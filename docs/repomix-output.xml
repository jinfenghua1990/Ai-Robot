<file path="backend/collectors/sync_daily_kline.py">
 1: """
 2: 日 K 线同步：将 Tushare daily 接口数据落地到 stock_daily_kline 表
 3: 用法:
 4:     python -m collectors.sync_daily_kline --start 20260625 --end 20260706
 5: """
 6: import logging
 7: import argparse
 8: from datetime import datetime, timedelta
 9: from db.connection import engine
10: from db.session import get_db_session
11: from db.models import StockDailyKline
12: from sqlalchemy import text
13: logger = logging.getLogger(__name__)
14: def sync_daily_kline(start_date: str, end_date: str) -> dict:
15:     """
16:     拉取区间内每个交易日的全市场日线 → upsert 到 stock_daily_kline
17:     使用 Tushare daily 接口,一次调用获取全市场 ~5000 条
18:     """
19:     from collectors.tdx_collector import call_tushare_mcp
20:     sd = datetime.strptime(start_date, '%Y%m%d')
21:     ed = datetime.strptime(end_date, '%Y%m%d')
22:     if sd > ed:
23:         sd, ed = ed, sd
24:     total_inserted = 0
25:     total_updated = 0
26:     days_done = 0
27:     cur = sd
28:     while cur <= ed:
29:         d = cur.strftime('%Y%m%d')
30:         try:
31:             rows = call_tushare_mcp(
32:                 api_name='daily',
33:                 params={'trade_date': d},
34:                 fields=['ts_code', 'trade_date', 'open', 'high', 'low', 'close',
35:                         'pre_close', 'pct_chg', 'vol', 'amount'],
36:             )
37:             if not rows:
38:                 logger.info(f'[{d}] 无数据(非交易日?)')
39:                 cur += timedelta(days=1)
40:                 continue
41:             # upsert: 一次性 insert on conflict do update
42:             from sqlalchemy.dialects.postgresql import insert as pg_insert
43:             with get_db_session() as db:
44:                 stmt = pg_insert(StockDailyKline.__table__).values([
45:                     {
46:                         'ts_code': r['ts_code'],
47:                         'trade_date': datetime.strptime(r['trade_date'], '%Y%m%d').date(),
48:                         'open': r.get('open'),
49:                         'high': r.get('high'),
50:                         'low': r.get('low'),
51:                         'close': r.get('close'),
52:                         'volume': r.get('vol'),
53:                         'amount': r.get('amount'),
54:                         'pct_chg': r.get('pct_chg'),
55:                     } for r in rows
56:                 ])
57:                 stmt = stmt.on_conflict_do_update(
58:                     index_elements=['ts_code', 'trade_date'],
59:                     set_={
60:                         'open': stmt.excluded.open,
61:                         'high': stmt.excluded.high,
62:                         'low': stmt.excluded.low,
63:                         'close': stmt.excluded.close,
64:                         'volume': stmt.excluded.volume,
65:                         'amount': stmt.excluded.amount,
66:                         'pct_chg': stmt.excluded.pct_chg,
67:                     },
68:                 )
69:                 db.execute(stmt)
70:                 db.commit()
71:             total_inserted += len(rows)
72:             days_done += 1
73:             logger.info(f'[{d}] 写入 {len(rows)} 条')
74:         except Exception as e:
75:             logger.error(f'[{d}] 同步失败: {e}', exc_info=True)
76:         cur += timedelta(days=1)
77:     return {'days_done': days_done, 'rows_synced': total_inserted}
78: if __name__ == '__main__':
79:     parser = argparse.ArgumentParser()
80:     parser.add_argument('--start', required=True)
81:     parser.add_argument('--end', required=True)
82:     args = parser.parse_args()
83:     logging.basicConfig(level=logging.INFO, format='%(asctime)s [%(levelname)s] %(message)s')
84:     r = sync_daily_kline(args.start, args.end)
85:     print(r)
</file>

