  1: """技术指标计算服务
  2: MA / RSI / MACD / KDJ / ATR / SuperTrend 等
  3: 统一一个地方，所有模块共用。
  4: """
  5: from typing import List, Optional
  6: def calc_ma(closes: List[float], period: int) -> List[Optional[float]]:
  7:     """计算简单移动平均线"""
  8:     ma = []
  9:     for i in range(len(closes)):
 10:         if i < period - 1:
 11:             ma.append(None)
 12:         else:
 13:             ma.append(sum(closes[i - period + 1:i + 1]) / period)
 14:     return ma
 15: def calc_ema(values: List[float], period: int) -> List[Optional[float]]:
 16:     """计算指数移动平均（SMA 种子 + EMA 公式）"""
 17:     if not values:
 18:         return []
 19:     ema = []
 20:     multiplier = 2 / (period + 1)
 21:     if len(values) >= period:
 22:         for i in range(period - 1):
 23:             ema.append(None)
 24:         sma_seed = sum(values[:period]) / period
 25:         ema.append(sma_seed)
 26:         for i in range(period, len(values)):
 27:             ema.append(values[i] * multiplier + ema[-1] * (1 - multiplier))
 28:     else:
 29:         ema.append(values[0])
 30:         for i in range(1, len(values)):
 31:             ema.append(values[i] * multiplier + ema[-1] * (1 - multiplier))
 32:     return ema
 33: def calc_macd(closes: List[float], fast=12, slow=26, signal_period=9):
 34:     """计算 MACD
 35:     Returns: (dif, dea, macd)
 36:     """
 37:     ema_fast = calc_ema(closes, fast)
 38:     ema_slow = calc_ema(closes, slow)
 39:     dif = []
 40:     for ef, es in zip(ema_fast, ema_slow):
 41:         if ef is None or es is None:
 42:             dif.append(None)
 43:         else:
 44:             dif.append(ef - es)
 45:     dif_valid_start = next((i for i, v in enumerate(dif) if v is not None), 0)
 46:     dif_valid = dif[dif_valid_start:]
 47:     dea_valid = calc_ema(dif_valid, signal_period)
 48:     dea = [None] * dif_valid_start + dea_valid
 49:     macd = []
 50:     for d, e in zip(dif, dea):
 51:         if d is None or e is None:
 52:             macd.append(None)
 53:         else:
 54:             macd.append((d - e) * 2)
 55:     return dif, dea, macd
 56: def calc_rsi(closes: List[float], period: int = 14) -> List[Optional[float]]:
 57:     """计算 RSI（相对强弱指标）"""
 58:     if len(closes) < period + 1:
 59:         return [None] * len(closes)
 60:     rsi = [None] * period
 61:     gains, losses = [], []
 62:     for i in range(1, period + 1):
 63:         chg = closes[i] - closes[i - 1]
 64:         gains.append(max(chg, 0))
 65:         losses.append(max(-chg, 0))
 66:     avg_gain = sum(gains) / period
 67:     avg_loss = sum(losses) / period
 68:     if avg_loss == 0:
 69:         rsi.append(100.0)
 70:     else:
 71:         rsi.append(100 - 100 / (1 + avg_gain / avg_loss))
 72:     for i in range(period + 1, len(closes)):
 73:         chg = closes[i] - closes[i - 1]
 74:         gain = max(chg, 0)
 75:         loss = max(-chg, 0)
 76:         avg_gain = (avg_gain * (period - 1) + gain) / period
 77:         avg_loss = (avg_loss * (period - 1) + loss) / period
 78:         if avg_loss == 0:
 79:             rsi.append(100.0)
 80:         else:
 81:             rsi.append(100 - 100 / (1 + avg_gain / avg_loss))
 82:     return rsi
 83: def calc_kdj(highs: List[float], lows: List[float], closes: List[float],
 84:              n: int = 9, m1: int = 3, m2: int = 3):
 85:     """计算 KDJ
 86:     Returns: (k, d, j)
 87:     """
 88:     k_values, d_values, j_values = [], [], []
 89:     k_prev = d_prev = 50.0
 90:     for i in range(len(closes)):
 91:         if i < n - 1:
 92:             k_values.append(None)
 93:             d_values.append(None)
 94:             j_values.append(None)
 95:             continue
 96:         start = i - n + 1
 97:         highest = max(highs[start:i + 1])
 98:         lowest = min(lows[start:i + 1])
 99:         if highest == lowest:
100:             rsv = 50.0
101:         else:
102:             rsv = (closes[i] - lowest) / (highest - lowest) * 100
103:         k = (m1 - 1) / m1 * k_prev + 1 / m1 * rsv
104:         d = (m2 - 1) / m2 * d_prev + 1 / m2 * k
105:         j = 3 * k - 2 * d
106:         k_values.append(k)
107:         d_values.append(d)
108:         j_values.append(j)
109:         k_prev, d_prev = k, d
110:     return k_values, d_values, j_values
111: def calc_atr(highs: List[float], lows: List[float], closes: List[float],
112:              period: int = 10) -> List[Optional[float]]:
113:     """计算 ATR（真实波幅）"""
114:     if not highs:
115:         return []
116:     tr = []
117:     for i in range(len(highs)):
118:         if i == 0:
119:             tr.append(highs[i] - lows[i])
120:         else:
121:             tr.append(max(
122:                 highs[i] - lows[i],
123:                 abs(highs[i] - closes[i - 1]),
124:                 abs(lows[i] - closes[i - 1])
125:             ))
126:     atr = []
127:     for i in range(len(tr)):
128:         if i < period - 1:
129:             atr.append(None)
130:         else:
131:             atr.append(sum(tr[i - period + 1:i + 1]) / period)
132:     return atr
133: def calc_supertrend(highs, lows, closes, period=10, multiplier=3.0):
134:     """计算 SuperTrend
135:     Returns: (support, resistance, trend, atr)
136:     """
137:     atr = calc_atr(highs, lows, closes, period)
138:     support, resistance, trend = [], [], []
139:     for i in range(len(closes)):
140:         hl2 = (highs[i] + lows[i]) / 2
141:         if atr[i] is None:
142:             support.append(None)
143:             resistance.append(None)
144:             trend.append(1)
145:             continue
146:         base_support = hl2 - multiplier * atr[i]
147:         base_resistance = hl2 + multiplier * atr[i]
148:         if i == 0 or support[i - 1] is None:
149:             support.append(base_support)
150:             resistance.append(base_resistance)
151:             trend.append(1)
152:             continue
153:         prev_close = closes[i - 1]
154:         # 支撑线(下轨)：多头时只上移
155:         if prev_close > support[i - 1]:
156:             support.append(max(base_support, support[i - 1]))
157:         else:
158:             support.append(base_support)
159:         # 阻力线(上轨)：空头时只下移
160:         if prev_close < resistance[i - 1]:
161:             resistance.append(min(base_resistance, resistance[i - 1]))
162:         else:
163:             resistance.append(base_resistance)
164:         # 趋势变轨
165:         prev_trend = trend[i - 1]
166:         if prev_trend == 1:
167:             if closes[i] < support[i - 1]:
168:                 trend.append(-1)
169:             else:
170:                 trend.append(1)
171:         else:
172:             if closes[i] > resistance[i - 1]:
173:                 trend.append(1)
174:             else:
175:                 trend.append(-1)
176:     return support, resistance, trend, atr
