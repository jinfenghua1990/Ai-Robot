<file path="backend/api/market_stage.py">
  1: """
  2: Market Stage API — 市场情绪 6 阶段 (迁移自 hermes-cockpit market_stage_engine)
  3: 6 阶段: 冰点 / 修复 / 发酵 / 高潮 / 分歧 / 退潮
  4: 每阶段对应仓位建议: 2-3成 / 4成 / 6成 / 7成 / 4-5成 / 3成
  5: 数据源: StockFlow 表实时统计 (涨停/跌停/涨跌家数) + ConceptSectorFlow 热度
  6: 算法: 综合热度/涨停数/涨跌广度/炸板率/跌停数 → 0-100 评分 → 6 阶段映射
  7: """
  8: from __future__ import annotations
  9: import logging
 10: import time
 11: from datetime import datetime, date
 12: from typing import Any, Optional
 13: from fastapi import APIRouter
 14: from sqlalchemy import func
 15: from db.session import get_db_session
 16: from db.models import StockFlow, ConceptSectorFlow
 17: logger = logging.getLogger(__name__)
 18: router = APIRouter(prefix="/api/market-stage", tags=["market-stage"])
 19: # ─── inline 缓存 (装饰器与 FastAPI endpoint 不兼容，改用 dict + TTL) ──────────
 20: _MARKET_STAGE_CACHE: dict[str, dict] = {}  # key -> {data, ts, ttl}
 21: _MS_CACHE_TTL_LATEST = 30        # 最新交易日 30s (盘中实时更新)
 22: _MS_CACHE_TTL_HISTORICAL = 600   # 历史日期 10min (数据稳定)
 23: # ─── 6 阶段配置 ────────────────────────────────────────────────────────────────
 24: STAGE_DESCRIPTIONS = {
 25:     "冰点": "短线情绪偏弱，资金仍在等待方向。",
 26:     "修复": "市场进入试探性修复，承接开始出现。",
 27:     "发酵": "主线扩散中，资金开始向核心方向集中。",
 28:     "高潮": "强势主线集中爆发，赚钱效应升温。",
 29:     "分歧": "高位分歧加剧，强弱切换明显。",
 30:     "退潮": "短线情绪回落，风险释放阶段。",
 31: }
 32: POSITION_GUIDANCE = {
 33:     "冰点": "2~3成",
 34:     "修复": "4成",
 35:     "发酵": "6成",
 36:     "高潮": "7成",
 37:     "分歧": "4~5成",
 38:     "退潮": "3成",
 39: }
 40: STAGE_COLORS = {
 41:     "冰点": "#3b82f6",    # 蓝
 42:     "修复": "#06b6d4",    # 青
 43:     "发酵": "#f59e0b",    # 琥珀
 44:     "高潮": "#ef4444",    # 红
 45:     "分歧": "#a855f7",    # 紫
 46:     "退潮": "#6b7280",    # 灰
 47: }
 48: def _stage_description(stage: str) -> str:
 49:     return STAGE_DESCRIPTIONS.get(stage, "市场结构待确认。")
 50: def _clamp(v: float, lo: float, hi: float) -> float:
 51:     return max(lo, min(hi, v))
 52: # ─── 6 阶段核心算法 (移植自 hermes market_stage_engine) ────────────────────────
 53: def build_market_stage(
 54:     limit_up: int,
 55:     broken: int,
 56:     limit_down: int,
 57:     up: int,
 58:     down: int,
 59:     heat_value: float,
 60:     theme_strength: float = 0.0,
 61:     mainline_count: int = 0,
 62: ) -> dict[str, Any]:
 63:     """根据市场广度数据计算情绪阶段
 64:     参数:
 65:         limit_up: 涨停家数
 66:         broken: 炸板家数 (涨停后开板)
 67:         limit_down: 跌停家数
 68:         up: 上涨家数
 69:         down: 下跌家数
 70:         heat_value: 市场热度 0-100
 71:         theme_strength: 主线强度 0-100 (可选)
 72:         mainline_count: 主线数量 (可选)
 73:     返回: {stage, score, description, position, signals, drivers, color}
 74:     """
 75:     broken_rate = (broken / limit_up) if limit_up > 0 else (1.0 if broken else 0.0)
 76:     breadth_net = up - down
 77:     breadth_total = up + down
 78:     score = 0.0
 79:     signals: list[str] = []
 80:     drivers: list[dict[str, Any]] = []
 81:     def push_driver(name: str, value: Any, impact: float, reason: str) -> None:
 82:         drivers.append({"name": name, "value": value, "impact": impact, "reason": reason})
 83:     # 热度评分
 84:     if heat_value >= 70:
 85:         score += 20
 86:         signals.append("市场热度高位")
 87:         push_driver("市场热度", round(heat_value, 2), 20, "热度处于高位，资金参与度强")
 88:     elif heat_value >= 55:
 89:         score += 15
 90:         signals.append("市场热度偏强")
 91:         push_driver("市场热度", round(heat_value, 2), 15, "热度偏强，情绪仍在扩散")
 92:     elif heat_value >= 40:
 93:         score += 8
 94:         signals.append("市场热度温和")
 95:         push_driver("市场热度", round(heat_value, 2), 8, "热度温和，属于试探修复区")
 96:     elif heat_value >= 25:
 97:         score += 3
 98:         signals.append("市场热度仍在修复")
 99:         push_driver("市场热度", round(heat_value, 2), 3, "热度仍在修复，但未回到强势区")
100:     else:
101:         signals.append("市场热度偏弱")
102:         push_driver("市场热度", round(heat_value, 2), 0, "热度偏弱，资金参与不足")
103:     # 涨停家数评分
104:     if limit_up >= 80:
105:         score += 20
106:         signals.append("涨停家数极高")
107:         push_driver("涨停家数", limit_up, 20, "涨停扩张明显，赚钱效应很强")
108:     elif limit_up >= 50:
109:         score += 17
110:         signals.append("涨停家数活跃")
111:         push_driver("涨停家数", limit_up, 17, "涨停家数保持活跃")
112:     elif limit_up >= 30:
113:         score += 12
114:         signals.append("涨停家数处于扩散")
115:         push_driver("涨停家数", limit_up, 12, "涨停家数进入扩散区间")
116:     elif limit_up >= 15:
117:         score += 7
118:         signals.append("涨停家数开始回暖")
119:         push_driver("涨停家数", limit_up, 7, "涨停家数回暖但仍偏中性")
120:     elif limit_up > 0:
121:         score += 3
122:         signals.append("仍有零散涨停")
123:         push_driver("涨停家数", limit_up, 3, "仍有零散活跃点，但不足以形成主升")
124:     # 涨跌广度评分
125:     if breadth_net >= 2000:
126:         score += 15
127:         signals.append("上涨家数明显占优")
128:         push_driver("涨跌家数", f"{up}:{down}", 15, "上涨家数明显占优，市场广度强")
129:     elif breadth_net >= 1000:
130:         score += 12
131:         signals.append("市场广度偏强")
132:         push_driver("涨跌家数", f"{up}:{down}", 12, "广度偏强，资金扩散较好")
133:     elif breadth_net >= 500:
134:         score += 8
135:         signals.append("市场广度温和回暖")
136:         push_driver("涨跌家数", f"{up}:{down}", 8, "广度温和回暖")
137:     elif breadth_net > 0:
138:         score += 4
139:         signals.append("广度略偏正")
140:         push_driver("涨跌家数", f"{up}:{down}", 4, "上涨略多于下跌")
141:     elif breadth_net <= -1000:
142:         score -= 12
143:         signals.append("下跌家数占优")
144:         push_driver("涨跌家数", f"{up}:{down}", -12, "下跌家数明显占优")
145:     elif breadth_net <= -500:
146:         score -= 8
147:         signals.append("市场广度偏弱")
148:         push_driver("涨跌家数", f"{up}:{down}", -8, "广度偏弱，承接不足")
149:     # 主线强度评分
150:     if theme_strength >= 75:
151:         score += 18
152:         signals.append("主线强度高")
153:         push_driver("主线强度", round(theme_strength, 2), 18, "主线强度高，方向性明确")
154:     elif theme_strength >= 55:
155:         score += 12
156:         signals.append("主线强度清晰")
157:         push_driver("主线强度", round(theme_strength, 2), 12, "主线强度清晰")
158:     elif theme_strength >= 35:
159:         score += 7
160:         signals.append("主线仍在扩散")
161:         push_driver("主线强度", round(theme_strength, 2), 7, "主线仍在扩散")
162:     elif theme_strength > 0:
163:         score += 3
164:         signals.append("主线尚在孕育")
165:         push_driver("主线强度", round(theme_strength, 2), 3, "主线尚在孕育")
166:     # 炸板率评分
167:     if broken_rate >= 0.35:
168:         score -= 18
169:         signals.append("炸板率偏高")
170:         push_driver("炸板率", round(broken_rate, 4), -18, "炸板率偏高，短线兑现压力加大")
171:     elif broken_rate >= 0.2:
172:         score -= 10
173:         signals.append("炸板率抬升")
174:         push_driver("炸板率", round(broken_rate, 4), -10, "炸板率开始抬升")
175:     elif broken_rate >= 0.1:
176:         score -= 5
177:         signals.append("炸板率略有压力")
178:         push_driver("炸板率", round(broken_rate, 4), -5, "炸板率略有压力")
179:     # 跌停数评分
180:     if limit_down >= 20:
181:         score -= 18
182:         signals.append("跌停扩散明显")
183:         push_driver("跌停数", limit_down, -18, "跌停扩散明显，尾部风险增大")
184:     elif limit_down >= 10:
185:         score -= 10
186:         signals.append("跌停数量偏多")
187:         push_driver("跌停数", limit_down, -10, "跌停数量偏多")
188:     elif limit_down >= 5:
189:         score -= 5
190:         signals.append("跌停仍需关注")
191:         push_driver("跌停数", limit_down, -5, "跌停仍需关注")
192:     # 主线覆盖加分
193:     if mainline_count >= 3 and limit_up >= 30 and broken_rate <= 0.15:
194:         score += 5
195:         signals.append("主线覆盖面较好")
196:         push_driver("主线覆盖", mainline_count, 5, "主线覆盖面较好，资金并未只集中单点")
197:     # 一致性预警
198:     if breadth_total and abs(breadth_net) / breadth_total < 0.1 and limit_up >= 30:
199:         signals.append("一致性较高")
200:         push_driver("一致性", round(abs(breadth_net) / breadth_total, 4), 0, "涨跌家数过于一致，后续切换风险需要注意")
201:     score = round(_clamp(score, 0.0, 100.0), 0)
202:     # 6 阶段判定
203:     if limit_down >= 20 or (heat_value < 20 and limit_up <= 10 and breadth_net < 0):
204:         stage = "退潮"
205:     elif broken_rate >= 0.35 and limit_up >= 30:
206:         stage = "分歧"
207:     elif limit_up >= 50 and broken_rate <= 0.18 and heat_value >= 60 and breadth_net > 0 and theme_strength >= 55:
208:         stage = "高潮"
209:     elif limit_up >= 30 and breadth_net > 0 and theme_strength >= 45 and heat_value >= 40:
210:         stage = "发酵"
211:     elif breadth_net >= 0 or heat_value >= 35 or limit_up >= 15:
212:         stage = "修复"
213:     else:
214:         stage = "冰点"
215:     if stage == "退潮":
216:         signals.append("短线情绪回落")
217:     elif stage == "分歧":
218:         signals.append("高位分歧显现")
219:     elif stage == "高潮":
220:         signals.append("主线集中爆发")
221:     elif stage == "发酵":
222:         signals.append("主线扩散中")
223:     elif stage == "修复":
224:         signals.append("市场试探性修复")
225:     else:
226:         signals.append("市场仍在冰点区")
227:     return {
228:         "stage": stage,
229:         "score": int(score),
230:         "description": _stage_description(stage),
231:         "position": POSITION_GUIDANCE.get(stage, ""),
232:         "color": STAGE_COLORS.get(stage, "#6b7280"),
233:         "signals": signals[:8],
234:         "drivers": drivers[:8],
235:         "metrics": {
236:             "limit_up": limit_up,
237:             "broken": broken,
238:             "limit_down": limit_down,
239:             "up": up,
240:             "down": down,
241:             "heat_value": round(heat_value, 2),
242:             "broken_rate": round(broken_rate, 4),
243:             "breadth_net": breadth_net,
244:             "theme_strength": round(theme_strength, 2),
245:             "mainline_count": mainline_count,
246:         },
247:     }
248: # ─── 从 StockFlow 实时统计市场广度 ─────────────────────────────────────────────
249: def _compute_heat(limit_up: int, up: int, down: int, total: int) -> float:
250:     """简化版热度计算: 涨停权重 40% + 涨跌比权重 30% + 涨停绝对值权重 30%"""
251:     if total == 0:
252:         return 0.0
253:     up_ratio = up / total
254:     # 涨停数映射到 0-100: 0只=0, 30只=50, 80只=100
255:     limit_up_score = min(100, limit_up * 1.25)
256:     # 涨跌比映射: 全跌=0, 平=50, 全涨=100
257:     breadth_score = up_ratio * 100
258:     heat = limit_up_score * 0.5 + breadth_score * 0.5
259:     return round(_clamp(heat, 0, 100), 2)
260: @router.get("")
261: def get_market_stage(date: Optional[str] = None):
262:     """获取当日市场情绪阶段 (从 StockFlow 实时统计)
263:     date: YYYYMMDD (可选, 默认最新交易日)
264:     返回: {stage, score, description, position, color, signals, drivers, metrics, trade_date}
265:     """
266:     cache_key = date or "__latest__"
267:     entry = _MARKET_STAGE_CACHE.get(cache_key)
268:     if entry and time.time() - entry['ts'] < entry['ttl']:
269:         return entry['data']
270:     result = _compute_market_stage(date)
271:     ttl = _MS_CACHE_TTL_HISTORICAL if date else _MS_CACHE_TTL_LATEST
272:     _MARKET_STAGE_CACHE[cache_key] = {'data': result, 'ts': time.time(), 'ttl': ttl}
273:     return result
274: def _compute_market_stage(date: Optional[str] = None) -> dict:
275:     with get_db_session() as db:
276:         # 确定查询日期
277:         target_date = date
278:         if not target_date:
279:             latest = db.query(func.max(StockFlow.trade_date)).scalar()
280:             if not latest:
281:                 return {
282:                     "stage": "冰点",
283:                     "score": 0,
284:                     "description": _stage_description("冰点"),
285:                     "position": POSITION_GUIDANCE["冰点"],
286:                     "color": STAGE_COLORS["冰点"],
287:                     "signals": ["无数据"],
288:                     "drivers": [],
289:                     "metrics": {},
290:                     "trade_date": None,
291:                     "error": "StockFlow 表无数据",
292:                 }
293:             target_date = latest
294:         # 统计涨跌停 + 涨跌家数
295:         rows = db.query(StockFlow.price_chg).filter(StockFlow.trade_date == target_date).all()
296:         if not rows:
297:             return {
298:                 "stage": "冰点",
299:                 "score": 0,
300:                 "description": _stage_description("冰点"),
301:                 "position": POSITION_GUIDANCE["冰点"],
302:                 "color": STAGE_COLORS["冰点"],
303:                 "signals": [f"{target_date} 无数据"],
304:                 "drivers": [],
305:                 "metrics": {},
306:                 "trade_date": str(target_date),
307:                 "error": f"{target_date} 当日无 StockFlow 数据",
308:             }
309:         limit_up = 0
310:         limit_down = 0
311:         up = 0
312:         down = 0
313:         flat = 0
314:         for (chg,) in rows:
315:             if chg is None:
316:                 continue
317:             chg_f = float(chg)
318:             if chg_f >= 9.8:
319:                 limit_up += 1
320:             elif chg_f <= -9.8:
321:                 limit_down += 1
322:             if chg_f > 0:
323:                 up += 1
324:             elif chg_f < 0:
325:                 down += 1
326:             else:
327:                 flat += 1
328:         total = up + down + flat
329:         # 炸板数估算 (无盘中数据，用 limit_up * 0.15 估算)
330:         broken = int(limit_up * 0.15)
331:         # 热度计算
332:         heat = _compute_heat(limit_up, up, down, total)
333:         # 主线强度: 从 ConceptSectorFlow 取热度 top 板块的平均强度
334:         theme_strength = 0.0
335:         mainline_count = 0
336:         try:
337:             sector_rows = db.query(ConceptSectorFlow).filter(
338:                 ConceptSectorFlow.trade_date == target_date,
339:             ).order_by(ConceptSectorFlow.net_flow.desc()).limit(5).all()
340:             if sector_rows:
341:                 # 主线 = 净流入为正的板块数
342:                 mainline_count = sum(1 for s in sector_rows if float(s.net_flow or 0) > 0)
343:                 # 简化: 用净流入正的板块比例 × 涨停数映射
344:                 if mainline_count > 0:
345:                     theme_strength = min(100, mainline_count * 20 + limit_up * 0.5)
346:         except Exception as e:
347:             logger.warning(f"查询 ConceptSectorFlow 失败: {e}")
348:         result = build_market_stage(
349:             limit_up=limit_up,
350:             broken=broken,
351:             limit_down=limit_down,
352:             up=up,
353:             down=down,
354:             heat_value=heat,
355:             theme_strength=theme_strength,
356:             mainline_count=mainline_count,
357:         )
358:         result["trade_date"] = str(target_date)
359:         result["metrics"]["flat"] = flat
360:         result["metrics"]["total"] = total
361:         return result
362: @router.get("/config")
363: def get_stage_config():
364:     """返回 6 阶段配置 (供前端展示用)"""
365:     return {
366:         "stages": [
367:             {"key": k, "description": v, "position": POSITION_GUIDANCE[k], "color": STAGE_COLORS[k]}
368:             for k, v in STAGE_DESCRIPTIONS.items()
369:         ],
370:         "stage_order": ["冰点", "修复", "发酵", "高潮", "分歧", "退潮"],
371:     }
