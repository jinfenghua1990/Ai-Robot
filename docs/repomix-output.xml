<file path="backend/api/watchlist/_shared.py">
  1: """watchlist 包内部共享状态与工具
  2: 包含：行情/K线缓存、watchlist 列表缓存、内部常量
  3: 所有子模块（core/groups/batch/quality/sync_mx）共用同一份缓存实例。
  4: """
  5: import time
  6: import asyncio
  7: import logging
  8: from typing import Optional
  9: from utils.http_constants import SINA_HEADERS_SHORT as SINA_HEADERS
 10: logger = logging.getLogger(__name__)
 11: _quote_cache: dict = {}
 12: _watchlist_cache = {"data": None, "ts": 0}
 13: _watchlist_refreshing = False
 14: _kline_cache: dict = {}
 15: QUOTE_CACHE_TTL = 30
 16: WATCHLIST_CACHE_TTL = 60
 17: KLINE_CACHE_TTL = 3600
 18: # 共享 httpx 客户端引用（由 main.py lifespan 设置）
 19: _shared_http_client = None
 20: _shared_http_client_loop = None  # 设置时所在的事件循环，用于检测 loop 不匹配
 21: _loop_fallback: dict = {}  # loop.id -> 临时 client，避免跨 loop 复用引发 "different loop" 错误
 22: def set_shared_http_client(client):
 23:     """由 main.py lifespan 调用，设置共享 httpx 客户端，并记录其事件循环。"""
 24:     global _shared_http_client, _shared_http_client_loop
 25:     _shared_http_client = client
 26:     try:
 27:         _shared_http_client_loop = asyncio.get_running_loop()
 28:     except RuntimeError:
 29:         _shared_http_client_loop = None
 30: def _get_http_client():
 31:     """获取 httpx 客户端：优先共享实例(同循环)，否则按当前运行循环创建并缓存独立 client，
 32:     避免重启后 lifespan 创建的 client 绑定旧 loop 导致 'attached to a different loop' 错误。"""
 33:     shared = _shared_http_client
 34:     if shared is not None and not shared.is_closed:
 35:         try:
 36:             loop = asyncio.get_running_loop()
 37:         except RuntimeError:
 38:             loop = None
 39:         if _shared_http_client_loop is None or _shared_http_client_loop is loop:
 40:             return shared
 41:         # loop 不匹配 -> 用当前 loop 的临时 client（缓存，避免每次新建）
 42:         if loop is not None:
 43:             fb = _loop_fallback.get(id(loop))
 44:             if fb is not None and not fb.is_closed:
 45:                 return fb
 46:             import httpx
 47:             fb = httpx.AsyncClient(timeout=8, headers=SINA_HEADERS)
 48:             _loop_fallback[id(loop)] = fb
 49:             return fb
 50:     import httpx
 51:     return httpx.AsyncClient(timeout=8, headers=SINA_HEADERS)
 52: def reset_watchlist_cache():
 53:     """清空 watchlist 列表缓存（外部模块删除/修改股票时调用）"""
 54:     _watchlist_cache["data"] = None
 55:     _watchlist_cache["ts"] = 0
 56: QUOTE_FAIL_TTL = 5  # 失败短缓存：限流/故障时避免打爆新浪
 57: async def get_quote(code: str) -> Optional[dict]:
 58:     """获取新浪实时行情（缓存 30 秒，失败结果 5 秒）
 59:     失败结果仅缓存 5 秒，避免新浪限流/临时故障时数据卡死。
 60:     """
 61:     cached = _quote_cache.get(code)
 62:     if cached and time.time() - cached[1] < QUOTE_CACHE_TTL:
 63:         return cached[0]
 64:     # 失败短缓存：5s 内不再重试（避免打爆新浪）
 65:     fail_ts = _quote_cache.get(code + '_fail_ts')
 66:     if fail_ts and time.time() - fail_ts < QUOTE_FAIL_TTL:
 67:         return None
 68:     from utils import stock_code_to_sina
 69:     sina_code = stock_code_to_sina(code)
 70:     if not sina_code:
 71:         return None
 72:     url = f"https://hq.sinajs.cn/list={sina_code}"
 73:     try:
 74:         client = _get_http_client()
 75:         resp = await client.get(url, headers=SINA_HEADERS, timeout=8)
 76:         resp.encoding = 'gbk'
 77:         text = resp.text
 78:         if '"' not in text or len(text.split('"')) < 3:
 79:             _quote_cache[code] = (None, time.time())
 80:             _quote_cache[code + '_fail_ts'] = time.time()  # 失败短缓存标记
 81:             return None
 82:         parts = text.split('"')[1].split(',')
 83:         if len(parts) < 10:
 84:             _quote_cache[code] = (None, time.time())
 85:             _quote_cache[code + '_fail_ts'] = time.time()
 86:             return None
 87:         # 新浪格式: name, 今开盘, 昨收盘, 当前价, 最高, 最低, ...
 88:         yesterday_close = float(parts[2])
 89:         current_price = float(parts[3])
 90:         change = current_price - yesterday_close
 91:         change_pct = (change / yesterday_close * 100) if yesterday_close else 0
 92:         result = {
 93:             'code': code,
 94:             'name': parts[0],
 95:             'price': current_price,
 96:             'yesterdayClose': yesterday_close,
 97:             'open': float(parts[1]),
 98:             'high': float(parts[4]),
 99:             'low': float(parts[5]),
100:             'volume': int(float(parts[8])),
101:             'change': round(change, 3),
102:             'changePct': round(change_pct, 2),
103:         }
104:         # 行情源校验：确保 low ≤ min(open, close), high ≥ max(open, close)
105:         min_price = min(result['open'], current_price)
106:         max_price = max(result['open'], current_price)
107:         if result['low'] > min_price:
108:             result['low'] = min_price
109:         if result['high'] < max_price:
110:             result['high'] = max_price
111:         _quote_cache[code] = (result, time.time())
112:         _quote_cache.pop(code + '_fail_ts', None)
113:         return result
114:     except Exception as e:
115:         logger.debug(f'[_shared] get_quote failed {code}: {e}')
116:         _quote_cache[code] = (None, time.time())
117:         _quote_cache[code + '_fail_ts'] = time.time()
118:         return None
119: async def batch_get_quotes(codes: list) -> dict:
120:     """批量获取新浪实时行情（一次最多 50 只，大幅减少 HTTP 请求）
121:     Args:
122:         codes: 股票代码列表，如 ['300285', '600000']
123:     Returns:
124:         dict: {code: quote_dict, ...}，失败或无数据的 code 值为 None
125:     """
126:     from utils import stock_code_to_sina
127:     result = {}
128:     # 先用缓存命中
129:     miss_codes = []
130:     now = time.time()
131:     for code in codes:
132:         cached = _quote_cache.get(code)
133:         if cached and now - cached[1] < QUOTE_CACHE_TTL:
134:             result[code] = cached[0]
135:         else:
136:             # 失败短缓存检查
137:             fail_ts = _quote_cache.get(code + '_fail_ts')
138:             if fail_ts and now - fail_ts < QUOTE_FAIL_TTL:
139:                 result[code] = None
140:             else:
141:                 miss_codes.append(code)
142:     if not miss_codes:
143:         return result
144:     # 批量请求新浪（每批最多 50 只）
145:     BATCH = 50
146:     for i in range(0, len(miss_codes), BATCH):
147:         batch = miss_codes[i:i + BATCH]
148:         sina_codes = []
149:         code_to_sina = {}
150:         for code in batch:
151:             sc = stock_code_to_sina(code)
152:             if sc:
153:                 sina_codes.append(sc)
154:                 code_to_sina[code] = sc
155:         if not sina_codes:
156:             for code in batch:
157:                 result[code] = None
158:                 _quote_cache[code] = (None, now)
159:             continue
160:         url = f"https://hq.sinajs.cn/list={','.join(sina_codes)}"
161:         try:
162:             client = _get_http_client()
163:             resp = await client.get(url, headers=SINA_HEADERS, timeout=8)
164:             resp.encoding = 'gbk'
165:             text = resp.text
166:             # 新浪返回格式：每行 var hq_str_xxx="field1,field2,...";
167:             lines = [ln.strip() for ln in text.split('\n') if ln.strip()]
168:             # 建立 sina_code -> quote 的映射
169:             sina_to_quote = {}
170:             for ln in lines:
171:                 if '=' not in ln or '"' not in ln:
172:                     continue
173:                 var_part = ln.split('=')[0]
174:                 data_part = ln.split('"')[1] if '"' in ln else ''
175:                 if not data_part:
176:                     continue
177:                 # var hq_str_sz300285
178:                 sc = var_part.split('hq_str_')[-1]
179:                 parts = data_part.split(',')
180:                 if len(parts) < 10:
181:                     sina_to_quote[sc] = None
182:                     continue
183:                 try:
184:                     yesterday_close = float(parts[2])
185:                     current_price = float(parts[3])
186:                     change = current_price - yesterday_close
187:                     change_pct = (change / yesterday_close * 100) if yesterday_close else 0
188:                     q = {
189:                         'name': parts[0],
190:                         'price': current_price,
191:                         'yesterdayClose': yesterday_close,
192:                         'open': float(parts[1]),
193:                         'high': float(parts[4]),
194:                         'low': float(parts[5]),
195:                         'volume': int(float(parts[8])),
196:                         'change': round(change, 3),
197:                         'changePct': round(change_pct, 2),
198:                     }
199:                     # 行情源校验
200:                     min_price = min(q['open'], current_price)
201:                     max_price = max(q['open'], current_price)
202:                     if q['low'] > min_price:
203:                         q['low'] = min_price
204:                     if q['high'] < max_price:
205:                         q['high'] = max_price
206:                     sina_to_quote[sc] = q
207:                 except Exception:
208:                     sina_to_quote[sc] = None
209:             # 回填到 result 和缓存
210:             for code in batch:
211:                 sc = code_to_sina.get(code)
212:                 q = sina_to_quote.get(sc) if sc else None
213:                 if q:
214:                     q['code'] = code
215:                     result[code] = q
216:                     _quote_cache[code] = (q, now)
217:                     _quote_cache.pop(code + '_fail_ts', None)
218:                 else:
219:                     result[code] = None
220:                     _quote_cache[code] = (None, now)
221:                     _quote_cache[code + '_fail_ts'] = now
222:         except Exception as e:
223:             logger.warning(f'[_shared] batch_get_quotes failed (batch {i//BATCH+1}): {e}')
224:             for code in batch:
225:                 result[code] = None
226:                 _quote_cache[code] = (None, now)
227:                 _quote_cache[code + '_fail_ts'] = now
228:     return result
229: async def fetch_kline_cached(code: str, datalen: int = 60) -> list:
230:     """日 K 线缓存（白天不变，缓存 1 小时，避免 164 只×HTTP=81 秒）"""
231:     from api.bs_signals import _fetch_kline
232:     cached = _kline_cache.get(code)
233:     if cached and time.time() - cached[1] < KLINE_CACHE_TTL:
234:         return cached[0]
235:     try:
236:         klines = await _fetch_kline(code, datalen)
237:         _kline_cache[code] = (klines, time.time())
238:         return klines
239:     except Exception as e:
240:         logger.debug(f'[_shared] fetch_kline_cached failed {code}: {e}')
241:         return []
</file>

