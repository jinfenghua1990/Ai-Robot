<file path="backend/analyzers/lifecycle_v3.py">
  1: """
  2: 龙头生命周期 V3 分析器
  3: 新增功能:
  4: 1. 二波检测 - 识别退潮后重新走强的股票
  5: 2. 板块聚合 - 按板块分组统计
  6: """
  7: from datetime import datetime, timedelta
  8: from db.session import get_db_session
  9: from db.models import LeaderLifecycle, StockFlow
 10: def is_second_wave(ts_code, trade_date, db):
 11:     """
 12:     检测股票是否处于二波行情
 13:     条件:
 14:     1. 近15天内有过退潮记录（确认第一波结束）
 15:     2. 当前重新走强（涨幅>5% 或 连板天数>=1）
 16:     3. 之前有过强势记录（连板>=2）
 17:     """
 18:     trade_date_obj = datetime.strptime(trade_date, '%Y-%m-%d') if isinstance(trade_date, str) else trade_date
 19:     start_date = trade_date_obj - timedelta(days=15)
 20:     # 检查近15天内是否有衰退记录（兼容新旧命名）
 21:     has_retreat = db.query(LeaderLifecycle).filter(
 22:         LeaderLifecycle.ts_code == ts_code,
 23:         LeaderLifecycle.trade_date >= start_date.date(),
 24:         LeaderLifecycle.trade_date < trade_date_obj.date(),
 25:         LeaderLifecycle.stage.in_(['衰退', '退潮'])
 26:     ).first()
 27:     if not has_retreat:
 28:         return False
 29:     # 检查之前是否有过强势记录（连板>=2）
 30:     has_strong = db.query(LeaderLifecycle).filter(
 31:         LeaderLifecycle.ts_code == ts_code,
 32:         LeaderLifecycle.trade_date >= start_date.date(),
 33:         LeaderLifecycle.trade_date < trade_date_obj.date(),
 34:         LeaderLifecycle.consecutive_days >= 2
 35:     ).first()
 36:     if not has_strong:
 37:         return False
 38:     # 检查当前是否重新走强
 39:     current = db.query(LeaderLifecycle).filter(
 40:         LeaderLifecycle.ts_code == ts_code,
 41:         LeaderLifecycle.trade_date == trade_date_obj.date()
 42:     ).first()
 43:     if not current:
 44:         return False
 45:     # 当前连板>=1 或涨幅>5% 视为重新走强
 46:     if current.consecutive_days >= 1 or (current.change_rate or 0) > 5:
 47:         return True
 48:     return False
 49: def get_lifecycle_v3(trade_date):
 50:     """
 51:     返回龙头生命周期 V3 数据
 52:     包含: 板块聚合统计 + 二波股票 + 完整龙头列表
 53:     """
 54:     trade_date_obj = datetime.strptime(trade_date, '%Y-%m-%d') if isinstance(trade_date, str) else trade_date
 55:     with get_db_session() as db:
 56:         leaders = db.query(LeaderLifecycle).filter_by(trade_date=trade_date_obj.date()).all()
 57:         sector_stats = {}
 58:         for leader in leaders:
 59:             sector = leader.sector or '未知'
 60:             if sector not in sector_stats:
 61:                 sector_stats[sector] = {
 62:                     'count': 0,
 63:                     'avg_strength': 0,
 64:                     'avg_change': 0,
 65:                     'total_inflow': 0,
 66:                     'leaders': [],
 67:                 }
 68:             stock = db.query(StockFlow).filter_by(
 69:                 trade_date=trade_date_obj.date(),
 70:                 ts_code=leader.ts_code
 71:             ).first()
 72:             inflow = float(stock.main_force_inflow or 0) if stock else 0
 73:             sector_stats[sector]['count'] += 1
 74:             sector_stats[sector]['avg_strength'] += float(leader.strength or 0)
 75:             sector_stats[sector]['avg_change'] += float(leader.change_rate or 0)
 76:             sector_stats[sector]['total_inflow'] += inflow
 77:             sector_stats[sector]['leaders'].append({
 78:                 'ts_code': leader.ts_code,
 79:                 'name': leader.name or '',
 80:                 'stage': leader.stage,
 81:                 'strength': float(leader.strength or 0),
 82:                 'change_rate': float(leader.change_rate or 0),
 83:                 'consecutive_days': leader.consecutive_days,
 84:                 'main_force_inflow': inflow,
 85:                 'is_second_wave': is_second_wave(leader.ts_code, trade_date, db),
 86:             })
 87:         for sector, stats in sector_stats.items():
 88:             if stats['count'] > 0:
 89:                 stats['avg_strength'] = round(stats['avg_strength'] / stats['count'], 1)
 90:                 stats['avg_change'] = round(stats['avg_change'] / stats['count'], 2)
 91:         sector_list = sorted(sector_stats.items(), key=lambda x: -x[1]['count'])
 92:         second_wave_stocks = []
 93:         for sector, stats in sector_stats.items():
 94:             for leader in stats['leaders']:
 95:                 if leader['is_second_wave']:
 96:                     leader['sector'] = sector
 97:                     second_wave_stocks.append(leader)
 98:         second_wave_stocks.sort(key=lambda x: -x['strength'])
 99:         return {
100:             'date': trade_date,
101:             'total_leaders': len(leaders),
102:             'total_sectors': len(sector_stats),
103:             'sector_list': [
104:                 {
105:                     'name': sector,
106:                     'count': stats['count'],
107:                     'avg_strength': stats['avg_strength'],
108:                     'avg_change': stats['avg_change'],
109:                     'total_inflow': round(stats['total_inflow'], 2),
110:                 }
111:                 for sector, stats in sector_list
112:             ],
113:             'sector_detail': sector_stats,
114:             'second_wave': second_wave_stocks,
115:             'leaders': [
116:                 {
117:                     'ts_code': l.ts_code,
118:                     'name': l.name or '',
119:                     'sector': l.sector,
120:                     'stage': l.stage,
121:                     'strength': float(l.strength or 0),
122:                     'change_rate': float(l.change_rate or 0),
123:                     'consecutive_days': l.consecutive_days,
124:                     'is_second_wave': is_second_wave(l.ts_code, trade_date, db),
125:                 }
126:                 for l in leaders
127:             ],
128:         }
129: if __name__ == '__main__':
130:     today = datetime.now().strftime('%Y-%m-%d')
131:     result = get_lifecycle_v3(today)
132:     print(f"Total leaders: {result['total_leaders']}")
133:     print(f"Total sectors: {result['total_sectors']}")
134:     print(f"Second wave: {len(result['second_wave'])}")
