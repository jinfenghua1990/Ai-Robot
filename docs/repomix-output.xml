165:                 q = q.filter(StrategyTrack.pool_date == pd)
166:             except ValueError:
167:                 raise HTTPException(status_code=400, detail="pool_date 格式应为 YYYY-MM-DD")
168:         q = q.order_by(desc(StrategyTrack.pool_date), desc(StrategyTrack.strategy_count))
169:         trackers = q.all()
170:         rows = [_serialize_tracker(db, t, include_daily=True, daily_limit=20) for t in trackers]
171:         # 统计摘要：total 跟随当前 filter；active/exited/expired 为全局统计
172:         total = len(trackers)
173:         active_count = (
174:             db.query(func.count(StrategyTrack.id))
175:             .filter(StrategyTrack.status == "active")
176:             .scalar()
177:             or 0
