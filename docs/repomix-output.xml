  39: # ===== 进程内 TTL 缓存 =====
  40: # 策略中心 / 共振页等列表会同时为 N 只股票各发一次 /api/stock-dashboard/{code}，
  41: # 单只冷算 1-3s，110 只全走完要几十秒。盘后（end-of-day）数据按交易日固定、不会中途变化，
  42: # 因此把 TTL 拉到 6 小时：同一交易日的股票只冷算一次，之后 6h 内任意次加载都瞬时返回，
  43: # 彻底消除"每次打开都要等几十秒重算"的卡顿。仅当用户手动"重试 / 触发扫描"后想看最新值时，
  44: # 前端带 refresh=1 绕过缓存强制重算。
  45: # 用进程内 dict + 时间戳实现（不能用 @cached，会阻塞 event loop——项目历史教训）。
  46: _DASH_CACHE = {}
  47: _DASH_CACHE_TTL = 21600  # 6 小时（盘后数据按交易日固定，无需 5min 短缓存）
  48: _DASH_CACHE_MAX = 500  # 最多缓存 500 只，防止内存膨胀
  49: # 并发保护：batch 改为线程池并行后，多个 worker 会同时读写此进程内缓存 dict，必须加锁。
  50: _DASH_CACHE_LOCK = threading.Lock()
  51: def _dash_cache_get(code: str):
  52:     """读缓存：返回 None 或 cached dict。命中时刷新时间戳。"""
  53:     with _DASH_CACHE_LOCK:
  54:         now = _time.time()
  55:         item = _DASH_CACHE.get(code)
  56:         if not item:
  57:             return None
  58:         if now - item['ts'] > _DASH_CACHE_TTL:
  59:             _DASH_CACHE.pop(code, None)
  60:             return None
  61:         return item['data']
  62: def _dash_cache_set(code: str, data: dict):
  63:     with _DASH_CACHE_LOCK:
  64:         if len(_DASH_CACHE) >= _DASH_CACHE_MAX:
  65:             # FIFO 驱逐：删最旧的一条
  66:             try:
  67:                 oldest = next(iter(_DASH_CACHE))
  68:                 _DASH_CACHE.pop(oldest, None)
  69:             except StopIteration:
  70:                 pass
  71:         _DASH_CACHE[code] = {'ts': _time.time(), 'data': data}
  72: def _dash_cache_pop(code: str):
  73:     """强制刷新时清除缓存（加锁，避免与并发读竞态）。"""
  74:     with _DASH_CACHE_LOCK:
  75:         _DASH_CACHE.pop(code, None)
  76: # ===== 技术指标 KDJ / MACD =====
  77: def _compute_technical_indicators(ts_code: str, db, target_date) -> dict:
  78:     """计算 KDJ / MACD 技术指标及买卖信号。
  79:     取近 60 个交易日 K 线（覆盖 MACD slow=26 + signal=9 + 余量），
