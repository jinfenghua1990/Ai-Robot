<file path="frontend/src/components/StrategyResultsTable.jsx">
  1: import { useState, useMemo, useCallback } from 'react';
  2: /**
  3:  * 策略选股结果紧凑表格（替代满屏 SignalCard 卡片）
  4:  *
  5:  * Props:
  6:  * - columns: [{ key, label, render(row), sortable?, align?, type?('percent'|'money'|'number') }]
  7:  * - rows: 原始数据数组
  8:  * - getRowKey: (row) => 唯一标识
  9:  * - cardComponent: 可选卡片组件（用于卡片视图）
 10:  * - cardProps: 卡片组件 props
 11:  * - pageSize: 每页条数（默认 20）
 12:  * - searchPlaceholder: 搜索框占位文字
 13:  * - extraToolbar: 额外工具栏内容
 14:  * - emptyText: 无数据提示文字
 15:  * - defaultView: 'table' | 'card'（默认 'table'）
 16:  */
 17: /** 格式化单元格值 */
 18: function fmt(val, type) {
 19:   if (val == null || val === '') return '-';
 20:   if (type === 'percent') {
 21:     const n = Number(val);
 22:     if (isNaN(n)) return val;
 23:     const sign = n > 0 ? '+' : '';
 24:     return `${sign}${n.toFixed(2)}%`;
 25:   }
 26:   if (type === 'money') {
 27:     const n = Number(val);
 28:     if (isNaN(n)) return val;
 29:     const abs = Math.abs(n);
 30:     if (abs >= 1e8) return `${(n / 1e8).toFixed(2)}亿`;
 31:     if (abs >= 1e4) return `${(n / 1e4).toFixed(2)}万`;
 32:     return n.toFixed(0);
 33:   }
 34:   if (type === 'number') {
 35:     const n = Number(val);
 36:     if (isNaN(n)) return val;
 37:     return n.toFixed(2);
 38:   }
 39:   return val;
 40: }
 41: /** 获取排序用的数值 */
 42: function sortVal(val, type) {
 43:   if (val == null || val === '') return -Infinity;
 44:   if (type === 'percent' || type === 'money' || type === 'number') {
 45:     const n = Number(val);
 46:     return isNaN(n) ? -Infinity : n;
 47:   }
 48:   return String(val).toLowerCase();
 49: }
 50: export default function StrategyResultsTable({
 51:   columns = [],
 52:   rows = [],
 53:   getRowKey,
 54:   cardComponent: CardComp,
 55:   cardProps = {},
 56:   pageSize = 20,
 57:   searchPlaceholder = '搜索代码 / 名称 / 板块...',
 58:   extraToolbar,
 59:   emptyText = '暂无选股结果',
 60:   defaultView = 'table',
 61: }) {
 62:   const [view, setView] = useState(defaultView);
 63:   const [search, setSearch] = useState('');
 64:   const [sortKey, setSortKey] = useState(null);
 65:   const [sortAsc, setSortAsc] = useState(true);
 66:   const [currentPage, setCurrentPage] = useState(0);
 67:   const handleSort = useCallback((key) => {
 68:     if (sortKey === key) {
 69:       setSortAsc(v => !v);
 70:     } else {
 71:       setSortKey(key);
 72:       setSortAsc(true);
 73:     }
 74:     setCurrentPage(0);
 75:   }, [sortKey]);
 76:   // 列信息查找
 77:   const colMap = useMemo(() => {
 78:     const m = {};
 79:     columns.forEach(c => { m[c.key] = c; });
 80:     return m;
 81:   }, [columns]);
 82:   // 搜索 + 排序
 83:   const processed = useMemo(() => {
 84:     let result = [...rows];
 85:     // 搜索（在所有列内容中查找）
 86:     if (search.trim()) {
 87:       const q = search.trim().toLowerCase();
 88:       result = result.filter(row =>
 89:         columns.some(col => {
 90:           const rendered = col.render ? col.render(row) : row[col.key];
 91:           return String(rendered || '').toLowerCase().includes(q);
 92:         })
 93:       );
 94:     }
 95:     // 排序
 96:     if (sortKey) {
 97:       const col = colMap[sortKey];
 98:       result.sort((a, b) => {
 99:         const va = sortVal(col?.render ? col.render(a) : a[sortKey], col?.type);
100:         const vb = sortVal(col?.render ? col.render(b) : b[sortKey], col?.type);
101:         if (va < vb) return sortAsc ? -1 : 1;
102:         if (va > vb) return sortAsc ? 1 : -1;
103:         return 0;
104:       });
105:     }
106:     return result;
107:   }, [rows, search, sortKey, sortAsc, columns, colMap]);
108:   const totalPages = Math.max(1, Math.ceil(processed.length / pageSize));
109:   // 确保当前页不越界
110:   const safePage = Math.min(currentPage, totalPages - 1);
111:   const paged = processed.slice(safePage * pageSize, (safePage + 1) * pageSize);
112:   // 排序箭头
113:   const sortArrow = (key) => {
114:     if (sortKey !== key) return <span style={{ opacity: 0.2 }}> ↕</span>;
115:     return sortAsc ? <span> ↑</span> : <span> ↓</span>;
116:   };
117:   // 确定涨跌颜色
118:   const changeColor = (val) => {
119:     const n = Number(val);
120:     if (isNaN(n)) return 'var(--text-secondary)';
121:     if (n > 0) return '#ef4444'; // A股红色涨
122:     if (n < 0) return '#22c55e'; // 绿色跌
123:     return 'var(--text-secondary)';
124:   };
125:   const cellColor = (col, val) => {
126:     if (col?.type === 'percent') return changeColor(val);
127:     return 'var(--text-primary)';
128:   };
129:   const Toolbar = (
130:     <div className="flex items-center gap-2 mb-2 flex-wrap">
131:       <input
132:         type="text"
133:         value={search}
134:         onChange={(e) => { setSearch(e.target.value); setCurrentPage(0); }}
135:         placeholder={searchPlaceholder}
136:         className="px-3 py-1.5 rounded-lg border text-sm flex-1 min-w-[180px] outline-none"
137:         style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)', color: 'var(--text-primary)' }}
138:       />
139:       <span className="text-xs" style={{ color: 'var(--text-muted)' }}>{processed.length} 只</span>
140:       {extraToolbar}
141:       {/* 视图切换 */}
142:       <div className="flex rounded-lg border overflow-hidden" style={{ borderColor: 'var(--border-color)' }}>
143:         <button
144:           onClick={() => setView('table')}
145:           className="px-2.5 py-1 text-xs font-medium transition-colors"
146:           style={{
147:             background: view === 'table' ? 'var(--accent-blue)' : 'transparent',
148:             color: view === 'table' ? '#fff' : 'var(--text-secondary)',
149:           }}
150:         >📋 表格</button>
151:         <button
152:           onClick={() => setView('card')}
153:           className="px-2.5 py-1 text-xs font-medium transition-colors"
154:           style={{
155:             background: view === 'card' ? 'var(--accent-blue)' : 'transparent',
156:             color: view === 'card' ? '#fff' : 'var(--text-secondary)',
157:           }}
158:         >🃏 卡片</button>
159:       </div>
160:     </div>
161:   );
162:   // 分页组件
163:   const Pagination = totalPages > 1 && (
164:     <div className="flex items-center justify-center gap-2 mt-3 pt-2 border-t" style={{ borderColor: 'var(--border-color)' }}>
165:       <button
166:         onClick={() => setCurrentPage(p => Math.max(0, p - 1))}
167:         disabled={safePage === 0}
168:         className="px-3 py-1 rounded-lg text-xs border disabled:opacity-30"
169:         style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)' }}
170:       >上一页</button>
171:       <span className="text-xs" style={{ color: 'var(--text-muted)' }}>{safePage + 1} / {totalPages} 页</span>
172:       <button
173:         onClick={() => setCurrentPage(p => Math.min(totalPages - 1, p + 1))}
174:         disabled={safePage >= totalPages - 1}
175:         className="px-3 py-1 rounded-lg text-xs border disabled:opacity-30"
176:         style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)' }}
177:       >下一页</button>
178:     </div>
179:   );
180:   if (processed.length === 0) {
181:     return (
182:       <div>
183:         {Toolbar}
184:         <div className="flex items-center justify-center h-32 text-sm" style={{ color: 'var(--text-muted)' }}>{emptyText}</div>
185:       </div>
186:     );
187:   }
188:   // 卡片视图
189:   if (view === 'card' && CardComp) {
190:     return (
191:       <div>
192:         {Toolbar}
193:         <div className="grid grid-cols-1 md:grid-cols-2 gap-3 max-h-[700px] overflow-y-auto">
194:           {paged.map(row => (
195:             <CardComp key={getRowKey(row)} signal={row} {...cardProps} />
196:           ))}
197:         </div>
198:         {Pagination}
199:       </div>
200:     );
201:   }
202:   // 表格视图
203:   return (
204:     <div>
205:       {Toolbar}
206:       {/* 表头 */}
207:       <div className="rounded-lg border overflow-hidden" style={{ borderColor: 'var(--border-color)' }}>
208:         <div className="overflow-x-auto">
209:           <div
210:             className="grid gap-2 px-2.5 py-2 text-[11px] font-semibold border-b"
211:             style={{
212:               borderColor: 'var(--border-color)',
213:               background: 'var(--bg-hover)',
214:               color: 'var(--text-secondary)',
215:               gridTemplateColumns: columns.map(c => c.width || '1fr').join(' '),
216:             }}
217:           >
218:             {columns.map(col => (
219:               <div
220:                 key={col.key}
221:                 className={`flex items-center cursor-pointer select-none ${col.align === 'right' ? 'justify-end' : ''}`}
222:                 style={{ whiteSpace: 'nowrap' }}
223:                 onClick={() => col.sortable !== false && handleSort(col.key)}
224:                 title={col.sortable !== false ? '点击排序' : ''}
225:               >
226:                 {col.label}
227:                 {col.sortable !== false && <span className="text-[9px] ml-0.5">{sortArrow(col.key)}</span>}
228:               </div>
229:             ))}
230:           </div>
231:           {/* 数据行 */}
232:           <div className="max-h-[600px] overflow-y-auto">
233:             {paged.map((row, i) => (
234:               <div
235:                 key={getRowKey(row, i)}
236:                 className="grid gap-2 px-2.5 py-1.5 text-xs border-b transition-colors"
237:                 style={{
238:                   borderColor: 'var(--border-color)',
239:                   background: i % 2 === 0 ? 'var(--bg-card)' : 'var(--bg-surface)',
240:                   gridTemplateColumns: columns.map(c => c.width || '1fr').join(' '),
241:                 }}
242:                 onMouseEnter={(e) => {
243:                   e.currentTarget.style.background = 'var(--bg-hover)';
244:                 }}
245:                 onMouseLeave={(e) => {
246:                   e.currentTarget.style.background = i % 2 === 0 ? 'var(--bg-card)' : 'var(--bg-surface)';
247:                 }}
248:               >
249:                 {columns.map(col => {
250:                   const val = col.render ? col.render(row) : row[col.key];
251:                   const align = col.align || (col.type ? 'right' : 'left');
252:                   return (
253:                     <div
254:                       key={col.key}
255:                       className="truncate"
256:                       style={{
257:                         textAlign: align,
258:                         color: cellColor(col, val),
259:                         fontWeight: col.type === 'percent' ? 600 : 400,
260:                       }}
261:                       title={val != null ? String(val) : ''}
262:                     >
263:                       {fmt(val, col.type)}
264:                     </div>
265:                   );
266:                 })}
267:               </div>
268:             ))}
269:           </div>
270:         </div>
271:       </div>
272:       {Pagination}
273:     </div>
274:   );
275: }
</file>

