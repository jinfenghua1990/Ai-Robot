  1: #!/usr/bin/env python3
  2: # -*- coding: utf-8 -*-
  3: """
  4: 📋 量价报告策略 - 按 CodeBuddy 量价筛选报告逻辑实现
  5: 报告核心：
  6: 1. 5种形态分类：缩量回踩 / 放量突破 / 趋势延续 / 缩量修复 / 结构偏弱
  7: 2. 3层分层：优先买入 / 等回踩确认 / 暂不参与
  8: 3. 关键指标：日涨跌、近5日涨跌、20日量比、距20日高点、均线乖离
  9: 4. 交易计划：每只股票输出具体买入价位 + 止损价位
 10: 执行规则（报告原文）：
 11: - 开盘高开>3%不追，等第一次回踩不破分时均线
 12: - 优先看5日线和10日线附近缩量承接
 13: - 突破型必须放量站上前高或平台上沿
 14: - 放量跌破20日线，短线计划失效
 15: """
 16: import logging
 17: import concurrent.futures
 18: import numpy as np
 19: logger = logging.getLogger(__name__)
 20: def calc_rsi(closes, period=14):
 21:     deltas = np.diff(closes)
 22:     gains = np.where(deltas > 0, deltas, 0)
 23:     losses = np.where(deltas < 0, -deltas, 0)
 24:     avg_gain = np.mean(gains[-period:])
 25:     avg_loss = np.mean(losses[-period:])
 26:     if avg_loss == 0:
 27:         return 100
 28:     rs = avg_gain / avg_loss
 29:     return 100 - (100 / (1 + rs))
 30: def liangjia_report_strategy(kline, day_index=-1, main_force_history=None):
 31:     """量价报告策略主函数
 32:     参数:
 33:         kline: K线数据列表
 34:         day_index: 检查哪一天（默认-1）
 35:         main_force_history: 近5日主力净流入列表（来自StockFlow，可选）
 36:     返回 dict（含 pattern/tier/gain5d/vol_ratio_20/distance_to_high_20/trade_plan 等）或 None
 37:     """
 38:     try:
 39:         if day_index == -1:
 40:             day_index = len(kline) - 1
 41:         if day_index < 0 or day_index >= len(kline) or day_index < 20:
 42:             return None
 43:         latest = kline[day_index]
 44:         prev = kline[day_index - 1]
 45:         close = float(latest['close'])
 46:         low = float(latest['low'])
 47:         high = float(latest['high'])
 48:         open_p = float(latest['open'])
 49:         ma20 = float(latest.get('ma_price20') or 0)
 50:         ma10 = float(latest.get('ma_price10') or 0)
 51:         ma5 = float(latest.get('ma_price5') or 0)
 52:         prev_close = float(prev['close'])
 53:         volume = float(latest['volume'])
 54:         if ma20 <= 0 or ma10 <= 0 or ma5 <= 0:
 55:             return None
 56:         closes = [float(k['close']) for k in kline[:day_index + 1]]
 57:         if len(closes) < 21:
 58:             return None
 59:         # ===== 关键指标计算 =====
 60:         change_pct = (close - prev_close) / prev_close * 100
 61:         gain5d = (close - closes[-6]) / closes[-6] * 100 if len(closes) >= 6 else 0
 62:         gain20d = (close - closes[-21]) / closes[-21] * 100
 63:         # 20日量比（报告口径：当日成交量 / 过去20个交易日均量）
 64:         recent_vols = [float(kline[day_index - j]['volume']) for j in range(1, 21) if day_index - j >= 0]
 65:         avg_vol_20 = np.mean(recent_vols) if recent_vols else 0
 66:         vol_ratio_20 = (volume / avg_vol_20) if avg_vol_20 > 0 else 999
 67:         # 距20日高点
 68:         high_20 = max(closes[-20:])
 69:         distance_to_high_20 = (high_20 - close) / high_20 * 100
 70:         # 均线乖离
 71:         deviation_ma20 = (close - ma20) / ma20 * 100
 72:         deviation_ma5 = (close - ma5) / ma5 * 100
 73:         # MA20趋势（连续4天向上）
 74:         ma20_list = []
 75:         for i in range(max(0, day_index - 5), day_index + 1):
 76:             ma = kline[i].get('ma_price20')
 77:             if ma and float(ma) > 0:
 78:                 ma20_list.append(float(ma))
 79:         ma20_rising = len(ma20_list) >= 4 and all(ma20_list[j] < ma20_list[j + 1] for j in range(len(ma20_list) - 4, len(ma20_list) - 1))
 80:         # 多头排列
 81:         bull_alignment = ma5 > ma10 > ma20
 82:         # 突破10日新高（来自 volume_breakout 策略核心维度）
 83:         high_10d = max(float(k['high']) for k in kline[max(0, day_index - 10):day_index]) if day_index >= 10 else 0
 84:         breakout_10d = (close > high_10d) if high_10d > 0 else False
 85:         breakout_pct = (close - high_10d) / high_10d * 100 if high_10d > 0 else 0
 86:         # 下影线/上影线
 87:         lower_shadow = (min(close, open_p) - low) / prev_close * 100
 88:         upper_shadow = (high - max(close, open_p)) / prev_close * 100
 89:         rsi = calc_rsi(closes)
 90:         # ===== 5种形态分类 =====
 91:         pattern = None
 92:         pattern_desc = ''
 93:         # 1. 缩量回踩：最低价触及MA20，缩量，收盘仍守MA20上方
 94:         if low <= ma20 and close > ma20 and vol_ratio_20 < 1.0 and ma20_rising:
 95:             pattern = 'pullback'
 96:             pattern_desc = '缩量回踩守20日线'
 97:         # 2. 放量突破：收盘站上MA5/MA10，放量，接近20日高点
 98:         elif close > ma5 and close > ma10 and vol_ratio_20 >= 1.5 and distance_to_high_20 <= 5:
 99:             pattern = 'breakout'
100:             pattern_desc = '放量突破不破5/10日线'
101:         # 3. 趋势延续：多头排列，均线结构尚可
102:         elif bull_alignment and close > ma20 and ma20_rising:
103:             pattern = 'trend'
104:             pattern_desc = '趋势延续，均线结构尚可'
105:         # 4. 缩量修复：缩量，跌破MA5或MA10，但守MA20
106:         elif vol_ratio_20 < 0.8 and close < ma5 and close > ma20:
107:             pattern = 'repair'
108:             pattern_desc = '缩量修复，短线跌破关键均线'
109:         # 5. 结构偏弱：跌破MA20 或 双线破位
110:         elif close < ma20 or (close < ma5 and close < ma10):
111:             pattern = 'weak'
112:             pattern_desc = '结构偏弱或追高风险偏大'
113:         if pattern is None:
114:             return None
115:         # ===== 3层分层 =====
116:         # 优先买入：缩量回踩 + 放量突破 + 趋势延续(乖离<15%)
117:         # 等回踩确认：趋势延续(乖离>15%) + 放量突破(距高点>5%但<10%)
118:         # 暂不参与：结构偏弱 + 缩量修复 + 趋势延续(距高点>15%)
