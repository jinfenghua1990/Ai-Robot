 162: # ===== BS 区间档案（含区间内日 K 序列，供前端 sparkline）=====
 163: def _compute_bs_interval(ts_code: str, current_price: float, db, target_date) -> dict:
 164:     """计算 BS 区间档案 + 区间内日 K 序列
 165:     复用 _generate_bs_signals（SuperTrend）生成 B/S 信号序列，
 166:     再调 _calc_bs_interval 提取当前区间（持仓中/已平仓），
 167:     最后从 StockDailyKline 取区间期间的日 K（含 B 起点 → S 终点/今天）暴露给前端画 sparkline。
 168:     Returns:
 169:         {
 170:             'state': 'holding' | 'empty' | 'unknown',
 171:             'start_date': str, 'start_price': float,
 172:             'end_date': str, 'end_price': float,
 173:             'hold_days': int, 'pnl_pct': float,
 174:             'klines': [{'date': str, 'open': float, 'close': float,
 175:                         'high': float, 'low': float, 'volume': float}, ...],
 176:         }
 177:     """
 178:     from api.bs_signals import _generate_bs_signals
 179:     from services.signal_builder import _calc_bs_interval
 180:     # 取近 150 根日 K（与 bs_signals API 同口径，确保 EMA/MACD 收敛）
 181:     kline_rows = db.query(StockDailyKline).filter(
 182:         StockDailyKline.ts_code == ts_code,
 183:         StockDailyKline.trade_date <= target_date,
 184:     ).order_by(StockDailyKline.trade_date.asc()).limit(150).all()
 185:     if len(kline_rows) < 35:
 186:         return {'state': 'unknown', 'klines': []}
 187:     klines = [{
 188:         'date': k.trade_date.strftime('%Y-%m-%d') if hasattr(k.trade_date, 'strftime') else str(k.trade_date),
 189:         'open': float(k.open or 0),
 190:         'close': float(k.close or 0),
 191:         'high': float(k.high or 0),
 192:         'low': float(k.low or 0),
 193:         'volume': float(k.volume or 0),
 194:     } for k in kline_rows]
 195:     try:
 196:         bs_signals, *_ = _generate_bs_signals(klines)
 197:     except Exception:
 198:         logger.debug(f"[bs_interval] _generate_bs_signals failed for {ts_code}", exc_info=True)
 199:         return {'state': 'unknown', 'klines': []}
 200:     if not bs_signals:
 201:         return {'state': 'unknown', 'klines': []}
 202:     interval = _calc_bs_interval(bs_signals, current_price)
 203:     interval['klines'] = []
 204:     # 统一日期格式为 YYYY-MM-DD（klines 已是此格式）
 205:     start_date = interval.get('start_date', '')
 206:     end_date = interval.get('end_date', '')
 207:     if not start_date:
 208:         return interval
 209:     sd_norm = start_date[:10]
 210:     ed_norm = end_date[:10] if end_date else None
 211:     # 显示最近 60 天日 K（提供 B 点前的趋势上下文），而不是只从 B 点开始
 212:     # 60 个交易日约等于 3 个月，足够看清 BS 区间全貌+前期走势
 213:     DISPLAY_DAYS = 60
 214:     in_range = []
 215:     total_klines = len(klines)
 216:     start_idx = max(0, total_klines - DISPLAY_DAYS)
 217:     for i in range(start_idx, total_klines):
