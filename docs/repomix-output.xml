 965: _DASH_EXECUTOR = None
 966: def _get_executor():
 967:     global _DASH_EXECUTOR
 968:     if _DASH_EXECUTOR is None:
 969:         _DASH_EXECUTOR = ThreadPoolExecutor(max_workers=12, thread_name_prefix="dash-worker")
 970:     return _DASH_EXECUTOR
 971: def _compute_one(code: str):
 972:     """线程池 worker：独立 DB session + 受锁保护的缓存写入。纯只读 + 本地表，线程安全。"""
 973:     try:
 974:         with get_db_session() as db:
 975:             r = _compute_dashboard(code, db)
 976:         if r:
 977:             _dash_cache_set(code, r)  # 内部已加锁
 978:             return code, r
 979:         return code, {"error": "该股票暂无特征数据，请确认已加入自选或当日数据已采集", "code": code}
 980:     except Exception as e:
 981:         logger.exception(f"[stock-dashboard-batch] {code} 计算失败: {e}")
 982:         return code, {"error": str(e)[:200], "code": code}
 983: @router.get("/api/stock-dashboard/batch")
 984: async def stock_dashboard_batch(
 985:     codes: str = Query(..., description="逗号分隔的 ts_code 列表，最多 50 只"),
 986:     refresh: bool = Query(False, description="true 时强制重算并刷新缓存（手动重试 / 扫描后拉最新）"),
 987: ):
 988:     """批量获取股票决策仪表盘：用于策略中心 / 共振页一次性渲染多只股票。
 989:     返回 {results: {code: dashboard_dict 或 {error: ...}}}，顺序与 codes 一致。
 990:     命中 6h 缓存瞬时返回；未命中部分交线程池并行计算（独立 session，线程安全）。
 991:     """
 992:     code_list = [c.strip() for c in codes.split(',') if c.strip()]
 993:     code_list = code_list[:50]  # 上限 50，防止滥用
 994:     # 1) 先处理 refresh 清理 + 缓存命中（加锁），划分命中 / 未命中
 995:     results = {}
 996:     miss = []
 997:     for code in code_list:
 998:         if refresh:
 999:             _dash_cache_pop(code)
1000:         cached = _dash_cache_get(code)  # 内部已加锁
1001:         if cached is not None:
1002:             results[code] = cached
1003:         else:
1004:             miss.append(code)
1005:     # 2) 未命中部分交给线程池并行计算（独立 DB session，线程安全）
1006:     if miss:
1007:         loop = asyncio.get_running_loop()
1008:         ex = _get_executor()
1009:         futures = [loop.run_in_executor(ex, _compute_one, code) for code in miss]
1010:         for code, r in await asyncio.gather(*futures):
1011:             results[code] = r
1012:     # 3) 按请求顺序组装，保证与 codes 一一对应
1013:     ordered = {c: results.get(c, {"error": "计算未完成", "code": c}) for c in code_list}
1014:     return {"results": ordered, "count": len(ordered)}
1015: @router.get("/api/stock-dashboard/{code}")
1016: async def stock_dashboard(code: str, refresh: bool = Query(False, description="true 时强制重算并刷新缓存")):
1017:     """单个股票决策仪表盘（8维指数 + 操作建议）"""
1018:     # 0) 强制刷新：清掉旧缓存
1019:     if refresh:
1020:         _dash_cache_pop(code)
1021:     # 1) 缓存命中直接返回
1022:     cached = _dash_cache_get(code)
1023:     if cached is not None:
1024:         return cached
1025:     # 2) 缓存未命中，正常计算并写入缓存
1026:     with get_db_session() as db:
1027:         result = _compute_dashboard(code, db)
1028:     if not result:
1029:         return {"error": "该股票暂无特征数据，请确认已加入自选或当日数据已采集", "code": code}
1030:     _dash_cache_set(code, result)
