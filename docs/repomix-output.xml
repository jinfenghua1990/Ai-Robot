  1: #!/usr/bin/env python3
  2: # -*- coding: utf-8 -*-
  3: """
  4: 🐉 青龙 - MA10主升浪回踩策略
  5: 从 /Users/gino/Downloads/青龙白虎双策略核心选股代码(1).py 迁移
  6: 数据源：新浪API → pytdx（collectors.tdx_collector）
  7: 核心逻辑：
  8: 1. MA10连续3天向上
  9: 2. 近20日累计涨幅 > 30%（超强主升浪）
 10: 3. 收盘价 > MA10（不破位）
 11: 4. 最低价 ≤ MA10（真回踩）
 12: 5. 偏离MA10 < 5%
 13: 5维度评分（下影线/涨幅/量比/RSI/偏离度），≥5分入选
 14: """
 15: import sys, os
 16: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 17: import numpy as np
 18: from .baihu_v30 import get_kline_from_tdx, calc_rsi
 19: import logging
 20: logger = logging.getLogger(__name__)
 21: # ============================================================
 22: # 工具函数
 23: # ============================================================
 24: def calc_ma(kline, day_index, period):
 25:     """计算指定日期的MA均线"""
 26:     closes = []
 27:     for i in range(max(0, day_index - period + 1), day_index + 1):
 28:         closes.append(float(kline[i]['close']))
 29:     return sum(closes) / len(closes) if closes else 0
 30: # ============================================================
 31: # 🐉 青龙 - MA10主升浪回踩策略
 32: # ============================================================
 33: def qinglong_strategy(kline, day_index=-1):
 34:     """
 35:     青龙策略：MA10主升浪回踩
 36:     特点：高弹性，抓翻倍股，89%概率赚20%+
 37:     参数:
 38:         kline: K线数据列表，每个元素是 dict，需包含 close/open/low/high/volume 字段
 39:         day_index: 检查哪一天（默认-1，即最新一天）
 40:     返回:
 41:         符合条件返回评分字典，不符合返回None
 42:     """
 43:     try:
 44:         # 统一处理 day_index=-1，避免 kline[:0] 切片为空的BUG
 45:         if day_index == -1:
 46:             day_index = len(kline) - 1
 47:         if day_index < 0 or day_index >= len(kline):
 48:             return None
 49:         # ========== 【5个必过硬门槛】 ==========
 50:         # 1. MA10连续3天向上（预计算，避免重复切片）
 51:         start_idx = max(0, day_index - 4)
 52:         closes = [float(k['close']) for k in kline[:day_index + 1]]
 53:         ma10_list = []
 54:         for i in range(start_idx, min(day_index + 1, len(closes))):
 55:             if i >= 9:
 56:                 ma10_list.append(sum(closes[i-9:i+1]) / 10.0)
 57:         if len(ma10_list) < 3:
 58:             return None
 59:         if not all(ma10_list[j] < ma10_list[j + 1] for j in range(len(ma10_list) - 3, len(ma10_list) - 1)):
 60:             return None
 61:         # 2. 近20日累计涨幅 > 30%（必须是超强主升浪）
 62:         if len(closes) < 21:
 63:             return None
 64:         close_20day_ago = closes[-21]
 65:         recent_20day_gain = (closes[-1] - close_20day_ago) / close_20day_ago * 100
 66:         if recent_20day_gain < 30:
 67:             return None
 68:         latest = kline[day_index]
 69:         prev = kline[day_index - 1]
 70:         close = float(latest['close'])
 71:         low = float(latest['low'])
 72:         ma10 = ma10_list[-1]
 73:         # 3. 收盘价 > MA10（不能破位）
 74:         if close <= ma10:
 75:             return None
 76:         # 4. 最低价 ≤ MA10（必须真回踩，不能离太远）
 77:         if low > ma10:
 78:             return None
 79:         # 5. 收盘价偏离MA10 < 5%（更贴近均线）
 80:         deviation = (close - ma10) / ma10 * 100
 81:         if deviation >= 5:
 82:             return None
 83:         # ========== 【其他指标计算】 ==========
 84:         open_p = float(latest['open'])
 85:         prev_close = float(prev['close'])
 86:         volume = float(latest['volume'])
 87:         change_pct = (close - prev_close) / prev_close * 100
 88:         lower_shadow = (min(close, open_p) - low) / prev_close * 100
 89:         rsi = calc_rsi(closes)
 90:         recent_vols = [float(kline[day_index - j]['volume']) for j in range(1, 6)]
 91:         avg_vol = np.mean(recent_vols)
 92:         vol_ratio = (volume / avg_vol * 100) if avg_vol > 0 else 999
 93:         # ========== 【5维度评分系统（满分8分，≥5分入选）】 ==========
 94:         score = 0
 95:         # 1. 下影线 > 0.5%（+2分）
 96:         if lower_shadow > 0.5:
 97:             score += 2
 98:         # 2. 当日涨幅 -2% ~ 4%（+2分）
 99:         if -2 <= change_pct <= 4:
100:             score += 2
101:         # 3. 量比 < 100%（+1分）
102:         if vol_ratio < 100:
103:             score += 1
104:         # 4. RSI 30 ~ 65（+1分）
105:         if 30 <= rsi <= 65:
106:             score += 1
107:         # 5. 偏离MA10 0% ~ 3%（+2分）
108:         if 0 < deviation < 3:
109:             score += 2
110:         # 及格线：≥5分
111:         if score < 5:
112:             return None
113:         return {
114:             'strategy': '青龙',
115:             'score': score,
116:             '20day_gain': round(recent_20day_gain, 2),
117:             'deviation': round(deviation, 2),
118:             'change_pct': round(change_pct, 2),
119:             'rsi': round(rsi, 2),
120:             'vol_ratio': round(vol_ratio, 2),
121:             'lower_shadow': round(lower_shadow, 2),
122:             'ma10': round(ma10, 2),
123:             'close': round(close, 2),
124:             'date': latest.get('day', ''),
125:         }
126:     except Exception:
127:         logger.debug(f"function failed", exc_info=True)
128:         return None
129: # ============================================================
130: # 批量选股
131: # ============================================================
132: def run_qinglong_screen(stock_list, trade_date=None):
133:     """
134:     批量执行青龙选股
135:     参数:
136:         stock_list: 股票代码列表（支持 'sz301171' 或 '000001.SZ' 格式）
137:         trade_date: 交易日期（可选，仅用于记录，不影响筛选逻辑）
138:     返回:
139:         符合条件的股票结果列表，每个元素含评分字典 + ts_code
140:     """
141:     results = []
142:     for ts_code in stock_list:
143:         kline = get_kline_from_tdx(ts_code)
144:         if kline and len(kline) >= 30:
145:             result = qinglong_strategy(kline)
146:             if result:
147:                 result['ts_code'] = ts_code
148:                 if trade_date:
149:                     result['trade_date'] = trade_date
150:                 results.append(result)
151:     return results
152: if __name__ == "__main__":
153:     print("=" * 80)
154:     print("🐉 青龙 - MA10主升浪回踩策略 (pytdx版)")
155:     print("=" * 80)
156:     sample = ['sz301117']
157:     hits = run_qinglong_screen(sample)
158:     for h in hits:
159:         print(f"✅ {h['ts_code']} 评分{h['score']} 偏离{h['deviation']}% 量比{h['vol_ratio']}%")
