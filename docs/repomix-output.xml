  1: """
  2: 白虎 V3.0 策略选股 API（全市场适配版）
  3: 独立于生命周期系统，返回5维度评分分解
  4: """
  5: import threading
  6: import concurrent.futures
  7: import logging
  8: from fastapi import APIRouter, Query
  9: from db.connection import get_db
 10: from db.session import get_db_session
 11: from db.models import StockFlow
 12: from strategies.baihu_v30 import get_kline_from_tdx, baihu_strategy_v30
 13: from api.validators import validate_date
 14: from services.signal_builder import build_signals_batch, build_signals_from_strategy_result, _enrich_signals_with_watchlist_extras
 15: from utils.cache import BoundedDict
 16: logger = logging.getLogger(__name__)
 17: router = APIRouter()
 18: # 线程本地K线缓存（避免重复请求通达信）
 19: _kline_cache = BoundedDict(maxsize=100)
 20: _cache_lock = threading.Lock()
 21: def _get_kline_cached(ts_code, days=360):
 22:     """带缓存的K线获取"""
 23:     with _cache_lock:
 24:         if ts_code in _kline_cache:
 25:             return _kline_cache[ts_code]
 26:     kline = get_kline_from_tdx(ts_code, days)
 27:     if kline:
 28:         with _cache_lock:
 29:             _kline_cache[ts_code] = kline
 30:     return kline
 31: def _screen_one(ts_code, trade_date):
 32:     """单只股票筛选（用于线程池）"""
 33:     try:
 34:         kline = _get_kline_cached(ts_code, 360)
 35:         if kline and len(kline) >= 30:
 36:             result = baihu_strategy_v30(kline)
 37:             if result:
 38:                 result['ts_code'] = ts_code
 39:                 if trade_date:
 40:                     result['trade_date'] = trade_date
 41:                 return result
 42:     except Exception:
 43:         logger.debug(f"_screen_one fallback", exc_info=True)
 44:         logger.debug('handled exception', exc_info=True)
 45:     return None
 46: @router.get("/api/baihu-screen")
 47: async def baihu_screen(date: str = Query(None)):
 48:     """白虎V3.0强势回调选股（全市场适配）"""
 49:     trade_date = validate_date(date)
 50:     try:
 51:         with get_db_session() as db:
 52:             # 优先读预计算表（盘后定时扫描已落库 strategy_key='baihu_v30'），命中则跳过现场扫描
 53:             _precomputed = await build_signals_from_strategy_result(db, 'baihu_v30', trade_date)
 54:             if _precomputed is not None:
 55:                 return {
 56:                     'date': trade_date,
 57:                     'stocks': _precomputed,
 58:                     'total': len(_precomputed),
 59:                     'candidate_count': len(_precomputed),
 60:                     'formula': _formula_meta(),
 61:                     'message': 'ok(预计算)',
 62:                 }
 63:             # 1. 获取全市场当日主力净流入>0的候选股票，按主力净流入降序取前50只
 64:             candidates = db.query(StockFlow).filter(
 65:                 StockFlow.trade_date == trade_date,
 66:                 StockFlow.main_force_inflow > 0,
 67:             ).order_by(StockFlow.main_force_inflow.desc()).limit(50).all()
 68:             stock_list = [c.ts_code for c in candidates]
 69:             stock_name_map = {c.ts_code: c.name for c in candidates}
 70:             stock_sector_map = {c.ts_code: c.sector for c in candidates}
 71:             if not stock_list:
 72:                 return {
 73:                     'date': trade_date,
 74:                     'stocks': [],
 75:                     'total': 0,
 76:                     'candidate_count': 0,
 77:                     'formula': _formula_meta(),
 78:                     'message': '无候选股票',
 79:                 }
 80:             # 2. 并发执行白虎V3.0策略选股（最多20线程，30秒超时）
 81:             hits = []
 82:             with concurrent.futures.ThreadPoolExecutor(max_workers=20) as executor:
 83:                 futures = {executor.submit(_screen_one, code, trade_date): code for code in stock_list}
 84:                 for future in concurrent.futures.as_completed(futures, timeout=30):
 85:                     try:
 86:                         result = future.result(timeout=5)
 87:                         if result:
 88:                             hits.append(result)
 89:                     except Exception:
 90:                         logger.debug(f"function fallback", exc_info=True)
 91:                         logger.debug('handled exception', exc_info=True)
 92:             # 3. 格式化结果（含5维度评分分解）
 93:             results = []
 94:             for h in hits:
 95:                 ts_code = h.get('ts_code', '')
 96:                 scores = h.get('scores', {})
 97:                 results.append({
 98:                     'ts_code': ts_code,
 99:                     'name': stock_name_map.get(ts_code, ''),
100:                     'sector': stock_sector_map.get(ts_code, ''),
101:                     'score': float(h.get('score', 0)),
102:                     'mode': h.get('mode', ''),
103:                     'close': float(h.get('close', 0)),
104:                     'ma5': float(h.get('ma5', 0)),
105:                     'ma10': float(h.get('ma10', 0)),
106:                     'ma20': float(h.get('ma20', 0)),
107:                     'change_pct': round(float(h.get('change_pct', 0)), 2),
108:                     'deviation': round(float(h.get('deviation', 0)), 2),
109:                     'rsi': round(float(h.get('rsi', 0)), 1),
110:                     'vol_ratio': round(float(h.get('vol_ratio', 0)), 1),
111:                     'lower_shadow': round(float(h.get('lower_shadow', 0)), 2),
112:                     '20day_gain': round(float(h.get('20day_gain', 0)), 2),
113:                     'distance_to_high_20': round(float(h.get('distance_to_high_20', 0)), 2),
114:                     'scores': scores,
115:                 })
116:             # 按评分降序
117:             results.sort(key=lambda x: -x['score'])
118:             # 4. 构造完整 signal 数据（与自选股/重点关注口径一致）
119:             enriched_stocks = await build_signals_batch(
120:                 results, db,
121:                 code_key='ts_code', name_key='name', sector_key='sector',
122:                 stage_key=None, strength_key='score',
123:                 change_key='change_pct',
124:             )
125:             # 保留白虎原始字段
126:             stock_meta = {r['ts_code']: r for r in results}
127:             for s in enriched_stocks:
128:                 meta = stock_meta.get(s['secCode'])
129:                 if meta:
130:                     s['strategyScore'] = meta.get('score', 0)
131:                     s['strategyMode'] = meta.get('mode', '')
132:                     s['deviation'] = meta.get('deviation', 0)
133:                     s['rsi'] = meta.get('rsi', 0)
134:                     s['scores'] = meta.get('scores', {})
135:                     s['lowerShadow'] = meta.get('lower_shadow', 0)
136:                     s['ma20'] = meta.get('ma20', 0)
137:                     s['ma10'] = meta.get('ma10', 0)
138:                     s['ma5'] = meta.get('ma5', 0)
139:                     s['volRatio'] = meta.get('vol_ratio', 0)
140:                     s['20dayGain'] = meta.get('20day_gain', 0)
141:                     s['distanceToHigh20'] = meta.get('distance_to_high_20', 0)
142:             # 补充自选股个股模块字段（moneyFlow/hitTags/actionHint），让 SignalCard 显示完整信息
143:             await _enrich_signals_with_watchlist_extras(db, enriched_stocks)
144:             return {
145:                 'date': trade_date,
146:                 'stocks': enriched_stocks,
147:                 'total': len(enriched_stocks),
148:                 'candidate_count': len(stock_list),
149:                 'formula': _formula_meta(),
150:         }
151:     except Exception as e:
152:         logger.exception(f'[baihu] Error')
153:         return {'error': str(e), 'stocks': []}
