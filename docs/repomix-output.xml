336: def resolve_backtest_pool(
337:     pool_source: Optional[str] = None,
338:     symbols: Optional[list[str]] = None,
339: ) -> tuple[list[str], str, Optional[list[str]]]:
340:     """解析回测股票池
341:     优先级:
342:     1. 显式传入 symbols
343:     2. 指定 pool_source（从 universe_memberships 读取）
344:     3. 默认使用 US_CORE_A
345:     Returns:
346:         (symbols列表, pool_source名称, pool_snapshot)
347:     """
348:     if symbols:
349:         return symbols, pool_source or "custom", symbols
350:     source = (pool_source or DEFAULT_BACKTEST_POOL_SOURCE).upper()
351:     # 从 universe_memberships 读取
352:     members = get_universe_members(source)
353:     if members:
354:         logger.info(f"[backtest] 从 universe_memberships 读取池 {source}: {len(members)} 只")
355:         return members, source, list(members)
356:     # 兜底：使用 US_CORE_A
357:     fallback = get_universe_members("US_CORE_A")
358:     if fallback:
359:         logger.warning(f"[backtest] 池 {source} 为空，回退到 US_CORE_A: {len(fallback)} 只")
360:         return fallback, "US_CORE_A", list(fallback)
361:     # 最后兜底
362:     logger.warning("[backtest] 所有池为空，返回空列表")
363:     return [], source, []
364: def run_backtest_batch(
365:     symbols: Optional[list[str]] = None,
366:     strategy: str = "ALL",
367:     start_date: Optional[str] = None,
368:     end_date: Optional[str] = None,
369:     save_to_db: bool = True,
370:     pool_source: Optional[str] = None,
371: ) -> list[BacktestMetrics]:
372:     """批量回测多个股票
373:     V2.2: 股票池从 universe_memberships 读取，不再硬编码。
374:     Args:
375:         symbols: 股票代码列表，None 则从 universe_memberships 读取
376:         strategy: 策略名称
377:         start_date: 开始日期
378:         end_date: 结束日期
379:         save_to_db: 是否保存到数据库
380:         pool_source: 股票池代码（如 US_CORE_A），默认使用 US_CORE_A
381:     Returns:
382:         回测结果列表
383:     """
384:     resolved_symbols, pool_name, pool_snapshot = resolve_backtest_pool(pool_source, symbols)
385:     if not resolved_symbols:
386:         logger.warning("[backtest] 无股票可回测")
387:         return []
388:     results = []
389:     for sym in resolved_symbols:
390:         try:
391:             metrics = run_backtest(sym, strategy, start_date, end_date)
392:             results.append(metrics)
393:             logger.info(f"[backtest] {sym} ({strategy}): {metrics.total_trades} trades, "
394:                         f"WR={metrics.win_rate}%, PnL={metrics.total_pnl_pct}%")
395:         except Exception as e:
396:             logger.error(f"[backtest] {sym} error: {e}")
397:     if save_to_db:
398:         _save_backtest_results(results, strategy, pool_source=pool_name, pool_snapshot=pool_snapshot)
399:     return results
400: def _save_backtest_results(
401:     results: list[BacktestMetrics],
402:     strategy: str,
403:     pool_source: str = "",
404:     pool_snapshot: Optional[list[str]] = None,
405: ):
406:     """保存回测结果到数据库（V2.2: 包含池快照）"""
407:     run_id = datetime.now().strftime("%Y%m%d_%H%M%S")
408:     try:
409:         with get_db_session() as db:
410:             for m in results:
411:                 if m.total_trades == 0:
412:                     continue
413:                 row = USBacktestResult(
414:                     run_id=run_id,
415:                     symbol=m.symbol,
416:                     strategy=strategy,
417:                     pool_source=pool_source or None,
418:                     pool_snapshot=pool_snapshot,
419:                     total_trades=m.total_trades,
420:                     winning_trades=m.winning_trades,
421:                     losing_trades=m.losing_trades,
422:                     win_rate=Decimal(str(m.win_rate)),
423:                     total_pnl=Decimal(str(m.total_pnl)),
424:                     total_pnl_pct=Decimal(str(m.total_pnl_pct)),
425:                     avg_win=Decimal(str(m.avg_win)) if m.avg_win else None,
426:                     avg_loss=Decimal(str(m.avg_loss)) if m.avg_loss else None,
427:                     profit_factor=Decimal(str(m.profit_factor)) if m.profit_factor != float("inf") else None,
428:                     max_drawdown_pct=Decimal(str(m.max_drawdown_pct)),
429:                     sharpe_ratio=Decimal(str(m.sharpe_ratio)) if m.sharpe_ratio else None,
430:                     avg_bars_held=Decimal(str(m.avg_bars_held)),
431:                     run_at=datetime.now(),
432:                 )
433:                 db.add(row)
434:                 # 保存每笔交易详情
435:                 for t in m.trades:
436:                     trade_row = USBacktestTrade(
437:                         run_id=run_id,
438:                         symbol=t.symbol,
439:                         strategy=t.strategy,
440:                         entry_date=t.entry_date,
441:                         entry_price=Decimal(str(t.entry_price)),
442:                         exit_date=t.exit_date,
443:                         exit_price=Decimal(str(t.exit_price)) if t.exit_price else None,
444:                         direction=t.direction,
445:                         shares=t.shares,
446:                         pnl=Decimal(str(t.pnl)) if t.pnl else None,
447:                         pnl_pct=Decimal(str(t.pnl_pct)) if t.pnl_pct else None,
448:                         bars_held=t.bars_held,
449:                         exit_reason=t.exit_reason,
450:                     )
451:                     db.add(trade_row)
452:             db.commit()
453:             logger.info(f"[backtest] 保存 {len(results)} 条回测结果 (run_id={run_id})")
454:     except Exception as e:
455:         logger.error(f"[backtest] 保存回测结果失败: {e}")
