  1: """US Quant System — 股票池过滤
  2: 硬过滤条件：
  3:   - 价格 >= $10
  4:   - 市值 >= 20亿
  5:   - 上市天数 >= 250
  6:   - 20日均成交额 >= 1亿
  7:   - 排除OTC
  8:   - 排除杠杆ETF
  9:   - 排除反向ETF
 10:   - 排除SPAC
 11:   - 要求完整数据
 12: """
 13: from __future__ import annotations
 14: from dataclasses import dataclass, field
 15: from typing import Optional
 16: @dataclass
 17: class FilterResult:
 18:     """过滤结果"""
 19:     passed: bool = False
 20:     reasons: list[str] = field(default_factory=list)
 21: def check_hard_filters(
 22:     price: Optional[float] = None,
 23:     market_cap: Optional[float] = None,
 24:     listing_days: Optional[int] = None,
 25:     avg_dollar_volume_20d: Optional[float] = None,
 26:     is_otc: bool = False,
 27:     is_leveraged_etf: bool = False,
 28:     is_inverse_etf: bool = False,
 29:     is_spac: bool = False,
 30:     has_complete_data: bool = True,
 31:     bid_ask_spread: Optional[float] = None,
 32:     is_suspended: bool = False,
 33: ) -> FilterResult:
 34:     """执行硬过滤检查"""
 35:     reasons = []
 36:     passed = True
 37:     if price is not None and price < 10:
 38:         reasons.append(f"价格 ${price} < $10")
 39:         passed = False
 40:     if market_cap is not None and market_cap < 2_000_000_000:
 41:         reasons.append(f"市值 ${market_cap/1e9:.1f}B < $20亿")
 42:         passed = False
 43:     if listing_days is not None and listing_days < 250:
 44:         reasons.append(f"上市天数 {listing_days} < 250")
 45:         passed = False
 46:     if avg_dollar_volume_20d is not None and avg_dollar_volume_20d < 100_000_000:
 47:         reasons.append(f"日均成交额 ${avg_dollar_volume_20d/1e6:.0f}M < $1亿")
 48:         passed = False
 49:     if is_otc:
 50:         reasons.append("OTC股票")
 51:         passed = False
 52:     if is_leveraged_etf:
 53:         reasons.append("杠杆ETF")
 54:         passed = False
 55:     if is_inverse_etf:
 56:         reasons.append("反向ETF")
 57:         passed = False
 58:     if is_spac:
 59:         reasons.append("SPAC")
 60:         passed = False
 61:     if not has_complete_data:
 62:         reasons.append("数据不完整")
 63:         passed = False
 64:     if bid_ask_spread is not None and bid_ask_spread > 0.002:
 65:         reasons.append(f"价差 {bid_ask_spread*100:.2f}% > 0.20%")
 66:         passed = False
 67:     if is_suspended:
 68:         reasons.append("停牌")
 69:         passed = False
 70:     return FilterResult(passed=passed, reasons=reasons)
 71: def check_premarket_filters(
 72:     premarket_change_pct: Optional[float] = None,
 73:     premarket_volume: Optional[float] = None,
 74:     premarket_dollar_volume: Optional[float] = None,
 75:     relative_volume: Optional[float] = None,
 76:     spread: Optional[float] = None,
 77:     price: Optional[float] = None,
 78:     avg_dollar_volume_20d: Optional[float] = None,
 79:     has_catalyst: bool = False,
 80: ) -> FilterResult:
 81:     """盘前过滤条件"""
 82:     reasons = []
 83:     passed = True
 84:     if premarket_change_pct is not None:
 85:         if premarket_change_pct < 2 or premarket_change_pct > 8:
 86:             reasons.append(f"盘前涨幅 {premarket_change_pct:.1f}% 不在 2%-8% 范围")
 87:             passed = False
 88:     if premarket_dollar_volume is not None and premarket_dollar_volume < 5_000_000:
 89:         reasons.append(f"盘前成交额 ${premarket_dollar_volume/1e6:.1f}M < $500万")
 90:         passed = False
 91:     if relative_volume is not None and relative_volume < 2:
 92:         reasons.append(f"相对成交量 {relative_volume:.1f} < 2")
 93:         passed = False
 94:     if spread is not None and spread > 0.002:
 95:         reasons.append(f"价差 {spread*100:.2f}% > 0.20%")
 96:         passed = False
 97:     if price is not None and price < 10:
 98:         reasons.append(f"股价 ${price} < $10")
 99:         passed = False
100:     if avg_dollar_volume_20d is not None and avg_dollar_volume_20d < 100_000_000:
101:         reasons.append(f"日均成交额 ${avg_dollar_volume_20d/1e6:.0f}M < $1亿")
102:         passed = False
103:     if not has_catalyst:
104:         reasons.append("无明确催化")
105:         passed = False
106:     return FilterResult(passed=passed, reasons=reasons)
