138:           stockCode={selected.code}
139:           stockName={selected.name}
140:           type="buy"
141:           positionCount={0}
142:           onClose={() => { setModalOpen(false); setQuery(''); setSelected(null); }}
143:           onConfirm={executeTrade}
144:         />
145:       )}
146:     </>
147:   );
148: }
