206:                     'top_sectors': [{'sector': sec, 'count': len(lst), 'leaders': lst[:3]} for sec, lst in leader_top_sectors],
207:                 },
208:                 'recommendations': {
209:                     'reduce': reduce_list,
210:                     'increase': increase_list,
211:                 },
212:                 'allocation': allocation,
213:                 'risk_control': risk_control,
