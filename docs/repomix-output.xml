 16:  * 与板块热度左栏一致的视觉语言。
 17:  * sectors: 父组件传入的已选概念列表（与实时右侧同维度）
 18:  * 右侧板块名称+数值用外部 HTML 标签层渲染，强制最小间距，永不重叠
 19:  */
 20: export default function AfterConceptSectorFlowSection({ selectedDate, sectors, selectedSector, onSelectSector }) {
 21:   const [rankData, setRankData] = useState(null);
 22:   const [trendData, setTrendData] = useState(null);
 23:   const [loading, setLoading] = useState(false);
 24:   const [error, setError] = useState(null);
 25:   const chartRef = useRef(null);
 26:   // 1. 拉取排名数据（用于回显 actual_date）
 27:   useEffect(() => {
 28:     if (!selectedDate) return;
 29:     const controller = new AbortController();
 30:     setLoading(true);
 31:     setError(null);
 32:     setTrendData(null);
 33:     (async () => {
 34:       const { ok, data } = await apiFetch(`/api/concept-sector-flow-rank?date=${selectedDate}`, { signal: controller.signal });
 35:       if (controller.signal.aborted) return;
 36:       if (ok) setRankData(data);
 37:       else setError(data?.detail || '加载失败');
 38:       setLoading(false);
 39:     })();
 40:     return () => controller.abort();
 41:   }, [selectedDate]);
 42:   // 用父组件传入的 sectors，不再自动取 Top10
 43:   const topSectors = useMemo(() => (sectors || []).slice(0, 30), [sectors]);
 44:   // 2. 拉取已选概念的 20 日趋势
 45:   useEffect(() => {
 46:     if (!selectedDate || topSectors.length === 0) {
 47:       setTrendData(null);
 48:       return;
 49:     }
 50:     const controller = new AbortController();
 51:     (async () => {
 52:       const names = topSectors.join(',');
 53:       const { ok, data } = await apiFetch(
 54:         `/api/concept-sector-flow-trend?date=${selectedDate}&days=20&sectors=${encodeURIComponent(names)}`,
 55:         { signal: controller.signal }
 56:       );
 57:       if (controller.signal.aborted) return;
 58:       if (ok) setTrendData(data);
 59:     })();
 60:     return () => controller.abort();
 61:   }, [selectedDate, topSectors]);
