  1: #!/usr/bin/env python3
  2: # -*- coding: utf-8 -*-
  3: """
  4: 📊 MACD 金叉策略 (macd_golden_cross)
  5: 核心逻辑：
  6: 1. MACD 金叉：DIF 由下穿 DEA 转为上穿（昨天下穿、今天上穿）
  7: 2. 柱状线由负转正或已为正
  8: 3. 收盘价站上 MA20
  9: 4. MA20 向上
 10: 与现有策略差异：
 11: - 白虎/青龙/主升浪都偏"已上涨"型，本策略捕捉"刚启动"型
 12: - DIF/DEA 是中期趋势指标，与 MA 类短期指标互补
 13: - 金叉比"金叉后第 N 天"信号更早
 14: 评分（满分 8 分，≥ 5 分入选）：
 15: - 金叉强度（+2）：DIF-DEA 交叉点接近 0
 16: - 柱状线状态（+2）：柱状线 > 0 且增大
 17: - 价格站上 MA20（+1）
 18: - MA20 向上（+1）
 19: - 量能配合（+2）：成交量 ≥ 近 5 日均量 × 1.2
 20: """
 21: import sys, os
 22: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 23: import numpy as np
 24: import logging
 25: logger = logging.getLogger(__name__)
 26: def calc_ema(series, period):
 27:     """计算 EMA（指数移动平均）"""
 28:     if len(series) < period:
 29:         return []
 30:     ema = [sum(series[:period]) / period]
 31:     multiplier = 2 / (period + 1)
 32:     for price in series[period:]:
 33:         ema.append((price - ema[-1]) * multiplier + ema[-1])
 34:     return ema
 35: def calc_macd(closes, short=12, long_=26, signal=9):
 36:     """计算 MACD（DIF, DEA, HIST）"""
 37:     if len(closes) < long_ + signal:
 38:         return None, None, None
 39:     ema_short = calc_ema(closes, short)
 40:     ema_long = calc_ema(closes, long_)
 41:     # 对齐到 ema_long 的索引
 42:     offset = len(ema_short) - len(ema_long)
 43:     dif = [ema_short[i + offset] - ema_long[i] for i in range(len(ema_long))]
 44:     dea = calc_ema(dif, signal)
 45:     offset2 = len(dif) - len(dea)
 46:     hist = [(dif[i + offset2] - dea[i]) * 2 for i in range(len(dea))]
