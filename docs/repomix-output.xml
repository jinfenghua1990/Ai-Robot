733:                 { key: 'avoid', label: '暂不参与', count: liangjiaData.avoid_count || 0, color: '#6b7280', desc: '高位、破位或性价比不足' },
734:               ].map(t => (
735:                 <button key={t.key} onClick={() => setLiangjiaTier(t.key)}
