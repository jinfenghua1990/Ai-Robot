 1: from __future__ import annotations
 2: from contextlib import contextmanager
 3: from typing import Any, Iterable
 4: from sqlalchemy import create_engine, text
 5: from .config import DATABASE_URL
 6: engine = create_engine(
 7:     DATABASE_URL,
 8:     pool_pre_ping=True,
 9:     pool_size=5,
10:     max_overflow=5,
11:     future=True,
12: )
13: @contextmanager
14: def connection():
15:     with engine.begin() as conn:
16:         yield conn
17: def fetch_all(sql: str, params: dict[str, Any] | None = None) -> list[dict[str, Any]]:
18:     with engine.connect() as conn:
19:         return [dict(row._mapping) for row in conn.execute(text(sql), params or {})]
20: def fetch_one(sql: str, params: dict[str, Any] | None = None) -> dict[str, Any] | None:
21:     with engine.connect() as conn:
22:         row = conn.execute(text(sql), params or {}).mappings().first()
23:         return dict(row) if row else None
24: def execute(sql: str, params: dict[str, Any] | None = None) -> None:
25:     with engine.begin() as conn:
26:         conn.execute(text(sql), params or {})
27: def execute_many(sql: str, rows: Iterable[dict[str, Any]]) -> None:
28:     payload = list(rows)
29:     if not payload:
30:         return
31:     with engine.begin() as conn:
32:         conn.execute(text(sql), payload)
