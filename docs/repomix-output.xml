 97:             style={{ borderColor: autoRefresh ? '#22c55e' : 'var(--border-color)', color: autoRefresh ? '#22c55e' : 'var(--text-secondary)', background: autoRefresh ? 'rgba(34,197,94,0.1)' : 'transparent' }}>
