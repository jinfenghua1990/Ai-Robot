<file path="backend/us_quant/sector_rotation.py">
  1: """US Quant System — 行业轮动评分
  2: 13个行业ETF评分体系：
  3:   指标                    | 分数
  4:   -----------------------|-----
  5:   5日收益                 | 10
  6:   20日收益                | 20
  7:   60日收益                | 20
  8:   相对SPY 20日强度        | 15
  9:   相对SPY 60日强度        | 15
 10:   均线趋势                | 10
 11:   成交量活跃度            | 10
 12: 等级：
 13:   80-100: 强势主线
 14:   70-79:  重点关注
 15:   60-69:  观察
 16:   <60:    不优先
 17: """
 18: from __future__ import annotations
 19: from typing import Optional
 20: from .contracts import IndexQuote, SectorScore
 21: # 13个行业ETF
 22: SECTOR_ETFS = [
 23:     ("XLK", "科技", "Technology"),
 24:     ("SMH", "半导体", "Semiconductors"),
 25:     ("SOXX", "芯片", "Chips"),
 26:     ("XLC", "通信", "Communication"),
 27:     ("XLY", "消费", "Consumer Cyclical"),
 28:     ("XLF", "金融", "Financial"),
 29:     ("XLI", "工业", "Industrial"),
 30:     ("XLV", "医疗", "Health Care"),
 31:     ("XLE", "能源", "Energy"),
 32:     ("XLB", "材料", "Materials"),
 33:     ("XLP", "必需消费", "Consumer Defensive"),
 34:     ("XLU", "公用事业", "Utilities"),
 35:     ("XLRE", "房地产", "Real Estate"),
 36: ]
 37: def score_sector(
 38:     etf_symbol: str,
 39:     etf_name: str,
 40:     industry: str,
 41:     closes_5d: Optional[list[float]] = None,
 42:     closes_20d: Optional[list[float]] = None,
 43:     closes_60d: Optional[list[float]] = None,
 44:     spy_closes_20d: Optional[list[float]] = None,
 45:     spy_closes_60d: Optional[list[float]] = None,
 46:     volumes_20d: Optional[list[float]] = None,
 47:     avg_volume_20d: Optional[float] = None,
 48:     ma20: Optional[float] = None,
 49:     ma50: Optional[float] = None,
 50:     current_price: Optional[float] = None,
 51:     rank: int = 0,
 52: ) -> SectorScore:
 53:     """计算单个行业评分"""
 54:     def _ret(closes) -> float:
 55:         if not closes or len(closes) < 2:
 56:             return 0.0
 57:         return (closes[-1] - closes[0]) / closes[0] * 100
 58:     ret_5d = _ret(closes_5d) if closes_5d else 0.0
 59:     ret_20d = _ret(closes_20d) if closes_20d else 0.0
 60:     ret_60d = _ret(closes_60d) if closes_60d else 0.0
 61:     spy_ret_20d = _ret(spy_closes_20d) if spy_closes_20d else 0.0
 62:     spy_ret_60d = _ret(spy_closes_60d) if spy_closes_60d else 0.0
 63:     # 相对强度
 64:     rel_20d = ret_20d - spy_ret_20d if spy_closes_20d else 0.0
 65:     rel_60d = ret_60d - spy_ret_60d if spy_closes_60d else 0.0
 66:     # 均线趋势
 67:     ma_trend = 0.0
 68:     if ma20 and ma50 and current_price:
 69:         if current_price > ma20 > ma50:
 70:             ma_trend = 10.0
 71:         elif current_price > ma20 and ma20 > ma50:
 72:             ma_trend = 8.0
 73:         elif current_price > ma20:
 74:             ma_trend = 6.0
 75:         elif current_price > ma50:
 76:             ma_trend = 4.0
 77:         else:
 78:             ma_trend = 2.0
 79:     # 成交量活跃度
 80:     vol_activity = 0.0
 81:     if volumes_20d and avg_volume_20d and avg_volume_20d > 0:
 82:         recent_avg = sum(volumes_20d) / len(volumes_20d)
 83:         ratio = recent_avg / avg_volume_20d
 84:         if ratio > 1.5:
 85:             vol_activity = 10.0
 86:         elif ratio > 1.2:
 87:             vol_activity = 8.0
 88:         elif ratio > 0.8:
 89:             vol_activity = 6.0
 90:         else:
 91:             vol_activity = 3.0
 92:     # 分项评分
 93:     def _score_ret(v: float, max_ret: float = 10.0) -> float:
 94:         if v > max_ret:
 95:             return 1.0
 96:         return max(0.0, v / max_ret)
 97:     def _score_rel(v: float, max_rel: float = 5.0) -> float:
 98:         if v > max_rel:
 99:             return 1.0
100:         return max(0.0, v / max_rel)
101:     score_5d = round(_score_ret(ret_5d, 8.0) * 10, 1)
102:     score_20d = round(_score_ret(ret_20d, 15.0) * 20, 1)
103:     score_60d = round(_score_ret(ret_60d, 25.0) * 20, 1)
104:     score_rel_20d = round(_score_rel(rel_20d, 8.0) * 15, 1)
105:     score_rel_60d = round(_score_rel(rel_60d, 12.0) * 15, 1)
106:     total = round(score_5d + score_20d + score_60d + score_rel_20d + score_rel_60d + ma_trend + vol_activity, 1)
107:     # 等级
108:     if total >= 80:
109:         grade = "强势主线"
110:     elif total >= 70:
111:         grade = "重点关注"
112:     elif total >= 60:
113:         grade = "观察"
114:     else:
115:         grade = "不优先"
116:     return SectorScore(
117:         etf_symbol=etf_symbol,
118:         etf_name=etf_name,
119:         industry=industry,
120:         ret_5d=round(ret_5d, 2),
121:         ret_20d=round(ret_20d, 2),
122:         ret_60d=round(ret_60d, 2),
123:         rel_strength_20d=round(rel_20d, 2),
124:         rel_strength_60d=round(rel_60d, 2),
125:         ma_trend=ma_trend,
126:         volume_activity=vol_activity,
127:         total_score=total,
128:         rank=rank,
129:         grade=grade,
130:     )
131: def rank_sectors(sectors: list[SectorScore]) -> list[SectorScore]:
132:     """按总评分排序并分配排名"""
133:     sorted_sectors = sorted(sectors, key=lambda s: s.total_score, reverse=True)
134:     for i, s in enumerate(sorted_sectors):
135:         object.__setattr__(s, "rank", i + 1)
136:     return sorted_sectors
</file>

<file path="backend/us_quant/states.py">
 1: """US Quant System — 7状态体系
 2: 状态不等于信号：
 3:   状态 = 股票所处阶段
 4:   信号 = 是否允许交易
 5: 状态：
 6:   FOLLOW        — 跟随观察
 7:   WATCH         — 重点关注
 8:   ACCUMULATION  — 吸筹阶段
 9:   LAUNCH        — 启动阶段
10:   EXPANSION     — 发酵阶段
11:   MARKUP        — 主升阶段
12:   DISTRIBUTION  — 退潮阶段
13: """
14: from __future__ import annotations
15: from dataclasses import dataclass
16: from typing import Optional
17: @dataclass
18: class StockState:
19:     """股票状态"""
20:     state: str
21:     label: str
22:     signal: str  # 当前是否可以交易的建议
23: def determine_stock_state(
24:     price: Optional[float] = None,
25:     ma20: Optional[float] = None,
26:     ma50: Optional[float] = None,
27:     ma200: Optional[float] = None,
28:     high_52w: Optional[float] = None,
29:     volume_ratio: Optional[float] = None,  # 当前量/均量
30:     rsi: Optional[float] = None,
31:     consecutive_up_days: Optional[int] = None,
32:     consecutive_down_days: Optional[int] = None,
33:     change_pct_5d: Optional[float] = None,
34:     change_pct_20d: Optional[float] = None,
35: ) -> StockState:
36:     """根据技术指标判断股票所处阶段"""
37:     if not price or not ma50:
38:         return StockState(state="FOLLOW", label="跟随", signal="数据不足，继续观察")
39:     # DISTRIBUTION: 退潮
40:     if (ma20 and price < ma20 and ma20 < ma50) or (consecutive_down_days and consecutive_down_days >= 5):
41:         return StockState(
42:             state="DISTRIBUTION",
43:             label="退潮",
44:             signal="趋势走弱，不建议新开仓，持仓考虑减仓或退出",
45:         )
46:     # MARKUP: 主升
47:     if (price > ma20 and ma20 > ma50 and price > ma50) and \
48:        (consecutive_up_days and consecutive_up_days >= 3) and \
49:        (rsi and rsi > 60):
50:         return StockState(
51:             state="MARKUP",
52:             label="主升",
53:             signal="处于主升阶段，持仓可继续持有，但不宜追高加仓",
54:         )
55:     # EXPANSION: 发酵
56:     if (price > ma20 and ma20 > ma50) and \
57:        (volume_ratio and volume_ratio > 1.2) and \
58:        (change_pct_5d and change_pct_5d > 5):
59:         return StockState(
60:             state="EXPANSION",
61:             label="发酵",
62:             signal="趋势向好，量价配合，可考虑建仓或加仓",
63:         )
64:     # LAUNCH: 启动
65:     if (price > ma20 and ma20 > ma50) and \
66:        (volume_ratio and volume_ratio > 1.5) and \
67:        (change_pct_5d and change_pct_5d > 3):
68:         return StockState(
69:             state="LAUNCH",
70:             label="启动",
71:             signal="放量突破，初步启动，可考虑入场",
72:         )
73:     # ACCUMULATION: 吸筹
74:     if (ma50 and price > ma50) and \
75:        (ma20 and price < ma20 * 1.05) and \
76:        (volume_ratio is None or volume_ratio < 1.2):
77:         return StockState(
78:             state="ACCUMULATION",
79:             label="吸筹",
80:             signal="价格在均线附近整理，量能平稳，观察等待信号",
81:         )
82:     # WATCH: 关注
83:     if ma200 and price > ma200:
84:         return StockState(
85:             state="WATCH",
86:             label="关注",
87:             signal="价格在MA200之上，中期趋势尚可，但短线信号不明",
88:         )
89:     # FOLLOW: 跟随
90:     return StockState(
91:         state="FOLLOW",
92:         label="跟随",
93:         signal="继续观察，等待更明确的信号",
94:     )
</file>

<file path="backend/us_quant/strategies.py">
  1: """US Quant System — 三套独立策略评分
  2: 按照文档实现：
  3: 1. breakout_score — 平台突破 Breakout V1
  4: 2. pullback_score — 趋势回踩 Pullback V1
  5: 3. earnings_gap_score — 财报跳空 Earnings Gap V1
  6: 三套策略独立评分，不共用总分。
  7: """
  8: from __future__ import annotations
  9: from dataclasses import dataclass, field
 10: from typing import Optional
 11: @dataclass
 12: class BreakoutScore:
 13:     total: float = 0.0
