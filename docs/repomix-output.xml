 89: async def _submit_order(req, do_trade, clear_cache):
 90:     """Submit an order and return API payload plus a stable order id if any."""
 91:     result = await do_trade(req)
 92:     clear_cache()
 93:     order_id = ""
 94:     if isinstance(result, dict):
 95:         for key in ("orderId", "order_id", "id", "entrustId", "entrust_id"):
 96:             if result.get(key) not in (None, ""):
 97:                 order_id = str(result[key])
 98:                 break
 99:         nested = result.get("data")
100:         if not order_id and isinstance(nested, dict):
101:             for key in ("orderId", "order_id", "id", "entrustId", "entrust_id"):
102:                 if nested.get(key) not in (None, ""):
103:                     order_id = str(nested[key])
104:                     break
105:     return result, order_id
106: async def execute_auto_trade(db, dry_run: bool = False) -> List[Dict]:
107:     """Execute V2 signals with account-aware gates and auditable status.
108:     Buys are allowed only for TRIGGERED signals with eligible resonance.  A
109:     submitted order is recorded as ``submitted``/``fill_status=submitted``;
110:     it is not falsely labelled as filled before order reconciliation.
111:     """
112:     from api.mx_trading import trade as do_trade, _clear_cache
113:     config = db.query(AutoTradeConfig).filter_by(id=1).first()
114:     if not config:
115:         return [{"status": "skipped", "reason": "配置未初始化"}]
116:     if not config.enabled and not dry_run:
117:         return [{"status": "skipped", "reason": "V2自动交易已关闭"}]
118:     # Use all ranked snapshots for held-position exits; the execution loop
119:     # applies the max-buy/max-position limits after the signal gate.
120:     signals = aggregate_signals(None, db, limit=None)
121:     if not signals:
122:         return [{"status": "skipped", "reason": "没有可用的已完成交易日信号"}]
123:     signal_date = signals[0].get("signal_date")
124:     try:
125:         signal_age = (date.today() - datetime.strptime(signal_date, "%Y-%m-%d").date()).days
126:     except Exception:
127:         signal_age = 999
128:     if signal_age > 3:
129:         return [{
130:             "status": "skipped",
131:             "reason": f"信号过期：{signal_date}，距今{signal_age}天",
132:         }]
133:     try:
134:         account = await get_account_overview(db)
135:     except Exception as exc:
136:         logger.error("[auto_trade] account unavailable: %s", exc)
137:         return [{"status": "failed", "reason": f"账户数据不可用: {exc}"}]
138:     balance = account["balance"]
139:     positions = account["positions"]
140:     total_assets = float(balance.get("totalAssets", 0) or 0)
141:     available_balance = float(balance.get("availBalance", 0) or 0)
142:     held_codes = {_code6(p.get("secCode", "")) for p in positions}
143:     signal_map = {item["ts_code"]: item for item in signals}
144:     signal_map.update({_code6(item["ts_code"]): item for item in signals})
145:     logs: list[dict] = []
146:     def append_log(entry: dict) -> None:
147:         logs.append(entry)
148:         _save_log(db, entry)
149:     # 1. Exits: fixed thresholds remain configurable, but signal invalidation
150:     # is now an independent V2 exit reason.  A-share T+1 is enforced through
151:     # availCount, not total count.
152:     sell_qty = max(int(config.sell_quantity or 100), 100)
153:     for position in positions:
154:         code = _code6(position.get("secCode", ""))
155:         cost = float(position.get("costPrice", 0) or 0)
156:         current = float(position.get("price", 0) or 0)
157:         total_count = int(position.get("count", 0) or 0)
158:         available_count = int(position.get("availCount", total_count) or 0)
159:         if cost <= 0 or current <= 0 or total_count <= 0:
160:             continue
161:         profit_pct = (current - cost) / cost * 100
162:         signal = signal_map.get(position.get("secCode")) or signal_map.get(code)
163:         reasons = []
164:         if profit_pct <= float(config.stop_loss_pct):
165:             reasons.append(f"止损：盈亏{profit_pct:.1f}%≤{config.stop_loss_pct}%")
166:         elif profit_pct >= float(config.take_profit_pct):
167:             reasons.append(f"止盈：盈亏{profit_pct:.1f}%≥{config.take_profit_pct}%")
168:         if signal and signal.get("trading_state") == "INVALID":
169:             reasons.append("V2信号失效")
170:         if signal and signal.get("lifecycle") == "退潮":
171:             reasons.append("生命周期退潮")
172:         if not reasons:
173:             continue
174:         if available_count <= 0:
175:             append_log(_make_log(
176:                 signal_date, code, position.get("secName", ""), "skip",
177:                 "；".join(reasons) + "；T+1无可卖数量", 0, current, 0,
178:                 _signal_context(signal), status="skipped",
179:             ))
180:             continue
181:         quantity = min(sell_qty, available_count)
182:         entry = _make_log(
183:             signal_date, code, position.get("secName", ""), "sell",
184:             f"{'；'.join(reasons)}；卖出{quantity}股", 0, current, quantity,
185:             _signal_context(signal),
186:         )
187:         if not dry_run and config.enabled:
188:             try:
189:                 from api.mx_trading import TradeRequest
190:                 result, order_id = await _submit_order(
191:                     TradeRequest(
192:                         type="sell", stockCode=code, quantity=quantity,
193:                         useMarketPrice=bool(config.use_market_price),
194:                     ),
195:                     do_trade,
196:                     _clear_cache,
197:                 )
198:                 entry.update({
199:                     "order_result": json.dumps(result, ensure_ascii=False),
200:                     "order_id": order_id,
201:                     "status": "submitted",
202:                     "fill_status": "submitted",
203:                 })
204:             except Exception as exc:
205:                 entry.update({"order_result": str(exc), "status": "failed", "fill_status": "failed"})
206:         else:
207:             entry.update({"status": "skipped", "fill_status": "dry_run"})
208:         append_log(entry)
209:     # 2. Buys: only a right-side TRIGGERED signal can enter this loop.
210:     buyable = [
211:         item for item in signals
212:         if item.get("trading_state") == "TRIGGERED"
213:         and item.get("resonance_eligible")
214:     ]
215:     buyable.sort(key=lambda item: (item.get("factor_score") or -1), reverse=True)
216:     max_positions = int(config.max_positions or 10)
217:     max_buy_count = int(config.max_buy_count or 20)
218:     position_count = len(held_codes)
219:     bought_count = 0
220:     base_assets = total_assets or available_balance
221:     for signal in buyable:
222:         if position_count >= max_positions:
223:             break
224:         if bought_count >= max_buy_count:
225:             break
226:         code = _code6(signal["ts_code"])
227:         if code in held_codes:
228:             continue
229:         from api.trading import get_realtime_quote
230:         try:
231:             quote = await get_realtime_quote(code=code)
232:             current_price = float(quote.get("price", 0) or 0)
233:         except Exception as exc:
234:             append_log(_make_log(
235:                 signal_date, code, signal.get("name", ""), "skip",
236:                 f"无法获取实时价格：{exc}", signal.get("resonance_count", 0), 0, 0,
237:                 _signal_context(signal), status="skipped",
238:             ))
239:             continue
240:         if current_price <= 0:
241:             continue
242:         buy_qty = max(int(config.buy_quantity or 100), 100)
243:         target_max = base_assets * float(config.single_position_pct or 10) / 100
244:         quantity = min(buy_qty, int(target_max / current_price / 100) * 100)
245:         if quantity < 100 or quantity * current_price > available_balance:
246:             append_log(_make_log(
247:                 signal_date, code, signal.get("name", ""), "skip",
248:                 "资金或单票仓位不足", signal.get("resonance_count", 0), current_price, 0,
249:                 _signal_context(signal), status="skipped",
250:             ))
251:             continue
252:         entry = _make_log(
253:             signal_date, code, signal.get("name", ""), "buy",
254:             f"V2触发：因子分{signal.get('factor_score')}; "
255:             f"共振{signal.get('resonance_count')}维；买入{quantity}股",
256:             signal.get("resonance_count", 0), current_price, quantity,
257:             _signal_context(signal),
258:         )
259:         if not dry_run and config.enabled:
260:             try:
261:                 from api.mx_trading import TradeRequest
262:                 result, order_id = await _submit_order(
263:                     TradeRequest(
264:                         type="buy", stockCode=code, quantity=quantity,
265:                         useMarketPrice=bool(config.use_market_price),
266:                     ),
267:                     do_trade,
268:                     _clear_cache,
269:                 )
270:                 entry.update({
271:                     "order_result": json.dumps(result, ensure_ascii=False),
272:                     "order_id": order_id,
273:                     "status": "submitted",
274:                     "fill_status": "submitted",
275:                 })
276:             except Exception as exc:
277:                 entry.update({"order_result": str(exc), "status": "failed", "fill_status": "failed"})
278:         else:
279:             entry.update({"status": "skipped", "fill_status": "dry_run"})
280:         append_log(entry)
281:         bought_count += 1
282:         position_count += 1
283:         held_codes.add(code)
284:         available_balance -= quantity * current_price
