  1: """
  2: 个股信号预计算服务
  3: - 盘后批量计算候选股票的 signal，落库到 WatchlistSignalDaily 表
  4: - 消除 /api/watchlist、/api/panorama/stocks、/api/leader/system 的现场计算/HTTP拉取
  5: - 防重复跑：同 trade_date 只跑一次（has_run_today 检查）
  6: """
  7: import sys
  8: import os
  9: import json
 10: import asyncio
 11: from datetime import datetime
 12: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 13: from db.session import get_db_session
 14: from db.models import WatchlistSignalDaily, StockFlow, SectorFlow, Watchlist
 15: from quant_vnext.production import is_st_name
 16: import logging
 17: logger = logging.getLogger(__name__)
 18: def check_data_ready(target_date=None) -> bool:
 19:     """检测当日盘后数据是否完整（SectorFlow + StockFlow 都有当日数据）"""
 20:     if target_date is None:
 21:         target_date = datetime.now().date()
 22:     elif isinstance(target_date, str):
 23:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
 24:     try:
 25:         with get_db_session() as db:
 26:             sector_count = db.query(SectorFlow).filter(SectorFlow.trade_date == target_date).count()
 27:             stock_count = db.query(StockFlow).filter(StockFlow.trade_date == target_date).count()
 28:             return sector_count > 30 and stock_count > 500
 29:     except Exception as e:
 30:         logger.error(f'[watchlist_signal_runner] check_data_ready error: {e}')
 31:         return False
 32: def has_run_today(target_date=None) -> bool:
 33:     """检查当日是否已预计算"""
 34:     if target_date is None:
 35:         target_date = datetime.now().date()
 36:     elif isinstance(target_date, str):
 37:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
 38:     with get_db_session() as db:
 39:         count = db.query(WatchlistSignalDaily).filter(
 40:             WatchlistSignalDaily.trade_date == target_date
 41:         ).count()
 42:         return count > 0
 43: def _get_candidate_stocks(db, trade_date, limit=300):
 44:     """候选股票池：StockFlow主力净流入前N只 + Watchlist自选股（去重）
 45:     返回: [{'code', 'ts_code', 'name', 'sector', 'change_rate', 'main_force_inflow'}, ...]
 46:     """
 47:     candidates = {}
 48:     # 1. StockFlow main_force_inflow > 0 前 N 只（覆盖 panorama 前端展示）
 49:     rows = db.query(
 50:         StockFlow.ts_code, StockFlow.name, StockFlow.sector,
 51:         StockFlow.main_force_inflow, StockFlow.price_chg,
 52:     ).filter(
 53:         StockFlow.trade_date == trade_date, StockFlow.main_force_inflow > 0,
 54:     ).order_by(StockFlow.main_force_inflow.desc()).limit(limit * 2).all()
 55:     for r in [row for row in rows if not is_st_name(row.name)][:limit]:
 56:         code = r.ts_code.split('.')[0] if '.' in r.ts_code else r.ts_code
 57:         candidates[code] = {
 58:             'code': code, 'ts_code': r.ts_code, 'name': r.name or '',
 59:             'sector': r.sector or '', 'change_rate': float(r.price_chg or 0),
 60:             'main_force_inflow': float(r.main_force_inflow or 0),
 61:         }
 62:     # 2. Watchlist 自选股（补充不在前N的自选股，确保 watchlist 页面有数据）
 63:     wl_rows = db.query(Watchlist.stock_code, Watchlist.stock_name).all()
 64:     for r in wl_rows:
 65:         code = r.stock_code
 66:         if code in candidates:
 67:             continue
 68:         ts_code = f"{code}.SH" if code[0] in ('6', '9') else f"{code}.SZ"
 69:         sf = db.query(StockFlow).filter(
 70:             StockFlow.trade_date == trade_date, StockFlow.ts_code == ts_code
 71:         ).first()
 72:         if is_st_name((sf.name if sf else None) or r.stock_name):
 73:             continue
 74:         candidates[code] = {
 75:             'code': code, 'ts_code': ts_code, 'name': r.stock_name or code,
 76:             'sector': sf.sector if sf else '', 'change_rate': float(sf.price_chg or 0) if sf else 0,
 77:             'main_force_inflow': float(sf.main_force_inflow or 0) if sf else 0,
 78:         }
 79:     return list(candidates.values())
 80: def compute_for_date(target_date=None):
 81:     """盘后批量计算个股信号并落库 WatchlistSignalDaily"""
 82:     if target_date is None:
 83:         target_date = datetime.now().date()
 84:     elif isinstance(target_date, str):
 85:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
 86:     if not check_data_ready(target_date):
 87:         logger.info(f'[watchlist_signal_runner] data not ready for {target_date}')
 88:         return False
 89:     if has_run_today(target_date):
 90:         logger.info(f'[watchlist_signal_runner] already computed for {target_date}')
 91:         return True
 92:     started = datetime.now()
 93:     logger.info(f'[watchlist_signal_runner] computing for {target_date}')
 94:     try:
 95:         with get_db_session() as db:
 96:             candidates = _get_candidate_stocks(db, target_date)
 97:             logger.info(f'[watchlist_signal_runner] {len(candidates)} candidates')
 98:             # 批量计算 signal（async，用 asyncio.run 包装）
 99:             from services.signal_builder import build_signals_batch
100:             signals = asyncio.run(build_signals_batch(
101:                 candidates, db,
102:                 code_key='code', name_key='name', sector_key='sector',
103:                 change_key='change_rate',
104:                 batch_size=20,
105:             ))
106:             logger.info(f'[watchlist_signal_runner] {len(signals)} signals computed')
107:             # 构建 code → main_force_inflow 映射
108:             inflow_map = {c['code']: c['main_force_inflow'] for c in candidates}
109:             # 落库（upsert：query-by-(trade_date,ts_code) → setattr or db.add）
110:             upserted = 0
111:             for sig in signals:
112:                 code = sig.get('secCode', '')
113:                 if not code or len(code) != 6:
114:                     continue
115:                 ts_code = f"{code}.SH" if code[0] in ('6', '9') else f"{code}.SZ"
116:                 quote = sig.get('quote') or {}
117:                 row = db.query(WatchlistSignalDaily).filter_by(
118:                     trade_date=target_date, ts_code=ts_code
119:                 ).first()
120:                 data = {
121:                     'name': sig.get('secName', ''),
122:                     'sector': sig.get('sector', ''),
123:                     'sector_trend_json': json.dumps(sig.get('sectorTrend') or {}, ensure_ascii=False),
124:                     'market_state_json': json.dumps(sig.get('marketState') or {}, ensure_ascii=False),
125:                     'bs_signal': sig.get('bsSignal'),
126:                     'bs_reasons_json': json.dumps(sig.get('reasons') or [], ensure_ascii=False),
127:                     'quality_status': sig.get('qualityStatus'),
128:                     'buy_power_base': json.dumps(sig.get('buyPower'), ensure_ascii=False) if sig.get('buyPower') else None,
129:                     'change_rate': quote.get('changePct') if quote else 0,
130:                     'main_force_inflow': inflow_map.get(code, 0),
131:                 }
132:                 if row:
133:                     for k, v in data.items():
134:                         setattr(row, k, v)
135:                 else:
136:                     row = WatchlistSignalDaily(trade_date=target_date, ts_code=ts_code, **data)
137:                     db.add(row)
138:                 upserted += 1
139:                 if upserted % 100 == 0:
140:                     db.commit()
141:             db.commit()
142:             elapsed = (datetime.now() - started).total_seconds()
143:             logger.info(f'[watchlist_signal_runner] done: {upserted} rows in {elapsed:.1f}s')
144:         return True
145:     except Exception as e:
146:         logger.error(f'[watchlist_signal_runner] error: {e}')
147:         import traceback
148:         traceback.print_exc()
149:         return False
150: if __name__ == '__main__':
151:     import argparse
152:     parser = argparse.ArgumentParser()
153:     parser.add_argument('--date', default=None, help='target date YYYY-MM-DD')
154:     args = parser.parse_args()
155:     ok = compute_for_date(args.date)
156:     logger.error(f'Result: {"success" if ok else "failed"}')
</file>

<file path="backend/utils/cache.py">
  1: """统一缓存装饰器
  2: - 单 worker 内存缓存（多 worker 部署需迁 Redis）
  3: - 支持 TTL + 手动失效
  4: - 线程安全（threading.Lock）
  5: - 支持参数化 key（key_fn 从 args/kwargs 生成缓存键）
  6: - 同一装饰器自动适配 sync / async 函数（消除重复实现）
  7: 【命名规范】（P1-#15 统一）
  8: - 所有模块级缓存对象必须以 `_cache` 后缀命名，禁止使用 `_memo` / `_store` / `_buffer` / `_map` 等
  9: - 单值带 TTL 的缓存：使用 TTLCache（多 key）或 dict-of-dict 模式 `{'data': ..., 'ts': ...}`（单 key）
 10: - 多 key 缓存：使用 BoundedDict(maxsize=N) 防止内存无限增长
 11: """
 12: import time
 13: import threading
 14: import functools
 15: import inspect
 16: from typing import Any, Callable, Optional
 17: import logging
 18: logger = logging.getLogger(__name__)
 19: _lock = threading.Lock()
 20: _registry: dict = {}  # full_cache_name -> {'data':..., 'ts':..., 'ttl':...}
 21: _MAX_ENTRIES = 1000
 22: def _evict_expired():
 23:     """惰性清理：移除所有过期条目；若仍超限则淘汰最旧的 20%"""
 24:     now = time.time()
 25:     expired = [k for k, v in _registry.items() if now - v['ts'] >= v['ttl']]
 26:     for k in expired:
 27:         del _registry[k]
 28:     if len(_registry) > _MAX_ENTRIES:
 29:         # 仍超限：按写入时间排序，淘汰最旧的 20%
 30:         sorted_keys = sorted(_registry.keys(), key=lambda k: _registry[k]['ts'])
 31:         for k in sorted_keys[:max(len(sorted_keys) // 5, 1)]:
 32:             del _registry[k]
 33: def _make_key(name: str, args: tuple, kwargs: dict, key_fn: Optional[Callable]) -> str:
 34:     """生成缓存键；key_fn 优先，否则回退到 args+kwargs repr。"""
 35:     if key_fn:
 36:         return f"{name}:{key_fn(*args, **kwargs)}"
 37:     return name
 38: def _read_cache(cache_key: str):
 39:     """线程安全读取；命中且未过期返回 data，否则返回 None。"""
 40:     with _lock:
 41:         entry = _registry.get(cache_key)
 42:         if entry and time.time() - entry['ts'] < entry['ttl']:
 43:             return entry['data']
 44:         return None
 45: def _write_cache(cache_key: str, data: Any, ttl: int) -> None:
 46:     """线程安全写入并触发惰性清理。"""
 47:     with _lock:
 48:         _registry[cache_key] = {'data': data, 'ts': time.time(), 'ttl': ttl}
 49:         _evict_expired()
 50: def cached(name: str, ttl: int = 60, key_fn: Optional[Callable] = None):
 51:     """统一缓存装饰器（自动适配 sync / async 函数）
 52:     Args:
 53:         name: 缓存命名空间（全局唯一前缀）
 54:         ttl: 缓存有效期（秒）
 55:         key_fn: 可选，从 (*args, **kwargs) 返回缓存键后缀。
 56:                 若为 None 则用全部 args+kwargs 的 repr。
 57:                 对于无参函数可省略。
 58:     行为：
 59:         - sync 函数：直接调用并缓存结果
 60:         - async 函数：await 调用并缓存结果
 61:         - 调用时可传 _force_refresh=True 跳过缓存
 62:     """
 63:     def decorator(fn):
 64:         is_coro = inspect.iscoroutinefunction(fn)
 65:         if is_coro:
 66:             @functools.wraps(fn)
 67:             async def async_wrapper(*args, **kwargs):
 68:                 force = kwargs.pop('_force_refresh', False)
 69:                 cache_key = _make_key(name, args, kwargs, key_fn)
 70:                 if not force:
 71:                     hit = _read_cache(cache_key)
 72:                     if hit is not None:
 73:                         return hit
 74:                 data = await fn(*args, **kwargs)
 75:                 _write_cache(cache_key, data, ttl)
 76:                 return data
 77:             wrapper = async_wrapper
 78:         else:
 79:             @functools.wraps(fn)
 80:             def sync_wrapper(*args, **kwargs):
 81:                 force = kwargs.pop('_force_refresh', False)
 82:                 cache_key = _make_key(name, args, kwargs, key_fn)
 83:                 if not force:
 84:                     hit = _read_cache(cache_key)
 85:                     if hit is not None:
 86:                         return hit
 87:                 data = fn(*args, **kwargs)
 88:                 _write_cache(cache_key, data, ttl)
 89:                 return data
 90:             wrapper = sync_wrapper
 91:         wrapper.invalidate = lambda: invalidate_prefix(name)  # type: ignore[attr-defined]
 92:         wrapper._cache_name = name
 93:         return wrapper
 94:     return decorator
 95: # 向后兼容别名：保留旧名以避免外部调用中断
 96: async_cached = cached
 97: def invalidate(name: str) -> bool:
 98:     """手动失效某个缓存（精确匹配）"""
 99:     with _lock:
100:         return _registry.pop(name, None) is not None
101: def invalidate_prefix(prefix: str) -> int:
102:     """批量失效（按前缀，含 namespace:key 形式）"""
103:     with _lock:
104:         keys = [k for k in _registry if k == prefix or k.startswith(prefix + ':')]
105:         for k in keys:
106:             _registry.pop(k, None)
107:         return len(keys)
108: def cache_status() -> dict:
109:     """获取所有缓存状态（用于 /api/health/cache）"""
110:     with _lock:
111:         now = time.time()
112:         return {
113:             name: {
114:                 'age_seconds': round(now - e['ts'], 1),
115:                 'ttl_seconds': e['ttl'],
116:                 'expired': now - e['ts'] > e['ttl'],
117:             }
118:             for name, e in _registry.items()
119:         }
120: class BoundedDict(dict):
121:     """有上限的字典缓存，超出 maxsize 时淘汰最旧条目（FIFO）。
122:     用于替代模块级裸字典缓存，防止内存无限增长。
123:     用法:
124:         _cache = BoundedDict(maxsize=200)  # 最多 200 个 key
125:         _cache[key] = value                 # 超限时自动淘汰最早写入的 key
126:     """
127:     def __init__(self, maxsize: int = 200, *args, **kwargs):
128:         self._maxsize = maxsize
129:         super().__init__(*args, **kwargs)
130:     def __setitem__(self, key, value):
131:         if len(self) >= self._maxsize and key not in self:
132:             # 淘汰最早写入的 key（FIFO）
133:             oldest = next(iter(self))
134:             del self[oldest]
135:         super().__setitem__(key, value)
136: class TTLCache:
137:     """带 TTL 的缓存，替代手动 {'data':.., 'ts':..} 模式。
138:     用法:
139:         cache = TTLCache(ttl=300)
140:         cache.set(key, data)
141:         data = cache.get(key)  # 过期返回 None
142:     """
143:     def __init__(self, ttl: int = 300, maxsize: int = 200):
144:         self._ttl = ttl
145:         self._maxsize = maxsize
146:         self._store: dict = {}
147:         self._lock = threading.Lock()
148:     def get(self, key, default=None):
149:         with self._lock:
150:             entry = self._store.get(key)
151:             if entry is None:
152:                 return default
153:             if time.time() - entry['ts'] >= self._ttl:
154:                 del self._store[key]
155:                 return default
156:             return entry['data']
157:     def set(self, key, data):
158:         with self._lock:
159:             if len(self._store) >= self._maxsize and key not in self._store:
160:                 oldest = min(self._store, key=lambda k: self._store[k]['ts'])
161:                 del self._store[oldest]
162:             self._store[key] = {'data': data, 'ts': time.time()}
163:     def invalidate(self, key=None):
164:         """失效单个 key 或全部"""
165:         with self._lock:
166:             if key:
167:                 self._store.pop(key, None)
168:             else:
169:                 self._store.clear()
170:     def __len__(self):
171:         return len(self._store)
172:     def __contains__(self, key):
173:         return self.get(key) is not None
