380: async def build_signals_batch(
381:     stocks: List[dict],
382:     db,
383:     *,
384:     code_key: str = 'code',
385:     name_key: str = 'name',
386:     sector_key: str = 'sector',
387:     stage_key: Optional[str] = None,
388:     strength_key: Optional[str] = None,
389:     change_key: Optional[str] = None,
390:     days_key: Optional[str] = None,
391:     batch_size: int = 20,
392: ) -> List[dict]:
393:     """批量构造 signal 数据（分批并发，避免新浪限流）
394:     Args:
395:         stocks: 股票列表（dict）
396:         code_key/name_key/sector_key: 字段名映射
397:         stage_key/strength_key/change_key/days_key: 可选的策略维度字段名
398:         batch_size: 每批并发数
399:     """
400:     # 收集所有 ts_code，批量查 LeaderLifecycle 真实生命周期阶段
401:     _all_ts_codes = []
402:     for s in stocks:
403:         code = s.get(code_key) or s.get('ts_code') or s.get('secCode') or ''
404:         if '.' not in code and len(code) == 6:
405:             code = f"{code}.SH" if code[0] in ('6', '9') else f"{code}.SZ"
406:         if '.' in code:
407:             _all_ts_codes.append(code)
408:     lifecycle_map = _get_lifecycle_map(db, _all_ts_codes)
409:     all_signals = []
410:     for i in range(0, len(stocks), batch_size):
411:         batch = stocks[i:i + batch_size]
412:         tasks = []
413:         for s in batch:
414:             code = s.get(code_key) or s.get('ts_code') or s.get('secCode') or ''
415:             # ts_code 形如 "600000.SH"，提取6位数字
416:             if '.' in code:
417:                 code = code.split('.')[0]
418:             if not code or len(code) != 6:
419:                 continue
420:             ts_code = f"{code}.SH" if code[0] in ('6', '9') else f"{code}.SZ"
421:             name = s.get(name_key) or s.get('secName') or ''
422:             sector = s.get(sector_key) or ''
423:             kwargs = {}
424:             if stage_key and s.get(stage_key):
425:                 kwargs['stage'] = s[stage_key]
426:             if strength_key and s.get(strength_key) is not None:
427:                 kwargs['strength'] = float(s[strength_key])
428:             if change_key and s.get(change_key) is not None:
429:                 kwargs['change_rate'] = float(s[change_key])
430:             if days_key and s.get(days_key) is not None:
431:                 kwargs['consecutive_days'] = int(s[days_key])
432:             kwargs['lifecycle_stage'] = lifecycle_map.get(ts_code) or '未入选'
433:             tasks.append(build_signal_for_stock(code, name, sector, db, **kwargs))
434:         results = await asyncio.gather(*tasks, return_exceptions=True)
435:         for r in results:
436:             if not isinstance(r, Exception) and r is not None:
437:                 all_signals.append(r)
438:     return all_signals
