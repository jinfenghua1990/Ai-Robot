 23: def get_prefix(code: str) -> str:
 24:     """6 位代码 → 交易所前缀。"""
 25:     if code.startswith(("6", "9")):
 26:         return "sh"
 27:     if code.startswith("8"):
 28:         return "bj"
 29:     return "sz"
