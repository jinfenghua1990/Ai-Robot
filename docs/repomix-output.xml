 64:   if (o === 'A杀退潮') return { emoji: '🔴', label: 'A杀退潮', bg: '#dc2626', color: '#fff' };
 65:   if (o === '高位震荡') return { emoji: '🟡', label: '高位震荡', bg: '#eab308', color: '#000' };
 66:   if (o === '横盘') return { emoji: '⚪', label: '横盘', bg: '#9ca3af', color: '#fff' };
