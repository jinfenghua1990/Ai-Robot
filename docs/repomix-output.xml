<file path="frontend/src/components/charts/RealtimeSankeyChart.jsx">
  1: import { useMemo } from 'react';
  2: const fmtFlow = (v) => {
  3:   if (v == null || isNaN(v)) return '—';
  4:   const abs = Math.abs(v);
  5:   if (abs >= 10000) return `${(v / 10000).toFixed(1)}亿`;
  6:   return `${v.toFixed(0)}万`;
  7: };
  8: /**
  9:  * 实时板块资金流向排名（替代桑基图）
 10:  * 左右分栏：Top 8 净流入 + Top 8 净流出，与盘后格式对齐方便对比。
 11:  */
 12: export default function RealtimeSankeyChart({ rtSectors, selectedSector, onNodeClick }) {
 13:   const { inflows, outflows, snapshotTime } = useMemo(() => {
 14:     const list = rtSectors?.sectors || [];
 15:     const sorted = list.slice().sort((a, b) => b.net_flow - a.net_flow);
 16:     return {
 17:       inflows: sorted.filter(s => s.net_flow > 0).slice(0, 8),
 18:       outflows: sorted.filter(s => s.net_flow < 0).sort((a, b) => a.net_flow - b.net_flow).slice(0, 8),
 19:       snapshotTime: rtSectors?.snapshot_time,
 20:     };
 21:   }, [rtSectors]);
 22:   if (!rtSectors?.trade_date) {
 23:     return <div className="flex items-center justify-center h-full text-sm" style={{ color: 'var(--text-muted)' }}>暂无实时数据</div>;
 24:   }
 25:   // 统计
 26:   const totalIn = inflows.reduce((s, x) => s + x.net_flow, 0);
 27:   const totalOut = outflows.reduce((s, x) => s + Math.abs(x.net_flow), 0);
 28:   return (
 29:     <div className="h-full flex flex-col gap-1.5 overflow-hidden">
 30:       {/* 统计摘要 */}
 31:       <div className="grid grid-cols-3 gap-1.5 shrink-0">
 32:         <div className="rounded px-2 py-1 border" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-surface)' }}>
 33:           <div className="text-[10px]" style={{ color: 'var(--text-muted)' }}>Top8 流入</div>
 34:           <div className="text-xs font-bold text-red-500">{fmtFlow(totalIn)}</div>
 35:         </div>
 36:         <div className="rounded px-2 py-1 border" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-surface)' }}>
 37:           <div className="text-[10px]" style={{ color: 'var(--text-muted)' }}>Top8 流出</div>
 38:           <div className="text-xs font-bold text-green-500">{fmtFlow(totalOut)}</div>
 39:         </div>
 40:         <div className="rounded px-2 py-1 border" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-surface)' }}>
 41:           <div className="text-[10px]" style={{ color: 'var(--text-muted)' }}>快照时间</div>
 42:           <div className="text-[10px] font-bold" style={{ color: 'var(--text-secondary)' }}>
 43:             {snapshotTime ? snapshotTime.slice(11, 19) : '—'}
 44:           </div>
 45:         </div>
 46:       </div>
 47:       {/* 排名列表 */}
 48:       <div className="flex-1 min-h-0 grid grid-cols-2 gap-2 overflow-hidden">
 49:         {/* 净流入 */}
 50:         <div className="flex flex-col min-h-0 overflow-hidden">
 51:           <div className="text-[10px] font-semibold text-red-500 px-1 shrink-0">▼ 净流入 Top 8</div>
 52:           <div className="flex-1 overflow-y-auto">
 53:             {inflows.map((s, i) => {
 54:               const isSel = selectedSector === s.sector;
 55:               return (
 56:                 <div
 57:                   key={s.sector}
 58:                   onClick={() => onNodeClick?.(s.sector)}
 59:                   className="flex items-center px-2 py-1 rounded cursor-pointer text-xs transition-colors"
 60:                   style={{
 61:                     background: isSel ? 'var(--bg-hover)' : 'transparent',
 62:                     borderLeft: isSel ? '2px solid #ef4444' : '2px solid transparent',
 63:                   }}
 64:                   onMouseEnter={e => { if (!isSel) e.currentTarget.style.background = 'var(--bg-hover)'; }}
 65:                   onMouseLeave={e => { if (!isSel) e.currentTarget.style.background = 'transparent'; }}
 66:                 >
 67:                   <span className="w-4 text-center font-mono text-[10px]" style={{ color: 'var(--text-muted)' }}>{i + 1}</span>
 68:                   <span className="flex-1 truncate mx-1.5" style={{ color: 'var(--text-primary)' }}>{s.sector}</span>
 69:                   {s.rise_ratio != null && (
 70:                     <span className="text-[10px] mr-1.5 font-mono" style={{ color: s.rise_ratio >= 0 ? '#ef4444' : '#22c55e' }}>
 71:                       {s.rise_ratio >= 0 ? '+' : ''}{s.rise_ratio.toFixed(2)}%
 72:                     </span>
 73:                   )}
 74:                   <span className="font-mono text-[11px] font-semibold text-red-500 w-14 text-right">
 75:                     {fmtFlow(s.net_flow)}
 76:                   </span>
 77:                 </div>
 78:               );
 79:             })}
 80:           </div>
 81:         </div>
 82:         {/* 净流出 */}
 83:         <div className="flex flex-col min-h-0 overflow-hidden">
 84:           <div className="text-[10px] font-semibold text-green-500 px-1 shrink-0">▲ 净流出 Top 8</div>
 85:           <div className="flex-1 overflow-y-auto">
 86:             {outflows.map((s, i) => {
 87:               const isSel = selectedSector === s.sector;
 88:               return (
 89:                 <div
 90:                   key={s.sector}
 91:                   onClick={() => onNodeClick?.(s.sector)}
 92:                   className="flex items-center px-2 py-1 rounded cursor-pointer text-xs transition-colors"
 93:                   style={{
 94:                     background: isSel ? 'var(--bg-hover)' : 'transparent',
 95:                     borderLeft: isSel ? '2px solid #22c55e' : '2px solid transparent',
 96:                   }}
 97:                   onMouseEnter={e => { if (!isSel) e.currentTarget.style.background = 'var(--bg-hover)'; }}
 98:                   onMouseLeave={e => { if (!isSel) e.currentTarget.style.background = 'transparent'; }}
 99:                 >
100:                   <span className="w-4 text-center font-mono text-[10px]" style={{ color: 'var(--text-muted)' }}>{i + 1}</span>
101:                   <span className="flex-1 truncate mx-1.5" style={{ color: 'var(--text-primary)' }}>{s.sector}</span>
102:                   {s.rise_ratio != null && (
103:                     <span className="text-[10px] mr-1.5 font-mono" style={{ color: s.rise_ratio >= 0 ? '#ef4444' : '#22c55e' }}>
104:                       {s.rise_ratio >= 0 ? '+' : ''}{s.rise_ratio.toFixed(2)}%
105:                     </span>
106:                   )}
107:                   <span className="font-mono text-[11px] font-semibold text-green-500 w-14 text-right">
108:                     {fmtFlow(s.net_flow)}
109:                   </span>
110:                 </div>
111:               );
112:             })}
113:           </div>
114:         </div>
115:       </div>
116:       {/* 底部说明 */}
117:       <div className="text-[10px] shrink-0 px-1" style={{ color: 'var(--text-muted)' }}>
118:         当日累计净流入 · 含涨跌幅参考 · 点击钻取分时走势
119:       </div>
120:     </div>
121:   );
122: }
