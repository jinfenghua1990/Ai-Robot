763:         logger.error(f'[scheduler] 盘后复盘生成失败: {e}', exc_info=True)
764: # ============================================================
765: # G) 美股量化扫描
766: # ============================================================
767: def scheduled_us_quant_collect():
768:     """美股日K线数据采集（北京时间 4:00-5:00，美股收盘后数据就绪时执行）
769:     数据流：东财push2(gstock) → akshare(新浪) → Nasdaq → Yahoo → 入 USStockDaily 表
770:     """
771:     now = datetime.now()
772:     if now.weekday() >= 5:
773:         return
774:     t = now.hour * 100 + now.minute
775:     # 北京时间 4:00-5:00 执行（美股收盘后约 4:00 ET，数据已就绪）
776:     if t < 400 or t > 500:
777:         return
778:     logger.info(f'[scheduler] US quant data collection triggered at {now.strftime("%H:%M")}')
779:     try:
780:         from us_quant.collector import collect_all
