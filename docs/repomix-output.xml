122:             # 缩量回踩和放量突破默认优先买入
123:             # 但放量突破如果距高点>5%，降级到等回踩
124:             if pattern == 'breakout' and distance_to_high_20 > 5:
125:                 tier = 'wait'
126:                 tier_label = '等回踩确认'
127:             else:
128:                 tier = 'priority'
129:                 tier_label = '优先买入'
130:         elif pattern == 'trend':
131:             # 趋势延续：乖离>15% 或 距高点>10% 降级到等回踩
132:             if deviation_ma20 > 15 or distance_to_high_20 > 10:
133:                 tier = 'wait'
134:                 tier_label = '等回踩确认'
135:             elif deviation_ma20 > 20 or distance_to_high_20 > 15:
136:                 tier = 'avoid'
137:                 tier_label = '暂不参与'
138:             else:
139:                 tier = 'priority'
140:                 tier_label = '优先买入'
