 28:         'emoji': '🌤️',
 29:         'action': '减仓防守 / 锁定自选',
 30:         'color': '#f97316',
 31:         'bg': 'rgba(249,115,22,0.08)',
 32:         'border': 'rgba(249,115,22,0.25)',
 33:     },
 34:     'typhoon': {
 35:         'key': 'typhoon',
 36:         'label': '龙卷风',
 37:         'emoji': '🌪️',
 38:         'action': '快进快出 / 严控止损',
 39:         'color': '#eab308',
 40:         'bg': 'rgba(234,179,8,0.08)',
 41:         'border': 'rgba(234,179,8,0.25)',
 42:     },
 43:     'sunny': {
 44:         'key': 'sunny',
 45:         'label': '晴空万里',
 46:         'emoji': '☀️',
 47:         'action': '持股待涨 / 顺势加仓',
 48:         'color': '#22c55e',
 49:         'bg': 'rgba(34,197,94,0.08)',
 50:         'border': 'rgba(34,197,94,0.25)',
 51:     },
 52:     'cloudy': {
 53:         'key': 'cloudy',
 54:         'label': '多云',
 55:         'emoji': '☁️',
 56:         'action': '观望 / 等待信号',
 57:         'color': '#6b7280',
 58:         'bg': 'rgba(107,114,128,0.08)',
 59:         'border': 'rgba(107,114,128,0.25)',
 60:     },
 61: }
 62: # === 天气判定规则 ===
 63: # 阈值（万元）
 64: INSTITUTION_THRESHOLD = 5000   # 机构爆买阈值
 65: YUZI_THRESHOLD = 3000          # 游资爆买/砸盘阈值
 66: RISE_THRESHOLD = 15.0          # 近5日涨幅阈值（台风）
 67: def _is_breakdown(technical: Optional[dict]) -> bool:
 68:     """技术形态是否破位"""
 69:     if not technical:
 70:         return False
 71:     return technical.get('stage') == '破位'
 72: def _is_bullish_technical(technical: Optional[dict]) -> bool:
 73:     """技术形态是否偏多/多头/突破"""
 74:     if not technical:
 75:         return False
 76:     return technical.get('stage') in ('偏多', '多头', '突破')
 77: def _classify_weather(
 78:     technical: Optional[dict],
 79:     inst_net_5d: float,
 80:     yuzi_net_5d: float,
 81:     change_5d: float,
 82: ) -> str:
 83:     """返回天气 key"""
 84:     breakdown = _is_breakdown(technical)
 85:     bullish = _is_bullish_technical(technical)
 86:     # 暴风雨：技术破位 + 游资砸盘 + 机构不接盘
 87:     if breakdown and yuzi_net_5d < -YUZI_THRESHOLD and inst_net_5d <= 0:
 88:         return 'storm'
 89:     # 阴转晴：技术破位 + 机构爆买 + 游资砸盘
 90:     if breakdown and inst_net_5d > INSTITUTION_THRESHOLD and yuzi_net_5d < -YUZI_THRESHOLD:
 91:         return 'cloudy_to_sunny'
 92:     # 台风：暴涨 + 游资爆买 + 机构出货
 93:     if change_5d > RISE_THRESHOLD and yuzi_net_5d > YUZI_THRESHOLD and inst_net_5d < -INSTITUTION_THRESHOLD:
 94:         return 'typhoon'
 95:     # 艳阳：技术多头 + 机构买入 + 游资买入
 96:     if bullish and inst_net_5d > 0 and yuzi_net_5d > 0:
 97:         return 'sunny'
 98:     return 'cloudy'
 99: def _fmt_wan(v: float) -> str:
100:     """格式化万元为 万/亿"""
101:     x = v or 0
102:     if abs(x) >= 10000:
103:         return f"{x / 10000:.2f}亿"
104:     return f"{x:.0f}万"
105: def _load_seat_flow_map(db: Session, stock_codes: List[str], days: int = 5) -> Dict[str, dict]:
106:     """批量查询近 N 日机构/游资净流入
107:     返回 {raw_code: {'inst_net': 万, 'yuzi_net': 万, 'inst_days': int, 'yuzi_days': int}}
108:     """
109:     if not stock_codes:
110:         return {}
111:     # 取最近 N 个交易日（从 YuziSeatDaily 的 trade_date 字符串 YYYYMMDD 中 distinct）
112:     recent_dates = db.query(YuziSeatDaily.trade_date).distinct()\
113:         .order_by(YuziSeatDaily.trade_date.desc()).limit(days).all()
114:     if not recent_dates:
115:         return {}
116:     date_list = [d[0] for d in recent_dates]
117:     # 一次批量拉取
118:     rows = db.query(
119:         YuziSeatDaily.ts_code,
120:         YuziSeatDaily.seat_name,
121:         YuziSeatDaily.yuzi_alias,
122:         YuziSeatDaily.net_amount,
123:         YuziDict.yuzi_group,
124:     ).outerjoin(
125:         YuziDict, YuziSeatDaily.seat_name == YuziDict.seat_name
126:     ).filter(
127:         YuziSeatDaily.trade_date.in_(date_list),
128:         YuziSeatDaily.ts_code.in_(stock_codes),
129:     ).all()
130:     result: Dict[str, dict] = {}
131:     for ts_code, seat_name, yuzi_alias, net_amount, yuzi_group in rows:
132:         code = ts_code.split('.')[0]
133:         if code not in result:
134:             result[code] = {'inst_net': 0.0, 'yuzi_net': 0.0, 'inst_days': set(), 'yuzi_days': set()}
135:         net = float(net_amount or 0)
136:         group = yuzi_group or ''
137:         # 机构识别：yuzi_group 为机构，或 seat_name 含机构专用
138:         if group == '机构' or '机构专用' in (seat_name or ''):
139:             result[code]['inst_net'] += net
140:             result[code]['inst_days'].add(ts_code + '@' + seat_name)
141:         # 游资识别：yuzi_group 属于游资类
142:         elif group in ('顶级游资', '实力游资', '假游资') or yuzi_alias:
143:             result[code]['yuzi_net'] += net
144:             result[code]['yuzi_days'].add(ts_code + '@' + seat_name)
145:     for code in result:
146:         result[code]['inst_net'] = round(result[code]['inst_net'], 2)
147:         result[code]['yuzi_net'] = round(result[code]['yuzi_net'], 2)
148:         result[code]['inst_days'] = len(result[code]['inst_days'])
149:         result[code]['yuzi_days'] = len(result[code]['yuzi_days'])
150:     return result
151: @router.get("/api/fund-weather")
152: async def get_fund_weather():
153:     """资金气象雷达：按机构/游资双轨博弈把自选股分组
154:     返回:
155:     {
156:       "weather_groups": [
157:         {
158:           "weather": "storm",
159:           "label": "雷暴风雨",
160:           "emoji": "⛈️",
161:           "action": "清仓 / 避险",
162:           "color": "#dc2626",
163:           "count": 3,
164:           "stocks": [...]
165:         },
166:         ...
167:       ],
168:       "generated_at": "..."
169:     }
170:     """
171:     # 复用 watchlist 缓存数据
172:     try:
173:         watchlist_data = await get_watchlist()
174:     except Exception as e:
175:         logger.warning(f'[fund-weather] get_watchlist failed: {e}')
176:         watchlist_data = {'signals': []}
177:     signals = watchlist_data.get('signals') or []
178:     if not signals:
179:         return {'weather_groups': [], 'generated_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S')}
180:     # 批量查询近 5 日席位资金流
181:     raw_codes = [s['secCode'] for s in signals if s.get('secCode')]
182:     ts_codes = [f"{c}.SH" if c[0] in ('6', '9') else f"{c}.SZ" for c in raw_codes if len(c) == 6]
183:     with get_db_session() as db:
184:         seat_map = _load_seat_flow_map(db, ts_codes, days=5)
185:     # 计算近 5 日涨幅（从 signal.quote 没有历史，用 changePct 近似当日，或用 moneyFlow inflow_5d 相关）
186:     # MVP：先使用当日涨幅作为 proxy，后续可从 StockDailyKline 取 5 日涨幅
187:     def _estimate_5d_change(s):
188:         quote = s.get('quote') or {}
189:         # 如果有近5日累计主力净流入方向与涨幅同向，用当日涨幅 proxy
190:         return float(quote.get('changePct') or 0)
191:     # 按天气分组
192:     groups = {key: [] for key in WEATHER_CONFIG}
193:     for s in signals:
194:         code = s.get('secCode', '')
195:         ts_code = f"{code}.SH" if code and code[0] in ('6', '9') else f"{code}.SZ"
196:         seat = seat_map.get(code, {'inst_net': 0, 'yuzi_net': 0})
197:         technical = s.get('technical')
198:         change_5d = _estimate_5d_change(s)
199:         weather_key = _classify_weather(
200:             technical,
201:             seat.get('inst_net', 0),
202:             seat.get('yuzi_net', 0),
203:             change_5d,
204:         )
205:         quote = s.get('quote') or {}
206:         cfg = WEATHER_CONFIG[weather_key]
207:         groups[weather_key].append({
208:             'code': code,
209:             'name': s.get('secName', ''),
210:             'sector': s.get('sector', ''),
211:             'technical_stage': technical.get('stage') if technical else '-',
212:             'change_pct': round(float(quote.get('changePct') or 0), 2),
213:             'price': round(float(quote.get('price') or 0), 2),
214:             'inst_net_5d': seat.get('inst_net', 0),
215:             'yuzi_net_5d': seat.get('yuzi_net', 0),
216:             'inst_net_5d_fmt': _fmt_wan(seat.get('inst_net', 0)),
217:             'yuzi_net_5d_fmt': _fmt_wan(seat.get('yuzi_net', 0)),
218:             'action': cfg['action'],
219:             'weather': weather_key,
220:         })
221:     weather_groups = []
222:     for key in ['storm', 'cloudy_to_sunny', 'typhoon', 'sunny', 'cloudy']:
223:         cfg = WEATHER_CONFIG[key]
224:         weather_groups.append({
225:             'weather': key,
226:             'label': cfg['label'],
227:             'emoji': cfg['emoji'],
228:             'action': cfg['action'],
229:             'color': cfg['color'],
230:             'bg': cfg['bg'],
231:             'border': cfg['border'],
232:             'count': len(groups[key]),
233:             'stocks': groups[key],
234:         })
235:     return {
236:         'weather_groups': weather_groups,
237:         'generated_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
238:     }
