126: # ─── 持仓自动同步到自选 ─────────────────────────────────
127: def _sync_portfolio_to_watchlist(items: list[dict]) -> dict:
128:     """持仓 → 自选 自动同步：只加不减、去重；仅在真正新增时写盘。
129:     返回 {"added": n, "skipped": m}
130:     """
131:     codes = sorted({str(it.get("symbol", "")).strip() for it in items if it.get("symbol")})
132:     if not codes:
133:         return {"added": 0, "skipped": 0}
134:     data = get_watchlist()
135:     stocks = data.setdefault("stocks", [])
136:     existing_codes = {s.get("code") for s in stocks}
137:     missing = [c for c in codes if c not in existing_codes]
138:     if not missing:
139:         return {"added": 0, "skipped": len(codes)}
140:     name_map = {str(it.get("symbol", "")).strip(): (it.get("name") or "") for it in items}
141:     # 1. 写 JSON（唯一真相源）
142:     for c in missing:
143:         stocks.append({"code": c, "name": name_map.get(c, ""), "note": "持仓自动同步", "group": "持仓同步"})
144:         existing_codes.add(c)
145:     save_watchlist(data)
146:     # 2. 同步到 DB + 重置缓存
147:     try:
148:         from db.session import get_db_session
149:         from db.models import Watchlist
150:         from api.watchlist._shared import reset_watchlist_cache
151:         with get_db_session() as db:
152:             existing_map = {item.stock_code: item for item in db.query(Watchlist).all()}
153:             for c in missing:
154:                 if c not in existing_map:
155:                     db.add(Watchlist(
156:                         stock_code=c,
157:                         stock_name=name_map.get(c, ""),
158:                         note="持仓自动同步",
159:                         group_name="持仓同步",
160:                     ))
161:             db.commit()
162:         reset_watchlist_cache()
163:     except Exception as e:
164:         logger.warning("持仓同步到自选 DB 失败: %s", e)
165:     # 3. 触发云同步（防抖推送）
166:     try:
167:         from api.sync_pkg import trigger_cloud_sync
168:         for c in missing:
169:             trigger_cloud_sync(f"add {c} (portfolio auto-sync)")
170:     except Exception as e:
171:         logger.debug("cloud sync trigger failed: %s", e)
172:     logger.info("持仓自动同步到自选: 新增 %d 只 (跳过 %d)", len(missing), len(codes) - len(missing))
173:     return {"added": len(missing), "skipped": len(codes) - len(missing)}
174: async def _refresh_portfolio(force=False):
175:     """刷新本地妙想模拟盘持仓到统一缓存；不再依赖 DSA。
176:     数据源说明：
177:     - 妙想 (miaoxiang): 用户在模拟账户中交易的实时持仓，为唯一持仓来源
178:     - 获取失败时保留 portfolio.json 中上一次成功快照
179:     """
180:     from api.trading import get_positions, get_balance
181:     # 1. 拉妙想模拟交易持仓
182:     mx_items: list[dict] = []
183:     positions_ok = False
184:     try:
185:         pos_data = await get_positions(force=force)
186:         positions_ok = True
187:         for p in pos_data.get("positions", []):
188:             qty = p.get("count", 0) or 0
189:             if qty <= 0:
190:                 continue
191:             mx_items.append({
192:                 "symbol": p.get("secCode", ""),
193:                 "name": p.get("secName", ""),
194:                 "market": "cn",
195:                 "quantity": float(qty),
196:                 "avg_cost": float(p.get("costPrice", 0) or 0),
197:                 "last_price": float(p.get("price", 0) or 0),
198:                 "market_value": float(p.get("value", 0) or 0),
199:                 "unrealized_pnl": float(p.get("profit", 0) or 0),
200:                 "profit_ratio": round(float(p.get("profitPct", 0) or 0), 2),
201:                 "day_pnl": float(p.get("dayProfit", 0) or 0),
202:                 "day_pnl_pct": round(float(p.get("dayProfitPct", 0) or 0), 2),
203:                 "pos_pct": round(float(p.get("posPct", 0) or 0), 2),
204:                 "source": "miaoxiang",
205:             })
206:     except Exception as e:
207:         logger.warning("妙想模拟交易持仓拉取失败: %s", e)
208:     if not positions_ok:
209:         previous = get_portfolio()
210:         previous["data_quality"] = "持仓源暂时不可用，保留上次成功快照"
211:         return previous
212:     items = list(mx_items)
213:     total_mv = sum(it["market_value"] for it in items)
214:     total_upnl = sum(it["unrealized_pnl"] for it in items)
215:     total_cost = sum((it.get("avg_cost", 0) or 0) * (it.get("quantity", 0) or 0) for it in items)
216:     total_day_pnl = sum(it.get("day_pnl", 0) or 0 for it in items)
217:     # 妙想模拟盘可用资金（现金余额），API 失败时回退到上次缓存值
218:     available_cash = 0.0
219:     try:
220:         bal = await get_balance(force=force)
221:         available_cash = float(bal.get("availBalance", 0) or 0)
222:     except Exception as e:
223:         prev = _read_json(PORTFOLIO_PATH)
224:         prev_cash = float(prev.get("available_cash", 0) or 0) if prev else 0
225:         available_cash = prev_cash
226:         logger.warning("查询妙想账户资金失败，回退到上次缓存值 %.2f: %s", prev_cash, e)
227:     total_assets = round(total_mv + available_cash, 2)
228:     # 持仓自动同步到自选（只加不减、去重；仅在真正新增时写盘）
229:     try:
230:         sync_info = _sync_portfolio_to_watchlist(items)
231:     except Exception as e:
232:         logger.warning("持仓自动同步到自选失败: %s", e)
233:         sync_info = {"added": 0, "skipped": 0}
234:     cache = {
235:         "as_of": date.today().isoformat(),
236:         "watchlist_sync": sync_info,
237:         "total_market_value": round(total_mv, 2),
238:         "total_unrealized_pnl": round(total_upnl, 2),
239:         "total_assets": total_assets,
240:         "available_cash": round(available_cash, 2),
241:         "total_cost": round(total_cost, 2),
242:         "total_day_pnl": round(total_day_pnl, 2),
243:         "positions": items,
244:         "count": len(items),
245:         "data_sources": {
246:             "miaoxiang": len([p for p in items if p.get("source") == "miaoxiang"]),
247:             "dsa": 0,
248:         },
249:     }
250:     _write_json(PORTFOLIO_PATH, cache)
251:     return cache
252: @router.get("/api/shared/portfolio")
253: async def shared_portfolio(force: int = Query(0, description="1=强制刷新缓存")):
254:     """返回统一持仓数据"""
255:     if force:
256:         await _refresh_portfolio(force=True)
