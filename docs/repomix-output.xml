109:             <b style={{ color: 'var(--text-muted)', marginLeft: 8 }}>{summary.down_count || 0}</b>下降
110:           </span>
111:           <span style={{ color: 'var(--text-muted)' }}>|</span>
112:           <span style={{ color: 'var(--text-secondary)' }}>
113:             龙头池: <b style={{ color: 'var(--text-primary)' }}>{data.all_count || 0}</b>只
