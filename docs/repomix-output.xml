 51: TUSHARE_RATE_WINDOW = 60        # 窗口长度（秒）
 52: def _tushare_rate_acquire():
 53:     """令牌桶：确保任意 60s 窗口内不超过 TUSHARE_RATE_MAX 次调用。"""
 54:     now = time.time()
 55:     with _tushare_rate_lock:
 56:         # 清理过期时间戳
 57:         cutoff = now - TUSHARE_RATE_WINDOW
 58:         _tushare_rate_timestamps[:] = [t for t in _tushare_rate_timestamps if t > cutoff]
 59:         if len(_tushare_rate_timestamps) >= TUSHARE_RATE_MAX:
