499: # ─── 真实基本面（腾讯 gtimg 行情，覆盖估算） ─────────────────────────────────
500: # 数据源：腾讯 gtimg (qt.gtimg.cn)。覆盖港股/美股，含 PE/PB/股息/市值/52周高低，
501: # 且不像 Eastmoney 那样限流。字段为真实值；ROE/增速/南向/资金流等需 F10 或另源，保留估算。
502: # 字段索引（已实测校准）：
503: #   [3]=现价 [32]=涨跌幅% [39]=市盈率TTM [44]=总市值(亿元)
504: #   [48]=52周最高 [49]=52周最低 [58]=市净率(HK可靠) [59]=股息率%(HK可靠)
505: _GT_CACHE: dict[str, tuple[float, dict]] = {}
506: _GT_CACHE_TTL = 3600  # 1 小时缓存
507: def _to_gtimg(market: str, code: str) -> str:
508:     """业务代码 → 腾讯 gtimg 查询符号"""
509:     if market == "HK":
510:         return "hk" + code.zfill(5)          # 00700 → hk00700
511:     return "us" + code.upper()               # AAPL  → usAAPL
512: def _gtimg_fetch(q: str):
513:     import re as _re
514:     url = f"https://qt.gtimg.cn/q={q}"
515:     try:
516:         resp = requests.get(
517:             url,
518:             headers={"User-Agent": "Mozilla/5.0", "Referer": "https://finance.qq.com/"},
519:             timeout=12,
520:         )
521:         resp.encoding = "gbk"
522:         m = _re.search(r'="(.*)";', resp.text)
523:         if not m:
524:             return None
525:         return m.group(1).split("~")
526:     except Exception as e:
527:         logger.warning(f"gtimg fetch failed for {q}: {e}")
528:         return None
529: def _gt_num(arr, idx):
530:     try:
531:         v = arr[idx]
532:         if v in (None, ""):
533:             return None
534:         return float(v)
535:     except Exception:
536:         return None
537: def _parse_fundamentals(market: str, arr) -> dict:
538:     if not arr or len(arr) < 50:
539:         return {}
540:     real: dict = {}
541:     pe = _gt_num(arr, 39)          # 市盈率(TTM)
542:     pb = _gt_num(arr, 58)          # 市净率（HK 可靠；美股 gtimg 该位不准，跳过）
543:     div = _gt_num(arr, 59)         # 股息率(%)
544:     mcap = _gt_num(arr, 44)        # 总市值(亿元)
545:     high52 = _gt_num(arr, 48)      # 52周最高
546:     low52 = _gt_num(arr, 49)       # 52周最低
547:     price = _gt_num(arr, 3)
548:     if pe is not None and pe > 0:
549:         real["pe"] = round(pe, 2)
550:     if market == "HK" and pb is not None and pb > 0:
551:         real["pb"] = round(pb, 2)
552:     if market == "HK" and div is not None and div >= 0:
553:         real["divYield"] = round(div, 2)
554:     if mcap is not None and mcap > 0:
555:         real["marketCap"] = round(mcap, 1)   # 亿元
556:     if price and high52 and low52 and high52 > low52 > 0:
557:         pct = (price - low52) / (high52 - low52) * 100
558:         real["pePercentile"] = round(max(0.0, min(100.0, pct)), 1)
559:     return real
560: def _fetch_fundamentals(market: str) -> dict:
561:     """逐只抓取真实基本面；仅填充可获得的真实字段，缺失字段由前端回退估算。"""
562:     watchlist = DEFAULT_WATCHLIST.get(market, [])
563:     result: dict[str, dict] = {}
564:     for stock in watchlist:
565:         code = stock["code"]
566:         q = _to_gtimg(market, code)
567:         arr = _gtimg_fetch(q)
568:         real = _parse_fundamentals(market, arr) if arr else {}
569:         result[code] = {
570:             "code": code, "name": stock["name"], "real": real,
571:             "source": "gtimg" if real else None, "estimated": not real, "query": q,
572:         }
573:         time.sleep(0.05)
574:     return result
575: @router.get("/fundamentals/{market}")
576: def get_fundamentals(market: str, raw: bool = Query(default=False)):
577:     """真实基本面（腾讯 gtimg）：PE/PB/股息率/市值/52周估值分位。
578:     real 字段为真实值，前端用它覆盖估算；estimated=true 表示未取到真实值。"""
579:     market = market.upper()
580:     if market not in ("HK", "US"):
581:         return {"market": market, "error": "仅支持 HK / US"}
582:     cache_key = f"fund:{market}"
583:     now = time.time()
584:     if cache_key in _GT_CACHE:
585:         ts, data = _GT_CACHE[cache_key]
586:         if now - ts < _GT_CACHE_TTL:
587:             return {"market": market, "items": data, "updated_at": datetime.now().strftime("%Y/%m/%d %H:%M:%S"),
588:                     "source": "gtimg", "cached": True}
589:     data = _fetch_fundamentals(market)
590:     _GT_CACHE[cache_key] = (now, data)
591:     out = {"market": market, "items": data, "updated_at": datetime.now().strftime("%Y/%m/%d %H:%M:%S"),
592:            "source": "gtimg"}
593:     if raw:
594:         out["raw"] = {code: _gtimg_fetch(_to_gtimg(market, code)) for code in data}
595:     return out
596: # ─── 南向资金（Eastmoney 港股通） ──────────────────────────────────────────────
597: _SB_CACHE: dict[str, tuple[float, dict]] = {}
598: _SB_CACHE_TTL = 1800  # 30 分钟
599: def _fetch_southbound() -> dict:
600:     """港股通南向资金：聚合净买入(最新+20日) + 个股港股通持股变化(尽力)。"""
601:     out = {"totalNet20d": None, "latestNet": None, "latestDate": None, "byStock": {}, "source": None}
602:     # 1) 聚合：港股通南向净买入时序
603:     kline_url = "https://push2.eastmoney.com/api/qt/kamt.kline/get"
604:     kp = {"fields1": "f1,f3", "fields2": "f51,f52", "klt": "101", "lmt": "30",
605:           "ut": "b2884a393a59ad64003c8a8bbb4d8fb9", "invt": "2"}
606:     try:
607:         r = requests.get(kline_url, params=kp, headers={
608:             "User-Agent": "Mozilla/5.0", "Referer": "https://data.eastmoney.com/hsgt/index.html"}, timeout=12)
609:         j = r.json().get("data") or {}
610:         klines = j.get("klines") or []
611:         vals = []
612:         for row in klines:
613:             parts = row.split(",")
614:             if len(parts) >= 2:
615:                 try:
616:                     vals.append((parts[0], float(parts[1])))
617:                 except Exception:
618:                     pass
619:         if vals:
620:             out["latestDate"] = vals[-1][0]
621:             out["latestNet"] = round(vals[-1][1], 2)
622:             out["totalNet20d"] = round(sum(v for _, v in vals[-20:]), 2)
623:             out["source"] = "eastmoney"
624:     except Exception as e:
625:         logger.warning(f"Eastmoney southbound kline failed: {e}")
626:     # 2) 个股：港股通标的持股变化（尽力，失败不影响聚合）
627:     try:
628:         clist_url = "https://push2.eastmoney.com/api/qt/clist/get"
629:         cp = {"pn": "1", "pz": "2000", "fid": "f62", "fs": "m:105+t:3",
630:               "fields": "f12,f14,f62,f63,f64,f65", "invt": "2", "fltt": "2"}
631:         r2 = requests.get(clist_url, params=cp, headers={
632:             "User-Agent": "Mozilla/5.0", "Referer": "https://data.eastmoney.com/hsgt/index.html"}, timeout=12)
633:         arr = (r2.json().get("data") or {}).get("diff") or []
634:         for it in arr:
635:             code = str(it.get("f12") or "").zfill(5)
636:             chg = _em_num(it.get("f65"))  # 持股变化(估算，字段待校准)
637:             if chg is not None:
638:                 out["byStock"][code] = round(chg, 2)
639:     except Exception as e:
640:         logger.warning(f"Eastmoney southbound byStock failed: {e}")
641:     return out
