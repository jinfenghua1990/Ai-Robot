  1: """GET /api/trading-system/daily-report — 当日 4.0 交易信号日报"""
  2: import json
  3: import logging
  4: from datetime import datetime, date
  5: from typing import Optional
  6: from fastapi import APIRouter, Query
  7: from db.session import get_db_session
  8: from db.models import TradingSignalDaily
  9: from services.trading_system.runner import compute_for_date, has_run_today
 10: logger = logging.getLogger(__name__)
 11: router = APIRouter()
 12: @router.get("/api/trading-system/daily-report")
 13: def get_daily_report(date: Optional[str] = Query(None, description="日期 YYYY-MM-DD，默认今天")):
 14:     """当日 4.0 交易信号日报
 15:     返回：市场总览 + 信号汇总 + 信号列表 + 风控警告
 16:     """
 17:     target_date_str = date or datetime.now().strftime('%Y-%m-%d')
 18:     target_date = datetime.strptime(target_date_str, '%Y-%m-%d').date()
 19:     with get_db_session() as db:
 20:         rows = db.query(TradingSignalDaily).filter(
 21:             TradingSignalDaily.trade_date == target_date
 22:         ).order_by(
 23:             TradingSignalDaily.signal_4 == 'STRONG_BUY',
 24:             TradingSignalDaily.final_score.desc(),
 25:         ).all()
 26:         # 无数据时尝试现场计算
 27:         if not rows:
 28:             logger.info(f'[daily-report] 无 {target_date_str} 数据，尝试现场计算')
 29:             try:
 30:                 result = compute_for_date(target_date)
 31:                 if result.get('count', 0) > 0:
 32:                     rows = db.query(TradingSignalDaily).filter(
 33:                         TradingSignalDaily.trade_date == target_date
 34:                     ).order_by(
 35:                         TradingSignalDaily.signal_4 == 'STRONG_BUY',
 36:                         TradingSignalDaily.final_score.desc(),
 37:                     ).all()
 38:             except Exception as e:
 39:                 logger.error(f'[daily-report] compute failed: {e}')
 40:         if not rows:
 41:             return {
 42:                 'date': target_date_str,
 43:                 'market_overview': None,
 44:                 'summary': {'strong_buy': 0, 'watch_buy': 0, 'forbid': 0, 'total': 0},
 45:                 'signals': [],
 46:                 'risk_warnings': [],
 47:                 'message': '暂无数据，请等待盘后预计算',
 48:             }
 49:         # 构建信号列表
 50:         signals = []
 51:         for row in rows:
 52:             signals.append({
 53:                 'ts_code': row.ts_code,
 54:                 'name': row.name,
 55:                 'sector': row.sector,
 56:                 'signal_4': row.signal_4,
 57:                 'signal_label': row.signal_label,
 58:                 'signal_color': row.signal_color,
 59:                 'final_score': float(row.final_score) if row.final_score else 0,
 60:                 'score_detail': json.loads(row.score_detail_json or '{}'),
 61:                 'position_pct': float(row.position_pct) if row.position_pct else 0,
 62:                 'position_amount': float(row.position_amount) if row.position_amount else 0,
 63:                 'stop_loss_pct': float(row.stop_loss_pct) if row.stop_loss_pct else 0,
 64:                 'take_profit_pct': float(row.take_profit_pct) if row.take_profit_pct else 0,
 65:                 'atr_14': float(row.atr_14) if row.atr_14 else 0,
 66:                 'risk_status': row.risk_status,
 67:                 'risk_reasons': json.loads(row.risk_reasons_json or '[]'),
 68:                 'market_state': row.market_state,
 69:                 'sentiment_stage': row.sentiment_stage,
 70:                 'is_high_position': row.is_high_position,
 71:                 'reasons': json.loads(row.reasons_json or '[]'),
 72:             })
 73:         # 市场总览（取多数票）
 74:         market_states = [s['market_state'] for s in signals if s['market_state']]
 75:         sentiments = [s['sentiment_stage'] for s in signals if s['sentiment_stage']]
 76:         dominant_market = max(set(market_states), key=market_states.count) if market_states else 'PENDING'
 77:         dominant_sentiment = max(set(sentiments), key=sentiments.count) if sentiments else '中性'
 78:         # 总仓位建议
 79:         from services.trading_system.risk_engine import SENTIMENT_TOTAL_CAP
 80:         total_cap = SENTIMENT_TOTAL_CAP.get(dominant_sentiment, 40.0)
 81:         total_position = sum(s['position_pct'] for s in signals if s['signal_4'] in ('STRONG_BUY', 'WATCH_BUY'))
 82:         # 汇总
 83:         summary = {
 84:             'strong_buy': sum(1 for s in signals if s['signal_4'] == 'STRONG_BUY'),
 85:             'watch_buy': sum(1 for s in signals if s['signal_4'] == 'WATCH_BUY'),
 86:             'forbid': sum(1 for s in signals if s['signal_4'] == 'FORBID'),
 87:             'total': len(signals),
 88:         }
 89:         # 风控警告
 90:         warnings = []
 91:         if total_position >= total_cap:
 92:             warnings.append(f'总仓位已达 {total_cap}% 上限')
 93:         high_pos = [s for s in signals if s['is_high_position']]
 94:         if high_pos:
 95:             warnings.append(f'{len(high_pos)} 只高位股仓位受限')
 96:         return {
 97:             'date': target_date_str,
 98:             'market_overview': {
 99:                 'market_state': dominant_market,
100:                 'sentiment': dominant_sentiment,
101:                 'total_position_suggestion': round(total_position, 2),
102:                 'total_cap_pct': total_cap,
103:             },
104:             'summary': summary,
105:             'signals': signals,
106:             'risk_warnings': warnings,
107:         }
