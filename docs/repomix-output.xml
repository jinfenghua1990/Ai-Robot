<file path="backend/services/research/myreports.py">
  1: """我的研报 —— 用户上传/归档自己的研报文件，存本地、不上传、不进开源仓库。
  2: 设计取舍：
  3: - 走 base64 JSON 上传（不引入 python-multipart 依赖，契合本项目「秒装必可用」）；研报文件不大，够用。
  4: - 存到 `VR_REPORTS_DIR`（默认 backend/.cache/myreports/，.cache 已 gitignore）——用户私有资料，绝不进仓、不上传。
  5: - 元数据存目录内 index.json；按文件名关键词自动打「行业」标签（best-effort，未命中记「未分类」）。
  6: 合规/隐私：与「持仓 / 关注股只存本地」同一红线——研报是用户私有数据，只落本地磁盘。
  7: """
  8: from __future__ import annotations
  9: import base64
 10: import binascii
 11: import json
 12: import os
 13: import threading
 14: import time
 15: import uuid
 16: from pathlib import Path
 17: _DEFAULT_DIR = Path(__file__).resolve().parent / ".cache" / "myreports"
 18: REPORTS_DIR = Path(os.environ.get("VR_REPORTS_DIR", str(_DEFAULT_DIR)))
 19: _INDEX = REPORTS_DIR / "index.json"
 20: _LOCK = threading.Lock()  # 索引读-改-写串行化（与 portfolio.py 同款），防并发上传/删除互相覆盖
 21: MAX_BYTES = 25 * 1024 * 1024  # 单文件上限 25MB
 22: # 允许的文档类型（白名单——不存可执行 / 网页等，避免下载回放风险）
 23: ALLOWED_EXT = {
 24:     ".pdf", ".doc", ".docx", ".txt", ".md", ".markdown",
 25:     ".csv", ".xls", ".xlsx", ".ppt", ".pptx",
 26:     ".png", ".jpg", ".jpeg", ".webp",
 27: }
 28: # 文件名关键词 → 行业标签（顺序即优先级，先命中先用）。纯文件名匹配、零依赖、离线可用。
 29: _INDUSTRY_KEYWORDS: list[tuple[str, list[str]]] = [
 30:     ("人形机器人", ["人形", "机器人", "humanoid", "谐波", "丝杠", "滚柱", "灵巧手", "减速器", "optimus", "宇树", "特斯拉"]),
 31:     ("光互联", ["光互联", "硅光", "cpo", "光模块", "磷化铟", "inp", "光芯片", "源杰", "中际旭创", "天孚"]),
 32:     ("HBM存储", ["hbm", "存储", "内存", "dram", "长鑫", "美光", "海力士", "颗粒", "闪存", "nand"]),
 33:     ("AI算力", ["算力", "gpu", "英伟达", "nvidia", "服务器", "液冷", "pcb", "交换机", "cowos", "沪电", "工业富联"]),
 34:     ("半导体", ["半导体", "芯片", "晶圆", "光刻", "封测", "台积电", "刻蚀", "存储芯片"]),
 35:     ("新能源", ["锂电", "电池", "光伏", "储能", "固态", "钠电", "宁德", "比亚迪"]),
 36:     ("创新药", ["创新药", "医药", "生物", "cxo", "临床", "adc", "glp", "药明"]),
 37:     ("商业航天", ["航天", "卫星", "火箭", "星链", "starlink", "spacex", "蓝箭"]),
 38:     ("电力电网", ["电力", "电网", "特高压", "变压器", "输配电", "燃气轮机"]),
 39: ]
 40: class ReportError(ValueError):
 41:     """上传/校验类错误（对应 HTTP 400/413）。"""
 42: def _ensure_dir() -> None:
 43:     REPORTS_DIR.mkdir(parents=True, exist_ok=True)
 44: def _load_index() -> list[dict]:
 45:     if not _INDEX.exists():
 46:         return []
 47:     try:
 48:         data = json.loads(_INDEX.read_text("utf-8"))
 49:         return data if isinstance(data, list) else []
 50:     except (json.JSONDecodeError, OSError):
 51:         return []
 52: def _save_index(items: list[dict]) -> None:
 53:     _ensure_dir()
 54:     tmp = _INDEX.with_suffix(".json.tmp")
 55:     tmp.write_text(json.dumps(items, ensure_ascii=False, indent=2), "utf-8")
 56:     os.replace(tmp, _INDEX)  # 原子改名，避免半截写入损坏索引（进程被 kill / OOM）
 57: def classify(filename: str) -> str:
 58:     """按文件名关键词判行业；未命中记「未分类」。"""
 59:     low = filename.lower()
 60:     for industry, kws in _INDUSTRY_KEYWORDS:
 61:         if any(kw.lower() in low for kw in kws):
 62:             return industry
 63:     return "未分类"
 64: def _sanitize_name(name: str) -> str:
 65:     """只保留基名，去掉路径分隔符；空名给个兜底。"""
 66:     base = os.path.basename((name or "").replace("\\", "/")).strip()
 67:     return base or "未命名"
 68: def list_reports() -> list[dict]:
 69:     """按上传时间倒序返回元数据列表。"""
 70:     return sorted(_load_index(), key=lambda r: r.get("ts", 0), reverse=True)
 71: def save_report(name: str, content_b64: str) -> dict:
 72:     """解码 base64 存盘 + 打行业标签 + 记录元数据。返回该条元数据。"""
 73:     fname = _sanitize_name(name)
 74:     ext = os.path.splitext(fname)[1].lower()
 75:     if ext not in ALLOWED_EXT:
 76:         raise ReportError(f"不支持的文件类型 {ext or '（无扩展名）'}；支持：PDF / Word / txt / md / 表格 / 图片")
 77:     # base64 可能带 data:URI 前缀（前端 FileReader.readAsDataURL），剥掉逗号前半段
 78:     if content_b64.startswith("data:"):
 79:         parts = content_b64.split(",", 1)
 80:         if len(parts) < 2:
 81:             raise ReportError("无效的 data URI（缺少逗号分隔的 base64 数据）")
 82:         raw_b64 = parts[1]
 83:     else:
 84:         raw_b64 = content_b64
 85:     try:
 86:         blob = base64.b64decode(raw_b64, validate=True)
 87:     except (binascii.Error, ValueError) as e:
 88:         raise ReportError(f"文件内容解码失败：{e}") from e
 89:     if not blob:
 90:         raise ReportError("文件为空")
 91:     if len(blob) > MAX_BYTES:
 92:         raise ReportError(f"文件过大（{len(blob) // 1024 // 1024}MB），上限 {MAX_BYTES // 1024 // 1024}MB")
 93:     _ensure_dir()
 94:     rid = uuid.uuid4().hex
 95:     (REPORTS_DIR / f"{rid}{ext}").write_bytes(blob)
 96:     meta = {
 97:         "id": rid,
 98:         "name": fname,
 99:         "industry": classify(fname),
100:         "size": len(blob),
101:         "ext": ext,
102:         "ts": int(time.time() * 1000),
103:     }
104:     with _LOCK:
105:         items = _load_index()
106:         items.append(meta)
107:         _save_index(items)
108:     return meta
109: def report_path(rid: str) -> tuple[Path, str] | None:
110:     """按 id 取 (磁盘路径, 原始文件名)；不存在返回 None。"""
111:     for r in _load_index():
112:         if r.get("id") == rid:
113:             p = REPORTS_DIR / f"{rid}{r.get('ext', '')}"
114:             return (p, r.get("name", rid)) if p.exists() else None
115:     return None
116: def delete_report(rid: str) -> bool:
117:     """删文件 + 移除索引条目。删成功（或本就不在）返回是否命中。"""
118:     with _LOCK:
119:         items = _load_index()
120:         hit = next((r for r in items if r.get("id") == rid), None)
121:         if hit is None:
122:             return False
123:         fp = REPORTS_DIR / f"{rid}{hit.get('ext', '')}"
124:         try:
125:             fp.unlink(missing_ok=True)
126:         except OSError:
127:             pass
128:         _save_index([r for r in items if r.get("id") != rid])
129:     return True
