<file path="backend/api/git_push.py">
 1: """
 2: 一键上传 API
 3: - POST /api/git-push   将当前仓库改动 add + commit + push 到 GitHub (Ai-Robot)
 4: 安全说明：
 5: - 使用 subprocess 列表形式调用 git，绝不拼接用户输入到 shell，避免命令注入。
 6: - commit message 仅作 git 参数传递，不进入 shell 解析。
 7: - 显式指定部署专用 SSH 密钥，确保 uvicorn 常驻进程环境下也能认证。
 8: """
 9: import os
10: import subprocess
11: from datetime import datetime
12: from fastapi import APIRouter, Body, Depends
13: from fastapi.responses import JSONResponse
14: from api.auth import verify_api_key
15: router = APIRouter(prefix="/api", tags=["git"])
16: # 仓库根目录（相对本文件计算，避免依赖进程 cwd）
17: REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), "..", ".."))
18: # 部署专用 SSH 密钥（确保 uvicorn 进程环境下也能认证；密钥无口令）
19: _KEY = os.path.expanduser("~/.ssh/airobot_deploy_ed25519")
20: GIT_SSH_COMMAND = f"ssh -i {_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=no"
21: def _run(args: list):
22:     return subprocess.run(
23:         args,
24:         cwd=REPO_ROOT,
25:         capture_output=True,
26:         text=True,
27:         env={
28:             **os.environ,
29:             "GIT_SSH_COMMAND": GIT_SSH_COMMAND,
30:             "HOME": os.path.expanduser("~"),
31:         },
32:         timeout=120,
33:     )
34: @router.post("/git-push", dependencies=[Depends(verify_api_key)])
35: def git_push(payload: dict = Body(default={})):
36:     """将本地改动提交并推送到远程 main 分支。
37:     请求体可选字段:
38:         message (str): 自定义提交说明；省略则用「网页一键上传: <时间>」
39:     返回:
40:         { ok, had_changes, commit_message, output }
41:     """
42:     try:
43:         # 1. 是否有未提交改动
44:         status = _run(["git", "status", "--porcelain"])
45:         has_changes = bool(status.stdout.strip())
46:         # 2. 暂存全部（.gitignore 已排除 .trash/ backups/ 等本地产物）
47:         _run(["git", "add", "-A"])
48:         # 3. 有改动才提交
49:         commit_msg = None
50:         if has_changes:
51:             commit_msg = (payload or {}).get("message") or \
52:                 f"网页一键上传: {datetime.now().strftime('%Y-%m-%d %H:%M')}"
53:             _run(["git", "commit", "-q", "-m", commit_msg])
54:         # 4. 推送到 origin/main
55:         push = _run(["git", "push", "origin", "main"])
56:         output = (push.stdout + push.stderr).strip()
57:         return {
58:             "ok": push.returncode == 0,
59:             "had_changes": has_changes,
60:             "commit_message": commit_msg,
61:             "output": output[-800:],  # 截断，避免响应过大
62:         }
63:     except subprocess.TimeoutExpired:
64:         return JSONResponse(
65:             status_code=504,
66:             content={"ok": False, "error": "git push 超时(>120s)，请稍后重试"},
67:         )
68:     except Exception as e:  # noqa: BLE001
69:         return JSONResponse(status_code=500, content={"ok": False, "error": str(e)})
