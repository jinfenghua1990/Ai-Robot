  4: import { apiFetch } from '../../utils/request';
  5: /**
  6:  * Top 10 板块资金流向对比
  7:  * 左：盘后 Top 10 板块资金流向走势（日度时间轴折线）
  8:  * 右：同一批板块实时资金流向走势（分钟时间轴折线）
  9:  */
 10: export default function SectorMoneyFlowCompareSection({
 11:   selectedDate, rtSectors, selectedSector, onSelectSector,
 12: }) {
 13:   const [rotationData, setRotationData] = useState(null);
 14:   const [loading, setLoading] = useState(false);
 15:   const [error, setError] = useState(null);
 16:   useEffect(() => {
 17:     if (!selectedDate) return;
 18:     const controller = new AbortController();
 19:     setLoading(true);
 20:     setError(null);
 21:     (async () => {
 22:       const res = await apiFetch(`/api/rotation?date=${selectedDate}&days=1`, { signal: controller.signal });
 23:       if (controller.signal.aborted) return;
 24:       if (res.ok) {
 25:         setRotationData(res.data);
 26:       } else {
 27:         setRotationData(null);
 28:         setError(res.error || '数据加载失败');
 29:       }
 30:       setLoading(false);
 31:     })();
 32:     return () => controller.abort();
 33:   }, [selectedDate]);
 34:   // 盘后 Top 10 板块：按 |net_flow| 排序，取前 10
 35:   const postTop10 = useMemo(() => {
 36:     if (!rotationData?.signals) return [];
 37:     const sectorFlows = [];
 38:     rotationData.signals.forEach(signal => {
 39:       const match = signal.match(/资金(流入|流出)[：:]\s*/);
 40:       if (!match) return;
 41:       const type = match[1];
 42:       const sectors = signal.replace(/资金(流入|流出)[：:]\s*/, '').split('、').filter(Boolean);
 43:       sectors.forEach(name => {
 44:         // 从 rotationData 的 all_inflows/all_outflows 中找具体数值
 45:         const inItem = rotationData.all_inflows?.find(s => s.sector === name);
 46:         const outItem = rotationData.all_outflows?.find(s => s.sector === name);
 47:         if (inItem) sectorFlows.push({ name, value: inItem.change, current: inItem.current, past: inItem.past });
 48:         else if (outItem) sectorFlows.push({ name, value: outItem.change, current: outItem.current, past: outItem.past });
 49:       });
 50:     });
 51:     return sectorFlows
 52:       .sort((a, b) => Math.abs(b.value) - Math.abs(a.value))
 53:       .slice(0, 10);
 54:   }, [rotationData]);
 55:   const sectorNames = useMemo(() => postTop10.map(s => s.name), [postTop10]);
 56:   const handleSelect = useCallback((name) => {
 57:     if (onSelectSector) onSelectSector(name);
 58:   }, [onSelectSector]);
 59:   return (
 60:     <div className="rounded-xl border p-3" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)' }}>
 61:       <div className="flex items-center justify-between mb-2">
 62:         <h2 className="text-lg font-bold" style={{ color: 'var(--text-primary)' }}>
 63:           Top 10 板块资金流向对比
 64:           <span className="ml-2 px-1.5 py-0.5 rounded text-[10px] font-normal align-middle" style={{ background: 'rgba(234,179,8,0.1)', color: '#eab308' }}>
 65:             {selectedDate ? `${selectedDate.slice(5).replace('-', '月')}日` : ''} 盘后 vs 实时
 66:             {rotationData?.actual_date && rotationData.actual_date !== selectedDate && (
 67:               <span className="ml-1" style={{ color: '#eab308' }}>（盘后已回退 {rotationData.actual_date.slice(5).replace('-', '月')}日）</span>
 68:             )}
 69:           </span>
 70:         </h2>
 71:         <div className="flex items-center gap-3 text-xs" style={{ color: 'var(--text-muted)' }}>
 72:           <span className="flex items-center gap-1"><span className="inline-block w-3 h-0.5 rounded" style={{ background: '#ef4444' }}></span>净流入</span>
 73:           <span className="flex items-center gap-1"><span className="inline-block w-3 h-0.5 rounded" style={{ background: '#22c55e' }}></span>净流出</span>
 74:         </div>
 75:       </div>
 76:       <div className="grid grid-cols-1 lg:grid-cols-2 gap-3 items-start">
 77:         {/* 左：盘后 Top 10 资金流向走势 */}
 78:         <div className="rounded-xl border p-3" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-surface)' }}>
 79:           <h3 className="text-sm font-medium mb-1" style={{ color: 'var(--text-secondary)' }}>
 80:             📊 盘后 Top 10 资金流向走势
 81:           </h3>
 82:           {loading ? (
 83:             <div className="h-64 rounded-xl animate-pulse" style={{ background: 'var(--bg-hover)' }} />
 84:           ) : error ? (
 85:             <div className="flex flex-col items-center justify-center h-64 gap-2">
 86:               <div className="text-sm" style={{ color: '#ef4444' }}>{error}</div>
 87:               <button onClick={() => setSelectedDate(selectedDate)} className="px-3 py-1.5 rounded-lg border text-xs" style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)' }}>重试</button>
 88:             </div>
 89:           ) : sectorNames.length === 0 ? (
 90:             <div className="flex items-center justify-center h-64 text-sm" style={{ color: 'var(--text-muted)' }}>暂无板块资金流向数据</div>
 91:           ) : (
 92:             <SectorPostTrendChart
 93:               sectors={sectorNames}
 94:               selectedDate={selectedDate}
 95:               days={5}
 96:               selectedSector={selectedSector}
 97:               onSectorClick={handleSelect}
 98:             />
 99:           )}
100:         </div>
101:         {/* 右：实时 Top 10 资金流向走势 */}
102:         <div className="rounded-xl border p-3" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-surface)' }}>
103:           <h3 className="text-sm font-medium mb-1" style={{ color: 'var(--text-secondary)' }}>
104:             ⚡ 实时 Top 10 资金流向走势
105:             <span className="ml-2 text-xs font-normal" style={{ color: 'var(--text-muted)' }}>
106:               {rtSectors?.trade_date || selectedDate} 盘中
107:             </span>
108:           </h3>
109:           {loading ? (
110:             <div className="h-64 rounded-xl animate-pulse" style={{ background: 'var(--bg-hover)' }} />
111:           ) : error ? (
112:             <div className="flex items-center justify-center h-64 text-sm" style={{ color: 'var(--text-muted)' }}>数据加载失败</div>
113:           ) : sectorNames.length === 0 ? (
114:             <div className="flex items-center justify-center h-64 text-sm" style={{ color: 'var(--text-muted)' }}>暂无板块资金流向数据</div>
115:           ) : (
116:             <SectorRealtimeTrendChart
117:               sectors={sectorNames}
118:               rtSectors={rtSectors}
119:               selectedSector={selectedSector}
120:               onSectorClick={handleSelect}
121:             />
122:           )}
123:         </div>
124:       </div>
125:     </div>
126:   );
127: }
