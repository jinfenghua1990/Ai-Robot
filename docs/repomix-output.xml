<file path="backend/us_quant/cache.py">
 1: """
 2: US Quant System — 简单缓存层
 3: V2.2: 减少 API 重复计算，缓存扫描结果。
 4: """
 5: from __future__ import annotations
 6: import time
 7: import logging
 8: from functools import lru_cache
 9: from typing import Any, Optional
10: logger = logging.getLogger(__name__)
11: class TTLCache:
12:     """时间感知缓存，支持 TTL 过期"""
13:     def __init__(self, default_ttl: int = 300):
14:         self._store: dict[str, tuple[float, Any]] = {}
15:         self.default_ttl = default_ttl
16:     def get(self, key: str) -> Optional[Any]:
17:         now = time.time()
18:         entry = self._store.get(key)
19:         if entry is None:
20:             return None
21:         expires_at, value = entry
22:         if now > expires_at:
23:             del self._store[key]
24:             return None
25:         return value
26:     def set(self, key: str, value: Any, ttl: Optional[int] = None):
27:         ttl = ttl if ttl is not None else self.default_ttl
28:         self._store[key] = (time.time() + ttl, value)
29:     def delete(self, key: str):
30:         self._store.pop(key, None)
31:     def clear(self):
32:         self._store.clear()
33:     def keys(self) -> list[str]:
34:         return list(self._store.keys())
35: # 全局缓存实例
36: scanner_cache = TTLCache(default_ttl=120)  # 扫描结果缓存 2 分钟
37: kline_cache = TTLCache(default_ttl=60)     # K 线数据缓存 1 分钟
38: def make_cache_key(scanner: bool = False, **kwargs) -> str:
39:     """生成缓存 key"""
40:     parts = sorted(f"{k}={v}" for k, v in kwargs.items() if v)
41:     prefix = "scanner" if scanner else "kline"
42:     return f"{prefix}:{'|'.join(parts)}"
43: def cached_scanner(ttl: int = 120):
44:     """装饰器：缓存扫描结果"""
45:     def decorator(func):
46:         def wrapper(*args, **kwargs):
47:             key = make_cache_key(scanner=True, **kwargs)
48:             cached = scanner_cache.get(key)
49:             if cached is not None:
50:                 logger.debug(f"[cache] 命中 scanner: {key}")
51:                 return cached
52:             result = func(*args, **kwargs)
53:             scanner_cache.set(key, result, ttl=ttl)
54:             return result
55:         return wrapper
56:     return decorator
