103: async def _recalc_cost_from_orders(sec_code: str, count: int, price: float, api_key: str = None) -> tuple:
104:     """从委托记录重算真实成本价（当妙想API返回负成本时使用）"""
105:     try:
106:         raw = await _proxy('/api/claw/mockTrading/orders', {
107:             'moneyUnit': 1,
108:             'beginDate': '',
109:             'endDate': '',
110:             'beginTime': 0,
111:             'endTime': 0,
112:             'count': 200,
113:             'offset': 0,
114:         }, cache_key='mx_orders', api_key=api_key)
115:         orders = raw.get('orders') or raw.get('orderList') or []
116:         buys = []
117:         sold_count = 0
118:         for o in orders:
119:             if o.get('secCode') != sec_code:
120:                 continue
121:             if o.get('status') != 4:
122:                 continue
123:             price_dec = o.get('priceDec', 2)
124:             raw_tp = o.get('tradePrice') or o.get('price') or 0
125:             tp = raw_tp / (10 ** price_dec)
126:             tc = o.get('tradeCount', 0)
127:             if o.get('drt') == 1:
128:                 buys.append((tp, tc))
129:             elif o.get('drt') == 2:
130:                 sold_count += tc
131:         remaining = count
132:         if remaining <= 0:
133:             return (price, 0, 0)
134:         total_cost = 0
135:         allocated_sold = sold_count
136:         for tp, tc in buys:
137:             if allocated_sold >= tc:
138:                 allocated_sold -= tc
139:                 continue
140:             avail = tc - allocated_sold
141:             allocated_sold = 0
142:             take = min(avail, remaining)
143:             total_cost += tp * take
144:             remaining -= take
145:             if remaining <= 0:
146:                 break
147:         if total_cost <= 0:
148:             return (price, 0, 0)
149:         real_cost = total_cost / count
150:         profit = (price - real_cost) * count
151:         profit_pct = (price - real_cost) / real_cost * 100 if real_cost > 0 else 0
152:         return (real_cost, profit, profit_pct)
153:     except Exception as e:
154:         logger.debug(f'[mx_trading] 成本重算失败: {e}')
155:         return (price, 0, 0)
