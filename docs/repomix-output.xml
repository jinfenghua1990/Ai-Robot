  1: """
  2: AKShare 采集器 - 开源Python库，整合东财/新浪/同花顺等多源数据
  3: 无额度限制，实时行情基于新浪（可用），资金流向基于东财push2his（可能受限）
  4: """
  5: import logging
  6: from utils.http_constants import clear_proxy_env
  7: from utils.cache import BoundedDict
  8: logger = logging.getLogger(__name__)
  9: clear_proxy_env()
 10: try:
 11:     import akshare as ak
 12:     AKSHARE_AVAILABLE = True
 13:     AKSHARE_VERSION = ak.__version__
 14: except ImportError:
 15:     AKSHARE_AVAILABLE = False
 16:     AKSHARE_VERSION = None
 17: # 全市场实时行情缓存（避免每次都全量拉取）
 18: _spot_cache = BoundedDict(maxsize=6000)  # A股约5000+只，容量需大于此
 19: _spot_cache_time = 0
 20: _SPOT_CACHE_TTL = 60  # 60秒缓存
 21: def akshare_batch_prices(ts_codes):
 22:     """
 23:     批量获取实时行情（基于新浪，无额度限制）
 24:     ts_codes: ["600519.SH", "000001.SZ", ...]
 25:     返回: {ts_code: {price, change_pct, open, high, low, prev_close, volume, amount}}
 26:     """
 27:     if not AKSHARE_AVAILABLE:
 28:         return {}
 29:     import time
 30:     global _spot_cache, _spot_cache_time
 31:     now = time.time()
 32:     if now - _spot_cache_time > _SPOT_CACHE_TTL:
 33:         # 缓存过期，重新拉取全市场行情
 34:         try:
 35:             df = ak.stock_zh_a_spot()
 36:             _spot_cache = BoundedDict(maxsize=6000)  # A股约5000+只，容量需大于此
 37:             for _, row in df.iterrows():
 38:                 code = str(row['代码'])  # 如 bj920000, sh600519, sz000001
 39:                 # 标准化为 ts_code 格式
 40:                 if code.startswith('sh'):
 41:                     tc = f"{code[2:]}.SH"
 42:                 elif code.startswith('sz'):
 43:                     tc = f"{code[2:]}.SZ"
 44:                 elif code.startswith('bj'):
 45:                     tc = f"{code[2:]}.BJ"
 46:                 else:
 47:                     continue
 48:                 _spot_cache[tc] = {
 49:                     'price': float(row.get('最新价', 0) or 0),
 50:                     'change_pct': float(row.get('涨跌幅', 0) or 0),
 51:                     'open': float(row.get('今开', 0) or 0),
 52:                     'high': float(row.get('最高', 0) or 0),
 53:                     'low': float(row.get('最低', 0) or 0),
 54:                     'prev_close': float(row.get('昨收', 0) or 0),
 55:                     'volume': float(row.get('成交量', 0) or 0),
 56:                     'amount': float(row.get('成交额', 0) or 0),
 57:                 }
 58:             _spot_cache_time = now
 59:             print(f'[akshare] Cached {len(_spot_cache)} stocks from stock_zh_a_spot')
 60:         except Exception as e:
 61:             logger.warning(f'[akshare] stock_zh_a_spot error: {e}', exc_info=True)
 62:             return {}
 63:     # 从缓存中提取请求的股票
 64:     result = {}
 65:     for tc in ts_codes:
 66:         if tc in _spot_cache:
 67:             result[tc] = _spot_cache[tc]
 68:     return result
 69: def akshare_single_fund_flow(ts_code):
 70:     """
 71:     个股资金流向（基于东财push2his，可能受限）
 72:     ts_code: "000001.SZ" 或 "600519.SH"
 73:     返回: {main_net, super_net, big_net, mid_net, small_net} 单位：元，或None
 74:     """
 75:     if not AKSHARE_AVAILABLE:
 76:         return None
 77:     code = ts_code.replace('.SH', '').replace('.SZ', '').replace('.BJ', '')
 78:     market = 'sh' if ts_code.endswith('.SH') else 'sz'
 79:     if ts_code.endswith('.BJ'):
 80:         market = 'bj'
 81:     try:
 82:         df = ak.stock_individual_fund_flow(stock=code, market=market)
 83:         if df is None or df.empty:
 84:             return None
 85:         # 取最后一条（当日）
 86:         last = df.iloc[-1]
 87:         return {
 88:             'main_net': float(last.get('主力净流入-净额', 0) or 0),
 89:             'super_net': float(last.get('超大单净流入-净额', 0) or 0),
 90:             'big_net': float(last.get('大单净流入-净额', 0) or 0),
 91:             'mid_net': float(last.get('中单净流入-净额', 0) or 0),
 92:             'small_net': float(last.get('小单净流入-净额', 0) or 0),
 93:         }
 94:     except Exception as e:
 95:         logger.warning(f'[akshare] fund_flow error for {ts_code}: {e}', exc_info=True)
 96:         return None
 97: def akshare_fund_flow_rank():
 98:     """
 99:     全市场资金流向排名（基于东财push2his，可能受限）
100:     返回: [{ts_code, name, main_net, ...}, ...] 或 None
101:     """
102:     if not AKSHARE_AVAILABLE:
103:         return None
104:     try:
105:         df = ak.stock_individual_fund_flow_rank(indicator='今日')
106:         if df is None or df.empty:
107:             return None
108:         result = []
109:         for _, row in df.iterrows():
110:             code = str(row.get('代码', ''))
111:             if not code:
112:                 continue
113:             if code.startswith('6') or code.startswith('9'):
114:                 tc = f"{code}.SH"
115:             elif code.startswith('8'):
116:                 tc = f"{code}.BJ"
117:             else:
118:                 tc = f"{code}.SZ"
119:             result.append({
120:                 'ts_code': tc,
121:                 'name': row.get('名称', ''),
122:                 'main_net': float(row.get('今日主力净流入-净额', 0) or 0),
123:                 'main_net_pct': float(row.get('今日主力净流入-净占比', 0) or 0),
124:                 'super_net': float(row.get('今日超大单净流入-净额', 0) or 0),
125:                 'big_net': float(row.get('今日大单净流入-净额', 0) or 0),
126:                 'mid_net': float(row.get('今日中单净流入-净额', 0) or 0),
127:                 'small_net': float(row.get('今日小单净流入-净额', 0) or 0),
128:             })
129:         return result
130:     except Exception as e:
131:         logger.warning(f'[akshare] fund_flow_rank error: {e}', exc_info=True)
132:         return None
133: if __name__ == '__main__':
134:     print(f'AKShare version: {AKSHARE_VERSION}')
135:     print(f'Available: {AKSHARE_AVAILABLE}')
136:     # 测试批量行情
137:     print('\n=== 批量行情 ===')
138:     prices = akshare_batch_prices(['000001.SZ', '600519.SH'])
139:     for tc, data in prices.items():
140:         print(f'{tc}: 价格={data["price"]}, 涨跌幅={data["change_pct"]}%')
141:     # 测试个股资金流向
142:     print('\n=== 个股资金流向 ===')
143:     flow = akshare_single_fund_flow('000001.SZ')
144:     if flow:
145:         print(f'主力净流入: {flow["main_net"]/10000:.2f}万')
146:     else:
147:         print('资金流向接口不可用（push2his可能受限）')
