  99:     # MACD
 100:     dif_arr, dea_arr, macd_arr = calc_macd(closes)
 101:     # 取最后两个有效值（今日 + 昨日）判断金叉/死叉
 102:     def _last_two(arr):
 103:         valid = [(i, v) for i, v in enumerate(arr) if v is not None]
 104:         if len(valid) < 2:
 105:             return None, None
 106:         return valid[-2][1], valid[-1][1]
 107:     prev_k, cur_k = _last_two(k_vals)
 108:     prev_d, cur_d = _last_two(d_vals)
