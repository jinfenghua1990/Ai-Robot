<file path="frontend/src/components/charts/ChartLabelLayer.jsx">
 1: import { useState, useEffect, useRef } from 'react';
 2: /**
 3:  * 图表右侧外部标签层 —— 替代 ECharts 内置 endLabel，彻底避免标签重叠
 4:  *
 5:  * 原理：用 echartsInstance.convertToPixel 把每条线的最终值转为 y 像素坐标，
 6:  *       按坐标排序后强制最小间距（minGap），用绝对定位渲染，保证永不重叠。
 7:  *
 8:  * chartRef: ReactECharts 的 ref（通过 .getEchartsInstance() 取实例）
 9:  * items: [{ key, label, value, valueText, color, isPositive, isSelected, dimmed, onClick }]
10:  */
11: export default function ChartLabelLayer({ chartRef, items, width = 160, minGap = 18 }) {
12:   const [positions, setPositions] = useState([]);
13:   const rafRef = useRef(0);
14:   useEffect(() => {
15:     const compute = () => {
16:       const instance = chartRef.current?.getEchartsInstance?.();
17:       if (!instance || !items || items.length === 0) {
18:         setPositions([]);
19:         return;
20:       }
21:       try {
22:         const calculated = items
23:           .map(item => {
24:             const y = instance.convertToPixel({ yAxisIndex: 0 }, item.value);
25:             return { ...item, y: Number.isFinite(y) ? y : null };
26:           })
27:           .filter(item => item.y !== null);
28:         // 按 y 坐标排序（y 小的在上方）
29:         calculated.sort((a, b) => a.y - b.y);
30:         // 强制最小间距：相邻标签若距离不足 minGap，向下推开
31:         for (let i = 1; i < calculated.length; i++) {
32:           if (calculated[i].y - calculated[i - 1].y < minGap) {
33:             calculated[i].y = calculated[i - 1].y + minGap;
34:           }
35:         }
36:         setPositions(calculated);
37:       } catch {
38:         // 图表未就绪，跳过本次计算
39:       }
40:     };
41:     // 双 RAF 确保图表完成渲染再读取坐标
42:     cancelAnimationFrame(rafRef.current);
43:     rafRef.current = requestAnimationFrame(() => {
44:       rafRef.current = requestAnimationFrame(compute);
45:     });
46:     const onResize = () => {
47:       cancelAnimationFrame(rafRef.current);
48:       rafRef.current = requestAnimationFrame(compute);
49:     };
50:     window.addEventListener('resize', onResize);
51:     return () => {
52:       cancelAnimationFrame(rafRef.current);
53:       window.removeEventListener('resize', onResize);
54:     };
55:   }, [items, chartRef, minGap]);
56:   if (positions.length === 0) return null;
57:   return (
58:     <div className="absolute top-0 right-0 pointer-events-none" style={{ width: `${width}px`, height: '100%' }}>
59:       {positions.map(p => (
60:         <div
61:           key={p.key}
62:           className="absolute flex items-center gap-1 whitespace-nowrap"
63:           style={{
64:             top: `${p.y}px`,
65:             right: '4px',
66:             transform: 'translateY(-50%)',
67:             opacity: p.dimmed ? 0.3 : 1,
68:             pointerEvents: p.onClick ? 'auto' : 'none',
69:             cursor: p.onClick ? 'pointer' : 'default',
70:           }}
71:           onClick={p.onClick}
72:         >
73:           <span style={{ color: p.color, fontSize: 11, fontWeight: p.isSelected ? 700 : 600 }}>
74:             {p.label}
75:           </span>
76:           <span style={{ color: p.isPositive ? '#ef4444' : '#22c55e', fontSize: 11, fontWeight: 600 }}>
77:             {p.valueText}
78:           </span>
79:         </div>
80:       ))}
81:     </div>
82:   );
83: }
</file>

