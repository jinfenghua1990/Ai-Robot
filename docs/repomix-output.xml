<file path="backend/api/strategy_resonance.py">
  1: """
  2: 🎯 多策略共振 API
  3: - GET /api/strategy-resonance  聚合当日所有策略命中，按共振数排序
  4: 共振 = 同一只股票被多个策略同时命中，不同维度共振意味着更强信号。
  5: V4.0 子共振：liangjia_report 内部 5 种形态拆分为独立虚拟策略维度参与共振计数
  6:   - pullback(回踩) / breakout(突破) / trend(趋势) → 各算 1 次共振
  7:   - repair(修复) → 算 1 次但标注低权重
  8:   - weak(偏弱) → 不参与共振
  9: """
 10: from datetime import datetime, date
 11: from collections import defaultdict
 12: from typing import Optional
 13: import json
 14: from fastapi import APIRouter, Query
 15: from sqlalchemy import desc, func
 16: from db.session import get_db_session
 17: from db.models import StrategyResult, StockDailyKline
 18: from services.strategy_runner import STRATEGIES, get_strategy_meta
 19: from api.validators import validate_date
 20: import logging
 21: logger = logging.getLogger(__name__)
 22: router = APIRouter()
 23: # 朱雀 V3.0 形态 → 虚拟策略 key & icon 映射
 24: _V4_PATTERN_META = {
 25:     'pullback':  {'key': 'v4_pullback',  'name': '朱雀V3.0回踩',  'icon': '📉'},
 26:     'breakout':  {'key': 'v4_breakout',  'name': '朱雀V3.0突破',  'icon': '🚀'},
 27:     'trend':     {'key': 'v4_trend',     'name': '朱雀V3.0趋势',  'icon': '📈'},
 28:     'repair':    {'key': 'v4_repair',    'name': '朱雀V3.0修复',  'icon': '🔧'},
 29:     # 'weak' 不映射 → 跳过不参与共振
 30: }
 31: @router.get("/api/strategy-resonance")
 32: def get_strategy_resonance(
 33:     date: str = Query(None, description="YYYY-MM-DD，默认今天"),
 34:     min_count: int = Query(2, description="最小共振数过滤，默认2"),
 35: ):
 36:     """返回当日被多个策略同时命中的股票，按共振数降序排序
 37:     V4.0 的 pullback/breakout/trend/repair 形态各算一个独立共振维度。
 38:     """
 39:     trade_date_str = validate_date(date)
 40:     with get_db_session() as db:
 41:         rows = db.query(StrategyResult).filter(
 42:             StrategyResult.trade_date == trade_date_str
 43:         ).order_by(desc(StrategyResult.score)).all()
 44:         if not rows:
 45:             return {
 46:                 'trade_date': trade_date_str,
 47:                 'total_stocks': 0,
 48:                 'total_hits': 0,
 49:                 'strategy_meta': _build_strategy_meta(),
 50:                 'stocks': [],
 51:             }
 52:         # 按 ts_code 分组，V4.0 按形态展开为独立虚拟策略
 53:         grouped = defaultdict(lambda: {'name': '', 'sector': '', 'strategies': [], 'total_score': 0})
 54:         for r in rows:
 55:             key = r.ts_code
 56:             # 跳过风险退出策略（卖出信号，不参与共振维度计数）
 57:             if r.strategy_key == 'risk_exit':
 58:                 continue
 59:             # V4.0 子共振：按形态拆成虚拟策略维度
 60:             if r.strategy_key == 'liangjia_report':
 61:                 pattern = _extract_v4_pattern(r)
 62:                 if pattern is None:
 63:                     continue  # 无法识别形态 → 跳过
 64:                 if pattern == 'weak':
 65:                     continue  # 结构偏弱 → 不参与共振
 66:                 pmeta = _V4_PATTERN_META.get(pattern, {})
 67:                 if not pmeta:
 68:                     continue
 69:                 # 仅在首次访问时设置 name/sector，避免同一 ts_code 多策略命中时重复覆盖
 70:                 if not grouped[key]['name']:
 71:                     grouped[key]['name'] = r.name or ''
 72:                 if not grouped[key]['sector']:
 73:                     grouped[key]['sector'] = r.sector or ''
 74:                 grouped[key]['strategies'].append({
 75:                     'strategy_key': pmeta['key'],
 76:                     'strategy_name': pmeta['name'],
 77:                     'icon': pmeta['icon'],
 78:                     'score': float(r.score) if r.score else 0,
 79:                     'parent_strategy': 'liangjia_report',
 80:                 })
 81:                 grouped[key]['total_score'] += float(r.score) if r.score else 0
 82:                 continue
 83:             # 非 V4.0 策略：照常处理
 84:             meta = get_strategy_meta(r.strategy_key) or {'icon': '📌'}
 85:             score = float(r.score) if r.score else 0
 86:             # 仅在首次访问时设置 name/sector，避免同一 ts_code 多策略命中时重复覆盖
 87:             if not grouped[key]['name']:
 88:                 grouped[key]['name'] = r.name or ''
 89:             if not grouped[key]['sector']:
 90:                 grouped[key]['sector'] = r.sector or ''
 91:             grouped[key]['strategies'].append({
 92:                 'strategy_key': r.strategy_key,
 93:                 'strategy_name': r.strategy_name or meta.get('name', r.strategy_key),
 94:                 'icon': meta.get('icon', '📌'),
 95:                 'score': score,
 96:             })
 97:             grouped[key]['total_score'] += score
 98:         # 构建股票列表并过滤
 99:         stocks = []
100:         for ts_code, info in grouped.items():
101:             resonance_count = len(info['strategies'])
102:             if resonance_count < min_count:
103:                 continue
104:             stocks.append({
105:                 'ts_code': ts_code,
106:                 'secCode': ts_code.split('.')[0] if '.' in ts_code else ts_code,
107:                 'name': info['name'],
108:                 'sector': info['sector'],
109:                 'resonance_count': resonance_count,
110:                 'total_score': round(info['total_score'], 2),
111:                 'strategies': info['strategies'],
112:             })
113:         # ── 价格数据：批量查询最新 K 线和 20 日涨幅 ──
114:         if stocks:
115:             ts_codes = [s['ts_code'] for s in stocks]
116:             td = datetime.strptime(trade_date_str, '%Y-%m-%d').date() \
117:                 if isinstance(trade_date_str, str) else trade_date_str
118:             # 最新 K 线（单条分组取最大 trade_date）
119:             latest_subq = db.query(
120:                 StockDailyKline.ts_code,
121:                 func.max(StockDailyKline.trade_date).label('max_date')
122:             ).filter(
123:                 StockDailyKline.ts_code.in_(ts_codes),
124:                 StockDailyKline.trade_date <= td
125:             ).group_by(StockDailyKline.ts_code).subquery()
126:             latest_rows = db.query(StockDailyKline).join(
127:                 latest_subq,
128:                 (StockDailyKline.ts_code == latest_subq.c.ts_code) &
129:                 (StockDailyKline.trade_date == latest_subq.c.max_date)
130:             ).all()
131:             kline_map = {k.ts_code: k for k in latest_rows}
132:             # 20 个交易日前日期
133:             recent_dates = db.query(StockDailyKline.trade_date).filter(
134:                 StockDailyKline.trade_date <= td
135:             ).distinct().order_by(StockDailyKline.trade_date.desc()).limit(20).all()
136:             date_20d_ago = recent_dates[-1][0] if recent_dates else None
137:             # 20 日前 K 线（批量）
138:             kline_map_20d = {}
139:             if date_20d_ago:
140:                 rows_20d = db.query(StockDailyKline).filter(
141:                     StockDailyKline.ts_code.in_(ts_codes),
142:                     StockDailyKline.trade_date == date_20d_ago
143:                 ).all()
144:                 kline_map_20d = {k.ts_code: k for k in rows_20d}
145:             # 回填价格字段
146:             for s in stocks:
147:                 kl = kline_map.get(s['ts_code'])
148:                 s['latest_price'] = float(kl.close) if kl and kl.close is not None else None
149:                 s['pct_chg'] = float(kl.pct_chg) if kl and kl.pct_chg is not None else None
150:                 kl20 = kline_map_20d.get(s['ts_code'])
151:                 if kl and kl.close is not None and kl20 and kl20.close is not None:
152:                     s['return_20d'] = round((float(kl.close) / float(kl20.close) - 1) * 100, 2)
153:                 else:
154:                     s['return_20d'] = None
155:         # ── sector 兜底：当日 StockFlow 缺失时，从历史 StockFlow 找最近一条非空 sector ──
156:         empty_sector_codes = [s['ts_code'] for s in stocks if not s.get('sector')]
157:         if empty_sector_codes:
158:             # 用 DISTINCT ON 取每只股票最近一条非空 sector（PostgreSQL 语法）
159:             from sqlalchemy import text
160:             sector_lookup_sql = text("""
161:                 SELECT DISTINCT ON (ts_code) ts_code, sector
162:                 FROM stock_flow
163:                 WHERE ts_code = ANY(:codes)
164:                   AND sector IS NOT NULL
165:                   AND sector != ''
166:                 ORDER BY ts_code, trade_date DESC
167:             """)
168:             rows = db.execute(sector_lookup_sql, {'codes': empty_sector_codes}).fetchall()
169:             sector_fallback = {r.ts_code: r.sector for r in rows}
170:             filled = 0
171:             for s in stocks:
172:                 if not s.get('sector') and s['ts_code'] in sector_fallback:
173:                     s['sector'] = sector_fallback[s['ts_code']]
174:                     filled += 1
175:             if filled:
176:                 logger.info(f'[strategy_resonance] sector 兜底：{filled}/{len(empty_sector_codes)} 只股票从历史数据回填')
177:         # 按共振数降序 → 总分降序
178:         stocks.sort(key=lambda x: (x['resonance_count'], x['total_score']), reverse=True)
179:         return {
180:             'trade_date': trade_date_str,
181:             'total_stocks': len(stocks),
182:             'total_hits': sum(s['resonance_count'] for s in stocks),  # 实际共振维度数
183:             'strategy_meta': _build_strategy_meta(),
184:             'stocks': stocks,
185:         }
186: def _extract_v4_pattern(row) -> Optional[str]:
187:     """从 V4.0 的 detail_json 中提取 pattern 字段"""
188:     ts_code = getattr(row, 'ts_code', '?')
189:     try:
190:         if row.detail_json:
191:             detail = json.loads(row.detail_json) if isinstance(row.detail_json, str) else row.detail_json
192:             return detail.get('pattern')
193:     except (json.JSONDecodeError, TypeError, AttributeError) as e:
194:         logger.warning("[strategy_resonance] extract v4 pattern from detail_json failed ts_code=%s: %s", ts_code, e)
195:     # 回退：从 scores_json 里找（旧版本可能存这里）
196:     try:
197:         if row.scores_json:
198:             scores = json.loads(row.scores_json) if isinstance(row.scores_json, str) else row.scores_json
199:             return scores.get('pattern')
200:     except (json.JSONDecodeError, TypeError, AttributeError) as e:
201:         logger.warning("[strategy_resonance] extract v4 pattern from scores_json failed ts_code=%s: %s", ts_code, e)
202:     return None
203: def _build_strategy_meta():
204:     """构建策略元数据图例（含 V4.0 子形态，排除 risk_exit）"""
205:     meta = [
206:         {'key': s['key'], 'name': s['name'], 'icon': s.get('icon', '📌')}
207:         for s in STRATEGIES if s['key'] != 'risk_exit'
208:     ]
209:     # 追加 V4.0 子维度
210:     for pm in _V4_PATTERN_META.values():
211:         meta.append({'key': pm['key'], 'name': pm['name'], 'icon': pm['icon']})
212:     return meta
