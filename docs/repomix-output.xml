 33:     return [{
 34:         'ts_code': r.ts_code,
 35:         'name': r.name or '',
 36:         'sector': r.sector or '',
 37:         'main_force_inflow': float(r.main_force_inflow or 0),
 38:     } for r in rows]
 39: def run_strategy_safely(strategy_key, stock_list, trade_date_str, db):
 40:     """跑单个策略（不落库，仅收集结果）。返回 (hits, dur, error_str)"""
 41:     meta = get_strategy_meta(strategy_key)
 42:     if not meta:
 43:         return [], 0, 'unknown strategy'
 44:     try:
 45:         mod = importlib.import_module(meta['module'])
 46:         screen_func = getattr(mod, meta['func'])
 47:         t0 = time.time()
 48:         if meta['needs_db']:
 49:             hits = screen_func(stock_list, trade_date_str, db=db)
 50:         else:
 51:             hits = screen_func(stock_list, trade_date_str)
 52:         dur = time.time() - t0
