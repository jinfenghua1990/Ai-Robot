410: def detect_anomalies(ts_code, name, indicator, value, history_values=None):
411:     """
412:     异常检测（规则+统计）
413:     history_values: 该指标的历史值列表（用于统计检测）
414:     返回: {'is_anomaly': bool, 'reason': str, 'severity': 'low/medium/high'}
415:     """
416:     anomalies = []
417:     # 规则检测
418:     if indicator == 'main_force_inflow':
419:         # 主力净流入 > 100亿 可疑
420:         if abs(value) > 1000000:  # 100亿（万元）
421:             anomalies.append({'severity': 'high', 'reason': f'主力净流入{value/10000:.0f}亿异常大'})
422:         # 涨停股主力净流入为负可疑
423:         if value < -50000:  # 流出超5亿
424:             anomalies.append({'severity': 'medium', 'reason': f'主力净流出{abs(value)/10000:.0f}亿'})
425:     elif indicator == 'price':
426:         if value <= 0:
427:             anomalies.append({'severity': 'high', 'reason': '价格≤0'})
428:         if value > 10000:
429:             anomalies.append({'severity': 'medium', 'reason': f'价格{value}元异常高'})
430:     elif indicator == 'price_chg':
431:         if abs(value) > 20:  # 创业板/科创板涨跌停20%
432:             anomalies.append({'severity': 'high', 'reason': f'涨跌幅{value}%超限'})
433:     # 统计检测（需要历史数据）
434:     if history_values and len(history_values) >= 5:
435:         mean = statistics.mean(history_values)
436:         std = statistics.stdev(history_values)
437:         if std > 0:
438:             z_score = abs(value - mean) / std
439:             if z_score > 3:
440:                 anomalies.append({'severity': 'high', 'reason': f'Z-Score={z_score:.1f}（偏离3σ）'})
441:             elif z_score > 2:
442:                 anomalies.append({'severity': 'medium', 'reason': f'Z-Score={z_score:.1f}（偏离2σ）'})
443:         # 箱线图检测
444:         sorted_vals = sorted(history_values)
445:         q1 = sorted_vals[len(sorted_vals) // 4]
446:         q3 = sorted_vals[3 * len(sorted_vals) // 4]
447:         iqr = q3 - q1
448:         if iqr > 0:
449:             if value < q1 - 1.5 * iqr or value > q3 + 1.5 * iqr:
450:                 anomalies.append({'severity': 'medium', 'reason': '超出箱线图范围'})
451:     if anomalies:
452:         severity = max(a['severity'] for a in anomalies)
453:         return {
454:             'is_anomaly': True,
455:             'reason': '; '.join(a['reason'] for a in anomalies),
456:             'severity': severity,
457:         }
458:     return {'is_anomaly': False, 'reason': '', 'severity': 'low'}
