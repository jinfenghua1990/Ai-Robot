<file path="frontend/src/utils/colors.js">
 1: /**
 2:  * 语义色常量（A股惯例：红涨绿跌）
 3:  *
 4:  * 统一使用此文件常量，避免硬编码 #ef4444 / #22c55e 导致颜色颠倒。
 5:  *
 6:  * 业务语义：
 7:  *   - 涨/盈利/流入/买入/看多/升温/加仓 → 红色系
 8:  *   - 跌/亏损/流出/卖出/看空/降温/清仓 → 绿色系
 9:  */
10: // 涨跌色（核心）
11: export const UP_COLOR   = '#ef4444';  // 涨/上涨
12: export const DOWN_COLOR = '#22c55e';  // 跌/下跌
13: // 买卖色（与涨跌色一致：买=红，卖=绿）
14: export const BUY_COLOR  = '#ef4444';  // 买入
15: export const SELL_COLOR = '#22c55e';  // 卖出
16: // 资金流向色（流入=红，流出=绿）
17: export const INFLOW_COLOR  = '#ef4444';  // 资金流入
18: export const OUTFLOW_COLOR = '#22c55e';  // 资金流出
19: // BS 信号色（B=买入=红，S=卖出=绿）
20: export const B_SIGNAL_COLOR = '#ef4444';  // B 点（买入信号）
21: export const S_SIGNAL_COLOR = '#22c55e';  // S 点（卖出信号）
22: // 看多/看空色（看多=红，看空=绿）
23: export const BULLISH_COLOR = '#ef4444';  // 看多
24: export const BEARISH_COLOR = '#22c55e';  // 看空
25: // 持仓动作色（加仓=红，清仓=绿）
26: export const ADD_COLOR     = '#ef4444';  // 加仓（强买）
27: export const REDUCE_COLOR  = '#84cc16';  // 减仓（弱卖，浅绿）
28: export const CLEAR_COLOR    = '#22c55e';  // 清仓（强卖）
29: // 深浅变体（用于 hover / 边框 / 背景）
30: export const UP_DARK   = '#dc2626';
31: export const UP_LIGHT  = '#f87171';
32: export const DOWN_DARK = '#16a34a';
33: export const DOWN_LIGHT = '#4ade80';
34: // 背景半透明（用于 tag / badge 背景）
35: export const upBg   = (alpha = 0.1) => `rgba(239,68,68,${alpha})`;
36: export const downBg = (alpha = 0.1) => `rgba(34,197,94,${alpha})`;
37: export const buyBg  = (alpha = 0.1) => `rgba(239,68,68,${alpha})`;
38: export const sellBg = (alpha = 0.1) => `rgba(34,197,94,${alpha})`;
39: // 工具函数：根据涨跌返回颜色
40: export const changeColor = (change) => (change > 0 ? UP_COLOR : change < 0 ? DOWN_COLOR : '#6b7280');
41: export const flowColor   = (flow)    => (flow > 0 ? INFLOW_COLOR : flow < 0 ? OUTFLOW_COLOR : '#6b7280');
42: // 评分色：score≥3 加仓（红），≤-5 清仓（绿），中间档灰/橙
43: export const scoreColor = (score) => {
44:   if (score <= -5) return DOWN_DARK;   // 清仓：深绿
45:   if (score <= -2) return REDUCE_COLOR; // 减仓：浅绿
46:   if (score >= 3)  return UP_COLOR;    // 加仓：红
47:   return '#6b7280';                     // 观望：灰
48: };
</file>

<file path="frontend/src/utils/formatTime.js">
 1: /**
 2:  * 时间格式化工具
 3:  *
 4:  * 统一抽取散落在各 Page 的 toLocaleString、formatDate 模板。
 5:  */
 6: /**
 7:  * 格式化日期时间：2026-06-12 14:30:00
 8:  */
 9: export function formatDateTime(ts) {
10:   if (!ts) return '--';
11:   const d = new Date(ts);
12:   if (isNaN(d.getTime())) return '--';
13:   const pad = (n) => String(n).padStart(2, '0');
14:   return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;
15: }
16: /**
17:  * 格式化日期：2026-06-12
18:  */
19: export function formatDate(ts) {
20:   if (!ts) return '--';
21:   const d = new Date(ts);
22:   if (isNaN(d.getTime())) return '--';
23:   const pad = (n) => String(n).padStart(2, '0');
24:   return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
25: }
26: /**
27:  * 当日标签：6月12日
28:  */
29: export function todayLabel() {
30:   const d = new Date();
31:   return `${d.getMonth() + 1}月${d.getDate()}日`;
32: }
</file>

