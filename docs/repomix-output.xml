306: def _urllib_get_json(url: str, params: dict) -> dict:
307:     full_url = url + '?' + urllib.parse.urlencode(params)
308:     last_err = None
309:     for attempt in range(3):
310:         try:
311:             req = urllib.request.Request(full_url, headers=_EM_HEADERS)
312:             with urllib.request.urlopen(req, timeout=8) as resp:
313:                 return json.loads(resp.read().decode())
314:         except Exception as e:
315:             last_err = e
316:             time.sleep(0.8 * (attempt + 1))
317:     raise last_err
