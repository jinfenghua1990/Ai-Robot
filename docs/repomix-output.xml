 1: from __future__ import annotations
 2: from datetime import date
 3: from typing import Mapping, Sequence
 4: from .contracts import DailyBar, MarketContext, SignalSnapshot
 5: from .engine import FactorEngine
 6: from .market_regime import MarketRegimeEngine
 7: from .registry import default_registry
 8: from .resonance import ResonanceEngine
 9: from .scoring import CrossSectionScorer
10: from .state import lifecycle_state, trading_state
11: from .universe import build_universe
12: class QuantPipeline:
13:     """独立的全新选股闭环；不依赖旧 strategies/analyzers/services。"""
14:     def __init__(self) -> None:
15:         self.registry = default_registry()
16:         self.factors = FactorEngine(self.registry)
17:         self.scorer = CrossSectionScorer()
18:         self.resonance = ResonanceEngine()
19:         self.market_regime = MarketRegimeEngine()
20:     def run(self, history: Mapping[str, Sequence[DailyBar]], trade_date: date, market: MarketContext) -> list[SignalSnapshot]:
21:         if market.trade_date != trade_date:
22:             raise ValueError("market context date mismatch")
23:         universe = build_universe(history, trade_date, market)
24:         values = self.factors.calculate(universe, trade_date, market)
25:         return self._score_values(values, trade_date, market)
26:     def run_with_values(self, history: Mapping[str, Sequence[DailyBar]], trade_date: date, market: MarketContext):
27:         if market.trade_date != trade_date:
28:             raise ValueError("market context date mismatch")
29:         universe = build_universe(history, trade_date, market)
30:         values = self.factors.calculate(universe, trade_date, market)
31:         return values, self._score_values(values, trade_date, market)
32:     def _score_values(self, values, trade_date: date, market: MarketContext):
33:         regime = self.market_regime.assess(market)
34:         scores = self.scorer.score(values, self.registry)
35:         snapshots = []
36:         for ts_code, dimensions in scores.items():
37:             resonance = self.resonance.evaluate(dimensions)
38:             factor_score = self.scorer.factor_score(dimensions, regime.weights)
39:             lifecycle = lifecycle_state(dimensions)
40:             state = trading_state(dimensions, resonance.eligible, regime.state, regime.allow_new_positions)
41:             reasons = [f"resonance={resonance.count}", f"lifecycle={lifecycle}", f"state={state}", f"market={regime.state}", regime.reason]
42:             snapshots.append(SignalSnapshot(
43:                 ts_code, trade_date, factor_score, dimensions, resonance, lifecycle, state, reasons,
44:                 regime.state, regime.weights,
45:             ))
46:         return sorted(snapshots, key=lambda x: x.factor_score if x.factor_score is not None else -1, reverse=True)
