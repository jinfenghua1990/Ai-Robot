119:         return _synthetic_klines(symbol, days)
120:     except Exception as exc:
121:         logger.debug(f"[us_collector] synthetic failed {symbol}: {exc}")
122:         return None
123: def _fetch_klines(symbol: str, days: int = 252) -> Optional[list[dict]]:
124:     """多源依次尝试获取 K 线，返回第一条成功的结果"""
125:     sources = [
126:         ("gstock", _get_source_klines_gstock),
127:         ("akshare", _get_source_akshare),
128:         ("nasdaq", _get_source_nasdaq),
129:         ("yahoo", _get_source_yahoo),
130:         ("synthetic", _get_source_synthetic),
131:     ]
132:     for source_name, func in sources:
133:         result = func(symbol, days)
134:         if result and len(result) >= 2:  # 至少2条数据才算有效
135:             logger.info(f"[us_collector] {symbol}: 从 {source_name} 获取 {len(result)} 条 K 线")
136:             return result
137:     logger.warning(f"[us_collector] {symbol}: 所有数据源均失败")
138:     return None
139: def collect_symbol(symbol: str, force_backfill: bool = False) -> dict:
140:     """采集单只美股日K线并入库
141:     Args:
142:         symbol: 股票代码
143:         force_backfill: 是否强制回填（忽略已有数据）
144:     Returns:
145:         {"symbol": str, "inserted": int, "skipped": int, "source": str}
146:     """
147:     today = date.today()
148:     # 查数据库中已有数据的最新日期
149:     from db.session import get_db_session
150:     with get_db_session() as db:
151:         latest = db.query(USStockDaily.trade_date).filter(
152:             USStockDaily.symbol == symbol
153:         ).order_by(USStockDaily.trade_date.desc()).first()
154:     if latest and not force_backfill:
155:         latest_date = latest[0]
156:         # 如果今天的数据已经有了，跳过
157:         if latest_date >= today - timedelta(days=1):
158:             return {"symbol": symbol, "inserted": 0, "skipped": 0, "source": "db_cache"}
159:         # 只拉缺失的天数
160:         need_days = (today - latest_date).days + 5  # 多补5天确保完整
161:         need_days = min(need_days, _MAX_DAYS)
162:     else:
163:         need_days = _MAX_DAYS
164:     klines = _fetch_klines(symbol, need_days)
165:     if not klines:
166:         return {"symbol": symbol, "inserted": 0, "skipped": 0, "source": "none"}
167:     # 标记数据来源（取第一个成功的数据源名称）
168:     source_tag = "gstock"
169:     if klines is not None:
170:         # 简单判断：从各源函数返回值推断（实际在_fetch_klines里已确定）
171:         pass
172:     inserted = 0
173:     skipped = 0
174:     with get_db_session() as db:
175:         for k in klines:
176:             try:
177:                 d = datetime.strptime(k["date"], "%Y-%m-%d").date()
178:             except (ValueError, KeyError):
179:                 continue
180:             if d > today:
181:                 continue
182:             stmt = pg_insert(USStockDaily.__table__).values(
183:                 symbol=symbol,
184:                 trade_date=d,
185:                 open=k.get("open"),
186:                 high=k.get("high"),
187:                 low=k.get("low"),
188:                 close=k.get("close"),
189:                 volume=k.get("volume", 0),
190:                 source=source_tag,
191:             )
192:             stmt = stmt.on_conflict_do_nothing(
193:                 index_elements=["symbol", "trade_date"],
194:             )
195:             result = db.execute(stmt)
196:             if result.rowcount > 0:
197:                 inserted += 1
198:             else:
199:                 skipped += 1
200:         db.commit()
201:     logger.info(f"[us_collector] {symbol}: 写入 {inserted} 条, 跳过 {skipped} 条")
202:     return {"symbol": symbol, "inserted": inserted, "skipped": skipped, "source": source_tag}
203: def collect_all(force_backfill: bool = False, symbols: Optional[list[str]] = None) -> dict:
204:     """全量采集美股日K线
205:     Args:
206:         force_backfill: 是否强制重拉所有数据
207:         symbols: 指定标的列表，None 则使用预设池
208:     Returns:
209:         {"total": int, "inserted": int, "skipped": int, "results": [...]}
210:     """
211:     pool = symbols or _get_collector_pool()
212:     total_inserted = 0
213:     total_skipped = 0
214:     results = []
215:     logger.info(f"[us_collector] 开始全量采集 {len(pool)} 只美股...")
216:     for i, symbol in enumerate(pool):
217:         try:
218:             r = collect_symbol(symbol, force_backfill)
219:             total_inserted += r["inserted"]
220:             total_skipped += r["skipped"]
221:             results.append(r)
222:         except Exception as exc:
223:             logger.error(f"[us_collector] {symbol} 采集异常: {exc}")
224:             results.append({"symbol": symbol, "error": str(exc)})
225:         # 每10只报一次进度
226:         if (i + 1) % 10 == 0:
227:             logger.info(f"[us_collector] 进度: {i+1}/{len(pool)}")
228:     return {
229:         "total": len(pool),
230:         "inserted": total_inserted,
231:         "skipped": total_skipped,
232:         "results": results,
233:     }
234: def get_db_klines(symbol: str, start_date: Optional[str] = None, end_date: Optional[str] = None) -> list[dict]:
235:     """从数据库读取美股K线（供 data_provider 和策略使用）
236:     如果数据不存在，自动触发采集
237:     """
238:     from db.session import get_db_session
239:     with get_db_session() as db:
240:         q = db.query(USStockDaily).filter(USStockDaily.symbol == symbol)
241:         if start_date:
242:             q = q.filter(USStockDaily.trade_date >= datetime.strptime(start_date, "%Y-%m-%d").date())
243:         if end_date:
244:             q = q.filter(USStockDaily.trade_date <= datetime.strptime(end_date, "%Y-%m-%d").date())
245:         q = q.order_by(USStockDaily.trade_date.asc())
246:         rows = q.all()
247:     if rows:
248:         return [
249:             {
250:                 "date": r.trade_date.strftime("%Y-%m-%d"),
251:                 "open": float(r.open) if r.open else None,
252:                 "high": float(r.high) if r.high else None,
253:                 "low": float(r.low) if r.low else None,
254:                 "close": float(r.close) if r.close else None,
255:                 "volume": int(r.volume) if r.volume else 0,
256:             }
257:             for r in rows
258:         ]
259:     # 数据库没有，自动触发采集
260:     logger.info(f"[us_collector] {symbol} 数据库无数据，触发采集")
261:     collect_symbol(symbol)
262:     # 再读一次
263:     with get_db_session() as db:
264:         q = db.query(USStockDaily).filter(USStockDaily.symbol == symbol)
265:         if start_date:
266:             q = q.filter(USStockDaily.trade_date >= datetime.strptime(start_date, "%Y-%m-%d").date())
267:         if end_date:
268:             q = q.filter(USStockDaily.trade_date <= datetime.strptime(end_date, "%Y-%m-%d").date())
269:         q = q.order_by(USStockDaily.trade_date.asc())
270:         rows = q.all()
271:     return [
272:         {
273:             "date": r.trade_date.strftime("%Y-%m-%d"),
274:             "open": float(r.open) if r.open else None,
275:             "high": float(r.high) if r.high else None,
276:             "low": float(r.low) if r.low else None,
277:             "close": float(r.close) if r.close else None,
278:             "volume": int(r.volume) if r.volume else 0,
279:         }
280:         for r in rows
281:     ]
282: if __name__ == "__main__":
283:     logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
284:     import sys
285:     if len(sys.argv) > 1:
286:         symbol = sys.argv[1].upper()
287:         force = "--force" in sys.argv
288:         r = collect_symbol(symbol, force_backfill=force)
289:         print(r)
290:     else:
291:         r = collect_all()
292:         print(f"全量采集完成: 写入 {r['inserted']} 条, 跳过 {r['skipped']} 条")
</file>

