 37:   return sign + formatMoney(val);
 38: };
 39: /**
 40:  * 格式化金额：万→亿（超过1亿显示亿）
 41:  * @param {number} v - 金额（万元）
 42:  * @returns {string} 格式化后的字符串
 43:  */
 44: export const fmtFlow = (v) => {
 45:   const abs = Math.abs(v);
 46:   if (abs >= 10000) return `${(v / 10000).toFixed(2)}亿`;
 47:   return `${v.toFixed(0)}万`;
 48: };
 49: /**
 50:  * 格式化涨跌幅
 51:  * @param {number} v - 涨跌幅（%）
 52:  * @returns {string} 带正负号的字符串
 53:  */
 54: export const fmtPct = (v) => {
 55:   if (v > 0) return `+${v.toFixed(2)}%`;
 56:   return `${v.toFixed(2)}%`;
 57: };
 58: /**
 59:  * 格式化金额（元为输入单位）：超 1 亿显示"X.XX亿"，超 1 万显示"X.Xw"，否则保留 2 位小数
 60:  * @param {number} v - 金额（元）
 61:  * @returns {string} 格式化后的字符串
 62:  */
 63: export const formatWan = (v) => {
 64:   if (v == null) return '-';
 65:   if (Math.abs(v) >= 1e8) return (v / 1e8).toFixed(2) + '亿';
 66:   if (Math.abs(v) >= 10000) return (v / 10000).toFixed(1) + 'w';
 67:   return v.toFixed(2);
 68: };
 69: /**
