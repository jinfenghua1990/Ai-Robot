358: _DATACENTER_URL = "https://datacenter-web.eastmoney.com/api/data/v1/get"
359: _EM_MIN_INTERVAL = 1.0          # 两次东财请求最小间隔（秒），内置防封节流
360: _em_last_call = [0.0]
361: _EM_SESSIONS: dict = {}         # {direct(bool): requests.Session}
362: _EM_CACHE: dict = {}            # {(url, frozenset(params)): (timestamp, payload)} 最近成功响应兜底
363: _EM_CACHE_TTL = 300             # 缓存兜底有效期（秒）
364: # 代理探测：后端由 launchd 启动，环境里没有 HTTP_PROXY，且 Clash 通常未注册进 macOS
365: # 系统代理（scutil 读不到），导致「代理兜底」长期空转。这里显式探测 Clash 常用端口，
366: # 让 em_get 的 proxy 路真正能走代理（直连被封时兜得住）。
367: _EM_PROXY_URL: str | None = None
368: _EM_PROXY_PROBED = False
369: _KNOWN_PROXY_PORTS = ("7897", "7890", "7891", "7898")
370: def _em_detect_proxy() -> str | None:
371:     """代理地址：优先环境变量，其次 macOS 系统代理(scutil)，最后探测本机 Clash 常用端口。"""
372:     for key in ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy"):
373:         v = os.environ.get(key)
374:         if v:
375:             return v
376:     if sys.platform == "darwin":
377:         try:
378:             out = subprocess.run(["/usr/sbin/scutil", "--proxy"],
379:                                  capture_output=True, text=True, timeout=5).stdout
380:             he = hp = ho = hs = hsp = None
381:             for line in out.splitlines():
382:                 s = line.strip()
383:                 if s.startswith("HTTPEnable") and ": 1" in s:
384:                     he = True
385:                 elif s.startswith("HTTPProxy :"):
386:                     hp = s.split(":", 1)[1].strip()
387:                 elif s.startswith("HTTPPort :"):
388:                     ho = s.split(":", 1)[1].strip()
389:                 elif s.startswith("HTTPSEnable") and ": 1" in s:
390:                     hs = True
391:                 elif s.startswith("HTTPSProxy :"):
392:                     hsp = s.split(":", 1)[1].strip()
393:                 elif s.startswith("HTTPSPort :"):
394:                     hsp_port = s.split(":", 1)[1].strip()
395:             if hs and hsp and hsp_port:
396:                 return f"http://{hsp}:{hsp_port}"
397:             if he and hp and ho:
398:                 return f"http://{hp}:{ho}"
399:         except Exception:
400:             pass
401:     # 探测本机 Clash / V2Ray 常用端口（仅探测 TCP 可达，不发送业务请求）
402:     import socket
403:     for port in _KNOWN_PROXY_PORTS:
404:         try:
405:             with socket.create_connection(("127.0.0.1", int(port)), timeout=0.4):
406:                 return f"http://127.0.0.1:{port}"
407:         except OSError:
408:             continue
409:     return None
410: def _em_proxies() -> dict | None:
411:     global _EM_PROXY_URL, _EM_PROXY_PROBED
412:     if not _EM_PROXY_PROBED:
413:         _EM_PROXY_URL = _em_detect_proxy()
414:         _EM_PROXY_PROBED = True
415:         if _EM_PROXY_URL:
416:             logger.info("[astock] 使用代理出网: %s", _EM_PROXY_URL)
417:     if not _EM_PROXY_URL:
418:         return None
419:     return {"http": _EM_PROXY_URL, "https": _EM_PROXY_URL}
420: # 数据层连接模式：国内财经站（东财/腾讯/新浪）本应「直连」——很多用户开着 Clash/V2Ray
421: # 科学上网，系统代理会把东财这类国内站路由挂掉（典型：push2.eastmoney.com 的 CONNECT 被掐）。
422: # 默认 auto：先试直连、失败再降级走系统代理；探测一次后固定，避免每次都重试。
423: # 只有少数「必须靠代理才能出网」的环境需要 VR_DATA_PROXY=1 强制走代理。
424: # 注意：这只影响数据层；AI 层（可能要调国外模型）仍走各自的系统代理，不受影响。
425: _em_mode = ["proxy" if os.environ.get("VR_DATA_PROXY", "").strip().lower() in ("1", "true", "yes") else "auto"]
426: def _em_session(direct: bool):
427:     """东财专用会话。direct=True → `trust_env=False` 忽略 HTTP(S)_PROXY 环境变量、直连。
428:     直连会话不重试（探测要快，失败即降级）；代理会话保留瞬态错误退避重试。惰性构建、复用。
429:     """
430:     if direct in _EM_SESSIONS:
431:         return _EM_SESSIONS[direct]
432:     import requests
433:     s = requests.Session()
434:     s.headers.update({"User-Agent": UA})
435:     s.trust_env = not direct     # 直连会话不读环境里的代理配置
436:     if not direct:
437:         # proxy 路：显式挂探测到的代理（Clash 等），不依赖环境变量
438:         s.proxies = _em_proxies() or {}
439:     try:
440:         from requests.adapters import HTTPAdapter
441:         from urllib3.util.retry import Retry
442:         # 直连也加瞬态错误重试：eastmoney 常主动掐 keep-alive（RemoteDisconnected/
443:         # ConnectionReset），属网络抖动而非限流，重试即可恢复。探测失败由 em_get 层跨路切换。
444:         retry = Retry(total=2, connect=2, backoff_factor=0.5,
445:                       status_forcelist=[429, 500, 502, 503, 504], allowed_methods=["GET"])
446:         adapter = HTTPAdapter(max_retries=retry)
447:         s.mount("https://", adapter)
448:         s.mount("http://", adapter)
449:     except Exception:
450:         logger.debug("urllib3 adapter setup failed, fallback to no-retry", exc_info=False)
451:     _EM_SESSIONS[direct] = s
452:     return s
453: def _em_cache_key(url: str, params) -> tuple:
454:     p = tuple(sorted((params or {}).items())) if isinstance(params, dict) else params
455:     return (url, p)
456: def _is_empty_payload(d) -> bool:
457:     """东财限流特征：HTTP 200 但业务 data 为 null/空。
458:     命中即视为「请求失败」，触发退避重试与跨路切换，避免把空白返回给 UI。
459:     """
460:     if not isinstance(d, dict):
461:         return False
462:     if "result" in d:                      # 数据中心接口（龙虎榜/融资融券/解禁/分红…）
463:         return not (d.get("result") and d["result"].get("data"))
464:     data = d.get("data")
465:     if data is None:
466:         return True
467:     if isinstance(data, dict):
468:         for k in ("diff", "klines"):       # clist / fflow(资金流) 接口
469:             if k in data:
470:                 return not data.get(k)
471:         return not data                    # 空 dict
472:     return False
473: class _CachedResponse:
474:     """把缓存 payload 包装成带 .json() 的响应对象，供 em_get 调用方无感使用。"""
475:     def __init__(self, payload):
476:         self._payload = payload
477:     def json(self):
478:         return self._payload
479: def em_get(url: str, params: dict | None = None, headers: dict | None = None, timeout: int = 15, use_cache: bool = True):
480:     """东财统一请求入口：限流 + 直连优先 + **空 payload 识别 + 跨路重试 + 缓存兜底**。
481:     稳定性加固（修复间歇返回空）：
482:       1. 直连/代理任一会话失败或返回「200 但空 payload」→ 退避后重试并在两路间切换；
483:       2. 两路都拿不到有效数据 → 回退最近 _EM_CACHE_TTL 秒内的成功响应，避免 UI 空白；
484:       3. 仅当缓存也过期才抛出，由调用方 except 兜底返回 []。
485:     """
486:     wait = _EM_MIN_INTERVAL - (time.time() - _em_last_call[0])
487:     if wait > 0:
488:         time.sleep(wait + random.uniform(0.1, 0.5))
489:     try:
490:         # 优先使用上次成功路（直连/代理），失败再切另一路
491:         order = ["proxy", "direct"] if _em_mode[0] == "proxy" else ["direct", "proxy"]
492:         last_exc = None
493:         tried_modes = set()
494:         for mode in order:
495:             if mode in tried_modes:
496:                 continue
497:             tried_modes.add(mode)
498:             for attempt in range(2):           # 每路最多 2 次（含退避）
499:                 try:
500:                     r = _em_session(mode == "direct").get(
501:                         url, params=params, headers=headers, timeout=timeout)
502:                     if r.status_code == 200:
503:                         try:
504:                             payload = r.json()
505:                         except Exception:
506:                             payload = None
507:                         if payload is not None and not _is_empty_payload(payload):
508:                             _em_mode[0] = mode          # 固定成功路
509:                             if use_cache:
510:                                 _EM_CACHE[_em_cache_key(url, params)] = (time.time(), payload)
511:                             return r
512:                     last_exc = RuntimeError(
513:                         f"em_get {url} status={r.status_code} "
514:                         f"empty={payload is None or _is_empty_payload(payload)}")
515:                 except Exception as e:
516:                     last_exc = e
517:                 if attempt < 1:
518:                     time.sleep(0.6 + random.uniform(0, 0.4))   # 退避，缓解限流
519:         # 两路全失败 → 最近成功缓存兜底（TTL 内）
520:         if use_cache:
521:             hit = _EM_CACHE.get(_em_cache_key(url, params))
522:             if hit and (time.time() - hit[0]) < _EM_CACHE_TTL:
523:                 logger.warning("[astock] em_get 双路失败，回退 %ds 前缓存: %s",
524:                                int(time.time() - hit[0]), url)
525:                 return _CachedResponse(hit[1])
526:         raise last_exc or RuntimeError(f"em_get failed: {url}")
527:     finally:
528:         _em_last_call[0] = time.time()
