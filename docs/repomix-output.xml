124:     def persist_research_snapshot(self, requested_date: date | None = None) -> dict:
125:         """Persist all catalog factor values without adding candidates to score.
126:         The normal daily snapshot only stores factors currently enabled in
127:         the research score.  This explicit research action evaluates the
128:         full catalog (including candidate Alpha158 formulas), keeps scoring
129:         on the active lifecycle set, and stores the raw candidate values for
130:         audit/research in ``v2_factor_values``.
131:         """
132:         target = self.data.resolve_date(requested_date)
133:         if not target:
134:             return {"trade_date": None, "universe_count": 0, "factor_values": 0, "snapshots": 0}
135:         with self._lock:
