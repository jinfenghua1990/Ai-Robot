 1: """
 2: 盘后日报服务接口（端口 9000）
 3: - GET /api/report/daily          最新一期日报（HTML）
 4: - GET /api/report/daily/{date}   指定日期日报（HTML）
 5: - GET /api/report/meta           日报元信息（最新日期/可用日期列表）
 6: - POST /api/report/generate      立即生成（默认最新交易日），返回路径
 7: """
 8: import os
 9: import logging
10: from datetime import datetime
11: from fastapi import APIRouter, HTTPException
12: from fastapi.responses import FileResponse, JSONResponse
13: from reports.daily_report import generate_daily_report, REPORT_DIR
14: from db.session import get_db_session
15: from sqlalchemy import text
16: logger = logging.getLogger("report_api")
17: router = APIRouter(prefix="/api/report", tags=["report"])
18: def _latest_date():
19:     with get_db_session() as db:
20:         row = db.execute(text("SELECT max(trade_date) FROM stock_flow")).scalar()
21:         return row.strftime("%Y-%m-%d") if row else None
22: def _report_path(date_str):
23:     return os.path.join(REPORT_DIR, f"{date_str}.html")
24: def _ensure_report(date_str):
25:     """确保某日期报告存在，缺失则即时生成"""
26:     path = _report_path(date_str)
27:     if not os.path.exists(path):
28:         generate_daily_report(date_str)
29:     if not os.path.exists(path):
30:         raise HTTPException(status_code=404, detail=f"未找到 {date_str} 的日报")
31:     return path
32: @router.get("/daily")
33: def get_latest_report():
34:     """最新一期日报（HTML）"""
35:     d = _latest_date()
36:     if not d:
37:         raise HTTPException(status_code=404, detail="无可用交易日数据")
38:     path = _ensure_report(d)
39:     return FileResponse(path, media_type="text/html; charset=utf-8",
40:                         headers={"Cache-Control": "no-cache"})
41: @router.get("/daily/{date_str}")
42: def get_report_by_date(date_str: str):
43:     """指定日期日报（HTML）"""
44:     if not (len(date_str) == 10 and date_str[4] == "-" and date_str[7] == "-"):
45:         raise HTTPException(status_code=400, detail="日期格式应为 YYYY-MM-DD")
46:     path = _ensure_report(date_str)
47:     return FileResponse(path, media_type="text/html; charset=utf-8",
48:                         headers={"Cache-Control": "no-cache"})
49: @router.get("/meta")
50: def get_report_meta():
51:     """日报元信息"""
52:     d = _latest_date()
53:     available = []
54:     if os.path.isdir(REPORT_DIR):
55:         available = sorted(
56:             f[:-5] for f in os.listdir(REPORT_DIR)
57:             if f.endswith(".html")
58:         )
59:     return {"latest": d, "available": available, "count": len(available)}
60: @router.post("/generate")
61: def generate_report(date_str: str = None):
62:     """立即生成日报（默认最新交易日）"""
63:     try:
64:         path = generate_daily_report(date_str)
65:     except Exception as e:
66:         logger.exception("生成日报失败")
67:         raise HTTPException(status_code=500, detail=f"生成失败: {e}")
68:     d = os.path.basename(path).replace(".html", "")
69:     return {
70:         "success": True,
71:         "date": d,
72:         "path": path,
73:         "url": f"/api/report/daily/{d}",
74:         "generated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
75:     }
