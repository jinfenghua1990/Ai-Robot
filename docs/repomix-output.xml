  1: from __future__ import annotations
  2: from bisect import bisect_left, bisect_right
  3: from collections import defaultdict
  4: from datetime import date, timedelta
  5: from statistics import mean
  6: from typing import Mapping, Sequence
  7: from .domain import Bar, DimensionScore, MarketContext, Signal
  8: from .factors import DIMENSION_LABELS, FACTOR_BY_NAME, PRODUCTION_FACTORS, calculate_raw
  9: WEIGHTS = {
 10:     "market": 0.10,
 11:     "sector": 0.20,
 12:     "strength": 0.20,
 13:     "trend": 0.15,
 14:     "volume_price": 0.15,
 15:     "position": 0.15,
 16:     "risk_penalty": 0.05,
 17: }
 18: def _clamp(value: float, low: float = 0.0, high: float = 100.0) -> float:
 19:     return round(max(low, min(high, value)), 2)
 20: def _percentile(values: Sequence[float], target: float) -> float:
 21:     if len(values) < 2:
 22:         return 50.0
 23:     # ``values`` is sorted once by the caller; avoid an O(N^2) scan when
 24:     # standardising 31 factors across the full market.
 25:     below = bisect_left(values, target)
 26:     equal = bisect_right(values, target) - below
 27:     return 100.0 * (below + equal / 2) / len(values)
 28: def _market_score(name: str, value: float) -> float:
 29:     if name == "market_breadth":
 30:         return _clamp(value * 100)
 31:     if name == "market_limit_balance":
 32:         return _clamp((value + 1) * 50)
 33:     if name == "market_trend_20d":
 34:         return _clamp(50 + value * 500)
 35:     if name == "market_sentiment":
 36:         return _clamp(value * 100)
 37:     return _clamp(value)
 38: def _normalize(raw_values: Mapping[str, Mapping[str, float | None]]) -> dict[str, dict[str, float | None]]:
 39:     pools: dict[str, list[float]] = defaultdict(list)
 40:     for row in raw_values.values():
 41:         for name, value in row.items():
 42:             if value is not None:
 43:                 pools[name].append(float(value))
 44:     sorted_pools = {name: sorted(values) for name, values in pools.items()}
 45:     normalized: dict[str, dict[str, float | None]] = {}
 46:     for code, row in raw_values.items():
 47:         normalized[code] = {}
 48:         for name, value in row.items():
 49:             definition = FACTOR_BY_NAME[name]
 50:             if value is None:
 51:                 normalized[code][name] = None
 52:                 continue
 53:             raw = float(value)
 54:             if definition.category == "market":
 55:                 score = _market_score(name, raw)
 56:             elif name in {"sector_rank", "sector_inner_rank"}:
 57:                 score = _clamp(raw)
 58:             else:
 59:                 score = _percentile(sorted_pools[name], raw)
 60:                 if definition.direction < 0:
 61:                     score = 100 - score
 62:             normalized[code][name] = round(score, 4)
 63:     return normalized
 64: class V2Engine:
 65:     """Quant-team style cross-sectional factor decision engine."""
 66:     opportunity_dimensions = ("market", "sector", "strength", "trend", "volume_price", "position")
 67:     all_dimensions = opportunity_dimensions + ("risk",)
 68:     def run(
 69:         self,
 70:         history: Mapping[str, Sequence[Bar]],
 71:         market: MarketContext,
 72:         sector_flow: Mapping[str, Mapping[str, float | None]],
 73:         display_limit: int | None = 50,
 74:         active_factor_names: set[str] | None = None,
 75:         score_mode: str = "RESEARCH",
 76:         include_candidate_factors: bool = False,
 77:     ) -> dict:
 78:         raw = calculate_raw(history, market, sector_flow, include_candidate=include_candidate_factors)
 79:         normalized = _normalize(raw)
 80:         active = set(active_factor_names or FACTOR_BY_NAME)
 81:         dimensions_by_code = {
 82:             code: self._dimensions(code, raw[code], normalized[code], active)
 83:             for code in raw
 84:         }
 85:         signals = []
 86:         for code, dimensions in dimensions_by_code.items():
 87:             bars = history[code]
 88:             resonance = self._resonance(dimensions)
 89:             score = self._factor_score(dimensions)
 90:             patterns = self._patterns(raw[code], bars, active)
 91:             lifecycle = self._lifecycle(dimensions, raw[code])
 92:             state = self._trading_state(dimensions, resonance, patterns, raw[code], market, score_mode)
 93:             reasons = self._reasons(dimensions, resonance, patterns, lifecycle, state, market, score_mode)
 94:             item = Signal(
 95:                 code=code,
 96:                 name=bars[-1].name or code,
 97:                 sector=bars[-1].sector or "未分类",
 98:                 trade_date=market.trade_date,
 99:                 rank=0,
100:                 factor_score=score,
101:                 dimensions=dimensions,
102:                 resonance_count=resonance["count"],
103:                 resonance_dimensions=resonance["dimensions"],
