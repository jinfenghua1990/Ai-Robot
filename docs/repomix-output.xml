 1: from __future__ import annotations
 2: from dataclasses import asdict
 3: from typing import Dict, Iterable
 4: from .contracts import FactorDefinition
 5: class FactorRegistry:
 6:     def __init__(self, definitions: Iterable[FactorDefinition] = ()) -> None:
 7:         self._items: Dict[str, FactorDefinition] = {}
 8:         for item in definitions:
 9:             self.register(item)
10:     def register(self, definition: FactorDefinition) -> None:
11:         if definition.name in self._items:
12:             raise ValueError(f"duplicate factor: {definition.name}")
13:         if definition.direction not in (-1, 1):
14:             raise ValueError(f"direction must be -1 or 1: {definition.name}")
15:         self._items[definition.name] = definition
16:     def get(self, name: str) -> FactorDefinition:
17:         return self._items[name]
18:     def all(self) -> list[FactorDefinition]:
19:         return list(self._items.values())
20:     def production(self) -> list[FactorDefinition]:
21:         return [item for item in self._items.values() if item.production]
22:     def export(self) -> list[dict]:
23:         return [asdict(item) for item in self._items.values()]
