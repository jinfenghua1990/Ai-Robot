244: def _get_sector(item: dict) -> str:
245:     """从 item 中获取行业（暂缺，默认返回空）"""
246:     return item.get("sector") or item.get("industry") or ""
247: def build_core_pools(research_stocks: list[dict]) -> dict:
248:     """从研究池中选出 Core A 300 + Core B 500
249:     Args:
250:         research_stocks: 研究池股票列表（含 price, market_cap, turnover 等字段）
251:     Returns:
252:         {"core_a": [(symbol, rank, score, reason), ...],
253:          "core_b": [(symbol, rank, score, reason), ...]}
254:     """
255:     # 1. 计算 A 池评分
256:     a_scored = []
257:     for s in research_stocks:
258:         if not _passes_research_filters(s):
259:             continue
260:         score = _score_core_a(s)
261:         a_scored.append((s["symbol"], score, s))
262:     a_scored.sort(key=lambda x: -x[1])
263:     # 2. 选 A 池（前 300，带行业约束）
264:     core_a = []
265:     sector_count_a = {}
266:     for symbol, score, s in a_scored:
267:         if len(core_a) >= CORE_A_CONFIG["target_count"]:
268:             break
269:         sector = _get_sector(s)
270:         max_pct = CORE_A_CONFIG["max_sector_pct"]
271:         max_count = int(CORE_A_CONFIG["target_count"] * max_pct)
272:         if sector and sector_count_a.get(sector, 0) >= max_count:
273:             continue
274:         sector_count_a[sector] = sector_count_a.get(sector, 0) + 1
275:         core_a.append((symbol, len(core_a) + 1, score, "Core A 评分排名"))
276:     a_symbols = {s[0] for s in core_a}
277:     # 3. 剩余股票计算 B 池评分
278:     b_scored = []
279:     for s in research_stocks:
280:         if s["symbol"] in a_symbols:
281:             continue
282:         if not _passes_research_filters(s):
283:             continue
284:         score = _score_core_b(s)
285:         b_scored.append((s["symbol"], score, s))
286:     b_scored.sort(key=lambda x: -x[1])
287:     # 4. 选 B 池（前 500，排除 A 池，带行业约束）
288:     core_b = []
289:     sector_count_b = {}
290:     for symbol, score, s in b_scored:
291:         if len(core_b) >= CORE_B_CONFIG["target_count"]:
292:             break
293:         sector = _get_sector(s)
294:         max_pct = CORE_B_CONFIG["max_sector_pct"]
295:         max_count = int(CORE_B_CONFIG["target_count"] * max_pct)
296:         if sector and sector_count_b.get(sector, 0) >= max_count:
297:             continue
298:         sector_count_b[sector] = sector_count_b.get(sector, 0) + 1
299:         core_b.append((symbol, len(core_b) + 1, score, "Core B 评分排名"))
300:     return {
301:         "core_a": core_a,
302:         "core_b": core_b,
303:     }
