  1: """
  2: 实时概念板块资金流向采集器
  3: 数据源：新浪财经(板块维度) + 个股多源聚合(交叉验证)
  4: """
  5: import logging
  6: from db.session import get_db_session
  7: from db.models import RealtimeConceptSectorFlow, RealtimeStockFlow, ConceptSector
  8: from collectors.realtime_sector_collector import _now_truncated
  9: from collectors.concept_sector_collector import get_concept_sector_money_flow_realtime
 10: from sqlalchemy import func
 11: logger = logging.getLogger(__name__)
 12: def _compute_concept_flows_from_stocks(db, snapshot_time, trade_date, concept_map):
 13:     """
 14:     基于 RealtimeStockFlow 计算 concept_sectors 表中所有有成分股的概念板块资金流向。
 15:     用于多源聚合：所有概念（含新浪的）都从成分股多源个股数据聚合，再与新浪板块维度数值交叉验证。
 16:     返回: {concept_name: {'net_flow': ..., 'money_inflow': ..., 'money_outflow': ..., 'rise_ratio': ..., 'covered': N}, ...}
 17:     """
 18:     # 对所有有成分股的概念计算（含 sina 来源）
 19:     concepts = db.query(ConceptSector).all()
 20:     if not concepts:
 21:         return {}
 22:     all_codes = set()
 23:     concept_codes = {}
 24:     for c in concepts:
 25:         codes = [s.strip() for s in (c.stocks or '').split(',') if s.strip()]
 26:         if codes:
 27:             concept_codes[c.name] = codes
 28:             all_codes.update(codes)
 29:     if not all_codes:
 30:         return {}
 31:     # 取同一快照时间点的个股数据；若当前时间点无个股快照，回退到当日最新一次
 32:     stocks = db.query(RealtimeStockFlow).filter(
 33:         RealtimeStockFlow.snapshot_time == snapshot_time,
 34:         RealtimeStockFlow.ts_code.in_(all_codes)
 35:     ).all()
 36:     if not stocks:
 37:         latest_stock_time = db.query(func.max(RealtimeStockFlow.snapshot_time)).filter(
 38:             RealtimeStockFlow.trade_date == trade_date
 39:         ).scalar()
 40:         if latest_stock_time:
 41:             stocks = db.query(RealtimeStockFlow).filter(
 42:                 RealtimeStockFlow.snapshot_time == latest_stock_time,
 43:                 RealtimeStockFlow.ts_code.in_(all_codes)
 44:             ).all()
 45:             if stocks:
 46:                 print(f'[realtime] fallback to latest stock snapshot {latest_stock_time} for computed concepts')
 47:     stock_data = {s.ts_code: s for s in stocks}
 48:     results = {}
 49:     for name, codes in concept_codes.items():
 50:         money_inflow = 0.0
 51:         money_outflow = 0.0
 52:         net_flow = 0.0
 53:         total_chg = 0.0
 54:         count = 0
 55:         for code in codes:
 56:             s = stock_data.get(code)
 57:             if not s:
 58:                 continue
 59:             mi = float(s.main_force_inflow or 0) if s.main_force_inflow is not None else 0.0
 60:             # 异常值剔除：主力净流入为 None 或异常巨大时跳过
 61:             if mi is None or abs(mi) > 1e10:
 62:                 continue
 63:             money_inflow += max(mi, 0)
 64:             money_outflow += max(-mi, 0)
 65:             net_flow += mi
 66:             total_chg += float(s.price_chg or 0)
 67:             count += 1
 68:         if count == 0:
 69:             continue
 70:         results[name] = {
 71:             'net_flow': net_flow,
 72:             'money_inflow': money_inflow,
 73:             'money_outflow': money_outflow,
 74:             'rise_ratio': total_chg / count,
 75:             'covered': count,
 76:             'total': len(codes),
 77:         }
 78:     if results:
 79:         print(f'[realtime] Computed {len(results)} concept sectors from stocks (multi-source aggregated)')
 80:     return results
 81: def collect_realtime_concept_sector_flow(trade_date):
 82:     """采集概念板块实时资金流向快照（新浪财经，板块维度）"""
 83:     snapshot_time = _now_truncated()
 84:     print(f'[realtime] Collecting concept sector flow snapshot at {snapshot_time}')
 85:     flows = get_concept_sector_money_flow_realtime(pages=10, per_page=100)
 86:     if not flows:
 87:         print('[realtime] No concept sector flow data')
 88:         return 0
 89:     with get_db_session() as db:
 90:         saved = 0
 91:         try:
 92:             concept_map = {c.name: c.id for c in db.query(ConceptSector).all()}
 93:             new_concepts = []
 94:             sina_values = {}
 95:             for f in flows:
 96:                 name = f['sector']
 97:                 if f.get('net_flow') is not None:
 98:                     sina_values[name] = {
 99:                         'net_flow': f['net_flow'],
100:                         'money_inflow': f.get('money_inflow'),
101:                         'money_outflow': f.get('money_outflow'),
102:                         'rise_ratio': f.get('rise_ratio'),
103:                     }
104:             computed = _compute_concept_flows_from_stocks(db, snapshot_time, trade_date, concept_map)
105:             all_names = set(sina_values.keys()) | set(computed.keys())
106:             merged_count = 0
107:             for name in all_names:
108:                 sina_val = sina_values.get(name)
109:                 calc_val = computed.get(name)
110:                 if sina_val and calc_val:
111:                     coverage = calc_val.get('covered', 0) / max(calc_val.get('total', 1), 1)
112:                     sina_net = abs(sina_val['net_flow'] or 0)
113:                     calc_net = abs(calc_val['net_flow'])
114:                     if coverage >= 0.3 and sina_net > 0 and abs(sina_net - calc_net) / max(sina_net, calc_net, 1) < 0.5:
115:                         final_net = (sina_val['net_flow'] + calc_val['net_flow']) / 2
116:                         source = 'merged'
117:                         merged_count += 1
118:                     else:
119:                         final_net = sina_val['net_flow']
120:                         source = 'sina'
121:                     final_rise = sina_val.get('rise_ratio') or calc_val['rise_ratio']
122:                 elif sina_val:
123:                     final_net = sina_val['net_flow']
124:                     final_rise = sina_val['rise_ratio']
125:                     source = 'sina'
126:                 else:
127:                     final_net = calc_val['net_flow']
128:                     final_rise = calc_val['rise_ratio']
129:                     source = 'computed'
130:                 # 统一从 final_net 反推 inflow/outflow，保证 inflow-outflow=net_flow 恒等
131:                 final_inflow = max(float(final_net or 0), 0)
132:                 final_outflow = max(-float(final_net or 0), 0)
133:                 cid = concept_map.get(name)
134:                 if cid is None:
135:                     new_c = ConceptSector(name=name, source=source, stocks='')
136:                     db.add(new_c)
137:                     db.flush()
138:                     cid = new_c.id
139:                     concept_map[name] = cid
140:                     new_concepts.append(name)
141:                 existing = db.query(RealtimeConceptSectorFlow).filter_by(
142:                     snapshot_time=snapshot_time, concept_name=name
143:                 ).first()
144:                 if existing:
145:                     existing.net_flow = final_net
146:                     existing.money_inflow = final_inflow
147:                     existing.money_outflow = final_outflow
148:                     existing.rise_ratio = final_rise
149:                     existing.source = source
150:                     existing.concept_sector_id = cid
151:                 else:
152:                     db.add(RealtimeConceptSectorFlow(
153:                         snapshot_time=snapshot_time,
154:                         trade_date=trade_date,
155:                         concept_sector_id=cid,
156:                         concept_name=name,
157:                         net_flow=final_net,
158:                         money_inflow=final_inflow,
159:                         money_outflow=final_outflow,
160:                         rise_ratio=final_rise,
161:                         source=source,
162:                     ))
163:                 saved += 1
164:             if merged_count:
165:                 logger.info(f'[realtime] Multi-source merged: {merged_count} concepts (sina + computed avg)')
166:             db.commit()
167:             if new_concepts:
168:                 logger.info(f'[realtime] Auto-created {len(new_concepts)} new concept sectors: {new_concepts[:10]}{"..." if len(new_concepts) > 10 else ""}')
169:             logger.info(f'[realtime] Saved {saved} concept sector snapshots')
170:         except Exception as e:
171:             db.rollback()
172:             logger.exception(f'[realtime] Concept sector save error')
173:     return saved
