130:             'details': {'latest_time': latest_time.isoformat(), 'gap_seconds': gap_seconds},
131:         })
132:     # 检查数据量（按最新时间点应该覆盖全市场，而不是总行数）
133:     with get_db_session() as db:
134:         latest_snapshot_count = db.query(func.count('*')).filter(
135:             RealtimeStockFlow.trade_date == trade_date,
136:             RealtimeStockFlow.snapshot_time == latest_time
137:         ).scalar()
138:     if latest_snapshot_count < min_expected_stocks:
139:         alerts.append({
140:             'level': 'warning',
