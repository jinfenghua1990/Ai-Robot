 96:   sentiment:    { label: '情绪温度', desc: '涨跌+板块热度+资金方向+量比' },
 97:   momentum:     { label: '资金动能', desc: '板块净流入+3日主力+资金连续性' },
 98:   mainForce:    { label: '主力资金', desc: '主力流向+持仓变化+大单特征+量价配合' },
 99:   technical:    { label: '技术形态', desc: '新高新低+趋势一致性+均线位置+斜率' },
100:   sector:       { label: '板块共振', desc: '板块热度+热度趋势+上涨比+板块强度' },
101:   risk:         { label: '风险等级', desc: '噪声比+ATR+形态评分+仓位' },
102: };
103: // 根据主力净流入推断趋势阶段
104: export const inferStage = (value) => {
105:   if (value >= 10000) return '蓄势';
106:   if (value >= 1000) return '留意';
107:   return '观望';
108: };
109: // score(0-100) → 阶段名（支持 5 段和 7 段）
110: export const scoreToStage = (score, variant) => {
111:   const config = VARIANT_CONFIGS[variant];
112:   if (!config) return '';
113:   const order = config.order;
114:   if (order.length === 5) {
115:     if (score >= 80) return order[4];
116:     if (score >= 60) return order[3];
117:     if (score >= 40) return order[2];
118:     if (score >= 20) return order[1];
119:     return order[0];
120:   }
121:   // 7段：按 100/7 步长分界
122:   if (order.length === 7) {
123:     const step = 100 / 7;
124:     for (let i = 6; i >= 0; i--) {
125:       if (score >= step * i) return order[i];
126:     }
127:     return order[0];
128:   }
129:   return config.defaultStage || '';
130: };
131: // 兼容别名
