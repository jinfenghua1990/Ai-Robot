243: async def get_focus_stocks():
244:     """获取重点关注股票列表（按赛道分组，含完整 signal 数据，与自选股维度对齐）"""
245:     with get_db_session() as db:
246:         # 展开所有股票
247:         all_stocks = [
248:             (s["code"], s["name"], sector_data["sector"])
249:             for sector_data in FOCUS_STOCKS
250:             for s in sector_data["stocks"]
251:         ]
252:         # 优先从预计算表读取（毫秒级），缺失时才现场计算
253:         import asyncio
254:         # 取最近一日的预计算数据
255:         latest_date = db.query(WatchlistSignalDaily.trade_date).order_by(
256:             WatchlistSignalDaily.trade_date.desc()
257:         ).first()
258:         precomputed_map = {}
259:         if latest_date:
260:             rows = db.query(WatchlistSignalDaily).filter(
261:                 WatchlistSignalDaily.trade_date == latest_date[0]
262:             ).all()
263:             for r in rows:
264:                 # ts_code (600000.SH) → code (600000)
265:                 code = r.ts_code.split('.')[0] if r.ts_code else ''
266:                 if code:
267:                     precomputed_map[code] = r
268:         # 分批构造 signal：预计算命中用快速路径，未命中用现场计算
269:         BATCH = 20
270:         all_signals = []
271:         precomputed_hits = 0
272:         for i in range(0, len(all_stocks), BATCH):
273:             batch = all_stocks[i:i + BATCH]
274:             tasks = []
275:             for code, name, sector_name in batch:
276:                 pre = precomputed_map.get(code)
277:                 if pre is not None:
278:                     precomputed_hits += 1
279:                     tasks.append(build_signal_from_precomputed(
280:                         code, name, pre,
281:                         extra_positive=[{"label": "赛道", "value": sector_name, "type": "positive"}],
282:                         db=db,
283:                     ))
284:                 else:
285:                     tasks.append(build_signal_for_stock(code, name, sector_name, db))
286:             results = await asyncio.gather(*tasks, return_exceptions=True)
287:             for r in results:
288:                 if not isinstance(r, Exception) and r is not None:
289:                     all_signals.append(r)
290:         # 批量补充 moneyFlow/hitTags/actionHint（与自选股 build_watchlist 完全一致口径）
291:         from services.signal_builder import _enrich_signals_with_watchlist_extras
292:         await _enrich_signals_with_watchlist_extras(db, all_signals)
293:         # 按赛道分组
294:         signal_map = {s['secCode']: s for s in all_signals}
295:         sectors_result = []
296:         for sector_data in FOCUS_STOCKS:
297:             sector_signals = [
298:                 signal_map[s["code"]]
299:                 for s in sector_data["stocks"]
300:                 if s["code"] in signal_map
301:             ]
302:             sectors_result.append({
303:                 "sector": sector_data["sector"],
304:                 "icon": sector_data["icon"],
305:                 "color": sector_data["color"],
306:                 "stocks": sector_signals,
307:             })
308:         # 统计
309:         total_stocks = len(all_signals)
310:         up_count = sum(1 for s in all_signals if s.get("quote") and s["quote"]["changePct"] > 0)
311:         down_count = sum(1 for s in all_signals if s.get("quote") and s["quote"]["changePct"] < 0)
312:         limit_up_count = sum(1 for s in all_signals if s.get("quote") and s["quote"]["changePct"] >= 9.8)
313:         return {
314:             "sectors": sectors_result,
315:             "summary": {
316:                 "total_sectors": len(sectors_result),
317:                 "total_stocks": total_stocks,
318:                 "up_count": up_count,
319:                 "down_count": down_count,
320:                 "flat_count": total_stocks - up_count - down_count,
321:                 "limit_up_count": limit_up_count,
322:             },
323:             "generated_at": datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
324:         }
