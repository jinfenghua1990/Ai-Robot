 46:     if (!selectedDate) return;
 47:     setLoading(true);
 48:     fetchSystem(selectedDate);
 49:   }, [selectedDate, fetchSystem]);
 50:   useEffect(() => {
 51:     (async () => {
 52:       try {
 53:         const { ok, data } = await apiFetch('/api/leader/stats');
 54:         if (ok) setStats(data);
 55:       } catch (e) { console.error('[StrategyCenter] leader/stats failed:', e); }
 56:     })();
