  32: def _batch_moneyflow_map(db, stock_codes: list) -> dict:
  33:     """批量查所有自选股的最新一日 4 档资金流 + 1/2/3/4/5 日累计 + 连续天数
  34:     用 3 个独立查询并行执行（ThreadPoolExecutor），将首次耗时 6-9s 降到 2-3s。
  35:     每个线程使用独立 Session（SQLAlchemy Session 非线程安全）。
  36:     返回 {ts_code: {main_net(万), super_large(万), large(万), small(万), tiny(万),
  37:                     inflow_1d/2d/3d/4d/5d(元), flow_continuity, available}}
  38:     """
  39:     from db.models import StockMoneyFlowDetail, StockFeaturesDaily
  40:     from db.connection import SessionLocal
  41:     from concurrent.futures import ThreadPoolExecutor, as_completed
  42:     if not stock_codes:
  43:         return {}
  44:     valid_codes = [c for c in stock_codes if c and len(c) == 6]
  45:     if not valid_codes:
  46:         return {}
  47:     ts_codes = [f"{c}.SH" if c[0] in ('6', '9') else f"{c}.SZ" for c in valid_codes]
  48:     out = {ts: {'available': False, 'main_net': 0, 'super_large': 0, 'large': 0,
  49:                 'small': 0, 'tiny': 0, 'turnover_rate': 0,
  50:                 'main_buy': 0, 'main_sell': 0, 'retail_buy': 0, 'retail_sell': 0,
  51:                 'super_large_pct': 0, 'large_pct': 0, 'small_pct': 0, 'tiny_pct': 0,
  52:                 'inflow_1d': 0, 'inflow_2d': 0, 'inflow_3d': 0, 'inflow_4d': 0, 'inflow_5d': 0,
  53:                 'inflow_6d': 0, 'inflow_7d': 0, 'inflow_8d': 0, 'inflow_9d': 0, 'inflow_10d': 0,
  54:                 'flow_continuity': 0}
  55:            for ts in ts_codes}
  56:     # === Q1: 取最新交易日期（必须先获取，Q2 依赖）===
  57:     latest = db.query(StockMoneyFlowDetail.trade_date)\
  58:         .order_by(StockMoneyFlowDetail.trade_date.desc()).first()
  59:     td = latest[0] if latest else None
  60:     def _q2_latest_details():
  61:         """Q2: 最新一日 StockMoneyFlowDetail 的 4 档资金流"""
  62:         if not td:
  63:             return []
  64:         thread_db = SessionLocal()
  65:         try:
  66:             return thread_db.query(StockMoneyFlowDetail).filter(
  67:                 StockMoneyFlowDetail.trade_date == td,
  68:                 StockMoneyFlowDetail.ts_code.in_(ts_codes),
  69:             ).all()
  70:         except Exception as e:
  71:             logger.warning(f'[moneyflow] Q2 latest details failed: {e}')
  72:             return []
  73:         finally:
  74:             thread_db.close()
  75:     def _q3_features_daily():
  76:         """Q3: StockFeaturesDaily 最新一日的 1/3/5 日累计 + 连续天数"""
  77:         thread_db = SessionLocal()
  78:         try:
  79:             latest_sub = thread_db.query(
  80:                 StockFeaturesDaily.stock_code,
