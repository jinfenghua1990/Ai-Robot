<file path="frontend/src/components/ErrorBoundary.jsx">
 1: import React from 'react';
 2: export default class ErrorBoundary extends React.Component {
 3:   constructor(props) {
 4:     super(props);
 5:     this.state = { hasError: false, error: null };
 6:   }
 7:   static getDerivedStateFromError(error) {
 8:     return { hasError: true, error };
 9:   }
10:   componentDidCatch(error, errorInfo) {
11:     console.error('ErrorBoundary:', error, errorInfo);
12:     // 打印完整堆栈用于调试
13:     console.error('===ERROR STACK===');
14:     console.error(error && error.stack);
15:     console.error('===COMPONENT STACK===');
16:     console.error(errorInfo && errorInfo.componentStack);
17:     console.error('===END STACK===');
18:   }
19:   render() {
20:     if (this.state.hasError) {
21:       return (
22:         <div className="flex flex-col items-center justify-center h-96 gap-3">
23:           <div className="text-lg">⚠️</div>
24:           <div className="text-sm" style={{ color: 'var(--text-muted)' }}>页面渲染出错</div>
25:           <button
26:             onClick={() => this.setState({ hasError: false, error: null })}
27:             className="px-3 py-1.5 rounded-lg border text-sm"
28:             style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)' }}
29:           >
30:             重试
31:           </button>
32:         </div>
33:       );
34:     }
35:     return this.props.children;
36:   }
37: }
</file>

