113:     # positions 接口在部分情况下不返回完整账户字段，因此保留明确的质量标记。
114:     api_cash = pos_data.get("availBalance")
115:     api_market_value = pos_data.get("totalPosValue")
116:     api_equity = pos_data.get("totalAssets")
117:     total_cash = float(api_cash or 0)
118:     if api_market_value not in (None, ""):
119:         total_mv = float(api_market_value or 0)
120:     total_equity = float(api_equity or 0) if api_equity not in (None, "") else total_cash + total_mv
121:     limitations = []
