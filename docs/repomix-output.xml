 90:  */
 91: export const fmtMissing = () => '—';
 92: /**
 93:  * 判断值是否为有效数据（非 null/undefined/NaN/空字符串）
 94:  */
 95: export const hasValue = (v) => v != null && v !== '' && !isNaN(v);
 96: /**
 97:  * 龙头数据 → SignalCard 兼容格式
 98:  * 用于龙头趋势阶段/强度排行/周期V3页面，直接复用模拟盘的 SignalCard 组件
 99:  */
100: export const leaderToSignal = (leader) => {
101:   const stage = leader.stage || '突破';
102:   const stageColors = {
103:     '观望': '#64748b',
104:     '留意': '#a78bfa',
105:     '蓄势': '#38bdf8',
106:     '突破': '#facc15',
107:     '加速': '#fb923c',
108:     '主升': '#ef4444',
109:     '分歧': '#f97316',
110:     '衰退': '#94a3b8',
111:   };
112:   const stageColor = stageColors[stage] || '#6b7280';
113:   const changeRate = leader.change_rate || 0;
114:   const days = leader.consecutive_days || 0;
115:   const strength = leader.strength || 0;
116:   const positiveFactors = [];
117:   const negativeFactors = [];
118:   const reasons = [];
119:   // 根据阶段生成看多/看空因素
120:   if (stage === '观望') {
121:     negativeFactors.push({ factor: '资金观望', detail: '主力资金未明显介入，处于观望状态', weight: -1 });
122:   } else if (stage === '留意') {
123:     positiveFactors.push({ factor: '资金留意', detail: '主力资金开始流入，值得跟踪', weight: 1 });
124:   } else if (stage === '蓄势') {
125:     positiveFactors.push({ factor: '主力蓄势', detail: '主力资金大幅流入，潜在突破信号', weight: 2 });
126:   } else if (stage === '突破') {
127:     positiveFactors.push({ factor: '突破阶段', detail: '首板涨停，资金开始关注', weight: 2 });
128:   } else if (stage === '加速') {
129:     positiveFactors.push({ factor: '加速阶段', detail: `${days}连板，市场共识形成`, weight: 3 });
130:   } else if (stage === '主升') {
131:     positiveFactors.push({ factor: '主升阶段', detail: `${days}连板，涨幅扩大`, weight: 2 });
132:     negativeFactors.push({ factor: '高位风险', detail: '连板高度较大，回调风险增加', weight: -1 });
133:   } else if (stage === '分歧') {
134:     negativeFactors.push({ factor: '分歧阶段', detail: '连板中断，多空分歧加大', weight: -2 });
135:   } else if (stage === '衰退') {
136:     negativeFactors.push({ factor: '衰退阶段', detail: '资金流出，行情进入尾声', weight: -2 });
137:   }
138:   // 涨跌因素
139:   if (changeRate > 0) {
140:     positiveFactors.push({ factor: '当日上涨', detail: `涨幅 ${changeRate.toFixed(2)}%`, weight: 1 });
141:   } else if (changeRate < 0) {
142:     negativeFactors.push({ factor: '当日下跌', detail: `跌幅 ${changeRate.toFixed(2)}%`, weight: -1 });
143:   }
144:   // 连板因素
145:   if (days >= 3) {
146:     positiveFactors.push({ factor: '连板强势', detail: `${days}连板`, weight: 1 });
147:   }
148:   reasons.push(`阶段：${stage}，强度：${strength.toFixed(0)}，连板：${days}天`);
149:   return {
150:     secCode: leader.ts_code,
151:     secName: leader.name || '',
152:     signal: stage,
153:     signalLabel: stage,
154:     signalColor: stageColor,
155:     riskLevel: (stage === '分歧' || stage === '衰退') ? 'high' : (stage === '主升' || stage === '蓄势' ? 'medium' : 'low'),
156:     score: Math.round(strength),
157:     reasons,
158:     positiveFactors,
159:     negativeFactors,
160:     sector: leader.sector || '未知',
161:     sectorTrend: { sector: leader.sector, available: false },
162:     position: {
163:       profitPct: changeRate,
164:       posPct: 0,
165:       dayProfit: 0,
166:       dayProfitPct: changeRate,
167:       count: days,
168:       price: 0,
169:       costPrice: 0,
170:       value: 0,
171:       profit: 0,
172:     },
173:   };
174: };
