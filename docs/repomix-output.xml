  1: """
  2: 板块趋势引擎（Level 1）
  3: 职责：板块评分、分类、过滤
  4: 核心思想：先选板块，再选龙头
  5: 评分维度（0-10分）：
  6: - heat_score 板块热度（0-100）→ 2分
  7: - net_flow 净流入资金 → 2分
  8: - limit_up_count 涨停家数 → 2分
  9: - avg_chg 平均涨幅（近5日趋势）→ 2分
 10: - rise_ratio 上涨家数占比 → 1分
 11: - leader_strength 龙头强度 → 1分
 12: 分类：
 13: - STRONG_TREND（≥8分）：主升板块，可交易
 14: - ROTATION（5-7分）：轮动板块，轻仓
 15: - DOWN_TREND（<5分）：下降板块，禁止交易
 16: """
 17: from datetime import date, timedelta
 18: from sqlalchemy import desc, distinct
 19: from db.session import get_db_session
 20: from db.models import SectorFlow, StockFlow
 21: def calc_sector_score(sector_data, history=None):
 22:     """计算板块评分（0-10）
 23:     Args:
 24:         sector_data: 当天 SectorFlow 记录
 25:         history: 近5天 SectorFlow 记录列表（用于趋势判断）
 26:     Returns:
 27:         dict: score, details(各维度得分), state
 28:     """
 29:     score = 0
 30:     details = {}
 31:     # 1. 板块热度（heat_score 0-100）
 32:     heat = float(sector_data.heat_score or 0)
 33:     if heat >= 60:
 34:         score += 2
 35:         details['heat'] = 2
 36:     elif heat >= 40:
 37:         score += 1
 38:         details['heat'] = 1
 39:     else:
 40:         details['heat'] = 0
 41:     # 2. 净流入资金（net_flow，单位元）
 42:     net_flow = float(sector_data.net_flow or 0)
 43:     if net_flow > 1000000:  # 净流入超100万
 44:         score += 2
 45:         details['flow'] = 2
 46:     elif net_flow > 100000:  # 净流入超10万
 47:         score += 1
 48:         details['flow'] = 1
 49:     else:
 50:         details['flow'] = 0
 51:     # 3. 涨停家数
 52:     limit_up = int(sector_data.limit_up_count or 0)
 53:     if limit_up >= 3:
 54:         score += 2
 55:         details['limit_up'] = 2
 56:     elif limit_up >= 1:
 57:         score += 1
 58:         details['limit_up'] = 1
 59:     else:
 60:         details['limit_up'] = 0
 61:     # 4. 平均涨幅趋势（用近5日 avg_chg 替代 ma20_trend）
 62:     avg_chg = float(sector_data.avg_chg or 0)
 63:     # 如果有历史数据，判断趋势
 64:     if history and len(history) >= 3:
 65:         recent_chgs = [float(h.avg_chg or 0) for h in history[:5]]
 66:         trend_up = sum(1 for c in recent_chgs if c > 0) >= 3
 67:         if avg_chg > 0 and trend_up:
 68:             score += 2
 69:             details['trend'] = 2
 70:         elif avg_chg > 0:
 71:             score += 1
 72:             details['trend'] = 1
 73:         else:
 74:             details['trend'] = 0
 75:     else:
 76:         # 无历史数据时，当天涨幅>0即给分
 77:         if avg_chg > 2:
 78:             score += 2
 79:             details['trend'] = 2
 80:         elif avg_chg > 0:
 81:             score += 1
 82:             details['trend'] = 1
 83:         else:
 84:             details['trend'] = 0
 85:     # 5. 上涨家数占比（rise_ratio）
 86:     rise_ratio = float(sector_data.rise_ratio or 0)
 87:     # rise_ratio 可能是百分比(0-100)或小数(0-1)，统一处理
 88:     rise_pct = rise_ratio if rise_ratio > 1 else rise_ratio * 100
 89:     if rise_pct > 50:
 90:         score += 1
 91:         details['breadth'] = 1
 92:     else:
 93:         details['breadth'] = 0
 94:     # 6. 龙头强度
 95:     leader_str = float(sector_data.leader_strength or 0)
 96:     if leader_str >= 7:
 97:         score += 1
 98:         details['leader'] = 1
 99:     else:
100:         details['leader'] = 0
101:     # 分类（根据实际数据分布调整阈值）
102:     if score >= 4:
103:         state = "STRONG_TREND"
104:         state_label = "主升"
105:     elif score >= 2:
106:         state = "ROTATION"
107:         state_label = "轮动"
108:     else:
109:         state = "DOWN_TREND"
110:         state_label = "下降"
111:     return {
112:         'score': score,
113:         'details': details,
114:         'state': state,
115:         'state_label': state_label,
116:         'heat': heat,
117:         'net_flow': net_flow,
118:         'limit_up_count': limit_up,
119:         'avg_chg': avg_chg,
120:         'rise_ratio': rise_ratio,
121:         'leader_stock': sector_data.leader_stock,
122:         'leader_strength': leader_str,
123:     }
124: def get_sector_ranking(target_date=None, top_n=30):
125:     """获取板块评分排名
126:     Args:
127:         target_date: 目标日期，默认最新交易日
128:         top_n: 返回前N个板块
129:     Returns:
130:         dict: strong/rotation/down 三个分类列表 + all 完整排名
131:     """
132:     with get_db_session() as db:
133:         if target_date is None:
134:             target_date = db.query(SectorFlow.trade_date).order_by(
135:                 desc(SectorFlow.trade_date)
136:             ).first()[0]
137:         # 当天所有板块数据
138:         sectors_today = db.query(SectorFlow).filter(
139:             SectorFlow.trade_date == target_date
140:         ).all()
141:         if not sectors_today:
142:             return {'strong': [], 'rotation': [], 'down': [], 'all': [], 'date': None}
143:         # 获取近5天历史数据（用于趋势判断）
144:         five_days_ago = target_date - timedelta(days=7)
145:         history_all = db.query(SectorFlow).filter(
146:             SectorFlow.trade_date >= five_days_ago,
147:             SectorFlow.trade_date < target_date
148:         ).order_by(desc(SectorFlow.trade_date)).all()
149:         # 按板块分组历史
150:         history_by_sector = {}
151:         for h in history_all:
152:             if h.sector not in history_by_sector:
153:                 history_by_sector[h.sector] = []
154:             history_by_sector[h.sector].append(h)
155:         # 计算每个板块评分
156:         ranked = []
157:         for s in sectors_today:
158:             history = history_by_sector.get(s.sector, [])
159:             result = calc_sector_score(s, history)
160:             result['sector'] = s.sector
161:             result['trade_date'] = target_date.isoformat()
162:             ranked.append(result)
163:         # 按评分排序
164:         ranked.sort(key=lambda x: x['score'], reverse=True)
165:         # 分类
166:         strong = [r for r in ranked if r['state'] == 'STRONG_TREND']
167:         rotation = [r for r in ranked if r['state'] == 'ROTATION']
168:         down = [r for r in ranked if r['state'] == 'DOWN_TREND']
169:         return {
170:             'strong': strong[:10],
171:             'rotation': rotation[:10],
172:             'down': down[:10],
173:             'all': ranked[:top_n],
174:             'date': target_date.isoformat(),
175:             'summary': {
176:                 'total': len(ranked),
177:                 'strong_count': len(strong),
178:                 'rotation_count': len(rotation),
179:                 'down_count': len(down),
180:             },
181:         }
182: def build_sector_top_map(start_date, end_date, top_n=10,
183:                          mode='strong_rotation', valid_sectors=None):
184:     """预计算回测区间内每个交易日的 TopN 上升趋势板块集合（无未来函数）。
185:     用于 BS 回测的板块趋势过滤器：B 点信号触发时，要求该股所属板块在当日 TopN。
186:     Args:
187:         start_date/end_date: 'YYYY-MM-DD' 字符串或 date 对象
188:         top_n: 每日取前N个板块
189:         mode: 'strong_rotation'=STRONG+ROTATION按分排序; 'strong_only'=仅STRONG
190:         valid_sectors: 可选的白名单板块集合(set)，None时自动从StockFlow distinct获取
191:     Returns:
192:         {date_iso_str: set(sector_names)}，无数据的日期不在dict中
193:     """
194:     # 统一为 date 对象
195:     if isinstance(start_date, str):
196:         start_date = date.fromisoformat(start_date)
197:     if isinstance(end_date, str):
198:         end_date = date.fromisoformat(end_date)
199:     with get_db_session() as db:
200:         # 多取10天给 calc_sector_score 的 history 维度用
201:         lookback_start = start_date - timedelta(days=10)
202:         rows = db.query(SectorFlow).filter(
203:             SectorFlow.trade_date >= lookback_start,
204:             SectorFlow.trade_date <= end_date,
205:         ).order_by(SectorFlow.trade_date).all()
206:         if not rows:
207:             return {}
208:         # 白名单：真实有股票的板块（剔除"行业"后缀幽灵板块）
209:         if valid_sectors is None:
210:             stock_sectors = set(s[0] for s in db.query(distinct(StockFlow.sector))
211:                                 .filter(StockFlow.sector.isnot(None),
212:                                         StockFlow.sector != '').all())
213:         else:
214:             stock_sectors = set(valid_sectors)
215:         # 按 date 组织当日板块；按 sector 组织历史（升序）
216:         by_date = {}
217:         hist_by_sector = {}
218:         for r in rows:
219:             d = r.trade_date
220:             by_date.setdefault(d, []).append(r)
221:             hist_by_sector.setdefault(r.sector, []).append(r)
222:         # 历史按日期升序，后续取最近5条用 [-5:] 后再反转降序
223:         for s in hist_by_sector:
224:             hist_by_sector[s].sort(key=lambda x: x.trade_date)
225:         result = {}
226:         for d, sectors_today in by_date.items():
227:             if d < start_date or d > end_date:
228:                 continue
229:             ranked = []
230:             for s in sectors_today:
231:                 if stock_sectors and s.sector not in stock_sectors:
232:                     continue  # 幽灵板块跳过
233:                 # history: 严格取 trade_date < 当日 的最近5条（降序，最近在前）
234:                 hist = [h for h in hist_by_sector.get(s.sector, []) if h.trade_date < d][-5:][::-1]
235:                 sc = calc_sector_score(s, hist)
236:                 if mode == 'strong_only' and sc['state'] != 'STRONG_TREND':
237:                     continue
238:                 if mode == 'strong_rotation' and sc['state'] not in ('STRONG_TREND', 'ROTATION'):
239:                     continue
240:                 ranked.append((sc['score'], s.sector))
241:             ranked.sort(reverse=True)
242:             top_set = set(sec for _, sec in ranked[:top_n])
243:             if top_set:
244:                 result[d.isoformat()] = top_set
245:         return result
