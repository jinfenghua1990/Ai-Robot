 49:             date_obj = datetime.strptime(trade_date, '%Y-%m-%d')
 50:             check_dates = []
 51:             for i in range(1, 8):  # 往前找7天，取最近3个有数据的交易日
 52:                 d = (date_obj - timedelta(days=i)).strftime('%Y-%m-%d')
 53:                 check_dates.append(d)
 54:             all_check_dates = [trade_date] + check_dates
 55:             recent_sectors = db.query(SectorFlow).filter(
