<file path="backend/us_quant/data_provider.py">
  1: """US Quant 数据源 provider — 自动识别系统代理 + 多源实时行情。
  2: 此前采集不到的真正根因：后端 uvicorn 进程既没读 macOS 系统代理设置，
  3: 也没有 HTTP_PROXY 环境变量，是裸连出网的；而 Yahoo 等免费源在大陆网络被
  4: 墙 / 限流，于是请求失败 → 一路降级到离线模拟。
  5: 现在的架构（数据源优先级，全部经本机代理出网）：
  6:   1. 自动识别出网代理：环境变量 HTTP(S)_PROXY，否则在 macOS 上读系统代理
  7:      (scutil --proxy)。让后端像浏览器一样走代理。
  8:   2. 主数据源 Nasdaq 官方 API（免费、无需 key、真实数据）。
  9:      股票用 assetclass=stocks，ETF 必须用 assetclass=etf（否则 Symbol not exists）。
 10:   3. VIX 波动率：CBOE 官方 CSV（Nasdaq 不带 VIX）。
 11:   4. 兜底：Yahoo Finance（经代理），仍可能被限流(429)。
 12:   5. 最后兜底：确定性离线模拟——仅在以上全部不可达时使用，避免页面空白。
 13: 所有外部请求带 60s TTL 缓存与失败重试（429/5xx 退避）。
 14: """
 15: from __future__ import annotations
 16: import logging
 17: import os
 18: import random
 19: import subprocess
 20: import sys
 21: import time
 22: from concurrent.futures import ThreadPoolExecutor, as_completed
 23: from datetime import date, datetime, timedelta
 24: from typing import Optional
 25: import requests
 26: logger = logging.getLogger(__name__)
 27: # ─── 已知 ETF（Nasdaq 对 ETF 必须用 assetclass=etf）──────────────────────
 28: _KNOWN_ETFS = {
 29:     "SPY", "QQQ", "IWM", "RSP", "DIA", "VTI", "VOO", "VIG", "IVE", "IWD",
 30:     "XLK", "SMH", "SOXX", "XLC", "XLY", "XLF", "XLI", "XLV", "XLE", "XLB",
 31:     "XLP", "XLU", "XLRE", "XBI", "XRT", "XHB", "XME", "KBE", "KRE", "ARKK",
 32: }
 33: _RANGE_DAYS = {
 34:     "1d": 1, "5d": 5, "1mo": 22, "2mo": 44, "3mo": 66, "6mo": 126, "1y": 252,
 35: }
 36: def _range_to_days(range_str: str) -> int:
 37:     return _RANGE_DAYS.get(range_str, 22)
 38: # ─── 代理自动识别 ──────────────────────────────────────────────────────────
 39: _PROXY_URL: Optional[str] = None
 40: _PROXY_PROBED = False
 41: def _detect_proxy() -> Optional[str]:
 42:     """优先取环境变量，否则在 macOS 上读取系统代理(scutil)。"""
 43:     for key in ("HTTPS_PROXY", "https_proxy", "HTTP_PROXY", "http_proxy"):
 44:         v = os.environ.get(key)
 45:         if v:
 46:             return v
 47:     if sys.platform == "darwin":
 48:         try:
 49:             out = subprocess.run(
 50:                 ["/usr/sbin/scutil", "--proxy"],
 51:                 capture_output=True, text=True, timeout=5,
 52:             ).stdout
 53:             http_host = http_port = https_host = https_port = None
 54:             http_en = https_en = False
 55:             for line in out.splitlines():
 56:                 s = line.strip()
 57:                 if s.startswith("HTTPEnable") and ": 1" in s:
 58:                     http_en = True
 59:                 elif s.startswith("HTTPProxy :"):
 60:                     http_host = s.split(":", 1)[1].strip()
 61:                 elif s.startswith("HTTPPort :"):
 62:                     http_port = s.split(":", 1)[1].strip()
 63:                 elif s.startswith("HTTPSEnable") and ": 1" in s:
 64:                     https_en = True
 65:                 elif s.startswith("HTTPSProxy :"):
 66:                     https_host = s.split(":", 1)[1].strip()
 67:                 elif s.startswith("HTTPSPort :"):
 68:                     https_port = s.split(":", 1)[1].strip()
 69:             if https_en and https_host and https_port:
 70:                 return f"http://{https_host}:{https_port}"
 71:             if http_en and http_host and http_port:
 72:                 return f"http://{http_host}:{http_port}"
 73:         except Exception as exc:
 74:             logger.debug(f"[us_quant] proxy detect failed: {exc}")
 75:     return None
 76: def _get_proxies() -> Optional[dict]:
 77:     global _PROXY_URL, _PROXY_PROBED
 78:     if not _PROXY_PROBED:
 79:         _PROXY_URL = _detect_proxy()
 80:         _PROXY_PROBED = True
 81:         if _PROXY_URL:
 82:             logger.info(f"[us_quant] 使用系统代理出网: {_PROXY_URL}")
 83:     if not _PROXY_URL:
 84:         return None
 85:     return {"http": _PROXY_URL, "https": _PROXY_URL}
 86: # ─── 请求会话（带重试）────────────────────────────────────────────────────
 87: _SESSION: Optional[requests.Session] = None
 88: def _session() -> requests.Session:
 89:     global _SESSION
 90:     if _SESSION is None:
 91:         s = requests.Session()
 92:         try:
 93:             retry = requests.packages.urllib3.util.retry.Retry(
 94:                 total=2, backoff_factor=0.3,
 95:                 status_forcelist=(429, 500, 502, 503, 504),
 96:                 allowed_methods=frozenset(["GET"]),
 97:             )
 98:             adapter = requests.adapters.HTTPAdapter(max_retries=retry)
 99:             s.mount("https://", adapter)
100:             s.mount("http://", adapter)
101:         except Exception:
102:             pass
103:         s.headers.update({
104:             "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) "
105:                           "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0 Safari/537.36",
106:             "Accept": "application/json",
107:         })
108:         # trust_env 是 Session 级属性：关掉，避免意外继承环境中的 HTTP_PROXY
109:         s.trust_env = False
110:         _SESSION = s
111:     return _SESSION
112: def _get_json(url: str, params: Optional[dict] = None) -> Optional[dict]:
113:     try:
114:         resp = _session().get(url, params=params, proxies=_get_proxies(),
115:                               timeout=(5, 12))
116:         if resp.status_code != 200:
117:             return None
118:         return resp.json()
119:     except Exception as exc:
120:         logger.debug(f"[us_quant] GET json failed {url}: {exc}")
121:         return None
122: def _get_text(url: str) -> Optional[str]:
123:     try:
124:         resp = _session().get(url, proxies=_get_proxies(),
125:                               timeout=(5, 12))
126:         if resp.status_code != 200:
127:             return None
128:         return resp.text
129:     except Exception as exc:
130:         logger.debug(f"[us_quant] GET text failed {url}: {exc}")
131:         return None
132: def _num(s) -> Optional[float]:
133:     if s is None:
134:         return None
135:     s = str(s).replace("$", "").replace(",", "").strip()
136:     if s in ("", "N/A", "NA", "—", "-"):
137:         return None
138:     try:
139:         return float(s)
140:     except ValueError:
141:         return None
142: # ─── Nasdaq 实时源 ────────────────────────────────────────────────────────
143: def _assetclass(symbol: str) -> str:
144:     return "etf" if symbol in _KNOWN_ETFS else "stocks"
145: def _nasdaq_historical(symbol: str, assetclass: str, days: int) -> Optional[list[dict]]:
146:     to_d = date.today()
147:     from_d = to_d - timedelta(days=int(days * 1.7) + 6)
148:     url = f"https://api.nasdaq.com/api/quote/{symbol}/historical"
149:     params = {
150:         "assetclass": assetclass,
151:         "fromdate": from_d.strftime("%Y-%m-%d"),
152:         "todate": to_d.strftime("%Y-%m-%d"),
153:     }
154:     data = _get_json(url, params=params)
155:     if not data or data.get("data") is None:
156:         return None
157:     rows = data["data"].get("tradesTable", {}).get("rows", [])
158:     items: list[dict] = []
159:     for r in rows:
160:         try:
161:             d = datetime.strptime(r["date"], "%m/%d/%Y").strftime("%Y-%m-%d")
162:         except Exception:
163:             continue
164:         close = _num(r.get("close"))
165:         if close is None:
166:             continue
167:         items.append({
168:             "date": d,
169:             "open": _num(r.get("open")),
170:             "high": _num(r.get("high")),
171:             "low": _num(r.get("low")),
172:             "close": close,
173:             "volume": int((r.get("volume") or "0").replace(",", "")) if r.get("volume") else 0,
174:         })
175:     if len(items) > days:
176:         items = items[-days:]
177:     return items if items else None
178: def _nasdaq_info(symbol: str, assetclass: str) -> Optional[dict]:
179:     """实时报价（last sale + 涨跌幅）。"""
180:     url = f"https://api.nasdaq.com/api/quote/{symbol}/info"
181:     data = _get_json(url, params={"assetclass": assetclass})
182:     if not data or data.get("data") is None:
183:         return None
184:     pd = data["data"].get("primaryData", {})
185:     price = _num(pd.get("lastSalePrice"))
186:     if price is None:
187:         return None
188:     change = _num(pd.get("netChange"))
189:     pct = _num(pd.get("percentageChange"))
190:     vol = _num(pd.get("volume"))
191:     return {
192:         "price": price,
193:         "prev_close": round(price - change, 4) if change is not None else None,
194:         "close": price,
195:         "change": change,
196:         "change_pct": pct,
197:         "volume": int(vol) if vol is not None else None,
198:         "currency": "USD",
199:         "exchange": data["data"].get("exchange", ""),
200:         "is_real_time": pd.get("isRealTime", False),
201:     }
202: # ─── CBOE VIX ─────────────────────────────────────────────────────────────
203: def _cboe_vix_klines(days: int) -> Optional[list[dict]]:
204:     url = "https://cdn.cboe.com/api/global/us_indices/daily_prices/VIX_History.csv"
205:     txt = _get_text(url)
206:     if not txt:
207:         return None
208:     items: list[dict] = []
209:     for line in txt.strip().splitlines():
210:         if line.startswith("Date") or not line.strip():
211:             continue
212:         p = line.split(",")
213:         if len(p) < 5:
214:             continue
215:         try:
216:             d = datetime.strptime(p[0], "%m/%d/%Y").strftime("%Y-%m-%d")
217:             items.append({
218:                 "date": d,
219:                 "open": float(p[1]), "high": float(p[2]),
220:                 "low": float(p[3]), "close": float(p[4]), "volume": 0,
221:             })
222:         except Exception:
223:             continue
224:     items.reverse()  # CSV 日期降序 → 升序
225:     if len(items) > days:
226:         items = items[-days:]
227:     return items if items else None
228: # ─── Yahoo 兜底（经代理）──────────────────────────────────────────────────
229: def _fetch_yahoo_live(symbol: str, range_str: str) -> Optional[list[dict]]:
230:     try:
231:         url = f"https://query1.finance.yahoo.com/v8/finance/chart/{symbol}"
232:         params = {"range": range_str, "interval": "1d"}
233:         resp = _session().get(url, params=params, proxies=_get_proxies(),
234:                               trust_env=False, timeout=(4, 8))
235:         if resp.status_code != 200:
236:             return None
237:         result = resp.json()["chart"]["result"][0]
238:         ts = result.get("timestamp", [])
239:         q = result.get("indicators", {}).get("quote", [{}])[0]
240:         o, h, l, c, v = (q.get(k, []) for k in ("open", "high", "low", "close", "volume"))
241:         items = []
242:         for i in range(len(ts)):
243:             close = c[i] if i < len(c) and c[i] is not None else None
244:             if close is None:
245:                 continue
246:             items.append({
247:                 "date": datetime.fromtimestamp(ts[i]).strftime("%Y-%m-%d"),
248:                 "open": round(o[i], 4) if i < len(o) and o[i] else None,
249:                 "high": round(h[i], 4) if i < len(h) and h[i] else None,
250:                 "low": round(l[i], 4) if i < len(l) and l[i] else None,
251:                 "close": round(close, 4),
252:                 "volume": int(v[i]) if i < len(v) and v[i] else 0,
253:             })
254:         return items if items else None
255:     except Exception as exc:
256:         logger.debug(f"[us_quant] Yahoo failed for {symbol}: {exc}")
257:         return None
258: # ─── 离线确定性模拟（仅最后兜底）──────────────────────────────────────────
259: _BASE_PRICE = {
260:     "SPY": 560.0, "QQQ": 480.0, "IWM": 220.0, "RSP": 180.0, "^VIX": 15.0,
261:     "AAPL": 195.0, "MSFT": 420.0, "GOOGL": 175.0, "AMZN": 185.0,
262:     "NVDA": 125.0, "TSLA": 250.0, "META": 510.0, "TSM": 175.0,
263:     "XLK": 230.0, "SMH": 255.0, "SOXX": 240.0, "XLC": 95.0, "XLY": 230.0,
264:     "XLF": 48.0, "XLI": 130.0, "XLV": 145.0, "XLE": 95.0, "XLB": 95.0,
265:     "XLP": 80.0, "XLU": 78.0, "XLRE": 42.0,
266: }
267: def _symbol_seed(symbol: str) -> int:
268:     h = 0
269:     for ch in symbol:
270:         h = (h * 31 + ord(ch)) & 0xFFFFFFFF
271:     return h
272: def _synthetic_klines(symbol: str, days: int) -> list[dict]:
273:     rng = random.Random(_symbol_seed(symbol))
274:     base = _BASE_PRICE.get(symbol, 50.0 + (_symbol_seed(symbol) % 400))
275:     drift = (rng.random() - 0.42) * 0.0018
276:     vol = 0.010 + rng.random() * 0.022
277:     price = base * (0.82 + rng.random() * 0.12)
278:     today = date.today()
279:     d = today
280:     items: list[dict] = []
281:     count = 0
282:     while count < days:
283:         if d.weekday() < 5:
284:             ret = drift + rng.gauss(0, vol)
285:             open_p = price
286:             close_p = max(0.5, open_p * (1 + ret))
287:             amp = abs(rng.gauss(0, vol / 2))
288:             high_p = max(open_p, close_p) * (1 + amp)
289:             low_p = min(open_p, close_p) * (1 - amp)
290:             volume = int((1_000_000 + rng.random() * 9_000_000) * (1 + abs(ret) * 18))
291:             items.append({
292:                 "date": d.strftime("%Y-%m-%d"),
293:                 "open": round(open_p, 4), "high": round(high_p, 4),
294:                 "low": round(low_p, 4), "close": round(close_p, 4),
295:                 "volume": volume,
296:             })
297:             price = close_p
298:             count += 1
299:         d -= timedelta(days=1)
300:     items.reverse()
301:     return items
302: # ─── 公共接口 ─────────────────────────────────────────────────────────────
303: _KLINE_CACHE: dict = {}
304: _KLINE_TTL = 300.0
305: def get_klines(symbol: str, range_str: str = "1mo") -> Optional[list[dict]]:
306:     """获取 K 线：数据库优先 → 多源采集 → 离线模拟。
307:     数据流：
308:       1. 先读 USStockDaily 表（已有数据直接返回）
309:       2. 表里没有 → 触发采集（gstock → akshare → Nasdaq → Yahoo → 合成）→ 入库
310:       3. 再次从库读取返回
311:     """
312:     days = max(_range_to_days(range_str), 2)
313:     key = (symbol, range_str)
314:     now = time.time()
315:     cached = _KLINE_CACHE.get(key)
316:     if cached and (now - cached[0]) < _KLINE_TTL:
317:         return cached[1]
318:     # 1. 优先从数据库读（已有数据则直接返回）
319:     try:
320:         from us_quant.collector import get_db_klines
321:         db_result = get_db_klines(symbol)
322:         if db_result and len(db_result) >= days * 0.5:
323:             if len(db_result) > days:
324:                 db_result = db_result[-days:]
325:             _KLINE_CACHE[key] = (now, db_result)
326:             return db_result
327:     except Exception as exc:
328:         logger.debug(f"[us_quant] get_klines db read failed {symbol}: {exc}")
329:     # 2. 数据库数据不足，从外部源采集（采集器会自动入库）
330:     result: Optional[list[dict]] = None
331:     try:
332:         if symbol == "^VIX":
333:             result = _cboe_vix_klines(days) or _fetch_yahoo_live(symbol, range_str)
334:         else:
335:             # 优先通过采集器入库
336:             try:
337:                 from us_quant.collector import collect_symbol
338:                 collect_symbol(symbol)
339:                 from us_quant.collector import get_db_klines as get_db
340:                 db_result = get_db(symbol)
341:                 if db_result and len(db_result) >= 2:
342:                     result = db_result
343:             except Exception:
344:                 pass
345:             if not result:
346:                 ac = _assetclass(symbol)
347:                 result = _nasdaq_historical(symbol, ac, days)
348:                 if not result and ac == "stocks":
349:                     result = _nasdaq_historical(symbol, "etf", days)
350:             if not result:
351:                 result = _fetch_yahoo_live(symbol, range_str)
352:         if result and len(result) < days * 0.5:
353:             logger.info(f'[us_quant] {symbol}: 真实数据仅 {len(result)} 条 (需求 {days})，切换到合成数据')
354:             result = _synthetic_klines(symbol, days)
355:         if not result:
356:             result = _synthetic_klines(symbol, days)
357:     except Exception as exc:
358:         logger.warning(f"[us_quant] get_klines fallback for {symbol}: {exc}")
359:         try:
360:             result = _synthetic_klines(symbol, days)
361:         except Exception:
362:             result = None
363:     if result and len(result) > days:
364:         result = result[-days:]
365:     _KLINE_CACHE[key] = (now, result)
366:     return result
367: def get_klines_batch(symbols: list[str], range_str: str = "1mo",
368:                       max_workers: int = 4) -> dict[str, Optional[list[dict]]]:
369:     """并行批量拉取多个标的的 K 线，把串行耗时压成「取最大」而非「累加」。
370:     个别标的失败（限流/超时）不影响其余，失败项返回 None，由调用方决定降级。
371:     """
372:     syms = list(dict.fromkeys(symbols))  # 去重保序
373:     results: dict[str, Optional[list[dict]]] = {}
374:     if not syms:
375:         return results
376:     with ThreadPoolExecutor(max_workers=min(max_workers, len(syms))) as ex:
377:         fut_to_sym = {ex.submit(get_klines, s, range_str): s for s in syms}
378:         for fut in as_completed(fut_to_sym):
379:             s = fut_to_sym[fut]
380:             try:
381:                 results[s] = fut.result()
382:             except Exception as exc:
383:                 logger.debug(f"[us_quant] batch klines failed {s}: {exc}")
384:                 results[s] = None
385:     # 失败项串行重试（缓解 Nasdaq 偶发 429 限流导致的丢数据）
386:     for _attempt in range(2):
387:         _failed = [s for s in syms if results.get(s) is None]
388:         if not _failed:
389:             break
390:         time.sleep(1.2)
391:         for s in _failed:
392:             try:
393:                 results[s] = get_klines(s, range_str)
394:             except Exception as exc:
395:                 logger.debug(f"[us_quant] batch retry failed {s}: {exc}")
396:                 results[s] = None
397:     for s in syms:
398:         results.setdefault(s, None)
399:     return results
400: def get_quote(symbol: str) -> Optional[dict]:
401:     """获取单只最新行情：优先 Nasdaq 实时报价，否则用 K 线末两根推算。"""
402:     if symbol == "^VIX":
403:         k = get_klines(symbol, "5d")
404:         if not k or len(k) < 1:
405:             return None
406:         last = k[-1]["close"]
407:         prev = k[-2]["close"] if len(k) >= 2 else last
408:         return {"price": last, "prev_close": prev, "close": last,
409:                 "currency": "USD", "exchange": "CBOE", "is_real_time": False}
410:     ac = _assetclass(symbol)
411:     info = _nasdaq_info(symbol, ac)
412:     if not info and ac == "stocks":
413:         info = _nasdaq_info(symbol, "etf")
414:     if info:
415:         return info
416:     k = get_klines(symbol, "5d")
417:     if not k or len(k) < 1:
418:         return None
419:     last = k[-1]["close"]
420:     prev = k[-2]["close"] if len(k) >= 2 else last
421:     return {"price": last, "prev_close": prev, "close": last,
422:             "currency": "USD", "exchange": "", "is_real_time": False}
423: # ─── 实时源可用性（带 TTL 缓存）──────────────────────────────────────────
424: _LIVE_CACHE: dict = {"ok": None, "ts": 0.0}
425: _LIVE_TTL = 300.0
426: def is_live_available() -> bool:
427:     """探活：Nasdaq 实时源是否可达（带 TTL 缓存）。"""
428:     now = time.time()
429:     if _LIVE_CACHE["ok"] is not None and (now - _LIVE_CACHE["ts"]) < _LIVE_TTL:
430:         return _LIVE_CACHE["ok"]
431:     ok = _nasdaq_info("AAPL", "stocks") is not None
432:     _LIVE_CACHE.update(ok=ok, ts=now)
433:     return ok
434: def reset_live_cache() -> None:
435:     """强制下次重新探活 + 清代理缓存 + 清 K 线缓存（配置变更后调用）。"""
436:     _LIVE_CACHE["ok"] = None
437:     _LIVE_CACHE["ts"] = 0.0
438:     _KLINE_CACHE.clear()
439:     global _PROXY_PROBED, _PROXY_URL
440:     _PROXY_PROBED = False
441:     _PROXY_URL = None
