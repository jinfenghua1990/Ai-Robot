 71:  * null/NaN → '—'
 72:  */
 73: export const fmtPct2 = (v) => {
 74:   if (v == null || isNaN(v)) return '—';
 75:   return `${v >= 0 ? '+' : ''}${v.toFixed(2)}%`;
 76: };
 77: /**
 78:  * 统一金额格式化（输入为元）：3.34亿 / 30万 / —
 79:  * null/NaN → '—'
