65:                 type="checkbox"
66:                 checked={!!activeFilters[f.key]}
67:                 onChange={(e) => onToggle(f.key, e.target.checked)}
68:               />
69:               <span className="text-[12px]">{f.icon}</span>
70:               <span className="text-[11px] font-bold">{f.label}</span>
71:               <span className="text-[10px] ml-auto" style={{ color: 'var(--text-muted)' }}>{f.desc}</span>
