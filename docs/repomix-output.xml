 1: """
 2: 实时板块资金流向采集器
 3: 数据源：新浪(主) → 东方财富(降级)
 4: """
 5: import logging
 6: from datetime import datetime
 7: from db.session import get_db_session
 8: from db.models import RealtimeSectorFlow
 9: from collectors.tdx_collector import get_sector_money_flow
10: logger = logging.getLogger(__name__)
11: def _now_truncated():
12:     """当前时间截断到分钟（秒数归零）"""
13:     return datetime.now().replace(second=0, microsecond=0)
14: def collect_realtime_sector_flow(trade_date):
15:     """
16:     采集板块实时资金流向快照
17:     数据源：新浪(主) → 东方财富(降级)
18:     """
19:     snapshot_time = _now_truncated()
20:     print(f'[realtime] Collecting sector flow snapshot at {snapshot_time}')
21:     # 复用现有采集函数（新浪→东方财富→Tushare）
22:     sector_flows = get_sector_money_flow(trade_date)
23:     if not sector_flows:
24:         print('[realtime] No sector flow data')
25:         return 0
26:     # 判断数据源
27:     source = 'sina'  # get_sector_money_flow 优先用新浪
28:     # 简单判断：如果板块数<40 可能是东方财富或Tushare
29:     if len(sector_flows) < 40:
30:         source = 'em'
31:     with get_db_session() as db:
32:         saved = 0
33:         try:
34:             for sf in sector_flows:
35:                 record = RealtimeSectorFlow(
36:                     snapshot_time=snapshot_time,
37:                     trade_date=trade_date,
38:                     sector=sf['sector'],
39:                     money_inflow=sf.get('money_inflow'),
40:                     money_outflow=sf.get('money_outflow'),
41:                     net_flow=sf.get('net_flow'),
42:                     rise_ratio=sf.get('rise_ratio'),
43:                     source=source,
44:                 )
45:                 db.add(record)
46:                 saved += 1
47:             db.commit()
48:             logger.info(f'[realtime] Saved {saved} sector snapshots (source={source})')
49:         except Exception as e:
50:             db.rollback()
51:             logger.warning(f'[realtime] Sector save error: {e}')
52:     return saved
