<file path="backend/api/yuzi/router.py">
  1: """
  2: 游资龙虎榜路由
  3: - GET  /api/yuzi/seats              席位字典列表
  4: - POST /api/yuzi/seats              新增席位
  5: - PUT  /api/yuzi/seats/{id}         修改席位
  6: - DELETE /api/yuzi/seats/{id}       删除席位
  7: - GET  /api/yuzi/billboard          当日资金动向榜（按大佬聚合）
  8: - GET  /api/yuzi/resonance          当日共振信号池（按股聚合，quant_score 排序）
  9: - GET  /api/yuzi/seat-stats         某游资近 N 日战绩
 10: - GET  /api/yuzi/stock-history      某股近 N 日游资介入记录
 11: - GET  /api/yuzi/holdings           大佬持仓跟踪(BUY→SELL 配对,持有天数+收益率)
 12: - POST /api/yuzi/refresh            触发盘后清洗
 13: - GET  /api/yuzi/dates              DB 已有数据日期列表
 14: """
 15: import json
 16: import logging
 17: from collections import defaultdict
 18: from datetime import datetime, timedelta
 19: from typing import Optional, List
 20: from fastapi import APIRouter, HTTPException, Query, Body
 21: from pydantic import BaseModel
 22: from db.session import get_db_session
 23: from db.models import YuziDict, YuziQuantSignal, YuziSeatDaily, StockDailyKline
 24: logger = logging.getLogger(__name__)
 25: router = APIRouter()
 26: # ============================================================
 27: # 席位字典 CRUD
 28: # ============================================================
 29: class SeatIn(BaseModel):
 30:     seat_name: str
 31:     yuzi_alias: str
 32:     yuzi_group: Optional[str] = '实力游资'
 33:     region: Optional[str] = ''
 34:     tags: Optional[List[str]] = []
 35:     is_active: Optional[bool] = True
 36:     hot_score: Optional[int] = 50
 37:     note: Optional[str] = ''
 38: @router.get("/api/yuzi/seats")
 39: def list_seats(
 40:     group: Optional[str] = None,
 41:     active_only: bool = True,
 42:     search: Optional[str] = None,
 43: ):
 44:     """席位字典列表（支持 group 过滤/active 过滤/名字模糊搜索）"""
 45:     with get_db_session() as db:
 46:         q = db.query(YuziDict)
 47:         if active_only:
 48:             q = q.filter(YuziDict.is_active == True)  # noqa
 49:         if group:
 50:             q = q.filter(YuziDict.yuzi_group == group)
 51:         if search:
 52:             kw = f'%{search}%'
 53:             q = q.filter((YuziDict.seat_name.like(kw)) | (YuziDict.yuzi_alias.like(kw)))
 54:         rows = q.order_by(YuziDict.hot_score.desc(), YuziDict.yuzi_alias).all()
 55:         return {
 56:             'count': len(rows),
 57:             'seats': [{
 58:                 'id': r.id,
 59:                 'seat_name': r.seat_name,
 60:                 'yuzi_alias': r.yuzi_alias,
 61:                 'yuzi_group': r.yuzi_group,
 62:                 'region': r.region or '',
 63:                 'tags': json.loads(r.tags or '[]'),
 64:                 'is_active': r.is_active,
 65:                 'hot_score': r.hot_score or 50,
 66:                 'note': r.note or '',
 67:                 'updated_at': r.updated_at.strftime('%Y-%m-%d %H:%M:%S') if r.updated_at else '',
 68:             } for r in rows]
 69:         }
 70: @router.post("/api/yuzi/seats")
 71: def add_seat(seat: SeatIn):
 72:     """新增席位（已存在则返回 409）"""
 73:     with get_db_session() as db:
 74:         if db.query(YuziDict).filter(YuziDict.seat_name == seat.seat_name).first():
 75:             raise HTTPException(409, detail=f"seat_name 已存在: {seat.seat_name}")
 76:         row = YuziDict(
 77:             seat_name=seat.seat_name,
 78:             yuzi_alias=seat.yuzi_alias,
 79:             yuzi_group=seat.yuzi_group or '实力游资',
 80:             region=seat.region or '',
 81:             tags=json.dumps(seat.tags or [], ensure_ascii=False),
 82:             is_active=seat.is_active if seat.is_active is not None else True,
 83:             hot_score=seat.hot_score or 50,
 84:             note=seat.note or '',
 85:         )
 86:         db.add(row)
 87:         db.commit()
 88:         return {'id': row.id, 'seat_name': row.seat_name, 'ok': True}
 89: @router.put("/api/yuzi/seats/{seat_id}")
 90: def update_seat(seat_id: int, seat: SeatIn):
 91:     """修改席位"""
 92:     with get_db_session() as db:
 93:         row = db.query(YuziDict).filter(YuziDict.id == seat_id).first()
 94:         if not row:
 95:             raise HTTPException(404, detail=f"seat id {seat_id} not found")
 96:         row.seat_name = seat.seat_name
 97:         row.yuzi_alias = seat.yuzi_alias
 98:         row.yuzi_group = seat.yuzi_group or '实力游资'
 99:         row.region = seat.region or ''
100:         row.tags = json.dumps(seat.tags or [], ensure_ascii=False)
101:         if seat.is_active is not None:
102:             row.is_active = seat.is_active
103:         row.hot_score = seat.hot_score or 50
104:         row.note = seat.note or ''
105:         db.commit()
106:         return {'id': row.id, 'ok': True}
107: @router.delete("/api/yuzi/seats/{seat_id}")
108: def delete_seat(seat_id: int):
109:     """软删（is_active=False），物理删除需手动 SQL"""
110:     with get_db_session() as db:
111:         row = db.query(YuziDict).filter(YuziDict.id == seat_id).first()
112:         if not row:
