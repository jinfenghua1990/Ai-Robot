<file path="backend/api/watchlist/watchlist_local.py">
  1: """本地自选股 JSON 文件读写（唯一真相源）
  2: watchlist.json 格式: {"stocks": [{"code","name","note","group"}], "version": 1, "updated_at": "..."}
  3: """
  4: import json
  5: import os
  6: import logging
  7: from datetime import datetime
  8: from threading import Lock
  9: logger = logging.getLogger(__name__)
 10: _MODULE_DIR = os.path.dirname(os.path.abspath(__file__))  # .../backend/api/watchlist
 11: _PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(_MODULE_DIR)))  # .../AIROBOT
 12: WATCHLIST_JSON_PATH = os.path.join(_PROJECT_ROOT, "watchlist.json")
 13: _lock = Lock()
 14: def read_local() -> dict:
 15:     """读取本地自选股 JSON，返回 {"stocks": [...], "version": 1, "updated_at": "..."}"""
 16:     with _lock:
 17:         try:
 18:             with open(WATCHLIST_JSON_PATH, "r", encoding="utf-8") as f:
 19:                 data = json.load(f)
 20:             if not isinstance(data.get("stocks"), list):
 21:                 data["stocks"] = []
 22:             return data
 23:         except (FileNotFoundError, json.JSONDecodeError) as e:
 24:             logger.warning(f"watchlist.json 读取失败: {e}")
 25:             return {"stocks": [], "version": 1, "updated_at": ""}
 26: def write_local(data: dict):
 27:     """写入本地自选股 JSON"""
 28:     data["updated_at"] = datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%SZ")
 29:     data.setdefault("version", 1)
 30:     with _lock:
 31:         os.makedirs(os.path.dirname(WATCHLIST_JSON_PATH), exist_ok=True)
 32:         with open(WATCHLIST_JSON_PATH, "w", encoding="utf-8") as f:
 33:             json.dump(data, f, ensure_ascii=False, indent=2)
 34: def add_stock(code: str, name: str = "", note: str = "", group: str = "默认"):
 35:     """本地新增一只自选股"""
 36:     data = read_local()
 37:     stocks = data["stocks"]
 38:     # 去重
 39:     for s in stocks:
 40:         if s["code"] == code:
 41:             s["name"] = name or s.get("name", "")
 42:             s["note"] = note or s.get("note", "")
 43:             s["group"] = group or s.get("group", "默认")
 44:             write_local(data)
 45:             return
 46:     stocks.append({"code": code, "name": name, "note": note, "group": group})
 47:     write_local(data)
 48: def remove_stock(code: str):
 49:     """本地删除一只自选股"""
 50:     data = read_local()
 51:     data["stocks"] = [s for s in data["stocks"] if s["code"] != code]
 52:     write_local(data)
 53: def update_stock(code: str, **kwargs):
 54:     """本地更新一只自选股字段"""
 55:     data = read_local()
 56:     for s in data["stocks"]:
 57:         if s["code"] == code:
 58:             for k, v in kwargs.items():
 59:                 if v is not None:
 60:                     s[k] = v
 61:             break
 62:     write_local(data)
 63: def get_stock_codes() -> list:
 64:     """获取所有自选股代码列表"""
 65:     data = read_local()
 66:     return [s["code"] for s in data["stocks"]]
 67: def sync_to_db():
 68:     """将本地 JSON 同步到 PostgreSQL Watchlist 表（启动时调用）"""
 69:     from db.session import get_db_session
 70:     from db.models import Watchlist
 71:     data = read_local()
 72:     stocks = data.get("stocks", [])
 73:     if not stocks:
 74:         logger.info("[watchlist_local] JSON 为空，跳过 DB 同步")
 75:         return
 76:     with get_db_session() as db:
 77:         existing_map = {}
 78:         for item in db.query(Watchlist).all():
 79:             existing_map[item.stock_code] = item
 80:         added, updated = 0, 0
 81:         for s in stocks:
 82:             code = s["code"]
 83:             name = s.get("name", "")
 84:             note = s.get("note", "")
 85:             group = s.get("group", "默认")
 86:             if code in existing_map:
 87:                 item = existing_map[code]
 88:                 changed = False
 89:                 if name and item.stock_name != name:
 90:                     item.stock_name = name
 91:                     changed = True
 92:                 if note and item.note != note:
 93:                     item.note = note
 94:                     changed = True
 95:                 if group and item.group_name != group:
 96:                     item.group_name = group
 97:                     changed = True
 98:                 if changed:
 99:                     updated += 1
100:             else:
101:                 db.add(Watchlist(
102:                     stock_code=code,
103:                     stock_name=name,
104:                     note=note,
105:                     group_name=group,
106:                 ))
107:                 added += 1
108:         # 删除 DB 中有但 JSON 中没有的股票
109:         json_codes = {s["code"] for s in stocks}
110:         removed = 0
111:         for code, item in existing_map.items():
112:             if code not in json_codes:
113:                 db.delete(item)
114:                 removed += 1
115:         db.commit()
116:         logger.info(f"[watchlist_local] JSON→DB 同步完成: +{added} ~{updated} -{removed}")
</file>

<file path="backend/api/watchlist/watchlist_sync.py">
 1: """watchlist 实时资金流采集触发 API（拆分自 core.py）
 2: 原 watchlist/core.py 末尾的 collection trigger 三件套：
 3:   - POST /api/watchlist/realtime-flow/trigger
 4:   - GET  /api/watchlist/realtime-flow/trigger/status
 5:   - GET  /api/watchlist/market-capital-ranking
 6: 将它们抽到本模块以降低 core.py 体积（1213 行 → ~1100 行），并按职责分组：
 7: core.py 负责 CRUD / 列表 / 标签 / 信号；sync.py 负责外部触发采集与进度上报。
 8: """
 9: import threading
10: import logging
11: from datetime import datetime
12: from fastapi import APIRouter, Query
13: from db.session import get_db_session
14: from db.models import Watchlist
15: logger = logging.getLogger(__name__)
16: router = APIRouter()
17: # ===== 手动触发实时资金流采集（带进度，后台线程不阻塞请求）=====
18: _COLLECT_STATE = {
19:     "running": False,
20:     "done": 0,
21:     "total": 0,
22:     "started_at": None,
23:     "finished_at": None,
24:     "last_error": None,
25: }
26: def _run_collection_job():
27:     """后台线程：采集全部自选股实时资金流，并上报进度。"""
28:     from collectors.emdatah5_collector import batch_save_realtime
29:     try:
30:         with get_db_session() as db:
31:             codes = [r.stock_code for r in db.query(Watchlist).all() if r.stock_code]
32:         _COLLECT_STATE["total"] = len(codes)
33:         _COLLECT_STATE["done"] = 0
34:         def _on_progress(done, total):
35:             _COLLECT_STATE["done"] = done
36:         batch_save_realtime(codes, on_progress=_on_progress)
37:     except Exception as e:
38:         _COLLECT_STATE["last_error"] = str(e)
39:         logger.error(f"[trigger] 手动采集异常: {e}", exc_info=True)
40:     finally:
41:         _COLLECT_STATE["running"] = False
42:         _COLLECT_STATE["finished_at"] = datetime.now().isoformat()
43: @router.post("/api/watchlist/realtime-flow/trigger")
44: async def trigger_realtime_collection():
45:     """立即触发一次全量自选股实时资金流采集（后台异步，约 60-90s）。"""
46:     if _COLLECT_STATE["running"]:
47:         return {
48:             "status": "running",
49:             "done": _COLLECT_STATE["done"],
50:             "total": _COLLECT_STATE["total"],
51:             "started_at": _COLLECT_STATE["started_at"],
52:         }
53:     # 先取总数，让前端立即知道进度上限
54:     try:
55:         with get_db_session() as db:
56:             _COLLECT_STATE["total"] = db.query(Watchlist).count()
57:     except Exception:
58:         _COLLECT_STATE["total"] = 0
59:     _COLLECT_STATE["running"] = True
60:     _COLLECT_STATE["started_at"] = datetime.now().isoformat()
61:     _COLLECT_STATE["finished_at"] = None
62:     _COLLECT_STATE["last_error"] = None
63:     _COLLECT_STATE["done"] = 0
64:     t = threading.Thread(target=_run_collection_job, daemon=True)
65:     t.start()
66:     return {"status": "started", "total": _COLLECT_STATE["total"]}
67: @router.get("/api/watchlist/realtime-flow/trigger/status")
68: async def trigger_collection_status():
69:     """查询手动采集进度。"""
70:     return {
71:         "running": _COLLECT_STATE["running"],
72:         "done": _COLLECT_STATE["done"],
73:         "total": _COLLECT_STATE["total"],
74:         "started_at": _COLLECT_STATE["started_at"],
75:         "finished_at": _COLLECT_STATE["finished_at"],
76:         "last_error": _COLLECT_STATE["last_error"],
77:     }
78: @router.get("/api/watchlist/market-capital-ranking")
79: async def market_capital_ranking(
80:     rtype: str = Query("inflow", description="inflow=主力净流入前N, outflow=主力净流出前N"),
81:     top: int = Query(100, description="返回条数(10-200)"),
82: ):
83:     """全市场资金流排行（东财批量排行榜接口，1 次请求，轻量）。"""
84:     from collectors.emdatah5_collector import fetch_market_capital_ranking
85:     rank_type = "outflow" if str(rtype).lower() == "outflow" else "inflow"
86:     top_n = max(10, min(200, int(top)))
87:     return fetch_market_capital_ranking(rank_type=rank_type, top_n=top_n)
