 809: def _parse_integrated_rate(rate_data: Dict[str, Any]) -> Dict[str, Any]:
 810:     """
 811:     解析基金费率信息，将多行整合为一行。
 812:     返回包含年管理费、年托管费、年销售服务费、认购费率、申购费率、赎回费率的字典。
 813:     """
 814:     result = {
 815:         "年管理费": "",
 816:         "年托管费": "",
 817:         "年销售服务费": "",
 818:         "认购费率": "",
 819:         "申购费率": "",
 820:         "赎回费率": "",
 821:     }
 822:     if not rate_data:
 823:         return result
 824:     data_list = rate_data.get("data", [])
 825:     if not data_list:
 826:         return result
 827:     # 获取年费率信息
 828:     fees_list = data_list[0].get("fees", [])
 829:     if fees_list and len(fees_list) > 0:
 830:         year_rates = fees_list[0]
 831:         result["年管理费"] = year_rates.get("managementfee", "")
 832:         result["年托管费"] = year_rates.get("storefee", "")
 833:         result["年销售服务费"] = year_rates.get("servicefee", "") or ""
 834:     # 按费率类别分组
 835:     rates_by_type = {"1": [], "2": [], "6": []}  # 认购、申购、赎回
 836:     for item in data_list:
 837:         rates_list = item.get("rates", [])
 838:         for rate_item in rates_list:
 839:             feetype = rate_item.get("feetype", "")
 840:             feerange = rate_item.get("feerange", "")
 841:             freeratedesc = rate_item.get("freeratedesc", "")
 842:             ratefreedesc = rate_item.get("ratefreedesc", "")
 843:             if feetype in rates_by_type:
 844:                 # 格式：适用范围 基准费率描述(折后：折后费率描述)
 845:                 if freeratedesc and ratefreedesc and freeratedesc != ratefreedesc:
 846:                     fee_desc = f"{feerange} {freeratedesc}(折后：{ratefreedesc})"
 847:                 else:
 848:                     fee_desc = f"{feerange} {freeratedesc}"
 849:                 rates_by_type[feetype].append(fee_desc)
 850:     # 整合费率信息
 851:     if rates_by_type["1"]:  # 认购费率
 852:         result["认购费率"] = "\n".join(rates_by_type["1"])
 853:     if rates_by_type["2"]:  # 申购费率
 854:         result["申购费率"] = "\n".join(rates_by_type["2"])
 855:     if rates_by_type["6"]:  # 赎回费率
 856:         result["赎回费率"] = "\n".join(rates_by_type["6"])
 857:     return result
