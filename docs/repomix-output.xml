<file path="frontend/src/components/trading/TrackButton.jsx">
 1: import { useState, useEffect } from 'react';
 2: import { apiFetch } from '../../utils/request';
 3: import { stripCode } from '../../utils/format';
 4: /**
 5:  * 全局跟踪列表缓存（避免 N 个 TrackButton 发 N 次相同请求）
 6:  */
 7: let _trackerCache = null;
 8: let _trackerCachePromise = null;
 9: async function getTrackerList() {
10:   if (_trackerCache) return _trackerCache;
11:   if (_trackerCachePromise) return _trackerCachePromise;
12:   _trackerCachePromise = (async () => {
13:     try {
14:       const { ok, data } = await apiFetch('/api/stock-tracker');
15:       if (ok && Array.isArray(data)) {
16:         _trackerCache = data;
17:       }
18:     } catch (e) { /* silent */ }
19:     _trackerCachePromise = null;
20:     return _trackerCache || [];
21:   })();
22:   return _trackerCachePromise;
23: }
24: /** 缓存 60 秒后自动失效 */
25: setInterval(() => { _trackerCache = null; }, 60000);
26: /**
27:  * 个股跟踪按键：悬浮在任意股票位置，一键加入/查看跟踪
28:  * - 首次渲染时检查该股是否已在跟踪列表（全局缓存，避免重复请求）
29:  * - 显示"📈 跟踪"或"✓ 已跟踪"
30:  * - 支持 size 属性（xs/sm/md），默认 sm
31:  */
32: export default function TrackButton({ stockCode, stockName, size = 'sm', className = '' }) {
33:   const [tracked, setTracked] = useState(false);
34:   const [loading, setLoading] = useState(false);
35:   const [err, setErr] = useState('');
36:   const code = stripCode(stockCode);
37:   const sizeClass = size === 'xs'
38:     ? 'px-1.5 py-0 text-[10px] h-5'
39:     : size === 'md'
40:     ? 'px-2.5 py-1 text-xs h-7'
41:     : 'px-2 py-0.5 text-xs h-6';
42:   useEffect(() => {
43:     if (!code) return;
44:     (async () => {
45:       try {
46:         const list = await getTrackerList();
47:         if (Array.isArray(list)) {
48:           const found = list.find(s => String(s.stock_code) === code);
49:           if (found) setTracked(true);
50:         }
51:       } catch (e) { /* silent */ }
52:     })();
53:   }, [code]);
54:   const handleToggle = async (e) => {
55:     e.stopPropagation();
56:     e.preventDefault();
57:     if (loading) return;
58:     if (tracked) return;
59:     setLoading(true);
60:     setErr('');
61:     try {
62:       const { ok, error } = await apiFetch('/api/stock-tracker', {
63:         method: 'POST',
64:         body: JSON.stringify({ stock_code: code, stock_name: stockName || code }),
65:       });
66:       if (ok) {
67:         setTracked(true);
68:         // 更新缓存
69:         _trackerCache = null;
70:       } else {
71:         if (error && error.includes('已在跟踪列表')) setTracked(true);
72:         else setErr(error || '失败');
73:       }
74:     } catch (e) { setErr('网络错误'); }
75:     setLoading(false);
76:   };
77:   if (!code) return null;
78:   return (
79:     <span
80:       onClick={handleToggle}
81:       title={tracked ? '已在跟踪列表中' : (err || '加入股票跟踪')}
82:       className={`inline-flex items-center gap-0.5 ${sizeClass} rounded font-medium cursor-pointer transition-all select-none ${className}`}
83:       style={tracked
84:         ? { background: 'rgba(34,197,94,0.12)', color: '#22c55e', border: '1px solid rgba(34,197,94,0.3)' }
85:         : { background: 'rgba(234,179,8,0.1)', color: '#eab308', border: '1px solid rgba(234,179,8,0.3)' }
86:       }
87:     >
88:       {loading ? '...' : tracked ? '✓' : '📈'}
89:       {tracked ? ' 已跟踪' : ' 跟踪'}
90:     </span>
91:   );
92: }
</file>

