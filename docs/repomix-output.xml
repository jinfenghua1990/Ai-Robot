<file path="frontend/src/components/sections/RealtimeConceptSectorSection.jsx">
 1: import { useMemo } from 'react';
 2: import ConceptRealtimeTrendChart from '../charts/ConceptRealtimeTrendChart';
 3: /**
 4:  * 实时概念板块资金流向 — 使用 RealtimeConceptSectorFlow 快照数据
 5:  * 盘中每 15 分钟采集一次，展示分时累计走势
 6:  */
 7: export default function RealtimeConceptSectorSection({ rtConceptSectors, sectors, selectedSector, onSelectSector }) {
 8:   // 只展示父组件选中的概念，按净流入降序
 9:   const trendSectors = useMemo(() => {
10:     const selectedSet = new Set(sectors || []);
11:     const concepts = (rtConceptSectors?.sectors || []).filter(s => selectedSet.has(s.sector));
12:     return [...concepts].sort((a, b) => b.net_flow - a.net_flow).map(d => d.sector);
13:   }, [rtConceptSectors, sectors]);
14:   // 判断当前快照是否在交易时段（必须在所有 early return 之前调用）
15:   const snapshotTime = rtConceptSectors?.snapshot_time;
16:   const isTradingHours = useMemo(() => {
17:     if (!snapshotTime) return false;
18:     const t = snapshotTime.slice(11, 16);
19:     return (t >= '09:30' && t <= '11:30') || (t >= '13:00' && t <= '15:00');
20:   }, [snapshotTime]);
21:   if (!rtConceptSectors?.trade_date) {
22:     return (
23:       <div className="flex items-center justify-center h-full text-sm" style={{ color: 'var(--text-muted)' }}>
24:         暂无实时概念板块快照
25:       </div>
26:     );
27:   }
28:   if (trendSectors.length === 0) {
29:     return (
30:       <div className="flex items-center justify-center h-full text-sm" style={{ color: 'var(--text-muted)' }}>
31:         请在右上方「筛选概念」中选择概念板块
32:       </div>
33:     );
34:   }
35:   return (
36:     <div className="h-full flex flex-col">
37:       <div className="flex items-center justify-between mb-1 px-1 shrink-0">
38:         <span className="text-[10px]" style={{ color: 'var(--text-muted)' }}>
39:           概念板块 · 快照: {snapshotTime || '—'}
40:           {!isTradingHours && (
41:             <span className="ml-2 px-1.5 py-0.5 rounded text-[10px]" style={{ background: 'rgba(234,179,8,0.15)', color: '#eab308' }}>
42:               非交易时段 · 仅最新收盘快照
43:             </span>
44:           )}
45:         </span>
46:       </div>
47:       <div className="flex-1 min-h-0">
48:         <ConceptRealtimeTrendChart
49:           sectors={trendSectors}
50:           rtSectors={rtConceptSectors}
51:           selectedSector={selectedSector}
52:           onSectorClick={onSelectSector}
53:           height="100%"
54:           maxLines={500}
55:           trendApiPath="/api/realtime/concept-sector-trend"
56:           bulkTrendApiPath="/api/realtime/concept-sector-trends"
57:         />
58:       </div>
59:     </div>
60:   );
61: }
</file>

