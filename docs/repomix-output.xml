  5: from datetime import datetime, date, timedelta
  6: import re
  7: def stock_code_to_sina(stock_code: str) -> str:
  8:     """6位股票代码转新浪格式: 600519 -> sh600519, 000001 -> sz000001, 430047 -> bj430047"""
  9:     if not stock_code:
 10:         return ''
 11:     code = stock_code.strip()
 12:     if code.startswith(('sh', 'sz', 'bj')):
 13:         return code
 14:     if len(code) != 6:
 15:         return ''
 16:     if code[0] in ('6', '9'):
 17:         return f'sh{code}'
 18:     if code[0] in ('4', '8'):
 19:         return f'bj{code}'
 20:     return f'sz{code}'
 21: def stock_code_to_ts_code(stock_code: str) -> str:
 22:     """6位 → ts_code (600519 -> 600519.SH)"""
 23:     if not stock_code or len(stock_code) != 6:
 24:         return stock_code
 25:     if stock_code[0] in ('6', '9'):
 26:         return f'{stock_code}.SH'
 27:     return f'{stock_code}.SZ'
 28: def ts_code_to_stock_code(ts_code: str) -> str:
 29:     """ts_code → 6位 (600519.SH -> 600519)"""
 30:     if not ts_code:
 31:         return ''
 32:     return ts_code.split('.')[0]
 33: def parse_ts_code(ts_code: str) -> tuple:
 34:     """ts_code → (6位, 交易所)"""
 35:     if not ts_code or '.' not in ts_code:
 36:         return (ts_code, '')
 37:     code, exchange = ts_code.split('.', 1)
 38:     return (code, exchange)
 39: def normalize_stock_code(stock_code: str) -> str:
 40:     """任意格式 → 6位股票代码"""
 41:     if not stock_code:
 42:         return ''
