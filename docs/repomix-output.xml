597: def scheduled_freshness_check():
598:     """每日早间新鲜度自检：落后则告警+补采"""
599:     today = datetime.now().date()
600:     with get_db_session() as db:
601:         expected = _previous_complete_market_day(db)
602:         if not expected:
603:             logger.info('[freshness] 无基准交易日，跳过自检')
604:             return
605:         if expected >= today:
606:             logger.info(f'[freshness] 基准日 {expected} 不早于今日，跳过（可能尚在当日盘前）')
607:             return
608:         stale = []
609:         _allowed_tables = {t for t, _ in _DAILY_FRESHNESS_TABLES}
610:         _allowed_cols = {c for _, c in _DAILY_FRESHNESS_TABLES}
611:         for tbl, col in _DAILY_FRESHNESS_TABLES:
612:             try:
613:                 if tbl not in _allowed_tables or col not in _allowed_cols:
614:                     raise ValueError(f"table/column not in whitelist: {tbl}.{col}")
615:                 latest = db.execute(text(f"SELECT max({col})::date FROM {tbl}")).scalar()
616:             except Exception as e:
617:                 logger.warning(f'[freshness] 查询 {tbl} 失败: {e}')
618:                 continue
619:             if latest is None or latest < expected:
620:                 gap = (expected - latest).days if latest else '?'
621:                 record_alert(
622:                     level='error', category='data_stale',
623:                     message=f'[{expected}] {tbl} 数据滞后：最新 {latest}，期望 {expected}（落后 {gap} 天）',
624:                     trade_date=expected,
625:                 )
626:                 stale.append(tbl)
627:                 logger.warning(f'[freshness] {tbl} 滞后（最新 {latest} / 期望 {expected}）')
628:         # 概念板块资金流缺失补采
629:         try:
630:             cf_latest = db.execute(text("SELECT max(trade_date) FROM concept_sector_flow")).scalar()
631:             if cf_latest is None or cf_latest < expected:
632:                 logger.info(f'[freshness] 触发 concept_sector_flow 补采 -> {expected}')
633:                 _compute_concept_sector_flow(expected.isoformat())
634:         except Exception as e:
635:             logger.error(f'[freshness] concept 补采失败: {e}', exc_info=True)
636:         # 研究层缺失补采（依赖外部 scheduler.add_job，避免在 with 块中嵌套调度）
637:         try:
638:             ai_latest = db.execute(text("SELECT max(created_at)::date FROM ai_analysis_cache")).scalar()
639:             if ai_latest is None or ai_latest < expected:
640:                 logger.info(f'[freshness] 触发研究采集补采 -> {expected}')
641:                 from collectors.research_collector import run_research_collection
642:                 # 注意：依赖 scheduler 实例，从 collectors.scheduler 导入
643:                 from collectors.scheduler import scheduler
644:                 scheduler.add_job(
645:                     run_research_collection, 'date',
646:                     run_date=datetime.now() + timedelta(minutes=1),
647:                     id='freshness_research_backfill', replace_existing=True,
648:                 )
649:         except Exception as e:
650:             logger.error(f'[freshness] 研究补采调度失败: {e}', exc_info=True)
651:     logger.info('[freshness] 自检完成')
