 75:         if level:
 76:             q = q.filter(DataCollectionAlert.level == level)
 77:         if category:
 78:             q = q.filter(DataCollectionAlert.category == category)
 79:         rows = q.order_by(DataCollectionAlert.created_at.desc()).limit(limit).all()
 80:         return [
 81:             {
