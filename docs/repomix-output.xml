 1: """同步包：本地自选股 ↔ 同花顺/妙想/新浪 三向同步
 2: 将原 backend/api/external_sync.py（776行）拆为：
 3: - ths.py        同花顺 cookie 提取 + 云端 API + sync_from/sync_to
 4: - mx.py         妙想云端 sync_from/sync_to
 5: - dispatcher.py 防抖触发（本地变化→推送/删除云端）
 6: - api.py        REST 端点 /api/sync/*
 7: """
 8: from fastapi import APIRouter
 9: import api.sync_pkg.ths  # noqa: F401  加载 router
10: import api.sync_pkg.mx  # noqa: F401
11: import api.sync_pkg.dispatcher  # noqa: F401
12: from .api import router as api_router
13: router = APIRouter()
14: router.include_router(api_router)
15: def trigger_cloud_sync(reason: str = "watchlist change"):
16:     """本地自选股变化后调用：防抖 3 秒后推送到所有云端。
17:     重新导出供 api/watchlist/core.py 调用。
18:     """
19:     from .dispatcher import trigger_cloud_sync as _impl
20:     return _impl(reason)
21: def trigger_cloud_delete(code: str, name: str = ""):
22:     """本地删除自选股后调用：防抖 3 秒后从所有云端删除。
23:     重新导出供 api/watchlist/core.py 调用。
24:     """
25:     from .dispatcher import trigger_cloud_delete as _impl
26:     return _impl(code, name)
27: async def full_sync(mirror_push: bool = True) -> dict:
28:     """全量双向同步（供 collector/scheduler.py 调用）"""
29:     from .dispatcher import full_sync as _impl
30:     return await _impl(mirror_push)
31: __all__ = ["router", "trigger_cloud_sync", "trigger_cloud_delete", "full_sync"]
