489:             prior_uptrend = bool(ema10 and ema20 and ma50 and ema10 > ema20 > ma50)
490:             pullback_pct = None
491:             if len(closes) >= 10:
492:                 peak = max(closes[-10:])
493:                 pullback_pct = (peak - price) / peak * 100
494:             ps = score_pullback(
495:                 price=price, ema10=ema10, ema20=ema20, ma50=ma50,
496:                 prior_uptrend=prior_uptrend, first_pullback=True,
497:                 pullback_pct=pullback_pct, volume_contracted=True,
