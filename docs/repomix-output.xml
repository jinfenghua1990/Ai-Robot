 91:  */
 92: function buildSparkline(history) {
 93:   if (!history || history.length < 2) return null;
 94:   const W = 280, H = 48, PAD = 4;
 95:   const wins = history.map(h => h.win_rate || 0).reverse();   // 老到新
 96:   const profits = history.map(h => h.total_profit_pct || 0).reverse();
 97:   const buildLine = (data, min, max) => {
 98:     const range = Math.max(max - min, 1);
 99:     const stepX = (W - PAD * 2) / (data.length - 1);
100:     const pts = data.map((v, i) => ({
101:       x: PAD + i * stepX,
102:       y: H - PAD - ((v - min) / range) * (H - PAD * 2),
103:     }));
104:     const line = pts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
105:     const area = `${line} L${pts[pts.length - 1].x.toFixed(1)},${H} L${pts[0].x.toFixed(1)},${H} Z`;
106:     return { line, area, dots: pts };
107:   };
108:   const all = [...wins, ...profits];
109:   const min = Math.min(...all);
110:   const max = Math.max(...all);
111:   return {
112:     win: buildLine(wins, min, max),
113:     profit: buildLine(profits, min, max),
114:   };
115: }
</file>

