224: def trigger_auto_review():
225:     """手动触发自动审核（处理pending状态的审核记录）"""
226:     import sys, os, statistics, json
227:     from datetime import datetime
228:     sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
229:     from db.models import ManualReviewQueue
230:     try:
231:         with get_db_session() as db:
232:             reviews = db.query(ManualReviewQueue).filter_by(status='pending').all()
233:             auto_passed = 0
234:             kept_manual = 0
235:             for r in reviews:
236:                 raw = json.loads(r.sources_data) if r.sources_data else {}
237:                 values = {}
238:                 for k, v in raw.items():
239:                     val = v.get('value') if isinstance(v, dict) else v
240:                     if val is not None:
241:                         values[k] = float(val)
242:                 vals = list(values.values())
243:                 if not vals:
244:                     kept_manual += 1
245:                     continue
246:                 median = statistics.median(vals)
247:                 mean = statistics.mean(vals)
248:                 std = statistics.stdev(vals) if len(vals) > 1 else 0
249:                 cv = (std / abs(mean) * 100) if mean else 0
250:                 if cv <= 5.0:
251:                     r.status = 'approved'
252:                     r.final_value = statistics.mean(vals)
253:                     r.reviewed_by = 'auto_review'
254:                     r.reviewed_at = datetime.now()
255:                     r.reason = f'[自动审核·高置信度] CV={cv:.1f}%≤5%，取平均值'
256:                     auto_passed += 1
257:                 elif cv <= 15.0:
258:                     r.status = 'approved'
259:                     r.final_value = median
260:                     r.reviewed_by = 'auto_review'
261:                     r.reviewed_at = datetime.now()
262:                     r.reason = f'[自动审核·中置信度] CV={cv:.1f}%≤15%，取中位数'
263:                     auto_passed += 1
264:                 else:
265:                     kept_manual += 1
266:             db.commit()
267:             return {"auto_passed": auto_passed, "kept_manual": kept_manual, "total": len(reviews)}
268:     except Exception as e:
