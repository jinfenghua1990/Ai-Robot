 1: from __future__ import annotations
 2: from datetime import date
 3: from typing import Mapping, Sequence
 4: from .contracts import DailyBar, MarketContext
 5: from .pipeline import QuantPipeline
 6: from .research import forward_return
 7: def _market(history: Mapping[str, Sequence[DailyBar]], trade_date: date) -> MarketContext:
 8:     latest = [bars[-1].pct_chg for bars in history.values() if bars and bars[-1].trade_date == trade_date]
 9:     return MarketContext(trade_date, sum(x > 0 for x in latest) / len(latest) if latest else 0.0)
10: def _forward_excursion(bars: Sequence[DailyBar], horizon: int) -> dict[str, float | None]:
11:     """Measure post-signal path risk using only the next ``horizon`` bars.
12:     ``max_profit`` and ``max_loss`` are intraperiod excursions from the
13:     signal-day close.  ``max_drawdown`` is the worst fall from a running high
14:     in that same forward window, represented as a negative return.
15:     """
16:     window = list(bars[:horizon + 1])
17:     if not window or not window[0].close:
18:         return {"max_profit": None, "max_loss": None, "max_drawdown": None}
19:     entry = float(window[0].close)
20:     highs = [float(bar.high or bar.close) for bar in window]
21:     lows = [float(bar.low or bar.close) for bar in window]
22:     max_profit = max(high / entry - 1 for high in highs)
23:     max_loss = min(low / entry - 1 for low in lows)
24:     running_high = highs[0]
25:     max_drawdown = 0.0
26:     for high, low in zip(highs, lows):
27:         running_high = max(running_high, high)
28:         max_drawdown = min(max_drawdown, low / running_high - 1 if running_high else 0.0)
29:     return {
30:         "max_profit": max_profit,
31:         "max_loss": max_loss,
32:         "max_drawdown": max_drawdown,
33:     }
34: def walk_forward(history: Mapping[str, Sequence[DailyBar]], dates: Sequence[date], horizons=(1, 3, 5, 10, 20), include_records: bool = False) -> dict:
35:     """严格按日期截断历史，避免把未来 K 线带入信号。"""
36:     pipeline = QuantPipeline()
37:     outcomes = []
38:     max_horizon = max(horizons)
39:     for trade_date in sorted(set(dates)):
40:         visible = {
41:             code: [bar for bar in bars if bar.trade_date <= trade_date]
42:             for code, bars in history.items()
43:         }
44:         visible = {code: bars for code, bars in visible.items() if bars and bars[-1].trade_date == trade_date}
45:         if not visible:
46:             continue
47:         snapshots = pipeline.run(visible, trade_date, _market(visible, trade_date))
48:         for snapshot in snapshots:
49:             bars = history[snapshot.ts_code]
50:             future_bars = [bar for bar in bars if bar.trade_date >= trade_date]
51:             closes = [bar.close for bar in future_bars]
52:             outcome = {str(h): forward_return(closes, h) for h in horizons}
53:             excursions = {str(h): _forward_excursion(future_bars, h) for h in horizons}
54:             if any(value is not None for value in outcome.values()):
55:                 outcomes.append({"snapshot": snapshot, "outcome": outcome, "excursions": excursions})
56:     summary = {}
57:     for horizon in horizons:
58:         values = [item["outcome"][str(horizon)] for item in outcomes if item["outcome"][str(horizon)] is not None]
59:         excursions = [
60:             item["excursions"][str(horizon)]
61:             for item in outcomes
62:             if item["outcome"][str(horizon)] is not None
63:         ]
64:         summary[str(horizon)] = {
65:             "count": len(values),
66:             "mean": sum(values) / len(values) if values else None,
67:             "win_rate": sum(value > 0 for value in values) / len(values) if values else None,
68:             "max_profit": max(values) if values else None,
69:             "max_loss": min(values) if values else None,
70:             "max_favorable_excursion": max(
71:                 (item["max_profit"] for item in excursions if item["max_profit"] is not None),
72:                 default=None,
73:             ),
74:             "max_adverse_excursion": min(
75:                 (item["max_loss"] for item in excursions if item["max_loss"] is not None),
76:                 default=None,
77:             ),
78:             "max_drawdown": min(
79:                 (item["max_drawdown"] for item in excursions if item["max_drawdown"] is not None),
80:                 default=None,
81:             ),
82:         }
83:     result = {"sample_count": len(outcomes), "horizons": summary}
84:     if include_records:
85:         record_horizon = str(max(horizons))
86:         result["records"] = [
87:             {
88:                 "ts_code": item["snapshot"].ts_code,
89:                 "signal_date": item["snapshot"].trade_date,
90:                 "trading_state": item["snapshot"].trading_state,
91:                 "returns": item["outcome"],
92:                 **item["excursions"].get(record_horizon, {}),
93:             }
94:             for item in outcomes
95:         ]
96:     return result
