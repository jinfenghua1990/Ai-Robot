 46:         price_sources = {'eastmoney': {'value': price}}
 47:         if ts_code in tencent_prices:
 48:             price_sources['tencent'] = {'value': tencent_prices[ts_code].get('price')}
 49:         price_result = cross_validate(
 50:             ts_code=ts_code, name=name, indicator='price',
 51:             sources_data=price_sources, snapshot_time=snapshot_time,
 52:             trade_date=trade_date,
 53:         )
 54:         authority_price = price_result['authority_value'] if price_result['authority_value'] is not None else price
 55:         # 写入历史表
 56:         db.add(StockFlow(
 57:             trade_date=trade_date, ts_code=ts_code, name=name,
 58:             sector=s.get('sector', ''), net_inflow=main_flow,
 59:             main_force_inflow=main_flow, retail_flow=float(s.get('retail_flow', 0) or 0),
 60:             price_chg=price_chg, price=authority_price,
