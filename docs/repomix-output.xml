<file path="frontend/src/components/sections/AfterConceptSectorFlowSection.jsx">
  1: import { useState, useEffect, useMemo, useRef } from 'react';
  2: import ReactECharts from 'echarts-for-react/lib/core';
  3: import echarts from '../../lib/echarts';
  4: import { tooltipStyle } from '../../utils/chartConfig';
  5: import { apiFetch } from '../../utils/request';
  6: import { getSectorColorHex } from '../../utils/sectorColors';
  7: import ChartLabelLayer from '../charts/ChartLabelLayer';
