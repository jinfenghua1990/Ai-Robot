 43:     if not strategies_json:
 44:         return []
 45:     try:
 46:         return json.loads(strategies_json)
 47:     except Exception:
 48:         return []
 49: def _serialize_daily(d):
 50:     """序列化一条 StrategyTrackDaily"""
 51:     return {
 52:         "id": d.id,
 53:         "tracker_id": d.tracker_id,
 54:         "trade_date": _d(d.trade_date),
 55:         "day_n": d.day_n,
 56:         "open": _f(d.open),
