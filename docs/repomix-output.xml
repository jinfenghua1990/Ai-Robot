  1: """港股/美股策略扫描 API
  2: - GET /api/hk-strategy/list              获取所有策略
  3: - POST /api/hk-strategy/strategies       保存策略
  4: - DELETE /api/hk-strategy/strategies/{id}  删除策略
  5: - POST /api/hk-strategy/scan             执行策略扫描
  6: 策略维度（基于 watchlist-enhanced 已有的技术指标）：
  7: - signal_type: B（买入信号）/ S（卖出信号）
  8: - change_pct: 当日涨跌幅
  9: - deviation: 偏离 MA20 度数
 10: - rsi: RSI(14)
 11: - change5d / change20d: 区间涨跌幅
 12: - volume_filter: 成交量放大
 13: - ma20_support: MA20 支撑（价格在 MA20 ±2% 内）
 14: - trend: 趋势方向（多头排列/空头排列）
 15: """
 16: import logging
 17: from datetime import datetime
 18: from typing import Any, Optional
 19: from fastapi import APIRouter, HTTPException, Query
 20: from pydantic import BaseModel
 21: from db.session import get_db_session
 22: from db.models import BSStrategy
 23: from .global_market import DEFAULT_WATCHLIST, _fetch_enhanced_for_stock
 24: from concurrent.futures import ThreadPoolExecutor, as_completed
 25: logger = logging.getLogger(__name__)
 26: router = APIRouter()
 27: # ─── 策略规则定义（可扩展）─────────────────────────────────────────────────────
 28: # 每条规则是一个字典：{key, name, desc, test(item) -> bool}
 29: def _rule_deviation_revert(item):
 30:     """回踩 MA20：价格在 MA20 ±2% 内（潜在反弹/反转点）"""
 31:     d = item.get("deviation")
 32:     return d is not None and abs(d) <= 2
 33: def _rule_rsi_oversold(item):
 34:     """RSI 超卖：RSI(14) ≤ 30"""
 35:     r = item.get("rsi")
 36:     return r is not None and r <= 30
 37: def _rule_rsi_overbought(item):
 38:     """RSI 超买：RSI(14) ≥ 70"""
 39:     r = item.get("rsi")
 40:     return r is not None and r >= 70
 41: def _rule_bull_align(item):
 42:     """多头排列：MA5 > MA10 > MA20 且价格 > MA5"""
 43:     ma5, ma10, ma20, price = item.get("ma5"), item.get("ma10"), item.get("ma20"), item.get("price")
 44:     if not all(v is not None for v in [ma5, ma10, ma20, price]):
 45:         return False
 46:     return ma5 > ma10 > ma20 and price > ma5
 47: def _rule_bear_align(item):
 48:     """空头排列：MA5 < MA10 < MA20 且价格 < MA5"""
 49:     ma5, ma10, ma20, price = item.get("ma5"), item.get("ma10"), item.get("ma20"), item.get("price")
 50:     if not all(v is not None for v in [ma5, ma10, ma20, price]):
 51:         return False
 52:     return ma5 < ma10 < ma20 and price < ma5
 53: def _rule_5d_pullback(item):
 54:     """5 日回调：5 日跌幅 ≤ -3%（超跌反弹机会）"""
 55:     c = item.get("change5d")
 56:     return c is not None and c <= -3
 57: def _rule_5d_breakout(item):
 58:     """5 日突破：5 日涨幅 ≥ 5%（动量延续）"""
 59:     c = item.get("change5d")
 60:     return c is not None and c >= 5
 61: def _rule_20d_uptrend(item):
 62:     """20 日上行：20 日涨幅 ≥ 8%"""
 63:     c = item.get("change20d")
 64:     return c is not None and c >= 8
 65: def _rule_20d_downtrend(item):
 66:     """20 日下行：20 日跌幅 ≤ -8%"""
 67:     c = item.get("change20d")
 68:     return c is not None and c <= -8
 69: def _rule_volume_active(item):
 70:     """成交活跃：成交量 > 100M（流动性充足）"""
 71:     v = item.get("volume")
 72:     return v is not None and v >= 100_000_000
 73: # 策略规则注册表
 74: RULES = [
 75:     {"key": "deviation_revert", "name": "回踩MA20", "desc": "价格在 MA20 ±2% 内（潜在反弹/反转点）", "test": _rule_deviation_revert, "signal": "B"},
 76:     {"key": "rsi_oversold", "name": "RSI超卖", "desc": "RSI(14) ≤ 30，超卖反弹机会", "test": _rule_rsi_oversold, "signal": "B"},
 77:     {"key": "rsi_overbought", "name": "RSI超买", "desc": "RSI(14) ≥ 70，超买回调风险", "test": _rule_rsi_overbought, "signal": "S"},
 78:     {"key": "bull_align", "name": "多头排列", "desc": "MA5 > MA10 > MA20 且价格 > MA5", "test": _rule_bull_align, "signal": "B"},
 79:     {"key": "bear_align", "name": "空头排列", "desc": "MA5 < MA10 < MA20 且价格 < MA5", "test": _rule_bear_align, "signal": "S"},
 80:     {"key": "5d_pullback", "name": "5日超跌", "desc": "5 日跌幅 ≤ -3%，超跌反弹机会", "test": _rule_5d_pullback, "signal": "B"},
 81:     {"key": "5d_breakout", "name": "5日突破", "desc": "5 日涨幅 ≥ 5%，动量延续", "test": _rule_5d_breakout, "signal": "B"},
 82:     {"key": "20d_uptrend", "name": "20日上行", "desc": "20 日涨幅 ≥ 8%", "test": _rule_20d_uptrend, "signal": "B"},
 83:     {"key": "20d_downtrend", "name": "20日下行", "desc": "20 日跌幅 ≤ -8%", "test": _rule_20d_downtrend, "signal": "S"},
 84:     {"key": "volume_active", "name": "成交活跃", "desc": "成交量 ≥ 100M，流动性充足", "test": _rule_volume_active, "signal": "B"},
 85: ]
 86: def _scan_item(item: dict, enabled_rules: list[str], signal_type: str = "B") -> dict:
 87:     """对单只股票执行策略扫描，返回命中规则列表"""
 88:     if not item or item.get("price") is None:
 89:         return {"code": item.get("code", "?"), "name": item.get("name", "?"), "hits": [], "signal": "—"}
 90:     hits = []
 91:     for rule in RULES:
 92:         if rule["key"] not in enabled_rules:
 93:             continue
 94:         if signal_type == "B" and rule["signal"] == "S":
 95:             continue
 96:         if signal_type == "S" and rule["signal"] == "B":
 97:             continue
 98:         try:
 99:             if rule["test"](item):
100:                 hits.append({"key": rule["key"], "name": rule["name"], "signal": rule["signal"]})
101:         except Exception as e:
102:             logger.warning(f"策略规则 {rule['key']} 执行失败: {e}")
103:     # 综合信号：所有命中规则的 signal 投票
104:     if not hits:
105:         signal = "—"
106:     else:
107:         b_count = sum(1 for h in hits if h["signal"] == "B")
108:         s_count = sum(1 for h in hits if h["signal"] == "S")
109:         if b_count > s_count:
110:             signal = "B"
111:         elif s_count > b_count:
112:             signal = "S"
113:         else:
114:             signal = "—"
115:     return {"code": item["code"], "name": item["name"], "hits": hits, "signal": signal, **{k: v for k, v in item.items() if k not in ("code", "name")}}
116: class ScanRequest(BaseModel):
117:     market: str = "HK"
118:     rules: list[str] = []
119:     signal_type: str = "B"  # B / S / ALL
120: @router.get("/api/hk-strategy/rules")
121: def list_rules():
122:     """返回所有可用策略规则"""
123:     return {"rules": [{"key": r["key"], "name": r["name"], "desc": r["desc"], "signal": r["signal"]} for r in RULES]}
124: @router.post("/api/hk-strategy/scan")
125: def scan_strategies(req: ScanRequest):
126:     """执行策略扫描：基于 watchlist-enhanced 数据 + 启用的规则"""
127:     market = req.market.upper()
128:     if market not in ("HK", "US"):
129:         return {"market": market, "items": [], "error": "仅支持 HK / US"}
130:     watchlist = DEFAULT_WATCHLIST.get(market, [])
131:     if not watchlist:
132:         return {"market": market, "items": [], "total": 0, "updated_at": datetime.now().strftime("%Y/%m/%d %H:%M:%S")}
133:     # 并行拉取所有股票的技术指标数据（复用 global_market 的函数）
134:     results = [None] * len(watchlist)
135:     with ThreadPoolExecutor(max_workers=6) as pool:
136:         futures = {pool.submit(_fetch_enhanced_for_stock, market, s): i for i, s in enumerate(watchlist)}
137:         for fut in as_completed(futures):
138:             idx = futures[fut]
139:             try:
140:                 results[idx] = fut.result()
141:             except Exception as e:
142:                 results[idx] = {"code": watchlist[idx]["code"], "name": watchlist[idx]["name"], "price": None, "error": str(e)}
143:     # 执行策略扫描
144:     enabled_rules = req.rules if req.rules else [r["key"] for r in RULES]
145:     scanned = [_scan_item(item, enabled_rules, req.signal_type) for item in results]
146:     # 只返回有命中的股票
147:     hits_only = [s for s in scanned if s.get("hits")]
148:     return {
149:         "market": market,
150:         "items": hits_only,
151:         "total": len(hits_only),
152:         "scanned": len(scanned),
153:         "rules": enabled_rules,
154:         "signal_type": req.signal_type,
155:         "updated_at": datetime.now().strftime("%Y/%m/%d %H:%M:%S"),
156:     }
