112:         "volume_ratio": round(float(feat.volume_ratio), 2) if feat and feat.volume_ratio is not None else "—",
113:         "summary": _tech_summary(feat, price),
114:     }
115:     # --- 资金流 ---
116:     money_flow = _build_money_flow(flows, klines)
117:     # --- 估值（基于 PG 行情 + 尝试 F10）---
118:     valuation = {
119:         "pe_ttm": "—", "pe_percentile_5y": "—", "pb": "—",
120:         "pb_percentile_5y": "—", "peg": "—",
121:         "industry_avg_pe": "—", "industry_avg_pb": "—",
122:         "assessment": "估值字段需 F10 财务数据；当前仅含 PG 盘后市场数据。",
123:     }
124:     financials = {
125:         "eps": "—", "bps": "—", "pe": "—", "pb": "—",
126:         "total_shares": "—", "market_cap": "—",
127:         "revenue": "—", "net_profit": "—", "roe": "—", "gross_margin": "—",
128:     }
129:     institutional = {
130:         "fund_count": "—", "fund_holding_ratio": "—",
131:         "fund_change_quarter": "—", "north_bound": "—", "north_bound_5d": "—",
132:     }
133:     target_price_val = None
134:     # --- F10 免费源 enrichment（Tushare 财务/机构 + 东方财富评级，缓存 PG；优雅降级）---
135:     if f10.is_configured():
136:         fin = f10.get_financials(code)
137:         if fin:
138:             financials["revenue"] = _as_str(fin.get("revenue"))
139:             financials["net_profit"] = _as_str(fin.get("net_profit"))
140:             financials["eps"] = _as_str(fin.get("eps"))
141:             financials["roe"] = _as_str(fin.get("roe"))
142:             financials["gross_margin"] = _as_str(fin.get("gross_margin"))
143:             # TTM PE / PB 直接用 Tushare daily_basic（免费且准确）
144:             pe = fin.get("pe_ttm")
145:             pb = fin.get("pb")
146:             if pe is not None:
147:                 try:
148:                     financials["pe"] = f"{float(pe):.2f}"
149:                     valuation["pe_ttm"] = round(float(pe), 2)
150:                 except Exception:
151:                     logger.debug("target_price format failed", exc_info=False)
152:             if pb is not None:
153:                 try:
154:                     financials["pb"] = f"{float(pb):.2f}"
155:                 except Exception:
156:                     logger.debug("PB format failed", exc_info=False)
157:             valuation["assessment"] = (
158:                 f"TTM PE≈{valuation.get('pe_ttm')}，PB≈{financials.get('pb')}；"
159:                 f"ROE {_as_str(fin.get('roe'))}，毛利率 {_as_str(fin.get('gross_margin'))}（数据来源 Tushare）。"
160:             )
161:         rat = f10.get_rating(code)
162:         if rat:
163:             tp = rat.get("target_price")
164:             if tp:
165:                 try:
166:                     target_price_val = float(str(tp).replace(",", "").replace("元", "").strip())
167:                 except Exception:
