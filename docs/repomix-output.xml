  1: from __future__ import annotations
  2: import math
  3: from collections import defaultdict
  4: from datetime import date
  5: from statistics import mean, pstdev
  6: from typing import Mapping, Sequence
  7: from .contracts import DailyBar, FactorValue, MarketContext
  8: from .registry import FactorRegistry
  9: def _mean(values: Sequence[float]) -> float:
 10:     return mean(values) if values else 0.0
 11: def _return(closes: Sequence[float], period: int) -> float | None:
 12:     if len(closes) < period + 1 or not closes[-period - 1]:
 13:         return None
 14:     return closes[-1] / closes[-period - 1] - 1
 15: def _slope(values: Sequence[float]) -> float:
 16:     if len(values) < 2:
 17:         return 0.0
 18:     x_bar = (len(values) - 1) / 2
 19:     y_bar = _mean(values)
 20:     den = sum((i - x_bar) ** 2 for i in range(len(values)))
 21:     return sum((i - x_bar) * (v - y_bar) for i, v in enumerate(values)) / den if den else 0.0
 22: def _correlation(left: Sequence[float], right: Sequence[float]) -> float | None:
 23:     if len(left) != len(right) or len(left) < 3:
 24:         return None
 25:     left_mean, right_mean = _mean(left), _mean(right)
 26:     left_dev = sum((value - left_mean) ** 2 for value in left) ** 0.5
 27:     right_dev = sum((value - right_mean) ** 2 for value in right) ** 0.5
 28:     if not left_dev or not right_dev:
 29:         return None
 30:     return sum((a - left_mean) * (b - right_mean) for a, b in zip(left, right)) / (left_dev * right_dev)
 31: def _rsquare(values: Sequence[float]) -> float | None:
 32:     correlation = _correlation(list(range(len(values))), values)
 33:     return correlation * correlation if correlation is not None else None
 34: def _atr_pct(bars: Sequence[DailyBar], period: int = 14) -> float | None:
 35:     if len(bars) < period + 1 or not bars[-1].close:
 36:         return None
 37:     true_ranges = []
 38:     for previous, current in zip(bars[-period - 1:-1], bars[-period:]):
 39:         true_ranges.append(max(
 40:             current.high - current.low,
 41:             abs(current.high - previous.close),
 42:             abs(current.low - previous.close),
 43:         ))
 44:     return _mean(true_ranges) / bars[-1].close
 45: def _pct_change(value: float) -> float:
 46:     """Normalize DailyBar.pct_chg, which may be stored as 10 or 0.10."""
 47:     return value * 100 if abs(value) <= 1 else value
 48: def _limit_up(bar: DailyBar) -> bool:
 49:     return _pct_change(float(bar.pct_chg or 0)) >= 9.5
 50: def _limit_down(bar: DailyBar) -> bool:
 51:     return _pct_change(float(bar.pct_chg or 0)) <= -9.5
 52: def _rank_fraction(values: Sequence[float], target: float) -> float:
 53:     if not values:
 54:         return 0.5
 55:     if len(values) == 1:
 56:         return 0.5
 57:     below = sum(value < target for value in values)
 58:     equal = sum(value == target for value in values)
 59:     return (below + equal / 2) / len(values)
 60: class FactorEngine:
 61:     """Calculate the production V1 factor groups from date-bounded daily bars.
 62:     The engine intentionally accepts an optional MarketContext. When it is
 63:     absent (for unit tests or standalone research), market breadth and 20-day
 64:     return are derived from the visible stock universe. No missing value is
 65:     replaced with a neutral score.
 66:     """
 67:     def __init__(self, registry: FactorRegistry) -> None:
 68:         self.registry = registry
 69:     def calculate(
 70:         self,
 71:         history: Mapping[str, Sequence[DailyBar]],
 72:         trade_date: date,
 73:         market: MarketContext | None = None,
 74:     ) -> list[FactorValue]:
 75:         visible_by_code: dict[str, list[DailyBar]] = {}
 76:         for ts_code, source_bars in history.items():
 77:             visible = sorted((bar for bar in source_bars if bar.trade_date <= trade_date), key=lambda bar: bar.trade_date)
 78:             if visible and visible[-1].trade_date == trade_date:
 79:                 visible_by_code[ts_code] = visible
 80:         market_values = self._market_values(visible_by_code, market)
 81:         sector_values = self._sector_values(visible_by_code)
 82:         result: list[FactorValue] = []
 83:         for ts_code, bars in visible_by_code.items():
 84:             values = self._stock_values(ts_code, bars, market_values, sector_values)
 85:             for definition in self.registry.production():
 86:                 raw_value = values.get(definition.name)
 87:                 valid = raw_value is not None and math.isfinite(float(raw_value))
 88:                 result.append(FactorValue(
 89:                     ts_code,
 90:                     trade_date,
 91:                     definition.name,
 92:                     definition.category,
 93:                     float(raw_value) if valid else None,
 94:                     None,
 95:                     valid,
 96:                     "" if valid else "insufficient_or_missing_data",
 97:                 ))
 98:         return result
 99:     @staticmethod
100:     def _market_values(visible_by_code: Mapping[str, Sequence[DailyBar]], market: MarketContext | None) -> dict[str, float | None]:
101:         latest = [bars[-1] for bars in visible_by_code.values() if bars]
102:         returns = [value for value in (_return([bar.close for bar in bars], 20) for bars in visible_by_code.values()) if value is not None]
103:         breadth = market.breadth if market is not None else (
104:             sum(1 for bars in visible_by_code.values() if len(bars) >= 2 and bars[-1].close > bars[-2].close) / len(latest) if latest else None
105:         )
106:         limit_up_count = market.limit_up_count if market is not None else sum(_limit_up(bar) for bar in latest)
107:         limit_down_count = market.limit_down_count if market is not None else sum(_limit_down(bar) for bar in latest)
108:         if market is not None and not market.market_data_available and limit_up_count == 0 and limit_down_count == 0:
109:             limit_up_count = sum(_limit_up(bar) for bar in latest)
110:             limit_down_count = sum(_limit_down(bar) for bar in latest)
111:         total_limits = limit_up_count + limit_down_count
112:         limit_pressure = ((limit_up_count - limit_down_count) / (total_limits + 10)) if total_limits else None
113:         market_return = market.market_return_20d if market is not None and market.market_return_20d is not None else (_mean(returns) if returns else None)
114:         return {
115:             "market_up_ratio": breadth,
116:             "market_limit_pressure": limit_pressure,
117:             "market_index_trend": market_return,
118:             "market_return_20d": market_return,
119:         }
120:     @staticmethod
121:     def _sector_values(visible_by_code: Mapping[str, Sequence[DailyBar]]) -> dict[str, dict[str, float | None]]:
122:         by_sector: dict[str, dict[str, dict[str, float | None]]] = defaultdict(dict)
123:         for ts_code, bars in visible_by_code.items():
124:             sector = bars[-1].sector if bars else ""
125:             if not sector:
126:                 continue
127:             closes = [bar.close for bar in bars]
128:             by_sector[sector][ts_code] = {
129:                 "return_5d": _return(closes, 5),
130:                 "return_20d": _return(closes, 20),
131:                 "up": 1.0 if len(closes) >= 2 and closes[-1] > closes[-2] else 0.0,
132:                 "limit_up": 1.0 if _limit_up(bars[-1]) else 0.0,
133:             }
134:         result: dict[str, dict[str, float | None]] = {}
135:         for sector, stocks in by_sector.items():
136:             return_5 = [item["return_5d"] for item in stocks.values() if item["return_5d"] is not None]
137:             return_20 = [item["return_20d"] for item in stocks.values() if item["return_20d"] is not None]
138:             up_ratio = _mean([float(item["up"]) for item in stocks.values()]) if stocks else None
139:             limit_up_count = sum(float(item["limit_up"]) for item in stocks.values()) if stocks else None
140:             for ts_code, item in stocks.items():
141:                 result[ts_code] = {
142:                     "return_5d": _mean(return_5),
143:                     "return_20d": _mean(return_20),
144:                     "up_ratio": up_ratio,
145:                     "limit_up": limit_up_count,
146:                     "rank": _rank_fraction(return_20, float(item["return_20d"])) if item["return_20d"] is not None else None,
147:                 }
148:         return result
149:     @staticmethod
150:     def _stock_values(
151:         ts_code: str,
152:         bars: Sequence[DailyBar],
153:         market: Mapping[str, float | None],
154:         sectors: Mapping[str, Mapping[str, float | None]],
155:     ) -> dict[str, float | None]:
156:         latest = bars[-1]
157:         closes = [bar.close for bar in bars]
158:         highs = [bar.high for bar in bars]
159:         volumes = [bar.volume for bar in bars]
160:         amounts = [bar.amount for bar in bars]
161:         daily_returns = [closes[i] / closes[i - 1] - 1 for i in range(1, len(closes)) if closes[i - 1]]
162:         returns_20 = _return(closes, 20)
163:         returns_5 = _return(closes, 5)
164:         returns_60 = _return(closes, 60)
165:         sector = sectors.get(ts_code, {})
166:         sector_return_20 = sector.get("return_20d")
167:         ma20 = _mean(closes[-20:]) if len(closes) >= 20 else None
168:         ma10 = _mean(closes[-10:]) if len(closes) >= 10 else None
169:         ma5 = _mean(closes[-5:]) if len(closes) >= 5 else None
170:         ma20_series = [_mean(closes[index - 19:index + 1]) for index in range(max(19, len(closes) - 5), len(closes))] if len(closes) >= 20 else []
171:         recent_changes = daily_returns[-20:]
172:         down_volumes = [bar.volume for previous, bar in zip(bars[-5:-1], bars[-4:]) if bar.close < previous.close]
173:         prior_volume = _mean(volumes[-25:-5]) if len(volumes) >= 25 else None
174:         recent_volume = _mean(volumes[-5:]) if len(volumes) >= 5 else None
175:         high20 = max(highs[-20:]) if len(highs) >= 20 else None
176:         high60 = max(highs[-60:]) if len(highs) >= 60 else None
177:         close20 = max(closes[-20:]) if len(closes) >= 20 else None
178:         close60 = max(closes[-60:]) if len(closes) >= 60 else None
179:         breakout_days = None
180:         if len(highs) >= 20:
181:             window = highs[-20:]
182:             breakout_days = len(window) - 1 - max(index for index, value in enumerate(window) if value == max(window))
183:         volume_ratio = volumes[-1] / _mean(volumes[-20:]) if len(volumes) >= 20 and _mean(volumes[-20:]) else None
184:         return {
185:             # market
186:             "market_up_ratio": market.get("market_up_ratio"),
187:             "market_limit_pressure": market.get("market_limit_pressure"),
188:             "market_index_trend": market.get("market_index_trend"),
189:             # sector
190:             "sector_rank": sector.get("rank"),
191:             "sector_return_5d": sector.get("return_5d"),
192:             "sector_return_20d": sector_return_20,
193:             "sector_up_ratio": sector.get("up_ratio"),
194:             "sector_limit_up": sector.get("limit_up"),
195:             # relative strength
196:             "return_20d": returns_20,
197:             "return_60d": returns_60,
198:             "rs_vs_index_20d": returns_20 - market["market_return_20d"] if returns_20 is not None and market.get("market_return_20d") is not None else None,
199:             "sector_relative_20d": returns_20 - sector_return_20 if returns_20 is not None and sector_return_20 is not None else None,
200:             "rank_in_sector": sector.get("rank"),
201:             "strength_persistence": _mean([1.0 if change > 0 else 0.0 for change in recent_changes]) if len(recent_changes) == 20 else None,
202:             # trend
203:             "ma_alignment": 1.0 if ma5 is not None and ma10 is not None and ma20 is not None and ma5 > ma10 > ma20 else 0.0 if ma5 is not None and ma10 is not None and ma20 is not None else None,
204:             "ma20_slope": _slope(ma20_series) / latest.close if len(ma20_series) >= 2 and latest.close else None,
205:             "new_high_20d": 1.0 if len(highs) >= 21 and highs[-1] >= max(highs[-21:-1]) else 0.0 if len(highs) >= 21 else None,
206:             "trend_consistency": _mean([1.0 if change > 0 else 0.0 for change in recent_changes]) if len(recent_changes) == 20 else None,
207:             "trend_rsq": _rsquare(closes[-20:]) if len(closes) >= 20 else None,
208:             # volume and price
209:             "volume_ratio_20d": volume_ratio,
210:             "volume_trend": recent_volume / _mean(volumes[-20:]) if recent_volume is not None and len(volumes) >= 20 and _mean(volumes[-20:]) else None,
211:             "price_volume_corr": _correlation(recent_changes, volumes[-20:]) if len(recent_changes) == 20 else None,
212:             "up_volume_ratio": _mean([bar.volume for previous, bar in zip(bars[-20:-1], bars[-19:]) if bar.close > previous.close]) / _mean(volumes[-20:]) if len(bars) >= 20 and _mean(volumes[-20:]) else None,
213:             "pullback_volume_shrink": _mean(down_volumes) / prior_volume if down_volumes and prior_volume else None,
214:             # position
215:             "distance_high_20d": latest.close / high20 - 1 if high20 else None,
216:             "distance_ma20": -(abs(latest.close / ma20 - 1)) if ma20 else None,
217:             "pullback_depth_20d": latest.close / close20 - 1 if close20 else None,
218:             "breakout_days": float(breakout_days) if breakout_days is not None else None,
219:             # risk quality
220:             "volatility_20d": pstdev(recent_changes) if len(recent_changes) == 20 else None,
221:             "atr_pct_14d": _atr_pct(bars),
222:             "drawdown_60d": latest.close / close60 - 1 if close60 else None,
