  1: """
  2: 个股 4 档资金流接口
  3: - GET /api/stock/{code}/money-flow-detail?date=20260706
  4: - 返回当前日 + 近 5 日的特/大/小/散单净流入
  5: """
  6: import logging
  7: from datetime import datetime
  8: from fastapi import APIRouter, Query
  9: from collectors.moneyflow_detail import (
 10:     get_stock_moneyflow_detail,
 11:     fetch_moneyflow_for_date,
 12:     backfill_moneyflow_detail,
 13: )
 14: logger = logging.getLogger(__name__)
 15: router = APIRouter()
 16: def _normalize_ts_code(code: str) -> str:
 17:     if not code:
 18:         return ''
 19:     code = str(code).strip()
 20:     if '.' in code:
 21:         return code.upper()
 22:     if code.startswith('6') or code.startswith('9'):
 23:         return f'{code}.SH'
 24:     if code.startswith('8') or code.startswith('4'):
 25:         return f'{code}.BJ'
 26:     return f'{code}.SZ'
 27: @router.get('/api/stock/{code}/money-flow-detail')
 28: def stock_money_flow_detail(
 29:     code: str,
 30:     date: str = Query(None, description='YYYYMMDD,留空取最新一日'),
 31: ):
 32:     """查询个股 4 档资金流(特/大/小/散单净流入)+ 主力/散户拆分"""
 33:     ts_code = _normalize_ts_code(code)
 34:     if not ts_code:
 35:         return {'error': 'invalid code'}
 36:     data = get_stock_moneyflow_detail(ts_code, date)
 37:     if not data:
 38:         return {
 39:             'ts_code': ts_code,
 40:             'available': False,
 41:             'message': '暂无 4 档资金流数据,系统每日 17:30 自动更新,可在指令信号日报页点击"补刷"',
 42:         }
 43:     return {
 44:         'ts_code': ts_code,
 45:         'available': True,
 46:         **data,
 47:     }
 48: @router.get('/api/watchlist/money-flow')
 49: def watchlist_money_flow(
 50:     codes: str = Query(..., description='逗号分隔的股票代码列表, 如 600519,000001,002415'),
 51:     date: str = Query(None, description='YYYYMMDD,留空取最新一日'),
 52: ):
 53:     """批量获取自选股的 4 档资金流(单次请求,避免 N+1)
 54:     返回:
 55:     - trade_date: 数据日期
 56:     - rows: [{ts_code, name, main_net, super_large, large, small, tiny, main_pct, available, message}]
 57:     """
 58:     from db.session import get_db_session
 59:     from db.models import StockMoneyFlowDetail
 60:     from sqlalchemy import and_
 61:     raw_codes = [c.strip() for c in codes.split(',') if c.strip()]
 62:     if not raw_codes:
 63:         return {'trade_date': None, 'rows': []}
 64:     ts_codes = [_normalize_ts_code(c) for c in raw_codes]
 65:     with get_db_session() as db:
 66:         if date:
 67:             td = datetime.strptime(date, '%Y%m%d').date()
 68:         else:
 69:             # 找 stock_money_flow_detail 表中最新日期
 70:             latest = db.query(StockMoneyFlowDetail.trade_date)\
 71:                 .order_by(StockMoneyFlowDetail.trade_date.desc()).first()
 72:             if not latest:
 73:                 return {'trade_date': None, 'rows': []}
 74:             td = latest[0]
 75:         rows_db = db.query(StockMoneyFlowDetail).filter(
 76:             StockMoneyFlowDetail.trade_date == td,
 77:             StockMoneyFlowDetail.ts_code.in_(ts_codes),
 78:         ).all()
 79:         data_map = {r.ts_code: r for r in rows_db}
 80:         # 关联 watchlist 取股票名
 81:         from db.models import Watchlist
 82:         wl_rows = db.query(Watchlist).filter(Watchlist.stock_code.in_(
 83:             [c for c in raw_codes]
 84:         )).all()
 85:         name_map = {w.stock_code: w.stock_name for w in wl_rows if w.stock_name}
 86:     rows = []
 87:     for raw, ts in zip(raw_codes, ts_codes):
 88:         r = data_map.get(ts)
 89:         if not r:
 90:             rows.append({
 91:                 'ts_code': ts,
 92:                 'name': name_map.get(raw, raw),
 93:                 'available': False,
 94:                 'message': '无数据',
 95:                 'main_net': 0, 'super_large': 0, 'large': 0,
 96:                 'small': 0, 'tiny': 0,
 97:                 'turnover_rate': 0,
 98:             })
 99:             continue
100:         def y2w(v):
101:             return round(float(v or 0) / 10000, 2)
102:         main_net = y2w(r.main_net)
103:         super_large = y2w(r.super_large_net)
104:         large = y2w(r.large_net)
105:         small = y2w(r.small_net)
106:         tiny = y2w(r.tiny_net)
107:         rows.append({
108:             'ts_code': ts,
109:             'name': name_map.get(raw, raw) or raw,
110:             'available': True,
111:             'main_net': main_net,
112:             'super_large': super_large,
113:             'large': large,
114:             'small': small,
115:             'tiny': tiny,
116:             'main_buy': y2w(r.main_buy),
117:             'main_sell': y2w(r.main_sell),
118:             'turnover_rate': float(r.turnover_rate or 0),
119:         })
120:     # 按主力净流入降序
121:     rows.sort(key=lambda x: x.get('main_net', 0), reverse=True)
122:     return {
123:         'trade_date': td.strftime('%Y%m%d'),
124:         'rows': rows,
125:     }
126: @router.post('/api/stock/money-flow-detail/backfill')
127: def backfill_money_flow_detail(
128:     start: str = Query(..., description='YYYYMMDD'),
129:     end: str = Query(..., description='YYYYMMDD'),
130: ):
131:     """手动回填 4 档资金流(管理员用)"""
132:     results = backfill_moneyflow_detail(start, end)
133:     total = sum(r.get('written', 0) for r in results)
134:     return {
135:         'days': len(results),
136:         'total_written': total,
137:         'results': results,
138:     }
139: @router.post('/api/stock/money-flow-detail/refresh')
140: def refresh_today_money_flow(date: str = Query(..., description='YYYYMMDD')):
141:     """手动触发某日 4 档资金流采集"""
142:     r = fetch_moneyflow_for_date(date)
143:     return {'date': date, **r}
