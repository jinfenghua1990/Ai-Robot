231: def _gen_trade_plan(pattern, tier, close, ma5, ma10, ma20, dist_high, dev_ma20):
232:     """生成具体交易计划（买入价位 + 止损价位）
233:     按报告模板：
234:     - 缩量回踩：靠近10日线 X 至20日线 Y 区间缩量企稳再买。有效跌破20日线 Y 失效。
235:     - 放量突破：放量站稳 Z 上方，或回踩不破5日线 W 再试错。跌回10日线 X 且放量转弱则止损。
236:     - 趋势延续：盘中回踩 X 附近承接强，再小仓试。跌破20日线 Y 不再恋战。
237:     - 缩量修复/结构偏弱：明天不主动买，除非放量反包并重新站回5/10日线。
238:     """
239:     if pattern == 'pullback':
240:         buy_zone = f"靠近10日线 {ma10:.2f} 至20日线 {ma20:.2f} 区间缩量企稳再买"
241:         stop_loss = f"有效跌破20日线 {ma20:.2f} 失效"
242:         return {'buy': buy_zone, 'stop': stop_loss, 'action': '低吸'}
243:     if pattern == 'breakout':
244:         buy_zone = f"放量站稳 {close:.2f} 上方，或回踩不破5日线 {ma5:.2f} 再试错"
245:         stop_loss = f"跌回10日线 {ma10:.2f} 且放量转弱则止损"
246:         return {'buy': buy_zone, 'stop': stop_loss, 'action': '右侧确认'}
247:     if pattern == 'trend':
248:         if tier == 'priority':
249:             buy_zone = f"不追开盘冲高；若盘中回踩 {ma10:.2f} 附近承接强，再小仓试"
250:             stop_loss = f"跌破20日线 {ma20:.2f} 不再恋战"
251:             return {'buy': buy_zone, 'stop': stop_loss, 'action': '回踩试错'}
252:         else:
253:             buy_zone = f"等回踩确认：靠近10日线 {ma10:.2f} 至20日线 {ma20:.2f} 区间缩量企稳再买"
254:             stop_loss = f"跌破20日线 {ma20:.2f} 不再恋战"
255:             return {'buy': buy_zone, 'stop': stop_loss, 'action': '等回踩'}
256:     if pattern == 'repair':
