  1: """个股状态评分引擎
  2: 6 个维度，每个返回 {stage, score}:
  3: - 情绪温度 (sentiment): 恐慌→谨慎→中性→乐观→狂热
  4: - 资金动能 (momentum): 流出→弱流→平衡→流入→强入（板块资金面）
  5: - 主力资金 (mainForce): 减仓→观望→平衡→建仓→强仓（个股主力资金专项）
  6: - 技术形态 (technical): 破位→弱势→震荡→偏多→多头
  7: - 板块共振 (sector): 冷门→跟随→联动→协同→共振
  8: - 风险等级 (risk): 安全→低危→中等→高危→极危
  9: 5段状态一致性标准：
 10: - 所有 5 段指标统一使用 20/40/60/80 分界线
 11: - 0-20: 极弱/极差/极 negative；20-40: 弱/差；40-60: 中性/平衡；
 12:   60-80: 强/积极；80-100: 极强/极积极
 13: - 风险等级为反向指标：低分=安全，高分=危险
 14: """
 15: from typing import Optional
 16: def _clamp(v, lo=0, hi=100):
 17:     return max(lo, min(hi, v))
 18: def _norm(raw, lo, hi):
 19:     """归一化到 0-100"""
 20:     if raw is None:
 21:         return 50
 22:     return _clamp((raw - lo) / (hi - lo) * 100)
 23: def _score_to_stage(score: int, stages: list) -> dict:
 24:     """0-100 分映射到 N 段阶段（等比分界）"""
 25:     n = len(stages)
 26:     if n <= 1:
 27:         return {'stage': stages[0] if stages else '', 'score': score}
 28:     step = 100 / n
 29:     idx = min(int(score / step), n - 1)
 30:     return {
 31:         'stage': stages[idx],
 32:         'score': score,
 33:     }
 34: # ===== 7 段阶段定义（统一标准）=====
 35: SENTIMENT_STAGES = ['冰点', '恐慌', '谨慎', '中性', '乐观', '狂热', '过热']
 36: RISK_STAGES = ['极安', '安全', '低危', '中等', '高危', '极危', '崩盘']
 37: MOMENTUM_STAGES = ['暴跌', '流出', '弱流', '平衡', '流入', '强入', '暴入']
 38: MAIN_FORCE_STAGES = ['出逃', '减仓', '观望', '平衡', '建仓', '强仓', '锁仓']
 39: TECHNICAL_STAGES = ['破位', '弱势', '震荡', '偏多', '多头', '突破', '顶部']
 40: SECTOR_STAGES = ['冷门', '跟随', '联动', '协同', '共振', '领涨', '极热']
 41: def calc_sentiment(quote: Optional[dict], sector_trend: Optional[dict],
 42:                    features: Optional[dict]) -> Optional[dict]:
 43:     """情绪温度：综合涨跌、板块热度、资金方向、量比"""
 44:     if not quote and not sector_trend:
 45:         return None
 46:     change_pct = quote.get('changePct', 0) if quote else 0
 47:     heat = sector_trend.get('latest_heat', 50) if sector_trend and sector_trend.get('available') else 50
 48:     flow_dir = sector_trend.get('flow_direction', '') if sector_trend else ''
 49:     vol_ratio = features.get('volume_ratio', 1.0) if features else 1.0
 50:     score = (
 51:         _norm(change_pct, -10, 10) * 0.3 +
 52:         _norm(heat, 0, 100) * 0.3 +
 53:         (80 if flow_dir == 'inflow' else 20 if flow_dir == 'outflow' else 50) * 0.2 +
 54:         _norm(vol_ratio, 0, 3) * 0.2
 55:     )
 56:     return _score_to_stage(round(_clamp(score)), SENTIMENT_STAGES)
 57: def calc_risk(features: Optional[dict], buy_power: Optional[dict],
 58:               position: Optional[dict]) -> Optional[dict]:
 59:     """风险等级：噪声比、ATR、仓位集中度、持仓比例（反向指标：低分=安全）"""
 60:     if not features and not buy_power and not position:
 61:         return None
 62:     noise = features.get('noise_ratio', 1.0) if features else 1.0
 63:     atr_pct = features.get('atr_pct', 0.03) if features else 0.03
 64:     pos_score = (buy_power.get('dimensions', {}).get('position', 50)
 65:                  if buy_power and buy_power.get('dimensions') else 50)
 66:     pos_pct = position.get('posPct', 0) if position else 0
 67:     # 风险分 = 高噪声 + 高波动 + 低形态 + 高仓位 → 分数越高越危险
 68:     score = (
 69:         _norm(noise, 0, 3) * 0.3 +
 70:         _norm(atr_pct, 0, 0.1) * 0.3 +
 71:         (100 - pos_score) * 0.2 +
 72:         _norm(pos_pct, 0, 100) * 0.2
 73:     )
 74:     return _score_to_stage(round(_clamp(score)), RISK_STAGES)
 75: def calc_momentum(sector_trend: Optional[dict],
 76:                   features: Optional[dict]) -> Optional[dict]:
 77:     """资金动能（板块资金面）：板块净流入、资金方向、3日主力流入、资金连续性"""
 78:     if not sector_trend and not features:
 79:         return None
 80:     net_flow = sector_trend.get('total_net_flow', 0) if sector_trend and sector_trend.get('available') else 0
 81:     flow_dir = sector_trend.get('flow_direction', '') if sector_trend else ''
 82:     inflow_3d = features.get('main_net_inflow_3d', 0) if features else 0
 83:     continuity = features.get('flow_continuity', 0) if features else 0
 84:     score = (
 85:         _norm(net_flow / 10000, -50, 50) * 0.3 +
 86:         (80 if flow_dir == 'inflow' else 20 if flow_dir == 'outflow' else 50) * 0.2 +
 87:         _norm(inflow_3d / 10000, -30, 30) * 0.3 +
 88:         _norm(continuity, 0, 10) * 0.2
 89:     )
 90:     return _score_to_stage(round(_clamp(score)), MOMENTUM_STAGES)
 91: def calc_main_force(quote: Optional[dict], features: Optional[dict],
 92:                     sector_trend: Optional[dict]) -> Optional[dict]:
 93:     """主力资金专项：主力资金流向、持仓变化、大单交易特征
 94:     独立于板块资金动能，聚焦个股层面的主力行为：
 95:     - 3日主力净流入强度（主力资金流向）
 96:     - 资金连续性（持仓变化趋势，连续流入天数）
 97:     - 量比放大（大单交易活跃度代理指标）
 98:     - 涨跌配合度（量价齐升=主力建仓，量增价跌=主力减仓）
 99:     """
100:     if not features and not quote:
101:         return None
102:     inflow_3d = features.get('main_net_inflow_3d', 0) if features else 0
103:     continuity = features.get('flow_continuity', 0) if features else 0
104:     vol_ratio = features.get('volume_ratio', 1.0) if features else 1.0
105:     change_pct = quote.get('changePct', 0) if quote else 0
106:     # 量价配合度：量增+价涨=建仓(高)；量增+价跌=减仓(低)
107:     if vol_ratio > 1.5 and change_pct > 0:
108:         vp_score = 80
109:     elif vol_ratio > 1.5 and change_pct < -1:
110:         vp_score = 20
111:     elif vol_ratio < 0.8:
112:         vp_score = 40  # 缩量，主力不活跃
113:     else:
114:         vp_score = 50
115:     # 连续性：>3天=强趋势，<0天=反向
116:     if continuity >= 5:
117:         cont_score = 90
118:     elif continuity >= 3:
119:         cont_score = 75
120:     elif continuity >= 1:
121:         cont_score = 60
122:     elif continuity == 0:
123:         cont_score = 50
124:     elif continuity >= -2:
125:         cont_score = 30
126:     else:
127:         cont_score = 15
128:     score = (
129:         _norm(inflow_3d / 10000, -30, 30) * 0.35 +
130:         cont_score * 0.25 +
131:         _norm(vol_ratio, 0, 3) * 0.15 +
132:         vp_score * 0.25
133:     )
134:     return _score_to_stage(round(_clamp(score)), MAIN_FORCE_STAGES)
135: def _technical_score_to_stage(score: int, features: Optional[dict]) -> dict:
136:     """7段技术形态映射：基础 5 段按分数，突破/顶部按条件覆盖"""
137:     if not features:
138:         return _score_to_stage(score, TECHNICAL_STAGES[:5])
139:     rsi = features.get('rsi_14', 50) or 50
140:     vol_ratio = features.get('volume_ratio', 1.0) or 1.0
141:     close_vs_ma20 = features.get('close_vs_ma20', 0) or 0
142:     higher_high = features.get('higher_high_flag', 0)
143:     # 顶部：RSI>=70 且量价背离（量大但 close_vs_ma20 收窄）
144:     if rsi >= 70 and vol_ratio > 1.5 and close_vs_ma20 < 0.05:
145:         return {'stage': '顶部', 'score': score}
146:     # 突破：多头（score>=75）且新高突破且量能放大
147:     if score >= 75 and higher_high == 1 and vol_ratio > 1.2:
148:         return {'stage': '突破', 'score': score}
149:     # 否则按 5 段映射（取前 5 段）
150:     return _score_to_stage(score, TECHNICAL_STAGES[:5])
151: def calc_technical(features: Optional[dict]) -> Optional[dict]:
152:     """技术形态：新高新低、趋势一致性、均线位置、均线斜率、RSI、量价配合（7段）"""
153:     if not features:
154:         return None
155:     hh = 1 if features.get('higher_high_flag') else 0
156:     hl = 1 if features.get('higher_low_flag') else 0
157:     consistency = features.get('trend_consistency_score', 50)
158:     close_vs_ma20 = features.get('close_vs_ma20', 0)
159:     ma20_slope = features.get('ma20_slope', 0)
160:     score = (
161:         hh * 20 +
162:         hl * 20 +
163:         _norm(consistency, 0, 100) * 0.3 +
164:         _norm(close_vs_ma20, -0.1, 0.1) * 0.15 +
165:         _norm(ma20_slope, -2, 2) * 0.15
166:     )
167:     return _technical_score_to_stage(round(_clamp(score)), features)
168: def calc_sector_resonance(sector_trend: Optional[dict],
169:                           features: Optional[dict]) -> Optional[dict]:
170:     """板块共振：板块热度、热度趋势、上涨家数比、板块强度"""
171:     if not sector_trend or not sector_trend.get('available'):
172:         return None
173:     heat = sector_trend.get('latest_heat', 50)
174:     heat_trend = sector_trend.get('heat_trend', 'stable')
175:     rise_ratio = sector_trend.get('rise_ratio', 0)
176:     sector_strength = features.get('sector_strength', 50) if features else 50
177:     score = (
178:         _norm(heat, 0, 100) * 0.3 +
179:         (80 if heat_trend == 'up' else 20 if heat_trend == 'down' else 50) * 0.25 +
180:         _norm(rise_ratio, -5, 5) * 0.2 +
181:         _norm(sector_strength, 0, 100) * 0.25
182:     )
183:     return _score_to_stage(round(_clamp(score)), SECTOR_STAGES)
</file>

<file path="backend/api/bs_backtest/run.py">
  1: """POST /api/bs-screener/backtest  单股+组合回测"""
  2: import asyncio
  3: import math
  4: from datetime import datetime
  5: from fastapi import APIRouter, HTTPException
  6: from pydantic import BaseModel
  7: from typing import List
  8: from api.bs_signals import _fetch_kline
  9: from db.connection import get_db
 10: from db.models import StockFlow
 11: from .engine import _backtest_single, _calc_stats
 12: router = APIRouter()
 13: class BacktestRequest(BaseModel):
 14:     stocks: List[str]
 15:     atr_period: int = 10
 16:     atr_multiplier: float = 1.0
 17:     start_date: str
 18:     end_date: str
 19:     initial_capital: float = 100000.0
 20:     volume_filter: bool = False
 21:     ma20_filter: bool = False
 22:     ma60_trend: bool = False
 23:     rsi_filter: bool = False
 24:     strong_volume: bool = False
 25:     macd_filter: bool = False
 26:     kdj_filter: bool = False
 27:     stop_loss_pct: float = 0.0
 28:     rsi_lower: int = 30
 29:     rsi_upper: int = 70
 30:     ma60_rising: bool = False
 31:     sector_uptrend_filter: bool = False
 32:     sector_top_n: int = 10
 33:     sector_filter_mode: str = 'strong_rotation'
 34:     sector_no_data_action: str = 'pass'
 35:     main_force_filter: bool = False
 36:     main_force_lookback: int = 3
 37:     main_force_min_total: float = 0.0
 38: def _scrub_nan(obj):
 39:     """把所有 float 字段的 NaN/Inf 替换为 0（防止 JSON 序列化 500 错）"""
 40:     if isinstance(obj, dict):
 41:         return {k: _scrub_nan(v) for k, v in obj.items()}
 42:     if isinstance(obj, list):
 43:         return [_scrub_nan(v) for v in obj]
 44:     if isinstance(obj, float):
 45:         if math.isnan(obj) or math.isinf(obj):
 46:             return 0.0
 47:         return obj
 48:     return obj
 49: @router.post("/api/bs-screener/backtest")
 50: async def run_backtest(req: BacktestRequest):
 51:     """运行 BS 策略回测（单股+组合）"""
 52:     if not req.stocks:
 53:         raise HTTPException(status_code=400, detail="请选择至少一只股票")
 54:     if len(req.stocks) > 2000:
 55:         raise HTTPException(status_code=400, detail="单次回测最多2000只股票")
 56:     if req.start_date >= req.end_date:
 57:         raise HTTPException(status_code=400, detail="开始日期必须早于结束日期")
 58:     per_stock_capital = req.initial_capital
 59:     sector_top10_map = None
 60:     stock_sector_map = None
 61:     if req.sector_uptrend_filter:
 62:         from analyzers.sector_engine import build_sector_top_map
 63:         sector_top10_map = build_sector_top_map(
 64:             req.start_date, req.end_date, top_n=req.sector_top_n,
 65:             mode=req.sector_filter_mode)
 66:         with get_db_session() as _db:
 67:             rows = _db.query(StockFlow.ts_code, StockFlow.sector).filter(
 68:                 StockFlow.sector.isnot(None), StockFlow.sector != '').all()
 69:             stock_sector_map = {}
 70:             for ts_code, sector in rows:
 71:                 bare = ts_code.replace('.SH', '').replace('.SZ', '')
 72:                 stock_sector_map[bare] = sector
 73:     semaphore = asyncio.Semaphore(5)
 74:     async def backtest_one(code: str):
 75:         async with semaphore:
 76:             try:
 77:                 klines = await _fetch_kline(code, 500)
 78:                 if not klines or len(klines) < 50:
 79:                     return {'code': code, 'trades': [], 'stats': {}, 'equity_curve': [], 'error': f'kline too short: {len(klines) if klines else 0}'}
 80:                 mf_db = None
 81:                 if req.main_force_filter:
 82:                     from db.connection import get_db as _gdb
 83:                     mf_db = next(_gdb())
 84:                 try:
 85:                     result = _backtest_single(
 86:                         klines, req.atr_period, req.atr_multiplier,
 87:                         per_stock_capital, req.start_date, req.end_date,
 88:                         req.volume_filter, req.ma20_filter,
 89:                         req.ma60_trend, req.rsi_filter, req.strong_volume,
 90:                         req.macd_filter, req.kdj_filter, req.stop_loss_pct,
 91:                         req.rsi_lower, req.rsi_upper, req.main_force_filter,
 92:                         mf_db, req.main_force_lookback, req.main_force_min_total,
 93:                         req.ma60_rising,
 94:                         code, req.sector_uptrend_filter, sector_top10_map,
 95:                         stock_sector_map, req.sector_no_data_action
 96:                     )
 97:                 finally:
 98:                     if mf_db is not None:
 99:                         mf_db.close()
100:                 result['code'] = code
101:                 return result
102:             except Exception as e:
103:                 return {'code': code, 'trades': [], 'stats': {}, 'equity_curve': [], 'error': str(e)}
104:     tasks = [backtest_one(c) for c in req.stocks]
105:     results = await asyncio.gather(*tasks, return_exceptions=True)
106:     final_results = []
107:     exc_count = 0
108:     for r in results:
109:         if isinstance(r, Exception):
110:             exc_count += 1
111:             final_results.append({'code': 'unknown', 'trades': [], 'stats': {}, 'equity_curve': [], 'error': f'gather-exception: {type(r).__name__}: {str(r)[:200]}'})
112:         else:
113:             final_results.append(r)
114:     results = final_results
115:     all_trades = []
116:     all_equity = {}
117:     valid_results = [r for r in results if not r.get('error')]
118:     for r in valid_results:
119:         all_trades.extend(r['trades'])
120:         for point in r['equity_curve']:
121:             d = point['date']
122:             all_equity[d] = all_equity.get(d, 0) + point['equity']
123:     merged_curve = [{'date': d, 'equity': round(v, 2)} for d, v in sorted(all_equity.items())]
124:     summary = _calc_stats(all_trades, merged_curve, req.initial_capital)
125:     stock_win_rate = 0
126:     stock_profitable_count = 0
127:     stock_with_trades_count = 0
128:     for r in valid_results:
129:         ts = r.get('trades', [])
130:         if not ts:
131:             continue
132:         stock_with_trades_count += 1
133:         net_profit = sum(t.get('profit', 0) for t in ts)
134:         if net_profit > 0:
135:             stock_profitable_count += 1
136:     if stock_with_trades_count > 0:
137:         stock_win_rate = round(stock_profitable_count / stock_with_trades_count * 100, 1)
138:     summary['stock_win_rate'] = stock_win_rate
139:     summary['stock_profitable_count'] = stock_profitable_count
140:     summary['stock_with_trades_count'] = stock_with_trades_count
141:     per_stock = []
142:     for r in results:
143:         ts = r.get('trades', [])
144:         net_profit = sum(t.get('profit', 0) for t in ts) if ts else 0
145:         per_stock.append({
146:             'code': r['code'],
147:             'trades': len(ts),
148:             'net_profit': round(net_profit, 2),
149:             'profitable': net_profit > 0,
150:             'stats': r.get('stats', {}),
151:             'error': r.get('error'),
152:         })
153:     return _scrub_nan({
154:         'summary': summary,
155:         'per_stock': per_stock,
156:         'trades': all_trades,
157:         'equity_curve': merged_curve,
158:         'params': {
159:             'stocks': req.stocks,
160:             'atr_period': req.atr_period,
161:             'atr_multiplier': req.atr_multiplier,
162:             'start_date': req.start_date,
163:             'end_date': req.end_date,
164:             'initial_capital': req.initial_capital,
165:         },
166:         'generated_at': datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
167:     })
</file>

<file path="backend/api/bs_screener/today.py">
  1: """GET /api/bs-screener/today  +  GET /api/bs-screener/strategy-picks
  2: 读盘后定时任务落库的预计算结果
  3: """
  4: import json
  5: from fastapi import APIRouter, HTTPException, Query
  6: from sqlalchemy import func
  7: from db.connection import get_db
  8: from db.session import get_db_session
  9: from db.models import BSDailyScan, LeaderLifecycle
 10: router = APIRouter()
 11: LEADER_STAGES = ['突破', '加速', '启动', '发酵']
 12: @router.get("/api/bs-screener/today")
 13: def bs_screener_today(backtest_id: int = Query(..., description="BSBacktestResult.id")):
 14:     """读取今日预扫描结果（盘后定时任务已落库 bs_daily_scan 表）"""
 15:     with get_db_session() as db:
 16:         row = db.query(BSDailyScan).filter(
 17:             BSDailyScan.backtest_id == backtest_id
 18:         ).order_by(BSDailyScan.trade_date.desc()).first()
 19:         if not row:
 20:             raise HTTPException(status_code=404, detail='今日无预扫描结果，请点击开始扫描')
 21:         signals = json.loads(row.signals_json or '[]')
 22:         summary = json.loads(row.summary_json or '{}')
 23:         return {
 24:             'signals': signals,
 25:             'summary': summary,
 26:             'scanned': row.scanned,
 27:             'trade_date': row.trade_date.strftime('%Y-%m-%d') if row.trade_date else '',
 28:             'generated_at': row.generated_at.strftime('%Y-%m-%d %H:%M:%S') if row.generated_at else '',
 29:             'precomputed': True,
 30:         }
 31: @router.get("/api/bs-screener/strategy-picks")
 32: def strategy_picks_today():
 33:     """返回当前 BS 策略今日命中的个股清单。
 34:     动态读取 BSDailyScan 最新一日的所有 strategy_name，避免硬编码策略名导致配置漂移。
 35:     前端用于在 Watchlist / 模拟盘 / 自动化页面上标记"策略命中"徽章。
 36:     """
 37:     with get_db_session() as db:
 38:         # 1. 动态查询 BSDailyScan 最新一日的所有策略（不再硬编码 retained_names）
 39:         latest_date = db.query(func.max(BSDailyScan.trade_date)).scalar()
 40:         if not latest_date:
 41:             return {
 42:                 'date': '',
 43:                 'picks': [],
 44:                 'code_to_strategies': {},
 45:                 'summary': {},
 46:             }
 47:         today_rows = db.query(BSDailyScan).filter(
 48:             BSDailyScan.trade_date == latest_date
 49:         ).all()
 50:         picks = []
 51:         code_to_strategies = {}
 52:         summary = {}
 53:         for r in today_rows:
 54:             signals = json.loads(r.signals_json or '[]')
 55:             for s in signals:
 56:                 raw_code = s.get('secCode') or s.get('code') or ''
 57:                 code = raw_code.split('.')[0] if raw_code else ''
 58:                 if not code:
 59:                     continue
 60:                 item = {
 61:                     'code': code,
 62:                     'name': s.get('secName') or s.get('name', ''),
 63:                     'sector': s.get('sector', ''),
 64:                     'strategy': r.strategy_name,
 65:                     'dimension': r.dimension,
 66:                     'signal': s.get('signal', 'B'),
 67:                     'reasons': s.get('reasons', []) or [],
 68:                     'score': s.get('score'),
 69:                 }
 70:                 picks.append(item)
 71:                 code_to_strategies.setdefault(code, [])
 72:                 if r.strategy_name not in code_to_strategies[code]:
 73:                     code_to_strategies[code].append(r.strategy_name)
 74:                 summary[r.strategy_name] = summary.get(r.strategy_name, 0) + 1
 75:         # 2. LeaderLifecycle 用 same latest_date 查询（与 BSDailyScan 一致）
 76:         # 强势阶段标记为"游资龙头"，所有阶段都返回供前端显示
 77:         leader_rows = db.query(LeaderLifecycle).filter(
 78:             LeaderLifecycle.trade_date == latest_date,
 79:         ).all()
 80:         for lr in leader_rows:
 81:             code = lr.ts_code.split('.')[0] if lr.ts_code else ''
 82:             if not code:
 83:                 continue
 84:             stage = lr.stage or ''
 85:             is_strong = stage in LEADER_STAGES
 86:             # 强势阶段用"游资龙头"标签，其他阶段用"阶段:XXX"标签
 87:             tag = '游资龙头' if is_strong else f'游资阶段:{stage}'
 88:             if code not in code_to_strategies:
 89:                 code_to_strategies[code] = []
 90:                 picks.append({
 91:                     'code': code,
 92:                     'name': lr.name or '',
 93:                     'sector': lr.sector or '',
 94:                     'strategy': tag,
 95:                     'dimension': 'leader',
 96:                     'signal': 'L',
 97:                     'reasons': [f'龙头阶段:{stage}'],
 98:                     'score': float(lr.strength) if lr.strength else None,
 99:                 })
100:             if tag not in code_to_strategies[code]:
101:                 code_to_strategies[code].append(tag)
102:             summary[tag] = summary.get(tag, 0) + 1
103:         return {
104:             'date': latest_date.strftime('%Y-%m-%d') if hasattr(latest_date, 'strftime') else str(latest_date),
105:             'picks': picks,
106:             'code_to_strategies': code_to_strategies,
107:             'summary': summary,
108:         }
