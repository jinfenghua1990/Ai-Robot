286: async def _fetch_quotes_batch(sec_codes: list) -> dict:
287:     """并发获取多只股票行情（分批20只，避免新浪限流）"""
288:     quotes = {}
289:     seen = set()
290:     unique_codes = [c for c in sec_codes if c and c not in seen and not seen.add(c)]
