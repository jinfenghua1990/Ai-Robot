 1: """API 共享工具函数"""
 2: from fastapi import HTTPException
 3: from datetime import datetime
 4: def validate_date(date_str: str) -> str:
 5:     """验证日期格式为 YYYY-MM-DD，返回处理后的日期字符串"""
 6:     if date_str:
 7:         try:
 8:             datetime.strptime(date_str, '%Y-%m-%d')
 9:         except ValueError:
10:             raise HTTPException(status_code=400, detail="date must be YYYY-MM-DD format")
11:     return date_str or datetime.now().strftime('%Y-%m-%d')
12: def validate_days(days: int, default: int = 5, max_val: int = 30) -> int:
13:     """验证 days 参数范围"""
14:     if days < 1 or days > max_val:
15:         raise HTTPException(status_code=400, detail=f"days must be between 1 and {max_val}")
16:     return days
