<file path="backend/quant_vnext/scoring.py">
 1: from __future__ import annotations
 2: from collections import defaultdict
 3: from statistics import mean
 4: from typing import Iterable, Mapping
 5: from .contracts import DimensionScore, FactorValue
 6: from .registry import FactorRegistry
 7: GROUP_WEIGHTS = {
 8:     "market": 0.10,
 9:     "sector": 0.20,
10:     "strength": 0.20,
11:     "trend": 0.15,
12:     "volume_price": 0.15,
13:     "position": 0.15,
14:     "risk_penalty": 0.05,
15: }
16: def _percentile(values: list[float], value: float) -> float:
17:     if len(values) < 2:
18:         return 50.0
19:     ordered = sorted(values)
20:     below = sum(v < value for v in ordered)
21:     equal = sum(v == value for v in ordered)
22:     return 100.0 * (below + equal / 2) / len(ordered)
23: def _market_score(name: str, value: float) -> float:
24:     """Map global context factors to 0-100 without turning equal values into 50."""
25:     if name == "market_up_ratio":
26:         return max(0.0, min(100.0, value * 100.0))
27:     if name == "market_limit_pressure":
28:         return max(0.0, min(100.0, (value + 1.0) * 50.0))
29:     if name == "market_index_trend":
30:         return max(0.0, min(100.0, 50.0 + value * 1000.0))
31:     return max(0.0, min(100.0, value))
32: class CrossSectionScorer:
33:     """Normalize individual factors, then aggregate the seven factor groups."""
34:     DIMENSION_MAP = {
35:         "market": "market",
36:         "momentum": "strength",
37:         "trend": "trend",
38:         "volume_price": "volume_price",
39:         "volatility": "risk",
40:         "position": "position",
41:         "sector": "sector",
42:         "risk": "risk",
43:     }
44:     DIMENSIONS = ("market", "sector", "strength", "trend", "volume_price", "position", "risk")
45:     def score(self, values: Iterable[FactorValue], registry: FactorRegistry) -> dict[str, dict[str, DimensionScore]]:
46:         rows = list(values)
47:         by_factor: dict[str, list[float]] = defaultdict(list)
48:         for row in rows:
49:             if row.valid and row.raw_value is not None:
50:                 by_factor[row.name].append(row.raw_value)
51:         by_stock: dict[str, list[FactorValue]] = defaultdict(list)
52:         for row in rows:
53:             by_stock[row.ts_code].append(row)
54:         result: dict[str, dict[str, DimensionScore]] = {}
55:         for ts_code, stock_rows in by_stock.items():
56:             dimensions: dict[str, list[float]] = defaultdict(list)
57:             factor_names: dict[str, list[str]] = defaultdict(list)
58:             for row in stock_rows:
59:                 if not row.valid or row.raw_value is None:
60:                     continue
61:                 definition = registry.get(row.name)
62:                 if definition.category == "market":
63:                     normalized = _market_score(row.name, row.raw_value)
64:                 else:
65:                     normalized = _percentile(by_factor[row.name], row.raw_value)
66:                     if definition.direction < 0:
67:                         normalized = 100.0 - normalized
68:                 row.normalized = round(normalized, 4)
69:                 dimension = self.DIMENSION_MAP[definition.category]
70:                 dimensions[dimension].append(normalized)
71:                 factor_names[dimension].append(row.name)
72:             result[ts_code] = {
73:                 name: DimensionScore(name, round(mean(dimensions[name]), 2), True, factor_names[name])
74:                 for name in dimensions
75:             }
76:             for name in self.DIMENSIONS:
77:                 if name not in result[ts_code]:
78:                     result[ts_code][name] = DimensionScore(name, None, False, [], "missing_factor")
79:         return result
80:     @staticmethod
81:     def factor_score(dimensions: Mapping[str, DimensionScore], weights: Mapping[str, float] | None = None) -> float | None:
82:         active_weights = dict(GROUP_WEIGHTS)
83:         if weights:
84:             active_weights.update(weights)
85:         usable = []
86:         for name in ("market", "sector", "strength", "trend", "volume_price", "position"):
87:             item = dimensions.get(name)
88:             if item and item.valid and item.score is not None:
89:                 usable.append(item.score * active_weights.get(name, 0.0))
90:         risk = dimensions.get("risk")
91:         if not usable and not (risk and risk.valid and risk.score is not None):
92:             return None
93:         score = sum(usable)
94:         if risk and risk.valid and risk.score is not None:
95:             score -= (100.0 - risk.score) * active_weights.get("risk_penalty", 0.05)
96:         return round(max(0.0, min(100.0, score)), 2)
