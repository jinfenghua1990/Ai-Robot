<file path="frontend/src/components/trading/QualityPicker.jsx">
 1: import { useState, useRef, useEffect } from 'react';
 2: import { qualityOrder, qualityColors } from '../StageBar';
 3: import { apiFetch } from '../../utils/request';
 4: /**
 5:  * 个股强度选择器（自选股卡片 2×2 按钮组里的一个格子）
 6:  * - 显示当前 quality_status 徽章（劣质/中性/偏强/强势/极强/核心/淘汰）
 7:  * - 点击弹出下拉菜单，可选择7个值之一
 8:  * - 调用 PUT /api/watchlist/{code}/quality 更新后端
 9:  *
10:  * props:
11:  *   stockCode  - 股票代码
12:  *   value      - 当前 quality_status（如 '核心'）
13:  *   onChange    - 可选，更新成功后回调
14:  */
15: export default function QualityPicker({ stockCode, value = '中性', onChange }) {
16:   const [open, setOpen] = useState(false);
17:   const [loading, setLoading] = useState(false);
18:   const ref = useRef(null);
19:   const currentValue = value || '中性';
20:   // 外部点击关闭
21:   useEffect(() => {
22:     if (!open) return;
23:     const handler = (e) => {
24:       if (ref.current && !ref.current.contains(e.target)) setOpen(false);
25:     };
26:     document.addEventListener('mousedown', handler);
27:     return () => document.removeEventListener('mousedown', handler);
28:   }, [open]);
29:   const handleSelect = async (q) => {
30:     if (q === currentValue || loading) {
31:       setOpen(false);
32:       return;
33:     }
34:     setLoading(true);
35:     try {
36:       const { ok, data } = await apiFetch(`/api/watchlist/${stockCode}/quality`, {
37:         method: 'PUT',
38:         headers: { 'Content-Type': 'application/json' },
39:         body: JSON.stringify({ quality_status: q }),
40:       });
41:       if (ok && data?.success) {
42:         onChange?.(q);
43:       }
44:     } catch (e) {
45:       /* silent */
46:     } finally {
47:       setLoading(false);
48:       setOpen(false);
49:     }
50:   };
51:   const color = qualityColors[currentValue] || '#64748B';
52:   return (
53:     <div ref={ref} className="relative">
54:       <button
55:         onClick={(e) => { e.stopPropagation(); setOpen(v => !v); }}
56:         className="px-1.5 py-0.5 rounded text-[10px] font-bold text-center whitespace-nowrap h-7 inline-flex items-center justify-center w-full cursor-pointer"
57:         style={{ background: `${color}22`, color, border: `1px solid ${color}55` }}
58:         title="点击修改个股强度"
59:       >
60:         {currentValue}
61:       </button>
62:       {open && (
63:         <div
64:           onClick={(e) => e.stopPropagation()}
65:           className="absolute top-full left-0 mt-1 z-50 rounded-md shadow-lg border overflow-hidden min-w-[80px]"
66:           style={{ background: 'var(--bg-card)', borderColor: 'var(--border-color)' }}
67:         >
68:           {qualityOrder.map((q) => {
69:             const c = qualityColors[q];
70:             const active = q === currentValue;
71:             return (
72:               <button
73:                 key={q}
74:                 disabled={loading}
75:                 onClick={() => handleSelect(q)}
76:                 className="block w-full text-left px-2 py-1 text-[11px] font-medium disabled:opacity-50 transition-colors"
77:                 style={{
78:                   background: active ? `${c}22` : 'transparent',
79:                   color: active ? c : 'var(--text-primary)',
80:                 }}
81:                 onMouseEnter={(e) => { if (!active) e.currentTarget.style.background = `${c}11`; }}
82:                 onMouseLeave={(e) => { if (!active) e.currentTarget.style.background = 'transparent'; }}
83:               >
84:                 {q}
85:               </button>
86:             );
87:           })}
88:         </div>
89:       )}
90:     </div>
91:   );
92: }
</file>

<file path="frontend/src/components/trading/SignalCardHeader.jsx">
 1: import React from 'react';
 2: import { scoreColor } from './SignalCardUtils';
 3: // 维度评分 pill：内嵌在各分组标题行，显示该维度的盘后 / 实时评分（带颜色）
 4: export function DimPill({ label, afterVal, rtVal, rtAvail }) {
 5:   const c = (v) => v == null ? null : v >= 70 ? '#ef4444' : v >= 50 ? '#eab308' : v >= 30 ? '#f97316' : '#22c55e';
 6:   const showAfter = afterVal != null;
 7:   const showRt = rtAvail && rtVal != null;
 8:   if (!showAfter && !showRt) return null;
 9:   return (
10:     <span className="text-[9px] inline-flex items-center gap-0.5 px-1 py-0.5 rounded font-bold whitespace-nowrap"
