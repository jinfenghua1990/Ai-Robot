<file path="frontend/src/components/watchlist/BatchBar.jsx">
  1: import { useState, useRef, useEffect } from 'react';
  2: /**
  3:  * 批量操作栏
  4:  *  - 全选 / 反选
  5:  *  - 批量删除
  6:  *  - 批量移动分组
  7:  *  - 导出 CSV
  8:  *  - 退出批量模式
  9:  */
 10: export default function BatchBar({
 11:   batchMode, selectedIds, allStocks, groups, activeGroup, onToggleBatch, onSelectAll, onInvert, onClearSel,
 12:   onBatchDelete, onBatchMove, onExport, addLog,
 13: }) {
 14:   const [open, setOpen] = useState(false);
 15:   const [moveOpen, setMoveOpen] = useState(false);
 16:   const ref = useRef(null);
 17:   useEffect(() => {
 18:     const h = (e) => { if (ref.current && !ref.current.contains(e.target)) { setOpen(false); setMoveOpen(false); } };
 19:     document.addEventListener('mousedown', h);
 20:     return () => document.removeEventListener('mousedown', h);
 21:   }, []);
 22:   if (!batchMode) {
 23:     return (
 24:       <button
 25:         onClick={onToggleBatch}
 26:         className="px-2 py-1 rounded text-[11px] flex items-center gap-1.5 hover:opacity-80"
 27:         style={{ background: 'var(--bg-hover)', border: '1px solid var(--border-color)', color: 'var(--text-primary)' }}
 28:       >
 29:         ☑ 批量
 30:       </button>
 31:     );
 32:   }
 33:   const total = allStocks.length;
 34:   const sel = selectedIds.length;
 35:   const allSelected = total > 0 && sel === total;
 36:   return (
 37:     <div ref={ref} className="flex items-center gap-1 relative">
 38:       {/* 全选/反选 */}
 39:       <button
 40:         onClick={() => allSelected ? onClearSel() : onSelectAll()}
 41:         className="px-2 py-1 rounded text-[11px] flex items-center gap-1 hover:opacity-80"
 42:         style={{ background: allSelected ? '#22c55e' : 'var(--bg-hover)', color: allSelected ? '#fff' : 'var(--text-primary)', border: '1px solid var(--border-color)' }}
 43:         title={allSelected ? '取消全选' : '全选当前分组'}
 44:       >
 45:         {allSelected ? '☑' : '☐'} {allSelected ? `全选 ${sel}` : `全选 ${total}`}
 46:       </button>
 47:       <button onClick={onInvert} className="px-2 py-1 rounded text-[11px] hover:opacity-80" style={{ background: 'var(--bg-hover)', border: '1px solid var(--border-color)', color: 'var(--text-primary)' }}>
 48:         反选
 49:       </button>
 50:       {/* 已选 N 只 */}
 51:       <span className="text-[11px] px-2" style={{ color: 'var(--text-muted)' }}>
 52:         已选 <b style={{ color: '#60a5fa' }}>{sel}</b> / {total}
 53:       </span>
 54:       {/* 批量操作下拉 */}
 55:       <button
 56:         onClick={() => setOpen(!open)}
 57:         disabled={sel === 0}
 58:         className="px-2 py-1 rounded text-[11px] flex items-center gap-1 hover:opacity-80"
 59:         style={{ background: sel > 0 ? '#ef4444' : 'var(--bg-hover)', color: sel > 0 ? '#fff' : 'var(--text-muted)', border: '1px solid var(--border-color)', cursor: sel > 0 ? 'pointer' : 'not-allowed' }}
 60:       >
 61:         操作 ▾
 62:       </button>
 63:       {open && sel > 0 && (
 64:         <div className="absolute right-0 top-full mt-1 z-30 rounded-lg shadow-2xl min-w-[180px] p-1"
 65:           style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)' }}>
 66:           <button
 67:             onClick={() => { if (confirm(`确认删除 ${sel} 只自选股？`)) onBatchDelete(); setOpen(false); }}
 68:             className="w-full text-left px-2 py-1 text-[11px] rounded hover:bg-white/10"
 69:             style={{ color: '#ef4444' }}
 70:           >
 71:             🗑 删除 {sel} 只
 72:           </button>
 73:           <button
 74:             onClick={() => { setMoveOpen(!moveOpen); }}
 75:             className="w-full text-left px-2 py-1 text-[11px] rounded hover:bg-white/10"
 76:             style={{ color: 'var(--text-primary)' }}
 77:           >
 78:             📂 移动到分组 ▸
 79:           </button>
 80:           {moveOpen && (
 81:             <div className="ml-3 border-l pl-1" style={{ borderColor: 'var(--border-color)' }}>
 82:               {groups.filter(g => g.name !== activeGroup).map(g => (
 83:                 <button
 84:                   key={g.name}
 85:                   onClick={() => { onBatchMove(g.name); setOpen(false); setMoveOpen(false); }}
 86:                   className="w-full text-left px-2 py-1 text-[11px] rounded hover:bg-white/10"
 87:                   style={{ color: 'var(--text-primary)' }}
 88:                 >
 89:                   {g.name} <span style={{ color: 'var(--text-muted)' }}>({g.count})</span>
 90:                 </button>
 91:               ))}
 92:             </div>
 93:           )}
 94:         </div>
 95:       )}
 96:       {/* 导出按钮（独立） */}
 97:       <button
 98:         onClick={onExport}
 99:         title="导出当前分组为 CSV"
100:         className="px-2 py-1 rounded text-[11px] hover:opacity-80"
101:         style={{ background: 'var(--bg-hover)', border: '1px solid var(--border-color)', color: 'var(--text-primary)' }}
102:       >
103:         📥
104:       </button>
105:       {/* 退出批量 */}
106:       <button
107:         onClick={() => { onClearSel(); onToggleBatch(); }}
108:         title="退出批量"
109:         className="px-2 py-1 rounded text-[11px] hover:opacity-80"
110:         style={{ background: 'var(--bg-hover)', color: 'var(--text-muted)' }}
111:       >
112:         ✕
113:       </button>
114:     </div>
115:   );
116: }
</file>

<file path="frontend/src/components/watchlist/FilterBar.jsx">
 1: import { useState, useRef, useEffect } from 'react';
 2: /**
 3:  * 筛选栏（独立于分组和排序）
 4:  * 专注：按条件过滤股票列表，不负责归类或排序
 5:  *
 6:  * 当前筛选条件：
 7:  *  - 拒绝震荡：隐藏 CHOPPY 状态股票（只留 TREND/IMPULSE）
 8:  *  - 信号过滤：按 B/S 信号筛选
 9:  *  - 板块升温：所属板块热度上升
10:  */
11: const FILTERS = [
12:   { key: 'junk', label: '拒绝震荡', icon: '〰️', desc: '隐藏CHOPPY状态，只留趋势/主升' },
13:   { key: 'buyOnly', label: '仅可买', icon: '🔴', desc: '只显示B信号股票' },
14:   { key: 'heating', label: '板块升温', icon: '🔥', desc: '所属板块热度上升' },
15:   { key: 'hit_yuzi', label: '游资命中', icon: '🎯', desc: '2+游资共振净买入' },
16:   { key: 'hit_strategy', label: '策略命中', icon: '🤖', desc: '量化策略今日命中' },
17:   { key: 'hit_trend', label: '趋势命中', icon: '📈', desc: '多头排列/底部突破' },
18:   { key: 'hit_capital', label: '资金命中', icon: '💰', desc: '主力净流入创30天新高' },
19:   { key: 'hit_popularity', label: '人气命中', icon: '🔥', desc: '板块爆发涨停≥5' },
20:   { key: 'hit_support', label: '承接命中', icon: '🛡️', desc: '昨日上榜今日V反' },
21:   { key: 'hit_accumulation', label: '吸筹命中', icon: '🧲', desc: '股东户数减少筹码集中' },
22: ];
23: export default function FilterBar({ activeFilters, onToggle, addLog }) {
24:   const [open, setOpen] = useState(false);
25:   const ref = useRef(null);
26:   useEffect(() => {
27:     const h = (e) => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); };
28:     document.addEventListener('mousedown', h);
29:     return () => document.removeEventListener('mousedown', h);
30:   }, []);
31:   const activeCount = FILTERS.filter(f => activeFilters[f.key]).length;
32:   return (
33:     <div ref={ref} className="relative">
34:       <button
35:         onClick={() => setOpen(!open)}
36:         className="px-2 py-1 rounded text-[11px] flex items-center gap-1.5 hover:opacity-80"
37:         style={{
38:           background: activeCount > 0 ? 'rgba(59,130,246,0.12)' : 'var(--bg-hover)',
39:           border: `1px solid ${activeCount > 0 ? '#3b82f6' : 'var(--border-color)'}`,
40:           color: activeCount > 0 ? '#3b82f6' : 'var(--text-primary)',
41:         }}
42:       >
43:         <span>🔍</span>
44:         <span className="font-bold">筛选</span>
45:         {activeCount > 0 && (
46:           <span className="px-1 rounded text-[10px]" style={{ background: '#3b82f6', color: '#fff' }}>
47:             {activeCount}
48:           </span>
49:         )}
50:         <span style={{ color: 'var(--text-muted)' }}>{open ? '▲' : '▼'}</span>
51:       </button>
52:       {open && (
53:         <div className="absolute right-0 top-full mt-1 z-30 rounded-lg shadow-2xl min-w-[260px] p-2"
54:           style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)' }}>
55:           <div className="text-[10px] mb-1 px-1" style={{ color: 'var(--text-muted)' }}>
56:             筛选条件（独立于分组和排序）
57:           </div>
58:           {FILTERS.map(f => (
