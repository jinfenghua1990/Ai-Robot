214:     }
215:     return report
216: def feat_high_turnover(flows):
217:     return float(flows[-1].turnover_rate) if flows and flows[-1].turnover_rate is not None else 0.0
218: def _ma_status(feat, price):
219:     if not feat:
220:         return "—"
221:     parts = []
222:     for label, val in [("MA5", feat.ma5), ("MA20", feat.ma20), ("MA60", feat.ma60)]:
223:         if val is not None:
224:             parts.append(f"{label}={val:.2f}")
225:     if not parts:
226:         return "—"
227:     above = price > max([v for v in [feat.ma5, feat.ma20, feat.ma60] if v is not None])
228:     trend = "站上" if above else "低于"
229:     return f"现价{price:.2f}{trend}短期均线（{', '.join(parts)}）"
230: def _tech_summary(feat, price):
231:     if not feat:
232:         return "无技术特征数据"
233:     bits = []
234:     if feat.rsi_14 is not None:
235:         rsi = feat.rsi_14
236:         zone = "超买" if rsi > 70 else ("超卖" if rsi < 30 else "中位偏强" if rsi > 50 else "中位偏弱")
237:         bits.append(f"RSI(14)={rsi:.1f}（{zone}）")
238:     if feat.ma5 is not None and feat.ma20 is not None:
239:         bits.append("MA5/MA20 " + ("多头排列" if feat.ma5 > feat.ma20 else "空头排列"))
240:     if feat.volume_ratio is not None:
241:         bits.append(f"量比{feat.volume_ratio:.2f}")
242:     if feat.market_state:
243:         bits.append(f"状态={feat.market_state}")
244:     return "；".join(bits) if bits else "技术特征数据不足"
245: def _build_money_flow(flows, klines):
246:     # 日期 -> 涨跌幅（来自 kline）
247:     pct_map = {}
248:     for k in klines:
249:         d = k.trade_date
250:         key = d.strftime("%Y%m%d") if isinstance(d, (datetime, date)) else str(d)
251:         pct_map[key] = float(k.pct_chg) if k.pct_chg is not None else 0.0
252:     trend = []
253:     for f in flows[-10:]:
254:         d = f.trade_date
255:         ds = d.strftime("%Y%m%d") if isinstance(d, (datetime, date)) else str(d)
256:         chg = pct_map.get(ds, 0.0)
257:         main = _yuan_to_yi(f.main_net)
258:         status = "流入" if (main or 0) > 0 else "流出"
259:         trend.append({
260:             "date": _mmdd(d),
261:             "main_net": _fmt_yi(f.main_net),
262:             "change": f"{chg:+.2f}%",
263:             "status": status,
264:         })
265:     def sum_n(n):
266:         sub = flows[-n:] if n <= len(flows) else flows
267:         return sum(float(x.main_net) for x in sub if x.main_net is not None)
268:     period_stats = {
269:         "1日": _fmt_yi(sum_n(1)),
270:         "3日": _fmt_yi(sum_n(3)),
271:         "5日": _fmt_yi(sum_n(5)),
272:         "10日": _fmt_yi(sum_n(10)),
273:     }
274:     today = flows[-1] if flows else None
275:     today_main = _yuan_to_yi(today.main_net) if today else None
276:     return {
277:         "today": {
278:             "main_net": _fmt_yi(today.main_net) if today else "—",
279:             "super_large": _fmt_yi(today.super_large_net) if today else "—",
280:             "large": _fmt_yi(today.large_net) if today else "—",
281:             "medium": _fmt_yi(today.medium_net) if today else "—",
282:             "small": _fmt_yi(today.small_net) if today else "—",
283:             "main_ratio": "—",
284:             "status": "主力净流入" if (today_main or 0) > 0 else "主力净流出",
285:         },
286:         "trend": trend,
287:         "period_stats": period_stats,
288:     }
289: def _derive_rating(price, target_price_val, feat):
290:     if target_price_val is not None and price > 0:
291:         if target_price_val > price * 1.10:
292:             return "买入", "中", f"券商目标价{target_price_val:.2f}较现价{price:.2f}高>10%"
293:         if target_price_val < price * 0.95:
294:             return "卖出", "中", f"券商目标价{target_price_val:.2f}较现价{price:.2f}低>5%"
295:         return "持有", "中", f"券商目标价{target_price_val:.2f}与现价{price:.2f}接近"
296:     # 无 F10：基于 PG 趋势的初步判断
297:     if feat and feat.ma5 is not None and feat.ma20 is not None:
298:         if price > feat.ma20 and (feat.main_net_inflow_5d or 0) > 0:
299:             return "持有", "低", "站上MA20且5日主力净流入为正（初步）"
300:         if price < feat.ma20:
301:             return "持有", "低", "跌破MA20（初步，偏谨慎）"
302:     return "持有", "低", "市场数据驱动的初步判断"
303: def _as_str(v):
304:     if v is None:
305:         return "—"
306:     return str(v)
307: def _key_points(price, change_pct, kline, money_flow, feat, rating_note):
308:     pts = [
309:         f"现价{price:.2f}（{change_pct:+.2f}%），60日区间{float(kline.get('change_pct',0)):+.2f}%（低{float(kline.get('low_60d',0))}→高{float(kline.get('high_60d',0))}）",
310:     ]
311:     mf10 = money_flow.get("period_stats", {}).get("10日", "—")
312:     pts.append(f"近10日主力净流入：{mf10}（PG stock_money_flow_detail）")
313:     if feat and feat.rsi_14 is not None:
314:         pts.append(f"RSI(14)={feat.rsi_14:.1f}，{_tech_summary(feat, price)}")
315:     pts.append(rating_note)
316:     return pts
317: def _bull_case(feat, money_flow, target_price_val, price):
318:     cases = []
319:     mf10 = money_flow.get("period_stats", {}).get("10日", "—")
320:     if "亿" in str(mf10) and not str(mf10).startswith("-"):
321:         cases.append(f"资金面偏强：近10日主力净流入{mf10}")
322:     if feat and feat.ma5 is not None and feat.ma20 is not None and feat.ma5 > feat.ma20:
323:         cases.append("技术多头：MA5 站上 MA20，短期趋势向上")
324:     if target_price_val and price and target_price_val > price:
325:         cases.append(f"估值空间：券商一致目标价{target_price_val:.2f}高于现价{price:.2f}")
326:     if not cases:
327:         cases.append("PG 盘后市场数据完整，可结合 F10 补全后进一步判断")
328:     return cases
329: def _bear_case(feat, kline, target_price_val, price):
330:     cases = []
331:     mf10 = kline.get("change_pct", 0)
332:     if isinstance(mf10, (int, float)) and mf10 > 40:
333:         cases.append(f"短期涨幅大：60日已涨{mf10:.1f}%，追高回撤风险")
334:     if feat and feat.ma5 is not None and feat.ma20 is not None and feat.ma5 < feat.ma20:
335:         cases.append("技术偏弱：MA5 跌破 MA20")
336:     if not f10.is_configured():
337:         cases.append("F10 财务/评级未补全，估值安全边际无法评估")
338:     if not cases:
339:         cases.append("需 F10 补全以评估盈利质量与估值风险")
340:     return cases
341: # ---------- 队列消费 ----------
342: def process_request(rid: str) -> bool:
343:     """处理单个请求：生成报告→落库→改状态。返回是否成功。"""
344:     with SessionLocal() as db:
345:         req = db.get(AnalysisRequest, rid)
346:         if not req or req.status in ("completed", "processing"):
347:             return False
348:         req.status = "processing"
349:         req.updated_at = datetime.now()
350:         db.commit()
351:         try:
352:             report = build_report_from_pg(req.stock_code, req.stock_name, req.source)
353:             report["id"] = rid
354:             rep = AnalysisReport(
355:                 id=rid,
356:                 stock_code=req.stock_code,
357:                 stock_name=req.stock_name,
358:                 source=req.source,
359:                 report_type=report.get("report_type", ""),
360:                 rating=report.get("summary", {}).get("rating", ""),
361:                 target_price=str(report.get("summary", {}).get("target_price", "")),
362:                 confidence=report.get("summary", {}).get("confidence", ""),
363:                 report_json=json.dumps(report, ensure_ascii=False),
364:             )
365:             db.merge(rep)
366:             # 通知
367:             from db.models import Notification
368:             notif = Notification(
369:                 id=f"notif_{rid}",
370:                 source=req.source,
371:                 stock_code=req.stock_code,
372:                 stock_name=req.stock_name,
373:                 title=f"{req.stock_name}({req.stock_code}) 个股分析报告",
374:                 read=False,
375:                 created_at=datetime.now(),
376:             )
377:             db.merge(notif)
378:             req.status = "completed"
379:             req.updated_at = datetime.now()
380:             db.commit()
381:             logger.info("[analysis_consumer] 完成 %s %s", rid, req.stock_code)
382:             return True
383:         except Exception as e:
384:             db.rollback()
385:             req.status = "failed"
386:             req.error = str(e)[:500]
387:             req.updated_at = datetime.now()
388:             db.commit()
389:             logger.exception("[analysis_consumer] 失败 %s: %s", rid, e)
390:             return False
391: def process_pending(limit: int = 20) -> int:
392:     """轮询并处理 pending 请求，返回处理数量。"""
393:     with SessionLocal() as db:
394:         rows = db.execute(
395:             select(AnalysisRequest).where(AnalysisRequest.status == "pending")
396:             .order_by(AnalysisRequest.created_at.asc()).limit(limit)
397:         ).scalars().all()
398:         pending_ids = [r.id for r in rows]
399:     done = 0
400:     for rid in pending_ids:
401:         try:
402:             if process_request(rid):
403:                 done += 1
404:         except Exception as e:
405:             logger.warning("[analysis_consumer] process %s error: %s", rid, e)
406:     return done
