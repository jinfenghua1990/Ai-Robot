452: def _check_freshness(data_date, today, is_trading_day, last_trade_day, category):
453:     """检查盘后数据新鲜度"""
454:     if data_date is None:
455:         return {"status": "error", "delay_days": 99, "message": "无数据", "expected_date": None}
456:     expected = today if is_trading_day and datetime.now().hour >= 16 else last_trade_day
457:     delay = _trading_day_diff(today, data_date)
458:     if data_date >= expected:
459:         return {"status": "fresh", "delay_days": 0, "message": "最新", "expected_date": expected.isoformat()}
460:     elif delay <= 1:
461:         return {"status": "stale", "delay_days": delay, "message": f"滞后{delay}个交易日", "expected_date": expected.isoformat()}
462:     else:
463:         return {"status": "stale", "delay_days": delay, "message": f"严重滞后{delay}个交易日", "expected_date": expected.isoformat()}
464: def _check_realtime_freshness(data_date, snapshot_time, today, now, is_trading_hours):
465:     """检查实时数据新鲜度"""
466:     if data_date is None:
467:         return {"status": "error", "delay_days": 99, "message": "无数据", "expected_date": None}
468:     delay = _trading_day_diff(today, data_date)
469:     if delay > 0:
470:         return {"status": "stale", "delay_days": delay, "message": f"数据日期滞后{delay}天", "expected_date": today.isoformat()}
471:     # 盘中检查快照时间
472:     if is_trading_hours and snapshot_time:
473:         minutes_ago = (now.hour * 60 + now.minute) - (snapshot_time.hour * 60 + snapshot_time.minute)
474:         if minutes_ago > 10:
475:             return {"status": "stale", "delay_days": 0, "message": f"盘中快照已{minutes_ago}分钟未更新", "expected_date": today.isoformat()}
476:         return {"status": "fresh", "delay_days": 0, "message": "盘中实时", "expected_date": today.isoformat()}
477:     return {"status": "fresh", "delay_days": 0, "message": "最新", "expected_date": today.isoformat()}
478: def _check_runtime_freshness(updated_at, now, hours=24):
479:     """检查运行时数据新鲜度"""
480:     if updated_at is None:
481:         return {"status": "error", "delay_days": 99, "message": "无数据", "expected_date": None}
482:     diff = now - updated_at
483:     if diff.total_seconds() < hours * 3600:
484:         return {"status": "fresh", "delay_days": 0, "message": "最新", "expected_date": None}
485:     else:
486:         days = int(diff.total_seconds() / 86400)
487:         return {"status": "stale", "delay_days": days, "message": f"{days}天未更新", "expected_date": None}
