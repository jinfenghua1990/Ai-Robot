188: def _get_index_constituents(ts_code: str, index_type: str) -> list:
189:     """从 akshare 获取指数成分股列表，返回 [ts_code, ...]
190:     index_type: 'cni' 调用 index_detail_cni; 'csi' 调用 index_stock_cons_weight_csindex
191:     """
192:     if not AKSHARE_AVAILABLE or not ak:
193:         return []
194:     cache_key = f'{ts_code}:{index_type}'
195:     cached = _constituent_cache.get(cache_key)
196:     if cached and time.time() - cached['ts'] < _CONSTITUENT_CACHE_TTL:
197:         return cached['members']
198:     raw_code = ts_code.split('.')[0]
199:     members = []
200:     try:
201:         if index_type == 'cni':
202:             df = ak.index_detail_cni(symbol=raw_code)
203:             codes = df['样本代码'].astype(str).str.zfill(6).tolist()
204:         elif index_type == 'csi':
205:             df = ak.index_stock_cons_weight_csindex(symbol=raw_code)
206:             codes = df['成分券代码'].astype(str).str.zfill(6).tolist()
207:         else:
208:             codes = []
209:         for c in codes:
210:             if c.startswith('6') or c.startswith('8') or c.startswith('9'):
211:                 members.append(f'{c}.SH')
212:             else:
213:                 members.append(f'{c}.SZ')
214:     except Exception as e:
215:         logger.warning(f'[index_flow] 获取 {ts_code} 成分股失败: {e}')
216:         return []
217:     _constituent_cache[cache_key] = {'members': members, 'ts': time.time()}
218:     return members
219: def _build_member_filter(idx_def: dict):
220:     """根据指数定义构建成员过滤条件（SQLAlchemy expression）"""
221:     members = idx_def.get('members')
222:     # 行业主题指数：动态获取成分股
223:     if not members and idx_def.get('type') in ('cni', 'csi'):
224:         members = _get_index_constituents(idx_def['ts_code'], idx_def['type'])
225:     if members:
226:         return StockFlow.ts_code.in_(members)
227:     elif idx_def.get('prefix'):
228:         prefix = idx_def['prefix']
229:         if len(prefix) == 1:
230:             return StockFlow.ts_code.like(f'{prefix[0]}%')
231:         else:
232:             return or_(*[StockFlow.ts_code.like(f'{p}%') for p in prefix])
233:     return None
234: def _aggregate_index_from_db(idx_def: dict, db, latest_n_days: int = 22) -> dict:
235:     """从 stock_flow 表聚合单个指数最近 N 天的资金流向
236:     返回：{ts_code, name, dates: [...], main_net: [...], cumulative: [...],
237:            inflow_1d, inflow_3d, inflow_5d, inflow_10d, inflow_22d, close, pct_change, member_count}
238:     """
239:     member_filter = _build_member_filter(idx_def)
240:     if member_filter is None:
241:         return None
242:     # 取最近 N 个交易日的数据，按 trade_date 聚合
243:     rows = db.query(
244:         StockFlow.trade_date,
245:         func.sum(StockFlow.main_force_inflow).label('main_net'),
246:         func.avg(StockFlow.price_chg).label('avg_chg'),
247:         func.avg(StockFlow.price).label('avg_close'),
248:         func.count('*').label('member_count'),
249:     ).filter(member_filter).group_by(
250:         StockFlow.trade_date
251:     ).order_by(
252:         StockFlow.trade_date.desc()
253:     ).limit(latest_n_days).all()
254:     if not rows:
255:         return None
256:     # rows 是倒序，反转为正序
257:     rows = list(reversed(rows))
258:     dates = [r.trade_date.strftime('%Y-%m-%d') if hasattr(r.trade_date, 'strftime') else str(r.trade_date) for r in rows]
259:     # main_force_inflow 字段在 DB 中单位是「万元」，统一转换为「元」与东方财富 API 一致
260:     _YI_TO_YUAN = 1e4
261:     main_nets = [float(r.main_net or 0) * _YI_TO_YUAN for r in rows]
262:     avg_chgs = [float(r.avg_chg or 0) for r in rows]
263:     avg_closes = [float(r.avg_close or 0) for r in rows]
264:     member_counts = [int(r.member_count or 0) for r in rows]
265:     # 累计净流入
266:     cumulative = []
267:     total = 0
268:     for v in main_nets:
269:         total += v
270:         cumulative.append(total)
271:     # 取最新日数据
272:     latest_row = rows[-1]
273:     latest_close = avg_closes[-1] if avg_closes else None
274:     latest_pct = avg_chgs[-1] if avg_chgs else None
275:     # 1/3/5/10 日累计主力净流入
276:     def _sum_last(n):
277:         return sum(main_nets[-n:]) if len(main_nets) >= n else sum(main_nets)
278:     return {
279:         'ts_code': idx_def['ts_code'],
280:         'name': idx_def['name'],
281:         'dates': dates,
282:         'main_net': main_nets,
283:         'cumulative': cumulative,
284:         'inflow_1d': _sum_last(1),
285:         'inflow_3d': _sum_last(3),
286:         'inflow_5d': _sum_last(5),
287:         'inflow_10d': _sum_last(10),
288:         'inflow_22d': _sum_last(22),
289:         'close': latest_close,
290:         'pct_change': latest_pct,
291:         'member_count': member_counts[-1] if member_counts else 0,
292:         'latest_date': dates[-1] if dates else None,
293:     }
