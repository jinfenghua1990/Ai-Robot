<file path="backend/utils/slow_query_logger.py">
 1: """SQLAlchemy 慢查询监听器
 2: - 不需要 PostgreSQL superuser 权限
 3: - 在应用层捕获 >200ms 的 SQL，记录到 logger
 4: - 启用方式：在 main.py 中 import 一次即可
 5: """
 6: import time
 7: import logging
 8: from sqlalchemy import event
 9: from db.connection import engine
10: logger = logging.getLogger('slow_query')
11: SLOW_THRESHOLD_MS = 200
12: @event.listens_for(engine, 'before_cursor_execute')
13: def _before_cursor_execute(conn, cursor, statement, parameters, context, executemany):
14:     context._query_start_time = time.time()
15: @event.listens_for(engine, 'after_cursor_execute')
16: def _after_cursor_execute(conn, cursor, statement, parameters, context, executemany):
17:     if not hasattr(context, '_query_start_time'):
18:         return
19:     elapsed_ms = (time.time() - context._query_start_time) * 1000
20:     if elapsed_ms > SLOW_THRESHOLD_MS:
21:         # 截断 SQL 避免日志过长
22:         sql_short = statement[:300].replace('\n', ' ')
23:         if len(statement) > 300:
24:             sql_short += '...'
25:         logger.warning(
26:             f'[slow_query] {elapsed_ms:.0f}ms | {sql_short} | params={str(parameters)[:100]}'
27:         )
