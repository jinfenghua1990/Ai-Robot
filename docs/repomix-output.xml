<file path="frontend/src/components/MarketStageBar.jsx">
  1: /**
  2:  * 市场情绪阶段条 — 显示当前市场处于 6 阶段中的哪个阶段
  3:  * 6 阶段: 冰点 → 修复 → 发酵 → 高潮 → 分歧 → 退潮
  4:  * 每阶段对应仓位建议: 2-3成 / 4成 / 6成 / 7成 / 4-5成 / 3成
  5:  *
  6:  * 数据源: /api/market-stage (从 StockFlow 实时统计)
  7:  */
  8: import { useState, useEffect } from 'react';
  9: import { apiFetch } from '../utils/request';
 10: const STAGE_ORDER = ['冰点', '修复', '发酵', '高潮', '分歧', '退潮'];
 11: const STAGE_COLORS = {
 12:   '冰点': '#3b82f6',
 13:   '修复': '#06b6d4',
 14:   '发酵': '#f59e0b',
 15:   '高潮': '#ef4444',
 16:   '分歧': '#a855f7',
 17:   '退潮': '#6b7280',
 18: };
 19: export default function MarketStageBar({ date }) {
 20:   const [data, setData] = useState(null);
 21:   const [loading, setLoading] = useState(false);
 22:   useEffect(() => {
 23:     let cancelled = false;
 24:     const load = async () => {
 25:       setLoading(true);
 26:       const url = date ? `/api/market-stage?date=${date}` : '/api/market-stage';
 27:       const { ok, data: d } = await apiFetch(url);
 28:       if (!cancelled) {
 29:         if (ok) setData(d);
 30:         setLoading(false);
 31:       }
 32:     };
 33:     load();
 34:     return () => { cancelled = true; };
 35:   }, [date]);
 36:   if (loading && !data) {
 37:     return (
 38:       <div className="rounded-lg p-3 animate-pulse" style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)', height: 80 }} />
 39:     );
 40:   }
 41:   if (!data || data.error) {
 42:     return (
 43:       <div className="rounded-lg p-3 text-xs" style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)', color: 'var(--text-muted)' }}>
 44:         市场情绪阶段数据暂不可用{data?.error ? `: ${data.error}` : ''}
 45:       </div>
 46:     );
 47:   }
 48:   const { stage, score, description, position, color, signals = [], drivers = [], metrics = {}, trade_date } = data;
 49:   const currentIdx = STAGE_ORDER.indexOf(stage);
 50:   const tooltip = [
 51:     `📅${trade_date || ''}`,
 52:     `阶段:${stage} (得分${score})`,
 53:     description,
 54:     position ? `建议仓位:${position}` : '',
 55:     metrics.limit_up != null ? `涨停:${metrics.limit_up} 跌停:${metrics.limit_down || 0} 炸板:${metrics.broken || 0}` : '',
 56:     metrics.up != null ? `上涨:${metrics.up} 下跌:${metrics.down} 平盘:${metrics.flat || 0}` : '',
 57:     metrics.heat_value != null ? `热度:${metrics.heat_value}` : '',
 58:     metrics.broken_rate != null ? `炸板率:${(metrics.broken_rate * 100).toFixed(1)}%` : '',
 59:     signals.length ? `信号:${signals.join('、')}` : '',
 60:   ].filter(Boolean).join(' | ');
 61:   return (
 62:     <div className="rounded-lg p-3" style={{ background: 'var(--bg-card)', border: `1px solid ${color}40` }} title={tooltip}>
 63:       {/* 阶段进度条 */}
 64:       <div className="flex items-center gap-1 mb-2">
 65:         {STAGE_ORDER.map((s, i) => {
 66:           const isActive = i === currentIdx;
 67:           const isPassed = i < currentIdx;
 68:           const sColor = STAGE_COLORS[s];
 69:           return (
 70:             <div
 71:               key={s}
 72:               className="flex-1 text-center py-1 px-2 rounded text-[11px] font-bold transition-all"
 73:               style={{
 74:                 background: isActive ? sColor : (isPassed ? `${sColor}20` : 'var(--bg-secondary)'),
 75:                 color: isActive ? '#fff' : (isPassed ? sColor : 'var(--text-muted)'),
 76:                 border: `1px solid ${isActive ? sColor : 'transparent'}`,
 77:                 transform: isActive ? 'scale(1.05)' : 'scale(1)',
 78:               }}
 79:               title={s}
 80:             >
 81:               {s}
 82:             </div>
 83:           );
 84:         })}
 85:       </div>
 86:       {/* 当前阶段详情 */}
 87:       <div className="flex items-center justify-between flex-wrap gap-2">
 88:         <div className="flex items-center gap-3">
 89:           <div className="text-lg font-bold" style={{ color }}>
 90:             {stage} <span className="text-sm">({score}分)</span>
 91:           </div>
 92:           <div className="text-xs" style={{ color: 'var(--text-secondary)' }}>
 93:             {description}
 94:           </div>
 95:         </div>
 96:         <div className="flex items-center gap-2">
 97:           {position && (
 98:             <span className="px-2 py-1 rounded text-xs font-bold" style={{ background: `${color}20`, color, border: `1px solid ${color}40` }}>
 99:               💰 建议仓位 {position}
100:             </span>
101:           )}
102:           {metrics.limit_up != null && (
103:             <span className="text-[11px]" style={{ color: 'var(--text-muted)' }}>
104:               涨停 <b style={{ color: '#ef4444' }}>{metrics.limit_up}</b> · 跌停 <b style={{ color: '#22c55e' }}>{metrics.limit_down || 0}</b> · 上涨 <b style={{ color: '#ef4444' }}>{metrics.up}</b> · 下跌 <b style={{ color: '#22c55e' }}>{metrics.down}</b> · 热度 <b style={{ color }}>{metrics.heat_value}</b>
105:             </span>
106:           )}
107:         </div>
108:       </div>
109:       {/* 信号标签 */}
110:       {signals.length > 0 && (
111:         <div className="flex flex-wrap gap-1 mt-2">
112:           {signals.slice(0, 6).map((sig, i) => (
113:             <span key={i} className="px-1.5 py-0.5 rounded text-[10px]" style={{ background: 'var(--bg-secondary)', color: 'var(--text-secondary)' }}>
114:               {sig}
115:             </span>
116:           ))}
117:         </div>
118:       )}
119:     </div>
120:   );
121: }
</file>

