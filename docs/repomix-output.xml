  1: """
  2: 扩展数据源采集器 - 7个新数据源统一采集
  3: 包含: efinance / qstock / adata / mootdx / 同花顺 / 网易财经 / 巨潮资讯
  4: 每个数据源都实现: 批量行情 + 资金流向（如支持）
  5: 所有函数都有try-except保护，出错不影响其他数据源
  6: """
  7: import logging
  8: import os, time, json, traceback
  9: from datetime import datetime
 10: import requests
 11: from utils.http_constants import clear_proxy_env
 12: clear_proxy_env()
 13: logger = logging.getLogger(__name__)
 14: # 出错率统计（内存中，定期持久化）
 15: _error_stats = {}  # {source: {'total': 0, 'errors': 0, 'last_error': ''}}
 16: def _record_call(source, success, error=''):
 17:     """记录数据源调用统计"""
 18:     if source not in _error_stats:
 19:         _error_stats[source] = {'total': 0, 'errors': 0, 'last_error': '', 'last_success': None}
 20:     _error_stats[source]['total'] += 1
 21:     if success:
 22:         _error_stats[source]['last_success'] = datetime.now().isoformat()
 23:     else:
 24:         _error_stats[source]['errors'] += 1
 25:         _error_stats[source]['last_error'] = error[:200]
 26: def get_error_stats():
 27:     """获取出错率统计"""
 28:     result = {}
 29:     for src, stats in _error_stats.items():
 30:         total = stats['total']
 31:         errors = stats['errors']
 32:         result[src] = {
 33:             'total_calls': total,
 34:             'errors': errors,
 35:             'error_rate': round(errors / total * 100, 1) if total > 0 else 0,
 36:             'last_error': stats['last_error'],
 37:             'last_success': stats['last_success'],
 38:         }
 39:     return result
 40: def _ts_to_code(ts_code):
 41:     """ts_code(000001.SZ) → 6位代码"""
 42:     return ts_code.replace('.SH', '').replace('.SZ', '').replace('.BJ', '')
 43: # ============================================================
 44: # 1. efinance - 基于东财的开源库
 45: # ============================================================
 46: def efinance_batch_quotes(ts_codes):
 47:     """efinance批量行情（逐个获取，限制20只）"""
 48:     try:
 49:         import efinance as ef
 50:         result = {}
 51:         for tc in ts_codes[:20]:
 52:             try:
 53:                 code = _ts_to_code(tc)
 54:                 s = ef.stock.get_quote_snapshot(code)
 55:                 if s is not None and '最新价' in s.index:
 56:                     result[tc] = {
 57:                         'price': float(s.get('最新价', 0) or 0),
 58:                         'price_chg': float(s.get('涨跌幅', 0) or 0),
 59:                     }
 60:             except Exception:
 61:                 logger.debug(f"efinance_batch_quotes item failed", exc_info=True)
 62:                 continue
 63:         _record_call('efinance', True)
 64:         return result
 65:     except Exception as e:
 66:         _record_call('efinance', False, str(e))
 67:         return {}
 68: def efinance_fund_flow(ts_code):
 69:     """efinance资金流向"""
 70:     try:
 71:         import efinance as ef
 72:         code = _ts_to_code(ts_code)
 73:         df = ef.stock.get_today_bill(code)
 74:         if df is None or df.empty:
 75:             _record_call('efinance', False, 'no fund flow data')
 76:             return None
 77:         latest = df.iloc[-1]
 78:         result = {
 79:             'main_force_inflow': float(latest.get('主力净流入-净额', 0) or 0) / 10000,
 80:         }
 81:         _record_call('efinance', True)
 82:         return result
 83:     except Exception as e:
 84:         _record_call('efinance', False, str(e))
 85:         return None
 86: # ============================================================
 87: # 2. qstock - 整合多源的开源库
 88: # ============================================================
 89: def qstock_batch_quotes(ts_codes):
 90:     """qstock批量行情"""
 91:     try:
 92:         import qstock as qs
 93:         codes = [_ts_to_code(c) for c in ts_codes[:50]]  # 限制50只
 94:         df = qs.realtime_data(codes)
 95:         if df is None or df.empty:
 96:             _record_call('qstock', False, 'empty data')
 97:             return {}
 98:         result = {}
 99:         for _, row in df.iterrows():
100:             code = str(row.get('代码', ''))
101:             ts_code = None
102:             for tc in ts_codes:
103:                 if _ts_to_code(tc) == code:
104:                     ts_code = tc
105:                     break
106:             if ts_code:
107:                 result[ts_code] = {
108:                     'price': float(row.get('最新价', 0) or 0),
109:                     'price_chg': float(row.get('涨跌幅', 0) or 0),
110:                 }
111:         _record_call('qstock', True)
112:         return result
113:     except Exception as e:
114:         _record_call('qstock', False, str(e))
115:         return {}
116: def qstock_fund_flow(ts_code):
117:     """qstock资金流向"""
118:     try:
119:         import qstock as qs
120:         code = _ts_to_code(ts_code)
121:         df = qs.data_fund_flow(code)
122:         if df is None or df.empty:
123:             _record_call('qstock', False, 'no fund flow data')
124:             return None
125:         latest = df.iloc[-1]
126:         result = {
127:             'main_force_inflow': float(latest.get('主力净流入-净额', 0) or 0) / 10000,
128:         }
129:         _record_call('qstock', True)
130:         return result
131:     except Exception as e:
132:         _record_call('qstock', False, str(e))
133:         return None
134: # ============================================================
135: # 3. adata - 聚合多源数据
136: # ============================================================
137: def adata_batch_quotes(ts_codes):
138:     """adata批量行情"""
139:     try:
140:         import adata
141:         codes = [_ts_to_code(c) for c in ts_codes[:50]]
142:         result = {}
143:         for code in codes:
144:             try:
145:                 df = adata.stock.market.get_market(stock_code=code, k_type=1)
146:                 if df is not None and not df.empty:
147:                     latest = df.iloc[-1]
148:                     ts_code = None
149:                     for tc in ts_codes:
150:                         if _ts_to_code(tc) == code:
151:                             ts_code = tc
152:                             break
153:                     if ts_code:
154:                         result[ts_code] = {
155:                             'price': float(latest.get('close', 0) or 0),
156:                             'price_chg': float(latest.get('pct_chg', 0) or 0),
157:                         }
158:             except Exception:
159:                 logger.debug(f"adata_batch_quotes item failed", exc_info=True)
160:                 continue
161:         _record_call('adata', True)
162:         return result
163:     except Exception as e:
164:         _record_call('adata', False, str(e))
165:         return {}
166: # ============================================================
167: # 4. mootdx - 通达信TCP增强版（pytdx降级）
168: # ============================================================
169: _mootdx_reader = None
170: _mootdx_use_pytdx = None  # None=未检测, True=用pytdx, False=不可用
171: def _get_mootdx_reader():
172:     """获取mootdx Reader实例（单例），优先mootdx，降级pytdx"""
173:     global _mootdx_reader, _mootdx_use_pytdx
174:     if _mootdx_reader is not None:
175:         return _mootdx_reader
176:     # 尝试mootdx
177:     try:
178:         from mootdx.reader import Reader
179:         _mootdx_reader = Reader.factory(market='std', tdxdir=None)
180:         return _mootdx_reader
181:     except Exception as e:
182:         logger.debug(f'[extended] mootdx 不可用，降级到 pytdx: {e}')
183:     # 降级：用pytdx TCP（已在tdx_collector中可用）
184:     try:
185:         from pytdx.hq import TdxHq_API
186:         _mootdx_use_pytdx = True
187:         _mootdx_reader = 'pytdx'  # 标记使用pytdx
188:         return _mootdx_reader
189:     except Exception:
190:         logger.debug(f"_get_mootdx_reader fallback", exc_info=True)
191:         _mootdx_reader = False
192:         return None
193: def mootdx_batch_quotes(ts_codes):
194:     """mootdx批量行情（优先mootdx，降级pytdx TCP）"""
195:     try:
196:         reader = _get_mootdx_reader()
197:         if not reader:
198:             _record_call('mootdx', False, 'no mootdx or pytdx available')
199:             return {}
200:         # pytdx TCP降级模式
201:         if _mootdx_use_pytdx:
202:             from collectors.tdx_collector import connect_with_retry
203:             api, server = connect_with_retry()
204:             if not api:
205:                 _record_call('mootdx', False, 'pytdx connect failed')
206:                 return {}
207:             result = {}
208:             for ts_code in ts_codes[:30]:
209:                 try:
210:                     code = _ts_to_code(ts_code)
211:                     market = 0 if ts_code.endswith('.SZ') else 1  # 0=深圳, 1=上海
212:                     quotes = api.get_security_quotes([(market, code)])
213:                     if quotes:
214:                         q = quotes[0]
215:                         price = float(q.get('price', 0) or q.get('last_close', 0) or 0)
216:                         pre_close = float(q.get('last_close', 0) or 0)
217:                         pct_chg = ((price - pre_close) / pre_close * 100) if pre_close > 0 else 0
218:                         result[ts_code] = {
219:                             'price': price,
220:                             'price_chg': round(pct_chg, 2),
221:                         }
222:                 except Exception:
223:                     logger.debug(f"function item failed", exc_info=True)
224:                     continue
225:                 api.disconnect()
226:             if result:
227:                 _record_call('mootdx', True)
228:             else:
229:                 _record_call('mootdx', False, 'pytdx no data')
230:             return result
231:         # mootdx原生模式
232:         result = {}
233:         for ts_code in ts_codes[:30]:
234:             try:
235:                 code = _ts_to_code(ts_code)
236:                 market = 'sz' if ts_code.endswith('.SZ') else 'sh'
237:                 df = reader.minute(symbol=f'{market}{code}')
238:                 if df is not None and not df.empty:
239:                     latest = df.iloc[-1]
240:                     result[ts_code] = {
241:                         'price': float(latest.get('price', 0) or 0),
242:                     }
243:             except Exception:
244:                 logger.debug(f"function item failed", exc_info=True)
245:                 continue
246:         _record_call('mootdx', True)
247:         return result
248:     except Exception as e:
249:         _record_call('mootdx', False, str(e))
250:         return {}
251: # ============================================================
252: # 5. 同花顺 - HTTP API
253: # ============================================================
254: def ths_fund_flow_rank():
255:     """同花顺资金流向排名（批量）"""
256:     try:
257:         url = 'https://data.10jqka.com.cn/funds/zijin/field/zdf/order/desc/page/1/ajax/1/free/1/'
258:         headers = {
259:             'User-Agent': 'Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7)',
260:             'Referer': 'https://data.10jqka.com.cn/',
261:         }
262:         resp = requests.get(url, headers=headers, timeout=10)
263:         if resp.status_code != 200:
264:             _record_call('ths', False, f'HTTP {resp.status_code}')
265:             return {}
266:         # 解析HTML表格
267:         import pandas as pd
268:         tables = pd.read_html(resp.text)
269:         if not tables:
270:             _record_call('ths', False, 'no tables')
271:             return {}
272:         df = tables[0]
273:         result = {}
274:         for _, row in df.iterrows():
275:             try:
276:                 code = str(row.get('代码', '')).zfill(6)
277:                 if code.startswith('6'):
278:                     ts_code = f'{code}.SH'
279:                 elif code.startswith(('0', '3')):
280:                     ts_code = f'{code}.SZ'
281:                 else:
282:                     continue
283:                 main_flow = float(row.get('主力净流入-净额', 0) or 0)
284:                 result[ts_code] = {
285:                     'main_force_inflow': main_flow / 10000,  # 元→万元
286:                 }
287:             except Exception:
288:                 logger.debug(f"function item failed", exc_info=True)
289:                 continue
290:         _record_call('ths', True)
291:         return result
292:     except Exception as e:
293:         _record_call('ths', False, str(e))
