  1: from typing import Optional, Dict, Any
  2: """
  3: 龙头引擎（Level 3，完整生命周期驱动版）
  4: 职责：在可交易板块内，基于「实时计算」识别龙头、评分、选取主龙和候选，
  5: 并具备跨日记忆——跟踪主龙处于 蓄势→突破→主升→分歧→衰退 哪一阶段演进，
  6: 识别板块轮动、主龙走弱时触发衰退预警并排序接棒候选。
  7: ⚠️ 本引擎不再读取 LeaderLifecycle 预计算表（那是当日涨停股的静态标签，
  8:    strength/stage/连板 写死且从未演进，无法真实反映龙头）。
  9: 真实数据来源：
 10: - StockFeaturesDaily：个股每日真实特征（均线/RSI/量比/主力净流入/趋势一致性…）
 11: - StockFlow：真实涨幅(price_chg)、真实主力净流入(main_force_inflow)、板块、名称
 12: - StockDailyKline：真实连板天数（近 N 日连续涨停计数）
 13: - sector_engine.get_sector_ranking：可交易板块（强势/轮动）
 14: - LeaderTrack：跨日状态记忆（当前主龙 + 近 N 日阶段演进轨迹）
 15: 评分维度（0-10分），全部基于实时计算：
 16: - 技术形态 technical       → 3分（破位→顶部 7 段）
 17: - 主力资金 mainForce      → 2分
 18: - 资金动能 momentum       → 2分
 19: - 情绪温度 sentiment      → 1分
 20: - 真实涨幅 change_rate    → 1分
 21: - 真实连板 consecutive_days→ 1分
 22: - 板块内排名 sector_rank  → 0.5分
 23: 主龙选取：score ≥ 7 的第一名（结合跨日状态与衰退预警）
 24: 候选龙：接棒排序前 3（score ≥ 4 且 phase 处于 突破/主升/rising）
 25: 切换规则：新龙头评分比当前高 1.5 分以上 + 涨幅更强，或当前走弱而新龙头处于上升期；
 26:           或当前主龙进入衰退（phase=衰退 / phase_trend=falling 且评分回落）时触发接棒
 27: """
 28: import json
 29: from collections import defaultdict
 30: from datetime import datetime, date, timedelta
 31: from sqlalchemy import desc, func, between
 32: from db.session import get_db_session
 33: from db.models import (
 34:     StockFeaturesDaily, StockFlow, SectorFlow, StockDailyKline, LeaderTrack,
 35: )
 36: from analyzers.sector_engine import get_sector_ranking
 37: from analyzers.stock_scores import (
 38:     calc_sentiment, calc_risk, calc_momentum, calc_main_force, calc_technical,
 39: )
 40: # ===== 工具函数 =====
 41: def _clamp(v, lo=0, hi=100):
 42:     return max(lo, min(hi, v))
 43: def _features_to_dict(f) -> dict:
 44:     """把 StockFeaturesDaily ORM 对象转成 stock_scores 所需的 features dict（真实值）"""
 45:     return {
 46:         'rsi_14': f.rsi_14,
 47:         'volume_ratio': f.volume_ratio,
 48:         'close_vs_ma20': f.close_vs_ma20,
 49:         'higher_high_flag': f.higher_high_flag,
 50:         'higher_low_flag': f.higher_low_flag,
 51:         'trend_consistency_score': f.trend_consistency_score,
 52:         'ma20_slope': f.ma20_slope,
 53:         'main_net_inflow_3d': f.main_net_inflow_3d,
 54:         'flow_continuity': f.flow_continuity,
 55:         'sector_strength': f.sector_strength,
 56:         'noise_ratio': f.noise_ratio,
 57:         'atr_14': f.atr_14,
 58:     }
 59: def _build_sector_trend(sf) -> dict:
 60:     """把 SectorFlow 真实聚合数据转成 calc_* 所需的 sector_trend dict 形状"""
 61:     if sf is None:
 62:         return None
 63:     net = float(sf.net_flow or 0)
 64:     rise = float(sf.rise_ratio or 0)
 65:     avg = float(sf.avg_chg or 0)
 66:     return {
 67:         'available': True,
 68:         'latest_heat': _clamp(50 + avg * 3, 0, 100),
 69:         'flow_direction': 'inflow' if net > 0 else ('outflow' if net < 0 else 'stable'),
 70:         'total_net_flow': net,
 71:         'rise_ratio': rise,
 72:         'heat_trend': 'stable',
 73:         'sector_strength': avg,
 74:     }
 75: def _compute_consecutive_limit_up(kmap: dict, ts_code: str, target_obj: date) -> int:
 76:     """真实连板天数：从 StockDailyKline 近 N 日记录里，自 target_date 向前数连续涨停日数。
 77:     涨停判定：pct_chg >= 9.5（主板 10% 阈值，留出误差）。
 78:     """
 79:     recs = sorted(kmap.get(ts_code, []), key=lambda x: x[0])
 80:     count = 0
 81:     for d, pct in reversed(recs):
 82:         if d > target_obj:
 83:             continue
 84:         if pct >= 9.5:
 85:             count += 1
 86:         else:
 87:             break
 88:     return count
 89: # ===== 技术形态映射（与前端 STAGE_COLORS 一致：破位/弱势/震荡/偏多/多头/突破/顶部） =====
 90: def _technical_stage_from_features(cv: float, tc: float, hh: int, rsi: float) -> str:
 91:     """基于真实特征合成当日技术形态（7 段）。"""
 92:     if cv <= -0.08:
 93:         return '破位'
 94:     if cv <= -0.02:
 95:         return '弱势'
 96:     if cv < 0.03:
 97:         return '震荡'
 98:     if cv < 0.08:
 99:         return '偏多'
100:     if cv < 0.15:
101:         return '多头'
102:     if hh == 1 or cv >= 0.15:
103:         return '突破'
104:     if rsi >= 80:
105:         return '顶部'
106:     return '多头'
107: # ===== 阶段演进（历史 N 日回溯） =====
108: def calc_lifecycle(stock_code: str, db, target_date: date, n: int = 12):
109:     """基于近 n 日真实特征(StockFeaturesDaily)回溯个股生命周期阶段与演进趋势。
110:     Args:
111:         stock_code: 6 位代码
112:         db: 数据库会话
113:         target_date: 目标日期
114:         n: 回溯交易日数
115:     Returns:
116:         dict: {
117:             'phase': '蓄势'|'突破'|'主升'|'分歧'|'衰退',
118:             'phase_trend': 'rising'|'flat'|'falling',
119:             'track': [ {date, technical_stage, score, close_vs_ma20, consecutive_days}, ... ],
120:             'technical_stage': 最新技术形态,
121:         }
122:     """
123:     end = target_date
124:     start = target_date - timedelta(days=n)
125:     feats = db.query(StockFeaturesDaily).filter(
126:         StockFeaturesDaily.stock_code == stock_code,
127:         StockFeaturesDaily.trade_date.between(start.strftime('%Y%m%d'), end.strftime('%Y%m%d')),
128:     ).order_by(StockFeaturesDaily.trade_date).all()
129:     if not feats:
130:         return {'phase': '蓄势', 'phase_trend': 'flat', 'track': [], 'technical_stage': '震荡'}
131:     track = []
132:     for f in feats:
133:         cv = float(f.close_vs_ma20 or 0)
134:         tc = float(f.trend_consistency_score or 0)
135:         hh = int(f.higher_high_flag or 0)
136:         rsi = float(f.rsi_14 or 50)
137:         # 技术位置分 0-100：close_vs_ma20 主导 + 趋势一致性 + 创新高
138:         pos_score = _clamp(50 + cv * 200, 0, 100)
139:         tech_score = _clamp(pos_score * 0.6 + tc * 100 * 0.4 + hh * 5, 0, 100)
140:         stage = _technical_stage_from_features(cv, tc, hh, rsi)
141:         track.append({
142:             'date': f.trade_date,
143:             'technical_stage': stage,
144:             'score': round(tech_score, 1),
145:             'close_vs_ma20': round(cv, 4),
146:             'consecutive_days': 0,  # 由调用方用当日真实连板填充
147:         })
148:     scores = [t['score'] for t in track]
149:     latest = track[-1]
150:     tc_latest = float(feats[-1].trend_consistency_score or 0)
151:     cv_latest = float(feats[-1].close_vs_ma20 or 0)
152:     rsi_latest = float(feats[-1].rsi_14 or 50)
153:     phase = _lifecycle_phase(latest['technical_stage'], scores, tc_latest, cv_latest, rsi_latest)
154:     phase_trend = _phase_trend(scores)
155:     return {
156:         'phase': phase,
157:         'phase_trend': phase_trend,
158:         'track': track,
159:         'technical_stage': latest['technical_stage'],
160:     }
161: def _lifecycle_phase(latest_stage: str, scores: list, tc_latest: float,
162:                     cv_latest: float, rsi_latest: float) -> str:
163:     """由最新技术形态 + 近 3 日评分斜率判定生命周期阶段。"""
164:     if len(scores) >= 2:
165:         slope = scores[-1] - scores[0]
166:     else:
167:         slope = 0
168:     # 衰退优先判定
169:     if latest_stage in ('破位', '弱势'):
170:         return '衰退'
171:     if slope < -5 and latest_stage in ('多头', '突破', '顶部', '偏多'):
172:         return '衰退'
173:     # 分歧：高位滞涨 / RSI 超买回落
174:     if latest_stage == '顶部' or (rsi_latest > 80 and slope < 0):
175:         return '分歧'
176:     # 主升：多头 + 趋势一致性强
177:     if latest_stage in ('多头', '突破') and tc_latest > 0.5:
178:         return '主升'
179:     # 突破：偏多/多头 且价格脱离均线或上行
180:     if latest_stage in ('偏多', '多头', '突破') and (cv_latest > 0.03 or slope > 0):
181:         return '突破'
182:     # 蓄势：弱势/震荡 且趋势未起
183:     if latest_stage in ('弱势', '震荡', '偏多') and tc_latest < 0.4:
184:         return '蓄势'
185:     return '蓄势' if latest_stage in ('弱势', '震荡') else '突破'
186: def _phase_trend(scores: list) -> str:
187:     """近 3 日 vs 前 3 日 技术位置分斜率。"""
188:     if len(scores) < 3:
189:         return 'flat'
190:     recent = scores[-3:]
191:     early = scores[-6:-3] if len(scores) >= 6 else scores[:1]
192:     delta = sum(recent) / len(recent) - sum(early) / len(early)
193:     if delta > 3:
194:         return 'rising'
195:     if delta < -3:
196:         return 'falling'
197:     return 'flat'
198: # ===== 跨日状态记忆 =====
199: def _read_current_leader_track(db) -> Optional[dict]:
200:     """读取当前主龙状态（is_active=True 的最近一条）。"""
201:     rec = db.query(LeaderTrack).filter(
202:         LeaderTrack.is_active == True
203:     ).order_by(LeaderTrack.last_date.desc()).first()
204:     if not rec:
205:         return None
206:     return {
207:         'ts_code': rec.ts_code,
208:         'name': rec.name,
209:         'sector': rec.sector,
210:         'enter_date': rec.enter_date.isoformat() if rec.enter_date else None,
211:         'current_phase': rec.current_phase,
212:         'phase_trend': rec.phase_trend,
213:         'track_json': rec.track_json,
214:         'consecutive_days_as_leader': rec.consecutive_days_as_leader,
215:         'last_date': rec.last_date.isoformat() if rec.last_date else None,
216:     }
217: def _last_track_score(cur_track: dict):
218:     """从历史轨迹取上一日 score（用于判断评分回落）。"""
219:     try:
220:         hist = json.loads(cur_track.get('track_json') or '[]')
221:         if hist:
222:             return float(hist[-1].get('score', 0))
223:     except Exception:
224:         pass
225:     return None
226: def _persist_leader_track(db, leader: dict, lc: dict, target_date: date, cur_track: Optional[dict]):
227:     """持久化当前主龙状态：仍在任则追加轨迹并延续连续天数；换龙则停旧立新。"""
228:     ts_code = leader['ts_code']
229:     point = {
230:         'date': target_date.isoformat(),
231:         'phase': (lc or {}).get('phase') or leader['stage'],
232:         'score': leader['score'],
233:         'technical_stage': leader['stage'],
234:         'consecutive_days': leader['consecutive_days'],
235:     }
236:     existing = db.query(LeaderTrack).filter(
237:         LeaderTrack.is_active == True,
238:         LeaderTrack.ts_code == ts_code,
239:     ).first()
240:     if existing:
241:         hist = json.loads(existing.track_json or '[]')
242:         hist.append(point)
243:         hist = hist[-20:]  # 保留最近 20 日
244:         existing.current_phase = point['phase']
245:         existing.phase_trend = (lc or {}).get('phase_trend') or 'flat'
246:         existing.track_json = json.dumps(hist, ensure_ascii=False)
247:         existing.consecutive_days_as_leader = existing.consecutive_days_as_leader + 1
248:         existing.last_date = target_date
249:         existing.sector = leader['sector']
250:         existing.name = leader['name']
251:     else:
252:         # 新主龙：停用所有旧 active
253:         db.query(LeaderTrack).filter(LeaderTrack.is_active == True).update({'is_active': False})
254:         db.add(LeaderTrack(
255:             ts_code=ts_code,
256:             name=leader['name'],
257:             sector=leader['sector'],
258:             enter_date=target_date,
259:             current_phase=point['phase'],
260:             phase_trend=(lc or {}).get('phase_trend') or 'flat',
261:             track_json=json.dumps([point], ensure_ascii=False),
262:             consecutive_days_as_leader=1,
263:             last_date=target_date,
264:             is_active=True,
265:         ))
266:     db.commit()
267: # ===== 板块轮动图谱 =====
268: def _build_sector_rotation(sector_ranking: dict, computed: list, cur_track: Optional[dict]) -> dict:
269:     cur_sector = (cur_track or {}).get('sector')
270:     by_sector = defaultdict(list)
271:     for c in computed[:20]:
272:         by_sector[c['sector'] or '未知'].append(c)
273:     sector_avg = {
274:         s: round(sum(x['score'] for x in v) / len(v), 2)
275:         for s, v in by_sector.items()
276:     }
277:     return {
278:         'current_leader_sector': cur_sector,
279:         'strong_sectors': [s['sector'] for s in sector_ranking.get('strong', [])],
280:         'rotation_sectors': [s['sector'] for s in sector_ranking.get('rotation', [])],
281:         'sector_avg_score': sector_avg,
282:     }
283: # ===== 主龙选取（结合跨日状态 + 衰退预警） =====
284: def _select_leader(computed: list, cur_track: Optional[dict], lifecycle_map: dict):
285:     """返回 (leader, decay_warning, old_leader)。"""
286:     top = computed[0] if computed else None
287:     if not top:
288:         return None, False, None
289:     cur_code = (cur_track or {}).get('ts_code')
290:     cur_in = next((c for c in computed if c['ts_code'] == cur_code), None)
291:     decay_warning = False
292:     if cur_track and cur_in:
293:         lc = lifecycle_map.get(cur_code, {})
294:         cur_score = cur_in['score']
295:         prev_score = _last_track_score(cur_track)
296:         # 衰退：phase=衰退，或 趋势拐头 且 评分较昨日回落
297:         if lc.get('phase') == '衰退' or (
298:             lc.get('phase_trend') == 'falling' and prev_score is not None
299:             and cur_score < prev_score - 0.3
300:         ):
301:             decay_warning = True
302:         switch, _ = should_switch(cur_in, top)
303:         if not decay_warning and not switch:
304:             return cur_in, False, None   # 维持当前主龙
305:         return top, decay_warning, cur_in
306:     # 无当前主龙：选评分最强者
307:     if top['score'] >= 7:
308:         return top, False, None
309:     return None, False, None
310: # ===== 评分 =====
311: def calc_leader_score(metrics: dict, sector_rank: int = 1) -> dict:
312:     """基于真实计算指标计算龙头评分（0-10）
313:     Args:
314:         metrics: {
315:             'technical': {stage,score} | None,
316:             'main_force': {stage,score} | None,
317:             'momentum': {stage,score} | None,
318:             'sentiment': {stage,score} | None,
319:             'risk': {stage,score} | None,
320:             'change_rate': float,
321:             'consecutive_days': int,
322:         }
323:         sector_rank: 该股票在板块内的排名（1=最强）
324:     Returns:
325:         dict: score, stage, strength, state, details
326:     """
327:     t = (metrics.get('technical') or {}).get('score', 50)
328:     mf = (metrics.get('main_force') or {}).get('score', 50)
329:     mo = (metrics.get('momentum') or {}).get('score', 50)
330:     se = (metrics.get('sentiment') or {}).get('score', 50)
331:     score = 0.0
332:     # 技术形态（权重最高）
333:     score += t / 100 * 3
334:     # 主力资金
335:     score += mf / 100 * 2
336:     # 资金动能
337:     score += mo / 100 * 2
338:     # 情绪温度
339:     score += se / 100 * 1
340:     # 真实涨幅
341:     chg = float(metrics.get('change_rate') or 0)
342:     if chg >= 9.5:
343:         score += 1
344:     elif chg >= 5:
345:         score += 0.7
346:     elif chg >= 1:
347:         score += 0.3
348:     # 真实连板
349:     days = int(metrics.get('consecutive_days') or 0)
350:     if days >= 4:
351:         score += 1
352:     elif days >= 2:
353:         score += 0.5
354:     # 板块内排名
355:     if sector_rank == 1:
356:         score += 0.5
357:     score = round(min(10, score), 1)
358:     # 阶段：优先用真实技术形态
359:     stage = (metrics.get('technical') or {}).get('stage') or '震荡'
360:     # 强度：真实各维加权（0-100），用于前端展示
361:     strength = round(t * 0.5 + mf * 0.3 + mo * 0.1 + se * 0.1, 1)
362:     # 状态判定
363:     if score >= 7:
364:         state = "LEADER"
365:     elif score >= 4:
366:         state = "CANDIDATE"
367:     elif score >= 2:
368:         state = "WATCH"
369:     else:
370:         state = "WEAK"
371:     return {
372:         'score': score,
373:         'stage': stage,
374:         'strength': strength,
375:         'state': state,
376:         'details': {
377:             'technical': round(t, 1),
378:             'mainForce': round(mf, 1),
379:             'momentum': round(mo, 1),
380:             'sentiment': round(se, 1),
381:             'change': round(chg, 2),
382:             'days': days,
383:             'rank': sector_rank,
384:         },
385:     }
386: def should_switch(current_leader: dict, new_leader: dict):
387:     """是否应该切换主龙（防乱换），基于真实技术阶段与评分"""
388:     if not current_leader:
389:         return True, '无当前主龙'
390:     diff = new_leader['score'] - current_leader['score']
391:     if diff > 1.5:
392:         if new_leader['change_rate'] > current_leader['change_rate']:
393:             return True, f'新龙头评分高{diff:.1f}分且涨幅更强'
394:     # 当前主龙走弱（破位/弱势），新龙头处于上升期（偏多/多头/突破/顶部）
395:     weak_stages = ('破位', '弱势')
396:     rising_stages = ('偏多', '多头', '突破', '顶部')
397:     if current_leader['stage'] in weak_stages and new_leader['stage'] in rising_stages:
398:         return True, '当前主龙走弱，新龙头处于上升期'
399:     return False, '维持当前主龙'
400: def run_leader_engine(target_date=None):
401:     """运行龙头引擎（完整生命周期驱动）
402:     流程：
403:     1. 获取可交易板块（sector_engine）
404:     2. 取当日真实特征(StockFeaturesDaily) + 真实资金(StockFlow)候选池（限制在可交易板块；若无则全量兜底）
405:     3. 批量取真实连板(StockDailyKline) + 板块趋势(SectorFlow)
406:     4. 对每只候选实时计算 6 维 + 涨幅 + 连板 → 龙头评分
407:     5. 板块内排名 → 总分排序
408:     6. 跨日生命周期跟踪：读当前主龙 → 对 top 候选+当前主龙回溯 N 日阶段演进
409:     7. 板块轮动图谱 → 主龙选取(结合衰退预警/接棒) → 持久化 LeaderTrack
410:     Returns:
411:         dict: leader, candidates, all_stocks, all_count, sector_filter, sector_rotation,
412:               decay_warning, successor_candidates, current_leader_track, date, message
413:     """
414:     with get_db_session() as db:
415:         # Step 1: 可交易板块
416:         sector_ranking = get_sector_ranking(target_date)
417:         tradable_sectors = set(
418:             [s['sector'] for s in sector_ranking.get('strong', []) + sector_ranking.get('rotation', [])]
419:         )
420:         if not tradable_sectors:
421:             return {
422:                 'leader': None, 'candidates': [], 'all_stocks': [], 'all_count': 0,
423:                 'sector_filter': sector_ranking, 'sector_rotation': {},
424:                 'decay_warning': False, 'successor_candidates': [], 'current_leader_track': None,
425:                 'date': None, 'message': '无可交易板块',
426:             }
427:         # Step 2: 确定日期（以 StockFeaturesDaily 最新交易日为准）
428:         if target_date is None:
429:             feat_date_str = db.query(func.max(StockFeaturesDaily.trade_date)).scalar()
430:             if not feat_date_str:
431:                 return {
432:                     'leader': None, 'candidates': [], 'all_stocks': [], 'all_count': 0,
433:                     'sector_filter': sector_ranking, 'sector_rotation': {},
434:                     'decay_warning': False, 'successor_candidates': [], 'current_leader_track': None,
435:                     'date': None, 'message': '无个股特征数据',
436:                 }
437:             target_date = datetime.strptime(feat_date_str, '%Y%m%d').date()
438:         date_str = target_date.strftime('%Y%m%d')   # 用于 StockFeaturesDaily(String YYYYMMDD)
439:         date_obj = target_date                       # 用于 Date 类型字段
440:         # Step 3: 候选池 = 当日有真实特征 + 真实资金的股票
441:         feats = db.query(StockFeaturesDaily).filter(
442:             StockFeaturesDaily.trade_date == date_str
443:         ).all()
444:         flows = db.query(StockFlow).filter(StockFlow.trade_date == date_obj).all()
445:         flow_map = {f.ts_code.split('.')[0]: f for f in flows}  # 6 位代码 -> flow
446:         # 限制在可交易板块；若过滤后为空，则全量兜底（保证页面有数据）
447:         candidates_raw = []
448:         for f in feats:
449:             flow = flow_map.get(f.stock_code)
450:             if not flow:
451:                 continue
452:             if flow.sector and flow.sector in tradable_sectors:
453:                 candidates_raw.append((f, flow))
454:         if not candidates_raw:
455:             for f in feats:
456:                 flow = flow_map.get(f.stock_code)
457:                 if flow:
458:                     candidates_raw.append((f, flow))
459:         if not candidates_raw:
460:             return {
461:                 'leader': None, 'candidates': [], 'all_stocks': [], 'all_count': 0,
462:                 'sector_filter': sector_ranking, 'sector_rotation': {},
463:                 'decay_warning': False, 'successor_candidates': [], 'current_leader_track': None,
464:                 'date': target_date.isoformat(), 'message': '当日无候选股（特征/资金数据缺失）',
465:             }
466:         # Step 4: 真实连板（批量取近 15 日 K 线）
467:         codes = [flow.ts_code for _, flow in candidates_raw]
468:         start_obj = target_date - timedelta(days=15)
469:         klines = db.query(StockDailyKline).filter(
470:             StockDailyKline.trade_date.between(start_obj, date_obj),
471:             StockDailyKline.ts_code.in_(codes),
472:         ).all()
473:         kmap = defaultdict(list)
474:         for k in klines:
475:             kmap[k.ts_code].append((k.trade_date, float(k.pct_chg or 0)))
476:         # 板块趋势 map（真实）
477:         sector_flows = db.query(SectorFlow).filter(SectorFlow.trade_date == date_obj).all()
478:         sector_trend_map = {sf.sector: _build_sector_trend(sf) for sf in sector_flows}
479:         sector_info_map = {s['sector']: s for s in sector_ranking.get('all', [])}
480:         # Step 5: 计算每只候选的真实指标
481:         computed = []
482:         for f, flow in candidates_raw:
483:             features = _features_to_dict(f)
484:             quote = {'changePct': float(flow.price_chg or 0)}
485:             sector_trend = sector_trend_map.get(flow.sector)
486:             technical = calc_technical(features)
487:             main_force = calc_main_force(quote, features, sector_trend)
488:             momentum = calc_momentum(sector_trend, features)
489:             sentiment = calc_sentiment(quote, sector_trend, features)
490:             risk = calc_risk(features, None, None)
491:             days = _compute_consecutive_limit_up(kmap, flow.ts_code, date_obj)
492:             metrics = {
493:                 'technical': technical, 'main_force': main_force,
494:                 'momentum': momentum, 'sentiment': sentiment, 'risk': risk,
495:                 'change_rate': float(flow.price_chg or 0),
496:                 'consecutive_days': days,
497:             }
498:             score_info = calc_leader_score(metrics, sector_rank=1)  # 暂定 1，稍后按板块内重排
499:             sec_info = sector_info_map.get(flow.sector or '')
500:             computed.append({
501:                 'ts_code': flow.ts_code,
502:                 'name': flow.name or f.stock_code,
503:                 'sector': flow.sector or '',
504:                 'score': score_info['score'],
505:                 'stage': score_info['stage'],
506:                 'strength': score_info['strength'],
507:                 'state': score_info['state'],
508:                 'consecutive_days': days,
509:                 'change_rate': float(flow.price_chg or 0),
510:                 'sector_score': sec_info.get('score') if sec_info else 0,
511:                 'sector_state': sec_info.get('state') if sec_info else 'UNKNOWN',
512:                 'sector_state_label': sec_info.get('state_label') if sec_info else '未知',
513:                 'details': score_info['details'],
514:                 'trade_date': target_date.isoformat(),
515:                 '_intensity': score_info['details']['technical'] * 0.5
516:                               + score_info['details']['mainForce'] * 0.3
517:                               + score_info['details']['momentum'] * 0.1
518:                               + score_info['details']['sentiment'] * 0.1,
519:             })
520:         # Step 6: 按板块内排名重算 sector_rank 并微调（板块内按强度排序给 rank）
521:         by_sector = defaultdict(list)
522:         for c in computed:
523:             by_sector[c['sector'] or '未知'].append(c)
524:         for sec, sec_stocks in by_sector.items():
525:             sec_stocks.sort(key=lambda x: x['_intensity'], reverse=True)
526:             for rank, s in enumerate(sec_stocks, 1):
527:                 if rank != 1:
528:                     s['score'] = round(max(0, s['score'] - 0.5), 1)
529:                 s['details']['rank'] = rank
530:         # Step 7: 总分排序
531:         computed.sort(key=lambda x: x['score'], reverse=True)
532:         for c in computed:
533:             c.pop('_intensity', None)
534:         # Step 8: 跨日生命周期跟踪
535:         # 8.1 当前主龙状态
536:         cur_track = _read_current_leader_track(db)
537:         # 8.2 对 top 候选 + 当前主龙 回溯 N 日阶段演进
538:         watch_codes = {c['ts_code'].split('.')[0] for c in computed[:10]}
539:         if cur_track:
540:             watch_codes.add(cur_track['ts_code'].split('.')[0])
541:         lifecycle_map = {}
542:         for code in watch_codes:
543:             lc = calc_lifecycle(code, db, target_date, n=12)
544:             days = _compute_consecutive_limit_up(kmap, f'{code}.SZ', date_obj) \
545:                 or _compute_consecutive_limit_up(kmap, f'{code}.SH', date_obj)
546:             for t in lc['track']:
547:                 t['consecutive_days'] = days
548:             lifecycle_map[f'{code}.SZ'] = lc
549:             lifecycle_map[f'{code}.SH'] = lc
550:         # 8.3 给 computed 附加生命周期字段
551:         for c in computed:
552:             lc = lifecycle_map.get(c['ts_code'])
553:             if lc:
554:                 c['phase'] = lc['phase']
555:                 c['phase_trend'] = lc['phase_trend']
556:                 c['track'] = lc['track']
557:             else:
558:                 c['phase'] = '蓄势'
559:                 c['phase_trend'] = 'flat'
560:                 c['track'] = []
561:         # 8.4 板块轮动图谱
562:         sector_rotation = _build_sector_rotation(sector_ranking, computed, cur_track)
563:         # 8.5 主龙选取（结合跨日状态 + 衰退预警）
564:         leader, decay_warning, old_leader = _select_leader(computed, cur_track, lifecycle_map)
565:         # 8.6 接棒候选排序（phase 处于 突破/主升 且 rising，再按 score）
566:         successors = [c for c in computed if c['ts_code'] != (leader or {}).get('ts_code')]
567:         successors.sort(key=lambda x: (
568:             x.get('phase') in ('突破', '主升'),
569:             x.get('phase_trend') == 'rising',
570:             x['score'],
571:         ), reverse=True)
572:         successor_candidates = successors[:3]
573:         # 8.7 候选列表：无衰退预警时展示非主龙 top；有预警时展示接棒候选
574:         if leader:
575:             candidates_out = successor_candidates if decay_warning else [
576:                 c for c in computed[1:] if c['score'] >= 4
577:             ][:3]
578:         else:
579:             candidates_out = computed[:5]
580:         # 8.8 持久化 LeaderTrack
581:         if leader:
582:             _persist_leader_track(db, leader, lifecycle_map.get(leader['ts_code']), target_date, cur_track)
583:         return {
584:             'leader': leader,
585:             'candidates': candidates_out,
586:             'all_stocks': computed[:20],
587:             'all_count': len(computed),
588:             'sector_filter': sector_ranking,
589:             'sector_rotation': sector_rotation,
590:             'decay_warning': decay_warning,
591:             'successor_candidates': successor_candidates,
592:             'current_leader_track': cur_track,
593:             'date': target_date.isoformat(),
594:             'message': 'ok' if leader else '无强主龙（score<7）',
595:         }
