421: async def update_stock_state(stock_code: str, sector_strength: float = 0) -> dict:
422:     """完整流程：拉K线 → 读取资金流 → 计算 → 判定 → 存库。返回判定结果"""
423:     klines = await _fetch_kline(stock_code, 120)
424:     if len(klines) < 60:
425:         return {'market_state': 'UNKNOWN', 'reasons': ['K线数据不足']}
426:     # 从 StockFlow 表读取主力资金流
