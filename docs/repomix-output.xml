 82:         avg_vol_5 = np.mean(recent_vols) if recent_vols else 0
 83:         if avg_vol_5 <= 0:
 84:             return None
 85:         vol_ratio = volume / avg_vol_5
 86:         # 评分
 87:         score = 0
 88:         scores = {}
 89:         # 金叉强度：DIF-DEA 接近 0 加分
 90:         cross_gap = abs(dif[-1] - dea[-1])
 91:         if cross_gap < 0.05:
 92:             score += 2
 93:             scores['cross'] = 2
 94:         elif cross_gap < 0.15:
 95:             score += 1
 96:             scores['cross'] = 1
 97:         # 柱状线
 98:         if hist[-1] > 0:
 99:             score += 2
100:             scores['hist'] = 2
101:         # 价格站上 MA20
102:         if latest_close > ma20:
103:             score += 1
104:             scores['above_ma20'] = 1
105:         # MA20 向上
106:         if ma20 > ma20_prev:
107:             score += 1
108:             scores['ma20_up'] = 1
109:         # 量能
110:         if vol_ratio >= 1.2:
111:             score += 2
112:             scores['vol'] = 2
113:         elif vol_ratio >= 1.0:
114:             score += 1
115:             scores['vol'] = 1
116:         if score < 5:
