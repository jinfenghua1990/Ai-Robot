 13: // ===== 工具函数 =====
 14: const calcEma = (arr, n) => {
 15:   const k = 2 / (n + 1);
 16:   let prev = arr[0];
 17:   return arr.map((v, i) => (prev = i === 0 ? v : v * k + prev * (1 - k)));
 18: };
 19: const calcIntradayMacd = (idPrices) => {
 20:   if (idPrices.length < 26) return null;
 21:   const e12 = calcEma(idPrices, 12);
 22:   const e26 = calcEma(idPrices, 26);
 23:   const dif = e12.map((v, i) => v - e26[i]);
 24:   const dea = calcEma(dif, 9);
 25:   const n = dif.length;
 26:   return { dif: dif[n - 1], dea: dea[n - 1], macd: 2 * (dif[n - 1] - dea[n - 1]) };
 27: };
 28: const calcIntradayKdj = (idPrices) => {
 29:   const N = 9;
 30:   if (idPrices.length < N) return null;
 31:   let k = 50, d = 50;
 32:   for (let i = N - 1; i < idPrices.length; i++) {
 33:     const win = idPrices.slice(i - N + 1, i + 1);
 34:     const hh = Math.max(...win), ll = Math.min(...win);
 35:     const rsv = hh === ll ? 50 : ((idPrices[i] - ll) / (hh - ll)) * 100;
 36:     k = (2 / 3) * k + (1 / 3) * rsv;
 37:     d = (2 / 3) * d + (1 / 3) * k;
 38:   }
 39:   return { k, d, j: 3 * k - 2 * d };
 40: };
