  1: #!/usr/bin/env python3
  2: # -*- coding: utf-8 -*-
  3: """
  4: 🔄 RSI超卖反弹 — 均值回归信号（与 MA 体系完全独立）
  5: 核心逻辑：
  6: 1. 昨日 RSI(14) < 30（超卖区间）
  7: 2. 今日收阳（close > open，反弹确认）
  8: 3. 今日成交量 >= 5日均量 × 1.2（放量确认，非无量反弹）
  9: 4. 今日涨幅 1%~7%（过滤假反弹和一字板）
 10: 评分（满分 8 分，>= 4 分入选，宽松门槛因为信号本身稀有）：
 11: - 超卖深度：RSI < 25 (+3), RSI < 30 (+2)
 12: - 反弹力度：涨幅 3%~7% (+2), 1%~3% (+1)
 13: - 量能确认：量比 >= 2.0 (+2), >= 1.2 (+1)
 14: - 站上 MA5 (+1)
 15: 定位：趋势跟踪策略抓不到的"别人恐慌我贪婪"型机会。
 16:     与 MA 体系相关性接近零，共振维度独立。
 17: """
 18: import numpy as np
 19: from .baihu_v30 import get_kline_from_tdx, calc_rsi
 20: def rsi_bounce_strategy(kline, day_index=-1):
 21:     """RSI超卖反弹单只股票分析
 22:     参数:
 23:         kline: K线数据列表（oldest-first），每元素含 close/open/low/high/volume
 24:         day_index: 检查哪一天（默认-1，最新一天）
 25:     返回:
 26:         命中返回 dict（含 ts_code/score/scores/signal/reason），不命中返回 None
 27:     """
 28:     try:
 29:         if day_index == -1:
 30:             day_index = len(kline) - 1
 31:         if day_index < 14 or day_index >= len(kline) or len(kline) < 15:
 32:             return None
 33:         closes = [float(k['close']) for k in kline]
 34:         opens = [float(k['open']) for k in kline]
 35:         volumes = [float(k['volume']) for k in kline]
 36:         today_close = closes[-1]
 37:         today_open = opens[-1]
 38:         today_vol = volumes[-1]
 39:         prev_close = closes[-2]
 40:         prev_open = opens[-2]
 41:         # 1. 昨日 RSI < 30
 42:         rsi_today = calc_rsi(closes, period=14)
 43:         rsi_yesterday = calc_rsi(closes[:-1], period=14)
 44:         if rsi_yesterday is None or rsi_yesterday >= 30:
 45:             return None
 46:         # 2. 今日收阳
 47:         if today_close <= today_open:
 48:             return None
 49:         # 3. 成交量 >= 5日均量（不缩量即可，超卖反弹放量要求放宽）
 50:         if len(volumes) >= 5:
 51:             avg_vol_5 = np.mean(volumes[-6:-1])  # 前5日（不含今天）
 52:             vol_ratio = (today_vol / avg_vol_5) if avg_vol_5 > 0 else 0
 53:             if vol_ratio < 1.0:
 54:                 return None
 55:         else:
 56:             return None
 57:         # 4. 今日涨幅 0.5%~8%（超卖反弹起点低，门槛放宽）
 58:         change_pct = (today_close - prev_close) / prev_close * 100 if prev_close > 0 else 0
 59:         if change_pct < 0.5 or change_pct > 8:
 60:             return None
 61:         # 计算均线
 62:         ma5 = np.mean(closes[-5:]) if len(closes) >= 5 else None
 63:         # 评分
 64:         score = 0
 65:         scores = {}
 66:         # 超卖深度
 67:         if rsi_yesterday < 25:
 68:             score += 3
 69:             scores['oversold_depth'] = 3
 70:         else:
 71:             score += 2
 72:             scores['oversold_depth'] = 2
 73:         # 反弹力度
 74:         if change_pct >= 3:
 75:             score += 2
 76:             scores['bounce_strength'] = 2
 77:         else:
 78:             score += 1
 79:             scores['bounce_strength'] = 1
 80:         # 量能确认
 81:         if vol_ratio >= 1.5:
 82:             score += 2
 83:             scores['volume_confirm'] = 2
 84:         else:
 85:             score += 1
 86:             scores['volume_confirm'] = 1
 87:         # MA5 确认（如果站上 MA5 额外加分）
 88:         above_ma5 = False
 89:         if ma5 and today_close > ma5:
 90:             score += 1
 91:             scores['above_ma5'] = 1
 92:             above_ma5 = True
 93:         if score < 4:
 94:             return None
 95:         # 反弹原因描述
 96:         reason_parts = [f'昨日RSI={rsi_yesterday:.1f}(超卖)', f'今日反弹+{change_pct:.1f}%']
 97:         if vol_ratio >= 2.0:
 98:             reason_parts.append(f'放量{vol_ratio:.1f}x')
 99:         if above_ma5:
100:             reason_parts.append('站上MA5')
101:         return {
102:             'ts_code': '',
103:             'signal': 'rsi_bounce',
104:             'signal_label': '超卖反弹',
105:             'score': round(score, 1),
106:             'scores': scores,
107:             'change_pct': round(change_pct, 2),
108:             'rsi': round(rsi_today, 1) if rsi_today else None,
109:             'rsi_yesterday': round(rsi_yesterday, 1),
110:             'vol_ratio': round(vol_ratio, 2),
111:             'ma5': round(ma5, 2) if ma5 else None,
112:             'price': round(today_close, 2),
113:             'reason': '，'.join(reason_parts),
114:             'indicators': {
115:                 'rsi_14': round(rsi_today, 1) if rsi_today else None,
116:                 'rsi_yesterday': round(rsi_yesterday, 1),
117:                 'vol_ratio': round(vol_ratio, 2),
118:                 'ma5': round(ma5, 2) if ma5 else None,
119:                 'change_pct': round(change_pct, 2),
120:             },
121:         }
122:     except Exception:
123:         return None
124: def run_rsi_bounce_screen(stock_list, trade_date=None):
125:     """对候选股票列表运行 RSI 超卖反弹策略"""
126:     results = []
127:     for ts_code in stock_list:
128:         try:
129:             kline = get_kline_from_tdx(ts_code, days=90)
130:             if not kline or len(kline) < 15:
131:                 continue
132:             hit = rsi_bounce_strategy(kline)
133:             if hit:
134:                 hit['ts_code'] = ts_code
135:                 if trade_date:
136:                     hit['trade_date'] = trade_date
137:                 results.append(hit)
138:         except Exception:
139:             continue
140:     return results
