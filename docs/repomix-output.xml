<file path="backend/scripts/backfill_analysis_pg.py">
 1: """一次性回填：把 analysis_reports/{requests,results,notifications} 下现有 JSON 导入 PG
 2: 目的：研报中心改为 PG 支撑后，旧 JSON 报告需迁移进库，前端才不丢数据。
 3: 可重复运行（用 merge 按主键 upsert）。
 4: """
 5: import json
 6: import os
 7: import sys
 8: from datetime import datetime
 9: BACKEND = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
10: sys.path.insert(0, BACKEND)
11: from db.connection import SessionLocal
12: from db.models import AnalysisRequest, AnalysisReport, Notification
13: def _parse(s):
14:     if not s:
15:         return None
16:     try:
17:         return datetime.fromisoformat(s)
18:     except Exception:
19:         return None
20: def main():
21:     base = os.path.join(BACKEND, "analysis_reports")
22:     req_dir = os.path.join(base, "requests")
23:     res_dir = os.path.join(base, "results")
24:     notif_dir = os.path.join(base, "notifications")
25:     with SessionLocal() as db:
26:         # 1) requests
27:         rc = 0
28:         if os.path.isdir(req_dir):
29:             for fn in os.listdir(req_dir):
30:                 if not fn.endswith(".json"):
31:                     continue
32:                 d = json.load(open(os.path.join(req_dir, fn), encoding="utf-8"))
33:                 db.merge(AnalysisRequest(
34:                     id=d["id"], stock_code=d.get("stock_code", ""),
35:                     stock_name=d.get("stock_name", ""), source=d.get("source", "tdx"),
36:                     status=d.get("status", "pending"), error=d.get("error"),
37:                     created_at=_parse(d.get("created_at")), updated_at=_parse(d.get("updated_at")),
38:                 ))
39:                 rc += 1
40:         # 2) results（报告）
41:         wc = 0
42:         if os.path.isdir(res_dir):
43:             for fn in os.listdir(res_dir):
44:                 if not fn.endswith(".json"):
45:                     continue
46:                 d = json.load(open(os.path.join(res_dir, fn), encoding="utf-8"))
47:                 rid = d.get("id") or fn[:-5]
48:                 summ = d.get("summary", {})
49:                 db.merge(AnalysisReport(
50:                     id=rid, stock_code=d.get("stock_code", ""), stock_name=d.get("stock_name", ""),
51:                     source=d.get("source", "tdx"), report_type=d.get("report_type", ""),
52:                     rating=summ.get("rating", ""), target_price=str(summ.get("target_price", "")),
53:                     confidence=summ.get("confidence", ""),
54:                     report_json=json.dumps(d, ensure_ascii=False),
55:                     created_at=_parse(d.get("created_at")),
56:                 ))
57:                 wc += 1
58:         # 3) notifications
59:         nc = 0
60:         if os.path.isdir(notif_dir):
61:             for fn in os.listdir(notif_dir):
62:                 if not fn.endswith(".json"):
63:                     continue
64:                 d = json.load(open(os.path.join(notif_dir, fn), encoding="utf-8"))
65:                 db.merge(Notification(
66:                     id=d["id"], source=d.get("source", ""), stock_code=d.get("stock_code", ""),
67:                     stock_name=d.get("stock_name", ""), title=d.get("title", ""),
68:                     read=bool(d.get("read", False)), created_at=_parse(d.get("created_at")),
69:                 ))
70:                 nc += 1
71:         db.commit()
72:         print(f"backfilled: requests={rc} reports={wc} notifications={nc}")
73: if __name__ == "__main__":
74:     main()
</file>

<file path="backend/scripts/backfill_f10_full.py">
  1: """全市场 F10 批量预拉（免费源：Tushare + 东方财富）+ 写入 stock_f10 / stock_universe
  2: 用途：
  3: - 把全市场 A 股（stock_basic 上市状态）的基础信息写入 stock_universe（名称/行业/板块）。
  4: - 逐只拉 F10（财务 fina_indicator+income+daily_basic / 机构 top10_floatholders / 评级东方财富），
  5:   按 ts_code 缓存进 stock_f10（TTL 1 天）。
  6: - call_tushare_mcp 自带全局令牌桶限流（250/min），逐只调用即可，无需额外 sleep。
  7: - 支持断点续拉：stock_f10 已存在且 fetched_at 在 TTL 内则跳过（--force 强制重拉）。
  8: 全市场体量约 5500 只，3 接口/只 ≈ 1.6 万次调用，按 250/min 约 60+ 分钟。
  9: 建议作为后台任务运行（run_in_background），首次跑完后每日增量很快。
 10: 用法：
 11:   python scripts/backfill_f10_full.py --layer all --limit 300     # 小批量验证
 12:   python scripts/backfill_f10_full.py --layer all                 # 全量（后台）
 13:   python scripts/backfill_f10_full.py --layer financials          # 仅财务+估值
 14:   python scripts/backfill_f10_full.py --layer institution         # 仅机构
 15:   python scripts/backfill_f10_full.py --layer all --force         # 强制重拉
 16: """
 17: import argparse
 18: import json
 19: import logging
 20: import sys
 21: from datetime import datetime, timedelta
 22: logging.basicConfig(
 23:     level=logging.INFO,
 24:     format="%(asctime)s [%(levelname)s] %(message)s",
 25:     datefmt="%H:%M:%S",
 26: )
 27: logger = logging.getLogger("backfill_f10")
 28: # 让脚本能 import 项目模块（backend/ 为根）
 29: sys.path.insert(0, "/Users/gino/Projects/AIROBOT/backend")
 30: from dotenv import load_dotenv
 31: load_dotenv("/Users/gino/Projects/AIROBOT/.env")
 32: from sqlalchemy import select, func
 33: from db.connection import SessionLocal, engine, Base
 34: from db.models import StockUniverse, StockF10
 35: # 复用研报中心的免费 F10 拉取逻辑（内部已带 PG 缓存）
 36: from services.f10_provider import (
 37:     _fetch_financials, _fetch_institution, _fetch_rating,
 38:     CACHE_TTL_HOURS, _cache_set,
 39: )
 40: from collectors.tdx_collector import call_tushare_mcp
 41: def load_universe(force_refresh: bool = False) -> int:
 42:     """拉全市场上市股票基础信息写入 stock_universe。返回写入/更新行数。"""
 43:     existing = {}
 44:     with SessionLocal() as db:
 45:         for row in db.execute(select(StockUniverse)).scalars().all():
 46:             existing[row.ts_code] = row
 47:     rows = call_tushare_mcp(
 48:         "stock_basic",
 49:         params={"list_status": "L", "exchange": ""},
 50:         fields=["ts_code", "name", "industry", "market", "list_status"],
 51:     )
 52:     if not rows:
 53:         logger.warning("stock_basic 返回空，跳过 universe 更新")
 54:         return 0
 55:     count = 0
 56:     with SessionLocal() as db:
 57:         for r in rows:
 58:             tc = r.get("ts_code")
 59:             if not tc:
 60:                 continue
 61:             obj = existing.get(tc) or StockUniverse(ts_code=tc)
 62:             obj.name = r.get("name") or ""
 63:             obj.industry = r.get("industry") or ""
 64:             obj.market = r.get("market") or ""
 65:             obj.list_status = r.get("list_status") or "L"
 66:             obj.is_active = (r.get("list_status") == "L")
 67:             db.merge(obj)
 68:             existing[tc] = obj
 69:             count += 1
 70:         db.commit()
 71:     logger.info("stock_universe 写入/更新 %s 只", count)
 72:     return count
 73: def _is_fresh(ts_code: str) -> bool:
 74:     with SessionLocal() as db:
 75:         row = db.get(StockF10, ts_code)
 76:         if row and row.fetched_at:
 77:             return datetime.now() - row.fetched_at < timedelta(hours=CACHE_TTL_HOURS)
 78:     return False
 79: def backfill(layer: str, limit: int = None, force: bool = False,
 80:               pull_rating: bool = False) -> dict:
 81:     """逐只拉 F10 并落 stock_f10。layer: financials | institution | all
 82:     pull_rating: 是否拉东方财富评级/目标价。默认 False —— 本环境东财接口无数据，
 83:     且每只都打 HTTP 会显著拖慢全量；单只报告走 fetch_f10 时仍按需尝试。
 84:     """
 85:     # 确保 universe 已加载（提供覆盖池与名称/行业）
 86:     load_universe()
 87:     with SessionLocal() as db:
 88:         q = select(StockUniverse).where(StockUniverse.is_active == True)
 89:         if limit:
 90:             # 按主键顺序取前 N 只（便于小批量验证可复现）
 91:             q = q.order_by(StockUniverse.ts_code).limit(limit)
 92:         else:
 93:             q = q.order_by(StockUniverse.ts_code)
 94:         codes = [r.ts_code for r in db.execute(q).scalars().all()]
 95:     logger.info("覆盖池 %s 只，开始拉取 layer=%s (pull_rating=%s)", len(codes), layer, pull_rating)
 96:     stats = {"total": len(codes), "financials_ok": 0, "institution_ok": 0,
 97:              "rating_ok": 0, "skipped": 0, "errors": 0}
 98:     t0 = datetime.now()
 99:     for i, tc in enumerate(codes, 1):
100:         try:
101:             if not force and _is_fresh(tc):
102:                 stats["skipped"] += 1
103:                 continue
104:             financials = None
105:             institution = None
106:             rating = None
107:             if layer in ("financials", "all"):
108:                 financials = _fetch_financials(tc)
109:                 if financials:
110:                     stats["financials_ok"] += 1
111:             if layer in ("institution", "all"):
112:                 institution = _fetch_institution(tc)
113:                 if institution:
114:                     stats["institution_ok"] += 1
115:             if pull_rating and layer in ("all",):
116:                 rating = _fetch_rating(tc)
117:                 if rating:
118:                     stats["rating_ok"] += 1
119:             if financials or institution or rating:
120:                 _cache_set(tc, financials, institution, rating)
121:         except Exception as e:
122:             stats["errors"] += 1
123:             logger.warning("[%s] 拉取异常: %s", tc, e)
124:         if i % 100 == 0:
125:             el = (datetime.now() - t0).total_seconds()
126:             logger.info("进度 %s/%s | 耗时 %.0fs | %s", i, len(codes), el, stats)
127:     el = (datetime.now() - t0).total_seconds()
128:     logger.info("完成 layer=%s | 总耗时 %.0fs | %s", layer, el, stats)
129:     return stats
130: def main():
131:     ap = argparse.ArgumentParser(description="全市场 F10 批量预拉")
132:     ap.add_argument("--layer", choices=["financials", "institution", "all"],
133:                     default="all", help="拉取层级（默认 all）")
134:     ap.add_argument("--limit", type=int, default=None,
135:                     help="仅处理前 N 只（按 ts_code 排序），用于小批量验证")
136:     ap.add_argument("--force", action="store_true", help="强制重拉（忽略 TTL 缓存）")
137:     ap.add_argument("--with-rating", action="store_true",
138:                     help="同时拉东方财富评级/目标价（本环境通常无数据，默认跳过以加速）")
139:     ap.add_argument("--universe-only", action="store_true",
140:                     help="仅刷新 stock_universe 基础信息表，不拉 F10")
141:     args = ap.parse_args()
142:     if args.universe_only:
143:         n = load_universe(force_refresh=True)
144:         logger.info("universe-only 完成，写入 %s 只", n)
145:         return
146:     # 建表（首次运行确保 stock_universe / stock_f10 存在）
147:     Base.metadata.create_all(bind=engine, tables=[StockUniverse.__table__, StockF10.__table__])
148:     if args.limit:
149:         backfill(args.layer, limit=args.limit, force=args.force, pull_rating=args.with_rating)
150:     else:
151:         backfill(args.layer, force=args.force, pull_rating=args.with_rating)
152: if __name__ == "__main__":
153:     main()
</file>

<file path="backend/scripts/backfill_moneyflow.py">
  1: """
  2: 回补近1年个股主力资金数据到 StockFlow 表（科创+创业板）
  3: 数据源：tushare pro.moneyflow（按交易日遍历，单次返回全市场）
  4: 单位：tushare 原生万元，与 StockFlow 一致，无需转换
  5: 字段映射：
  6:   main_force_inflow = net_mf_amount（主力净流入 = 超大单净额 + 大单净额）
  7:   net_inflow        = net_mf_amount（保持一致）
  8:   retail_flow       = buy_sm_amount - sell_sm_amount（小单/散户净额）
  9:   name / sector     = 从 pro.stock_basic 补
 10: """
 11: import os
 12: import sys
 13: import time
 14: from datetime import datetime, date, timedelta
 15: sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
 16: from db.connection import get_db, engine, Base
 17: from db.session import get_db_session
 18: from db.models import StockFlow
 19: from config import TUSHARE_TOKEN
 20: import tushare as ts
 21: ts.set_token(TUSHARE_TOKEN)
 22: pro = ts.pro_api()
 23: def is_target(ts_code):
 24:     """科创(688.SH) + 创业(300/301.SZ)"""
 25:     if ts_code.startswith('688') and ts_code.endswith('.SH'):
 26:         return True
 27:     if ts_code.startswith(('300', '301')) and ts_code.endswith('.SZ'):
 28:         return True
 29:     return False
 30: def backfill(days=365):
 31:     end_date = date.today()
 32:     start_date = end_date - timedelta(days=days)
 33:     start_str = start_date.strftime('%Y%m%d')
 34:     end_str = end_date.strftime('%Y%m%d')
 35:     # 1. 交易日历
 36:     print(f'[backfill] 获取交易日历 {start_str} ~ {end_str}')
 37:     cal = pro.trade_cal(exchange='SSE', start_date=start_str, end_date=end_str, is_open='1')
 38:     trade_dates = sorted(cal['cal_date'].tolist())
 39:     print(f'[backfill] 共 {len(trade_dates)} 个交易日')
 40:     # 2. 股票基础信息（name, industry）
 41:     print('[backfill] 获取股票基础信息...')
 42:     basic = pro.stock_basic(exchange='', list_status='L', fields='ts_code,name,industry')
 43:     basic_map = {r['ts_code']: {'name': r['name'], 'industry': r['industry']} for _, r in basic.iterrows()}
 44:     print(f'[backfill] 股票基础信息 {len(basic_map)} 条')
 45:     # 3. 检查已采集的交易日（跳过已完整的）
 46:     with get_db_session() as db:
 47:         existing_rows = db.query(StockFlow.trade_date).filter(
 48:             StockFlow.trade_date >= start_date,
 49:             StockFlow.main_force_inflow.isnot(None)
 50:         ).distinct().all()
 51:         existing_dates = set(str(r[0]) for r in existing_rows)
 52:     todo = []
 53:     for d in trade_dates:
 54:         d_iso = f'{d[:4]}-{d[4:6]}-{d[6:8]}'
 55:         if d_iso in existing_dates:
 56:             continue
 57:         todo.append(d)
 58:     print(f'[backfill] 已采集 {len(trade_dates) - len(todo)} 天，待采集 {len(todo)} 天')
 59:     # 4. 逐日采集
 60:     total_rows = 0
 61:     for i, d in enumerate(todo):
 62:         d_iso = f'{d[:4]}-{d[4:6]}-{d[6:8]}'
 63:         t0 = time.time()
 64:         try:
 65:             df = pro.moneyflow(trade_date=d)
 66:         except Exception as e:
 67:             print(f'[backfill] {d_iso} API错误: {e}, 等待5s重试')
 68:             time.sleep(5)
 69:             try:
 70:                 df = pro.moneyflow(trade_date=d)
 71:             except Exception as e2:
 72:                 print(f'[backfill] {d_iso} 重试失败: {e2}, 跳过')
 73:                 continue
 74:         if df is None or len(df) == 0:
 75:             print(f'[{i+1}/{len(todo)}] {d_iso} 无数据')
 76:             continue
 77:         # 过滤科创+创业
 78:         df = df[df['ts_code'].apply(is_target)]
 79:         day_count = 0
 80:         try:
 81:             with get_db_session() as db:
 82:                 existing = {s.ts_code: s for s in db.query(StockFlow).filter_by(trade_date=d_iso).all()}
 83:                 for _, r in df.iterrows():
 84:                     ts_code = r['ts_code']
 85:                     net_mf = float(r.get('net_mf_amount') or 0)
 86:                     retail = float(r.get('buy_sm_amount') or 0) - float(r.get('sell_sm_amount') or 0)
 87:                     info = basic_map.get(ts_code, {})
 88:                     rec = existing.get(ts_code)
 89:                     if rec:
 90:                         rec.main_force_inflow = net_mf
 91:                         rec.net_inflow = net_mf
 92:                         rec.retail_flow = retail
 93:                         if not rec.name:
 94:                             rec.name = info.get('name')
 95:                         if not rec.sector:
 96:                             rec.sector = info.get('industry')
 97:                     else:
 98:                         db.add(StockFlow(
 99:                             trade_date=d_iso,
100:                             ts_code=ts_code,
101:                             name=info.get('name'),
102:                             sector=info.get('industry'),
103:                             net_inflow=net_mf,
104:                             main_force_inflow=net_mf,
105:                             retail_flow=retail,
106:                         ))
107:                     day_count += 1
108:                 db.commit()
109:                 total_rows += day_count
110:                 elapsed = time.time() - t0
111:                 print(f'[{i+1}/{len(todo)}] {d_iso} 写入 {day_count} 条 ({elapsed:.1f}s) 累计 {total_rows}')
112:         except Exception as e:
113:             db.rollback()
114:             print(f'[backfill] {d_iso} 写入失败: {e}')
115:         # 控制频率：tushare moneyflow 限制 500次/分钟，0.2s 间隔足够
116:         time.sleep(0.2)
117:     print(f'[backfill] 完成！共 {len(todo)} 天，{total_rows} 条记录')
118: if __name__ == '__main__':
119:     import argparse
120:     parser = argparse.ArgumentParser()
121:     parser.add_argument('--days', type=int, default=365, help='回补天数（默认365）')
122:     args = parser.parse_args()
123:     backfill(args.days)
</file>

<file path="backend/scripts/backfill_watchlist_name.py">
 1: """
 2: 一次性脚本：回填 watchlist.stock_name（来自同花顺/新浪同步时遗漏的空名称）
 3: 数据源：akshare stock_zh_a_spot() 全市场实时行情（含 '名称' 列）
 4: 用法：python -m scripts.backfill_watchlist_name [--dry-run]
 5: """
 6: import argparse
 7: import os
 8: import sys
 9: # 保证 backend 包可被导入
10: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
11: from utils.http_constants import clear_proxy_env
12: clear_proxy_env()
13: from db import get_db  # noqa: E402
14: from db.models import Watchlist  # noqa: E402
15: def fetch_code_name_map():
16:     """从 akshare 拉取全市场 代码 -> 名称 映射（同时返回 带后缀 和 纯数字 两种 key）
17:     使用 stock_info_a_code_name() 而非 spot 行情接口（更快、更稳定）
18:     """
19:     try:
20:         import akshare as ak
21:     except ImportError:
22:         print('[backfill] akshare 未安装，跳过')
23:         return {}
24:     code_name = {}
25:     try:
26:         df = ak.stock_info_a_code_name()
27:         # 列：code, name
28:         for _, row in df.iterrows():
29:             bare = str(row['code']).strip()  # 纯数字代码，如 600519
30:             name = str(row.get('name', '')).strip()
31:             if not name:
32:                 continue
33:             code_name[bare] = name
34:             # 推断 ts_code 后缀
35:             if bare.startswith('6') or bare.startswith('9'):
36:                 code_name[f"{bare}.SH"] = name
37:             elif bare.startswith('4') or bare.startswith('8'):
38:                 code_name[f"{bare}.BJ"] = name
39:             else:
40:                 code_name[f"{bare}.SZ"] = name
41:         print(f'[backfill] akshare 返回 {len(code_name)} 条名称映射（含双重 key）')
42:     except Exception as e:
43:         print(f'[backfill] akshare stock_info_a_code_name 错误: {e}，回退到 stock_zh_a_spot')
44:         try:
45:             df = ak.stock_zh_a_spot()
46:             for _, row in df.iterrows():
47:                 code = str(row['代码'])
48:                 if code.startswith('sh'):
49:                     tc, bare = f"{code[2:]}.SH", code[2:]
50:                 elif code.startswith('sz'):
51:                     tc, bare = f"{code[2:]}.SZ", code[2:]
52:                 elif code.startswith('bj'):
53:                     tc, bare = f"{code[2:]}.BJ", code[2:]
54:                 else:
55:                     continue
56:                 name = str(row.get('名称', '')).strip()
57:                 if name:
58:                     code_name[tc] = name
59:                     code_name[bare] = name
60:             print(f'[backfill] 回退后返回 {len(code_name)} 条名称映射')
61:         except Exception as e2:
62:             print(f'[backfill] stock_zh_a_spot 也失败: {e2}')
63:     return code_name
64: def main():
