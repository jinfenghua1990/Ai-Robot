<file path="frontend/src/components/trading/MiniFlowChart.jsx">
 1: /**
 2:  * 轻量级分时资金趋势图（纯 SVG，无外部依赖）
 3:  * 双线：价格（蓝）+ 主力净流入（红/绿）
 4:  * 用于 SignalCard 展开区域
 5:  */
 6: import { memo } from 'react';
 7: function MiniFlowChart({ points = [], height = 60 }) {
 8:   if (!points || points.length < 2) {
 9:     return <div className="text-[10px] text-center py-2" style={{ color: 'var(--text-muted)' }}>数据不足</div>;
10:   }
11:   const W = 320;
12:   const H = height;
13:   const PAD_X = 2;
14:   const PAD_Y = 8;
15:   const labelW = 30;
16:   const chartW = W - labelW - PAD_X * 2;
17:   const chartH = H - PAD_Y * 2;
18:   const prices = points.map(p => p.price);
19:   const flows = points.map(p => p.main_force_inflow || 0);
20:   const pMax = Math.max(...prices);
21:   const pMin = Math.min(...prices);
22:   const pRange = Math.max(pMax - pMin, 0.01);
23:   const fMax = Math.max(...flows, 0);
24:   const fMin = Math.min(...flows, 0);
25:   const fRange = Math.max(fMax - fMin, 1);
26:   const stepX = chartW / (points.length - 1);
27:   // 价格线（蓝色）
28:   const pricePts = prices.map((v, i) => ({
29:     x: PAD_X + labelW + i * stepX,
30:     y: PAD_Y + chartH - ((v - pMin) / pRange) * chartH,
31:   }));
32:   const priceLine = pricePts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
33:   // 资金流向线（红/绿，0 轴分界）
34:   const zeroY = PAD_Y + chartH - ((0 - fMin) / fRange) * chartH;
35:   const flowPts = flows.map((v, i) => ({
36:     x: PAD_X + labelW + i * stepX,
37:     y: PAD_Y + chartH - ((v - fMin) / fRange) * chartH,
38:   }));
39:   const flowLine = flowPts.map((p, i) => `${i === 0 ? 'M' : 'L'}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(' ');
40:   const flowArea = `${flowLine} L${flowPts[flowPts.length - 1].x.toFixed(1)},${zeroY.toFixed(1)} L${flowPts[0].x.toFixed(1)},${zeroY.toFixed(1)} Z`;
41:   const lastPrice = prices[prices.length - 1];
42:   const lastFlow = flows[flows.length - 1];
43:   const flowColor = lastFlow >= 0 ? '#ef4444' : '#22c55e';
44:   return (
45:     <div className="w-full">
46:       <svg width="100%" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" style={{ maxHeight: H }}>
47:         <defs>
48:           <linearGradient id="flowGrad" x1="0" y1="0" x2="0" y2="1">
49:             <stop offset="0%" stopColor={flowColor} stopOpacity="0.3" />
50:             <stop offset="100%" stopColor={flowColor} stopOpacity="0" />
51:           </linearGradient>
52:         </defs>
53:         {/* 0 轴虚线 */}
54:         <line
55:           x1={PAD_X + labelW} y1={zeroY} x2={W - PAD_X} y2={zeroY}
56:           stroke="var(--border-color)" strokeWidth="0.5" strokeDasharray="2,2"
57:         />
58:         {/* 资金流向面积 */}
59:         <path d={flowArea} fill="url(#flowGrad)" />
60:         {/* 资金流向线 */}
61:         <path d={flowLine} fill="none" stroke={flowColor} strokeWidth="1.2" strokeLinejoin="round" />
62:         {/* 价格线 */}
63:         <path d={priceLine} fill="none" stroke="#3b82f6" strokeWidth="1.5" strokeLinejoin="round" />
64:         {/* 最新点 */}
65:         <circle cx={pricePts[pricePts.length - 1].x} cy={pricePts[pricePts.length - 1].y} r="2" fill="#3b82f6" />
66:         <circle cx={flowPts[flowPts.length - 1].x} cy={flowPts[flowPts.length - 1].y} r="2" fill={flowColor} />
67:       </svg>
68:       <div className="flex items-center justify-between text-[10px] mt-0.5" style={{ color: 'var(--text-muted)' }}>
69:         <span>📊 价格 <span style={{ color: '#3b82f6' }}>{lastPrice.toFixed(2)}</span></span>
70:         <span>💰 主力 <span style={{ color: flowColor }}>{(lastFlow / 10000).toFixed(1)}万</span></span>
71:         <span>{points[0].time} - {points[points.length - 1].time}</span>
72:       </div>
73:     </div>
74:   );
75: }
76: export default memo(MiniFlowChart);
</file>

