  1: """
  2: 策略共振股 20 天跟踪 API
  3: - 入池：从 strategy_result 拉取当日多策略共振 (>=2) 命中的股票
  4: - 每日盘后更新：拉行情 + BS 信号检查
  5: - 撤离：BS 出现 S 点 → 撤离放入历史；或跟踪满 20 天自动到期
  6: """
  7: import json
  8: import logging
  9: from datetime import datetime, date, timedelta
 10: from decimal import Decimal
 11: from fastapi import APIRouter, Query, HTTPException, Body
 12: from sqlalchemy import func, desc
 13: from db.session import get_db_session
 14: from db.models import (
 15:     StrategyResult,
