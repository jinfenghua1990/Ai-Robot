  1: """
  2: 双引擎决策系统 API
  3: GET /api/leader/system - 板块+龙头双层决策结果
  4: """
  5: import logging
  6: from fastapi import APIRouter, Query
  7: from starlette.concurrency import run_in_threadpool
  8: from datetime import date, datetime
  9: from sqlalchemy import func
 10: from analyzers.leader_engine import run_leader_engine, should_switch
 11: from analyzers.sector_engine import get_sector_ranking
 12: from db.connection import get_db
 13: from db.session import get_db_session
 14: from db.models import WatchlistSignalDaily, StockFeaturesDaily, StockFlow
 15: from services.leader_history_service import save_daily_leader
 16: from services.signal_builder import build_signal_for_stock, build_signal_from_precomputed
 17: router = APIRouter()
 18: logger = logging.getLogger(__name__)
 19: def _infer_market_suffix(code: str) -> str:
 20:     """根据 6 位代码推断市场后缀"""
 21:     if not code:
 22:         return '.SH'
 23:     c = str(code).strip()
 24:     if '.' in c:
 25:         return c.split('.', 1)[1].upper() or '.SH'
 26:     if c.startswith(('6', '9', '5')):
 27:         return '.SH'
 28:     if c.startswith(('0', '3', '1')):
 29:         return '.SZ'
 30:     if c.startswith(('8', '4')):
 31:         return '.BJ'
 32:     return '.SH'
 33: def _load_inflow_map(db, ts_codes: list, trade_date_str: str) -> dict:
 34:     """批量查 StockFlow 主力净流入（游资详情页用）
 35:     StockFlow 数据覆盖度远高于 StockFeaturesDaily，是主力净流入的权威源。
 36:     1日 = 当日 main_force_inflow；3日/5日 = 累计；连续天数 = 连续 > 0 交易日数
 37:     """
 38:     inflow_map = {}
 39:     if not ts_codes:
 40:         return inflow_map
 41:     # 归一化 ts_code + 纯 6 位 code
 42:     pure_codes = []
 43:     code_to_ts = {}
 44:     for tc in ts_codes:
 45:         if not tc:
 46:             continue
 47:         pure = tc.split('.')[0] if '.' in tc else tc
 48:         suffix = _infer_market_suffix(pure)
 49:         full_ts = f"{pure}{suffix}"
 50:         if pure not in pure_codes:
 51:             pure_codes.append(pure)
 52:         code_to_ts[pure] = full_ts
 53:     if not pure_codes:
 54:         return inflow_map
 55:     full_ts_list = [f"{c}.SH" if c.startswith(('6', '9', '5')) else f"{c}.SZ" if c.startswith(('0', '3', '1')) else f"{c}.BJ" for c in pure_codes]
 56:     # 取最近 10 个交易日（含当日），用于计算 1日/3日/5日/连续
 57:     rows = db.query(StockFlow).filter(
 58:         StockFlow.ts_code.in_(full_ts_list)
 59:     ).order_by(StockFlow.trade_date.desc()).limit(len(full_ts_list) * 10).all()
 60:     # 按 ts_code 分组
 61:     by_code = {}
 62:     for r in rows:
 63:         by_code.setdefault(r.ts_code, []).append(r)
 64:     for full_ts in full_ts_list:
 65:         records = by_code.get(full_ts, [])
 66:         if not records:
 67:             inflow_map[full_ts] = {
 68:                 'inflow_1d': 0, 'inflow_3d': 0, 'inflow_5d': 0,
 69:                 'flow_continuity': 0,
 70:             }
 71:             continue
 72:         # StockFlow.main_force_inflow 单位是万元（之前其他查询是元，注意统一）
 73:         # 这里按万元处理，前端展示"万"
 74:         # 找到当前 trade_date 当日（若无则取最新）
 75:         if trade_date_str:
 76:             target_date = trade_date_str
 77:             if hasattr(target_date, 'isoformat'):
 78:                 target_date = target_date.isoformat()
 79:         else:
 80:             target_date = None
 81:         # 取当日的 main_force_inflow（按 trade_date 匹配）
 82:         day1 = next((r for r in records if str(r.trade_date) == str(target_date)), None)
 83:         inflow_1d = float(day1.main_force_inflow or 0) if day1 else 0
 84:         # 3日累计：取 trade_date <= target_date 的 3 条，按 DESC 取前 3 条再求和
 85:         sorted_recs = records  # 已经 desc
 86:         inflow_3d = sum(float(r.main_force_inflow or 0) for r in sorted_recs[:3])
 87:         inflow_5d = sum(float(r.main_force_inflow or 0) for r in sorted_recs[:5])
 88:         # 连续净流入天数（从最近一天往前数 main_force_inflow > 0）
 89:         continuity = 0
 90:         for r in sorted_recs:
 91:             if float(r.main_force_inflow or 0) > 0:
 92:                 continuity += 1
 93:             else:
 94:                 break
 95:         inflow_map[full_ts] = {
 96:             'inflow_1d': inflow_1d * 10000,  # 万元 → 元（前端除以 10000 变万元显示）
 97:             'inflow_3d': inflow_3d * 10000,
 98:             'inflow_5d': inflow_5d * 10000,
 99:             'flow_continuity': continuity,
100:         }
101:     return inflow_map
102: def _enrich_with_inflow(stocks: list, inflow_map: dict) -> None:
103:     """把 inflow 数据注入到每只股票的 mainForce 字段（inplace）"""
104:     if not stocks:
105:         return
106:     for s in stocks:
107:         if not s:
108:             continue
109:         ts = s.get('ts_code') or ''
110:         if not ts and s.get('secCode'):
111:             ts = f"{s.get('secCode')}{_infer_market_suffix(s.get('secCode', ''))}"
112:         inflow = inflow_map.get(ts, {}) if ts else {}
113:         mf = s.get('mainForce') or {'stage': '平衡', 'score': 50}
114:         if not isinstance(mf, dict):
115:             mf = {'stage': '平衡', 'score': 50}
116:         mf['inflow_1d'] = inflow.get('inflow_1d', 0)
117:         mf['inflow_3d'] = inflow.get('inflow_3d', 0)
118:         mf['inflow_5d'] = inflow.get('inflow_5d', 0)
119:         mf['flow_continuity'] = inflow.get('flow_continuity', 0)
120:         s['mainForce'] = mf
121: def _enrich_with_leader_meta(stocks: list, original_map: dict) -> None:
122:     """从 leader_engine 原始数据补回 stage/strength/consecutive_days/change_rate
123:     （_enrich_stock 转换时丢失的原始龙头字段）"""
124:     if not stocks:
125:         return
126:     for s in stocks:
127:         if not s:
128:             continue
129:         ts = s.get('ts_code') or ''
130:         if not ts and s.get('secCode'):
131:             ts = f"{s.get('secCode')}{_infer_market_suffix(s.get('secCode', ''))}"
132:         orig = original_map.get(ts, {}) if ts else {}
133:         if orig:
134:             s['stage'] = orig.get('stage') or s.get('stage') or s.get('lifecycleStage')
135:             s['strength'] = orig.get('strength') if orig.get('strength') is not None else s.get('strength')
136:             s['consecutive_days'] = orig.get('consecutive_days') if orig.get('consecutive_days') is not None else s.get('consecutive_days')
137:             s['change_rate'] = orig.get('change_rate') if orig.get('change_rate') is not None else s.get('change_rate')
138:             s['phase'] = orig.get('phase') or s.get('phase') or '蓄势'
139:             s['phase_trend'] = orig.get('phase_trend') or s.get('phase_trend') or 'flat'
140:             s['track'] = orig.get('track') or s.get('track') or []
141: async def _enrich_stock(stock: dict, db, precomputed_map: dict = None) -> dict:
142:     """将 leader_engine 输出的股票数据增强为完整 18 字段 signal
143:     优先读预计算表，未命中才 fallback 到 build_signal_for_stock
144:     """
145:     if not stock or not stock.get('ts_code'):
146:         return stock
147:     ts_code = stock['ts_code']
148:     code = ts_code.split('.')[0] if '.' in ts_code else ts_code
149:     name = stock.get('name', '')
150:     sector = stock.get('sector', '')
151:     try:
152:         precomputed = (precomputed_map or {}).get(ts_code)
153:         if precomputed:
154:             signal = await build_signal_from_precomputed(
155:                 code, name, precomputed,
156:                 stage=stock.get('stage'),
157:                 strength=stock.get('strength'),
158:                 consecutive_days=stock.get('consecutive_days'),
159:                 lifecycle_stage=stock.get('stage'),
160:                 db=db,
161:             )
162:         else:
163:             signal = await build_signal_for_stock(
164:                 code, name, sector, db,
165:                 stage=stock.get('stage'),
166:                 strength=stock.get('strength'),
167:                 change_rate=stock.get('change_rate'),
168:                 consecutive_days=stock.get('consecutive_days'),
169:             )
170:         signal['leaderScore'] = stock.get('score', 0)
171:         signal['sectorScore'] = stock.get('sector_score')
172:         signal['sectorStateLabel'] = stock.get('sector_state_label')
173:         signal['details'] = stock.get('details')
174:         return signal
175:     except Exception as e:
176:         logger.warning(f' enrich {ts_code} failed: {e}')
177:         return stock
178: def _load_precomputed_map(db, ts_codes: list) -> dict:
179:     """同步查预计算表（最近交易日），返回 {ts_code: row}"""
180:     precomputed_map = {}
181:     if not ts_codes:
182:         return precomputed_map
183:     latest_date = db.query(func.max(WatchlistSignalDaily.trade_date)).scalar()
184:     if latest_date:
185:         rows = db.query(WatchlistSignalDaily).filter(
186:             WatchlistSignalDaily.trade_date == latest_date,
187:             WatchlistSignalDaily.ts_code.in_(ts_codes),
188:         ).all()
189:         for row in rows:
190:             precomputed_map[row.ts_code] = row
191:     return precomputed_map
192: _leader_cache = {'data': None, 'ts': 0, 'date': None}
193: _LEADER_CACHE_TTL = 5  # 5 秒结果缓存，避免短时间内重复计算
194: @router.get("/api/leader/system")
195: async def leader_system(target_date: str = Query(None, description="目标日期 YYYY-MM-DD")):
196:     """双引擎决策系统
197:     返回：
198:     - sector_filter: 板块引擎输出（strong/rotation/down）
199:     - leader: 主龙（唯一，含完整 signal 数据）
200:     - candidates: 候选龙（≤3只，含完整 signal 数据）
201:     - all_stocks: 热度池（前20，含完整 signal 数据）
202:     - switch_warning: 主龙切换预警
203:     """
204:     d = date.fromisoformat(target_date) if target_date else None
205:     today_str = target_date or datetime.now().strftime('%Y-%m-%d')
206:     # 5 秒结果缓存（同日内重复请求直接返回）
207:     import time as _time
208:     if (not target_date and _leader_cache['data']
209:             and _leader_cache['date'] == today_str
210:             and _time.time() - _leader_cache['ts'] < _LEADER_CACHE_TTL):
211:         return _leader_cache['data']
212:     result = await run_in_threadpool(run_leader_engine, d)
213:     # 切换预警：如果有候选且候选评分接近主龙
214:     switch_warning = None
215:     if result.get('leader') and result.get('candidates'):
216:         leader = result['leader']
217:         for c in result['candidates']:
218:             diff = leader['score'] - c['score']
219:             if diff <= 1.5 and c['change_rate'] > leader['change_rate']:
220:                 should, reason = should_switch(leader, c)
221:                 if should:
222:                     switch_warning = {
223:                         'new_candidate': c['name'],
224:                         'reason': reason,
225:                         'score_diff': round(diff, 1),
226:                     }
227:                     break
228:     # 自动写入龙头历史（主龙选出后记录）
229:     leader_raw = result.get('leader')
230:     trade_date = result.get('date')
231:     if leader_raw and trade_date:
232:         try:
233:             with get_db_session() as db:
234:                 save_daily_leader(db, trade_date, leader_raw['sector'], leader_raw)
235:         except Exception as e:
236:             logger.warning(f'龙头历史写入失败: {e}')
237:     # 构造完整 signal 数据
238:     import asyncio
239:     with get_db_session() as db:
240:         # 批量查预计算表（最近交易日），命中则跳过现场计算（丢线程池避免阻塞事件循环）
241:         all_raw = ([leader_raw] if leader_raw else []) + result.get('candidates', []) + result.get('all_stocks', [])
242:         ts_codes = [s.get('ts_code') for s in all_raw if s and s.get('ts_code')]
243:         precomputed_map = await run_in_threadpool(_load_precomputed_map, db, ts_codes)
244:         tasks = []
245:         if leader_raw:
246:             tasks.append(_enrich_stock(leader_raw, db, precomputed_map))
247:         candidates_raw = result.get('candidates', [])
248:         for c in candidates_raw:
249:             tasks.append(_enrich_stock(c, db, precomputed_map))
250:         all_stocks_raw = result.get('all_stocks', [])
251:         for s in all_stocks_raw:
252:             tasks.append(_enrich_stock(s, db, precomputed_map))
253:         successors_raw = result.get('successor_candidates', [])
254:         for s in successors_raw:
255:             tasks.append(_enrich_stock(s, db, precomputed_map))
256:         enriched = await asyncio.gather(*tasks, return_exceptions=True)
257:         idx = 0
258:         enriched_leader = None
259:         if leader_raw:
260:             r = enriched[idx]
261:             enriched_leader = r if not isinstance(r, Exception) else leader_raw
262:             idx += 1
263:         enriched_candidates = []
264:         for c in candidates_raw:
265:             r = enriched[idx]
266:             enriched_candidates.append(r if not isinstance(r, Exception) else c)
267:             idx += 1
268:         enriched_all = []
269:         for s in all_stocks_raw:
270:             r = enriched[idx]
271:             enriched_all.append(r if not isinstance(r, Exception) else s)
272:             idx += 1
273:         enriched_successors = []
274:         for s in successors_raw:
275:             r = enriched[idx]
276:             enriched_successors.append(r if not isinstance(r, Exception) else s)
277:             idx += 1
278:     # 注入主力净流入（inflow 1日/3日/5日 + 连续天数）— 游资详情页用
279:     try:
280:         # 从 leader_engine 原始数据取 ts_code（enriched 后的 stock 只有 secCode）
281:         all_ts = []
282:         for src in (result.get('leader'),) + tuple(result.get('candidates') or []) + tuple(result.get('all_stocks') or []):
283:             if src and src.get('ts_code') and src['ts_code'] not in all_ts:
284:                 all_ts.append(src['ts_code'])
285:         inflow_map = await run_in_threadpool(_load_inflow_map, db, all_ts, result.get('date'))
286:         _enrich_with_inflow([enriched_leader] if enriched_leader else [], inflow_map)
287:         _enrich_with_inflow(enriched_candidates, inflow_map)
288:         _enrich_with_inflow(enriched_all, inflow_map)
289:     except Exception as e:
290:         logger.warning(f'inflow enrichment failed: {e}')
291:     # 补回 leader_engine 原始字段（strength/连板/涨幅/stage）— 游资详情页用
292:     try:
293:         original_map = {}
294:         for src in (result.get('leader'),) + tuple(result.get('candidates') or []) + tuple(result.get('all_stocks') or []) + tuple(result.get('successor_candidates') or []):
295:             if src and src.get('ts_code'):
296:                 original_map[src['ts_code']] = src
297:         _enrich_with_leader_meta([enriched_leader] if enriched_leader else [], original_map)
298:         _enrich_with_leader_meta(enriched_candidates, original_map)
299:         _enrich_with_leader_meta(enriched_all, original_map)
300:         _enrich_with_leader_meta(enriched_successors, original_map)
301:     except Exception as e:
302:         logger.warning(f'leader_meta enrichment failed: {e}')
303:     response = {
304:         'leader': enriched_leader,
305:         'candidates': enriched_candidates,
306:         'all_stocks': enriched_all,
307:         'successor_candidates': enriched_successors,
308:         'all_count': result.get('all_count', 0),
309:         'sector_filter': result.get('sector_filter'),
310:         'sector_rotation': result.get('sector_rotation'),
311:         'decay_warning': result.get('decay_warning'),
312:         'current_leader_track': result.get('current_leader_track'),
313:         'switch_warning': switch_warning,
314:         'date': result.get('date'),
315:         'message': result.get('message', 'ok'),
316:     }
317:     # 写入 5 秒缓存
318:     if not target_date:
319:         _leader_cache['data'] = response
320:         _leader_cache['ts'] = _time.time()
321:         _leader_cache['date'] = today_str
322:     return response
