  1: """A small, dependency-free implementation of Qlib Alpha158 features.
  2: The V2 app does not import Qlib at runtime.  The formulas below are mapped
  3: from the local Qlib Alpha158 loader and are calculated only from bars visible
  4: on the signal date.  They are deliberately registered as candidate factors;
  5: the lifecycle engine decides whether any can enter the scoring set.
  6: """
  7: from __future__ import annotations
  8: import math
  9: from statistics import mean, pstdev
 10: from typing import Sequence
 11: from .domain import Bar, FactorDefinition
 12: WINDOWS = (5, 10, 20, 30, 60)
 13: def _safe(value: float | None) -> float | None:
 14:     if value is None:
 15:         return None
 16:     try:
 17:         value = float(value)
 18:     except (TypeError, ValueError):
 19:         return None
 20:     return value if math.isfinite(value) else None
 21: def _div(numerator: float | None, denominator: float | None) -> float | None:
 22:     if numerator is None or denominator is None or abs(denominator) < 1e-12:
 23:         return None
 24:     return _safe(numerator / denominator)
 25: def _slope(values: Sequence[float]) -> float | None:
 26:     if len(values) < 2:
 27:         return None
 28:     xbar = (len(values) - 1) / 2
 29:     ybar = mean(values)
 30:     den = sum((index - xbar) ** 2 for index in range(len(values)))
 31:     return _safe(sum((index - xbar) * (value - ybar) for index, value in enumerate(values)) / den) if den else None
 32: def _corr(left: Sequence[float], right: Sequence[float]) -> float | None:
 33:     if len(left) != len(right) or len(left) < 3:
 34:         return None
 35:     left_mean, right_mean = mean(left), mean(right)
 36:     left_sd = sum((value - left_mean) ** 2 for value in left) ** 0.5
 37:     right_sd = sum((value - right_mean) ** 2 for value in right) ** 0.5
 38:     if not left_sd or not right_sd:
 39:         return None
 40:     return _safe(sum((a - left_mean) * (b - right_mean) for a, b in zip(left, right)) / (left_sd * right_sd))
 41: def _quantile(values: Sequence[float], probability: float) -> float | None:
 42:     if not values:
 43:         return None
 44:     ordered = sorted(values)
 45:     position = (len(ordered) - 1) * probability
 46:     lower = int(position)
 47:     upper = min(lower + 1, len(ordered) - 1)
 48:     fraction = position - lower
 49:     return _safe(ordered[lower] + (ordered[upper] - ordered[lower]) * fraction)
