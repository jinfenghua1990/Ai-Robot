227:                 onChange={e => setNoteText(e.target.value)}
228:                 placeholder="如：突破压力位 / 龙头回调"
229:                 className="flex-1 px-2.5 py-1.5 rounded text-sm outline-none"
230:                 style={{ background: 'var(--bg-surface)', color: 'var(--text-primary)', border: '1px solid var(--border-color)' }}
231:               />
232:               <button onClick={saveNote} className="px-3 py-1 rounded text-xs font-bold" style={{ background: '#3b82f6', color: '#fff' }}>保存</button>
233:             </div>
234:           </div>
235:         )}
236:       </div>
237:       {/* 买入/卖出弹窗 */}
238:       {tradeType && (
239:         <TradeModal
240:           stockCode={code}
241:           stockName={name}
242:           type={tradeType}
243:           positionCount={positionCount}
244:           onClose={() => setTradeType(null)}
245:           onConfirm={executeTrade}
246:         />
247:       )}
248:       {/* 委托记录弹窗 */}
249:       {orderOpen && (
250:         <OrderHistoryModal
251:           stockName={name}
252:           secCode={code}
253:           orders={orders}
254:           onClose={() => setOrderOpen(false)}
255:         />
256:       )}
257:     </div>
258:   ), document.body);
259: }
