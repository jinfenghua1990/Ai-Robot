 24: def record_alert(level: str, category: str, message: str,
 25:                  trade_date: Optional[date] = None,
 26:                  details: Optional[Dict[str, Any]] = None,
 27:                  cooldown_seconds: int = 600) -> None:
 28:     """记录一条采集告警到数据库，并对重复告警做冷却去重。
 29:     采集任务通常每分钟运行一次，若数据源持续异常，原实现会每次
 30:     插入一条完全相同的问题告警，既放大数据库写入，也淹没真正的新问题。
 31:     这里按 level/category/trade_date/消息指纹做短时间冷却；不同错误内容
 32:     仍会正常记录。
 33:     """
 34:     if trade_date is None:
 35:         trade_date = date.today()
 36:     try:
 37:         with get_db_session() as db:
 38:             normalized_message = re.sub(r'\d+(?:\.\d+)?', '#', message)
 39:             fingerprint = hashlib.sha1(
 40:                 f'{level}|{category}|{trade_date}|{normalized_message}'.encode('utf-8')
 41:             ).hexdigest()
 42:             recent_since = datetime.now() - timedelta(seconds=cooldown_seconds)
 43:             recent_alerts = db.query(DataCollectionAlert.message).filter(
 44:                 DataCollectionAlert.level == level,
 45:                 DataCollectionAlert.category == category,
 46:                 DataCollectionAlert.trade_date == trade_date,
 47:                 DataCollectionAlert.created_at >= recent_since,
 48:             ).limit(50).all()
 49:             duplicate = any(
 50:                 re.sub(r'\d+(?:\.\d+)?', '#', row[0] or '') == normalized_message
 51:                 for row in recent_alerts
 52:             )
 53:             if duplicate:
 54:                 logger.debug('[alert_service] suppressed duplicate alert %s', fingerprint[:10])
 55:                 return
 56:             alert = DataCollectionAlert(
 57:                 level=level,
 58:                 category=category,
 59:                 message=message,
 60:                 details=json.dumps(details, ensure_ascii=False, default=str) if details else None,
 61:                 trade_date=trade_date,
 62:             )
 63:             db.add(alert)
 64:             db.commit()
 65:     except Exception as e:
 66:         logger.warning(f'[alert_service] failed to record alert: {e}', exc_info=True)
 67: def get_recent_alerts(level: Optional[str] = None,
