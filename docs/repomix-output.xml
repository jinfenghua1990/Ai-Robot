234: # ---------------------------------------------------------------------------
235: # 估值计算
236: # ---------------------------------------------------------------------------
237: def calc_peg(pe: float, cagr: float) -> float:
238:     if cagr <= 0:
239:         return float("inf")
240:     return pe / (cagr * 100)
241: def pe_digestion(current_pe: float, cagr: float, target_pe: float = 30) -> float:
242:     if current_pe <= target_pe:
243:         return 0.0
244:     if cagr <= 0:
245:         return float("inf")
246:     return math.log(current_pe / target_pe) / math.log(1 + cagr)
247: def financials(code: str) -> dict:
248:     """财务关键指标（同花顺财务摘要，最新报告期）—— 干净可靠的营收/净利/ROE/毛利率等。
249:     注：mootdx finance() 的营收/净利数值不可靠(实测放大数倍)，故财务摘要走此源。
250:     """
251:     ak = _akshare()
252:     df = ak.stock_financial_abstract_ths(symbol=code, indicator="按报告期")
253:     if df is None or df.empty:
254:         return {}
255:     row = df.iloc[-1].to_dict()  # 最新报告期（按报告期升序，取末行）
256:     def g(k):
257:         v = row.get(k)
258:         return None if v in (False, "false", "", None) else v
259:     return {
260:         "period": g("报告期"),
261:         "revenue": g("营业总收入"), "revenue_yoy": g("营业总收入同比增长率"),
262:         "net_profit": g("净利润"), "net_profit_yoy": g("净利润同比增长率"),
263:         "eps": g("基本每股收益"), "bvps": g("每股净资产"),
264:         "roe": g("净资产收益率"), "gross_margin": g("销售毛利率"), "net_margin": g("销售净利率"),
265:         "op_cf_ps": g("每股经营现金流"),
266:     }
267: def valuation_percentile(code: str, period: str = "近五年") -> dict:
268:     """历史估值分位（百度股市通）：PE-TTM / PB 的当前值 + 历史 20/50/80 分位带 + 所处分位。
269:     只表达"处于历史什么位置"，不划买卖线（理杏仁式中立呈现）。
270:     """
271:     ak = _akshare()
272:     def _q(vals: list, p: float) -> float:
273:         if not vals:
274:             return 0.0
275:         idx = p * (len(vals) - 1)
276:         lo = int(idx)
277:         if lo + 1 >= len(vals):
278:             return vals[-1]
279:         frac = idx - lo
280:         return vals[lo] * (1 - frac) + vals[lo + 1] * frac
281:     metrics = {}
282:     for key, ind in (("pe_ttm", "市盈率(TTM)"), ("pb", "市净率")):
283:         try:
284:             df = ak.stock_zh_valuation_baidu(symbol=code, indicator=ind, period=period)
285:             raw = df.iloc[:, 1].dropna().astype(float).tolist()
286:             if not raw:
287:                 continue
288:             cur = float(raw[-1])
289:             s = sorted(raw)
290:             below = sum(1 for x in s if x < cur)
291:             metrics[key] = {
292:                 "current": round(cur, 2),
293:                 "percentile": round(below / max(len(s) - 1, 1) * 100, 1),
294:                 "min": round(s[0], 2), "max": round(s[-1], 2),
295:                 "p20": round(_q(s, 0.2), 2), "p50": round(_q(s, 0.5), 2), "p80": round(_q(s, 0.8), 2),
296:                 "n": len(s),
297:             }
298:         except Exception:
299:             continue
300:     return {"period": "近5年", "metrics": metrics}
301: def full_valuation(code: str) -> dict:
302:     """单票完整估值：腾讯行情 + 一致预期 EPS + 前向PE/PEG/消化年数。"""
303:     quotes = tencent_quote([code])
304:     q = quotes.get(code)
305:     if not q:
306:         raise ValueError(f"未取到 {code} 的行情")
307:     price = q["price"]
308:     out = {
309:         "name": q["name"], "code": code, "price": price,
310:         "mcap_yi": q["mcap_yi"], "pe_ttm": q["pe_ttm"], "pb": q["pb"],
311:         "eps_26e": None, "eps_27e": None, "pe_26e": None,
312:         "cagr_pct": None, "peg": None, "digest_years": None, "analyst_count": 0,
313:     }
314:     try:
315:         rows = profit_forecast(code)
316:     except DependencyMissing:
317:         out["forecast_note"] = "一致预期需安装 akshare"
318:         return out
319:     def _eps(row: dict):
320:         # 同花顺对覆盖不全的股票会缺「均值」或给 '-' 占位，硬取会让整只票的估值接口 502
321:         try:
322:             return float(str(row.get("均值", "")).replace(",", ""))
