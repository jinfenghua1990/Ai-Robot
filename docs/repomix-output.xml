  1: // AiDiagnosisModule：底部独立 AI 联动诊断（盘后 ‖ 实时 双列，规则化合成）。
  2: // 2026-07-19 v2：3 行结构化布局
  3: //   行1：结论标签 + 多空评分进度条（空头/多头双向条）
  4: //   行2：多头逻辑（绿底）+ 命中条件
  5: //   行3：空头风险（红底）+ 命中条件
  6: // 左右严格对齐：左盘后 / 右实时
  7: import { memo, useMemo } from 'react';
  8: function synthesize(dash, inst, rt, rtAvail, side) {
  9:   const isRt = side === 'rt';
 10:   const trend = isRt ? (rtAvail ? rt.trend_strength : null) : dash.trend_strength;
 11:   const chg = isRt ? (rtAvail ? rt.price_chg : null) : (dash.quote ? dash.quote.change : null);
 12:   const rel = isRt ? (rtAvail ? rt.relative_strength : null) : dash.relative_strength;
 13:   const mainNet = isRt ? (rtAvail ? rt.main_net : null) : (inst ? inst.main_net : null);
 14:   const signals = [];
 15:   if (trend != null && trend < 40) {
 16:     signals.push({ type: 'bear', weight: -2, text: '技术破位（触发风控）' });
 17:   } else if (trend != null && trend >= 60) {
 18:     signals.push({ type: 'bull', weight: 1, text: '技术走强' });
 19:   }
 20:   if (chg != null && chg > 0) signals.push({ type: 'bull', weight: 1, text: '当日上涨' });
 21:   if (rel != null && rel > 50) signals.push({ type: 'bull', weight: 1, text: '板块升温' });
 22:   if (mainNet != null && mainNet > 0) signals.push({ type: 'bull', weight: 1, text: '资金流入' });
 23:   const bear = signals.filter((s) => s.type === 'bear').reduce((a, s) => a + s.weight, 0);
 24:   const bull = signals.filter((s) => s.type === 'bull').reduce((a, s) => a + s.weight, 0);
 25:   const riskTriggered = signals.some((s) => s.type === 'bear' && s.weight <= -2);
 26:   const bullTexts = signals.filter((s) => s.type === 'bull').map((s) => s.text);
 27:   const bearTexts = signals.filter((s) => s.type === 'bear').map((s) => s.text);
 28:   return { signals, bear, bull, riskTriggered, trend, bullTexts, bearTexts };
 29: }
 30: // 综合评级：基于多空分差给出 5 档评级
 31: function grade(bear, bull, riskTriggered) {
 32:   if (riskTriggered) return { label: '风控', color: '#ef4444', bg: 'rgba(239,68,68,0.15)' };
 33:   const net = bull + bear; // bear 为负数
 34:   if (net >= 3) return { label: '强烈看多', color: '#dc2626', bg: 'rgba(220,38,38,0.12)' };
 35:   if (net >= 1) return { label: '偏多', color: '#ef4444', bg: 'rgba(239,68,68,0.08)' };
 36:   if (net === 0) return { label: '中性', color: '#94a3b8', bg: 'rgba(148,163,184,0.08)' };
 37:   if (net >= -1) return { label: '偏空', color: '#22c55e', bg: 'rgba(34,197,94,0.08)' };
 38:   return { label: '看空', color: '#16a34a', bg: 'rgba(22,163,74,0.12)' };
 39: }
 40: function AiDiagnosisModule({ dash, inst, rt, rtAvail }) {
 41:   const after = useMemo(() => dash ? synthesize(dash, inst, null, false, 'after') : null, [dash, inst]);
 42:   const real = useMemo(() => (dash && rtAvail) ? synthesize(dash, inst, rt, true, 'rt') : null, [dash, inst, rt, rtAvail]);
 43:   if (!dash) return null;
 44:   // 多空维度上限（用于行1的 N/M 格式显示）
 45:   // 多头维度上限 = 4（技术走强 + 当日上涨 + 板块升温 + 资金流入）
 46:   // 空头维度上限 = 2（技术破位 weight=-2；其他维度暂未加空头）
 47:   const BULL_MAX = 4;
 48:   const BEAR_MAX = 2;
 49:   // 渲染行1（结论标签 + 多空计数）— 合并到模块标题同一行
 50:   const renderHeader = (syn, title, isRt) => {
 51:     const g = syn ? grade(syn.bear, syn.bull, syn.riskTriggered) : null;
 52:     const bullAbs = syn ? syn.bull : 0;
 53:     const bearAbs = syn ? Math.abs(syn.bear) : 0;
 54:     const net = syn ? (syn.bull + syn.bear) : 0;
 55:     return (
 56:       <div className="flex items-center justify-between gap-1 mb-0.5 min-h-[16px]">
 57:         <span className="text-[9px] font-bold tracking-wider whitespace-nowrap" style={{ color: 'var(--text-muted)' }}>{title}</span>
 58:         {syn ? (
 59:           <div className="flex items-center gap-1.5 flex-shrink-0">
 60:             <span
 61:               className="text-[10px] px-1.5 py-0.5 rounded font-bold whitespace-nowrap"
 62:               style={{ background: g.bg, color: g.color, border: `1px solid ${g.color}40` }}
 63:               title={`多 ${bullAbs}/${BULL_MAX} · 空 ${bearAbs}/${BEAR_MAX}（bear 为负数，net=${net}）`}
 64:             >
 65:               {g.label}
 66:             </span>
 67:             <span className="text-[10px] tabular-nums whitespace-nowrap" style={{ color: 'var(--text-muted)' }}>
 68:               <span style={{ color: '#ef4444' }} className="font-bold">多{bullAbs}/{BULL_MAX}</span>
 69:               <span style={{ color: 'var(--text-muted)' }}> · </span>
 70:               <span style={{ color: '#22c55e' }} className="font-bold">空{bearAbs}/{BEAR_MAX}</span>
 71:             </span>
 72:           </div>
 73:         ) : (
 74:           <span className="text-[10px] italic" style={{ color: 'var(--text-muted)' }}>
 75:             {isRt ? '实时暂无数据' : '盘后暂无数据'}
 76:           </span>
 77:         )}
 78:       </div>
 79:     );
 80:   };
 81:   // 渲染行2+行3（多头逻辑 + 空头风险）
 82:   const renderBody = (syn) => (
 83:     <>
 84:       {/* 行2：多头逻辑 */}
 85:       <div className="flex items-start gap-1 px-1 py-0.5 rounded min-h-[16px]" style={{ background: (syn && syn.bull > 0) ? 'rgba(239,68,68,0.06)' : 'transparent' }}>
 86:         <span className="text-[9px] font-bold flex-shrink-0" style={{ color: (syn && syn.bull > 0) ? '#ef4444' : 'var(--text-muted)' }}>多</span>
 87:         <span className="text-[10px] leading-snug" style={{ color: (syn && syn.bull > 0) ? 'var(--text-primary)' : 'var(--text-muted)' }}>
 88:           {(syn && syn.bullTexts.length > 0) ? syn.bullTexts.join(' + ') : '无显著多头信号'}
 89:         </span>
 90:       </div>
 91:       {/* 行3：空头风险 */}
 92:       <div className="flex items-start gap-1 px-1 py-0.5 rounded min-h-[16px]" style={{ background: (syn && syn.bear < 0) ? 'rgba(34,197,94,0.06)' : 'transparent' }}>
 93:         <span className="text-[9px] font-bold flex-shrink-0" style={{ color: (syn && syn.bear < 0) ? '#22c55e' : 'var(--text-muted)' }}>空</span>
 94:         <span className="text-[10px] leading-snug" style={{ color: (syn && syn.bear < 0) ? 'var(--text-primary)' : 'var(--text-muted)' }}>
 95:           {(syn && syn.bearTexts.length > 0) ? syn.bearTexts.join(' + ') : '无显著空头风险'}
 96:         </span>
 97:       </div>
 98:     </>
 99:   );
100:   return (
101:     <>
102:       {/* 全宽横条分隔（与其他模块统一：h-px + 同色 border-color） */}
103:       <div className="h-px w-full" style={{ backgroundColor: 'var(--border-color)' }} />
104:       <div className="px-2.5 py-1.5">
105:         <div className="flex items-stretch">
106:           {/* 左：盘后 */}
107:           <div className="flex-1 min-w-0 pr-2.5 flex flex-col gap-0.5">
108:             {renderHeader(after, '🤖 AI 联动诊断 · 盘后', false)}
109:             {renderBody(after)}
