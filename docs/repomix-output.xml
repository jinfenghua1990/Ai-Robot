39:             'ts_code': r.get('ts_code'),
40:             'name': r.get('name'),
41:             'ann_date': _parse_date(r.get('ann_date')),
42:             'end_date': _parse_date(r.get('end_date')),
43:             'holder_num': _int(r.get('holder_num')),
44:             'avg_shares': _float(r.get('avg_shares')),
45:         })
46:     return rows
47: def _parse_date(v):
48:     if not v:
49:         return None
50:     if isinstance(v, str):
51:         return datetime.strptime(v, '%Y%m%d').date()
52:     return v
53: def save_rows(rows):
54:     if not rows:
55:         return 0
56:     db = SessionLocal()
57:     try:
58:         for row in rows:
59:             stmt = pg_insert(StockHolderNumber).values(**row)
60:             stmt = stmt.on_conflict_do_update(
61:                 index_elements=['ts_code', 'ann_date'],
62:                 set_={
63:                     'name': stmt.excluded.name,
64:                     'end_date': stmt.excluded.end_date,
65:                     'holder_num': stmt.excluded.holder_num,
66:                     'avg_shares': stmt.excluded.avg_shares,
67:                 }
68:             )
69:             db.execute(stmt)
70:         db.commit()
71:         return len(rows)
72:     finally:
73:         db.close()
74: def run_full_refresh():
75:     """全量：拉最近 5 年数据"""
76:     end = datetime.now().strftime('%Y%m%d')
77:     start = (datetime.now() - timedelta(days=365 * 5)).strftime('%Y%m%d')
78:     rows = fetch_holder_number(start_date=start, end_date=end)
79:     return save_rows(rows)
80: def run_daily():
81:     """增量：拉最近 90 天，覆盖最新一期"""
82:     end = datetime.now().strftime('%Y%m%d')
83:     start = (datetime.now() - timedelta(days=90)).strftime('%Y%m%d')
84:     rows = fetch_holder_number(start_date=start, end_date=end)
85:     return save_rows(rows)
86: if __name__ == '__main__':
87:     import argparse
88:     parser = argparse.ArgumentParser()
89:     parser.add_argument('--full', action='store_true', help='full refresh')
90:     args = parser.parse_args()
91:     count = run_full_refresh() if args.full else run_daily()
92:     print(f'saved {count} rows')
