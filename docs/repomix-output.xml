  1: """
  2: 龙头生命周期 V2 — 多维度强度评分
  3: 保留原 identify_stage 阶段判断逻辑，强度改为连续值计算
  4: """
  5: import sys, os, math
  6: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
  7: import logging
  8: from datetime import datetime
  9: from db.session import get_db_session
 10: from db.models import LeaderLifecycle, StockFlow
 11: from sqlalchemy import func
 12: logger = logging.getLogger(__name__)
 13: # 阶段判断（新命名）
 14: def identify_stage(consecutive_days, change_rate, main_force_inflow):
 15:     if consecutive_days <= 1:
 16:         return '突破'
 17:     elif consecutive_days <= 3:
 18:         if main_force_inflow > 0:
 19:             return '加速'
 20:         return '分歧'
 21:     elif consecutive_days >= 4:
 22:         if change_rate > 5:
 23:             return '主升'
 24:         elif change_rate > 0:
 25:             return '分歧'
 26:         else:
 27:             return '衰退'
 28:     return '突破'
 29: # 阶段加成（加速最优，主升降分因高位风险）
 30: STAGE_BONUS = {
 31:     '突破': 15,
 32:     '加速': 20,
 33:     '主升': 10,
 34:     '分歧': 5,
 35:     '衰退': 0,
 36: }
 37: STAGE_COLORS = {
 38:     '突破': '#facc15',
 39:     '加速': '#fb923c',
 40:     '主升': '#ef4444',
 41:     '分歧': '#f97316',
 42:     '衰退': '#94a3b8',
 43: }
 44: # 连板分映射表（非单调：2-3板最优，4板+递减因高位风险）
 45: CONN_SCORE_MAP = {0: 5, 1: 15, 2: 30, 3: 30, 4: 20, 5: 10}
 46: def get_conn_score(consecutive_days):
 47:     if consecutive_days >= 6:
 48:         return 5  # 6板+ 高位风险极大
 49:     return CONN_SCORE_MAP.get(consecutive_days, 5)
 50: def calculate_strength(consecutive_days, change_rate, main_force_inflow, stage):
 51:     """
 52:     多维度强度评分 V2（0-100 连续值）
 53:     回测优化后公式（V2.1）：
 54:       连板分 (30分): 非单调，2-3板满分，4板+递减（高位风险）
 55:       涨幅分 (10分): |涨幅| × 1，10%满分（涨停无区分度，降权）
 56:       资金分 (40分): sqrt(流入/50万) × 40，平方根曲线提升低端区分度
 57:       阶段加成 (20分): 加速20 / 突破15 / 主升10 / 分歧5 / 衰退0
 58:     """
 59:     # 连板分（0-30，非单调）
 60:     conn_score = get_conn_score(consecutive_days)
 61:     # 涨幅分（0-10，涨停股无区分度故降权）
 62:     change_score = min(abs(change_rate) * 1, 10)
 63:     # 资金分（0-40，平方根曲线：低端区分度提升3-4倍）
 64:     fund_score = min(math.sqrt(max(main_force_inflow, 0) / 50) * 40, 40) if main_force_inflow > 0 else 0
 65:     # 阶段加成（0-20）
 66:     stage_score = STAGE_BONUS.get(stage, 0)
 67:     total = conn_score + change_score + fund_score + stage_score
 68:     return round(min(total, 100), 1)
 69: def get_lifecycle_v2(trade_date):
 70:     """返回 V2 龙头生命周期数据（含多维度强度）"""
 71:     try:
 72:         with get_db_session() as db:
 73:             leaders = db.query(LeaderLifecycle).filter_by(trade_date=trade_date).all()
 74:             if not leaders:
 75:                 return {'date': trade_date, 'leaders': [], 'message': '无龙头数据'}
 76:             # 获取前一交易日（计算连板天数）
 77:             trade_date_obj = datetime.strptime(trade_date, '%Y-%m-%d') if isinstance(trade_date, str) else trade_date
 78:             prev_date_row = db.query(func.max(LeaderLifecycle.trade_date)).filter(
 79:                 LeaderLifecycle.trade_date < trade_date_obj.date()
 80:             ).scalar()
 81:             prev_leaders = []
 82:             if prev_date_row:
 83:                 prev_leaders = db.query(LeaderLifecycle).filter_by(trade_date=prev_date_row).all()
 84:             prev_map = {l.ts_code: l for l in prev_leaders}
 85:             # 批量获取个股资金数据
 86:             ts_codes = [l.ts_code for l in leaders]
 87:             stocks = db.query(StockFlow).filter(
 88:                 StockFlow.trade_date == trade_date,
 89:                 StockFlow.ts_code.in_(ts_codes)
 90:             ).all()
 91:             stock_map = {s.ts_code: s for s in stocks}
 92:             result = []
 93:             for leader in leaders:
 94:                 stock = stock_map.get(leader.ts_code)
 95:                 change_rate = float(stock.price_chg or 0) if stock else 0
 96:                 main_force = float(stock.main_force_inflow or 0) if stock else 0
 97:                 # 连板天数
 98:                 prev_leader = prev_map.get(leader.ts_code)
 99:                 consecutive_days = (prev_leader.consecutive_days or 0) + 1 if prev_leader else 1
100:                 # 阶段判断（与 V1 一致）
101:                 stage = identify_stage(consecutive_days, change_rate, main_force)
102:                 # 多维度强度
103:                 strength = calculate_strength(consecutive_days, change_rate, main_force, stage)
104:                 # 各维度得分（用于前端展示）
105:                 conn_score = get_conn_score(consecutive_days)
106:                 change_score = min(abs(change_rate) * 1, 10)
107:                 fund_score = min(math.sqrt(max(main_force, 0) / 50) * 40, 40) if main_force > 0 else 0
108:                 stage_score = STAGE_BONUS.get(stage, 0)
109:                 result.append({
110:                     'ts_code': leader.ts_code,
111:                     'name': leader.name or stock.name if stock else '',
112:                     'sector': leader.sector,
113:                     'stage': stage,
114:                     'strength': strength,
115:                     'consecutive_days': consecutive_days,
116:                     'change_rate': round(change_rate, 2),
117:                     'main_force_inflow': round(main_force, 2),
118:                     # 维度分解
119:                     'scores': {
120:                         'connection': round(conn_score, 1),
121:                         'change': round(change_score, 1),
122:                         'fund': round(fund_score, 1),
123:                         'stage_bonus': stage_score,
124:                     },
125:                 })
126:             # 按强度降序
127:             result.sort(key=lambda x: -x['strength'])
128:             return {
129:                 'date': trade_date,
