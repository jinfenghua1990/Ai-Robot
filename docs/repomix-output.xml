 91:                         WHERE ts_code=:code AND trade_date = ANY(:dates)
 92:                     """),
 93:                     {'code': ts_code, 'dates': date_list}
 94:                 ).fetchall()
 95:                 adj_map = {str(r[0]): float(r[1]) for r in adj_rows}
 96:                 # 用最新的 adj_factor 回溯修正全部 K 线
 97:                 latest_adj = None
 98:                 for ad in sorted(adj_map.values(), reverse=True):
 99:                     latest_adj = ad
100:                     break
101:                 if latest_adj and latest_adj != 1.0:
102:                     for k in klines:
103:                         adj = adj_map.get(k['day'].replace('-', ''), latest_adj)
