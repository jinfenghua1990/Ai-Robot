  1: """US Quant System — 盘前扫描、盘中触发与信号生命周期"""
  2: from __future__ import annotations
  3: from datetime import datetime, timedelta
  4: from typing import Optional
  5: from .contracts import Signal
  6: from .filters import check_premarket_filters
  7: from .market_regime import MarketRegime
  8: # ─── 盘前扫描 ─────────────────────────────────────────────────────────────────
  9: def scan_premarket(
 10:     symbol: str,
 11:     name: str,
 12:     premarket_change_pct: float,
 13:     premarket_dollar_volume: float,
 14:     premarket_volume: float,
 15:     relative_volume: float,
 16:     spread: float,
 17:     price: float,
 18:     avg_dollar_volume_20d: float,
 19:     catalyst: str = "",
 20:     sector_aligned: bool = False,
 21:     industry: str = "",
 22:     sector_rank: int = 0,
 23:     regime: Optional[MarketRegime] = None,
 24: ) -> Optional[dict]:
 25:     """盘前扫描单只股票
 26:     返回候选字典或 None（被过滤掉）
 27:     """
 28:     # 过滤
 29:     f = check_premarket_filters(
 30:         premarket_change_pct=premarket_change_pct,
 31:         premarket_dollar_volume=premarket_dollar_volume,
 32:         relative_volume=relative_volume,
 33:         spread=spread,
 34:         price=price,
 35:         avg_dollar_volume_20d=avg_dollar_volume_20d,
 36:         has_catalyst=bool(catalyst),
 37:     )
 38:     if not f.passed:
 39:         return None
 40:     # 高波动池
 41:     high_volatility = premarket_change_pct > 10
 42:     return {
 43:         "symbol": symbol,
 44:         "name": name,
 45:         "premarket_change_pct": round(premarket_change_pct, 2),
 46:         "premarket_volume": premarket_volume,
 47:         "premarket_dollar_volume": premarket_dollar_volume,
 48:         "premarket_high": price * (1 + premarket_change_pct / 100),
 49:         "premarket_low": price,
 50:         "spread": spread,
 51:         "catalyst": catalyst,
 52:         "industry": industry,
 53:         "sector_rank": sector_rank,
 54:         "high_volatility": high_volatility,
 55:         "position_mult": 0.5 if high_volatility else 1.0,
 56:         "regime": regime.regime if regime else "",
 57:     }
 58: # ─── 盘中触发 ─────────────────────────────────────────────────────────────────
 59: def check_intraday_trigger(
 60:     price: float,
 61:     opening_range_high: float,
 62:     opening_range_low: float,
 63:     vwap: float,
 64:     previous_close: float,
 65:     relative_spy_strong: bool = False,
 66:     sector_aligned: bool = False,
 67:     market_aligned: bool = False,
 68:     rel_volume: Optional[float] = None,
 69:     upper_shadow: bool = False,
 70:     regime: Optional[MarketRegime] = None,
 71: ) -> dict:
 72:     """检查盘中触发条件"""
 73:     result = {
 74:         "triggered": False,
 75:         "trigger_type": "",
 76:         "reasons": [],
 77:         "details": {},
 78:     }
 79:     # 市场状态检查
 80:     if regime and not regime.allow_new_positions:
 81:         result["reasons"].append(f"市场状态 {regime.regime} 禁止新开仓")
 82:         return result
 83:     # 15分钟开盘区间突破
 84:     if price > opening_range_high:
 85:         result["trigger_type"] = "开盘区间突破"
 86:         result["triggered"] = True
 87:         result["reasons"].append(f"突破15分钟开盘区间高点 {opening_range_high:.2f}")
 88:     # VWAP 回踩承接
 89:     if price >= vwap * 0.995 and price <= vwap * 1.005:
 90:         result["trigger_type"] = "VWAP回踩"
 91:         result["triggered"] = True
 92:         result["reasons"].append(f"回踩VWAP {vwap:.2f} 后承接")
 93:     # 假突破排除
 94:     if upper_shadow:
 95:         result["triggered"] = False
 96:         result["reasons"].append("长上影，排除假突破")
 97:     if rel_volume and rel_volume < 1.0:
 98:         result["triggered"] = False
 99:         result["reasons"].append("成交量不足")
100:     if not sector_aligned:
101:         result["reasons"].append("行业不同步")
102:     if not market_aligned:
103:         result["reasons"].append("指数不同步")
104:     result["details"] = {
105:         "price": price,
106:         "opening_range_high": opening_range_high,
107:         "opening_range_low": opening_range_low,
108:         "vwap": vwap,
109:         "rel_volume": rel_volume,
110:         "relative_spy_strong": relative_spy_strong,
111:         "sector_aligned": sector_aligned,
112:         "market_aligned": market_aligned,
113:     }
114:     return result
115: # ─── 信号生命周期管理 ─────────────────────────────────────────────────────────
116: SIGNAL_LIFECYCLE_STATES = [
117:     "DISCOVERED",
118:     "SCORED",
119:     "WATCHING",
120:     "TRIGGERED",
121:     "RISK_REJECTED",
122:     "APPROVED",
123:     "ORDER_CREATED",
124:     "ACTIVE",
125:     "EXIT_TRIGGERED",
126:     "CLOSED",
127:     "EXPIRED",
128: ]
129: VALID_TRANSITIONS = {
130:     "DISCOVERED": ["SCORED", "EXPIRED"],
131:     "SCORED": ["WATCHING", "RISK_REJECTED", "EXPIRED"],
132:     "WATCHING": ["TRIGGERED", "EXPIRED"],
133:     "TRIGGERED": ["RISK_REJECTED", "APPROVED", "EXPIRED"],
134:     "RISK_REJECTED": ["EXPIRED"],
135:     "APPROVED": ["ORDER_CREATED", "EXPIRED"],
136:     "ORDER_CREATED": ["ACTIVE", "EXPIRED"],
137:     "ACTIVE": ["EXIT_TRIGGERED", "CLOSED"],
138:     "EXIT_TRIGGERED": ["CLOSED"],
139:     "CLOSED": [],
140:     "EXPIRED": [],
141: }
142: def transition_signal(signal: Signal, new_status: str) -> tuple[bool, str]:
143:     """尝试转换信号状态"""
144:     if signal.lifecycle_status not in VALID_TRANSITIONS:
145:         return False, f"未知状态: {signal.lifecycle_status}"
146:     if new_status not in VALID_TRANSITIONS[signal.lifecycle_status]:
147:         return False, f"不能从 {signal.lifecycle_status} 转换到 {new_status}"
148:     signal.lifecycle_status = new_status
149:     return True, f"信号已从 {signal.lifecycle_status} 转换到 {new_status}"
150: def create_signal(
151:     symbol: str,
152:     name: str,
153:     strategy: str,
154:     strategy_version: str,
155:     score: float,
156:     signal_time: Optional[datetime] = None,
157:     planned_entry: Optional[float] = None,
158:     planned_stop: Optional[float] = None,
159:     planned_target: Optional[float] = None,
160:     expected_rr: Optional[float] = None,
161:     market_regime: str = "",
162:     sector_rank: int = 0,
163:     trigger_details: Optional[dict] = None,
164: ) -> Signal:
165:     """创建新信号"""
166:     signal_time = signal_time or datetime.utcnow()
167:     expires_at = signal_time + timedelta(days=3)  # 默认3天过期
168:     return Signal(
169:         symbol=symbol,
170:         name=name,
171:         strategy=strategy,
172:         strategy_version=strategy_version,
173:         signal_type="ENTRY",
174:         lifecycle_status="DISCOVERED",
175:         score=score,
176:         signal_time=signal_time,
177:         expires_at=expires_at,
178:         planned_entry=planned_entry,
179:         planned_stop=planned_stop,
180:         planned_target=planned_target,
181:         expected_rr=expected_rr,
182:         market_regime=market_regime,
183:         sector_rank=sector_rank,
184:         trigger_details=trigger_details or {},
185:     )
