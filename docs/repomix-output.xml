 64: # ============================================================
 65: # BS 区间计算：SuperTrend 天然交替 B→S→B→S，每个 B-S 对构成一个持仓/空仓区间
 66: # 区间信息暴露给前端：起止日期、起止价格、持有天数、区间盈亏%
 67: # ============================================================
 68: def _calc_bs_interval(bs_signals: list, current_price: float = 0.0) -> dict:
 69:     """
 70:     从 BS 信号序列中提取当前所在区间信息。
 71:     返回结构：
 72:     {
 73:         'state': 'holding' | 'empty' | 'unknown',
 74:         'start_date': str,      'start_price': float,
 75:         'end_date': str,        # S 触发时为卖出日；当前持仓中为最近K线日期
 76:         'end_price': float,
 77:         'hold_days': int,
 78:         'pnl_pct': float,      # 区间盈亏%（仅 holding 时有意义；空仓=区间跌幅）
 79:     }
 80:     """
 81:     if not bs_signals:
 82:         return {'state': 'unknown'}
 83:     last = bs_signals[-1]
 84:     last_type = last.get('type')
 85:     last_date = last.get('date', '')
 86:     last_price = last.get('price', 0.0) or 0.0
 87:     # 找到上一个反向信号（S→B 时找前一个 B；B→S 时找前一个 S）
 88:     prev_idx = None
 89:     for i in range(len(bs_signals) - 2, -1, -1):
 90:         if bs_signals[i].get('type') != last_type:
 91:             prev_idx = i
 92:             break
 93:     # 区间盈亏%（基于当前价 / S 价）
 94:     ref_price = current_price or last_price
 95:     if last_type == 'B':
 96:         # 当前持仓中：B 起点 → 今天（仍未卖出）
 97:         start_date = last_date
 98:         start_price = last_price
 99:         end_date = ''  # 未结束
100:         end_price = ref_price
101:         state = 'holding'
102:         if prev_idx is not None:
103:             # 上一个 S 之后才有这个 B —— B 起点 = 当前 B 信号日
104:             pass
105:         pnl_pct = ((ref_price - start_price) / start_price * 100) if start_price else 0.0
106:     elif last_type == 'S':
107:         # 已平仓：前一个 B → 当前 S
108:         state = 'empty'
109:         end_date = last_date
110:         end_price = last_price
111:         if prev_idx is not None:
112:             b_sig = bs_signals[prev_idx]
113:             start_date = b_sig.get('date', '')
114:             start_price = b_sig.get('price', 0.0) or 0.0
115:         else:
116:             start_date = ''
117:             start_price = 0.0
118:         pnl_pct = ((end_price - start_price) / start_price * 100) if start_price else 0.0
119:     else:
120:         return {'state': 'unknown'}
121:     # 持有天数
122:     hold_days = 0
123:     if start_date:
124:         try:
125:             from datetime import datetime
126:             sd = datetime.strptime(str(start_date)[:10].replace('-', ''), '%Y%m%d')
127:             ed_str = str(end_date)[:10].replace('-', '') if end_date else datetime.now().strftime('%Y%m%d')
128:             ed = datetime.strptime(ed_str, '%Y%m%d')
129:             hold_days = max(0, (ed - sd).days)
130:         except Exception:
131:             hold_days = 0
132:     return {
133:         'state': state,
134:         'start_date': str(start_date)[:10] if start_date else '',
135:         'start_price': round(start_price, 3) if start_price else 0.0,
136:         'end_date': str(end_date)[:10] if end_date else '',
137:         'end_price': round(end_price, 3) if end_price else 0.0,
138:         'hold_days': hold_days,
139:         'pnl_pct': round(pnl_pct, 2),
140:     }
