  1: """US Quant System — 风险否决与仓位管理"""
  2: from __future__ import annotations
  3: from typing import Optional
  4: from .contracts import PositionSizingResult, RiskCheckResult
  5: # ─── 风险否决 ─────────────────────────────────────────────────────────────────
  6: def check_risk_veto(
  7:     data_stale: bool = False,
  8:     broker_disconnected: bool = False,
  9:     position_reconciliation_failed: bool = False,
 10:     spread_abnormal: bool = False,
 11:     stop_distance_too_large: bool = False,
 12:     expected_rr_below_min: bool = False,
 13:     daily_loss_limit_reached: bool = False,
 14:     weekly_loss_limit_reached: bool = False,
 15:     sector_risk_high: bool = False,
 16:     correlated_positions_exceeded: bool = False,
 17:     market_risk_off: bool = False,
 18:     stock_suspended: bool = False,
 19:     duplicate_order: bool = False,
 20:     unknown_earnings_risk: bool = False,
 21:     data_delayed: bool = False,
 22: ) -> RiskCheckResult:
 23:     """执行风险否决检查
 24:     任一项触发则禁止开仓。
 25:     """
 26:     veto_reasons = []
 27:     if data_stale:
 28:         veto_reasons.append("行情数据过期")
 29:     if data_delayed:
 30:         veto_reasons.append("数据延迟")
 31:     if broker_disconnected:
 32:         veto_reasons.append("券商断线")
 33:     if position_reconciliation_failed:
 34:         veto_reasons.append("持仓核对失败")
 35:     if spread_abnormal:
 36:         veto_reasons.append("价差异常")
 37:     if stop_distance_too_large:
 38:         veto_reasons.append("止损距离过大")
 39:     if expected_rr_below_min:
 40:         veto_reasons.append("盈亏比不足")
 41:     if daily_loss_limit_reached:
 42:         veto_reasons.append("达到日亏损上限")
 43:     if weekly_loss_limit_reached:
 44:         veto_reasons.append("达到周亏损上限")
 45:     if sector_risk_high:
 46:         veto_reasons.append("行业风险过高")
 47:     if correlated_positions_exceeded:
 48:         veto_reasons.append("相关仓位过多")
 49:     if market_risk_off:
 50:         veto_reasons.append("市场 RISK_OFF")
 51:     if stock_suspended:
 52:         veto_reasons.append("股票停牌")
 53:     if duplicate_order:
 54:         veto_reasons.append("重复订单")
 55:     if unknown_earnings_risk:
 56:         veto_reasons.append("未知财报风险")
 57:     risk_score = min(100, len(veto_reasons) * 20)
 58:     passed = len(veto_reasons) == 0
 59:     return RiskCheckResult(passed=passed, veto_reasons=veto_reasons, risk_score=risk_score)
 60: # ─── 仓位管理 ─────────────────────────────────────────────────────────────────
 61: def calculate_position_size(
 62:     account_equity: float = 100_000.0,
 63:     entry_price: float = 0.0,
 64:     stop_price: float = 0.0,
 65:     target_prices: Optional[list[float]] = None,
 66:     risk_per_trade: float = 0.005,         # 单笔风险 0.5%
 67:     max_position_pct: float = 0.10,        # 单股最高仓位 10%
 68:     max_open_positions: int = 6,
 69:     current_positions: int = 0,
 70:     current_sector_exposure: float = 0.0,  # 当前行业仓位占比
 71:     max_sector_exposure: float = 0.30,     # 行业最高仓位 30%
 72:     min_trade_unit: int = 1,
 73: ) -> PositionSizingResult:
 74:     """计算仓位"""
 75:     if entry_price <= 0 or stop_price <= 0:
 76:         return PositionSizingResult(reason="无效的入场价或止损价")
 77:     risk_per_share = abs(entry_price - stop_price)
 78:     if risk_per_share <= 0:
 79:         return PositionSizingResult(reason="止损价与入场价相同")
 80:     # 允许亏损金额
 81:     allowed_loss = account_equity * risk_per_trade
 82:     # 理论股数
 83:     theoretical_shares = int(allowed_loss / risk_per_share)
 84:     # 单股仓位上限
 85:     max_shares_by_position = int(account_equity * max_position_pct / entry_price)
 86:     # 行业风险上限
 87:     remaining_sector_capacity = max_sector_exposure - current_sector_exposure
 88:     max_shares_by_sector = int(account_equity * remaining_sector_capacity / entry_price) if remaining_sector_capacity > 0 else 0
 89:     # 最终股数
 90:     final_shares = min(theoretical_shares, max_shares_by_position, max_shares_by_sector)
 91:     if max_shares_by_sector <= 0:
 92:         final_shares = 0
 93:     # 取整到最小交易单位
 94:     final_shares = (final_shares // min_trade_unit) * min_trade_unit
 95:     position_pct = (final_shares * entry_price) / account_equity if account_equity > 0 else 0
 96:     risk_amount = final_shares * risk_per_share
 97:     target_prices = target_prices or []
 98:     reason_parts = []
 99:     if final_shares == theoretical_shares:
100:         reason_parts.append("标准仓位")
101:     elif final_shares == max_shares_by_position:
102:         reason_parts.append("受单股仓位上限限制")
103:     elif final_shares == max_shares_by_sector:
104:         reason_parts.append("受行业风险上限限制")
105:     else:
106:         reason_parts.append("调整仓位")
107:     return PositionSizingResult(
108:         allowed_quantity=final_shares,
109:         position_pct=round(position_pct * 100, 2),
110:         risk_amount=round(risk_amount, 2),
111:         stop_price=stop_price,
112:         target_prices=target_prices,
113:         reason=", ".join(reason_parts),
114:     )
115: # ─── 止损止盈 ─────────────────────────────────────────────────────────────────
116: def calculate_stop_loss(
117:     entry_price: float,
118:     support_level: Optional[float] = None,
119:     platform_low: Optional[float] = None,
120:     ema20: Optional[float] = None,
121:     atr_value: Optional[float] = None,
122:     atr_multiple: float = 1.5,
123:     use_atr: bool = False,
124: ) -> float:
125:     """计算止损价
126:     优先级：形态失效位 > 平台下沿 > EMA20 > ATR
127:     """
128:     if support_level and support_level < entry_price:
129:         return round(support_level, 2)
130:     if platform_low and platform_low < entry_price:
131:         return round(platform_low, 2)
132:     if ema20 and ema20 < entry_price:
133:         return round(ema20, 2)
134:     if use_atr and atr_value and atr_value > 0:
135:         return round(entry_price - atr_value * atr_multiple, 2)
136:     return round(entry_price * 0.95, 2)  # 默认 5% 止损
137: def calculate_take_profit(
138:     entry_price: float,
139:     stop_price: float,
140:     r_multiple: float = 2.0,
141:     partial_at_1r: float = 0.30,
142:     partial_at_2r: float = 0.30,
143: ) -> list[float]:
144:     """计算止盈价
145:     1R：卖出30%
146:     2R：再卖30%
147:     剩余40%：跟踪
148:     """
149:     risk_r = entry_price - stop_price
150:     if risk_r <= 0:
151:         return [round(entry_price * 1.05, 2), round(entry_price * 1.10, 2)]
152:     tp1 = entry_price + risk_r * 1.0
153:     tp2 = entry_price + risk_r * r_multiple
154:     return [round(tp1, 2), round(tp2, 2)]
</file>

