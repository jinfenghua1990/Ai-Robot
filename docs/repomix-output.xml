  1: """妙想云端自选股同步（推送用）"""
  2: import time
  3: import logging
  4: from fastapi import HTTPException
  5: from config import MX_APIKEY, MX_API_URL
  6: from api.watchlist._shared import _get_http_client
  7: logger = logging.getLogger(__name__)
  8: async def _mx_post(endpoint: str, payload: dict, timeout: float = 30.0) -> dict:
  9:     """调用妙想 API（自然语言处理较慢，默认 30 秒超时）"""
 10:     if not MX_APIKEY:
 11:         raise HTTPException(status_code=500, detail="MX_APIKEY未配置")
 12:     url = f"{MX_API_URL}{endpoint}"
 13:     client = _get_http_client()
 14:     # 共享 client 默认超时 10s 不够，妙想自然语言处理需 15-30s，这里用独立 timeout 覆盖
 15:     resp = await client.post(url, json=payload, headers={
 16:         "apikey": MX_APIKEY,
 17:         "Content-Type": "application/json; charset=UTF-8",
 18:     }, timeout=timeout)
 19:     return resp.json()
 20: async def mx_push_stock(stock_name: str) -> dict:
 21:     """添加股票到妙想云端自选股（自然语言）"""
 22:     return await _mx_post("/api/claw/self-select/manage", {"query": f"把{stock_name}加入自选"})
 23: async def mx_delete_stock(stock_name: str) -> dict:
 24:     """从妙想云端自选股删除（自然语言）"""
 25:     return await _mx_post("/api/claw/self-select/manage", {"query": f"把{stock_name}从我的自选股列表删除"})
 26: def _norm_code(code: str) -> str:
 27:     """归一化为 6 位纯代码：去掉 .SH/.SZ/.BJ 等交易所后缀。"""
 28:     if not code:
 29:         return code
 30:     c = code.strip().upper()
 31:     if '.' in c:
 32:         c = c.split('.')[0]
 33:     return c
 34: async def sync_to_mx(dry_run: bool = False, mirror: bool = False) -> dict:
 35:     """把 AIROBOT 自选股推送到妙想云端"""
 36:     from db.session import get_db_session
 37:     from db.models import Watchlist
 38:     from api.mx_skills import _parse_zixuan_list
 39:     raw = await _mx_post("/api/claw/self-select/get", {})
 40:     if isinstance(raw, dict) and raw.get('status') == 112:
 41:         return {
 42:             "success": False, "error": "妙想API限流，请稍后再试",
 43:             "local_count": None, "mx_count": None,
 44:             "pushed": 0, "pushed_list": [], "failed": [],
 45:         }
 46:     mx_list = _parse_zixuan_list(raw)
 47:     mx_codes = {_norm_code(s["stock_code"]) for s in mx_list if s.get("stock_code")}
 48:     mx_name = {_norm_code(s["stock_code"]): s.get("stock_name", "") for s in mx_list if s.get("stock_code")}
 49:     with get_db_session() as db:
 50:         local_items = db.query(Watchlist).all()
 51:         # 归一化本地代码并建立 归一码 -> 原始记录 映射（去重）
 52:         local_norm: dict = {}
 53:         for it in local_items:
 54:             nc = _norm_code(it.stock_code)
 55:             if nc:
 56:                 local_norm.setdefault(nc, it)
 57:         local_codes = set(local_norm.keys())
 58:         to_push = local_codes - mx_codes
 59:         to_delete = mx_codes - local_codes if mirror else set()
 60:         if dry_run:
 61:             return {
 62:                 "local_count": len(local_codes),
 63:                 "mx_count": len(mx_codes),
 64:                 "to_push": len(to_push),
 65:                 "to_push_list": sorted(to_push),
 66:                 "to_delete": len(to_delete),
 67:                 "to_delete_list": sorted(to_delete),
 68:                 "mirror": mirror,
 69:                 "dry_run": True,
 70:             }
 71:         code_name = {nc: (it.stock_name or nc) for nc, it in local_norm.items()}
 72:         pushed = []
 73:         failed = []
 74:         for code in to_push:
 75:             if not (len(code) == 6 and code.isdigit()):
 76:                 failed.append({"code": code, "error": "非A股代码跳过"})
 77:                 continue
 78:             name = code_name.get(code, code)
 79:             try:
 80:                 result = await mx_push_stock(name or code)
 81:                 if isinstance(result, dict) and result.get('status') == 112:
 82:                     failed.append({"code": code, "error": "妙想限流，稍后重试"})
 83:                     time.sleep(2)  # 限流时多等
 84:                     continue
 85:                 pushed.append(code)
 86:                 time.sleep(0.2)  # 正常 0.2s 间隔（之前 1.0s 导致 160 只推送需 200 秒超时）
 87:             except Exception as e:
 88:                 failed.append({"code": code, "error": str(e)})
 89:                 time.sleep(0.2)
 90:         deleted = []
 91:         for code in to_delete:
 92:             if not (len(code) == 6 and code.isdigit()):
 93:                 continue
 94:             name = mx_name.get(code, code)
 95:             try:
 96:                 result = await mx_delete_stock(name or code)
 97:                 if isinstance(result, dict) and result.get('status') == 112:
 98:                     failed.append({"code": code, "error": "妙想限流，稍后重试"})
 99:                     time.sleep(2)
100:                     continue
101:                 deleted.append(code)
102:                 time.sleep(0.2)
103:             except Exception as e:
104:                 failed.append({"code": code, "error": str(e)})
105:                 time.sleep(0.2)
106:         return {
107:             "success": True,
108:             "local_count": len(local_codes),
109:             "mx_count": len(mx_codes),
110:             "pushed": len(pushed),
111:             "pushed_list": pushed,
112:             "deleted": len(deleted),
113:             "deleted_list": deleted,
114:             "mirror": mirror,
115:             "failed": failed,
116:         }
117: async def sync_from_mx(dry_run: bool = False, mirror: bool = False) -> dict:
118:     """从妙想拉取自选股到 AIROBOT"""
119:     from db.session import get_db_session
120:     from db.models import Watchlist
121:     from api.mx_skills import _parse_zixuan_list
122:     raw = await _mx_post("/api/claw/self-select/get", {})
123:     if isinstance(raw, dict) and raw.get('status') == 112:
124:         return {"success": False, "error": "妙想API限流，请稍后再试",
125:                 "mx_count": None, "added": 0, "skipped": 0, "deleted": 0}
126:     mx_list = _parse_zixuan_list(raw)
127:     mx_codes = {s["stock_code"] for s in mx_list if s.get("stock_code")}
128:     code_name = {s["stock_code"]: s.get("stock_name", "") for s in mx_list}
129:     with get_db_session() as db:
130:         local_all = db.query(Watchlist).all()
131:         local_codes = {item.stock_code for item in local_all}
132:         to_add = {c for c in (mx_codes - local_codes) if len(c) == 6 and c.isdigit()}
133:         to_delete = local_codes - mx_codes if mirror else set()
134:         if dry_run:
135:             return {"mx_count": len(mx_codes), "local_count": len(local_codes),
136:                     "to_add": len(to_add), "to_add_list": sorted(to_add),
137:                     "to_delete": len(to_delete), "to_delete_list": sorted(to_delete),
138:                     "mirror": mirror, "dry_run": True}
139:         added = []
140:         for code in to_add:
141:             item = Watchlist(stock_code=code, stock_name=code_name.get(code, ""),
142:                              note="妙想同步", group_name="妙想同步")
143:             db.add(item)
144:             added.append(code)
145:         deleted = []
146:         if to_delete:
147:             db.query(Watchlist).filter(
148:                 Watchlist.stock_code.in_(to_delete)
149:             ).delete(synchronize_session=False)
150:             deleted = sorted(to_delete)
151:         db.commit()
152:         from api.watchlist import _watchlist_cache
153:         _watchlist_cache["data"] = None
154:         return {"success": True, "mx_count": len(mx_codes), "local_count": len(local_codes),
155:                 "added": len(added), "added_list": added, "skipped": len(mx_codes & local_codes),
156:                 "deleted": len(deleted), "deleted_list": deleted, "mirror": mirror}
