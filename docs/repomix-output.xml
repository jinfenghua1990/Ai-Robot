 75:             "retail_net": _f(data.get("f140")),
 76:             "turnover": _f(data.get("f86")),
 77:         }
 78:     except Exception as e:
 79:         logger.warning(f"[emdatah5] fetch {code} failed: {e}")
 80:         return None
 81: def save_realtime_snapshot(code: str) -> bool:
 82:     """获取并保存某只股票的实时资金流快照
 83:     每次调用INSERT一条新记录 → 数据在数据库中持续沉淀积累。
 84:     可通过 (ts_code, trade_date, snapshot_time) 查询历史分钟级走势。
 85:     """
 86:     flow = fetch_realtime_fund_flow(code)
 87:     if not flow:
 88:         return False
 89:     now = datetime.now()
 90:     with get_db_session() as db:
 91:         db.execute(text("""
 92:             INSERT INTO stock_money_flow_realtime
 93:                 (trade_date, ts_code, name, snapshot_time,
 94:                  main_buy, main_sell, main_net,
 95:                  retail_buy, retail_sell, retail_net, turnover, source)
 96:             VALUES
 97:                 (:td, :ts, :nm, :now,
 98:                  :mb, :ms, :mn, :rb, :rs, :rn, :to, :src)
 99:         """), {
100:             "td": now.date(), "ts": flow["ts_code"], "nm": flow["name"],
101:             "now": now,
102:             "mb": flow["main_buy"], "ms": flow["main_sell"], "mn": flow["main_net"],
103:             "rb": flow["retail_buy"], "rs": flow["retail_sell"], "rn": flow["retail_net"],
104:             "to": flow["turnover"], "src": "emdatah5",
105:         })
106:         db.commit()
107:     return True
108: def batch_save_realtime(stock_codes: list, on_progress=None) -> dict:
109:     """批量获取并保存多只股票的快照。
110:     on_progress(done, total): 可选回调，每处理完一只调用一次，用于上报进度。
111:     """
112:     result = {"success": 0, "failed": 0, "total": len(stock_codes)}
113:     done = 0
114:     for code in stock_codes:
115:         if not code or len(code) != 6:
116:             result["failed"] += 1
117:             done += 1
118:             if on_progress:
119:                 on_progress(done, result["total"])
120:             continue
121:         ok = save_realtime_snapshot(code)
122:         if ok:
123:             result["success"] += 1
124:         else:
125:             result["failed"] += 1
126:         done += 1
127:         if on_progress:
128:             on_progress(done, result["total"])
129:     return result
130: # 东财全市场资金流排行榜接口（单次请求返回排序后的 N 只，极轻量）
131: MARKET_RANK_URL = "https://push2.eastmoney.com/api/qt/clist/get"
132: def fetch_market_capital_ranking(rank_type: str = "inflow", top_n: int = 100) -> dict:
133:     """全市场资金流排行（东财批量排行榜接口，1 次请求）。
134:     rank_type:
135:         'inflow'  = 主力净流入前 top_n（po=1 降序）
136:         'outflow' = 主力净流出前 top_n（po=0 升序，即净流入最小）
137:     返回: {updated_at, type, total_market, items:[{code,name,price,pct,main_net,main_net_pct}]}
138:     """
139:     fs = "m:0+t:6,m:0+t:80,m:1+t:2,m:1+t:23"  # 全部 A 股（沪A/深A/北交）
140:     fields = "f12,f14,f2,f3,f62,f184"
141:     # po=1 降序（净流入最大），po=0 升序（净流入最小=净流出最大）
142:     po = 0 if rank_type == "outflow" else 1
143:     params = {
144:         "fs": fs, "fields": fields, "fid": "f62",
145:         "po": po, "pz": top_n, "pn": 1, "np": 1,
146:     }
147:     try:
148:         # push2 子域需要 data.eastmoney.com 的 Referer，否则会被掐连接
149:         # 复用 EM_SESSION（已验证可稳定经代理访问东财），并加重试规避代理偶发抖动
150:         rank_headers = {
151:             "Referer": "https://data.eastmoney.com/stock/zjlx.html",
152:             "Accept": "*/*",
153:         }
154:         resp = None
155:         last_err = None
156:         for attempt in range(4):
157:             try:
158:                 resp = _em_get(MARKET_RANK_URL, params=params, timeout=15, headers=rank_headers)
159:                 resp.raise_for_status()
160:                 break
161:             except Exception as e:
162:                 last_err = e
163:                 time.sleep(0.8 + attempt * 0.6)
164:         if resp is None:
165:             raise last_err or RuntimeError("ranking request failed")
166:         data = resp.json().get("data") or {}
167:         diff = data.get("diff") or []
168:         # diff 可能是 dict({"0":{...}}) 也可能是 list([{...}])，两种都兼容
169:         seq = diff.values() if isinstance(diff, dict) else (diff if isinstance(diff, list) else [])
170:         items = []
171:         for v in seq:
172:             f2 = v.get("f2")
173:             f3 = v.get("f3")
174:             f62 = v.get("f62")
175:             f184 = v.get("f184")
176:             items.append({
177:                 "code": v.get("f12"),
178:                 "name": v.get("f14"),
179:                 # 原始值单位为 分 / 万分之一 / 元，这里转成可读数值
180:                 "price": round(f2 / 100, 2) if isinstance(f2, (int, float)) else None,
181:                 "pct": round(f3 / 100, 2) if isinstance(f3, (int, float)) else None,
182:                 "main_net": f62 if isinstance(f62, (int, float)) else None,
183:                 "main_net_pct": round(f184 / 100, 2) if isinstance(f184, (int, float)) else None,
184:             })
185:         return {
186:             "updated_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
187:             "type": rank_type,
188:             "total_market": data.get("total"),
189:             "items": items,
190:         }
191:     except Exception as e:
192:         logger.error(f"[emdatah5] 全市场资金流排行获取失败: {e}")
193:         return {"updated_at": None, "type": rank_type, "total_market": None, "items": [], "error": str(e)}
194: def is_trading_time() -> bool:
195:     """判断当前是否在交易时段 (09:30-15:00)"""
196:     now = datetime.now()
197:     if now.weekday() >= 5:  # 周末
198:         return False
199:     t = now.time()
200:     return dtime(9, 30) <= t <= dtime(15, 0)
