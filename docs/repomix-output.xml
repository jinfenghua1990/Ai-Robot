275: def run_liangjia_report_screen(stock_list, trade_date=None, max_workers=20, db=None):
276:     """批量执行量价报告选股（线程池并发）
277:     参数:
278:         stock_list: 股票代码列表
279:         trade_date: 交易日期 (YYYY-MM-DD)
280:         max_workers: 线程池大小
281:         db: 数据库会话（可选，用于查 StockFlow 主力资金历史）
282:     """
283:     # 预加载主力资金历史（近5个交易日）
284:     main_force_map = {}
285:     if db and trade_date:
286:         from db.models import StockFlow as SF
287:         from datetime import datetime, timedelta
288:         date_obj = datetime.strptime(trade_date, '%Y-%m-%d')
289:         check_dates = []
290:         for i in range(0, 15):
291:             d = (date_obj - timedelta(days=i)).strftime('%Y-%m-%d')
292:             check_dates.append(d)
293:         flows = db.query(SF).filter(
294:             SF.trade_date.in_(check_dates),
295:             SF.ts_code.in_(stock_list),
296:         ).all()
297:         sf_grouped = {}
298:         for f in flows:
299:             sf_grouped.setdefault(f.ts_code, []).append({
300:                 'date': str(f.trade_date),
301:                 'main_force': float(f.main_force_inflow or 0),
302:             })
303:         for ts_code, flist in sf_grouped.items():
304:             flist.sort(key=lambda x: x['date'], reverse=True)
305:             recent5 = flist[:5]
306:             if len(recent5) >= 3:
307:                 recent5.reverse()
308:                 main_force_map[ts_code] = [f['main_force'] for f in recent5]
309:     def _screen_one(ts_code):
310:         try:
311:             kline = get_kline_from_tdx(ts_code, 60)
312:             if kline and len(kline) >= 30:
313:                 mf_history = main_force_map.get(ts_code)
314:                 result = liangjia_report_strategy(kline, main_force_history=mf_history)
315:                 if result:
316:                     result['ts_code'] = ts_code
317:                     if trade_date:
318:                         result['trade_date'] = trade_date
319:                     return result
320:         except Exception:
321:             logger.debug(f'liangjia _screen_one failed {ts_code}', exc_info=True)
322:         return None
323:     results = []
324:     with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
325:         futures = {executor.submit(_screen_one, code): code for code in stock_list}
326:         for future in concurrent.futures.as_completed(futures, timeout=120):
327:             try:
328:                 result = future.result(timeout=10)
329:                 if result:
330:                     results.append(result)
331:             except Exception:
332:                 logger.debug('liangjia future failed', exc_info=True)
333:     return results
