132:   }, [lineMeta, trendData, selectedSector]);
133:   // 外部标签 items（ChartLabelLayer 用，强制不重叠）
134:   const labelItems = useMemo(() => lineMeta.map(s => {
135:     const isSelected = selectedSector && selectedSector === s.sector;
136:     const dimmed = selectedSector && !isSelected;
