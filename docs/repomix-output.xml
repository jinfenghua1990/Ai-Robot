191:                 bs_interval = _calc_bs_interval(bs_signals, quote.get('price') if quote else 0.0)
192:                 # 提取最新 KDJ/MACD/支撑/阻力（最后一根 K 线对应的值）
193:                 def _last(arr):
194:                     return arr[-1] if arr and arr[-1] is not None else None
195:                 indicators = {
196:                     'macd': round(_last(macd), 4) if _last(macd) is not None else None,
197:                     'dif': round(_last(dif), 4) if _last(dif) is not None else None,
198:                     'dea': round(_last(dea), 4) if _last(dea) is not None else None,
199:                     'kdj_k': round(_last(k_vals), 2) if _last(k_vals) is not None else None,
200:                     'kdj_d': round(_last(d_vals), 2) if _last(d_vals) is not None else None,
201:                     'kdj_j': round(_last(j_vals), 2) if _last(j_vals) is not None else None,
202:                     'ma5': round(_last(ma5), 2) if _last(ma5) is not None else None,
203:                     'ma20': round(_last(ma20), 2) if _last(ma20) is not None else None,
204:                     'support': round(_last(support), 2) if _last(support) is not None else None,
205:                     'resistance': round(_last(resistance), 2) if _last(resistance) is not None else None,
