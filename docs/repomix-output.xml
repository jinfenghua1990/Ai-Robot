 59:         if td and td not in local_dates:
 60:             merged[td] = item
 61:     # 转为统一格式，按日期升序排列
 62:     all_dates = sorted(merged.keys())
 63:     klines = []
 64:     for td in all_dates[-datalen:]:
 65:         r = merged[td]
 66:         if hasattr(r, 'trade_date'):  # ORM 对象
 67:             klines.append({
 68:                 'day': str(r.trade_date), 'open': float(r.open or 0), 'close': float(r.close or 0),
 69:                 'high': float(r.high or 0), 'low': float(r.low or 0), 'volume': int(r.volume or 0),
 70:             })
 71:         else:  # Tushare dict
