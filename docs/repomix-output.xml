182:     indicators = {}
183:     try:
184:         if klines and len(klines) > 0:
185:             # _generate_bs_signals 返回 12 个值：signals, dif, dea, macd, ma5, ma20, k, d, j, support, resistance, trend
186:             bs_signals, dif, dea, macd, ma5, ma20, k_vals, d_vals, j_vals, support, resistance, _trend = _generate_bs_signals(klines)
187:             if bs_signals:
