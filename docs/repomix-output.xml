<file path="frontend/src/hooks/useWatchlistRealtimeStream.js">
  1: /**
  2:  * 订阅 watchlist 实时推送 (SSE)
  3:  *
  4:  * 数据源：GET /api/watchlist/realtime/stream
  5:  * 数据格式：{server_time, count, data: {ts_code: {current_price, pct_chg, main_force_inflow, ...}}}
  6:  *
  7:  * 转换逻辑：
  8:  * 1. 复用 SSE 连接，避免每只股票单独请求
  9:  * 2. 将 REALTIME_STATE 格式（current_price/pct_chg）映射为 SignalCard 期望的实时字段（price/price_chg）
 10:  * 3. 暴露 realtimeMap: secCode -> {price, price_chg, main_force_inflow, ...}
 11:  *
 12:  * 设计权衡：
 13:  * - EventSource 自动重连，但服务端每 5s 推送一帧，前端不要做额外节流
 14:  * - 组件卸载时调用 es.close() 释放连接
 15:  * - 非交易时段返回空 data 帧，连接保持
 16:  */
 17: import { useEffect, useState, useRef, useCallback } from 'react';
 18: import { stripCode } from '../utils/format';
 19: const STREAM_URL = '/api/watchlist/realtime/stream';
 20: const POLL_FALLBACK_URL = '/api/watchlist/realtime/snapshot';
 21: const FALLBACK_POLL_INTERVAL = 15000;  // 15s 兜底轮询（非交易时段或 SSE 失败时）
 22: function mapRealtimePayload(payload) {
 23:   if (!payload?.data) return { serverTime: payload?.server_time, byCode: {} };
 24:   const byCode = {};
 25:   for (const [tsCode, item] of Object.entries(payload.data)) {
 26:     const code = stripCode(tsCode);
 27:     if (!code) continue;
 28:     const mainForce = item.main_force_inflow ?? 0;
 29:     byCode[code] = {
 30:       price: item.current_price ?? 0,
 31:       price_chg: item.pct_chg ?? 0,
 32:       main_force_inflow: mainForce,
 33:       // 实时数据源仅提供主力净流入，总净流入不存在；散户净流按日内资金平衡估算
 34:       net_inflow: null,
 35:       retail_flow: -mainForce,
 36:       latest_time: item.snapshot_time,
 37:       source: item.source,
 38:       turnover_rate: item.turnover_rate,
 39:       large_buy_count_3s: item.large_buy_count_3s,
 40:       large_sell_count_3s: item.large_sell_count_3s,
 41:       large_order_active_ratio: item.large_order_active_ratio,
 42:       thousand_count_1m: item.thousand_order_count_per_min,
 43:       support_level: item.support_level_eval,
 44:       bid_price_1: item.bid_price_1,
 45:       bid_vol_1: item.bid_vol_1,
 46:       ask_price_1: item.ask_price_1,
 47:       ask_vol_1: item.ask_vol_1,
 48:       is_stale: item.snapshot_time ? (Date.now() - new Date(item.snapshot_time).getTime() > 300000) : true,
 49:     };
 50:   }
 51:   return { serverTime: payload.server_time, byCode };
 52: }
 53: /**
 54:  * 字段级对比：仅当任一字段不同时才返回新对象，否则返回原对象引用。
 55:  * 避免服务端推送完全相同的快照时仍新建引用，触发下游组件无谓重渲染。
 56:  */
 57: function mergeIfChanged(prev, next) {
 58:   if (!prev) return next;
 59:   let changed = false;
 60:   for (const k of Object.keys(next)) {
 61:     if (prev[k] !== next[k]) { changed = true; break; }
 62:   }
 63:   // 同时清理 prev 中存在但 next 已删除的字段（理论不会发生，但防御）
 64:   return changed ? { ...prev, ...next } : prev;
 65: }
 66: /**
 67:  * 主 hook：SSE + 兜底轮询
 68:  * - 优先用 SSE（5s 推送）
 69:  * - SSE 出错或不支持时降级到 15s 轮询
 70:  */
 71: export function useWatchlistRealtimeStream() {
 72:   const [realtimeMap, setRealtimeMap] = useState({});
 73:   const [serverTime, setServerTime] = useState(null);
 74:   const [streamStatus, setStreamStatus] = useState('connecting');  // connecting | open | fallback | closed
 75:   const esRef = useRef(null);
 76:   const pollTimerRef = useRef(null);
 77:   const applyPayload = useCallback((payload) => {
 78:     const { serverTime, byCode } = mapRealtimePayload(payload);
 79:     setServerTime(serverTime);
 80:     if (Object.keys(byCode).length > 0) {
 81:       // 字段级合并：仅对实际变化的 code 替换引用，避免 164 张卡全量重渲染
 82:       setRealtimeMap((prev) => {
 83:         let next = prev;
 84:         let dirty = false;
 85:         for (const [code, item] of Object.entries(byCode)) {
 86:           const merged = mergeIfChanged(prev[code], item);
 87:           if (merged !== prev[code]) {
 88:             if (!dirty) { next = { ...prev }; dirty = true; }
 89:             next[code] = merged;
 90:           }
 91:         }
 92:         return dirty ? next : prev;
 93:       });
 94:     }
 95:   }, []);
 96:   const startPollingFallback = useCallback(() => {
 97:     if (pollTimerRef.current) return;
 98:     setStreamStatus('fallback');
 99:     const tick = async () => {
100:       try {
101:         const res = await fetch(POLL_FALLBACK_URL);
102:         if (res.ok) applyPayload(await res.json());
103:       } catch { /* silent */ }
104:     };
105:     tick();
106:     pollTimerRef.current = setInterval(tick, FALLBACK_POLL_INTERVAL);
107:   }, [applyPayload]);
108:   useEffect(() => {
109:     if (typeof window === 'undefined' || typeof EventSource === 'undefined') {
110:       startPollingFallback();
111:       return;
112:     }
113:     let cancelled = false;
114:     let reconnectTimer = null;
115:     const connect = () => {
116:       if (cancelled) return;
117:       try {
118:         const es = new EventSource(STREAM_URL);
119:         esRef.current = es;
120:         es.onopen = () => {
121:           if (cancelled) return;
122:           setStreamStatus('open');
123:           if (pollTimerRef.current) {
124:             clearInterval(pollTimerRef.current);
125:             pollTimerRef.current = null;
126:           }
127:         };
128:         es.onmessage = (evt) => {
129:           if (cancelled) return;
130:           try {
131:             applyPayload(JSON.parse(evt.data));
132:           } catch { /* ignore parse error */ }
133:         };
134:         es.onerror = () => {
135:           if (cancelled) return;
136:           // 仅在自己仍是当前 ES 时清空 ref，避免旧 ES 的延迟 onerror 把新 ES 的引用清掉
137:           // 导致新 ES 无法被 cleanup 关闭，连接泄漏
138:           es.close();
139:           if (esRef.current === es) esRef.current = null;
140:           setStreamStatus('fallback');
141:           if (!pollTimerRef.current) startPollingFallback();
142:           // 30s 后重试 SSE（先清旧定时器避免 onerror 短时多次触发导致连接堆叠）
143:           if (reconnectTimer) clearTimeout(reconnectTimer);
144:           reconnectTimer = setTimeout(() => { if (!cancelled) connect(); }, 30000);
145:         };
146:       } catch {
147:         startPollingFallback();
148:       }
149:     };
150:     connect();
151:     return () => {
152:       cancelled = true;
153:       if (reconnectTimer) clearTimeout(reconnectTimer);
154:       if (esRef.current) { esRef.current.close(); esRef.current = null; }
155:       if (pollTimerRef.current) { clearInterval(pollTimerRef.current); pollTimerRef.current = null; }
156:       // 不再 setStreamStatus('closed')：组件已卸载，setState 无意义且可能触发 React 警告
157:     };
158:   }, [applyPayload, startPollingFallback]);
159:   return { realtimeMap, serverTime, streamStatus };
160: }
</file>

