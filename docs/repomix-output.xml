  1: """
  2: 根据 concept_sectors 成分股和 stock_flow 表，计算概念板块日度资金流向。
  3: """
  4: import os
  5: import sys
  6: from datetime import datetime, date
  7: from collections import defaultdict
  8: sys.path.insert(0, os.path.join(os.path.dirname(__file__), '..'))
  9: from db.connection import get_db, engine, Base
 10: from db.session import get_db_session
 11: from db.models import ConceptSector, ConceptSectorFlow, StockFlow
 12: from sqlalchemy import func
 13: def _resolve_trade_date(db, target_date):
 14:     """若 target_date 无数据，向前查找最近交易日"""
 15:     latest = db.query(func.max(StockFlow.trade_date)).filter(
 16:         StockFlow.trade_date <= target_date
 17:     ).scalar()
 18:     return latest
 19: def compute_for_date(target_date=None):
 20:     with get_db_session() as db:
 21:         Base.metadata.create_all(bind=engine, tables=[ConceptSectorFlow.__table__])
 22:         if target_date is None:
 23:             target_date = date.today()
 24:         elif isinstance(target_date, str):
 25:             target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
 26:         trade_date = _resolve_trade_date(db, target_date)
 27:         if not trade_date:
 28:             print(f'[compute_concept_sector_flow] no stock_flow data for {target_date}')
 29:             return
 30:         concepts = db.query(ConceptSector).all()
 31:         if not concepts:
 32:             print('[compute_concept_sector_flow] no concept sectors found')
 33:             return
 34:         # 获取所有相关股票的 stock_flow 数据
 35:         all_codes = set()
 36:         concept_map = {}
 37:         for c in concepts:
 38:             codes = [s.strip() for s in (c.stocks or '').split(',') if s.strip()]
 39:             concept_map[c.id] = {'id': c.id, 'name': c.name, 'codes': codes}
 40:             all_codes.update(codes)
 41:         stocks = db.query(StockFlow).filter(
 42:             StockFlow.trade_date == trade_date,
 43:             StockFlow.ts_code.in_(all_codes)
 44:         ).all()
 45:         # 按 ts_code 聚合（同一股票不应重复，但保险起见取第一条）
 46:         stock_data = {}
 47:         for s in stocks:
 48:             if s.ts_code not in stock_data:
 49:                 stock_data[s.ts_code] = s
 50:         # 计算每个概念板块
 51:         for c in concept_map.values():
 52:             money_inflow = 0.0
 53:             money_outflow = 0.0
 54:             net_flow = 0.0
 55:             total_chg = 0.0
 56:             count = 0
 57:             limit_up = 0
 58:             valid_stocks = []
 59:             for code in c['codes']:
 60:                 s = stock_data.get(code)
 61:                 if not s:
 62:                     continue
 63:                 mi = float(s.net_inflow or 0) if s.net_inflow is not None else 0.0
 64:                 # stock_flow 只有 net_inflow，没有单独的流入流出；用 net_inflow 近似
 65:                 # 这里用 net_inflow 作为净流入，流入流出需要额外计算，暂用 net_inflow 正负拆分
 66:                 money_inflow += max(mi, 0)
 67:                 money_outflow += max(-mi, 0)
 68:                 net_flow += mi
 69:                 chg = float(s.price_chg or 0)
 70:                 total_chg += chg
 71:                 count += 1
 72:                 if chg >= 9.5:
 73:                     limit_up += 1
 74:                 valid_stocks.append(chg)
 75:             if count == 0:
 76:                 # 即使没有成分股数据，也写入0值记录，保证板块覆盖与实时一致
 77:                 existing = db.query(ConceptSectorFlow).filter_by(
 78:                     trade_date=trade_date, concept_sector_id=c['id']
 79:                 ).first()
 80:                 if existing:
 81:                     existing.money_inflow = 0
 82:                     existing.money_outflow = 0
 83:                     existing.net_flow = 0
 84:                     existing.rise_ratio = 0
 85:                     existing.avg_chg = 0
 86:                     existing.limit_up_count = 0
 87:                     existing.heat_score = 0
 88:                 else:
 89:                     db.add(ConceptSectorFlow(
 90:                         trade_date=trade_date,
 91:                         concept_sector_id=c['id'],
 92:                         concept_name=c['name'],
 93:                         money_inflow=0,
 94:                         money_outflow=0,
 95:                         net_flow=0,
 96:                         rise_ratio=0,
 97:                         avg_chg=0,
 98:                         limit_up_count=0,
 99:                         heat_score=0,
100:                     ))
101:                 continue
102:             avg_chg = total_chg / count
103:             rise_ratio = avg_chg
104:             # 热度分：综合涨幅、涨停数、净流入（简化版）
105:             heat_score = min(100, max(0, 50 + rise_ratio * 2 + limit_up * 3 + (net_flow / 100000)))
106:             existing = db.query(ConceptSectorFlow).filter_by(
107:                 trade_date=trade_date, concept_sector_id=c['id']
108:             ).first()
109:             if existing:
110:                 existing.money_inflow = money_inflow
111:                 existing.money_outflow = money_outflow
112:                 existing.net_flow = net_flow
113:                 existing.rise_ratio = rise_ratio
114:                 existing.avg_chg = avg_chg
115:                 existing.limit_up_count = limit_up
116:                 existing.heat_score = heat_score
117:             else:
118:                 db.add(ConceptSectorFlow(
119:                     trade_date=trade_date,
120:                     concept_sector_id=c['id'],
121:                     concept_name=c['name'],
122:                     money_inflow=money_inflow,
123:                     money_outflow=money_outflow,
124:                     net_flow=net_flow,
125:                     rise_ratio=rise_ratio,
126:                     avg_chg=avg_chg,
127:                     limit_up_count=limit_up,
128:                     heat_score=heat_score,
129:                 ))
130:         db.commit()
131:         print(f'[compute_concept_sector_flow] computed {len(concept_map)} concepts for {trade_date}')
132: if __name__ == '__main__':
133:     import argparse
134:     parser = argparse.ArgumentParser()
135:     parser.add_argument('--date', default=None, help='YYYY-MM-DD，默认今天')
136:     args = parser.parse_args()
137:     compute_for_date(args.date)
