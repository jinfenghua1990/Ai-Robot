 1: """GET /api/bs-screener/run  实时扫描"""
 2: import time
 3: from fastapi import APIRouter, Query
 4: from db.connection import get_db
 5: from db.session import get_db_session
 6: from .core import _scan_cache, _execute_bs_scan_core
 7: router = APIRouter()
 8: @router.get("/api/bs-screener/run")
 9: async def run_bs_screener(
10:     atr_period: int = Query(10, description="ATR周期"),
11:     atr_multiplier: float = Query(1.0, description="ATR乘数"),
12:     scan_limit: int = Query(50, description="扫描股票数量"),
13:     sector: str = Query('', description="板块筛选(逗号分隔)"),
14:     signal_type: str = Query('B', description="信号类型: B/S/ALL"),
15:     volume_filter: bool = Query(False),
16:     ma20_filter: bool = Query(False),
17:     ma60_trend: bool = Query(False),
18:     rsi_filter: bool = Query(False),
19:     strong_volume: bool = Query(False),
20:     macd_filter: bool = Query(False),
21:     kdj_filter: bool = Query(False),
22:     rsi_lower: int = Query(30),
23:     rsi_upper: int = Query(70),
24:     dimension: str = Query('', description="维度筛选: star=科创板 chinext=创业板 all=全A股"),
25: ):
26:     """运行 BS 选股扫描"""
27:     params_key = f"{atr_period}_{atr_multiplier}_{scan_limit}_{sector}_{signal_type}_{volume_filter}_{ma20_filter}_{ma60_trend}_{rsi_filter}_{strong_volume}_{dimension}"
28:     if _scan_cache['data'] and time.time() - _scan_cache['ts'] < 30 and _scan_cache['params_key'] == params_key:
29:         return _scan_cache['data']
30:     with get_db_session() as db:
31:         result = await _execute_bs_scan_core(
32:             db,
33:             atr_period=atr_period, atr_multiplier=atr_multiplier, scan_limit=scan_limit,
34:             sector=sector, signal_type=signal_type,
35:             volume_filter=volume_filter, ma20_filter=ma20_filter, ma60_trend=ma60_trend,
36:             rsi_filter=rsi_filter, strong_volume=strong_volume,
37:             macd_filter=macd_filter, kdj_filter=kdj_filter,
38:             rsi_lower=rsi_lower, rsi_upper=rsi_upper, dimension=dimension,
39:         )
40:         _scan_cache['data'] = result
41:         _scan_cache['ts'] = time.time()
42:         _scan_cache['params_key'] = params_key
