<file path="backend/api/sync_pkg/dispatcher.py">
  1: """本地变化 → 云端同步的事件防抖触发器
  2: - trigger_cloud_sync(): 本地新增后防抖 3 秒推送到所有云端
  3: - trigger_cloud_delete(): 本地删除后防抖 3 秒从所有云端删除
  4: - full_sync(): 单向推送（本地→云端，不再从云端拉取）
  5: """
  6: import asyncio
  7: import logging
  8: from datetime import datetime
  9: from .ths import ths_delete_stock, sync_to_ths, sync_from_ths
 10: from .mx import mx_delete_stock, sync_to_mx, sync_from_mx
 11: logger = logging.getLogger(__name__)
 12: # 本地 JSON 为唯一真相源，禁用云端 pull
 13: CLOUD_PULL_DISABLED = True
 14: _debounce_task = None
 15: _delete_queue = []
 16: _delete_debounce_task = None
 17: DEBOUNCE_SECONDS = 3
 18: async def _push_to_all(reason: str = "change") -> dict:
 19:     """推送到所有已连接平台（best-effort，失败记日志不抛）"""
 20:     results = {}
 21:     try:
 22:         results["push_ths"] = await sync_to_ths(mirror=False)
 23:     except Exception as e:
 24:         results["push_ths"] = {"error": str(e)}
 25:     try:
 26:         results["push_mx"] = await sync_to_mx(mirror=False)
 27:     except Exception as e:
 28:         results["push_mx"] = {"error": str(e)}
 29:     results["reason"] = reason
 30:     results["timestamp"] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
 31:     return results
 32: async def _debounced_push(reason: str):
 33:     try:
 34:         await asyncio.sleep(DEBOUNCE_SECONDS)
 35:     except asyncio.CancelledError:
 36:         return
 37:     try:
 38:         await _push_to_all(reason)
 39:     except Exception as e:
 40:         logger.warning(f"防抖推送异常: {e}")
 41: def trigger_cloud_sync(reason: str = "watchlist change"):
 42:     """本地自选股变化后调用：防抖 3 秒后推送到所有云端。"""
 43:     global _debounce_task
 44:     try:
 45:         loop = asyncio.get_event_loop()
 46:     except RuntimeError:
 47:         return
 48:     if _debounce_task and not _debounce_task.done():
 49:         _debounce_task.cancel()
 50:     _debounce_task = loop.create_task(_debounced_push(reason))
 51: async def _delete_from_all(code: str, name: str = "") -> dict:
 52:     """从所有云端删除指定股票（best-effort）"""
 53:     results = {}
 54:     try:
 55:         results["ths"] = await ths_delete_stock(code)
 56:     except Exception as e:
 57:         results["ths"] = {"error": str(e)}
 58:     try:
 59:         results["mx"] = await mx_delete_stock(name or code)
 60:     except Exception as e:
 61:         results["mx"] = {"error": str(e)}
 62:     return results
 63: async def _debounced_delete():
 64:     global _delete_queue
 65:     try:
 66:         await asyncio.sleep(DEBOUNCE_SECONDS)
 67:     except asyncio.CancelledError:
 68:         return
 69:     queue = _delete_queue[:]
 70:     _delete_queue = []
 71:     for code, name in queue:
 72:         try:
 73:             await _delete_from_all(code, name)
 74:         except Exception as e:
 75:             logger.warning(f"云端删除异常 {code}: {e}")
 76: def trigger_cloud_delete(code: str, name: str = ""):
 77:     """本地删除自选股后调用：防抖 3 秒后从所有云端删除该股票。"""
 78:     global _delete_debounce_task, _delete_queue
 79:     _delete_queue.append((code, name))
 80:     try:
 81:         loop = asyncio.get_event_loop()
 82:     except RuntimeError:
 83:         return
 84:     if _delete_debounce_task and not _delete_debounce_task.done():
 85:         _delete_debounce_task.cancel()
 86:     _delete_debounce_task = loop.create_task(_debounced_delete())
 87: async def full_sync(mirror_push: bool = False) -> dict:
 88:     """单向同步：本地→云端推送（不再从云端拉取）。默认增量模式 mirror_push=False（只加不删）"""
 89:     results = {}
 90:     if not CLOUD_PULL_DISABLED:
 91:         try:
 92:             results["pull_ths"] = await sync_from_ths()
 93:         except Exception as e:
 94:             results["pull_ths"] = {"error": str(e)}
 95:         try:
 96:             results["pull_mx"] = await sync_from_mx()
 97:         except Exception as e:
 98:             results["pull_mx"] = {"error": str(e)}
 99:     else:
100:         results["pull"] = "disabled (本地 JSON 为唯一真相源)"
101:     try:
102:         results["push_ths"] = await sync_to_ths(mirror=mirror_push)
103:     except Exception as e:
104:         results["push_ths"] = {"error": str(e)}
105:     try:
106:         results["push_mx"] = await sync_to_mx(mirror=mirror_push)
107:     except Exception as e:
108:         results["push_mx"] = {"error": str(e)}
109:     results["timestamp"] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
110:     return results
