 115:     if prev_k is not None and prev_d is not None and cur_k is not None and cur_d is not None:
 116:         if prev_k <= prev_d and cur_k > cur_d:
 117:             kdj_signal = '金叉'
 118:         elif prev_k >= prev_d and cur_k < cur_d:
