 1: from __future__ import annotations
 2: from typing import Mapping
 3: from .contracts import DimensionScore, ResonanceSnapshot
 4: class ResonanceEngine:
 5:     # 风险不是机会证据，不能因为风险分高就增加共振数量；它只负责否决。
 6:     OPPORTUNITY_DIMENSIONS = ("market", "sector", "strength", "trend", "volume_price", "position")
 7:     REQUIRED = OPPORTUNITY_DIMENSIONS + ("risk",)
 8:     def evaluate(self, dimensions: Mapping[str, DimensionScore]) -> ResonanceSnapshot:
 9:         valid = [
10:             name for name in self.OPPORTUNITY_DIMENSIONS
11:             if dimensions.get(name)
12:             and dimensions[name].valid
13:             and (dimensions[name].score or 0) >= 60
14:         ]
15:         failed = [name for name in self.OPPORTUNITY_DIMENSIONS if name not in valid]
16:         trend_ok = "trend" in valid
17:         strength_ok = "strength" in valid or "sector" in valid
18:         risk = dimensions.get("risk")
19:         risk_ok = bool(risk and risk.valid and risk.score is not None and risk.score >= 40)
20:         if not risk_ok:
21:             failed.append("risk")
22:         eligible = len(valid) >= 4 and trend_ok and strength_ok and risk_ok
23:         reason = "eligible" if eligible else ";".join([
24:             item for item in (
25:                 "less_than_4_dimensions" if len(valid) < 4 else "",
26:                 "trend_not_confirmed" if not trend_ok else "",
27:                 "strength_or_sector_not_confirmed" if not strength_ok else "",
28:                 "risk_not_acceptable" if not risk_ok else "",
29:             ) if item
30:         ])
31:         return ResonanceSnapshot(len(valid), valid, failed, eligible, reason)
