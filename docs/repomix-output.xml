 955:         }
 956:     """
 957:     result = {
 958:         "资产规模": {"value": "", "unit": "", "date": ""},
 959:         "份额规模": {"value": "", "unit": "", "date": ""},
 960:         "投资人结构": {"机构占比": "", "个人占比": ""}
