<file path="backend/analyzers/lifecycle.py">
  1: """
  2: 龙头趋势阶段识别器（原"生命周期"）
  3: 阶段: 观望 → 留意 → 蓄势 → 突破 → 加速 → 主升 → 分歧 → 衰退
  4: - 涨停股：基于连板高度 + 涨幅 + 主力资金判断（突破/加速/主升/分歧/衰退）
  5: - 非涨停股：基于主力净流入推断（观望/留意/蓄势）
  6: """
  7: import sys, os
  8: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
  9: import logging
 10: from datetime import datetime
 11: from db.session import get_db_session
 12: from db.models import LeaderLifecycle, StockFlow
 13: from sqlalchemy import func
 14: logger = logging.getLogger(__name__)
 15: LIMIT_UP_THRESHOLD = 9.8  # 涨停判定阈值（%）
 16: # 涨停股趋势阶段配置
 17: LIMIT_UP_STAGE_CONFIG = {
 18:     '突破': {'strength': 20, 'color': '#facc15'},
 19:     '加速': {'strength': 40, 'color': '#fb923c'},
 20:     '主升': {'strength': 80, 'color': '#ef4444'},
 21:     '分歧': {'strength': 60, 'color': '#f97316'},
 22:     '衰退': {'strength': 20, 'color': '#94a3b8'},
 23: }
 24: # 非涨停股趋势阶段配置（观望/留意/蓄势）
 25: NON_LIMIT_STAGE_CONFIG = {
 26:     '蓄势': {'strength': 60, 'color': '#38bdf8'},
 27:     '留意': {'strength': 40, 'color': '#a78bfa'},
 28:     '观望': {'strength': 20, 'color': '#64748b'},
 29: }
 30: def _to_float(value, default=0):
 31:     try:
 32:         return float(value or default)
 33:     except (TypeError, ValueError):
 34:         return default
 35: def identify_limit_up_stage(consecutive_days, change_rate, main_force_inflow):
 36:     """涨停股：根据连板天数、涨幅、主力资金判断趋势阶段"""
 37:     if consecutive_days <= 1:
 38:         return '突破'
 39:     elif consecutive_days <= 3:
 40:         if main_force_inflow > 0:
 41:             return '加速'
 42:         return '分歧'
 43:     elif consecutive_days >= 4:
 44:         if change_rate > 5:
 45:             return '主升'
 46:         elif change_rate > 0:
 47:             return '分歧'
 48:         else:
 49:             return '衰退'
 50:     return '突破'
 51: def infer_non_limit_stage(main_force_inflow):
 52:     """非涨停股：根据主力净流入推断趋势阶段"""
 53:     if main_force_inflow >= 10000:
 54:         return '蓄势'
 55:     elif main_force_inflow >= 1000:
 56:         return '留意'
 57:     return '观望'
 58: def update_lifecycle(trade_date):
 59:     """更新指定日期所有股票的生命周期阶段"""
 60:     try:
 61:         with get_db_session() as db:
 62:             trade_date_obj = datetime.strptime(trade_date, '%Y-%m-%d') if isinstance(trade_date, str) else trade_date
 63:             # 获取前一交易日数据用于计算连板天数
 64:             prev_date_row = db.query(func.max(LeaderLifecycle.trade_date)).filter(
 65:                 LeaderLifecycle.trade_date < trade_date_obj.date()
 66:             ).scalar()
 67:             prev_leaders = db.query(LeaderLifecycle).filter_by(trade_date=prev_date_row).all() if prev_date_row else []
 68:             prev_map = {l.ts_code: l for l in prev_leaders}
 69:             # 当天所有已存在的生命周期记录
 70:             existing_leaders = {l.ts_code: l for l in db.query(LeaderLifecycle).filter_by(trade_date=trade_date).all()}
 71:             # 当天所有个股资金流向（覆盖涨停+非涨停）
 72:             stocks = db.query(StockFlow).filter_by(trade_date=trade_date).all()
 73:             if not stocks:
 74:                 print(f'[lifecycle] No stock flow data for {trade_date}')
 75:                 return
 76:             updated = 0
 77:             created = 0
 78:             for stock in stocks:
 79:                 ts_code = stock.ts_code
 80:                 name = stock.name
 81:                 sector = stock.sector
 82:                 change_rate = _to_float(stock.price_chg)
 83:                 main_force = _to_float(stock.main_force_inflow)
 84:                 is_limit_up = change_rate >= LIMIT_UP_THRESHOLD
 85:                 leader = existing_leaders.get(ts_code)
 86:                 if not leader:
 87:                     leader = LeaderLifecycle(
 88:                         trade_date=trade_date,
 89:                         ts_code=ts_code,
 90:                         name=name,
 91:                         sector=sector,
 92:                         stage='突破',
 93:                         consecutive_days=1,
 94:                     )
 95:                     db.add(leader)
 96:                     created += 1
 97:                 # 补充名称/板块（如果缺失）
 98:                 if not leader.name and name:
 99:                     leader.name = name
100:                 if not leader.sector and sector:
101:                     leader.sector = sector
102:                 # 计算连板天数：仅涨停股累计，非涨停股重置为 1
103:                 prev_leader = prev_map.get(ts_code)
104:                 if is_limit_up:
105:                     if prev_leader and prev_leader.consecutive_days and prev_leader.consecutive_days >= 1:
106:                         leader.consecutive_days = prev_leader.consecutive_days + 1
107:                     else:
108:                         leader.consecutive_days = 1
109:                 else:
110:                     leader.consecutive_days = 1
111:                 # 识别阶段
112:                 if is_limit_up:
113:                     stage = identify_limit_up_stage(leader.consecutive_days, change_rate, main_force)
114:                     leader.strength = LIMIT_UP_STAGE_CONFIG[stage]['strength']
115:                 else:
116:                     stage = infer_non_limit_stage(main_force)
117:                     leader.strength = NON_LIMIT_STAGE_CONFIG[stage]['strength']
118:                 leader.stage = stage
119:                 leader.change_rate = change_rate
120:                 updated += 1
121:             db.commit()
122:         print(f'[lifecycle] Updated {updated} stocks ({created} created) for {trade_date}')
123:     except Exception as e:
124:         pass  # with context auto-rollbacks
125:         logger.exception(f'[lifecycle] Error')
126:         return {'error': str(e)}
127: if __name__ == '__main__':
128:     today = datetime.now().strftime('%Y-%m-%d')
129:     update_lifecycle(today)
</file>

<file path="backend/analyzers/rotation.py">
  1: """
  2: 板块轮动分析器
  3: 对比当前与N日前各板块net_flow变化，生成桑基图数据
  4: """
  5: import sys, os
  6: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
  7: import logging
  8: from datetime import datetime, timedelta
  9: from db.session import get_db_session
 10: from db.models import SectorFlow
 11: from sqlalchemy import func
 12: logger = logging.getLogger(__name__)
 13: def calculate_rotation(trade_date, lookback_days=5):
 14:     """
 15:     计算板块轮动数据
 16:     返回桑基图格式: { nodes: [...], links: [...], signals: [...], streaks: {...} }
 17:     """
 18:     try:
 19:         with get_db_session() as db:
 20:             # 获取当前日期和N天前的板块数据
 21:             current_sectors = db.query(SectorFlow).filter_by(trade_date=trade_date).all()
 22:             # 获取N天前的数据：查找数据库中实际存在的最近交易日
 23:             trade_date_obj = datetime.strptime(trade_date, '%Y-%m-%d') if isinstance(trade_date, str) else trade_date
 24:             past_date_obj = trade_date_obj - timedelta(days=lookback_days)
 25:             # 查询该日期之前（含）最近的交易日
 26:             past_date_row = db.query(func.max(SectorFlow.trade_date)).filter(
 27:                 SectorFlow.trade_date <= past_date_obj.date(),
 28:                 SectorFlow.trade_date < trade_date_obj.date()
 29:             ).scalar()
 30:             past_sectors = []
 31:             if past_date_row:
 32:                 past_date = past_date_row.strftime('%Y-%m-%d')
 33:                 past_sectors = db.query(SectorFlow).filter_by(trade_date=past_date_row).all()
 34:                 logger.debug(f'[rotation] Comparing {trade_date} vs {past_date} (lookback {lookback_days}d)')
 35:             else:
 36:                 logger.debug(f'[rotation] No past trading day found for lookback {lookback_days}d')
 37:             if not current_sectors:
 38:                 return {'nodes': [], 'links': [], 'signals': [], 'streaks': {}}
 39:             # 构建板块净流入映射
 40:             current_map = {s.sector: float(s.net_flow or 0) for s in current_sectors}
 41:             past_map = {s.sector: float(s.net_flow or 0) for s in past_sectors} if past_sectors else {}
 42:             # 计算变化
 43:             changes = []
 44:             for sector, current_flow in current_map.items():
 45:                 past_flow = past_map.get(sector, 0)
 46:                 change = current_flow - past_flow
 47:                 changes.append({
 48:                     'sector': sector,
 49:                     'current': current_flow,
 50:                     'past': past_flow,
 51:                     'change': change,
 52:                 })
 53:             # 按变化排序：正变化=流入，负变化=流出
 54:             inflows = sorted([c for c in changes if c['change'] > 0], key=lambda x: x['change'], reverse=True)
 55:             outflows = sorted([c for c in changes if c['change'] < 0], key=lambda x: x['change'])
 56:             # 生成桑基图节点和链接
 57:             nodes = []
 58:             links = []
 59:             # 全量流出/流入列表（按变化值排序）
 60:             all_outflows = outflows  # 全部流出板块
 61:             all_inflows = inflows    # 全部流入板块
 62:             # 实际总额（全量）
 63:             total_outflow_all = sum(abs(c['change']) for c in all_outflows)
 64:             total_inflow_all = sum(c['change'] for c in all_inflows)
 65:             # 桑基图用 Top 15 流出 + Top 10 流入（避免节点过多）
 66:             top_outflows = outflows[:15]
 67:             top_inflows = inflows[:10]
 68:             # 流出板块节点
 69:             for c in top_outflows:
 70:                 nodes.append({'name': c['sector'], 'category': 'outflow'})
 71:             # 流入板块节点
 72:             for c in top_inflows:
 73:                 nodes.append({'name': c['sector'], 'category': 'inflow'})
 74:             # 按比例分配链接：每个流出板块按各流入板块占比分配资金
 75:             total_outflow = sum(abs(c['change']) for c in top_outflows)
 76:             total_inflow = sum(c['change'] for c in top_inflows)
 77:             for out_c in top_outflows:
 78:                 out_val = abs(out_c['change'])
 79:                 for in_c in top_inflows:
 80:                     if total_outflow > 0:
 81:                         flow_value = out_val * (in_c['change'] / total_outflow)
 82:                     else:
 83:                         flow_value = 0
 84:                     if flow_value > 0.01:
 85:                         links.append({
 86:                             'source': out_c['sector'],
 87:                             'target': in_c['sector'],
 88:                             'value': round(flow_value, 2),
 89:                         })
 90:             # === 计算连续流入天数 ===
 91:             # 查询最近30天的交易日，计算每个板块的连续净流入天数
 92:             recent_dates = db.query(SectorFlow.trade_date).filter(
 93:                 SectorFlow.trade_date <= trade_date_obj.date()
 94:             ).distinct().order_by(SectorFlow.trade_date.desc()).limit(30).all()
 95:             recent_dates = [d[0] for d in recent_dates]
 96:             recent_dates.reverse()  # 旧→新
 97:             streaks = {}
 98:             if recent_dates:
 99:                 recent_data = db.query(SectorFlow).filter(
100:                     SectorFlow.trade_date.in_(recent_dates)
101:                 ).all()
102:                 # 按板块分组，按日期排序
103:                 sector_daily = {}
104:                 for s in recent_data:
105:                     if s.sector not in sector_daily:
106:                         sector_daily[s.sector] = []
107:                     sector_daily[s.sector].append({
108:                         'date': s.trade_date,
109:                         'net_flow': float(s.net_flow or 0)
110:                     })
111:                 # 计算每个板块的连续流入天数
112:                 for sector, daily_list in sector_daily.items():
113:                     daily_list.sort(key=lambda x: x['date'], reverse=True)  # 最新在前
114:                     streak = 0
115:                     for d in daily_list:
116:                         if d['net_flow'] > 0:
117:                             streak += 1
118:                         else:
119:                             break
120:                     streaks[sector] = streak
121:             # 生成轮动信号
122:             signals = []
123:             if inflows:
124:                 # 在信号中加入连续流入天数信息
125:                 inflow_names = [c['sector'] for c in inflows[:5]]
126:                 inflow_detail = []
127:                 for c in inflows[:5]:
128:                     streak = streaks.get(c['sector'], 0)
129:                     if streak >= 2:
130:                         inflow_detail.append(f"{c['sector']}(连续{streak}天流入)")
131:                     else:
132:                         inflow_detail.append(c['sector'])
133:                 signals.append(f"资金流入：{'、'.join(inflow_detail)}")
134:             if outflows:
135:                 signals.append(f"资金流出：{'、'.join([c['sector'] for c in outflows[:5]])}")
136:             return {
137:                 'nodes': nodes,
138:                 'links': links,
139:                 'signals': signals,
140:                 'streaks': streaks,
141:                 'date': trade_date,
142:                 'lookback_days': lookback_days,
143:                 # 全量数据（供前端展示完整列表）
144:                 'all_inflows': [{'sector': c['sector'], 'change': round(c['change'], 2),
145:                                  'current': round(c['current'], 2), 'past': round(c['past'], 2)}
146:                                 for c in all_inflows],
147:                 'all_outflows': [{'sector': c['sector'], 'change': round(c['change'], 2),
148:                                   'current': round(c['current'], 2), 'past': round(c['past'], 2)}
149:                                  for c in all_outflows],
150:                 # 实际总额（全量）
151:                 'total_inflow': round(total_inflow_all, 2),
152:                 'total_outflow': round(total_outflow_all, 2),
153:                 'net_flow': round(total_inflow_all - total_outflow_all, 2),
154:         }
155:     except Exception as e:
156:         logger.exception(f'[rotation] Error')
157:         return {'nodes': [], 'links': [], 'signals': [], 'streaks': {}, 'error': str(e)}
158: if __name__ == '__main__':
159:     today = datetime.now().strftime('%Y-%m-%d')
160:     result = calculate_rotation(today)
161:     print(result)
</file>

