371: 
372: ```python
373: import numpy as np
374: from db.connection import get_db
375: from db.models import SectorFlow
376: 
377: def calculate_heat_scores(trade_date):
378:     """计算指定日期所有板块的热度评分"""
379:     db = next(get_db())
380:     sectors = db.query(SectorFlow).filter_by(trade_date=trade_date).all()
381:     if not sectors:
382:         return
383:     # 归一化
384:     net_flows = np.array([float(s.net_flow or 0) for s in sectors])
385:     limit_ups = np.array([float(s.limit_up_count or 0) for s in sectors])
386:     rises = np.array([float(s.rise_ratio or 0) for s in sectors])
387:     
388:     def normalize(arr):
389:         if arr.max() == arr.min():
390:             return np.ones_like(arr) * 0.5
391:         return (arr - arr.min()) / (arr.max() - arr.min())
392:     
393:     nf_norm = normalize(net_flows)
394:     lu_norm = normalize(limit_ups)
395:     rr_norm = normalize(rises)
396:     
397:     for i, sector in enumerate(sectors):
398:         sector.heat_score = nf_norm[i] * 0.4 + lu_norm[i] * 0.3 + rr_norm[i] * 0.3
399:     db.commit()
400: ```
