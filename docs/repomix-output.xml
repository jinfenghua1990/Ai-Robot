<file path="backend/scripts/seed_us_quant.py">
  1: #!/usr/bin/env python3
  2: """US Quant — 一次性扫描 + 种子脚本（让系统有真实可看的数据）。
  3: 做什么：
  4:   1. 用可插拔数据源（us_quant.data_provider：Nasdaq 实时主源 → Yahoo 兜底 → 离线模拟）拉行情；
  5:   2. 用现有策略引擎（indicators / strategies / filters / states）对 watchlist 评分；
  6:   3. 通过 scanner.create_signal 生成信号，落库 us_signals；
  7:   4. 额外造一批「跨生命周期状态」的样本信号 + 样本持仓，便于演示；
  8:   5. 幂等：先清空 us_signals / us_positions 再写入。
  9: 运行（必须在 backend 目录下用后端同款解释器）：
 10:     cd /Users/gino/Projects/AIROBOT/backend
 11:     /usr/bin/python3 scripts/seed_us_quant.py
 12: """
 13: import os
 14: import sys
 15: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 16: import random
 17: from datetime import datetime, timedelta, date
 18: from db.session import get_db_session
 19: from us_quant.repository import ensure_schema, USSignal, USPosition
 20: from us_quant.data_provider import get_klines, get_quote
 21: from us_quant.indicators import (
 22:     ema, sma, rsi as calc_rsi, macd as calc_macd, kdj as calc_kdj,
 23: )
 24: from us_quant.strategies import score_breakout, score_pullback
 25: from us_quant.filters import check_hard_filters
 26: from us_quant.states import determine_stock_state
 27: from us_quant.scanner import create_signal
 28: WATCHLIST = [
 29:     ("AAPL", "Apple"), ("MSFT", "Microsoft"), ("GOOGL", "Alphabet"),
 30:     ("AMZN", "Amazon"), ("NVDA", "NVIDIA"), ("TSLA", "Tesla"),
 31:     ("META", "Meta"), ("TSM", "TSMC"), ("AMD", "AMD"), ("NFLX", "Netflix"),
 32:     ("COIN", "Coinbase"), ("PLTR", "Palantir"),
 33:     ("XLK", "Technology ETF"), ("SMH", "Semiconductor ETF"),
 34:     ("XLF", "Financial ETF"), ("XLE", "Energy ETF"),
 35: ]
 36: def score_symbol(symbol: str):
 37:     klines = get_klines(symbol, "3mo")
 38:     if not klines or len(klines) < 5:
 39:         return None
 40:     closes = [k["close"] for k in klines if k.get("close")]
 41:     highs = [k["high"] for k in klines if k.get("high")]
 42:     lows = [k["low"] for k in klines if k.get("low")]
 43:     volumes = [k["volume"] for k in klines if k.get("volume")]
 44:     price = closes[-1]
 45:     if not price:
 46:         return None
 47:     ema10 = ema(closes, 10)
 48:     ema20 = ema(closes, 20)
 49:     ma50 = sma(closes, 50)
 50:     rsi_val = calc_rsi(closes, 14)
 51:     macd_val = calc_macd(closes)
 52:     kdj_val = calc_kdj(closes)
 53:     e10 = ema10[-1] if ema10 else None
 54:     e20 = ema20[-1] if ema20 else None
 55:     m50 = ma50[-1] if ma50 else None
 56:     hf = check_hard_filters(price=price)
 57:     high_52w = max(closes[-252:]) if len(closes) >= 252 else max(closes)
 58:     base_high = max(closes[-20:]) if len(closes) >= 20 else max(closes)
 59:     base_low = min(closes[-20:]) if len(closes) >= 20 else min(closes)
 60:     rel_vol = (volumes[-1] / (sum(volumes[-5:]) / 5)) if len(volumes) >= 5 else 1.0
 61:     change_today = (closes[-1] - closes[-2]) / closes[-2] * 100 if len(closes) >= 2 else 0
 62:     bs = score_breakout(
 63:         price=price, ema10=e10, ema20=e20, ma50=m50, high_52w=high_52w,
 64:         base_high=base_high, base_low=base_low, base_days=20, rel_volume=rel_vol,
 65:         change_pct_today=change_today, market_mult=1.0,
 66:     )
 67:     prior_up = bool(e10 and e20 and m50 and e10 > e20 > m50)
 68:     pb = None
 69:     if len(closes) >= 10:
 70:         peak = max(closes[-10:])
 71:         pb = (peak - price) / peak * 100
 72:     ps = score_pullback(
 73:         price=price, ema10=e10, ema20=e20, ma50=m50, prior_uptrend=prior_up,
 74:         first_pullback=True, pullback_pct=pb, volume_contracted=True,
 75:         no_consecutive_bearish=True, market_mult=1.0,
 76:     )
 77:     state = determine_stock_state(price=price, ma20=e20, ma50=m50, rsi=rsi_val)
 78:     stop = round(m50 * 0.97, 2) if (m50 and price) else round(price * 0.95, 2)
 79:     bo = bs.total if getattr(bs, "hard_pass", False) else None
 80:     pbk = ps.total if getattr(ps, "hard_pass", False) else None
 81:     return {
 82:         "symbol": symbol, "price": price, "rsi": rsi_val,
 83:         "state_label": state.label, "breakout": bo, "pullback": pbk,
 84:         "hard_pass": hf.passed, "stop": stop,
 85:         "indicators": {"macd": macd_val, "kdj": kdj_val},
 86:     }
 87: def main():
 88:     ensure_schema()
 89:     with get_db_session() as db:
 90:         # 幂等清空
 91:         deleted_sig = db.query(USSignal).delete()
 92:         deleted_pos = db.query(USPosition).delete()
 93:         # 1) 扫描生成信号
 94:         scanned = 0
 95:         for sym, name in WATCHLIST:
 96:             try:
 97:                 r = score_symbol(sym)
 98:                 if not r or not r["hard_pass"]:
 99:                     continue
100:                 bo = r["breakout"] or 0.0
101:                 pbk = r["pullback"] or 0.0
102:                 strat = "breakout" if bo >= pbk else "pullback"
103:                 score = max(bo, pbk)
104:                 if score < 30:
105:                     continue
106:                 sig = create_signal(
107:                     symbol=sym, name=name, strategy=strat, strategy_version="2.1.1",
108:                     score=round(score, 2), planned_entry=round(r["price"], 2),
109:                     planned_stop=r["stop"],
110:                     expected_rr=round((r["price"] - r["stop"]) / r["stop"] * 100, 2) if r["stop"] else None,
111:                     market_regime="LIVE", sector_rank=0,
112:                     trigger_details={"state": r["state_label"], "rsi": round(r["rsi"], 1) if r["rsi"] else None},
113:                 )
114:                 db.add(USSignal(
115:                     symbol=sig.symbol, name=sig.name, strategy=sig.strategy,
116:                     strategy_version=sig.strategy_version, signal_type=sig.signal_type,
117:                     lifecycle_status=sig.lifecycle_status, score=sig.score,
118:                     signal_time=sig.signal_time, expires_at=sig.expires_at,
119:                     planned_entry=sig.planned_entry, planned_stop=sig.planned_stop,
120:                     planned_target=sig.planned_target, expected_rr=sig.expected_rr,
121:                     risk_veto=sig.risk_veto, trigger_details=sig.trigger_details,
122:                     market_regime=sig.market_regime, sector_rank=sig.sector_rank,
123:                 ))
124:                 scanned += 1
125:             except Exception as exc:  # 单只失败不影响其余
126:                 print(f"  [skip] {sym}: {exc}")
127:         # 2) 样本信号：覆盖多种生命周期状态，保证演示丰富
128:         now = datetime.utcnow()
129:         samples = [
130:             ("NVDA", "NVIDIA", "breakout", "TRIGGERED", 128.4, 118.0, 2.1),
131:             ("TSLA", "Tesla", "pullback", "ACTIVE", 255.0, 240.0, 1.8),
132:             ("AMD", "AMD", "breakout", "WATCHING", 162.0, 150.0, 2.4),
133:             ("COIN", "Coinbase", "breakout", "SCORED", 245.0, 220.0, 1.5),
134:             ("META", "Meta", "pullback", "DISCOVERED", 515.0, 498.0, 2.0),
135:             ("PLTR", "Palantir", "breakout", "CLOSED", 38.5, 30.0, 3.2),
136:             ("NFLX", "Netflix", "pullback", "APPROVED", 680.0, 650.0, 1.9),
137:         ]
138:         for sym, name, strat, status, entry, stop, rr in samples:
139:             db.add(USSignal(
140:                 symbol=sym, name=name, strategy=strat, strategy_version="2.1.1",
141:                 signal_type="ENTRY", lifecycle_status=status,
142:                 score=round(random.uniform(55, 92), 2),
143:                 signal_time=now - timedelta(days=random.randint(0, 3)),
144:                 expires_at=now + timedelta(days=3),
145:                 planned_entry=entry, planned_stop=stop, expected_rr=rr,
146:                 market_regime="LIVE", sector_rank=0,
147:                 trigger_details={"sample": True},
148:             ))
149:         # 3) 样本持仓（current_price 取实时行情，不再写死）
150:         positions = [
151:             ("TSLA", "Tesla", "pullback", 250.0, 100, "Technology", 238.0),
152:             ("NVDA", "NVIDIA", "breakout", 120.0, 200, "Semiconductors", 112.0),
153:             ("COIN", "Coinbase", "breakout", 220.0, 30, "Financial", 210.0),
154:         ]
155:         for sym, name, strat, ep, qty, sector, stop in positions:
156:             q = get_quote(sym)
157:             cp = float(q["price"]) if (q and q.get("price")) else ep
158:             pl = (cp - ep) * qty
159:             db.add(USPosition(
160:                 symbol=sym, name=name, strategy=strat, entry_price=ep, current_price=round(cp, 2),
161:                 quantity=qty, cost_basis=ep * qty, market_value=cp * qty,
162:                 unrealized_pl=pl, unrealized_pl_pct=round((cp - ep) / ep * 100, 2),
163:                 stop_price=stop, entry_date=date.today() - timedelta(days=random.randint(3, 20)),
164:                 holding_days=random.randint(3, 20), sector=sector,
165:                 risk_group="LIVE", status="ACTIVE",
166:             ))
167:         db.commit()
168:         print(f"OK: 清空原信号 {deleted_sig} / 持仓 {deleted_pos}；"
169:               f"新写入 扫描信号 {scanned} + 样本信号 {len(samples)} + 样本持仓 {len(positions)}")
170: if __name__ == "__main__":
171:     main()
</file>

