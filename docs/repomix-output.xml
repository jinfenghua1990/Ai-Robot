 60:         latest_close = closes[-1]
 61:         latest = kline[day_index]
 62:         prev = kline[day_index - 1] if day_index > 0 else latest
 63:         # 1. 金叉：昨天 DIF <= DEA，今天 DIF > DEA
 64:         if dif[-2] is None or dea[-2] is None:
 65:             return None
 66:         if not (dif[-2] <= dea[-2] and dif[-1] > dea[-1]):
 67:             return None
 68:         # 2. 柱状线：最近一天 >= 0（如果 hist[-1] < 0 但 DIF>DEA 极弱，丢弃）
 69:         if hist[-1] < 0:
