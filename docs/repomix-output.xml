  1: """研报中心 F10 免费数据源（替代付费通达信 Hub）+ PG 缓存
  2: 设计原则：
  3: - 财务(营收/净利/ROE/毛利率/eps) 与 机构持仓(机构数/占流通比) 走 Tushare
  4:   复用 collectors.tdx_collector.call_tushare_mcp（已含 TUSHARE_TOKEN + 全局令牌桶限流）。
  5: - 评级/目标价 走东方财富公开 API（无需 token）。
  6: - 三者按 ts_code 整包缓存进 PG `stock_f10` 表，TTL = 1 天（日频变化）。
  7:   多用户复用、断网/限流时直接读缓存，无需每次外网拉取。
  8: - 任何网络/解析异常都吞掉并返回 None，绝不中断主报告生成（F10 只是锦上添花）。
  9: 对外暴露与旧 tdx_hub_client 完全一致的接口签名：
 10:   get_financials(code) / get_rating(code) / get_institutional(code) / is_configured()
 11: 这样 analysis_consumer 几乎不用改动即可切换数据源。
 12: """
 13: import json
 14: import logging
 15: from datetime import datetime, timedelta
 16: from typing import Optional, Dict, Any
 17: import httpx
 18: from db.connection import SessionLocal
 19: from db.models import StockF10
 20: logger = logging.getLogger("f10_provider")
 21: # 缓存有效期（小时）。财务/机构日频变化，1 天足够。
 22: CACHE_TTL_HOURS = 24
 23: # 东方财富 datacenter 盈利预测接口（含目标价/一致EPS），公开无需鉴权
 24: _EM_RATING_URL = (
 25:     "https://datacenter.eastmoney.com/securities/api/data/v1/get"
 26:     "?reportName=RPT_WEB_RESPREDICT&columns=ALL"
 27:     "&filter=(SECUCODE%3D%22{secucode}%22)"
 28:     "&client=PC&source=WEB&p=1"
 29: )
 30: _EM_HEADERS = {
 31:     "User-Agent": "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) "
 32:                   "AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120 Safari/537.36",
 33:     "Referer": "https://data.eastmoney.com/",
 34: }
 35: # ---------- 工具 ----------
 36: def _to_ts_code(code: str) -> str:
 37:     """纯数字代码 -> tushare 风格 ts_code（002245 -> 002245.SZ）。"""
 38:     c = (code or "").strip()
 39:     if not c:
 40:         return c
 41:     if "." in c:
 42:         return c
 43:     if c[0] in ("6", "9") or c.startswith("688"):
 44:         return f"{c}.SH"
 45:     if c.startswith("8") or c.startswith("4"):
 46:         return f"{c}.BJ"
 47:     return f"{c}.SZ"
 48: def is_configured() -> bool:
 49:     """只要 Tushare token 在（财务/机构可用）即视为可用；东方财富无需 token。"""
 50:     try:
 51:         from config import TUSHARE_TOKEN
 52:         if TUSHARE_TOKEN:
 53:             return True
 54:     except Exception as e:
 55:         logger.debug("[f10_provider] is_configured failed: %s", e)
 56:     return False
 57: # ---------- PG 缓存 ----------
 58: def _cache_get(ts_code: str) -> Optional[Dict[str, Any]]:
 59:     try:
 60:         with SessionLocal() as db:
 61:             row = db.get(StockF10, ts_code)
 62:             if row and row.fetched_at:
 63:                 if datetime.now() - row.fetched_at < timedelta(hours=CACHE_TTL_HOURS):
 64:                     return {
 65:                         "financials": json.loads(row.financial_json) if row.financial_json else None,
 66:                         "institution": json.loads(row.institution_json) if row.institution_json else None,
 67:                         "rating": json.loads(row.rating_json) if row.rating_json else None,
 68:                     }
 69:     except Exception as e:
 70:         logger.warning("[f10_provider] cache_get %s error: %s", ts_code, e)
 71:     return None
 72: def _cache_set(ts_code: str, financials, institution, rating) -> None:
 73:     try:
 74:         with SessionLocal() as db:
 75:             row = db.get(StockF10, ts_code)
 76:             if not row:
 77:                 row = StockF10(ts_code=ts_code)
 78:             row.financial_json = json.dumps(financials, ensure_ascii=False) if financials else None
 79:             row.institution_json = json.dumps(institution, ensure_ascii=False) if institution else None
 80:             row.rating_json = json.dumps(rating, ensure_ascii=False) if rating else None
 81:             row.fetched_at = datetime.now()
 82:             db.merge(row)
 83:             db.commit()
 84:     except Exception as e:
 85:         logger.warning("[f10_provider] cache_set %s error: %s", ts_code, e)
 86: # ---------- 免费源拉取 ----------
 87: def _fetch_financials(ts_code: str) -> Optional[Dict[str, Any]]:
 88:     """Tushare 财务：fina_indicator 取 ROE/毛利率/eps/bps，income 取营收/净利，合并为最新期。"""
 89:     from collectors.tdx_collector import call_tushare_mcp
 90:     out: Dict[str, Any] = {}
 91:     fi = call_tushare_mcp(
 92:         "fina_indicator",
 93:         params={"ts_code": ts_code},
 94:         fields=["ts_code", "ann_date", "end_date", "roe", "grossprofit_margin", "eps", "bps"],
 95:     )
 96:     if fi:
 97:         r = fi[0]
 98:         if r.get("roe") is not None:
 99:             out["roe"] = r["roe"]
100:         if r.get("grossprofit_margin") is not None:
101:             out["gross_margin"] = r["grossprofit_margin"]
102:         if r.get("eps") is not None:
103:             out["eps"] = r["eps"]
104:         if r.get("bps") is not None:
105:             out["bps"] = r["bps"]
106:         if r.get("end_date"):
107:             out["period"] = str(r["end_date"])
108:     inc = call_tushare_mcp(
109:         "income",
110:         params={"ts_code": ts_code},
111:         fields=["ts_code", "ann_date", "end_date", "revenue", "n_income"],
112:     )
113:     if inc:
114:         r = inc[0]
115:         if r.get("revenue") is not None:
116:             out["revenue"] = r["revenue"]
117:         if r.get("n_income") is not None:
118:             out["net_profit"] = r["n_income"]
119:         if "period" not in out and r.get("end_date"):
120:             out["period"] = str(r["end_date"])
121:     # TTM PE / PB 来自 daily_basic（免费且准确，避免用单季 EPS 误算）
122:     db = call_tushare_mcp(
123:         "daily_basic",
124:         params={"ts_code": ts_code},
125:         fields=["ts_code", "trade_date", "pe_ttm", "pb"],
126:     )
127:     if db:
128:         db.sort(key=lambda x: str(x.get("trade_date") or ""), reverse=True)
129:         r = db[0]
130:         if r.get("pe_ttm") is not None:
131:             out["pe_ttm"] = r["pe_ttm"]
132:         if r.get("pb") is not None:
133:             out["pb"] = r["pb"]
134:     return out or None
135: _INST_KEYWORDS = ("基金", "资管", "保险", "社保", "QFII", "信托", "证券", "银行", "私募", "养老")
136: def _fetch_institution(ts_code: str) -> Optional[Dict[str, Any]]:
137:     """Tushare top10_floatholders：仅取最新报告期，统计机构数 + 机构合计占流通股比例。"""
138:     from collectors.tdx_collector import call_tushare_mcp
139:     rows = call_tushare_mcp(
140:         "top10_floatholders",
141:         params={"ts_code": ts_code},
142:         fields=["ts_code", "ann_date", "holder_name", "hold_ratio"],
143:     )
144:     if not rows:
145:         return None
146:     # 只保留最新报告期（避免跨期累加导致占比 >100%）
147:     rows.sort(key=lambda x: str(x.get("ann_date") or ""), reverse=True)
148:     latest = rows[0].get("ann_date")
149:     period_rows = [r for r in rows if r.get("ann_date") == latest]
150:     inst_rows = [x for x in period_rows if any(k in (x.get("holder_name") or "") for k in _INST_KEYWORDS)]
151:     out: Dict[str, Any] = {}
152:     if inst_rows:
153:         out["机构数量"] = len(inst_rows)
154:         try:
155:             ratio = sum(float(x.get("hold_ratio") or 0) for x in inst_rows)
156:             out["持仓占实际流通A股比例"] = round(ratio, 4)
157:         except Exception as e:
158:             logger.debug("[f10_provider] hold_ratio sum failed: %s", e)
159:     if latest:
160:         out["period"] = str(latest)
161:     return out or None
162: def _fetch_rating(ts_code: str) -> Optional[Dict[str, Any]]:
163:     """东方财富公开盈利预测接口（RPT_WEB_RESPREDICT）：券商一致目标价 / EPS / 评级分布。
164:     字段证实可用（2026-07-14 验证）：
165:     - DEC_AIMPRICEMAX/DEC_AIMPRICEMIN → 最高/最低目标价（取均值）
166:     - EPS1/2/3/4 → 各财年一致预测（YEAR_MARK: A=actual, E=estimate）
167:     - RATING_BUY_NUM/ADD_NUM/NEUTRAL_NUM/REDUCE_NUM/SALE_NUM → 评级分布
168:     - RATING_ORG_NUM → 覆盖机构数
169:     """
170:     secucode = ts_code
171:     url = _EM_RATING_URL.format(secucode=secucode)
172:     try:
173:         resp = httpx.get(url, headers=_EM_HEADERS, timeout=12)
174:         if resp.status_code != 200:
175:             logger.warning("[f10_provider] 东财评级 %s -> HTTP %s", ts_code, resp.status_code)
176:             return None
177:         data = resp.json()
178:         if not data.get("success"):
179:             logger.warning("[f10_provider] 东财评级 %s 接口失败: %s", ts_code, data.get("message"))
180:             return None
181:         items = (data.get("result") or {}).get("data") or []
182:         if not items:
183:             return None
184:         row = items[0]
185:         out: Dict[str, Any] = {}
186:         # 目标价（最高/最低取均值）
187:         tp_max = row.get("DEC_AIMPRICEMAX")
188:         tp_min = row.get("DEC_AIMPRICEMIN")
189:         if tp_max is not None or tp_min is not None:
190:             try:
191:                 vals = [float(v) for v in (tp_max, tp_min) if v is not None]
192:                 if vals:
193:                     out["target_price"] = round(sum(vals) / len(vals), 2)
194:             except Exception:
195:                 logger.debug("f10: target price avg failed", exc_info=False)
196:         # 一致 EPS（优先取 A=actual 已确认的财年，否则取最新的 E=estimate）
197:         for i in range(1, 5):
198:             eps = row.get(f"EPS{i}")
199:             mrk = row.get(f"YEAR_MARK{i}")
200:             if eps is not None and mrk == "A":
201:                 out["eps"] = float(eps)
202:                 yr = row.get(f"YEAR{i}")
203:                 if yr:
204:                     out["eps_year"] = int(yr)
205:                 break
206:         else:
207:             for i in range(1, 5):
208:                 eps = row.get(f"EPS{i}")
209:                 if eps is not None:
210:                     out["eps"] = float(eps)
211:                     break
212:         # 评级分布 & 综合信号
213:         buy = row.get("RATING_BUY_NUM") or 0
214:         add = row.get("RATING_ADD_NUM") or 0
215:         neutral = row.get("RATING_NEUTRAL_NUM") or 0
216:         reduce = row.get("RATING_REDUCE_NUM") or 0
217:         sale = row.get("RATING_SALE_NUM") or 0
218:         total = buy + add + neutral + reduce + sale
219:         out["org_count"] = total
220:         out["rating_buy"] = buy
221:         out["rating_add"] = add
222:         out["rating_neutral"] = neutral
223:         if total > 0:
224:             out["buy_add_ratio"] = round((buy + add) / total, 4)
225:         if out:
226:             return out
227:     except Exception as e:
228:         logger.warning("[f10_provider] 东财评级 %s exception: %s", ts_code, e)
229:     return None
230: # ---------- 对外接口（与旧 tdx_hub_client 签名一致）----------
231: def fetch_f10(code: str) -> Dict[str, Any]:
232:     """拉取（或读缓存）F10 整包：{financials, institution, rating}。"""
233:     ts_code = _to_ts_code(code)
234:     cached = _cache_get(ts_code)
235:     if cached:
236:         return cached
237:     financials = _fetch_financials(ts_code)
238:     institution = _fetch_institution(ts_code)
239:     rating = _fetch_rating(ts_code)
240:     _cache_set(ts_code, financials, institution, rating)
241:     return {"financials": financials, "institution": institution, "rating": rating}
242: def get_financials(code: str) -> Optional[Dict[str, Any]]:
243:     return fetch_f10(code).get("financials")
244: def get_institutional(code: str) -> Optional[Dict[str, Any]]:
245:     return fetch_f10(code).get("institution")
246: def get_rating(code: str) -> Optional[Dict[str, Any]]:
247:     """返回 {target_price, rating_name, eps?}；eps 优先用财务包里的。"""
248:     bundle = fetch_f10(code)
249:     rating = bundle.get("rating") or {}
250:     fin = bundle.get("financials") or {}
251:     out = dict(rating)
252:     if "eps" not in out and fin.get("eps") is not None:
253:         out["eps"] = fin["eps"]
254:     return out or None
