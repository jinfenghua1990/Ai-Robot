<file path="frontend/src/components/StageBar.jsx">
  1: /**
  2:  * 等宽分段状态条（支持 8 种 variant，7 段统一标准）
  3:  *
  4:  * variant:
  5:  *   'lifecycle' (8段): 观望 → 留意 → 蓄势 → 突破 → 加速 → 主升 → 分歧 → 衰退
  6:  *   'quality'   (7段): 劣质 → 中性 → 偏强 → 强势 → 极强 → 核心 → 淘汰
  7:  *   'sentiment' (7段): 冰点 → 恐慌 → 谨慎 → 中性 → 乐观 → 狂热 → 过热
  8:  *   'risk'      (7段): 极安 → 安全 → 低危 → 中等 → 高危 → 极危 → 崩盘
  9:  *   'momentum'  (7段): 暴跌 → 流出 → 弱流 → 平衡 → 流入 → 强入 → 暴入
 10:  *   'mainForce' (7段): 出逃 → 减仓 → 观望 → 平衡 → 建仓 → 强仓 → 锁仓
 11:  *   'technical' (7段): 破位 → 弱势 → 震荡 → 偏多 → 多头 → 突破 → 顶部
 12:  *   'sector'    (7段): 冷门 → 跟随 → 联动 → 协同 → 共振 → 领涨 → 极热
 13:  *
 14:  * 7段一致性标准：所有 7 段指标统一使用 100/7 等比分界
 15:  */
 16: // ===== 趋势阶段（原"生命周期"，8段含分歧）=====
 17: const LIFECYCLE_ORDER = ['观望', '留意', '蓄势', '突破', '加速', '主升', '分歧', '衰退'];
 18: const LIFECYCLE_COLORS = {
 19:   '观望': '#64748b',
 20:   '留意': '#a78bfa',
 21:   '蓄势': '#38bdf8',
 22:   '突破': '#facc15',
 23:   '加速': '#fb923c',
 24:   '主升': '#ef4444',
 25:   '分歧': '#f97316',
 26:   '衰退': '#94a3b8',
 27: };
 28: // 旧名 → 新名映射（兼容后端旧数据）
 29: const LEGACY_LIFECYCLE_MAP = {
 30:   '跟随': '观望', '关注': '留意', '吸筹': '蓄势', '启动': '突破',
 31:   '发酵': '加速', '退潮': '衰退',
 32: };
 33: // ===== 个股强度（原"质量状态"，7段）=====
