 21: const isIntraday = () => {
 22:   const now = new Date();
 23:   const wd = now.getDay();
 24:   if (wd === 0 || wd === 6) return false;
 25:   const t = now.getHours() * 60 + now.getMinutes();
 26:   return (t >= 570 && t <= 690) || (t >= 780 && t <= 900);
 27: };
 28: export default function LifecycleV4Page() {
