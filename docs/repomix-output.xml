213:                   style={{ borderColor: 'var(--border-color)', background: 'var(--bg-surface)', color: 'var(--text-secondary)' }}>
214:                   📁 {g.name} ({g.count ?? 0})
215:                 </button>
216:               ))}
217:             </div>
