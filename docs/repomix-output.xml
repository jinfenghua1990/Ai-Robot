142: def _generate_bs_signals(klines, period=10, multiplier=1.0):
143:     """
144:     基于SuperTrend(超级趋势指标)生成BS点
145:     - B点: SuperTrend从空头转多头(收盘突破上轨)
146:     - S点: SuperTrend从多头转空头(收盘跌破下轨)
147:     辅助reason: MACD金叉/死叉、DIF拐头、KDJ金叉/死叉
148:     单信号源，天然交替(B→S→B→S)，无需去噪
149:     可配置参数: period(ATR周期), multiplier(乘数)
150:     """
151:     closes = [k['close'] for k in klines]
152:     highs = [k['high'] for k in klines]
153:     lows = [k['low'] for k in klines]
154:     # 主信号源: SuperTrend
155:     support, resistance, trend, atr = _calc_supertrend_impl(highs, lows, closes, period, multiplier)
156:     # 辅助指标(用于reason和indicators返回)
157:     dif, dea, macd = _calc_macd_impl(closes)
158:     ma5 = _calc_ma_impl(closes, 5)
159:     ma20 = _calc_ma_impl(closes, 20)
160:     k_vals, d_vals, j_vals = _calc_kdj_impl(highs, lows, closes, 9, 3, 3)
161:     signals = []
162:     for i in range(1, len(klines)):
163:         if trend[i] == trend[i-1]:
164:             continue  # 无变轨，无信号
165:         signal_type = 'B' if trend[i] == 1 else 'S'
166:         date = klines[i]['date']
167:         reasons = []
168:         # 主信号reason
169:         if signal_type == 'B':
170:             reasons.append(f'SuperTrend多头: 收盘{klines[i]["close"]:.2f}突破阻力线{resistance[i-1]:.2f}')
171:         else:
172:             reasons.append(f'SuperTrend空头: 收盘{klines[i]["close"]:.2f}跌破支撑线{support[i-1]:.2f}')
173:         # 辅助reason: MACD交叉
174:         if dif[i] is not None and dea[i] is not None and dif[i-1] is not None and dea[i-1] is not None:
175:             if signal_type == 'B' and dif[i-1] <= dea[i-1] and dif[i] > dea[i]:
176:                 reasons.append('MACD金叉: DIF上穿DEA')
177:             elif signal_type == 'S' and dif[i-1] >= dea[i-1] and dif[i] < dea[i]:
178:                 reasons.append('MACD死叉: DIF下穿DEA')
179:         # 辅助reason: DIF拐头
180:         if dif[i] is not None and dif[i-1] is not None and dif[i-2] is not None:
181:             if signal_type == 'B' and dif[i-2] > dif[i-1] and dif[i] > dif[i-1]:
182:                 reasons.append(f'DIF底拐头: {dif[i-1]:.4f}→{dif[i]:.4f}')
183:             elif signal_type == 'S' and dif[i-2] < dif[i-1] and dif[i] < dif[i-1]:
184:                 reasons.append(f'DIF顶拐头: {dif[i-1]:.4f}→{dif[i]:.4f}')
185:         # 辅助reason: KDJ交叉
186:         if k_vals[i] is not None and d_vals[i] is not None and k_vals[i-1] is not None and d_vals[i-1] is not None:
187:             if signal_type == 'B' and k_vals[i-1] <= d_vals[i-1] and k_vals[i] > d_vals[i]:
188:                 reasons.append('KDJ金叉: K上穿D')
189:             elif signal_type == 'S' and k_vals[i-1] >= d_vals[i-1] and k_vals[i] < d_vals[i]:
190:                 reasons.append('KDJ死叉: K下穿D')
191:         signals.append({
192:             'date': date,
193:             'type': signal_type,
194:             'price': klines[i]['close'],
195:             'reasons': reasons,
196:             'macd': round(macd[i], 4) if macd[i] is not None else None,
197:             'dif': round(dif[i], 4) if dif[i] is not None else None,
198:             'dea': round(dea[i], 4) if dea[i] is not None else None,
199:             'kdj_k': round(k_vals[i], 2) if k_vals[i] is not None else None,
200:             'kdj_d': round(d_vals[i], 2) if d_vals[i] is not None else None,
201:             'kdj_j': round(j_vals[i], 2) if j_vals[i] is not None else None,
202:         })
203:     return signals, dif, dea, macd, ma5, ma20, k_vals, d_vals, j_vals, support, resistance, trend
204: async def _fetch_trade_records(stock_code: str):
205:     """从东方财富获取该股票的交易记录"""
206:     if not MX_APIKEY:
207:         return []
208:     try:
209:         client = _get_http_client()
210:         resp = await client.post(
211:             f"{MX_API_URL}/api/claw/mockTrading/orders",
212:             json={'fltOrderDrt': 0, 'fltOrderStatus': 0},
213:             headers={"apikey": MX_APIKEY, "Content-Type": "application/json; charset=UTF-8"},
214:         )
215:         data = resp.json()
216:     except Exception:
217:         logger.debug(f"_fetch_trade_records failed", exc_info=True)
218:         return []
219:     if str(data.get('code', '')) not in ('0', '200'):
220:         return []
221:     orders = data.get('data', {}).get('orders') or []
222:     records = []
223:     for o in orders:
224:         if o.get('secCode') != stock_code:
225:             continue
226:         price_dec = o.get('priceDec', 2)
227:         trade_price = o.get('tradePrice')
228:         if trade_price:
229:             trade_price = trade_price / (10 ** price_dec)
230:         order_price = o.get('price', 0) / (10 ** price_dec)
231:         # 只记录已成交的
232:         if o.get('status') in (4, 3):  # 已成、部成
233:             records.append({
234:                 'date': '',  # 需要从时间戳转换
235:                 'type': 'B' if o.get('drt') == 1 else 'S',
236:                 'price': trade_price or order_price,
237:                 'quantity': o.get('tradeCount', 0),
238:                 'order_id': o.get('id', ''),
239:             })
240:     return records
