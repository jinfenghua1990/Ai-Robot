12: // EMA 计算（纯函数）
13: export const calcEma = (arr, n) => {
14:   const k = 2 / (n + 1);
15:   let prev = arr[0];
16:   return arr.map((v, i) => (prev = i === 0 ? v : v * k + prev * (1 - k)));
17: };
18: // 实时 MACD：基于当日分时价格序列计算（参数 idPrices 显式传入）
19: export const calcIntradayMacd = (idPrices) => {
20:   if (idPrices.length < 26) return null;
21:   const e12 = calcEma(idPrices, 12);
22:   const e26 = calcEma(idPrices, 26);
23:   const dif = e12.map((v, i) => v - e26[i]);
24:   const dea = calcEma(dif, 9);
25:   const n = dif.length;
26:   return { dif: dif[n - 1], dea: dea[n - 1], macd: 2 * (dif[n - 1] - dea[n - 1]) };
27: };
28: // 实时 KDJ：基于当日分时价格序列计算（参数 idPrices 显式传入）
29: export const calcIntradayKdj = (idPrices) => {
30:   const N = 9;
31:   if (idPrices.length < N) return null;
32:   let k = 50, d = 50;
33:   for (let i = N - 1; i < idPrices.length; i++) {
34:     const win = idPrices.slice(i - N + 1, i + 1);
35:     const hh = Math.max(...win), ll = Math.min(...win);
36:     const rsv = hh === ll ? 50 : ((idPrices[i] - ll) / (hh - ll)) * 100;
37:     k = (2 / 3) * k + (1 / 3) * rsv;
38:     d = (2 / 3) * d + (1 / 3) * k;
39:   }
40:   return { k, d, j: 3 * k - 2 * d };
41: };
