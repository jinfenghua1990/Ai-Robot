172:                     f"PE(TTM)≈{valuation.get('pe_ttm') if valuation.get('pe_ttm') != '—' else '—'}。"
173:                 )
174:         inst = f10.get_institutional(code)
175:         if isinstance(inst, dict):
176:             institutional["fund_holding_ratio"] = _as_str(
177:                 inst.get("持仓占实际流通A股比例") or inst.get("持仓比例")
178:             )
179:             institutional["fund_count"] = _as_str(inst.get("机构数量"))
180:     # --- 评级（透明规则）---
181:     rating, confidence, rating_note = _derive_rating(price, target_price_val, feat)
182:     if not f10.is_configured():
