124: def fetch_nextday_plan(db, d, lim=20):
125:     """多信号交叉打分：龙头活跃 ∪ 当日强势(>=5%) ，综合价格/资金/阶段/研究"""
126:     sql = text("""
127:         WITH pool AS (
128:             SELECT ts_code, name FROM leader_lifecycle
129:             WHERE trade_date = :d AND stage IN ('加速', '主升', '启动')
130:             UNION
131:             SELECT ts_code, name FROM stock_flow
132:             WHERE trade_date = :d AND price_chg >= 5
133:         )
134:         SELECT p.ts_code, p.name,
135:                sf.price, sf.price_chg,
136:                round(sf.main_force_inflow::numeric / 1e8, 2) AS main_net_yi,
137:                ll.stage, ll.strength, ll.consecutive_days,
138:                (SELECT count(*) FROM ai_analysis_cache a WHERE a.stock_code = p.ts_code) AS has_ai,
139:                (SELECT count(*) FROM stock_news_search n WHERE n.stock_code = p.ts_code) AS has_news
140:         FROM pool p
141:         LEFT JOIN stock_flow sf ON sf.ts_code = p.ts_code AND sf.trade_date = :d
142:         LEFT JOIN leader_lifecycle ll ON ll.ts_code = p.ts_code AND ll.trade_date = :d
143:     """)
144:     rows = [dict(r) for r in db.execute(sql, {"d": d}).mappings().all()]
145:     scored = []
146:     for r in rows:
147:         pc = _fnum(r.get("price_chg"), 2)
148:         mn = _fnum(r.get("main_net_yi"), 2)
149:         stage = r.get("stage")
150:         strength = _fnum(r.get("strength"), 1)
151:         has_research = (int(r.get("has_ai") or 0) + int(r.get("has_news") or 0)) > 0
152:         stage_bonus = {"主升": 30, "加速": 22, "启动": 14}.get(stage, 0)
153:         research_bonus = 12 if has_research else 0
154:         # 价格贡献(封顶20) + 资金贡献(封顶25) + 阶段 + 研究
155:         score = min(pc, 20) + min(max(mn, 0) * 2, 25) + stage_bonus + research_bonus
156:         r["score"] = round(score, 1)
157:         r["has_research"] = has_research
158:         scored.append(r)
159:     scored.sort(key=lambda x: x["score"], reverse=True)
160:     return scored[:lim]
