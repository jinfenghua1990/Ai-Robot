 37:     # longer supported for Gemini Code Assist for individuals"），故已从订阅接入中移除。
 38:     "deepseek": {"bins": ["deepseek", "codewhale"], "delivery": "arg",
 39:                  "build_args": lambda _: ["exec", "--auto"], "env": {}},
 40:     # Codex：codex exec 默认纯文本（进度走 stderr、最终答案走 stdout）；`-` 从 stdin 读提示词，
 41:     # --skip-git-repo-check 跳过 git 检查（我们在临时目录跑）。复用本机 `codex login` 的订阅登录态。
 42:     "codex": {"bins": ["codex"], "delivery": "stdin",
 43:               "build_args": lambda _: ["exec", "--skip-git-repo-check", "-"], "env": {}},
 44: }
 45: _EXTRA_PATH_DIRS = [
 46:     "/opt/homebrew/bin", "/usr/local/bin", "/usr/bin",
 47:     str(Path.home() / ".local/bin"), str(Path.home() / ".npm-global/bin"),
 48:     str(Path.home() / ".bun/bin"), str(Path.home() / ".deno/bin"),
 49:     str(Path.home() / ".yarn/bin"),
 50: ]
 51: _CLI_TIMEOUT_S = 300  # 子进程兜底超时（秒）
 52: _MAX_ARG_BYTES = 110_000  # 位置参数投递的提示词字节上限
 53: class CliUnavailable(RuntimeError):
 54:     """本机未检测到对应 CLI（未安装 / 不在 PATH）。"""
 55: def _find_bin(name: str) -> str | None:
 56:     hit = shutil.which(name)
 57:     if hit:
 58:         return hit
 59:     for d in _EXTRA_PATH_DIRS:
 60:         p = Path(d) / name
 61:         if p.is_file() and os.access(p, os.X_OK):
 62:             return str(p)
 63:     return None
 64: def detect_cli(kind: str) -> str | None:
 65:     """返回某订阅 CLI 的可执行路径，未装则 None。"""
 66:     d = _CLI_DEFS.get(kind)
 67:     if not d:
 68:         return None
 69:     for b in d["bins"]:
 70:         found = _find_bin(b)
 71:         if found:
 72:             return found
 73:     return None
 74: def supported_kinds() -> list[str]:
 75:     return list(_CLI_DEFS.keys())
 76: def run_cli(kind: str, system_prompt: str, user_prompt: str) -> str:
 77:     """起 CLI 子进程，一次性作答，返回纯文本 stdout。失败抛异常。"""
 78:     d = _CLI_DEFS.get(kind)
 79:     bin_path = detect_cli(kind)
 80:     if not d or not bin_path:
 81:         raise CliUnavailable(
 82:             f"未检测到「{kind}」对应的本机命令。请先安装并登录该 CLI，或改用「API 接入」。"
 83:         )
 84:     combined = f"{system_prompt}\n\n{user_prompt}"
 85:     env = {**os.environ, **d.get("env", {})}
 86:     tmpdir = tempfile.mkdtemp(prefix="research-cli-")
 87:     try:
 88:         stdin_payload: str | None
 89:         if d["delivery"] == "system-file":
 90:             sys_file = str(Path(tmpdir) / "system.txt")
 91:             Path(sys_file).write_text(system_prompt, encoding="utf-8")
 92:             args = d["build_args"](sys_file)
 93:             stdin_payload = user_prompt
 94:         elif d["delivery"] == "stdin":
 95:             args = d["build_args"](None)
 96:             stdin_payload = combined
 97:         else:  # arg
 98:             if len(combined.encode("utf-8")) > _MAX_ARG_BYTES:
 99:                 raise RuntimeError(f"提示词过长，超过 {kind} 的命令行参数上限，请改用 Claude / Qwen 或 API 接入。")
100:             args = [*d["build_args"](None), combined]
101:             stdin_payload = None
102:         try:
103:             proc = subprocess.run(
104:                 [bin_path, *args],
105:                 input=stdin_payload,
106:                 capture_output=True,
107:                 text=True,
108:                 cwd=tmpdir,
109:                 env=env,
110:                 timeout=_CLI_TIMEOUT_S,
111:             )
112:         except subprocess.TimeoutExpired as e:
113:             raise RuntimeError(f"{kind} 生成超时（>{_CLI_TIMEOUT_S}s）") from e
114:         out = (proc.stdout or "").strip()
115:         if proc.returncode != 0 and not out:
116:             err = (proc.stderr or "").strip()[:300]
117:             raise RuntimeError(f"{kind} 退出码 {proc.returncode}{'：' + err if err else ''}")
118:         return out
119:     finally:
120:         shutil.rmtree(tmpdir, ignore_errors=True)
121: def run_cli_stream(kind: str, system_prompt: str, user_prompt: str):
122:     """流式版：起 CLI 子进程，stdout 边出边 yield 纯文本块。失败抛异常。"""
123:     d = _CLI_DEFS.get(kind)
124:     bin_path = detect_cli(kind)
125:     if not d or not bin_path:
126:         raise CliUnavailable(
127:             f"未检测到「{kind}」对应的本机命令。请先安装并登录该 CLI，或改用「API 接入」。"
128:         )
129:     combined = f"{system_prompt}\n\n{user_prompt}"
130:     env = {**os.environ, **d.get("env", {})}
131:     tmpdir = tempfile.mkdtemp(prefix="research-cli-")
132:     proc = None
133:     try:
134:         if d["delivery"] == "system-file":
135:             sys_file = str(Path(tmpdir) / "system.txt")
136:             Path(sys_file).write_text(system_prompt, encoding="utf-8")
137:             args = d["build_args"](sys_file)
138:             stdin_payload = user_prompt
139:         elif d["delivery"] == "stdin":
140:             args = d["build_args"](None)
141:             stdin_payload = combined
142:         else:  # arg
143:             if len(combined.encode("utf-8")) > _MAX_ARG_BYTES:
144:                 raise RuntimeError(f"提示词过长，超过 {kind} 的命令行参数上限，请改用 Claude / Qwen 或 API 接入。")
145:             args = [*d["build_args"](None), combined]
146:             stdin_payload = None
147:         proc = subprocess.Popen(
148:             [bin_path, *args], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
149:             stderr=subprocess.DEVNULL, cwd=tmpdir, env=env, text=True, bufsize=1,
150:         )
151:         if stdin_payload is not None:
152:             try:
153:                 proc.stdin.write(stdin_payload)
154:             except BrokenPipeError:
155:                 pass
156:         if proc.stdin:
157:             proc.stdin.close()
158:         # 读线程 + 队列：让 _CLI_TIMEOUT_S 约束整个流式过程。
159:         # 直接 `for line in proc.stdout` 是无限期阻塞读——CLI 挂起时永远走不到
160:         # proc.wait(timeout=...)，超时形同虚设，子进程会常驻堆积。
161:         q: queue.Queue = queue.Queue()
162:         def _pump(stdout=proc.stdout):
163:             try:
164:                 for ln in stdout:
165:                     q.put(ln)
166:             except Exception:
167:                 logger.debug("cli_runtime: stdout read failed", exc_info=False)
168:             finally:
169:                 q.put(None)  # EOF 哨兵
170:         threading.Thread(target=_pump, daemon=True).start()
171:         deadline = time.monotonic() + _CLI_TIMEOUT_S
172:         while True:
173:             remaining = deadline - time.monotonic()
174:             if remaining <= 0:
175:                 raise RuntimeError(f"{kind} 生成超时（>{_CLI_TIMEOUT_S}s）")
176:             try:
177:                 line = q.get(timeout=min(remaining, 1.0))
178:             except queue.Empty:
179:                 continue
180:             if line is None:
181:                 break
182:             yield line
183:         try:
184:             rc = proc.wait(timeout=10)
185:         except subprocess.TimeoutExpired as e:
186:             raise RuntimeError(f"{kind} 输出已结束但进程未退出") from e
187:         if rc != 0:
188:             raise RuntimeError(f"{kind} 退出码 {rc}")
189:     finally:
190:         if proc and proc.poll() is None:
191:             proc.kill()
192:         shutil.rmtree(tmpdir, ignore_errors=True)
