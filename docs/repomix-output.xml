  1: """研报中心 consumer：消费 analysis_requests 队列，生成报告落 PG
  2: 数据流：
  3:   用户提交 request(pending)
  4:     → analysis_consumer.process_pending() 轮询
  5:     → 市场数据读 PG 已有盘后表（stock_features_daily / stock_daily_kline / stock_money_flow_detail）
  6:     → F10(财务/评级/机构) 调 f10_provider 免费源拉取（Tushare 财务/机构 + 东方财富评级，结果缓存 PG；失败优雅降级为"—"）
  7:     → 组装完整报告 dict → 写 analysis_reports + 改 request=completed + 写通知
  8: 这样：数据全部落 PG（多用户复用/可查询），且生成自动化（无需每次手动拉）。
  9: """
 10: import json
 11: import logging
 12: from datetime import datetime, date
 13: from typing import Optional, Dict, Any
 14: logger = logging.getLogger(__name__)
 15: from sqlalchemy import select
 16: from db.connection import SessionLocal
 17: from db.models import (
 18:     AnalysisRequest, AnalysisReport, StockFeaturesDaily,
 19:     StockDailyKline, StockMoneyFlowDetail,
 20: )
 21: from services import f10_provider as f10
 22: logger = logging.getLogger("analysis_consumer")
 23: # ---------- 工具 ----------
 24: def _to_ts_code(code: str) -> str:
 25:     """纯数字代码 → tushare 风格 ts_code（002245 -> 002245.SZ）。"""
 26:     c = code.strip()
 27:     if "." in c:
 28:         return c
 29:     if c[0] in ("6", "9") or (c.startswith("688")):
 30:         return f"{c}.SH"
 31:     if c.startswith("8") or c.startswith("4"):
 32:         return f"{c}.BJ"
 33:     return f"{c}.SZ"
 34: def _yuan_to_yi(v) -> Optional[float]:
 35:     try:
 36:         return float(v) / 1e8
 37:     except (TypeError, ValueError):
 38:         return None
 39: def _fmt_yi(v, sign=True) -> str:
 40:     x = _yuan_to_yi(v)
 41:     if x is None:
 42:         return "—"
 43:     return (f"{x:+.2f}亿" if sign else f"{x:.2f}亿")
 44: def _mmdd(d) -> str:
 45:     if isinstance(d, (datetime, date)):
 46:         return d.strftime("%m-%d")
 47:     s = str(d)
 48:     return f"{s[4:6]}-{s[6:8]}" if len(s) >= 8 else s
 49: # ---------- 报告组装（来自 PG）----------
 50: def build_report_from_pg(stock_code: str, stock_name: str = "", source: str = "tdx") -> Dict[str, Any]:
 51:     code = stock_code.strip()
 52:     ts_code = _to_ts_code(code)
 53:     name = stock_name or code
 54:     with SessionLocal() as db:
 55:         feat = db.execute(
 56:             select(StockFeaturesDaily).where(StockFeaturesDaily.stock_code == code)
 57:             .order_by(StockFeaturesDaily.trade_date.desc()).limit(1)
 58:         ).scalars().first()
 59:         klines = db.execute(
 60:             select(StockDailyKline).where(StockDailyKline.ts_code == ts_code)
 61:             .order_by(StockDailyKline.trade_date.desc()).limit(60)
 62:         ).scalars().all()
 63:         klines = list(reversed(klines))  # 升序，便于区间计算
 64:         flows = db.execute(
 65:             select(StockMoneyFlowDetail).where(StockMoneyFlowDetail.ts_code == ts_code)
 66:             .order_by(StockMoneyFlowDetail.trade_date.desc()).limit(15)
 67:         ).scalars().all()
 68:         flows = list(reversed(flows))  # 升序
 69:     if not feat and not klines:
 70:         raise ValueError(f"PG 中无 {code} 的市场数据（可能未纳入每日采集）")
 71:     # --- 行情 ---
 72:     last_k = klines[-1] if klines else None
 73:     price = float(feat.close) if feat and feat.close is not None else (float(last_k.close) if last_k else 0)
 74:     change_pct = float(last_k.pct_chg) if last_k and last_k.pct_chg is not None else 0.0
 75:     high = float(last_k.high) if last_k else price
 76:     low = float(last_k.low) if last_k else price
 77:     vol = int(last_k.volume) if last_k and last_k.volume else 0
 78:     amount = float(last_k.amount) if last_k and last_k.amount else 0.0
 79:     quotes = {
 80:         "price": round(price, 2),
 81:         "change_pct": round(change_pct, 2),
 82:         "high": round(high, 2),
 83:         "low": round(low, 2),
 84:         "volume": f"{vol/1e4:.0f}万手" if vol else "—",
 85:         "amount": f"{amount/1e8:.2f}亿" if amount else "—",
 86:         "turnover_rate": round(float(feat_high_turnover(flows)), 2) if flows else 0.0,
 87:     }
 88:     # --- K线区间 ---
 89:     closes = [float(k.close) for k in klines if k.close is not None]
 90:     highs = [float(k.high) for k in klines if k.high is not None]
