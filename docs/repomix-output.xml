391:                     db.add(record)
392:                 record.total_count = (record.total_count or 0) + 1
393:                 if src in outliers:
394:                     record.outlier_count = (record.outlier_count or 0) + 1
395:                 # 更新平均偏差
396:                 deviation = abs(val - median) / abs(median) * 100 if median else 0
397:                 old_avg = float(record.avg_deviation or 0)
398:                 old_count = (record.total_count or 1) - 1
399:                 if old_count > 0:
400:                     record.avg_deviation = (old_avg * old_count + deviation) / record.total_count
401:                 else:
402:                     record.avg_deviation = deviation
403:                 # 更新可靠性评分
404:                 outlier_rate = record.outlier_count / record.total_count if record.total_count else 0
405:                 record.reliability_score = max(0, 100 - outlier_rate * 100 - float(record.avg_deviation or 0) * 0.5)
406:             db.commit()
