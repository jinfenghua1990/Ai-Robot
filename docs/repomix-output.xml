381: def daily_update():
382:     """更新所有 active 跟踪记录的当日行情 + BS 信号检查"""
383:     updated = []
384:     exited = []
385:     expired = []
386:     with get_db_session() as db:
387:         active_trackers = (
388:             db.query(StrategyTrack).filter(StrategyTrack.status == "active").all()
389:         )
390:         for t in active_trackers:
391:             try:
392:                 # 1. 找到需要更新的交易日（trade_date > pool_date 且未在 daily 中）
393:                 existing_dates_rows = (
394:                     db.query(StrategyTrackDaily.trade_date)
395:                     .filter(StrategyTrackDaily.tracker_id == t.id)
396:                     .all()
397:                 )
398:                 existing_dates = {row[0] for row in existing_dates_rows}
399:                 existing_count = len(existing_dates)
400:                 candidates = (
401:                     db.query(StockDailyKline)
402:                     .filter(StockDailyKline.ts_code == t.ts_code)
403:                     .filter(StockDailyKline.trade_date > t.pool_date)
404:                     .filter(
405:                         ~StockDailyKline.trade_date.in_(existing_dates)
406:                         if existing_dates
407:                         else True
408:                     )
409:                     .order_by(StockDailyKline.trade_date.asc())
410:                     .all()
411:                 )
412:                 if not candidates:
413:                     continue
414:                 # 2. 计算 BS 信号（基于截止最后候选日的最近 150 条 K 线）
415:                 last_trade_date = candidates[-1].trade_date
416:                 bs_by_date = _calc_bs_signals_for_klines(db, t.ts_code, last_trade_date)
417:                 # 3. 逐日插入 daily 记录
418:                 pool_close = (
419:                     float(t.pool_close) if t.pool_close is not None else None
420:                 )
421:                 last_inserted_day_n = existing_count
422:                 last_inserted_close = None
423:                 last_inserted_trade_date = None
424:                 last_inserted_pct = None
425:                 last_inserted_daily_chg = None
426:                 last_inserted_bs_signal = None
427:                 last_inserted_bs_reason = None
428:                 new_exited = False
429:                 new_expired = False
430:                 cur_max = (
431:                     float(t.max_return_pct)
432:                     if t.max_return_pct is not None
433:                     else None
434:                 )
435:                 cur_min = (
436:                     float(t.min_return_pct)
437:                     if t.min_return_pct is not None
438:                     else None
439:                 )
440:                 for k in candidates:
441:                     last_inserted_day_n += 1
442:                     close = float(k.close) if k.close is not None else 0.0
443:                     daily_chg = (
444:                         float(k.pct_chg) if k.pct_chg is not None else None
445:                     )
446:                     cum_pct = None
447:                     if pool_close and pool_close > 0:
448:                         cum_pct = round((close - pool_close) / pool_close * 100, 2)
449:                     kdate_str = (
450:                         k.trade_date.isoformat() if k.trade_date else None
451:                     )
452:                     sig = bs_by_date.get(kdate_str)
453:                     bs_signal = sig.get("type") if sig else None
454:                     bs_reason = None
455:                     if sig and sig.get("reasons"):
456:                         bs_reason = "; ".join(sig["reasons"])
457:                     daily_row = StrategyTrackDaily(
458:                         tracker_id=t.id,
459:                         trade_date=k.trade_date,
460:                         day_n=last_inserted_day_n,
461:                         open=float(k.open) if k.open is not None else None,
462:                         high=float(k.high) if k.high is not None else None,
463:                         low=float(k.low) if k.low is not None else None,
464:                         close=close,
465:                         pct_chg=daily_chg,
466:                         cum_pct=cum_pct,
467:                         volume=k.volume,
468:                         amount=float(k.amount) if k.amount is not None else None,
469:                         main_force_inflow=(
470:                             float(k.main_force_inflow)
471:                             if k.main_force_inflow is not None
472:                             else None
473:                         ),
474:                         bs_signal=bs_signal,
475:                         bs_reason=bs_reason,
476:                     )
477:                     db.add(daily_row)
478:                     if cum_pct is not None:
479:                         if cur_max is None or cum_pct > cur_max:
480:                             cur_max = cum_pct
481:                         if cur_min is None or cum_pct < cur_min:
482:                             cur_min = cum_pct
483:                     last_inserted_close = close
484:                     last_inserted_trade_date = k.trade_date
485:                     last_inserted_pct = cum_pct
486:                     last_inserted_daily_chg = daily_chg
487:                     last_inserted_bs_signal = bs_signal
488:                     last_inserted_bs_reason = bs_reason
489:                     # S 点撤离
490:                     if bs_signal == "S":
491:                         new_exited = True
492:                         break
493:                     # 满 track_days 到期
494:                     if last_inserted_day_n >= (t.track_days or 20):
495:                         new_expired = True
496:                         break
497:                 if last_inserted_day_n == existing_count:
498:                     # 没有新数据可插入
499:                     db.rollback()
500:                     continue
501:                 # 更新主表
502:                 t.latest_day = last_inserted_day_n
503:                 t.latest_trade_date = last_inserted_trade_date
504:                 t.latest_close = last_inserted_close
505:                 t.latest_pct = last_inserted_pct
506:                 t.latest_daily_chg = last_inserted_daily_chg
507:                 t.latest_bs_signal = last_inserted_bs_signal
508:                 t.latest_bs_reason = last_inserted_bs_reason
509:                 t.max_return_pct = cur_max
510:                 t.min_return_pct = cur_min
511:                 if new_exited:
512:                     t.status = "exited"
513:                     t.exit_date = last_inserted_trade_date
514:                     t.exit_reason = "BS_S_SIGNAL"
515:                     t.exit_price = last_inserted_close
516:                     t.exit_return_pct = last_inserted_pct
517:                     exited.append(
518:                         {
519:                             "ts_code": t.ts_code,
520:                             "name": t.name,
521:                             "reason": "BS_S_SIGNAL",
522:                             "return_pct": last_inserted_pct,
523:                             "exit_date": (
524:                                 last_inserted_trade_date.isoformat()
525:                                 if last_inserted_trade_date
526:                                 else None
527:                             ),
528:                         }
529:                     )
530:                 elif new_expired:
531:                     t.status = "expired"
532:                     t.exit_date = last_inserted_trade_date
533:                     t.exit_reason = "MAX_DAYS_REACHED"
534:                     t.exit_price = last_inserted_close
535:                     t.exit_return_pct = last_inserted_pct
536:                     expired.append(
537:                         {
538:                             "ts_code": t.ts_code,
539:                             "name": t.name,
540:                             "reason": "MAX_DAYS_REACHED",
541:                             "return_pct": last_inserted_pct,
542:                             "exit_date": (
543:                                 last_inserted_trade_date.isoformat()
544:                                 if last_inserted_trade_date
545:                                 else None
546:                             ),
547:                         }
548:                     )
549:                 updated.append(
550:                     {
551:                         "ts_code": t.ts_code,
552:                         "name": t.name,
553:                         "day_n": last_inserted_day_n,
554:                         "close": last_inserted_close,
555:                         "bs_signal": last_inserted_bs_signal,
556:                     }
557:                 )
558:                 db.commit()
559:             except Exception as e:
560:                 logger.exception(
561:                     f"[strategy_track] daily-update error for {t.ts_code}: {e}"
562:                 )
563:                 db.rollback()
564:                 continue
565:     return {
566:         "updated": updated,
567:         "exited": exited,
