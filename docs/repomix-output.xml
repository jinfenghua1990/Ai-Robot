 77: const ACTION_STYLE = {
 78:   buy:  { emoji: '🟢', label: '寻找买点', bg: '#15803d', short: '买' },
 79:   hold: { emoji: '🔵', label: '坚定持有', bg: '#0ea5e9', short: '持' },
 80:   sell: { emoji: '🔴', label: '卖出警报', bg: '#dc2626', short: '卖' },
 81:   skip: { emoji: '⚫', label: '放弃参与', bg: '#475569', short: '弃' },
 82: };
 83: const _lastFilledDay = (lc) => {
 84:   // 找 lifecycle_data 里最大的 d{n}
 85:   if (!lc || typeof lc !== 'object') return null;
 86:   let best = null, bestN = 0;
 87:   for (const k of Object.keys(lc)) {
 88:     if (k.startsWith('d')) {
 89:       const n = parseInt(k.slice(1), 10);
 90:       if (!isNaN(n) && n > bestN) { bestN = n; best = lc[k]; }
 91:     }
 92:   }
 93:   return best ? { ...best, _n: bestN } : null;
 94: };
 95: const _classifyAction = (row) => {
 96:   const lc = row.lifecycle_data || {};
 97:   const last = _lastFilledDay(lc);
 98:   if (!last) return 'skip';
 99:   const stage = last.price_stage || '震荡';
100:   const openPrem = Number(last.open_premium || 0);
101:   const outcome = row.final_outcome || '未结束';
102:   // 算近3天累计涨跌(用于趋势判定,避免"最新一格偏多但近3天暴跌"误判)
103:   const n = last._n;
104:   const recent3 = [0, 1, 2].map(i => lc[`d${n - i}`]).filter(d => d);
105:   const recent3Pct = recent3.map(d => Number(d.pct_chg ?? d.win_rate_impact ?? 0));
106:   const recent3Sum = recent3Pct.reduce((a, b) => a + b, 0);
107:   const recent3AllDown = recent3Pct.length >= 3 && recent3Pct.every(p => p < 0);
108:   // 已 final 的走弱/退潮 → 卖出 / 放弃
109:   if (outcome === 'A杀退潮') return 'sell';
110:   if (outcome === '弱势回调') return 'sell';
111:   // 已 final 的大妖股 / 高位震荡 → 持有 (但要警惕近期走弱)
112:   if (outcome === '大妖股' || outcome === '高位震荡') {
113:     if (stage === '跌停A杀' || stage === '砸盘' || stage === '分歧' || stage === '偏空') return 'sell';
114:     if (recent3AllDown && recent3Sum <= -5) return 'sell';  // 高位但近3天暴跌 = 退潮信号
115:     return 'hold';
116:   }
117:   if (outcome === '横盘') {
118:     if (stage === '连板' || stage === '晋级' || stage === '偏多') {
119:       if (recent3AllDown && recent3Sum <= -5) return 'sell';
