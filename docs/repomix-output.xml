591:       minHeight: embedded ? 'auto' : '100vh'
592:     }}>
593:       {/* Header */}
594:       <Header
595:         tradeDate={data?.trade_date}
596:         generatedAt={data?.generated_at}
597:         onRun={handleRun}
598:         onRefresh={fetchData}
599:         running={running}
600:         loading={loading}
601:       />
602:       {/* Loading / Error */}
603:       {loading && (
604:         <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '80px 0' }}>
605:           <span className="animate-spin" style={{ fontSize: 32, color: C.blue, display: 'inline-block' }}>⏳</span>
606:           <span style={{ marginLeft: 8, color: C.textDim, fontSize: 14 }}>加载波浪分析数据...</span>
607:         </div>
608:       )}
609:       {error && !loading && (
610:         <div style={{
611:           background: 'rgba(220,38,38,0.05)', border: `1px solid rgba(220,38,38,0.15)`,
612:           borderRadius: 12, padding: '32px 16px', textAlign: 'center'
613:         }}>
614:           <span style={{ fontSize: 32, color: C.red, margin: '0 auto 8px', display: 'inline-block' }}>⚠️</span>
615:           <p style={{ fontSize: 14, color: C.red }}>{error}</p>
616:           <button
617:             onClick={fetchData}
618:             style={{
619:               marginTop: 12, padding: '6px 16px',
620:               background: 'rgba(220,38,38,0.1)', border: 'none',
621:               borderRadius: 6, color: C.red, fontSize: 12, fontWeight: 600,
622:               cursor: 'pointer'
623:             }}
624:           >
625:             重试
626:           </button>
627:         </div>
628:       )}
629:       {!loading && !error && data && signals.length > 0 && (
630:         <>
631:           {/* Index overview grid */}
632:           <IndexGrid signals={signals} />
633:           {/* Decision card */}
