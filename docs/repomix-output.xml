  1: """
  2: BS策略每日预计算服务
  3: - 盘后定时跑最近 N 条 BSBacktestResult 策略，结果落 bs_daily_scan 表
  4: - 前端 /api/bs-screener/today 读取预计算结果，消除现场全市场扫描
  5: - 防重复跑：同 trade_date × backtest_id 只跑一次（唯一约束）
  6: """
  7: import sys
  8: import os
  9: import json
 10: import logging
 11: from datetime import datetime
 12: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 13: from db.session import get_db_session
 14: from db.models import BSBacktestResult, BSDailyScan
 15: logger = logging.getLogger(__name__)
 16: # 每天预计算的最近回测策略数量（与前端 StrategyCenterPage 的 limit=5 对齐，多取5个留余量）
 17: PRECOMPUTE_TOP_N = 10
 18: async def precompute_bs_strategies(target_date=None) -> dict:
 19:     """跑最近 N 条 BSBacktestResult 策略，结果落 bs_daily_scan 表。
 20:     Args:
 21:         target_date: 指定日期（None=今天）
 22:     Returns:
 23:         {'success': int, 'failed': int, 'skipped': int, 'details': [...]}
 24:     """
 25:     from api.bs_screener import _execute_bs_scan_core
 26:     if target_date is None:
 27:         target_date = datetime.now().date()
 28:     elif isinstance(target_date, str):
 29:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
 30:     with get_db_session() as db:
 31:         stats = {'success': 0, 'failed': 0, 'skipped': 0, 'details': []}
 32:         try:
 33:             backtests = db.query(BSBacktestResult).order_by(
 34:                 BSBacktestResult.run_at.desc()
 35:             ).limit(PRECOMPUTE_TOP_N).all()
 36:             if not backtests:
 37:                 logger.info('[bs-precompute] 无 BSBacktestResult 记录，跳过')
 38:                 return stats
 39:             for bt in backtests:
 40:                 exists = db.query(BSDailyScan).filter(
 41:                     BSDailyScan.trade_date == target_date,
 42:                     BSDailyScan.backtest_id == bt.id,
 43:                 ).first()
 44:                 if exists:
 45:                     stats['skipped'] += 1
 46:                     stats['details'].append({
 47:                         'backtest_id': bt.id, 'name': bt.name,
 48:                         'status': 'skipped', 'hits': exists.hit_count,
 49:                     })
 50:                     continue
 51:                 start = datetime.now()
 52:                 try:
 53:                     result = await _execute_bs_scan_core(
 54:                         db,
 55:                         atr_period=bt.atr_period or 10,
 56:                         atr_multiplier=float(bt.atr_multiplier or 1.0),
 57:                         scan_limit=9999,
 58:                         sector='',
 59:                         signal_type='B',
 60:                         volume_filter=bool(bt.volume_filter),
 61:                         ma20_filter=bool(bt.ma20_filter),
 62:                         ma60_trend=bool(getattr(bt, 'ma60_trend', False) or False),
 63:                         rsi_filter=bool(getattr(bt, 'rsi_filter', False) or False),
 64:                         strong_volume=bool(getattr(bt, 'strong_volume', False) or False),
 65:                         macd_filter=bool(getattr(bt, 'macd_filter', False) or False),
 66:                         kdj_filter=bool(getattr(bt, 'kdj_filter', False) or False),
 67:                         rsi_lower=int(getattr(bt, 'rsi_lower', 30) or 30),
 68:                         rsi_upper=int(getattr(bt, 'rsi_upper', 70) or 70),
 69:                         dimension=bt.dimension or '',
 70:                     )
 71:                     signals = result.get('signals', [])
 72:                     summary = result.get('summary', {})
 73:                     row = BSDailyScan(
 74:                         trade_date=target_date,
 75:                         backtest_id=bt.id,
 76:                         strategy_name=bt.name or f'BS-{bt.id}',
 77:                         dimension=bt.dimension or '',
 78:                         signals_json=json.dumps(signals, ensure_ascii=False),
 79:                         summary_json=json.dumps(summary, ensure_ascii=False),
 80:                         scanned=result.get('scanned', 0),
 81:                         hit_count=len(signals),
 82:                     )
 83:                     db.add(row)
 84:                     db.commit()
 85:                     dur = (datetime.now() - start).total_seconds()
 86:                     stats['success'] += 1
 87:                     stats['details'].append({
 88:                         'backtest_id': bt.id, 'name': bt.name,
 89:                         'status': 'success', 'hits': len(signals),
 90:                         'scanned': result.get('scanned', 0), 'dur_s': round(dur, 1),
 91:                     })
 92:                     logger.info(
 93:                         f'[bs-precompute] bt={bt.id}({bt.name}) dim={bt.dimension} '
 94:                         f'hits={len(signals)} scanned={result.get("scanned", 0)} dur={dur:.1f}s'
 95:                     )
 96:                 except Exception as e:
 97:                     db.rollback()
 98:                     stats['failed'] += 1
 99:                     stats['details'].append({
100:                         'backtest_id': bt.id, 'name': bt.name,
101:                         'status': 'failed', 'error': str(e)[:200],
102:                     })
103:                     logger.exception(f'[bs-precompute] bt={bt.id}({bt.name}) failed: {e}')
104:         except Exception as e:
105:             logger.exception(f'[bs-precompute] outer error: {e}')
106:     logger.info(
107:         f'[bs-precompute] {target_date} done: '
108:         f"success={stats['success']} failed={stats['failed']} skipped={stats['skipped']}"
109:     )
110:     return stats
111: if __name__ == '__main__':
112:     import asyncio
113:     logging.basicConfig(level=logging.INFO, format='%(asctime)s [%(levelname)s] %(message)s')
114:     result = asyncio.run(precompute_bs_strategies())
115:     logger.info(json.dumps(result, ensure_ascii=False, indent=2))
</file>

