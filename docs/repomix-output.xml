  1: """
  2: 资金流向数据中转层（Money Flow Middleman）
  3: - 盘中每分钟/每 5 分钟抓取外部概念/行业板块资金流
  4: - 三道防错：网络容错 → 前向填充(FFill) → 累计平滑
  5: - 写入 realtime_money_flow_snapshot 表，并维护内存缓存供 FastAPI 直接读取
  6: """
  7: import sys, os
  8: import logging
  9: import threading
 10: import requests
 11: from datetime import date, datetime, time
 12: from typing import Dict, List, Optional
 13: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 14: from db.connection import get_db
 15: from db.session import get_db_session
 16: from db.models import RealtimeMoneyFlowSnapshot
 17: from sqlalchemy import func
 18: from utils.http_constants import SINA_HEADERS
 19: logger = logging.getLogger(__name__)
 20: # =====================================================================
 21: # 内存缓存
 22: # 结构: {dimension: {block_name: {"09:30": 1.2, "09:31": 1.5, ...}}}
 23: # =====================================================================
 24: DATA_CACHE: Dict[str, Dict[str, Dict[str, float]]] = {"concept": {}, "industry": {}}
 25: LAST_VALID_SNAPSHOT: Dict[str, Dict[str, float]] = {"concept": {}, "industry": {}}
 26: _CACHE_LOCK = threading.RLock()
 27: # SINA_HEADERS imported from utils.http_constants
 28: def generate_market_time_slots() -> List[str]:
 29:     """生成 A 股标准交易分钟时间点 (09:30-11:30, 13:00-15:00)"""
 30:     slots = []
 31:     for h in range(9, 12):
 32:         for m in range(60):
 33:             if (h == 9 and m >= 30) or h == 10 or (h == 11 and m <= 30):
 34:                 slots.append(f"{h:02d}:{m:02d}")
 35:     for h in range(13, 15):
 36:         for m in range(60):
 37:             slots.append(f"{h:02d}:{m:02d}")
 38:     slots.append("15:00")
 39:     return slots
 40: MARKET_TIMELINE = generate_market_time_slots()
 41: def _is_market_open(minute: str) -> bool:
 42:     return minute in MARKET_TIMELINE
 43: def _now_truncated():
 44:     return datetime.now().replace(second=0, microsecond=0)
 45: def _should_ffill(name: str, val: Optional[float], last: float) -> bool:
 46:     """判断是否需要前向填充：None，或非首分钟突变为 0"""
 47:     if val is None:
 48:         return True
 49:     if val == 0.0 and last != 0.0:
 50:         return True
 51:     return False
 52: def fetch_raw_data_from_sina_concept() -> List[dict]:
 53:     """
 54:     从新浪财经抓取概念板块实时资金流向。
 55:     返回 [{block_name, net_amount}, ...]，net_amount 单位：元。
 56:     """
 57:     url = 'http://vip.stock.finance.sina.com.cn/quotes_service/api/json_v2.php/MoneyFlow.ssl_bkzj_bk'
 58:     items = []
 59:     for page in range(1, 20):
 60:         try:
 61:             resp = requests.get(url, params={
 62:                 'page': page, 'num': 100, 'sort': 'netamount', 'asc': 0, 'fenlei': 1
 63:             }, timeout=10, headers=SINA_HEADERS)
 64:             data = resp.json()
 65:             if not data:
 66:                 break
 67:             for item in data:
 68:                 name = item.get('name', '').strip()
 69:                 net = item.get('netamount')
 70:                 if name and net is not None:
 71:                     items.append({
 72:                         'block_name': name,
 73:                         'net_amount': float(net),
 74:                     })
 75:             if len(data) < 100:
 76:                 break
 77:         except Exception as e:
 78:             logger.error(f'[middleman] sina concept page {page} error: {e}')
 79:             break
 80:     return items
 81: def fetch_raw_data_from_sina_industry() -> List[dict]:
 82:     """
 83:     从新浪财经抓取行业板块实时资金流向。
 84:     fenlei=0 为行业板块。
 85:     """
 86:     url = 'http://vip.stock.finance.sina.com.cn/quotes_service/api/json_v2.php/MoneyFlow.ssl_bkzj_bk'
 87:     items = []
 88:     for page in range(1, 20):
 89:         try:
 90:             resp = requests.get(url, params={
 91:                 'page': page, 'num': 100, 'sort': 'netamount', 'asc': 0, 'fenlei': 0
 92:             }, timeout=10, headers=SINA_HEADERS)
 93:             data = resp.json()
 94:             if not data:
 95:                 break
 96:             for item in data:
 97:                 name = item.get('name', '').strip()
 98:                 net = item.get('netamount')
 99:                 if name and net is not None:
100:                     items.append({
101:                         'block_name': name,
102:                         'net_amount': float(net),
103:                     })
104:             if len(data) < 100:
105:                 break
106:         except Exception as e:
107:             logger.error(f'[middleman] sina industry page {page} error: {e}')
108:             break
109:     return items
110: def fetch_raw_data(dimension: str) -> List[dict]:
111:     """根据维度抓取原始数据"""
112:     if dimension == 'industry':
113:         return fetch_raw_data_from_sina_industry()
114:     return fetch_raw_data_from_sina_concept()
115: def _restore_cache_from_db(dimension: str):
116:     """启动时从数据库恢复当天缓存"""
117:     today = date.today()
118:     with get_db_session() as db:
119:         rows = db.query(RealtimeMoneyFlowSnapshot).filter_by(
120:             trade_date=today, dimension=dimension
121:         ).order_by(RealtimeMoneyFlowSnapshot.minute).all()
122:         with _CACHE_LOCK:
123:             for r in rows:
124:                 if r.block_name not in DATA_CACHE[dimension]:
125:                     DATA_CACHE[dimension][r.block_name] = {}
126:                 DATA_CACHE[dimension][r.block_name][r.minute] = float(r.net_inflow_yi)
127:                 LAST_VALID_SNAPSHOT[dimension][r.block_name] = float(r.net_inflow_yi)
128:         if rows:
129:             logger.info(
130:                 f'[middleman] [{dimension}] restored {len(rows)} snapshots from DB, '
131:                 f'latest {max(r.minute for r in rows)}'
132:             )
133: def _bulk_upsert_snapshots(records: List[RealtimeMoneyFlowSnapshot]):
134:     """批量写入/更新数据库（预加载现有记录 → 内存 map，避免 N 次 SELECT）"""
135:     if not records:
136:         return
137:     try:
138:         with get_db_session() as db:
139:             # 1) 按 (trade_date, dimension) 一次性批量加载已有记录
140:             date_dim_pairs = {(r.trade_date, r.dimension) for r in records}
141:             all_existing = []
142:             for td, dim in date_dim_pairs:
143:                 batch = db.query(RealtimeMoneyFlowSnapshot).filter_by(
144:                     trade_date=td, dimension=dim
145:                 ).all()
146:                 all_existing.extend(batch)
147:             exist_map = {
148:                 (e.trade_date, e.dimension, e.block_name, e.minute): e
149:                 for e in all_existing
150:             }
151:             # 2) 内存 map 查找，零 DB 查询
152:             for rec in records:
153:                 key = (rec.trade_date, rec.dimension, rec.block_name, rec.minute)
154:                 existing = exist_map.get(key)
155:                 if existing:
156:                     existing.net_inflow_yi = rec.net_inflow_yi
157:                     existing.source = rec.source
158:                 else:
159:                     db.add(rec)
160:             db.commit()
161:     except Exception as e:
162:         db.rollback()
163:         logger.exception(f'[middleman] bulk upsert error: {e}')
164: def collect_realtime_money_flow_snapshot(dimension: str = 'concept', trade_date: Optional[date] = None, force: bool = False):
165:     """
166:     核心中转调度器：抓取、清洗、FFill、累计、持久化。
167:     返回保存的记录数。
168:     force=True 时可在非交易时段强制采集（用于测试/补数据）。
169:     """
170:     if trade_date is None:
171:         trade_date = date.today()
172:     # 首次调用时恢复缓存
173:     if not DATA_CACHE[dimension] and not LAST_VALID_SNAPSHOT[dimension]:
174:         _restore_cache_from_db(dimension)
175:     now = datetime.now()
176:     current_hm = now.strftime('%H:%M')
177:     if not force and not _is_market_open(current_hm):
178:         logger.info(f'[middleman] [{dimension}] {current_hm} 不在交易时段，跳过')
179:         return 0
180:     logger.info(f'[middleman] [{dimension}] {current_hm} 开始抓取与清洗...')
181:     # 1. 网络容错
182:     try:
183:         raw_data = fetch_raw_data(dimension)
184:     except Exception as e:
185:         logger.error(f'[middleman] [{dimension}] 外部接口失败: {e}，降级使用前一分钟数据')
186:         raw_data = []
187:     # 收集所有应存在的板块
188:     all_block_names = set(DATA_CACHE[dimension].keys())
189:     for item in raw_data:
190:         name = item.get('block_name')
191:         if name:
192:             all_block_names.add(name)
193:     records_to_save = []
194:     saved_count = 0
195:     with _CACHE_LOCK:
196:         for name in all_block_names:
197:             raw_item = next((x for x in raw_data if x.get('block_name') == name), None)
198:             raw_val = raw_item.get('net_amount') if raw_item else None
199:             val_in_yi = (raw_val / 1e8) if raw_val is not None else None
200:             last_val = LAST_VALID_SNAPSHOT[dimension].get(name, 0.0)
201:             # 2. 数据清洗 + FFill
202:             if _should_ffill(name, val_in_yi, last_val):
203:                 clean_val = last_val
204:                 source = 'ffill'
205:                 logger.warning(
206:                     f'[middleman] [{dimension}] [{name}] 数据异常({raw_val})，'
207:                     f'FFill填充为 {clean_val:.2f} 亿'
208:                 )
209:             else:
210:                 clean_val = round(val_in_yi, 2)
211:                 source = 'api'
212:             # 3. 累计值（新浪返回的 netamount 已经是当日累计净流入，直接保存）
213:             cumulative_val = clean_val
214:             LAST_VALID_SNAPSHOT[dimension][name] = cumulative_val
215:             if name not in DATA_CACHE[dimension]:
216:                 DATA_CACHE[dimension][name] = {}
217:             DATA_CACHE[dimension][name][current_hm] = cumulative_val
218:             saved_count += 1
219:             records_to_save.append(RealtimeMoneyFlowSnapshot(
220:                 trade_date=trade_date,
221:                 dimension=dimension,
222:                 block_name=name,
223:                 minute=current_hm,
224:                 net_inflow_yi=cumulative_val,
225:                 source=source,
226:             ))
227:     # 4. 持久化
228:     _bulk_upsert_snapshots(records_to_save)
229:     logger.info(f'[middleman] [{dimension}] {current_hm} 保存 {saved_count} 条记录')
230:     return saved_count
231: def get_money_flow_response(dimension: str = 'concept', top_n: int = 10, bottom_n: int = 5):
232:     """
233:     组装给 ECharts 的多折线数据。
234:     返回 {status, dimension, trade_date, timeline, series}。
235:     """
236:     # 缓存为空时先从数据库恢复（服务重启后）
237:     if not DATA_CACHE.get(dimension):
238:         _restore_cache_from_db(dimension)
239:     with _CACHE_LOCK:
240:         cache = {k: dict(v) for k, v in DATA_CACHE.get(dimension, {}).items()}
241:     if not cache:
242:         return {
243:             'status': 'success',
244:             'dimension': dimension,
245:             'trade_date': date.today().isoformat(),
246:             'timeline': MARKET_TIMELINE,
247:             'series': [],
248:         }
249:     # 非交易时段快照（如 20:28）不在标准 timeline 里，需要映射到 15:00 展示
250:     latest_snapshot_minute = None
251:     for name, time_series in cache.items():
252:         if time_series:
253:             last_time = max(time_series.keys())
254:             if latest_snapshot_minute is None or last_time > latest_snapshot_minute:
255:                 latest_snapshot_minute = last_time
256:     use_close_mapping = latest_snapshot_minute and latest_snapshot_minute not in MARKET_TIMELINE
257:     latest_rank = []
258:     for name, time_series in cache.items():
259:         if time_series:
260:             last_time = max(time_series.keys())
261:             latest_rank.append((name, time_series[last_time]))
262:     latest_rank.sort(key=lambda x: x[1], reverse=True)
263:     top_blocks = [x[0] for x in latest_rank[:top_n]]
264:     bottom_blocks = [x[0] for x in latest_rank[-bottom_n:]] if len(latest_rank) > top_n else []
265:     target_blocks = list(dict.fromkeys(top_blocks + bottom_blocks))
266:     echarts_series = []
267:     for block_name in target_blocks:
268:         data_points = []
269:         running_val = 0.0
270:         for t in MARKET_TIMELINE:
271:             if t in cache.get(block_name, {}):
272:                 running_val = cache[block_name][t]
273:             # 非交易时段：把最新快照值放到 15:00
274:             if use_close_mapping and t == '15:00' and block_name in cache:
275:                 running_val = cache[block_name].get(latest_snapshot_minute, running_val)
276:             data_points.append(round(running_val, 2))
277:         echarts_series.append({
278:             'name': block_name,
279:             'type': 'line',
280:             'smooth': True,
281:             'data': data_points,
282:         })
283:     return {
284:         'status': 'success',
285:         'dimension': dimension,
286:         'trade_date': date.today().isoformat(),
287:         'timeline': MARKET_TIMELINE,
288:         'series': echarts_series,
