  1: import { useState, useRef, useEffect } from 'react';
  2: import TradeModal from './TradeModal';
  3: import { useTrading } from '../../context/TradingContext';
  4: import { apiFetch } from '../../utils/request';
  5: /**
  6:  * 手动输入股票买入栏
  7:  * 支持代码(000001)或中文名(平安银行)双模式搜索
  8:  */
  9: export default function ManualTradeBar({ children, compact = false, showLabel = true, placeholder }) {
 10:   const { executeTrade } = useTrading();
 11:   const [query, setQuery] = useState('');
 12:   const [results, setResults] = useState([]);
 13:   const [showResults, setShowResults] = useState(false);
 14:   const [loading, setLoading] = useState(false);
 15:   const [selected, setSelected] = useState(null); // {code, name, ts_code}
 16:   const [modalOpen, setModalOpen] = useState(false);
 17:   const debounceRef = useRef(null);
 18:   const containerRef = useRef(null);
 19:   // 搜索防抖
 20:   useEffect(() => {
 21:     if (debounceRef.current) clearTimeout(debounceRef.current);
 22:     if (query.trim().length < 1) {
 23:       setResults([]);
 24:       return;
 25:     }
 26:     debounceRef.current = setTimeout(async () => {
 27:       setLoading(true);
 28:       try {
 29:         const { ok, data } = await apiFetch(`/api/trading/search?q=${encodeURIComponent(query.trim())}`);
 30:         if (!ok) { setResults([]); return; }
 31:         setResults(data.results || []);
 32:         setShowResults(true);
 33:       } catch {
 34:         setResults([]);
 35:       } finally {
 36:         setLoading(false);
 37:       }
 38:     }, 300);
 39:     return () => { if (debounceRef.current) clearTimeout(debounceRef.current); };
 40:   }, [query]);
 41:   // 点击外部关闭结果
 42:   useEffect(() => {
 43:     const handler = (e) => {
 44:       if (containerRef.current && !containerRef.current.contains(e.target)) {
 45:         setShowResults(false);
 46:       }
 47:     };
 48:     document.addEventListener('mousedown', handler);
 49:     return () => document.removeEventListener('mousedown', handler);
 50:   }, []);
 51:   const handleSelect = (item) => {
 52:     setSelected(item);
 53:     setQuery(`${item.name} (${item.code})`);
 54:     setShowResults(false);
 55:     setModalOpen(true);
 56:   };
 57:   // 直接输入6位代码回车
 58:   const handleKeyDown = (e) => {
 59:     if (e.key === 'Enter') {
 60:       const code6 = query.trim().replace(/\D/g, '');
 61:       if (code6.length === 6) {
 62:         // 直接用6位代码
 63:         const suffix = code6[0] === '6' || code6[0] === '9' ? '.SH' : '.SZ';
 64:         handleSelect({ code: code6, name: code6, ts_code: code6 + suffix });
 65:       } else if (results.length > 0) {
 66:         handleSelect(results[0]);
 67:       }
 68:     }
 69:   };
 70:   const [justAdded, setJustAdded] = useState('');
 71:   const addToWatchlist = async (item) => {
 72:     const code = item.code || item.ts_code?.replace(/\.\w+$/, '');
 73:     if (!code) return;
 74:     try {
 75:       await apiFetch('/api/watchlist/add', {
 76:         method: 'POST', headers: { 'Content-Type': 'application/json' },
 77:         body: JSON.stringify({ stockCode: code, stockName: item.name, group: '默认' })
 78:       });
 79:       setJustAdded(code);
 80:       setTimeout(() => setJustAdded(''), 2000);
 81:     } catch (e) { /* silent */ }
 82:   };
 83:   return (
 84:     <>
 85:       <div ref={containerRef} className={`relative flex items-center gap-2 rounded-lg border flex-wrap ${compact ? 'px-2 py-1' : 'px-3 py-2'}`} style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)' }}>
 86:         {showLabel && (
 87:           <span className="text-sm font-medium flex-shrink-0" style={{ color: 'var(--text-primary)' }}>🔍 手动买入</span>
 88:         )}
 89:         <div className={`relative ${compact ? 'w-44 max-w-[11rem]' : 'w-64 max-w-[16rem]'}`}>
 90:           <input
 91:             type="text"
 92:             value={query}
 93:             onChange={e => { setQuery(e.target.value); setSelected(null); }}
 94:             onKeyDown={handleKeyDown}
 95:             onFocus={() => results.length > 0 && setShowResults(true)}
 96:             placeholder={placeholder || (compact ? '代码或名称' : '输入代码或名称（如 000001 / 平安银行）')}
 97:             className={`w-full rounded-md outline-none ${compact ? 'px-2 py-1 text-xs' : 'px-3 py-1.5 text-sm'}`}
 98:             style={{ background: 'var(--bg-surface)', color: 'var(--text-primary)', border: '1px solid var(--border-color)' }}
 99:           />
100:           {/* 搜索结果下拉 */}
101:           {showResults && (results.length > 0 || loading) && (
102:             <div className="absolute top-full left-0 right-0 mt-1 rounded-md border overflow-hidden z-50 max-h-72 overflow-y-auto" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)' }}>
103:               {loading && <div className="px-3 py-2 text-xs" style={{ color: 'var(--text-muted)' }}>搜索中...</div>}
104:               {!loading && results.map(r => {
105:                 const c = r.code || r.ts_code?.replace(/\.\w+$/, '');
106:                 const added = justAdded === c;
107:                 return (
108:                   <div key={r.ts_code} className="flex items-center px-3 py-2 text-sm" style={{ borderBottom: '1px solid var(--border-color)' }}>
109:                     <button onClick={() => handleSelect(r)} className="flex-1 flex items-center justify-between text-left" title="点击买入">
110:                       <span style={{ color: 'var(--text-primary)' }}>{r.name}</span>
111:                       <span className="text-xs" style={{ color: 'var(--text-muted)' }}>{r.code} {r.sector && `· ${r.sector}`}</span>
112:                     </button>
113:                     <button onClick={(e) => { e.stopPropagation(); addToWatchlist(r); }}
114:                       className="ml-2 px-2 py-0.5 rounded text-xs flex-shrink-0"
115:                       style={{ background: added ? 'rgba(34,197,94,0.15)' : 'rgba(234,179,8,0.1)', color: added ? '#22c55e' : '#eab308' }}
116:                       title="加入自选股">
117:                       {added ? '✓已加入' : '⭐自选'}
118:                     </button>
119:                   </div>
120:                 );
121:               })}
122:             </div>
123:           )}
124:         </div>
125:         {selected && (
126:           <span className="text-xs px-2 py-1 rounded" style={{ background: 'rgba(59,130,246,0.1)', color: '#3b82f6' }}>
127:             已选: {selected.name} {selected.code}
128:           </span>
129:         )}
130:         {/* 右侧工具栏插槽：分组 + 排序 + 批量，横向排开 */}
131:         {children && (
132:           <div className="flex items-center gap-2 flex-wrap ml-auto">{children}</div>
133:         )}
134:       </div>
135:       {/* 交易弹窗 */}
136:       {modalOpen && selected && (
