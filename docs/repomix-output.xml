<file path="backend/analyzers/cross_validator.py">
  1: """
  2: 多渠道数据交叉验证引擎
  3: - 对同一指标的多源数据进行交叉验证
  4: - 计算偏差、中位数、加权平均
  5: - 识别异常源，生成质量评分
  6: - 记录质量日志，触发人工审核
  7: """
  8: import sys
  9: import os
 10: import json
 11: import statistics
 12: import logging
 13: logger = logging.getLogger(__name__)
 14: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 15: from datetime import datetime, date
 16: from db.session import get_db_session
 17: from db.models import DataQualityLog, ManualReviewQueue, DataSourceReliability
 18: # 数据源默认权重（基于历史可靠性，可动态调整）
 19: DEFAULT_WEIGHTS = {
 20:     'eastmoney': 0.30,   # 东方财富（个股资金流向主源）
 21:     'sina':      0.25,   # 新浪（板块资金流向主源）
 22:     'guosen':    0.20,   # 国信证券（验证源）
 23:     'tencent':   0.15,   # 腾讯财经（价格/PE/PB）
 24:     'tushare':   0.07,   # Tushare（降级源）
 25:     'tdx':       0.03,   # 通达信（价格补充）
 26:     'akshare':   0.12,   # AKShare（行情验证源）
 27:     'efinance':  0.10,   # efinance（行情/资金补充）
 28:     'adata':     0.08,   # adata（聚合多源验证）
 29:     'qstock':    0.08,   # qstock（行情/资金补充）
 30:     'ths':       0.15,   # 同花顺（资金流向/龙虎榜）
 31:     'mootdx':    0.05,   # mootdx（TCP行情补充）
 32:     'baostock':  0.06,   # baostock（盘后日K验证）
 33:     'sina_quote': 0.10,  # 新浪行情（批量极速验证）
 34:     'tencent_kline': 0.08, # 腾讯K线（前复权验证）
 35:     'netease':   0.05,   # 网易财经（价格补充）
 36:     'itick':     0.12,   # iTick（实时行情，低延迟验证）
 37:     'jqdata':    0.18,   # 聚宽数据（高质量日K/财务）
 38: }
 39: # 偏差阈值（按指标类型差异化）
 40: DEVIATION_THRESHOLD_PCT = {
 41:     'price': 0.02,        # 价格类 2%（价格应高度一致）
 42:     'volume': 0.10,       # 成交量 10%（量能波动大）
 43:     'money_flow': 0.15,   # 资金流向 15%（大额波动正常）
 44:     'pe_pb': 0.05,        # 估值指标 5%
 45:     'default': 0.05,      # 默认 5%
 46: }
 47: DEVIATION_THRESHOLD_ABS = 10    # 10万绝对阈值（资金流向类）；个股主力净流入常见在几十万到几千万，10万可识别小盘股异常源
 48: def get_threshold(metric_type: str = 'default') -> float:
 49:     """获取指定指标类型的偏差阈值"""
 50:     return DEVIATION_THRESHOLD_PCT.get(metric_type, DEVIATION_THRESHOLD_PCT['default'])
 51: def _infer_metric_type(indicator: str) -> str:
 52:     """根据指标名推断指标类型（用于差异化阈值）"""
 53:     if not indicator:
 54:         return 'default'
 55:     ind_lower = indicator.lower()
 56:     if any(k in ind_lower for k in ['price', 'close', 'open', 'high', 'low', '现价', '价格']):
 57:         return 'price'
 58:     if any(k in ind_lower for k in ['volume', 'vol', '成交量', '量比']):
 59:         return 'volume'
 60:     if any(k in ind_lower for k in ['flow', 'inflow', 'outflow', 'net', 'main_force', '资金', '主力', '净流入']):
 61:         return 'money_flow'
 62:     if any(k in ind_lower for k in ['pe', 'pb', 'roe', '估值']):
 63:         return 'pe_pb'
 64:     return 'default'
 65: def get_dynamic_weights(target_date=None):
 66:     """获取动态权重（基于数据源可靠性统计）"""
 67:     try:
 68:         with get_db_session() as db:
 69:             if target_date is None:
 70:                 target_date = date.today()
 71:             # 查最近7天的可靠性统计
 72:             from datetime import timedelta
 73:             week_ago = target_date - timedelta(days=7)
 74:             records = db.query(DataSourceReliability).filter(
 75:                 DataSourceReliability.date >= week_ago
 76:             ).all()
 77:             if not records:
 78:                 return DEFAULT_WEIGHTS.copy()
 79:             # 按数据源聚合
 80:             source_stats = {}
 81:             for r in records:
 82:                 if r.source not in source_stats:
 83:                     source_stats[r.source] = {'total': 0, 'outliers': 0, 'deviations': []}
 84:                 source_stats[r.source]['total'] += r.total_count or 0
 85:                 source_stats[r.source]['outliers'] += r.outlier_count or 0
 86:                 if r.avg_deviation is not None:
 87:                     source_stats[r.source]['deviations'].append(float(r.avg_deviation))
 88:             # 计算动态权重：可靠性越高权重越大
 89:             weights = {}
 90:             total_reliability = 0
 91:             for source, stats in source_stats.items():
 92:                 total = stats['total']
 93:                 outliers = stats['outliers']
 94:                 if total == 0:
 95:                     reliability = 50
 96:                 else:
 97:                     # 可靠性 = 100 - (异常率 * 100) - (平均偏差 * 0.5)
 98:                     outlier_rate = outliers / total
 99:                     avg_dev = statistics.mean(stats['deviations']) if stats['deviations'] else 0
100:                     reliability = max(10, 100 - outlier_rate * 100 - avg_dev * 0.5)
101:                 weights[source] = reliability
102:                 total_reliability += reliability
103:             # 归一化
104:             if total_reliability > 0:
105:                 weights = {k: v / total_reliability for k, v in weights.items()}
106:             # 合并默认权重（对于没有统计数据的源）
107:             for src, w in DEFAULT_WEIGHTS.items():
108:                 if src not in weights:
109:                     weights[src] = w * 0.5  # 降权
110:                     total_reliability += weights[src]
111:             weights = {k: v / total_reliability for k, v in weights.items()}
112:         return weights
113:     except Exception as e:
114:         logger.warning(f'[validator] get_dynamic_weights error: {e}', exc_info=True)
115:         return DEFAULT_WEIGHTS.copy()
116: def cross_validate(ts_code, name, indicator, sources_data, snapshot_time=None, trade_date=None):
117:     """
118:     交叉验证核心函数
119:     sources_data = {
120:         'eastmoney': {'value': 8919.35, ...},
121:         'guosen':    {'value': 8920.10, ...},
122:         'tencent':   {'value': None, ...},  # None表示该源无此数据
123:     }
124:     返回: {
125:         'authority_value': 8919.5,
126:         'confidence': 'high',
127:         'sources_used': ['eastmoney', 'guosen'],
128:         'sources_count': 2,
129:         'outliers': [],
130:         'deviation_pct': 0.01,
131:         'quality_score': 92.5,
132:         'action': 'accept',
133:         'is_corrected': False,
134:     }
135:     """
136:     if snapshot_time is None:
137:         snapshot_time = datetime.now().replace(second=0, microsecond=0)
