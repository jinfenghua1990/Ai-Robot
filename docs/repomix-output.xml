<file path="backend/api/cache.py">
 1: """
 2: Lightweight in-memory TTL cache for API responses.
 3: """
 4: from __future__ import annotations
 5: import time
 6: import threading
 7: import hashlib
 8: import json
 9: from functools import wraps
10: from typing import Any, Callable
11: class TTLCache:
12:     """Thread-safe TTL cache with key-based expiry."""
13:     def __init__(self):
14:         self._store: dict[str, tuple[float, Any]] = {}
15:         self._lock = threading.Lock()
16:     def get(self, key: str) -> Any | None:
17:         with self._lock:
18:             entry = self._store.get(key)
19:             if entry is None:
20:                 return None
21:             expires_at, value = entry
22:             if time.time() > expires_at:
23:                 del self._store[key]
24:                 return None
25:             return value
26:     def set(self, key: str, value: Any, ttl: float):
27:         with self._lock:
28:             self._store[key] = (time.time() + ttl, value)
29:     def invalidate(self, prefix: str = ""):
30:         """Remove all keys matching prefix (empty = flush all)."""
31:         with self._lock:
32:             if not prefix:
33:                 self._store.clear()
34:             else:
35:                 keys_to_del = [k for k in self._store if k.startswith(prefix)]
36:                 for k in keys_to_del:
37:                     del self._store[k]
38:     def cleanup_expired(self):
39:         """Remove all expired entries."""
40:         now = time.time()
41:         with self._lock:
42:             expired = [k for k, (exp, _) in self._store.items() if now > exp]
43:             for k in expired:
44:                 del self._store[k]
45: # Global cache instance
46: cache = TTLCache()
47: def cached(ttl: float = 300, prefix: str = "", key_func: Callable | None = None):
48:     """Decorator to cache function results with TTL.
49:     Args:
50:         ttl: Cache lifetime in seconds (default 5 min)
51:         prefix: Cache key prefix for group invalidation
52:         key_func: Custom function to generate cache key from args.
53:                   Defaults to using all positional args + sorted kwargs.
54:     """
55:     def decorator(fn: Callable) -> Callable:
56:         @wraps(fn)
57:         def wrapper(*args, **kwargs):
58:             if key_func:
59:                 cache_key = f"{prefix}:{key_func(*args, **kwargs)}"
60:             else:
61:                 # Build key from function name + args
62:                 parts = [fn.__module__, fn.__qualname__]
63:                 if args:
64:                     parts.append(json.dumps(args, default=str, ensure_ascii=False))
65:                 if kwargs:
66:                     parts.append(json.dumps(kwargs, sort_keys=True, default=str, ensure_ascii=False))
67:                 raw = "|".join(parts)
68:                 cache_key = f"{prefix}:{hashlib.md5(raw.encode()).hexdigest()}"
69:             result = cache.get(cache_key)
70:             if result is not None:
71:                 return result
72:             result = fn(*args, **kwargs)
73:             cache.set(cache_key, result, ttl)
74:             return result
75:         return wrapper
76:     return decorator
</file>

