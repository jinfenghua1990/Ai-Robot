100:                 '制造': inflow_manufacturing,
101:             }
102:             dominant_style = max(style_scores, key=style_scores.get) if any(style_scores.values()) else '均衡'
103:             market_style = {
104:                 'dominant': dominant_style,
105:                 'growth_vs_value': '成长 > 价值' if inflow_tech > inflow_finance else '价值 > 成长',
106:                 'tech_vs_finance': '科技 > 金融' if inflow_tech > inflow_finance else '金融 > 科技',
107:                 'manufacturing_vs_cyclical': '制造 > 周期' if inflow_manufacturing > outflow_energy else '周期 > 制造',
108:                 'inflow_tech': round(inflow_tech, 1),
109:                 'inflow_finance': round(inflow_finance, 1),
110:                 'inflow_manufacturing': round(inflow_manufacturing, 1),
111:                 'inflow_cyclical': round(inflow_cyclical, 1),
112:                 'inflow_defensive': round(inflow_defensive, 1),
113:                 'outflow_finance': round(outflow_finance, 1),
114:                 'outflow_energy': round(outflow_energy, 1),
115:             }
116:             # 5. 生成配置建议
117:             # 基于流入板块计算配置权重
118:             total_inflow_val = sum(v for _, v in inflow_sorted) or 1
119:             allocation = []
120:             # 科技硬件
121:             tech_inflow = sum(v for s, v in inflow_sorted if s in tech_sectors)
122:             tech_pct = round(tech_inflow / total_inflow_val * 100) if total_inflow_val > 0 else 0
123:             tech_pct = min(max(tech_pct, 30), 45)  # 限制在30-45%
124:             allocation.append({
125:                 'category': '科技硬件',
126:                 'sectors': [s for s, _ in inflow_sorted if s in tech_sectors] or ['半导体', '通信设备'],
127:                 'percentage': tech_pct,
128:                 'reason': 'AI算力需求爆发，国产替代加速，主力资金持续流入',
129:                 'stocks': [s for sec in stock_sectors if sec in tech_sectors for s in stock_sectors[sec]['stocks'][:3]],
130:             })
131:             # 高端制造
132:             mfg_inflow = sum(v for s, v in inflow_sorted if s in manufacturing_sectors)
133:             mfg_pct = round(mfg_inflow / total_inflow_val * 100) if total_inflow_val > 0 else 0
134:             mfg_pct = min(max(mfg_pct, 15), 30)
135:             allocation.append({
136:                 'category': '高端制造',
137:                 'sectors': [s for s, _ in inflow_sorted if s in manufacturing_sectors] or ['机械基件', '专用机械'],
138:                 'percentage': mfg_pct,
139:                 'reason': '高端制造国产化，设备更新政策催化，订单饱满',
140:                 'stocks': [],
141:             })
142:             # 防御消费
143:             allocation.append({
144:                 'category': '防御消费',
145:                 'sectors': ['医药', '食品饮料', '旅游'],
146:                 'percentage': 20,
147:                 'reason': '对冲科技波动风险，防御属性突出',
148:                 'stocks': [],
149:             })
150:             # 现金
151:             cash_pct = 100 - tech_pct - mfg_pct - 20
152:             allocation.append({
153:                 'category': '现金/短债',
154:                 'sectors': [],
155:                 'percentage': max(cash_pct, 10),
156:                 'reason': '等待回调加仓科技股的机会',
157:                 'stocks': [],
158:             })
159:             # 6. 减持建议
160:             reduce_list = []
161:             for sec, val in outflow_sorted:
162:                 reason_map = {
163:                     '银行': '低估值陷阱，资金持续外流，缺乏催化剂',
164:                     '证券': '市场量能不足，券商beta属性弱化',
165:                     '保险': '利率下行周期，负债端承压',
166:                     '火力发电': '能源转型趋势下长期承压',
167:                     '水力发电': '来水不确定性，防御价值降低',
168:                     '化工原料': '周期下行，需求疲软',
169:                     '电气设备': '新能源链产能过剩，竞争加剧',
170:                 }
171:                 reduce_list.append({
172:                     'sector': sec,
173:                     'outflow': round(val, 1),
174:                     'reason': reason_map.get(sec, '资金持续流出，趋势走弱'),
175:                 })
176:             # 7. 增持建议
177:             increase_list = []
178:             for sec, val in inflow_sorted:
179:                 stock_list = stock_sectors.get(sec, {}).get('stocks', [])
180:                 leader_list = leader_by_sector.get(sec, [])
181:                 increase_list.append({
182:                     'sector': sec,
183:                     'inflow': round(val, 1),
184:                     'stocks': stock_list[:3],
185:                     'leader_count': len(leader_list),
186:                     'leaders': [l['name'] for l in leader_list[:3]],
187:                 })
188:             # 8. 风控建议
189:             risk_control = {
190:                 'stop_loss': '个股跌幅超8%减半仓，超12%清仓',
191:                 'stop_profit': '板块轮动信号反转（科技板块出现在流出Top10时）全面减仓',
192:                 'monitor': '每日关注资金流向Sankey图，若半导体/通信设备从流入端消失则立即调整',
193:                 'position_limit': '单一个股不超过15%，单一板块不超过30%',
194:             }
