 1: """
 2: US Quant System — 策略注册表（插件化）
 3: 后续添加新策略只需在 STRATEGIES 中添加一条配置 + 实现 score_xxx 函数。
 4: """
 5: from __future__ import annotations
 6: from typing import Optional, Callable
 7: import logging
 8: logger = logging.getLogger(__name__)
 9: # ============================================================
10: # 策略注册表（后续扩展只需在此添加配置）
11: # ============================================================
12: STRATEGIES = [
13:     {
14:         'key': 'breakout',
15:         'name': '平台突破 Breakout V1',
16:         'icon': '📈',
17:         'module': 'us_quant.strategies',
18:         'func': 'score_breakout',
19:         'description': '平台整理突破 + 量能确认 + 相对强度',
20:         'needs_klines': True,
21:         'needs_market_regime': True,
22:         'default_params': {
23:             'min_breakout_score': 60,
24:             'volume_confirmation': True,
25:             'min_volume_ratio': 1.5,
26:         },
27:     },
28:     {
29:         'key': 'pullback',
30:         'name': '趋势回踩 Pullback V1',
31:         'icon': '📉',
32:         'module': 'us_quant.strategies',
33:         'func': 'score_pullback',
34:         'description': '中期趋势向上 + 回踩关键均线 + 缩量整理',
35:         'needs_klines': True,
36:         'needs_market_regime': True,
37:         'default_params': {
38:             'min_pullback_score': 60,
39:             'ema_period': 20,
40:             'max_pullback_pct': 8,
41:         },
42:     },
43:     {
44:         'key': 'earnings_gap',
45:         'name': '财报跳空 Earnings Gap V1',
46:         'icon': '💰',
47:         'module': 'us_quant.strategies',
48:         'func': 'score_earnings_gap',
49:         'description': '财报超预期跳空 + 成交量确认 + 催化剂评级',
50:         'needs_klines': True,
51:         'needs_market_regime': True,
52:         'default_params': {
53:             'min_gap_score': 60,
54:             'min_gap_pct': 2.0,
55:             'require_volume_spike': True,
56:         },
57:     },
58: ]
59: def get_strategy(key: str) -> Optional[dict]:
60:     """按 key 获取策略元数据"""
61:     for s in STRATEGIES:
62:         if s['key'] == key:
63:             return dict(s)
64:     return None
65: def list_strategies() -> list[dict]:
66:     """列出所有已注册策略"""
67:     return [dict(s) for s in STRATEGIES]
68: def load_strategy_func(strategy: dict) -> Optional[Callable]:
69:     """动态加载策略评分函数（插件化加载）"""
70:     try:
71:         mod = __import__(strategy['module'], fromlist=[strategy['func']])
72:         func = getattr(mod, strategy['func'])
73:         return func
74:     except (ImportError, AttributeError) as e:
75:         logger.error(f"[strategy_registry] 加载策略 {strategy['key']} 失败: {e}")
76:         return None
77: def run_strategy(strategy_key: str, **kwargs):
78:     """运行单个策略，返回评分结果"""
79:     meta = get_strategy(key=strategy_key)
80:     if not meta:
81:         logger.warning(f"[strategy_registry] 未知策略: {strategy_key}")
82:         return None
83:     func = load_strategy_func(meta)
84:     if not func:
85:         return None
86:     try:
87:         return func(**kwargs)
88:     except Exception as e:
89:         logger.error(f"[strategy_registry] 策略 {strategy_key} 执行失败: {e}")
90:         return None
