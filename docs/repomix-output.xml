 1: """Market regime assessment and dynamic factor-weight scheduling."""
 2: from __future__ import annotations
 3: from dataclasses import dataclass
 4: from .contracts import MarketContext
 5: @dataclass(frozen=True)
 6: class MarketRegime:
 7:     state: str
 8:     score: float
 9:     weights: dict[str, float]
10:     allow_new_positions: bool
11:     reason: str
12: class MarketRegimeEngine:
13:     """Turn market breadth into a regime, not a binary strategy switch."""
14:     BASE_WEIGHTS = {
15:         "market": 0.10,
16:         "sector": 0.20,
17:         "strength": 0.20,
18:         "trend": 0.15,
19:         "volume_price": 0.15,
20:         "position": 0.15,
21:         "risk_penalty": 0.05,
22:     }
23:     def assess(self, market: MarketContext) -> MarketRegime:
24:         breadth = max(0.0, min(1.0, float(market.breadth)))
25:         limit_balance = self._limit_balance(market)
26:         trend = market.market_return_20d
27:         trend_component = 0.5 if trend is None else max(0.0, min(1.0, 0.5 + float(trend) * 5.0))
28:         score = round((breadth * 0.60 + (limit_balance * 0.5 + 0.5) * 0.20 + trend_component * 0.20) * 100, 2)
29:         if breadth >= 0.70 and limit_balance >= 0 and trend_component >= 0.50:
30:             return MarketRegime("STRONG", score, {
31:                 "market": 0.10, "sector": 0.20, "strength": 0.25,
32:                 "trend": 0.20, "volume_price": 0.10, "position": 0.10,
33:                 "risk_penalty": 0.05,
34:             }, True, "上涨家数占优，趋势与强度优先；降低追高位置权重")
35:         if breadth < 0.30 or limit_balance <= -0.35 or trend_component <= 0.30:
36:             return MarketRegime("WEAK", score, {
37:                 "market": 0.10, "sector": 0.15, "strength": 0.10,
38:                 "trend": 0.10, "volume_price": 0.10, "position": 0.15,
39:                 "risk_penalty": 0.30,
40:             }, False, "市场宽度或涨跌停结构恶化；禁止新开仓并提高风险惩罚")
41:         return MarketRegime("RANGE", score, {
42:             "market": 0.10, "sector": 0.20, "strength": 0.15,
43:             "trend": 0.10, "volume_price": 0.20, "position": 0.20,
44:             "risk_penalty": 0.05,
45:         }, True, "市场处于震荡区间；回踩位置和量价确认优先")
46:     @staticmethod
47:     def _limit_balance(market: MarketContext) -> float:
48:         total = market.limit_up_count + market.limit_down_count
49:         if total <= 0:
50:             return 0.0
51:         return (market.limit_up_count - market.limit_down_count) / total
