<file path="frontend/src/utils/marketScore.js">
  1: /**
  2:  * 港股研究中心 / 美股智能交易系统 —— 评分模型、状态体系、策略匹配、市场环境
  3:  *
  4:  * 数据来源说明（已接入真实数据源）：
  5:  *  - 技术维度（价格 / MA5 / MA10 / MA20 / RSI / 区间涨跌 / 偏离度）来自后端真实行情接口（Yahoo，港股回退新浪）。
  6:  *  - 基本面维度（PE / PB / 股息率 / 总市值 / 52周估值分位）来自腾讯 gtimg 实时接口，
  7:  *    由后端 /api/global-market/fundamentals 提供，真实值覆盖下方估算。
  8:  *  - ROE / 营收增速 / 利润增速 / 南向资金 / 主力资金流 / 每股收益超预期等维度，
  9:  *    免费实时源暂不可靠，仍用「确定性估算」（按代码种子，稳定可复现）填充，页面标注「估算」。
 10:  *
 11:  * 模型权重严格遵循两份架构设计文档：
 12:  *  - 港股：基本面30 / 资金25 / 估值20 / 趋势15 / 催化10 = 100
 13:  *  - 美股：趋势30 / 基本面25 / 资金20 / 动量15 / 风险10 = 100
 14:  */
 15: import { apiFetch } from './request';
 16: const clamp = (v, min = 0, max = 1) => Math.max(min, Math.min(max, v));
 17: const round1 = (v) => Math.round(v * 10) / 10;
 18: // ─── 确定性伪随机（按代码种子，保证刷新一致） ───────────────────────────────
 19: function hashStr(str) {
 20:   let h = 2166136261;
 21:   for (let i = 0; i < str.length; i++) {
 22:     h ^= str.charCodeAt(i);
 23:     h = Math.imul(h, 16777619);
 24:   }
 25:   return h >>> 0;
 26: }
 27: function makeRng(seed) {
 28:   let s = seed >>> 0;
 29:   return () => {
 30:     s = (s + 0x6d2b79f5) | 0;
 31:     let t = Math.imul(s ^ (s >>> 15), 1 | s);
 32:     t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
 33:     return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
 34:   };
 35: }
 36: /**
 37:  * 估算基本面（稳定，按 market+code 种子）
 38:  */
 39: export function estimateFundamentals(market, code) {
 40:   const r = makeRng(hashStr(`${market}:${code}`));
 41:   const pick = (min, max) => min + r() * (max - min);
 42:   return {
 43:     pe: round1(pick(7, 48)),
 44:     pb: round1(pick(0.5, 9)),
 45:     roe: round1(pick(5, 34)), // %
 46:     divYield: round1(pick(0, 7)), // %
 47:     revGrowth: round1(pick(-8, 48)), // %
 48:     earnGrowth: round1(pick(-18, 60)), // %
 49:     grossMargin: round1(pick(18, 78)), // %
 50:     // 港股：南向资金 20 日净流入（亿元，估算）
 51:     southNet20d: round1(pick(-35, 70)),
 52:     // 美股：机构/主力资金流（估算强度 -1..1）
 53:     moneyFlow: round1(pick(-0.8, 0.9) * 10) / 10,
 54:     institutionHold: round1(pick(18, 78)), // %
 55:     cashFlowStable: r() > 0.3,
 56:     vol20: round1(pick(12, 48)), // 年化波动率 %
 57:     pePercentile: round1(pick(5, 95)), // 当前 PE 在历史的百分位
 58:     pbPercentile: round1(pick(5, 95)),
 59:     epsSurprise: round1(pick(-9, 20)), // %
 60:     revSurprise: round1(pick(-7, 18)), // %
 61:     guidance: r() > 0.4, // 是否上调指引
 62:   };
 63: }
 64: // ─── 港股评分模型 ─────────────────────────────────────────────────────────────
 65: export function hkScore(stock, f) {
 66:   // 基本面 30
 67:   let fundamental =
 68:     clamp((f.roe - 5) / 25) * 12 +
 69:     clamp((f.revGrowth + 5) / 40) * 9 +
 70:     clamp((f.earnGrowth + 10) / 60) * 9;
 71:   // 资金 25（南向 + 机构）
 72:   let capital =
 73:     clamp((f.southNet20d + 35) / 95) * 15 +
 74:     clamp((f.institutionHold - 15) / 60) * 10;
 75:   // 估值 20（低 PE 分位 + 低 PB 更优）
 76:   let valuation =
 77:     clamp((40 - f.pePercentile) / 40) * 12 +
 78:     clamp((3.5 - f.pb) / 3) * 8;
 79:   // 趋势 15（真实技术数据）
 80:   let trend = 0;
 81:   if (stock.price && stock.ma20) trend += clamp((stock.price - stock.ma20) / stock.ma20 / 0.1) * 7;
 82:   if (stock.rsi != null) trend += clamp((stock.rsi - 40) / 40) * 4;
 83:   if (stock.change20d != null) trend += clamp((stock.change20d + 10) / 30) * 4;
 84:   // 催化 10
 85:   let catalyst = (f.guidance ? 6 : 3) + clamp(f.epsSurprise / 10) * 4;
 86:   const subs = {
 87:     fundamental: round1(fundamental),
 88:     capital: round1(capital),
 89:     valuation: round1(valuation),
 90:     trend: round1(trend),
 91:     catalyst: round1(catalyst),
 92:   };
 93:   subs.total = round1(subs.fundamental + subs.capital + subs.valuation + subs.trend + subs.catalyst);
 94:   return subs;
 95: }
 96: // ─── 美股评分模型 ─────────────────────────────────────────────────────────────
 97: export function usScore(stock, f) {
 98:   // 趋势 30（MA 排列 + 区间涨幅，真实技术数据）
 99:   let trend = 0;
100:   if (stock.price && stock.ma20) trend += clamp((stock.price - stock.ma20) / stock.ma20 / 0.08) * 12;
101:   if (stock.ma5 && stock.ma20) trend += (stock.ma5 > stock.ma20 ? 6 : 0);
102:   if (stock.change20d != null) trend += clamp(stock.change20d / 25) * 12;
103:   // 基本面 25
104:   let fundamental =
105:     clamp((f.roe - 5) / 25) * 10 +
106:     clamp((f.revGrowth + 5) / 40) * 8 +
107:     clamp((f.earnGrowth + 10) / 60) * 7;
108:   // 资金 20
109:   let capital = clamp((f.moneyFlow + 0.8) / 1.7) * 10 + clamp((f.institutionHold - 15) / 60) * 10;
110:   // 动量 15
111:   let momentum = 0;
112:   if (stock.rsi != null) momentum += clamp((stock.rsi - 45) / 35) * 7;
113:   if (stock.change5d != null) momentum += clamp(stock.change5d / 10) * 8;
114:   // 风险 10（低波动 + 非极端 RSI 更优）
115:   let risk = clamp((35 - f.vol20) / 30) * 6 + (stock.rsi != null && stock.rsi < 78 ? 4 : 0);
116:   const subs = {
117:     trend: round1(trend),
118:     fundamental: round1(fundamental),
119:     capital: round1(capital),
120:     momentum: round1(momentum),
121:     risk: round1(risk),
122:   };
123:   subs.total = round1(subs.trend + subs.fundamental + subs.capital + subs.momentum + subs.risk);
124:   return subs;
125: }
126: // ─── 港股 7 维状态体系 ────────────────────────────────────────────────────────
127: export function hkStatus(score, stock, f) {
128:   const upTrend = stock.price && stock.ma20 && stock.price > stock.ma20 && stock.change20d != null && stock.change20d > 0;
129:   const strong = score.total >= 70;
130:   if ((f.southNet20d ?? 0) < -10 && stock.price && stock.ma20 && stock.price < stock.ma20) return '风险退潮';
131:   if (f.pePercentile < 30 && f.roe >= 12) return '低估';
132:   if ((f.southNet20d ?? 0) > 25) return '资金流入';
133:   if (f.pePercentile < 45 && f.earnGrowth > 5 && (f.southNet20d ?? 0) > 0) return '修复启动';
134:   if (f.revGrowth > 20 && f.earnGrowth > 20 && (f.southNet20d ?? 0) > 10) return '成长加速';
135:   if (upTrend && strong && stock.price && stock.ma60 && stock.price > stock.ma60) return '趋势主升';
136:   return '观察';
137: }
138: // ─── 美股 7 维状态体系 ────────────────────────────────────────────────────────
139: export function usStatus(score, stock, f) {
140:   const price = stock.price;
141:   const ma20 = stock.ma20;
142:   const ch20 = stock.change20d;
143:   if (price && ma20 && price < ma20 && ch20 != null && ch20 < -8) return '退潮';
144:   if (stock.rsi != null && stock.rsi > 78) return '高位风险';
145:   if (price && ma20 && price > ma20 && stock.ma5 && stock.ma5 > ma20 && ch20 != null && ch20 > 12) return '主升';
146:   if (price && ma20 && price > ma20 && ch20 != null && ch20 > 3) return '趋势';
147:   if (price && ma20 && price > ma20 && ch20 != null && ch20 > 0) return '启动';
148:   if (price && ma20 && price < ma20 && ch20 != null && ch20 > -3) return '筑底';
149:   return '观察';
150: }
151: // ─── 港股 4 大选股策略 ────────────────────────────────────────────────────────
152: export function hkStrategies(stock, f) {
153:   const matched = [];
154:   // 南向资金流入：20日净流入 + 站上 MA60 + 量能提升
155:   if ((f.southNet20d ?? 0) > 20 && stock.price && stock.ma60 && stock.price > stock.ma60) {
156:     matched.push('南向资金流入');
157:   }
158:   // 价值修复：PE 低位 + ROE 优 + 利润恢复 + 资金流入
159:   if (f.pePercentile < 35 && f.roe >= 12 && f.earnGrowth > 0 && (f.southNet20d ?? 0) > 0) {
160:     matched.push('价值修复');
161:   }
162:   // 成长趋势：收入增长 + 利润增长 + 趋势突破
163:   if (f.revGrowth > 18 && f.earnGrowth > 18 && stock.price && stock.ma20 && stock.price > stock.ma20) {
164:     matched.push('成长趋势');
165:   }
166:   // 高股息：股息率>5% + 现金流稳定 + 低波动
167:   if (f.divYield > 5 && f.cashFlowStable && f.vol20 < 30) {
168:     matched.push('高股息');
169:   }
170:   return matched;
171: }
172: // ─── 美股 6 大交易策略 ────────────────────────────────────────────────────────
173: export function usStrategies(stock, f) {
174:   const matched = [];
175:   const price = stock.price, ma20 = stock.ma20, ma5 = stock.ma5;
176:   // 青龙趋势：MA20>MA50>MA200 + 站上均线 + 资金流入（MA50/200 用估算趋势强度代替）
177:   if (ma5 && ma20 && ma5 > ma20 && price && price > ma20 && f.moneyFlow > 0.2 && stock.change20d > 5) {
178:     matched.push('青龙趋势');
179:   }
180:   // 白虎突破：突破 60 日新高 + 量>150% + RSI 50-70（用 20 日涨幅近似新高）
181:   if (stock.change20d != null && stock.change20d > 12 && stock.rsi != null && stock.rsi >= 50 && stock.rsi <= 70) {
182:     matched.push('白虎突破');
183:   }
184:   // 回踩：上涨趋势 + 回调~10% + 缩量 + 均线支撑
185:   if (stock.change20d != null && stock.change20d > 5 && stock.change5d != null && stock.change5d < -3 && ma20 && price && price > ma20 * 0.95) {
186:     matched.push('回踩');
187:   }
188:   // 财报：EPS / Revenue 超预期 + 上调指引
189:   if (f.epsSurprise > 5 && f.revSurprise > 3 && f.guidance) {
190:     matched.push('财报');
191:   }
192:   // 低估反转：PE 较低 + ROE 优 + 基本面稳 + 资金流入
193:   if (f.pePercentile < 40 && f.roe >= 12 && f.moneyFlow > 0.1) {
194:     matched.push('低估反转');
195:   }
196:   // ETF 轮动：仅对主流 ETF 标的生效
197:   if (['QQQ', 'SMH', 'XLK', 'XLE', 'XLV', 'SPY'].includes(stock.code)) {
198:     matched.push('ETF轮动');
199:   }
200:   return matched;
201: }
202: // ─── 美股市场环境评分（0-100） ────────────────────────────────────────────────
203: export function usMarketEnv(indices, stats) {
204:   // 大盘趋势：从指数涨跌近似（恒正且强 → 高分）。真实需 MA200，这里用指数强度估算。
205:   const idxPct = (indices || []).map((i) => i.change_pct || 0);
206:   const avgIdx = idxPct.length ? idxPct.reduce((a, b) => a + b, 0) / idxPct.length : 0;
207:   const trend = clamp((avgIdx + 2) / 4) * 50; // -2%..+2% → 0..50
208:   // 市场宽度：上涨占比
209:   const total = stats?.total || 0;
210:   const breadth = total ? clamp(stats.up / total) * 30 : 0;
211:   // VIX 风险（估算，标注）：默认 15 左右为低风险。此处给固定估算值。
212:   const vix = 15.0;
213:   const vixScore = (vix < 20 ? 20 : vix < 30 ? 10 : 0);
214:   const totalScore = Math.round(trend + breadth + vixScore);
215:   let label = '中性';
216:   if (totalScore >= 80) label = '强势';
217:   else if (totalScore >= 60) label = '偏多';
218:   else if (totalScore < 40) label = '弱势';
219:   return {
220:     trend: Math.round(trend),
221:     breadth: Math.round(breadth),
222:     vix,
223:     vixScore,
224:     total: totalScore,
225:     label,
226:   };
227: }
228: // ─── 港股行业轮动（估算，稳定） ───────────────────────────────────────────────
229: const HK_SECTOR_DEFS = [
230:   ['科技', 88], ['互联网', 92], ['半导体', 81], ['创新药', 74],
231:   ['消费', 68], ['汽车', 71], ['金融', 63], ['能源', 55], ['地产', 48],
232: ];
233: export function hkSectors() {
234:   return HK_SECTOR_DEFS.map(([name, heat], i) => {
235:     const f = estimateFundamentals('HK', `SECTOR${i}`);
236:     const valuation = Math.round(clamp((55 - f.pePercentile) / 55) * 100);
237:     const trend = Math.round(clamp((heat - 40) / 60) * 100);
238:     const capital = Math.round(clamp((f.southNet20d + 35) / 95) * 100);
239:     const score = Math.round(heat * 0.4 + capital * 0.25 + trend * 0.2 + valuation * 0.15);
240:     return { name, heatScore: heat, capitalFlow: Math.round(f.southNet20d), trendScore: trend, valuationScore: valuation, score };
241:   });
242: }
243: // ─── 美股行业轮动（估算，稳定） ───────────────────────────────────────────────
244: const US_SECTOR_DEFS = [
245:   ['科技 (XLK)', 90], ['半导体 (SMH)', 86], ['通信 (XLC)', 78],
246:   ['消费 (XLY)', 72], ['医疗 (XLV)', 64], ['金融 (XLF)', 60],
247:   ['能源 (XLE)', 55], ['工业 (XLI)', 58], ['材料 (XLB)', 50],
248: ];
249: export function usSectors() {
250:   return US_SECTOR_DEFS.map(([name, momentum], i) => {
251:     const f = estimateFundamentals('US', `SECTOR${i}`);
252:     const gain = Math.round(clamp((momentum - 40) / 60) * 100); // 涨幅
253:     const capital = Math.round(clamp((f.moneyFlow + 0.8) / 1.7) * 100); // 资金
254:     const trend = Math.round(clamp((momentum - 40) / 60) * 100); // 趋势
255:     const strength = gain; // 强度
256:     const score = Math.round(gain * 0.3 + capital * 0.3 + trend * 0.2 + strength * 0.2);
257:     return { name, gainScore: gain, capitalFlow: capital, trendScore: trend, strengthScore: strength, score };
258:   });
259: }
