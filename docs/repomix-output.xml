302:     """对所有持仓生成分析信号（async 实现）"""
303:     config = get_config()
304:     with get_db_session() as db:
305:         signals = []
306:         sector_cache = {}
307:         for pos in positions:
308:             sec_code = pos.get("secCode", "")
309:             # 查找板块（带缓存）
310:             if sec_code not in sector_cache:
311:                 sector_cache[sec_code] = _find_sector_for_stock(db, sec_code)
312:             sector = sector_cache[sec_code]
313:             # 获取板块趋势
314:             if sector:
315:                 if sector not in sector_cache:
316:                     sector_cache[sector] = _get_sector_trend(db, sector, config["sector_trend_days"])
317:                 sector_trend = sector_cache[sector]
318:             else:
319:                 sector_trend = {"sector": "未知", "available": False}
320:             # 生成信号
321:             signal = analyze_position(pos, sector_trend, config, total_assets)
322:             signals.append(signal)
323:         # 汇总统计
324:         signal_counts = {s: 0 for s in [SIGNAL_STRONG_SELL, SIGNAL_SELL, SIGNAL_HOLD, SIGNAL_ADD]}
325:         high_risk_count = 0
326:         for sig in signals:
327:             signal_counts[sig["signal"]] += 1
328:             if sig["riskLevel"] == "high":
329:                 high_risk_count += 1
330:         # 并发拉取所有持仓的新浪实时行情（与自选股口径一致）
331:         sec_codes = [sig.get("secCode", "") for sig in signals]
332:         quotes_map = await _fetch_quotes_batch(sec_codes)
333:         # 补齐与自选股一致的数据维度
334:         validation_issues = []
335:         for sig in signals:
336:             sec_code = sig.get("secCode", "")
337:             sector_trend = sig.get("sectorTrend") or {}
338:             position = sig.get("position") or {}
339:             quote = quotes_map.get(sec_code)
340:             # 市场状态（CHOPPY/TREND/IMPULSE，从数据库预计算读取；缺则 PENDING 待算）
341:             market_state_data = get_latest_state(sec_code) or {"market_state": "PENDING", "reasons": ["待计算"]}
342:             sig["marketState"] = market_state_data
343:             # 透传 quote 和 bsSignal（与自选股字段对齐）
344:             sig["quote"] = quote
345:             sig["bsSignal"] = None  # 模拟盘未拉 K 线，无 BS 信号
346:             # 如有实时行情，用 quote.changePct 覆盖 position.dayProfitPct
347:             # 原因：妙想 API 的 dayProfitPct 是当日盈亏率（相对成本），
348:             # 自选股的 dayProfitPct 是当日涨跌幅（相对昨收），sim_watchlist 模式前端显示"涨跌"应用涨跌幅
349:             if quote:
350:                 position["dayProfitPct"] = quote.get("changePct", position.get("dayProfitPct", 0))
351:                 position["price"] = quote.get("price", position.get("price", 0))
352:             # 购买力评分（用真实 quote.changePct，与自选股 calc_buy_power_for_signal 口径一致）
353:             sig["buyPower"] = calc_buy_power_for_signal(quote, sector_trend, None)
354:             # 质量状态（用 compute_quality_from_features，与自选股 sync-quality 口径一致）
355:             ms = market_state_data.get("market_state", "PENDING")
356:             features = market_state_data.get("features") or {}
357:             stock_name = sig.get("secName", "") or ""
358:             is_junk = 'ST' in stock_name.upper() or '退' in stock_name
359:             sig["qualityStatus"] = compute_quality_from_features(ms, features, is_junk)
360:             # 数据校验
361:             missing = _validate_signal(sig)
362:             if missing:
363:                 validation_issues.append({'secCode': sec_code, 'missing': missing})
364:         # 默认排序：持仓优先（仓位高的在前），同仓位按购买力降序
365:         # 同时保留信号优先级作为第三关键字，确保清仓/减仓信号仍优先展示
366:         priority_order = {SIGNAL_STRONG_SELL: 0, SIGNAL_SELL: 1, SIGNAL_HOLD: 2, SIGNAL_ADD: 3}
367:         signals.sort(key=lambda x: (
368:             -(x.get("position", {}).get("posPct") or 0),      # 1. 仓位降序（持仓优先）
369:             -(x.get("buyPower", {}).get("score") or 0),        # 2. 购买力降序
370:             priority_order.get(x["signal"], 9),                # 3. 信号优先级
371:         ))
372:         return {
373:             "signals": signals,
374:             "summary": {
375:                 "total": len(signals),
376:                 "strong_sell": signal_counts[SIGNAL_STRONG_SELL],
377:                 "sell": signal_counts[SIGNAL_SELL],
378:                 "hold": signal_counts[SIGNAL_HOLD],
379:                 "add": signal_counts[SIGNAL_ADD],
380:                 "high_risk": high_risk_count,
381:             },
382:             "config": config,
383:             "generated_at": datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
384:             "validation": {
385:                 "issues": validation_issues,
386:                 "field_count": len(_REQUIRED_SIGNAL_FIELDS),
387:             },
388:         }
