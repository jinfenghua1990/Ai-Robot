<file path="frontend/src/components/trading/moduleHeaderConfig.js">
  1: // 模块标题标准配置 — 所有卡片模块的「图标 + 名称 + 结论计算规则」集中于此
  2: //
  3: // 用法：
  4: //   import { MODULE_HEADER_CONFIG, calcModuleConclusion, REALTIME_HEADER } from './moduleHeaderConfig';
  5: //   const cfg = MODULE_HEADER_CONFIG.tech;
  6: //   const conclusion = calcModuleConclusion('tech', { ind, kdjJ, macdVal, dif, dea, ma5, ma20, rsiVal });
  7: //   <ModuleHeader icon={cfg.icon} name={cfg.name} conclusion={conclusion.label} conclusionColor={conclusion.color} title={conclusion.title} />
  8: //
  9: // 修改一处规则，所有模块自动生效。新增模块只需在此处加一个 key。
 10: import { UP_COLOR, DOWN_COLOR, UP_DARK } from '../../utils/colors';
 11: // === 颜色常量（统一使用 colors.js 的语义色） ===
 12: export const COLOR = {
 13:   BULL: UP_COLOR,           // 红=买入/看多
 14:   BEAR: DOWN_COLOR,         // 绿=卖出/看空
 15:   CAUTION: '#f97316',       // 橙=谨慎/分歧
 16:   ATTENTION: '#eab308',     // 黄=关注
 17:   NEUTRAL: '#64748b',       // 灰=中性
 18:   RISK: UP_DARK,            // 深红=高危
 19:   STRONG: UP_DARK,          // 主升浪
 20:   BOTTOM: '#3b82f6',        // 超卖低吸
 21: };
 22: // === 模块标题配置 ===
 23: export const MODULE_HEADER_CONFIG = {
 24:   tech: { icon: '📈', name: '个股技术指标' },
 25:   org: { icon: '🏛️', name: '机构 / 游资' },
 26:   flow: { icon: '💰', name: '资金流向' },
 27:   sector: { icon: '🏭', name: '板块' },
 28:   market: { icon: '🌐', name: '市场' },
 29:   bs: { icon: '🎯', name: 'BS 区间' },
 30:   ai: { icon: '🤖', name: 'AI 联动诊断' },
 31:   rt: { icon: '🟢', name: '实时' }, // 右侧实时栏统一用这个
 32: };
 33: // === 各模块结论计算函数 ===
 34: // 每个函数返回 { label, color, title }
 35: // label 是核心操作建议（带方向），color 是 A 股惯例（红涨绿跌）
 36: /**
 37:  * 个股技术指标综合结论
 38:  * 输入：{ kdjJ, macdVal, dif, dea, ma5, ma20, rsiVal }
 39:  * 优先级：超买/超卖 > 金叉/死叉 > 多头/空头排列
 40:  */
 41: export function getTechConclusion(ind = {}) {
 42:   const kdjJ = ind?.kdj_j;
 43:   const macdVal = ind?.macd;
 44:   const dif = ind?.dif, dea = ind?.dea;
 45:   const ma5 = ind?.ma5, ma20 = ind?.ma20;
 46:   const rsiVal = ind?.rsi;
 47:   const isGoldenCross = dif != null && dea != null && dif > dea;
 48:   const isDeathCross = dif != null && dea != null && dif < dea;
 49:   const isMaBull = ma5 != null && ma20 != null && ma5 > ma20;
 50:   const isMaBear = ma5 != null && ma20 != null && ma5 < ma20;
 51:   const isOverbought = (kdjJ != null && kdjJ >= 80) || (rsiVal != null && rsiVal >= 70);
 52:   const isOversold = (kdjJ != null && kdjJ <= 20) || (rsiVal != null && rsiVal <= 30);
 53:   if (isOverbought && isGoldenCross && isMaBull) return { label: '超买·减仓', color: COLOR.CAUTION, title: 'KDJ/RSI 超买 + 金叉多头' };
 54:   if (isOversold) return { label: '超卖·关注反弹', color: COLOR.BOTTOM, title: 'KDJ/RSI 超卖' };
 55:   if (isGoldenCross && isMaBull && macdVal != null && macdVal > 0) return { label: '金叉多头·买入', color: COLOR.BULL, title: 'MACD 金叉 + MA 多头 + 红柱' };
 56:   if (isGoldenCross && isMaBull) return { label: '多头·持有', color: COLOR.BULL, title: 'MACD 金叉 + MA 多头' };
 57:   if (isDeathCross && isMaBear && macdVal != null && macdVal < 0) return { label: '死叉空头·减仓', color: COLOR.BEAR, title: 'MACD 死叉 + MA 空头 + 绿柱' };
 58:   if (isDeathCross && isMaBear) return { label: '空头·谨慎', color: COLOR.BEAR, title: 'MACD 死叉 + MA 空头' };
 59:   if (isMaBull) return { label: '偏多·持有', color: COLOR.BULL, title: 'MA5 > MA20 多头排列' };
 60:   if (isMaBear) return { label: '偏空·观望', color: COLOR.BEAR, title: 'MA5 < MA20 空头排列' };
 61:   return { label: '中性·观望', color: COLOR.NEUTRAL, title: '无显著趋势信号' };
 62: }
 63: /**
 64:  * 机构 / 游资综合结论
 65:  * 输入：{ instNet, yzNet }
 66:  * 基于 4 档组合判断主力行为
 67:  */
 68: export function getOrgConclusion({ instNet, yzNet } = {}) {
 69:   const instPositive = instNet != null && instNet > 0;
 70:   const yzPositive = yzNet != null && yzNet > 0;
 71:   const instNegative = instNet != null && instNet < 0;
 72:   const yzNegative = yzNet != null && yzNet < 0;
 73:   if (instPositive && yzPositive) return { label: '主力吸筹·跟进', color: COLOR.BULL, title: '机构净流入 + 游资净流入' };
 74:   if (instNegative && yzNegative) return { label: '主力出逃·减仓', color: COLOR.BEAR, title: '机构净流出 + 游资净流出' };
 75:   if (instPositive && yzNegative) return { label: '机构买·游资卖·分歧', color: COLOR.CAUTION, title: '机构净流入但游资净流出，分歧加剧' };
 76:   if (instNegative && yzPositive) return { label: '机构卖·游资买·分歧', color: COLOR.CAUTION, title: '机构净流出但游资净流入，分歧加剧' };
 77:   return { label: '无主力信号·观望', color: COLOR.NEUTRAL, title: '机构与游资均无显著动作' };
 78: }
 79: /**
 80:  * 资金流向综合结论
 81:  * 输入：{ hitTags, mainNet }
 82:  * 基于 hitTags.capital + 主力净额方向
 83:  */
 84: export function getFlowConclusion({ hitTags = [], mainNet } = {}) {
 85:   const isCapitalBurst = (hitTags || []).includes('capital');
 86:   if (isCapitalBurst) return { label: '主力爆买·加仓', color: COLOR.STRONG, title: '主力资金爆买信号触发' };
 87:   if (mainNet != null && mainNet > 0) return { label: '资金流入·持有', color: COLOR.BULL, title: '主力净流入' };
 88:   if (mainNet != null && mainNet < 0) return { label: '资金流出·减仓', color: COLOR.BEAR, title: '主力净流出' };
 89:   return { label: null, color: COLOR.NEUTRAL, title: '无主力资金数据' };
 90: }
 91: /**
 92:  * 板块综合结论 — 直接使用已计算的 sectorEffect
 93:  * 输入：sectorEffect 对象（{ label, color, icon }）+ 板块基础数据
 94:  */
 95: export function getSectorConclusion(sectorEffect, sector, limitUp, secAvgChg) {
 96:   return {
 97:     label: sectorEffect?.label || null,
 98:     color: sectorEffect?.color || COLOR.NEUTRAL,
 99:     title: `板块: ${sector || '--'} · 涨停 ${limitUp ?? 0} · 涨幅 ${secAvgChg != null ? secAvgChg.toFixed(2) + '%' : '--'}`,
100:   };
101: }
102: /**
103:  * 市场综合结论 — 精简为单行仓位建议
104:  * 输入：{ riskStage, riskScore, msState }
105:  * 输出：{ label, color, title, position, extra }
106:  *
107:  * 系统性风险 veto：高危强制清仓，与个股板块信号无关
108:  * 与板块微观判断形成宏观-微观双层：板块=个股战场，市场=系统性风险背景
109:  */
110: export function getMarketConclusion({ riskStage, riskScore, msState } = {}) {
111:   const positionMap = {
112:     '高危':   { label: '0-20%·果断清仓', color: COLOR.RISK, position: '0-20%' },
113:     '高风险': { label: '0-20%·果断清仓', color: COLOR.RISK, position: '0-20%' },
114:     '警戒':   { label: '20-40%·减仓防守', color: COLOR.BULL, position: '20-40%' },
115:     '中风险': { label: '40-60%·谨慎', color: COLOR.CAUTION, position: '40-60%' },
116:     '关注':   { label: '60-80%·持有', color: COLOR.ATTENTION, position: '60-80%' },
117:     '低风险': { label: '80-100%·可加仓', color: COLOR.BEAR, position: '80-100%' },
118:     '安全':   { label: '80-100%·可加仓', color: COLOR.BEAR, position: '80-100%' },
119:   };
120:   const posInfo = riskStage ? (positionMap[riskStage] || { label: riskStage, color: COLOR.NEUTRAL, position: '--' }) : null;
121:   const stateAbbrev = {
122:     'IMPULSE': '脉冲',
123:     'TREND': '趋势',
124:     'CHOPPY': '震荡',
125:     'PENDING': '待计算',
126:     'UNKNOWN': '未知',
127:   };
128:   const stateLabel = stateAbbrev[msState] || null;
129:   return {
130:     label: posInfo?.label || null,
131:     color: posInfo?.color || COLOR.NEUTRAL,
132:     position: posInfo?.position || '--',
133:     stateLabel,
134:     title: `市场状态: ${msState || '--'} · 风险等级: ${riskStage || '--'} · 风险评分: ${riskScore != null ? riskScore : '--'}`,
135:   };
136: }
137: /**
138:  * 实时栏标题 — 右侧实时栏的动态时间标签
139:  * 输入：rtDash（{ mode, snapshot_time }）
140:  * 输出：{ label, color, title }
141:  * mode: live=今天盘中；closed_today=今日已收盘；previous=回退到最近交易日
142:  */
143: export function getRealtimeHeader(rtDash) {
144:   if (!rtDash) return { label: '🟢 实时', color: COLOR.NEUTRAL, title: '' };
145:   const mode = rtDash.mode;
146:   const iso = rtDash.snapshot_time;
147:   let timeStr = '';
148:   let dateStr = '';
149:   if (iso) {
150:     const dt = new Date(iso);
151:     if (!Number.isNaN(dt.getTime())) {
152:       const hh = String(dt.getHours()).padStart(2, '0');
153:       const mm = String(dt.getMinutes()).padStart(2, '0');
154:       timeStr = `${hh}:${mm}`;
155:       const md = `${dt.getMonth() + 1}月${dt.getDate()}日`;
156:       dateStr = md;
157:     }
158:   }
159:   if (mode === 'live') return { label: `🟢 实时滚动 ${timeStr}`.trim(), color: COLOR.BEAR, title: `快照: ${iso || ''}` };
160:   if (mode === 'closed_today') return { label: `🟠 盘后定格 ${timeStr}`.trim(), color: COLOR.CAUTION, title: `快照: ${iso || ''}` };
161:   if (mode === 'previous') return { label: `上一交易日 ${dateStr} ${timeStr}`.trim(), color: COLOR.NEUTRAL, title: `快照: ${iso || ''}` };
162:   return { label: timeStr ? `🟢 ${timeStr}` : '🟢 实时', color: COLOR.NEUTRAL, title: `快照: ${iso || ''}` };
163: }
164: /**
165:  * 提取实时栏标签的纯净文本（去除前缀 emoji）
166:  * 配合 ModuleHeader 使用：右侧标题只显示时间部分，emoji 由 ModuleHeader 的 icon 提供
167:  */
168: export function stripRealtimePrefix(label = '') {
169:   return label.replace(/^🟢\s*/, '').replace(/^🟠\s*/, '').replace(/^上一交易日\s*/, '上一交易日 ');
170: }
</file>

