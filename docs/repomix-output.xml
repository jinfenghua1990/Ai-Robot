<file path="backend/api/analysis_reports.py">
  1: """研报中心 API（PG 支撑版本）
  2: 端点契约与旧 JSON 文件版保持一致，前端无需改动：
  3:   POST /request                  提交分析请求（入队 pending，consumer 自动消费）
  4:   GET  /requests                 列出请求（可按 status 过滤）
  5:   GET  /result/{id}              获取报告（解析 report_json）
  6:   GET  /results                  列出已完成报告
  7:   GET  /notifications            通知列表 + 未读数
  8:   POST /notifications/read/{id}  标记已读
  9:   GET  /status/{id}              查询请求状态
 10:   POST /generate-recap          生成盘后复盘（sina 指数，落 PG）
 11:   GET  /recap                    获取最新复盘
 12:   POST /generate-recaps-batch   批量补最近5个交易日复盘
 13: """
 14: import json
 15: import os
 16: import uuid
 17: from datetime import datetime, timedelta
 18: from fastapi import APIRouter, Query, Body
 19: from sqlalchemy import select, desc
 20: from db.connection import SessionLocal
 21: from db.models import AnalysisRequest, AnalysisReport, Notification
 22: router = APIRouter(prefix="/api/analysis", tags=["analysis"])
 23: # ---------- 请求入队 ----------
 24: @router.post("/request")
 25: def create_request(
 26:     stock_code: str = Body(...),
 27:     stock_name: str = Body(''),
 28:     source: str = Body('tdx', description="tdx/ifind"),
 29: ):
 30:     """提交个股分析请求（入队 pending，由 analysis_consumer 自动消费生成）"""
 31:     rid = uuid.uuid4().hex[:12]
 32:     now = datetime.now()
 33:     req = AnalysisRequest(
 34:         id=rid,
 35:         stock_code=stock_code.strip(),
 36:         stock_name=stock_name or stock_code,
 37:         source=source,
 38:         status='pending',
 39:         created_at=now,
 40:         updated_at=now,
 41:     )
 42:     with SessionLocal() as db:
 43:         db.add(req)
 44:         db.commit()
 45:     return {'ok': True, 'request_id': rid, 'status': 'pending'}
 46: @router.get("/requests")
 47: def list_requests(status: str = Query('', description="pending/completed/failed/all")):
 48:     """列出分析请求"""
 49:     with SessionLocal() as db:
 50:         q = select(AnalysisRequest)
 51:         if status and status != 'all':
 52:             q = q.where(AnalysisRequest.status == status)
 53:         q = q.order_by(desc(AnalysisRequest.created_at))
 54:         items = db.execute(q).scalars().all()
 55:         data = [{
 56:             'id': r.id, 'stock_code': r.stock_code, 'stock_name': r.stock_name,
 57:             'source': r.source, 'status': r.status, 'error': r.error,
 58:             'created_at': r.created_at.isoformat() if r.created_at else '',
 59:             'updated_at': r.updated_at.isoformat() if r.updated_at else '',
 60:         } for r in items]
 61:     return {'ok': True, 'requests': data, 'count': len(data)}
 62: @router.get("/result/{request_id}")
 63: def get_result(request_id: str):
 64:     """获取分析结果（解析 report_json）"""
 65:     with SessionLocal() as db:
 66:         rep = db.get(AnalysisReport, request_id)
 67:         if not rep:
 68:             return {'ok': False, 'error': 'not_found'}
 69:         data = json.loads(rep.report_json)
 70:     return {'ok': True, 'result': data}
 71: @router.get("/results")
 72: def list_results(limit: int = Query(50), source: str = Query('')):
 73:     """列出所有已完成的报告"""
 74:     with SessionLocal() as db:
 75:         q = select(AnalysisReport)
 76:         if source:
 77:             q = q.where(AnalysisReport.source == source)
 78:         q = q.order_by(desc(AnalysisReport.created_at)).limit(limit)
 79:         items = db.execute(q).scalars().all()
 80:         data = [json.loads(r.report_json) for r in items]
 81:     return {'ok': True, 'results': data, 'count': len(data)}
 82: @router.get("/notifications")
 83: def get_notifications():
 84:     """获取通知列表 + 未读数"""
 85:     with SessionLocal() as db:
 86:         items = db.execute(
 87:             select(Notification).order_by(desc(Notification.created_at)).limit(20)
 88:         ).scalars().all()
 89:         data = [{
 90:             'id': n.id, 'source': n.source, 'stock_code': n.stock_code,
 91:             'stock_name': n.stock_name, 'title': n.title, 'read': n.read,
 92:             'created_at': n.created_at.isoformat() if n.created_at else '',
 93:         } for n in items]
 94:         unread = sum(1 for n in items if not n.read)
 95:     return {'ok': True, 'notifications': data, 'unread_count': unread}
 96: @router.post("/notifications/read/{notif_id}")
 97: def mark_notification_read(notif_id: str):
 98:     """标记通知已读"""
 99:     with SessionLocal() as db:
100:         n = db.get(Notification, notif_id)
101:         if n:
102:             n.read = True
103:             db.commit()
104:     return {'ok': True}
105: @router.get("/status/{request_id}")
106: def get_request_status(request_id: str):
107:     """查询请求状态"""
108:     with SessionLocal() as db:
109:         req = db.get(AnalysisRequest, request_id)
110:         if not req:
111:             return {'ok': False, 'error': 'not_found'}
112:         has_result = db.get(AnalysisReport, request_id) is not None
113:     return {
114:         'ok': True,
115:         'request': {
116:             'id': req.id, 'stock_code': req.stock_code, 'stock_name': req.stock_name,
117:             'source': req.source, 'status': req.status, 'error': req.error,
118:             'created_at': req.created_at.isoformat() if req.created_at else '',
119:             'updated_at': req.updated_at.isoformat() if req.updated_at else '',
120:         },
121:         'has_result': has_result,
122:     }
123: # ---------- 盘后复盘（sina 指数）----------
124: def recap_exists(date_str: str) -> bool:
125:     rid = f"recap_{date_str}"
126:     with SessionLocal() as db:
127:         return db.get(AnalysisReport, rid) is not None
128: def build_and_persist_recap(date_str: str, now: datetime):
129:     """采集 sina 指数并生成复盘报告落 PG（幂等：今日已存在且含指数数据则跳过）。返回 (rid, created)。"""
130:     rid = f"recap_{date_str}"
131:     # 已存在且已有指数数据则跳过；占位（空指数）则覆盖重生成
132:     with SessionLocal() as db:
133:         rep = db.get(AnalysisReport, rid)
134:         if rep:
135:             try:
136:                 d = json.loads(rep.report_json)
137:                 if d.get("indices"):
138:                     return rid, False
139:             except Exception:
140:                 logger.debug("report_json parse failed", exc_info=False)
141:     indices_data = _collect_indices()
142:     recap = {
143:         'id': rid, 'stock_code': 'MARKET', 'stock_name': 'A股市场',
144:         'source': 'recap', 'created_at': now.isoformat(),
145:         'report_type': '盘后复盘报告', 'date': date_str,
146:         'indices': indices_data,
147:         'summary': {
148:             'rating': '中性', 'confidence': '高',
149:             'key_points': _recap_points(indices_data),
150:         },
151:         'disclaimer': '盘后复盘报告基于免费公开数据生成，仅供参考，不构成投资建议',
152:     }
153:     _persist_report(rid, 'MARKET', 'A股市场', 'recap', recap)
154:     return rid, True
155: @router.post("/generate-recap")
156: def generate_market_recap():
157:     """盘后复盘：采集当日市场数据生成复盘报告（落 PG）"""
158:     now = datetime.now()
159:     date_str = now.strftime('%Y-%m-%d')
160:     rid, created = build_and_persist_recap(date_str, now)
161:     return {'ok': True, 'request_id': rid, 'status': 'already_exists' if not created else 'created'}
162: @router.get("/recap")
163: def get_latest_recap():
164:     """获取最新复盘报告"""
165:     with SessionLocal() as db:
166:         rep = db.execute(
167:             select(AnalysisReport).where(AnalysisReport.source == 'recap')
168:             .order_by(desc(AnalysisReport.created_at)).limit(1)
169:         ).scalars().first()
170:         if not rep:
171:             return {'ok': True, 'has_recap': False, 'recap': None}
172:         recap = json.loads(rep.report_json)
173:     return {'ok': True, 'has_recap': True, 'recap': recap}
174: @router.post("/generate-recaps-batch")
175: def batch_generate_recaps():
176:     """批量生成最近5个工作日复盘（占位，落 PG）"""
177:     results = []
178:     now = datetime.now()
179:     for i in range(5):
180:         d = now - timedelta(days=i)
181:         if d.weekday() >= 5:
182:             continue
183:         date_str = d.strftime('%Y-%m-%d')
184:         rid = f'recap_{date_str}'
185:         with SessionLocal() as db:
186:             if db.get(AnalysisReport, rid):
187:                 continue
188:         recap = {
189:             'id': rid, 'stock_code': 'MARKET', 'stock_name': 'A股市场',
190:             'source': 'recap', 'created_at': d.isoformat(),
191:             'report_type': '盘后复盘报告', 'date': date_str, 'indices': {},
192:             'summary': {'rating': '中性', 'confidence': '低', 'key_points': [f'{date_str} 市场复盘报告（盘后数据）']},
193:             'disclaimer': '仅供参考，不构成投资建议',
194:         }
195:         _persist_report(rid, 'MARKET', 'A股市场', 'recap', recap)
196:         results.append(date_str)
197:     return {'ok': True, 'generated': results}
198: # ---------- 内部辅助 ----------
199: def _persist_report(rid, stock_code, stock_name, source, report_dict):
200:     """写 AnalysisReport + AnalysisRequest(completed) + Notification 到 PG。"""
201:     report_dict.setdefault('id', rid)
202:     rep = AnalysisReport(
203:         id=rid, stock_code=stock_code, stock_name=stock_name, source=source,
204:         report_type=report_dict.get('report_type', ''),
205:         rating=report_dict.get('summary', {}).get('rating', ''),
206:         target_price=str(report_dict.get('summary', {}).get('target_price', '')),
207:         confidence=report_dict.get('summary', {}).get('confidence', ''),
208:         report_json=json.dumps(report_dict, ensure_ascii=False),
209:         created_at=datetime.now(),
210:     )
211:     req = AnalysisRequest(
212:         id=rid, stock_code=stock_code, stock_name=stock_name, source=source,
213:         status='completed', created_at=datetime.now(), updated_at=datetime.now(),
214:     )
215:     notif = Notification(
216:         id=f'notif_{rid}', source=source, stock_code=stock_code, stock_name=stock_name,
217:         title=f'{date_str_title(report_dict)} 复盘报告' if source == 'recap' else f'{stock_name}({stock_code}) 个股分析报告',
218:         read=False, created_at=datetime.now(),
219:     )
220:     with SessionLocal() as db:
221:         db.merge(rep)
222:         db.merge(req)
223:         db.merge(notif)
224:         db.commit()
225: def date_str_title(report_dict):
226:     return report_dict.get('date', '')
227: def _collect_indices():
228:     indices_data = {}
229:     try:
230:         import httpx
231:         index_codes = {
232:             '上证指数': 's_sh000001', '深证成指': 's_sz399001',
233:             '创业板指': 's_sz399006', '科创50': 's_sh000688',
234:         }
235:         for name, code in index_codes.items():
236:             url = f'http://hq.sinajs.cn/list={code}'
237:             resp = httpx.get(url, headers={'Referer': 'https://finance.sina.com.cn'}, timeout=5)
238:             if resp.status_code == 200:
239:                 parts = resp.text.split(',')
240:                 if len(parts) >= 4:
241:                     indices_data[name] = {
242:                         'price': float(parts[1]) if parts[1] else 0,
243:                         'change_pct': float(parts[3]) if parts[3] else 0,
244:                     }
245:     except Exception:
246:         logger.debug("sina index parse failed", exc_info=False)
247:     return indices_data
248: def _recap_points(indices_data):
249:     pts = []
250:     for name in ['上证指数', '深证成指', '创业板指']:
251:         v = indices_data.get(name)
252:         if v:
253:             pts.append(f'{name} {v["price"]}点 ({(v["change_pct"]):.2f}%)')
254:     if not pts:
255:         pts.append('指数数据暂未采集')
256:     return pts
