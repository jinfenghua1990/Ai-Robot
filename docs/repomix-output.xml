261:         return None
262: # ─── 技术指标计算 ───────────────────────────────────────────────────────────────
263: def _calc_ma(closes: list[float], period: int) -> float | None:
264:     if len(closes) < period:
265:         return None
266:     return round(sum(closes[-period:]) / period, 4)
267: def _calc_rsi(closes: list[float], period: int = 14) -> float | None:
268:     if len(closes) < period + 1:
269:         return None
270:     gains, losses = [], []
271:     for i in range(1, len(closes)):
272:         delta = closes[i] - closes[i - 1]
273:         gains.append(max(0, delta))
274:         losses.append(max(0, -delta))
275:     if len(gains) < period:
276:         return None
277:     avg_gain = sum(gains[-period:]) / period
278:     avg_loss = sum(losses[-period:]) / period
279:     if avg_loss == 0:
280:         return 100.0
281:     rs = avg_gain / avg_loss
282:     return round(100 - 100 / (1 + rs), 2)
283: def _calc_change_pct(closes: list[float], periods: int) -> float | None:
284:     if len(closes) < periods + 1:
285:         return None
286:     old = closes[-(periods + 1)]
287:     new = closes[-1]
288:     if old == 0:
289:         return None
290:     return round((new - old) / old * 100, 2)
