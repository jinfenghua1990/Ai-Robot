 80: ## Task 2: 股东户数采集脚本
 81: 
 82: **Files:**
 83: - Create: `backend/collectors/holder_number_collector.py`
 84: 
 85: - [ ] **Step 1: 创建采集脚本**
 86: 
 87: ```python
 88: """股东户数/户均持股采集（Tushare stk_holdernumber）"""
 89: import os
 90: import sys
 91: from datetime import datetime, timedelta
 92: 
 93: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 94: 
 95: from db.connection import SessionLocal
 96: from db.models import StockHolderNumber
 97: from sqlalchemy.dialects.postgresql import insert as pg_insert
 98: import tushare as ts
 99: 
100: 
101: def fetch_holder_number(ts_code: str = None, start_date: str = None, end_date: str = None, token: str = None):
102:     """从 Tushare 拉取股东户数数据"""
103:     if token is None:
104:         token = os.getenv('TUSHARE_TOKEN')
105:     if not token:
106:         raise RuntimeError('TUSHARE_TOKEN not set')
107:     pro = ts.pro_api(token)
108:     params = {}
109:     if ts_code:
110:         params['ts_code'] = ts_code
111:     if start_date:
112:         params['start_date'] = start_date
113:     if end_date:
114:         params['end_date'] = end_date
115:     df = pro.stk_holdernumber(**params)
116:     if df is None or df.empty:
117:         return []
118:     df = df.where(df.notna(), None)
119:     rows = []
120:     for _, r in df.iterrows():
121:         rows.append({
122:             'ts_code': r.get('ts_code'),
123:             'name': r.get('name'),
124:             'ann_date': _parse_date(r.get('ann_date')),
125:             'end_date': _parse_date(r.get('end_date')),
126:             'holder_num': int(r.get('holder_num') or 0),
127:             'avg_shares': float(r.get('avg_shares') or 0),
128:         })
129:     return rows
130: 
131: 
132: def _parse_date(v):
133:     if not v:
134:         return None
135:     if isinstance(v, str):
136:         return datetime.strptime(v, '%Y%m%d').date()
137:     return v
138: 
139: 
140: def save_rows(rows):
141:     if not rows:
142:         return 0
143:     db = SessionLocal()
144:     try:
145:         for row in rows:
146:             stmt = pg_insert(StockHolderNumber).values(**row)
147:             stmt = stmt.on_conflict_do_update(
148:                 index_elements=['ts_code', 'ann_date'],
149:                 set_={
150:                     'name': stmt.excluded.name,
151:                     'end_date': stmt.excluded.end_date,
152:                     'holder_num': stmt.excluded.holder_num,
153:                     'avg_shares': stmt.excluded.avg_shares,
154:                 }
155:             )
156:             db.execute(stmt)
157:         db.commit()
158:         return len(rows)
159:     finally:
160:         db.close()
161: 
162: 
163: def run_full_refresh():
164:     """全量：拉最近 5 年数据"""
165:     end = datetime.now().strftime('%Y%m%d')
166:     start = (datetime.now() - timedelta(days=365 * 5)).strftime('%Y%m%d')
167:     rows = fetch_holder_number(start_date=start, end_date=end)
168:     return save_rows(rows)
169: 
170: 
171: def run_daily():
172:     """增量：拉最近 90 天，覆盖最新一期"""
173:     end = datetime.now().strftime('%Y%m%d')
174:     start = (datetime.now() - timedelta(days=90)).strftime('%Y%m%d')
175:     rows = fetch_holder_number(start_date=start, end_date=end)
176:     return save_rows(rows)
177: 
178: 
179: if __name__ == '__main__':
180:     import argparse
181:     parser = argparse.ArgumentParser()
182:     parser.add_argument('--full', action='store_true', help='full refresh')
183:     args = parser.parse_args()
184:     count = run_full_refresh() if args.full else run_daily()
185:     print(f'saved {count} rows')
186: ```
