<file path="frontend/src/components/sections/ModuleGroup.jsx">
 1: /**
 2:  * 模块组：统一的通栏对比容器
 3:  * 标题在通栏顶部，下方左右两栏按【标题行】【副标题行】【内容行】分别对齐，
 4:  * 保证左右 chart 顶部/底部严格对齐。
 5:  *
 6:  * 用法：
 7:  *   <ModuleGroup title="板块热度" badge="..." extra={...}>
 8:  *     <ModuleGroup.Header left={...} right={...} />
 9:  *     <ModuleGroup.SubHeader left={...} right={...} />
10:  *     <ModuleGroup.Content left={...} right={...} />
11:  *   </ModuleGroup>
12:  *
13:  * contentHeight: 内容行高度，默认 280px；列表类模块可传 'auto'。
14:  */
15: export function ModuleGroup({ title, badge, extra, children, contentHeight = '280px' }) {
16:   const slots = { header: { left: null, right: null }, subHeader: { left: null, right: null }, content: { left: null, right: null } };
17:   const arr = Array.isArray(children) ? children : [children];
18:   arr.forEach(child => {
19:     if (!child) return;
20:     if (child.type === ModuleGroupHeader) slots.header = { left: child.props.left, right: child.props.right };
21:     else if (child.type === ModuleGroupSubHeader) slots.subHeader = { left: child.props.left, right: child.props.right };
22:     else if (child.type === ModuleGroupContent) slots.content = { left: child.props.left, right: child.props.right };
23:   });
24:   const isAutoHeight = contentHeight === 'auto';
25:   const resolvedContentHeight = isAutoHeight ? 'auto' : contentHeight;
26:   const Cell = ({ children }) => (
27:     <div className="min-w-0">
28:       {children}
29:     </div>
30:   );
31:   const ContentCell = ({ children }) => (
32:     <div className="flex flex-col" style={{ minHeight: isAutoHeight ? undefined : '280px' }}>
33:       {children}
34:     </div>
35:   );
36:   return (
37:     <div className="rounded-xl border p-2.5"
38:       style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)' }}>
39:       {/* 通栏标题 */}
40:       <div className="flex items-center justify-between flex-wrap gap-2 mb-2">
41:         <div className="flex items-center gap-2">
42:           <h2 className="text-base font-bold" style={{ color: 'var(--text-primary)' }}>{title}</h2>
43:           {badge && (
44:             <span className="px-1.5 py-0.5 rounded text-[10px] font-normal align-middle"
45:               style={{ background: 'rgba(234,179,8,0.1)', color: '#eab308' }}>{badge}</span>
46:           )}
47:         </div>
48:         {extra && (
49:           <div className="flex items-center gap-2">{extra}</div>
50:         )}
51:       </div>
52:       {/* 左右两栏：标题行 / 副标题行 / 内容行 分别对齐 */}
53:       <div className="grid grid-cols-1 lg:grid-cols-2 gap-2"
54:         style={{ gridTemplateRows: `auto auto ${resolvedContentHeight}` }}>
55:         <Cell>{slots.header.left}</Cell>
56:         <Cell>{slots.header.right}</Cell>
57:         {slots.subHeader.left || slots.subHeader.right ? (
58:           <>
59:             <Cell>{slots.subHeader.left}</Cell>
60:             <Cell>{slots.subHeader.right}</Cell>
61:           </>
62:         ) : null}
63:         <ContentCell>{slots.content.left}</ContentCell>
64:         <ContentCell>{slots.content.right}</ContentCell>
65:       </div>
66:     </div>
67:   );
68: }
69: function ModuleGroupHeader({ left, right }) { return null; }
70: function ModuleGroupSubHeader({ left, right }) { return null; }
71: function ModuleGroupContent({ left, right }) { return null; }
