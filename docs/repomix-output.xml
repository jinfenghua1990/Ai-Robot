215:                     'total_inflow': round(total_inflow, 0),
216:                     'total_outflow': round(total_outflow, 0),
217:                     'net_flow': round(total_inflow - total_outflow, 0),
218:                     'dominant_style': dominant_style,
219:                     'leader_total': len(leaders),
220:                 },
