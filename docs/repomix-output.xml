<file path="frontend/src/components/trading/KLineChart.jsx">
  1: import { memo, useEffect, useRef, useState } from 'react';
  2: import { createChart, CandlestickSeries, LineSeries, AreaSeries } from 'lightweight-charts';
  3: import { UP_COLOR, DOWN_COLOR, B_SIGNAL_COLOR, S_SIGNAL_COLOR } from '../../utils/colors';
  4: import { apiFetch } from '../../utils/request';
  5: /**
  6:  * K线图组件（memoized：仅在 code 变化时重新拉取渲染）
  7:  * 叠加：
  8:  *  - 蜡烛K线（价格）
  9:  *  - SuperTrend 操盘线（黄色）
 10:  *  - 板块趋势线（紫色 Area）：该股所属板块的近期热量走势，独立 Y 轴
 11:  *  - B/S 买卖点 markers
 12:  */
 13: function KLineChart({ code, height = 260 }) {
 14:   const containerRef = useRef(null);
 15:   const chartRef = useRef(null);
 16:   const seriesRef = useRef({});
 17:   const [loading, setLoading] = useState(true);
 18:   const [err, setErr] = useState('');
 19:   useEffect(() => {
 20:     let cancelled = false;
 21:     setLoading(true);
 22:     setErr('');
 23:     (async () => {
 24:       try {
 25:         const { ok, data, error } = await apiFetch(`/api/trading/bs-signals?stockCode=${code}&datalen=120`);
 26:         if (cancelled) return;
 27:         if (!ok) { setErr(error || '加载失败'); setLoading(false); return; }
 28:         if (data.detail) throw new Error(data.detail);
 29:         render(data);
 30:         setLoading(false);
 31:       } catch (e) {
 32:         if (!cancelled) { setErr(e.message); setLoading(false); }
 33:       }
 34:     })();
 35:     return () => { cancelled = true; cleanup(); };
 36:   }, [code]);
 37:   function cleanup() {
 38:     if (chartRef.current) {
 39:       try { chartRef.current.remove(); } catch {}
 40:       chartRef.current = null;
 41:       seriesRef.current = {};
 42:     }
 43:   }
 44:   function render(data) {
 45:     cleanup();
 46:     if (!containerRef.current) return;
 47:     const klines = data.klines || [];
 48:     if (klines.length === 0) { setErr('无K线数据'); return; }
 49:     const chart = createChart(containerRef.current, {
 50:       width: containerRef.current.clientWidth,
 51:       height,
 52:       layout: { background: { color: 'transparent' }, textColor: '#9ca3af' },
 53:       grid: { vertLines: { color: 'rgba(255,255,255,0.04)' }, horzLines: { color: 'rgba(255,255,255,0.04)' } },
 54:       timeScale: { borderColor: 'rgba(255,255,255,0.1)', timeVisible: false },
 55:       rightPriceScale: { borderColor: 'rgba(255,255,255,0.1)' },
 56:       crosshair: { mode: 1 },
 57:     });
 58:     chartRef.current = chart;
 59:     // 1) K线
 60:     const candle = chart.addSeries(CandlestickSeries, {
 61:       upColor: UP_COLOR, downColor: DOWN_COLOR,
 62:       borderUpColor: UP_COLOR, borderDownColor: DOWN_COLOR,
 63:       wickUpColor: UP_COLOR, wickDownColor: DOWN_COLOR,
 64:     });
 65:     candle.setData(klines.map(k => ({
 66:       time: k.date,
 67:       open: k.open, high: k.high, low: k.low, close: k.close,
 68:     })));
 69:     seriesRef.current.candle = candle;
 70:     // 2) SuperTrend 操盘线（与 K线同 Y 轴，多头=绿支撑 / 空头=红阻力）
 71:     const supertrend = data.indicators?.supertrend || [];
 72:     if (supertrend.length > 0) {
 73:       const line = chart.addSeries(LineSeries, {
 74:         color: '#eab308', lineWidth: 2, title: 'SuperTrend',
 75:         priceLineVisible: false, lastValueVisible: false,
 76:       });
 77:       const points = [];
 78:       klines.forEach((k, i) => {
 79:         if (supertrend[i] != null) points.push({ time: k.date, value: supertrend[i] });
 80:       });
 81:       line.setData(points);
 82:       seriesRef.current.supertrend = line;
 83:     }
 84:     // 3) 板块趋势线 - 独立 Y 轴，紫色 Area
 85:     // strategy_engine 已经在 watchlist signal.sectorTrend.heat_series 暴露 7 天板块数据
 86:     // 这里直接从 watchlist 缓存里取
 87:     const sectorSeries = buildSectorSeries(code, klines);
 88:     if (sectorSeries && sectorSeries.length > 0) {
 89:       const heatLine = chart.addSeries(AreaSeries, {
 90:         priceScaleId: 'sector',
 91:         lineColor: '#a855f7', topColor: 'rgba(168,85,247,0.4)', bottomColor: 'rgba(168,85,247,0.05)',
 92:         lineWidth: 2, title: '板块热量',
 93:         priceLineVisible: false, lastValueVisible: false,
 94:       });
 95:       heatLine.setData(sectorSeries);
 96:       seriesRef.current.heatLine = heatLine;
 97:       chart.priceScale('sector').applyOptions({
 98:         scaleMargins: { top: 0.7, bottom: 0 },  // 板块线放主图顶部 30% 区域
 99:         borderColor: 'rgba(168,85,247,0.3)',
100:       });
101:     }
102:     // 4) BS 点 markers
103:     const techSignals = data.techSignals || [];
104:     if (techSignals.length > 0) {
105:       const markers = techSignals.map(s => ({
106:         time: s.date,
107:         position: s.type === 'B' ? 'belowBar' : 'aboveBar',
108:         color: s.type === 'B' ? B_SIGNAL_COLOR : S_SIGNAL_COLOR,
109:         shape: s.type === 'B' ? 'arrowUp' : 'arrowDown',
110:         text: s.type,
111:       }));
112:       try { candle.setMarkers(markers); } catch { /* chart cleanup: ignore */ }
113:     }
114:     // 自适应
115:     chart.timeScale().fitContent();
116:     const ro = new ResizeObserver(entries => {
117:       const w = entries[0]?.contentRect?.width;
118:       if (w) chart.applyOptions({ width: w });
119:     });
120:     ro.observe(containerRef.current);
121:     seriesRef.current._ro = ro;
122:   }
123:   // 7 天板块热度序列对齐到 K线时间轴（最近一天对齐到 K线最后一天）
124:   function buildSectorSeries(code, klines) {
125:     // 同步拿一下 watchlist 缓存里的 sectorTrend
126:     // 简单做法：直接 fetch /api/watchlist 拿到 selected 的 sectorTrend
127:     // 但这里为了避免 race condition，直接从全局 fetch
128:     const data = window.__wlSectorCache || {};
129:     const heatSeries = data[code];
130:     if (!heatSeries || heatSeries.length === 0) return null;
131:     // 对齐：板块 series 7 天 → 摊到 K线最后 7 根上
132:     const tail = klines.slice(-heatSeries.length);
133:     if (tail.length === 0) return null;
134:     return tail.map((k, i) => ({
135:       time: k.date,
136:       value: heatSeries[i]?.heat ?? 0,
137:     })).filter(p => p.value != null);
138:   }
139:   if (err) return <div className="h-full flex items-center justify-center text-xs" style={{ color: '#ef4444' }}>{err}</div>;
140:   return (
141:     <div className="relative">
142:       {loading && <div className="absolute inset-0 flex items-center justify-center text-xs" style={{ color: 'var(--text-muted)' }}>加载K线…</div>}
143:       <div ref={containerRef} style={{ height }} />
144:     </div>
145:   );
146: }
147: export default memo(KLineChart);
</file>

