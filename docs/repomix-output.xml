266:                     vol_ratio = (k.volume / float(klines[0].volume)) if k.volume else 1.0
267:                 # 板块资金流向符号（查当日该板块的 net_flow）
268:                 # 用 StockFlow 查当日同板块资金流向作为参考
269:                 sector_sign = 0
