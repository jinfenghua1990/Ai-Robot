 21: def calc_rsi(closes, period=14):
 22:     """计算RSI指标"""
 23:     deltas = np.diff(closes)
 24:     gains = np.where(deltas > 0, deltas, 0)
 25:     losses = np.where(deltas < 0, -deltas, 0)
 26:     avg_gain = np.mean(gains[-period:])
 27:     avg_loss = np.mean(losses[-period:])
 28:     if avg_loss == 0:
 29:         return 100
 30:     rs = avg_gain / avg_loss
 31:     return 100 - (100 / (1 + rs))
