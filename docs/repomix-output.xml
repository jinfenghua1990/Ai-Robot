 59: def _quantile_means(pairs: list[tuple[float, float]], direction: int, buckets: int = 5) -> list[float]:
 60:     if len(pairs) < buckets * 2:
 61:         return []
 62:     ordered = sorted(pairs, key=lambda item: item[0])
 63:     result = []
 64:     for index in range(buckets):
 65:         start = index * len(ordered) // buckets
 66:         end = (index + 1) * len(ordered) // buckets
 67:         values = [item[1] for item in ordered[start:end]]
 68:         result.append(mean(values) if values else 0.0)
