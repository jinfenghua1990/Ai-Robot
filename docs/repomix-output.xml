<file path="backend/api/panorama.py">
 1: """
 2: 板块全景个股增强 API
 3: - /api/panorama/stocks  批量将个股代码列表增强为完整 18 字段 signal 数据
 4: """
 5: import logging
 6: from fastapi import APIRouter, Body
 7: from starlette.concurrency import run_in_threadpool
 8: from pydantic import BaseModel
 9: from typing import List, Optional
10: from sqlalchemy import func
11: from db.session import get_db_session
12: from db.models import WatchlistSignalDaily
13: from services.signal_builder import build_signal_for_stock, build_signal_from_precomputed
14: import asyncio
15: router = APIRouter()
16: logger = logging.getLogger(__name__)
17: class StockItem(BaseModel):
18:     ts_code: str
19:     name: str = ''
20:     sector: str = ''
21:     main_force_inflow: Optional[float] = None
22:     price_chg: Optional[float] = None
23: class EnrichRequest(BaseModel):
24:     stocks: List[StockItem]
25: def _normalize_ts_code(code: str) -> str:
26:     """统一转成 600000.SH / 000001.SZ 格式"""
27:     if '.' in code:
28:         return code
29:     return f"{code}.SH" if code[0] in ('6', '9') else f"{code}.SZ"
30: def _load_precomputed_map(db, stocks: list) -> dict:
31:     """同步查预计算表（最近交易日），返回 {normalized_ts_code: row}"""
32:     precomputed_map = {}
33:     ts_codes = []
34:     for item in stocks:
35:         code = item.ts_code.split('.')[0] if '.' in item.ts_code else item.ts_code
36:         if code and len(code) == 6:
37:             ts_codes.append(_normalize_ts_code(code))
38:     if not ts_codes:
39:         return precomputed_map
40:     latest_date = db.query(func.max(WatchlistSignalDaily.trade_date)).scalar()
41:     if latest_date:
42:         rows = db.query(WatchlistSignalDaily).filter(
43:             WatchlistSignalDaily.trade_date == latest_date,
44:             WatchlistSignalDaily.ts_code.in_(ts_codes),
45:         ).all()
46:         for row in rows:
47:             precomputed_map[row.ts_code] = row
48:     return precomputed_map
49: @router.post("/api/panorama/stocks")
50: async def enrich_panorama_stocks(req: EnrichRequest = Body(...)):
51:     """批量增强个股列表为完整 signal 数据（用于板块全景个股列表展示）
52:     优先读预计算表（WatchlistSignalDaily），命中则跳过 K线/BS/板块现场计算；
53:     未命中才 fallback 到 build_signal_for_stock。
54:     """
55:     if not req.stocks:
56:         return {'stocks': []}
57:     with get_db_session() as db:
58:         # 批量查预计算表（丢线程池避免阻塞事件循环）
59:         precomputed_map = await run_in_threadpool(_load_precomputed_map, db, req.stocks)
60:         async def _enrich(item: StockItem):
61:             ts_code = item.ts_code
62:             code = ts_code.split('.')[0] if '.' in ts_code else ts_code
63:             if not code or len(code) != 6:
64:                 return None
65:             try:
66:                 normalized = _normalize_ts_code(code)
67:                 precomputed = precomputed_map.get(normalized)
68:                 if precomputed:
69:                     signal = await build_signal_from_precomputed(
70:                         code, item.name, precomputed, db=db,
71:                     )
72:                 else:
73:                     signal = await build_signal_for_stock(
74:                         code, item.name, item.sector, db,
75:                         change_rate=item.price_chg,
76:                     )
77:                 signal['mainForceInflow'] = item.main_force_inflow or 0
78:                 signal['priceChg'] = item.price_chg or 0
79:                 return signal
80:             except Exception as e:
81:                 logger.warning(f'enrich {ts_code} failed: {e}')
82:                 return None
83:         tasks = [_enrich(item) for item in req.stocks]
84:         results = await asyncio.gather(*tasks, return_exceptions=True)
85:         enriched = [r for r in results if r is not None and not isinstance(r, Exception)]
86:         return {'stocks': enriched}
