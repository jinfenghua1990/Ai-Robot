  1: """资金气象雷达 API
  2: - GET /api/fund-weather  返回自选股按机构/游资双轨资金博弈划分的气象分组
  3: """
  4: import logging
  5: from datetime import datetime
  6: from typing import Dict, List, Optional
  7: from fastapi import APIRouter
  8: from sqlalchemy.orm import Session
  9: from db.session import get_db_session
 10: from db.models import YuziSeatDaily, YuziDict
 11: from api.watchlist.core import get_watchlist
 12: router = APIRouter()
 13: logger = logging.getLogger(__name__)
 14: # === 天气配置 ===
 15: WEATHER_CONFIG = {
 16:     'storm': {
 17:         'key': 'storm',
