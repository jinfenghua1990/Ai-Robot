274: // ─── 真实数据接入 ─────────────────────────────────────────────────────────────
275: // 后端 /api/global-market/fundamentals/{market}（腾讯 gtimg）返回每只股票的 real 真实字段：
276: //   pe / pb / divYield / marketCap(亿元) / pePercentile(52周估值分位)
277: // 用真实值覆盖 estimateFundamentals 的对应估算，其余维度保留估算。
278: export async function fetchFundamentals(market) {
279:   try {
280:     const res = await apiFetch(`/api/global-market/fundamentals/${market}`, {}, 60000, 0);
281:     if (res && res.ok && res.data && res.data.items) return res.data.items;
282:   } catch (e) { /* 失败则回退估算 */ }
283:   return null;
284: }
285: // 港股通南向资金（后端 Eastmoney，尽力取真实，失败为 null）
286: export async function fetchSouthbound() {
287:   try {
288:     const res = await apiFetch(`/api/global-market/southbound`, {}, 40000, 0);
289:     if (res && res.ok && res.data) return res.data;
290:   } catch (e) { /* 失败则回退估算 */ }
291:   return null;
292: }
293: /**
294:  * 合并真实基本面到估算：返回 { f, real }
295:  *  - f：估算被打底，real 中的真实字段（pe/pb/divYield/marketCap/pePercentile）覆盖之
296:  *  - real：本次取到的真实字段对象（用于页面「实时」徽标）；null 表示全部为估算
297:  */
298: export function mergeFundamentals(market, code, realObj) {
299:   const est = estimateFundamentals(market, code);
300:   const real = realObj && realObj.real ? realObj.real : null;
301:   if (!real || !Object.keys(real).length) return { f: est, real: null };
302:   return { f: { ...est, ...real }, real };
303: }
