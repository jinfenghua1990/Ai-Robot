 33: logger = logging.getLogger(__name__)
 34: router = APIRouter(prefix="/api/us-quant", tags=["us-quant"])
 35: # ─── 数据源（可插拔：Nasdaq 主源 + CBOE VIX + Yahoo 兜底 → 离线模拟最后兜底）──
 36: # 后端会先自动识别本机出网代理（macOS 系统代理 / HTTP(S)_PROXY），让请求能
 37: # 像浏览器一样走代理；详见 us_quant/data_provider.py
 38: def _fetch_yahoo(symbol: str, range_str: str = "1mo") -> list[dict] | None:
 39:     """委托给可插拔数据源（Nasdaq 实时主源 → Yahoo 兜底 → 离线模拟）。"""
 40:     from us_quant.data_provider import get_klines
 41:     return get_klines(symbol, range_str)
 42: def _fetch_quote(symbol: str) -> Optional[dict]:
 43:     """委托给可插拔数据源（Nasdaq 实时主源 → Yahoo 兜底 → 离线模拟）。"""
 44:     from us_quant.data_provider import get_quote
 45:     return get_quote(symbol)
 46: # ─── API 端点 ─────────────────────────────────────────────────────────────────
 47: @router.get("/regime")
 48: async def get_regime():
 49:     """获取当前市场环境状态"""
 50:     from us_quant.data_provider import get_klines_batch
 51:     _batch = get_klines_batch(["SPY", "QQQ", "IWM", "RSP"], "2mo")
 52:     indices = {
 53:         "SPY": _batch.get("SPY"),
 54:         "QQQ": _batch.get("QQQ"),
 55:         "IWM": _batch.get("IWM"),
 56:         "RSP": _batch.get("RSP"),
 57:         "^VIX": _fetch_yahoo("^VIX", "1mo"),
 58:     }
 59:     def _make_quote(symbol, klines, name) -> IndexQuote:
 60:         if not klines or len(klines) < 2:
 61:             return IndexQuote(symbol=symbol, name=name, price=0, change_pct=0)
 62:         closes = [k["close"] for k in klines if k.get("close")]
 63:         prices = [k["close"] for k in klines if k.get("close")]
 64:         price = prices[-1] if prices else 0
 65:         change_pct = (prices[-1] - prices[-2]) / prices[-2] * 100 if len(prices) >= 2 else 0
 66:         ma20 = sum(closes[-20:]) / min(20, len(closes)) if len(closes) >= 20 else None
 67:         ma50 = sum(closes[-50:]) / min(50, len(closes)) if len(closes) >= 50 else None
 68:         return IndexQuote(
