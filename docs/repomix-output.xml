108:             'level': 'error',
109:             'category': 'collection_gap',
110:             'message': f'[{trade_date}] 今日无任何实时个股快照数据，实时采集完全中断',
111:             'details': {'row_count': 0, 'latest_time': None},
112:         }
113:         record_alert(**result, trade_date=trade_date)
114:         return result
115:     now = datetime.now()
116:     gap_seconds = int((now - latest_time).total_seconds())
117:     # 简单交易时段判定（9:30-11:30, 13:00-15:00）
118:     weekday = now.weekday()
