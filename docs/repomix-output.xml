 12: from typing import Dict, Any, Optional
 13: import ssl
 14: import warnings
 15: warnings.filterwarnings('ignore')
 16: DEFAULT_BASE_URL = "https://dgzt.guosen.com.cn/skills"
 17: SOFT_NAME = "goldsun_skills"
 18: TIMEOUT_SECONDS = 60
