253:     return DATA_SOURCES
254: def get_available_sources():
255:     """获取所有已启用的数据源"""
256:     return {k: v for k, v in DATA_SOURCES.items() if v['available']}
257: def get_sources_for_indicator(indicator):
258:     """获取支持某指标的所有可用数据源，按优先级排序"""
259:     sources = [(k, v) for k, v in DATA_SOURCES.items()
260:                if v['available'] and indicator in v['indicators']]
261:     return sorted(sources, key=lambda x: x[1]['priority'])
262: def get_unlimited_sources(indicator=None):
263:     """获取无额度限制的数据源（用于高频采集）"""
264:     sources = {k: v for k, v in DATA_SOURCES.items()
265:                if v['available'] and not v['rate_limited']}
266:     if indicator:
267:         sources = {k: v for k, v in sources.items() if indicator in v['indicators']}
268:     return sources
269: def get_rate_limited_sources(indicator=None):
270:     """获取有额度限制的数据源（用于低频验证）"""
271:     sources = {k: v for k, v in DATA_SOURCES.items()
272:                if v['available'] and v['rate_limited']}
273:     if indicator:
274:         sources = {k: v for k, v in sources.items() if indicator in v['indicators']}
275:     return sources
276: def register_source(name, config):
