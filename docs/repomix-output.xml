  2: # -*- coding: utf-8 -*-
  3: """
  4: 🛡️ 风险退出模块 - 从 wave_band 卖出信号独立出来
  5: 卖出信号（任一触发即预警）：
  6: 1. 单日跌幅 > 5%（止损线）
  7: 2. RSI6 > 75 且收盘跌破 MA5（短线见顶）
  8: 3. 收盘跌破 MA10 × 97%（趋势走坏）
  9: 定位：不是选股策略，而是持仓风险预警模块。
 10:     不产生"买入"信号，只产生"退出/减仓"预警。
 11:     在个股详情页和自选股列表展示。
 12: """
 13: import logging
 14: logger = logging.getLogger(__name__)
 15: def risk_exit_check(kline, day_index=-1):
 16:     """
 17:     风险退出检查
 18:     参数:
 19:         kline: K线数据列表（oldest-first），每个元素含 close/open/low/high/volume 字段
 20:         day_index: 检查哪一天（默认-1，最新一天）
 21:     返回:
 22:         有风险信号返回 dict，无信号返回 None
 23:     """
 24:     try:
 25:         if day_index == -1:
 26:             day_index = len(kline) - 1
 27:         if day_index < 0 or day_index >= len(kline) or len(kline) < 21:
 28:             return None
 29:         closes = [float(k['close']) for k in kline]
 30:         last_close = closes[-1]
 31:         # 计算 MA
 32:         ma5 = sum(closes[-5:]) / 5 if len(closes) >= 5 else None
 33:         ma10 = sum(closes[-10:]) / 10 if len(closes) >= 10 else None
 34:         # 计算 RSI6
 35:         from strategies.baihu_v30 import calc_rsi
 36:         rsi6 = calc_rsi(closes, period=6)
 37:         # 当日涨幅
 38:         change_pct = ((last_close - closes[-2]) / closes[-2] * 100) if len(closes) >= 2 else 0
 39:         # 逐条检查退出信号
 40:         signals = []
 41:         if change_pct < -5:
 42:             signals.append({
 43:                 'type': 'stop_loss',
 44:                 'severity': 'critical',
 45:                 'label': '止损',
 46:                 'reason': f'单日跌幅 {change_pct:.2f}%，触发止损',
 47:             })
 48:         if rsi6 is not None and rsi6 > 75 and ma5 and last_close < ma5:
 49:             signals.append({
 50:                 'type': 'overbought',
 51:                 'severity': 'warning',
 52:                 'label': '见顶预警',
 53:                 'reason': f'RSI6={rsi6:.1f}>75 + 跌破MA5({ma5:.2f})，短线见顶',
 54:             })
 55:         if ma10 and last_close < ma10 * 0.97:
 56:             signals.append({
