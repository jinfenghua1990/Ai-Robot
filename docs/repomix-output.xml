166:                     'outlier_count': 0,
167:                     'deviations': [],
168:                     'scores': [],
169:                     'daily': [],
170:                 }
171:             s = source_summary[r.source]
172:             s['total_count'] += r.total_count or 0
173:             s['outlier_count'] += r.outlier_count or 0
174:             if r.avg_deviation is not None:
175:                 s['deviations'].append(float(r.avg_deviation))
176:             if r.reliability_score is not None:
