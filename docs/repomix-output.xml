392:         return {"total": 0, "inserted": 0, "updated": 0, "filtered_out": 0}
393:     now = _now()
394:     total = len(raw)
395:     filtered_out = 0
396:     inserted = 0
397:     updated = 0
398:     with get_db_session() as db:
399:         for item in raw:
400:             if not _passes_research_filters(item):
401:                 filtered_out += 1
402:                 continue
403:             symbol = item["symbol"]
404:             existing = db.query(USInstrument).filter(USInstrument.symbol == symbol).first()
405:             if existing:
406:                 # 更新行情数据
407:                 changed = False
408:                 for field, src_key in [
409:                     ("price", "price"), ("market_cap", "market_cap"),
410:                     ("volume", "volume"), ("avg_dollar_volume_20d", "turnover"),
411:                 ]:
412:                     val = _numf(item.get(src_key))
413:                     if val is not None and getattr(existing, field) != val:
414:                         setattr(existing, field, val)
415:                         changed = True
416:                 if item.get("name"):
417:                     existing.name = item["name"]
418:                 if item.get("exchange"):
419:                     existing.exchange = item["exchange"]
420:                 existing.is_active = True
421:                 existing.universe_source = "eastmoney"
422:                 existing.data_updated_at = now
423:                 if changed:
424:                     updated += 1
425:             else:
426:                 db.add(USInstrument(
427:                     symbol=symbol,
428:                     name=item.get("name"),
429:                     exchange=item.get("exchange"),
430:                     price=_numf(item.get("price")),
431:                     market_cap=_numf(item.get("market_cap")),
432:                     volume=item.get("volume"),
433:                     avg_dollar_volume_20d=_numf(item.get("turnover")),
434:                     is_active=True,
435:                     universe_source="eastmoney",
436:                     data_updated_at=now,
437:                 ))
438:                 inserted += 1
439:         db.commit()
440:     logger.info(f"[universe] 研究池刷新: 总 {total}, 筛选淘汰 {filtered_out}, "
441:                 f"新增 {inserted}, 更新 {updated}")
442:     return {"total": total, "inserted": inserted, "updated": updated, "filtered_out": filtered_out}
