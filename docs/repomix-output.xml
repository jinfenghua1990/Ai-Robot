  1: """
  2: 📋 量价报告策略 API
  3: 按 CodeBuddy 量价筛选报告逻辑，返回3层分层结果：
  4: - priority: 优先买入（只做条件触发，不追高）
  5: - wait:     等回踩确认（逻辑尚可，位置需优化）
  6: - avoid:    暂不参与（高位、破位或性价比不足）
  7: 每只股票含：5种形态分类 + 关键指标 + 具体交易计划（买入价位+止损价位）
  8: """
  9: import logging
 10: import threading
 11: import concurrent.futures
 12: from fastapi import APIRouter, Query
 13: from db.session import get_db_session
 14: from db.models import StockFlow
 15: from strategies.liangjia_report import get_kline_from_tdx, liangjia_report_strategy
 16: from api.validators import validate_date
 17: from services.signal_builder import build_signals_batch, build_signals_from_strategy_result, _enrich_signals_with_watchlist_extras
 18: logger = logging.getLogger(__name__)
 19: router = APIRouter()
 20: _kline_cache = {}
 21: _cache_lock = threading.Lock()
 22: def _get_kline_cached(ts_code, days=60):
 23:     with _cache_lock:
 24:         if ts_code in _kline_cache:
 25:             return _kline_cache[ts_code]
 26:     kline = get_kline_from_tdx(ts_code, days)
 27:     if kline:
 28:         with _cache_lock:
 29:             _kline_cache[ts_code] = kline
 30:     return kline
 31: def _screen_one(ts_code, trade_date):
 32:     try:
 33:         kline = _get_kline_cached(ts_code, 60)
 34:         if kline and len(kline) >= 30:
 35:             result = liangjia_report_strategy(kline)
 36:             if result:
 37:                 result['ts_code'] = ts_code
 38:                 if trade_date:
 39:                     result['trade_date'] = trade_date
 40:                 return result
 41:     except Exception:
 42:         logger.debug('liangjia _screen_one fallback', exc_info=True)
 43:     return None
 44: @router.get("/api/liangjia-report")
 45: async def liangjia_report(date: str = Query(None)):
 46:     """量价报告策略选股（3层分层 + 交易计划）"""
 47:     trade_date = validate_date(date)
 48:     try:
 49:         with get_db_session() as db:
 50:             # 优先读预计算表
 51:             _precomputed = await build_signals_from_strategy_result(db, 'liangjia_report', trade_date)
 52:             if _precomputed is not None:
 53:                 return _format_response(trade_date, _precomputed, len(_precomputed), 'ok(预计算)')
 54:             # 1. 候选池：全市场当日主力净流入>0，按主力净流入降序取前80只
 55:             candidates = db.query(StockFlow).filter(
 56:                 StockFlow.trade_date == trade_date,
 57:                 StockFlow.main_force_inflow > 0,
 58:             ).order_by(StockFlow.main_force_inflow.desc()).limit(80).all()
 59:             stock_list = [c.ts_code for c in candidates]
 60:             stock_name_map = {c.ts_code: c.name for c in candidates}
 61:             stock_sector_map = {c.ts_code: c.sector for c in candidates}
 62:             if not stock_list:
 63:                 return _format_response(trade_date, [], 0, '无候选股票')
 64:             # 2. 并发执行量价报告选股
 65:             hits = []
 66:             with concurrent.futures.ThreadPoolExecutor(max_workers=20) as executor:
 67:                 futures = {executor.submit(_screen_one, code, trade_date): code for code in stock_list}
 68:                 for future in concurrent.futures.as_completed(futures, timeout=60):
 69:                     try:
 70:                         result = future.result(timeout=5)
 71:                         if result:
 72:                             hits.append(result)
 73:                     except Exception:
 74:                         logger.debug('liangjia future fallback', exc_info=True)
 75:             # 3. 格式化结果
 76:             results = []
 77:             for h in hits:
 78:                 ts_code = h.get('ts_code', '')
 79:                 results.append({
 80:                     'ts_code': ts_code,
 81:                     'name': stock_name_map.get(ts_code, ''),
 82:                     'sector': stock_sector_map.get(ts_code, ''),
 83:                     'score': h.get('score', 0),
 84:                     'pattern': h.get('pattern', ''),
 85:                     'pattern_desc': h.get('pattern_desc', ''),
 86:                     'tier': h.get('tier', ''),
 87:                     'tier_label': h.get('tier_label', ''),
 88:                     'close': float(h.get('close', 0)),
 89:                     'change_pct': round(float(h.get('change_pct', 0)), 2),
 90:                     'gain5d': round(float(h.get('gain5d', 0)), 2),
 91:                     'gain20d': round(float(h.get('gain20d', 0)), 2),
 92:                     'vol_ratio_20': round(float(h.get('vol_ratio_20', 0)), 2),
 93:                     'distance_to_high_20': round(float(h.get('distance_to_high_20', 0)), 2),
 94:                     'deviation_ma20': round(float(h.get('deviation_ma20', 0)), 2),
 95:                     'rsi': round(float(h.get('rsi', 0)), 1),
 96:                     'ma5': float(h.get('ma5', 0)),
 97:                     'ma10': float(h.get('ma10', 0)),
