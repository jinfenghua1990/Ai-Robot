578:                 if wsig == 'buy' and float(wconf or 0) > 50:
579:                     positive_factors.append({'factor': '波浪买入', 'detail': f'波浪信号: {str(wreason)[:30]}', 'weight': 1})
580:                 elif wsig == 'sell' and float(wconf or 0) > 50:
581:                     negative_factors.append({'factor': '波浪卖出', 'detail': f'波浪信号: {str(wreason)[:30]}', 'weight': -1})
582:         except Exception:
583:             logger.debug("signal_builder: margin factor failed", exc_info=False)
584:     score = len(positive_factors) - len(negative_factors)
585:     reasons.append(f'综合评分: {"看多" if score > 0 else "看空" if score < 0 else "中性"} → {signal_label}')
586:     # 计算风险等级（预计算模式不涉及持仓）
587:     features = market_state_data.get('features') or {}
