615:         'qualityStatus': quality_status,
616:         'buyPower': buy_power,
617:         'marketState': market_state_data,
618:         'lifecycleStage': lifecycle_stage,
619:     }
620: async def build_signals_from_strategy_result(
621:     db, strategy_key: str, trade_date: str, *,
622:     stage: str = '策略选股',
623: ) -> Optional[List[dict]]:
624:     """从 strategy_result 预计算表读取策略命中，用 WatchlistSignalDaily 富化
625:     返回 enriched signals 列表；无预计算数据时返回 None（调用方 fallback 现场计算）。
626:     跳过 K线/BS/板块/市场状态的现场计算，仅拉实时 quote（30s缓存）。
627:     """
628:     from db.models import StrategyResult, WatchlistSignalDaily
629:     from sqlalchemy import func
630:     rows = db.query(StrategyResult).filter(
631:         StrategyResult.trade_date == trade_date,
632:         StrategyResult.strategy_key == strategy_key,
633:     ).order_by(StrategyResult.score.desc()).all()
634:     if not rows:
635:         return None
636:     ts_codes = [r.ts_code for r in rows]
637:     latest_date = db.query(func.max(WatchlistSignalDaily.trade_date)).scalar()
638:     precomputed_map = {}
639:     if latest_date:
640:         wl_rows = db.query(WatchlistSignalDaily).filter(
641:             WatchlistSignalDaily.trade_date == latest_date,
642:             WatchlistSignalDaily.ts_code.in_(ts_codes),
643:         ).all()
644:         for wl_row in wl_rows:
645:             precomputed_map[wl_row.ts_code] = wl_row
646:     # 批量查 LeaderLifecycle 真实生命周期阶段（非龙头股查不到则显示"未入选"）
647:     lifecycle_map = _get_lifecycle_map(db, ts_codes, trade_date)
648:     tasks = []
649:     for row in rows:
650:         code = row.ts_code.split('.')[0] if '.' in row.ts_code else row.ts_code
651:         precomputed = precomputed_map.get(row.ts_code)
652:         _lifecycle = lifecycle_map.get(row.ts_code) or '未入选'
653:         if precomputed:
654:             tasks.append(build_signal_from_precomputed(
655:                 code, row.name, precomputed,
656:                 stage=stage, strength=float(row.score or 0),
657:                 lifecycle_stage=_lifecycle,
658:             ))
659:         else:
660:             tasks.append(build_signal_for_stock(
661:                 code, row.name, row.sector, db,
662:                 stage=stage, strength=float(row.score or 0),
663:                 lifecycle_stage=_lifecycle,
664:             ))
665:     results = await asyncio.gather(*tasks, return_exceptions=True)
666:     enriched = []
667:     for i, r in enumerate(results):
668:         if isinstance(r, Exception) or r is None:
669:             continue
670:         row = rows[i]
671:         detail = json.loads(row.detail_json or '{}')
672:         r['strategyScore'] = float(row.score or 0)
673:         r['deviation'] = float(detail.get('deviation', 0))
674:         r['rsi'] = float(detail.get('rsi', 0))
675:         r['scores'] = json.loads(row.scores_json or '{}')
676:         r['lowerShadow'] = float(detail.get('lower_shadow', 0))
677:         if strategy_key in ('baihu_v30', 'liangjia_report'):
678:             r['ma20'] = float(detail.get('ma20', 0))
679:             r['volRatio'] = float(detail.get('vol_ratio', 0))
680:             r['20dayGain'] = float(detail.get('20day_gain', 0))
681:         if strategy_key == 'baihu_v30':
682:             r['strategyMode'] = detail.get('mode', '')
683:             r['ma5'] = float(detail.get('ma5', 0))
684:             r['ma10'] = float(detail.get('ma10', 0))
685:             r['distanceToHigh20'] = float(detail.get('distance_to_high_20', 0))
686:         if strategy_key == 'liangjia_report':
687:             # 量价报告策略：5种形态 + 3层分层 + 交易计划 + 合并维度
688:             r['pattern'] = detail.get('pattern', '')
689:             r['patternDesc'] = detail.get('pattern_desc', '')
690:             r['tier'] = detail.get('tier', '')
691:             r['tierLabel'] = detail.get('tier_label', '')
692:             r['gain5d'] = float(detail.get('gain5d', 0))
693:             r['gain20d'] = float(detail.get('gain20d', 0))
694:             r['volRatio20'] = float(detail.get('vol_ratio_20', 0))
695:             r['distanceToHigh20'] = float(detail.get('distance_to_high_20', 0))
696:             r['deviationMa20'] = float(detail.get('deviation_ma20', 0))
697:             r['deviationMa5'] = float(detail.get('deviation_ma5', 0))
698:             r['ma5'] = float(detail.get('ma5', 0))
699:             r['ma10'] = float(detail.get('ma10', 0))
700:             r['ma20'] = float(detail.get('ma20', 0))
701:             r['ma20Rising'] = bool(detail.get('ma20_rising', False))
702:             r['bullAlignment'] = bool(detail.get('bull_alignment', False))
703:             r['tradePlan'] = detail.get('trade_plan', {})
704:             r['strategyMode'] = detail.get('pattern', '')  # 复用 SignalCard 模式标签
705:             # 合并吸收的维度
706:             r['breakout10d'] = bool(detail.get('breakout_10d', False))
707:             r['breakoutPct'] = float(detail.get('breakout_pct', 0))
708:             r['mainForceDays'] = int(detail.get('main_force_days', 0))
709:             r['hasMainForce'] = bool(detail.get('has_main_force', False))
710:         if strategy_key == 'risk_exit':
711:             r['worstSeverity'] = detail.get('worst_severity', '')
712:             r['worstLabel'] = detail.get('worst_label', '')
713:             r['worstReason'] = detail.get('worst_reason', '')
714:             r['riskSignals'] = detail.get('signals', [])
715:         enriched.append(r)
716:     # 补充自选股个股模块字段（moneyFlow/hitTags/actionHint），让 SignalCard 显示完整信息
717:     await _enrich_signals_with_watchlist_extras(db, enriched)
718:     return enriched
719: # 缓存 _enrich_signals_with_watchlist_extras 的中间结果（moneyflow_map + hit_tags_map）
720: # 这些都是盘后数据，2 分钟内不会变化；避免 81 只股票的 11+ 次 DB 查询重复执行（首次 6-9s → 命中 <100ms）
721: _enrich_extras_cache = BoundedDict(maxsize=50)  # key: frozenset(codes) -> (timestamp, moneyflow_map, hit_tags_map)
722: _ENRICH_EXTRAS_CACHE_TTL = 120  # 2 分钟
723: async def _enrich_signals_with_watchlist_extras(db, signals: List[dict]) -> None:
724:     """为 signal 列表批量补充自选股个股模块的 3 个字段（原地修改）：
725:     - moneyFlow: 4 档资金流 + 1/2/3/4/5 日累计（盘后数据）
726:     - hitTags:   7 大命中标签（yuzi/strategy/trend/capital/popularity/support/accumulation）
727:     - actionHint: 根据命中标签组合生成的操作方向文案
728:     与自选股 build_watchlist 完全一致的口径，确保 SignalCard 中列资金流向模块和 HitTagBar 正常渲染。
729:     """
730:     if not signals:
731:         return
732:     # 复用 watchlist.core 的批量函数，保证口径一致
733:     from api.watchlist.core import _batch_moneyflow_map, _batch_hit_tags
734:     stock_codes = [s.get('secCode') for s in signals if s.get('secCode')]
735:     if not stock_codes:
736:         return
737:     # 检查缓存（盘后数据，2 分钟 TTL）
738:     cache_key = frozenset(stock_codes)
739:     now = time.time()
740:     cached = _enrich_extras_cache.get(cache_key)
741:     if cached and now - cached[0] < _ENRICH_EXTRAS_CACHE_TTL:
742:         moneyflow_map, hit_tags_map = cached[1], cached[2]
743:     else:
744:         # 批量拉资金流 + 命中标签（11+ 次 DB 查询，首次 6-9s）
745:         moneyflow_map = _batch_moneyflow_map(db, stock_codes)
746:         sectors_map = {s.get('secCode'): s.get('sector', '') for s in signals}
747:         hit_tags_map = _batch_hit_tags(db, stock_codes, sectors_map)
748:         _enrich_extras_cache[cache_key] = (now, moneyflow_map, hit_tags_map)
749:     for s in signals:
750:         code = s.get('secCode')
751:         if not code or len(code) != 6:
752:             continue
753:         ts_code = f"{code}.SH" if code[0] in ('6', '9') else f"{code}.SZ"
754:         # moneyFlow（缺失时给空壳，前端显示"暂无盘后数据"）；浅拷贝避免污染缓存
755:         if 'moneyFlow' not in s or not s.get('moneyFlow'):
756:             mf = moneyflow_map.get(ts_code)
757:             s['moneyFlow'] = dict(mf) if mf else {
758:                 'available': False, 'main_net': 0, 'super_large': 0,
759:                 'large': 0, 'small': 0, 'tiny': 0, 'turnover_rate': 0,
760:                 'inflow_1d': 0, 'inflow_2d': 0, 'inflow_3d': 0,
761:                 'inflow_4d': 0, 'inflow_5d': 0, 'flow_continuity': 0,
762:             }
763:         # hitTags + actionHint；浅拷贝 list 避免污染缓存
764:         hit_info = hit_tags_map.get(ts_code, {})
765:         s.setdefault('hitTags', list(hit_info.get('hit_tags', [])))
766:         s.setdefault('actionHint', hit_info.get('action_hint', ''))
