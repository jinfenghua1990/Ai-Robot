206:         "bear_case": _bear_case(feat, kline_analysis, target_price_val, price),
207:         "risk_factors": [
208:             "PG 盘后数据 T+1 延迟：盘中/当日实时变动不反映在此报告",
209:             "F10 财务/评级未补全时，估值与评级仅为初步判断",
210:             "概念/行业分类需结合 F10 补全，当前行业字段为占位",
211:             "市场有风险，本报告由数据自动生成，不构成投资建议",
212:         ],
