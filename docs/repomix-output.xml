107: def fetch_research_universe_from_eastmoney() -> list[dict]:
108:     """从东财 clist API 拉取 NASDAQ + NYSE 股票列表（分页，按市值降序）
109:     返回格式：[{symbol, name, price, market_cap, volume, exchange, ...}]
110:     NOTE: 东财 push2 API 在本机网络环境可能不通，
111:           失败时返回空列表，由调用方决定是否降级。
112:     """
113:     try:
114:         from services.research.astock import em_get
115:     except ImportError:
116:         logger.warning("[universe] astock.em_get 不可用，跳过东财拉取")
117:         return []
118:     all_stocks = []
119:     page = 1
120:     page_size = 500
121:     max_pages = 20  # 最多拉 10000 只（安全上限）
122:     params_base = {
123:         "po": 1, "np": 1, "fltt": 2, "invt": 2,
124:         "fid": "f20",  # 按市值排序
125:         "fs": "m:1 t:2,m:1 t:3",  # NASDAQ + NYSE
126:         "fields": "f12,f14,f2,f3,f4,f5,f6,f15,f16,f17,f18,f20,f21",
127:     }
128:     headers = {"User-Agent": "Mozilla/5.0"}
129:     for page in range(1, max_pages + 1):
130:         params = dict(params_base)
131:         params["pn"] = page
132:         params["pz"] = page_size
133:         try:
134:             r = em_get("https://push2.eastmoney.com/api/qt/clist/get",
135:                        params=params, headers=headers, timeout=15)
136:             data = r.json().get("data")
137:             if not data:
138:                 break
139:             diff = data.get("diff") or []
140:             if not diff:
141:                 break
142:             for item in diff:
143:                 symbol = str(item.get("f12") or "")
144:                 name = str(item.get("f14") or "")
145:                 if not symbol or not name:
146:                     continue
147:                 all_stocks.append({
148:                     "symbol": symbol,
149:                     "name": name,
150:                     "price": _numf(item.get("f2")),
151:                     "change_pct": _numf(item.get("f3")),
152:                     "volume": item.get("f4") or item.get("f5") or 0,
153:                     "turnover": item.get("f6") or 0,  # 成交额
154:                     "market_cap": item.get("f20") or 0,  # 总市值
155:                     "float_cap": item.get("f21") or 0,
156:                     "exchange": "NASDAQ" if item.get("f15") == 105 else "NYSE",
157:                 })
158:             logger.info(f"[universe] 东财拉取第 {page} 页: {len(diff)} 条")
159:             if len(diff) < page_size:
160:                 break
161:             time.sleep(0.3)  # 限流
162:         except Exception as exc:
163:             logger.warning(f"[universe] 东财拉取第 {page} 页失败: {exc}")
164:             break
165:     logger.info(f"[universe] 东财拉取完成: 共 {len(all_stocks)} 只")
166:     return all_stocks
167: def _numf(v):
168:     """安全转数字"""
169:     if v is None:
170:         return None
171:     try:
172:         return float(v)
173:     except (TypeError, ValueError):
174:         return None
