 1: import { memo, useCallback, useMemo } from 'react';
 2: import SignalCard from './SignalCardV4';
 3: import CardSafetyBoundary from '../CardSafetyBoundary';
 4: /**
 5:  * 自选股列表项（memoized）
 6:  * 关键优化：通过 React.memo 避免点击切换选中时 164 张卡片全部重渲染。
 7:  * 只有 isSelected 变化的 2 张卡（旧选中→未选中、新选中→选中）会重渲染。
 8:  *
 9:  * onSelect/onSell 是 useState setter（React 保证引用稳定），onRemove 需在父层 useCallback。
10:  *
11:  * 模块级空数组常量：避免每次 render 新建 [] 击穿下游 SignalCardV4 的 memo。
12:  * （默认参数 orders=[] 和 strategyTags=[] 每次都创建新引用，是 memo 杀手）
13:  */
14: const EMPTY_ORDERS = [];
15: const EMPTY_TAGS = [];
16: function WatchlistItem({ signal, isSelected, realtimeFlow, onSelect, onRemove, onSell, onRefresh, batchMode, checked, onToggleCheck, onAnalyze, strategyTags = EMPTY_TAGS }) {
17:   const handleClick = useCallback((e) => {
18:     // 如果点击的是按钮或弹窗，不触发选中
19:     if (e.target.closest('button') || e.target.closest('.fixed')) return;
20:     batchMode ? onToggleCheck?.(signal.secCode) : onSelect(signal.secCode);
21:   }, [batchMode, onToggleCheck, onSelect, signal.secCode]);
22:   const containerStyle = useMemo(() => ({
23:     outline: isSelected ? '2px solid #60a5fa' : (batchMode && checked ? '2px solid #f97316' : '2px solid transparent'),
24:     opacity: 1,
25:   }), [isSelected, batchMode, checked]);
26:   return (
27:     <div
28:       onClick={handleClick}
29:       className="cursor-pointer rounded-lg transition-all relative"
30:       style={containerStyle}
31:     >
32:       {/* 批量模式 checkbox */}
33:       {batchMode && (
34:         <div className="absolute top-1 left-1 z-10">
35:           <input
36:             type="checkbox"
37:             checked={!!checked}
38:             onChange={() => onToggleCheck?.(signal.secCode)}
39:             onClick={(e) => e.stopPropagation()}
40:             className="w-4 h-4 cursor-pointer"
41:           />
42:         </div>
43:       )}
44:       <CardSafetyBoundary>
45:         <SignalCard
46:           signal={signal}
47:           orders={EMPTY_ORDERS}
48:           onSell={onSell}
49:           onRemove={onRemove}
50:           onRefresh={onRefresh}
51:           onAnalyze={onAnalyze}
52:           showWatchBtn={false}
53:           // 自选页现在是持仓状态管理页，不在这里把未持仓标的当成买入信号。
54:           showBuyBtn={false}
55:           mode="watchlist"
56:           showAnalysisButton
57:           showActionButton={!batchMode}
58:           strategyTags={strategyTags}
59:           realtimeFlow={realtimeFlow}
60:           showRealtimeDetail={isSelected}
61:         />
62:       </CardSafetyBoundary>
63:     </div>
64:   );
65: }
66: export default memo(WatchlistItem);
</file>

