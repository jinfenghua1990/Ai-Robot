<file path="backend/db/session.py">
 1: """DB 会话上下文管理器
 2: 用法:
 3:     with get_db_session() as db:
 4:         rows = db.query(XXX).all()
 5:     # 自动关闭，即使发生异常
 6: 向后兼容：原有的 db = next(get_db()) ... db.close() 模式不受影响。
 7: """
 8: from contextlib import contextmanager
 9: from db.connection import SessionLocal
10: @contextmanager
11: def get_db_session():
12:     """提供自动关闭的 DB 会话，替代 next(get_db()) + try/finally/close"""
13:     db = SessionLocal()
14:     try:
15:         yield db
16:     finally:
17:         db.close()
</file>

<file path="backend/quant_service/service.py">
 1: """
 2: AIROBOT Quant Service —— Qlib 因子/ML 排序 + VectorBT 扫描 的独立微服务。
 3: 设计要点：
 4: - 跑在独立 Python 3.11 venv（不污染 9000 主服务的系统 Python 3.9）。
 5: - qlib / vectorbt 延迟导入：未安装或未就绪时服务仍可启动，/api/score 与
 6:   /api/scan 返回 {"ready": False, "phase": "Phase0", ...}，前端据此显示
 7:   “数据准备中”，页面永不空白。
 8: - 主服务 9000 通过 /api/quant/* 反代到本服务（默认 9003）。
 9: """
10: import os
11: import time
12: from typing import Optional
13: from fastapi import FastAPI, Request
14: from fastapi.responses import JSONResponse
15: QUANT_PORT = int(os.environ.get("QUANT_PORT", "9003"))
16: QUANT_HOST = os.environ.get("QUANT_HOST", "0.0.0.0")
17: app = FastAPI(title="AIROBOT Quant Service", version="0.1.0")
18: # ── 引擎就绪探测（延迟导入，避免缺包时服务崩溃）─────────────────────────
19: QLIB_READY = False
20: VECTORBT_READY = False
21: QLIB_ERROR: Optional[str] = None
22: VECTORBT_ERROR: Optional[str] = None
23: try:
24:     import qlib  # noqa: F401
25:     QLIB_READY = True
26: except Exception as e:  # pragma: no cover
27:     QLIB_ERROR = str(e)
28: try:
29:     import vectorbt  # noqa: F401
30:     VECTORBT_READY = True
31: except Exception as e:  # pragma: no cover
32:     VECTORBT_ERROR = str(e)
33: # Phase 0 数据仓就绪后由初始化逻辑置 True（当前默认未就绪）。
34: DATA_READY = False
35: SERVICE_STARTED_AT = time.strftime("%Y/%m/%d %H:%M:%S")
36: @app.get("/health")
37: def health():
38:     return {
39:         "status": "ok",
40:         "service": "quant",
41:         "port": QUANT_PORT,
42:         "qlib_ready": QLIB_READY,
43:         "vectorbt_ready": VECTORBT_READY,
44:         "data_ready": DATA_READY,
45:         "qlib_error": QLIB_ERROR,
46:         "vectorbt_error": VECTORBT_ERROR,
47:         "started_at": SERVICE_STARTED_AT,
48:     }
49: @app.post("/score")
50: async def score(payload: dict):
51:     """个股 ML 排序评分（Phase 1 由 Qlib 实现；当前返回 pending）。
52:     预期入参: {"market": "US", "codes": ["AAPL", "MSFT", ...]}
53:     就绪后返回: {"ready": True, "scores": {"AAPL": {"score": 82.3, "factors": {...}}}}
54:     """
55:     market = payload.get("market", "US")
56:     codes = payload.get("codes") or []
57:     if not QLIB_READY or not DATA_READY:
58:         return {
59:             "ready": False,
60:             "phase": "Phase0",
61:             "reason": "Qlib 或美股数据仓尚未就绪（见 requirements-ml.txt 与 Phase 0 数据准备）",
62:             "qlib_ready": QLIB_READY,
63:             "data_ready": DATA_READY,
64:             "market": market,
65:             "requested": codes,
66:             "scores": {},
67:         }
68:     # TODO Phase 1: 调 Qlib 跑 Alpha 因子 + 模型推理，返回排序分与关键因子。
69:     return {"ready": True, "market": market, "scores": {}}
70: @app.get("/scan")
71: async def scan(strategy: str = "longqing", market: str = "US", limit: int = 20):
72:     """策略扫描（Phase 2 由 VectorBT 实现高速批量扫描；当前返回 pending）。
73:     策略键: longqing(青龙趋势) / baihu(白虎突破) / huiche(回踩)
74:     """
75:     if not VECTORBT_READY or not DATA_READY:
76:         return {
77:             "ready": False,
78:             "phase": "Phase0",
79:             "reason": "VectorBT 或数据仓尚未就绪",
80:             "vectorbt_ready": VECTORBT_READY,
81:             "data_ready": DATA_READY,
82:             "strategy": strategy,
83:             "market": market,
84:             "hits": [],
85:         }
86:     # TODO Phase 2: VectorBT 向量化计算命中列表。
87:     return {"ready": True, "strategy": strategy, "market": market, "hits": []}
88: if __name__ == "__main__":
89:     import uvicorn
90:     uvicorn.run(app, host=QUANT_HOST, port=QUANT_PORT)
</file>

