 241: # ===== 兜底：StockFeaturesDaily 缺失时，从 K 线 + StockFlow 现场算近似特征 =====
 242: # 解决「共振列表 90%+ 股票不在 watchlist，features_daily 未被采集」导致 dashboard 不可用的问题。
 243: # 仅覆盖 dashboard 用到的核心指标：MA/ATR/RSI/close_vs_ma20/volume_ratio/higher_high/momentum/连续性。
 244: # sector_strength / noise_ratio 等仅在 features 里有真值，缺失时给中性默认（0.5 / 1.0）。
 245: def _features_from_kline_fallback(ts_code: str, target_date, db) -> Optional[dict]:
 246:     """从 K 线 + 资金流现场合成 features 字典，返回 None 表示 K 线不足。"""
 247:     klines = db.query(StockDailyKline).filter(
 248:         StockDailyKline.ts_code == ts_code,
 249:         StockDailyKline.trade_date <= target_date,
 250:     ).order_by(StockDailyKline.trade_date.asc()).limit(120).all()
 251:     if len(klines) < 30:
 252:         return None
 253:     closes = [float(k.close or 0) for k in klines if k.close is not None]
 254:     volumes = [float(k.volume or 0) for k in klines if k.volume is not None]
 255:     highs = [float(k.high or 0) for k in klines if k.high is not None]
 256:     lows = [float(k.low or 0) for k in klines if k.low is not None]
 257:     if len(closes) < 30:
 258:         return None
 259:     close = closes[-1]
 260:     ma5 = sum(closes[-5:]) / 5 if len(closes) >= 5 else close
 261:     ma20 = sum(closes[-20:]) / 20 if len(closes) >= 20 else close
 262:     ma60 = sum(closes[-60:]) / 60 if len(closes) >= 60 else close
 263:     close_vs_ma20 = (close / ma20 - 1) if ma20 > 0 else 0
 264:     # MA20 斜率：今日 ma20 vs 5 日前 ma20 的变化率
 265:     if len(closes) >= 25:
 266:         ma20_5d_ago = sum(closes[-25:-5]) / 20
 267:         ma20_slope = (ma20 / ma20_5d_ago - 1) if ma20_5d_ago > 0 else 0
 268:     else:
 269:         ma20_slope = 0
 270:     # ATR(14)：True Range 14 日平均
 271:     trs = []
 272:     for i in range(-14, 0):
 273:         if i == -14:
 274:             continue
 275:         h = highs[i]
 276:         l = lows[i]
 277:         pc = closes[i - 1]
 278:         tr = max(h - l, abs(h - pc), abs(l - pc))
 279:         trs.append(tr)
 280:     atr_14 = sum(trs) / len(trs) if trs else 0
 281:     # Volume ratio：今日 vol / 20日均量
 282:     vol_20_avg = sum(volumes[-20:]) / 20 if len(volumes) >= 20 else (volumes[-1] if volumes else 1)
 283:     volume_ratio = (volumes[-1] / vol_20_avg) if vol_20_avg > 0 else 1
 284:     # higher_high / higher_low_flag：今日 high/low 是否创 20 日新高/新低（严格 > / <）
 285:     high_20 = max(highs[-20:]) if len(highs) >= 20 else highs[-1]
 286:     low_20 = min(lows[-20:]) if len(lows) >= 20 else lows[-1]
 287:     higher_high_flag = 1 if highs[-1] > high_20 else 0
 288:     higher_low_flag = 1 if lows[-1] > low_20 else 0
 289:     # trend_consistency_score：近 20 日 close > ma20 的占比（0-1）
 290:     if len(closes) >= 20:
 291:         above = sum(1 for i in range(-20, 0) if closes[i] > ma20)
 292:         trend_consistency_score = above / 20
 293:     else:
 294:         trend_consistency_score = 0.5
 295:     # RSI(14)：Wilder 平滑
 296:     rsi_14 = 50
 297:     if len(closes) >= 15:
 298:         gains, losses = [], []
 299:         for i in range(-14, 0):
 300:             diff = closes[i] - closes[i - 1]
 301:             gains.append(max(diff, 0))
 302:             losses.append(max(-diff, 0))
 303:         avg_gain = sum(gains) / 14
 304:         avg_loss = sum(losses) / 14
 305:         if avg_loss > 0:
 306:             rs = avg_gain / avg_loss
 307:             rsi_14 = 100 - 100 / (1 + rs)
 308:         else:
 309:             rsi_14 = 100 if avg_gain > 0 else 50
 310:     # 资金流连续性：近 5 日 StockFlow 主力净流入正的天数
 311:     code6 = ts_code.split('.')[0]
 312:     flows = db.query(StockFlow).filter(
 313:         StockFlow.ts_code == ts_code,
 314:         StockFlow.trade_date <= target_date,
 315:     ).order_by(StockFlow.trade_date.desc()).limit(5).all()
 316:     inflow_1d = float(flows[0].main_force_inflow or 0) if len(flows) >= 1 else 0
 317:     inflow_3d = sum(float(f.main_force_inflow or 0) for f in flows[:3]) if flows else 0
 318:     inflow_5d = sum(float(f.main_force_inflow or 0) for f in flows[:5]) if flows else 0
 319:     flow_continuity = sum(1 for f in flows if float(f.main_force_inflow or 0) > 0) if flows else 0
 320:     return {
 321:         'rsi_14': round(rsi_14, 2),
 322:         'volume_ratio': round(volume_ratio, 2),
 323:         'close_vs_ma20': round(close_vs_ma20, 4),
 324:         'higher_high_flag': higher_high_flag,
 325:         'higher_low_flag': higher_low_flag,
 326:         'trend_consistency_score': round(trend_consistency_score, 2),
 327:         'ma20_slope': round(ma20_slope, 4),
 328:         'main_net_inflow_1d': inflow_1d,
 329:         'main_net_inflow_3d': inflow_3d,
 330:         'main_net_inflow_5d': inflow_5d,
 331:         'flow_continuity': flow_continuity,
 332:         'sector_strength': 0,      # 兜底默认中性
 333:         'noise_ratio': 1.0,        # 兜底默认中性
 334:         'atr_14': round(atr_14, 4),
 335:         # 同步供 _compute_dashboard 后续用（避免再查一次）
 336:         '_close': close,
 337:     }
 338: # ===== 实时维度计算 =====
 339: def _compute_realtime(code: str, sector: str, db) -> dict:
 340:     """从 RealtimeStockFlow / RealtimeSectorFlow / StockMoneyFlowRealtime 算实时维度分。
 341:     取「最近一个有实时快照的交易日」而非严格今天，使盘后/非交易时段也能看到
 342:     最近一个交易时段的实时数据（避免非交易时段实时列恒为空白）。
 343:     live 标记：仅当快照所属交易日 == 今天 且 当前处于交易时段(09:30-15:00) 时才为 True，
 344:     否则为「上一交易日收盘快照」，前端据此诚实标注，不把历史数据伪装成实时。
 345:     """
 346:     latest_rt = db.query(func.max(RealtimeStockFlow.trade_date)).filter(
 347:         RealtimeStockFlow.ts_code.like(f'{code}.%')
 348:     ).scalar()
 349:     if not latest_rt:
 350:         return {'available': False}
 351:     today = latest_rt
 352:     now = datetime.now()
 353:     cur_time = now.time()
 354:     in_session = cur_time >= datetime.strptime('09:30', '%H:%M').time() and \
 355:                  cur_time <= datetime.strptime('15:00', '%H:%M').time()
 356:     live = (today == date.today()) and in_session
 357:     rt_flow = db.query(RealtimeStockFlow).filter(
 358:         RealtimeStockFlow.ts_code.like(f'{code}.%'),
 359:         RealtimeStockFlow.trade_date == today,
 360:     ).order_by(RealtimeStockFlow.snapshot_time.desc()).first()
 361:     if not rt_flow:
 362:         return {'available': False}
 363:     rt_pct_chg = float(rt_flow.price_chg or 0)
 364:     rt_main_force = float(rt_flow.main_force_inflow or 0) * 10000  # 万元→元
 365:     rt_snapshot_time = rt_flow.snapshot_time
 366:     # 机构
 367:     rt_money = db.query(StockMoneyFlowRealtime).filter(
 368:         StockMoneyFlowRealtime.ts_code.like(f'{code}.%'),
 369:         StockMoneyFlowRealtime.trade_date == today,
 370:     ).order_by(StockMoneyFlowRealtime.snapshot_time.desc()).first()
 371:     rt_main_net = float(rt_money.main_net or 0) if rt_money else 0
 372:     # 板块
 373:     rt_sector = db.query(RealtimeSectorFlow).filter(
 374:         RealtimeSectorFlow.sector == sector,
 375:         RealtimeSectorFlow.trade_date == today,
 376:     ).order_by(RealtimeSectorFlow.snapshot_time.desc()).first() if sector else None
 377:     rt_sector_net = float(rt_sector.net_flow or 0) if rt_sector else 0
 378:     rt_sector_rise = float(rt_sector.rise_ratio or 0) if rt_sector else 0
 379:     # ---- 5 个可算维度 ----
 380:     trend_rt = _clamp(50 + rt_pct_chg * (10 if rt_pct_chg >= 0 else 8), 0, 100)
 381:     mag_bonus = min(abs(rt_main_force) / 1e8, 3) * 10 if rt_main_force > 0 else \
 382:                 -min(abs(rt_main_force) / 1e8, 2) * 8
 383:     capital_rt = _clamp(50 + mag_bonus, 0, 100)
 384:     same_dir = (rt_main_force > 0) == (rt_sector_net > 0)
 385:     resonance_rt = 75 if (same_dir and abs(rt_main_force) > 1e6) else \
 386:                    55 if abs(rt_main_force) < 1e6 else 25
 387:     relative_rt = _clamp(50 + (rt_pct_chg - rt_sector_rise) * 12, 0, 100)
 388:     inst_rt = _clamp(
 389:         50 + (rt_main_net > 0) * 20 + min(abs(rt_main_net) / 5e7 * 15, 15) * (1 if rt_main_net > 0 else -1),
 390:         0, 100,
 391:     ) if rt_money else None
 392:     # ---- 当日分时序列（真正的实时时间维度）：价格 + 主力净流入随快照时间变化 ----
 393:     rt_series = db.query(RealtimeStockFlow).filter(
 394:         RealtimeStockFlow.ts_code.like(f'{code}.%'),
 395:         RealtimeStockFlow.trade_date == today,
 396:     ).order_by(RealtimeStockFlow.snapshot_time.asc()).all()
 397:     intraday = [{
 398:         't': r.snapshot_time.strftime('%H:%M') if r.snapshot_time else None,
 399:         'price': round(float(r.price or 0), 2) if r.price is not None else None,
 400:         'pct_chg': round(float(r.price_chg or 0), 2) if r.price_chg is not None else None,
 401:         'main_force': round(float(r.main_force_inflow or 0) * 10000) if r.main_force_inflow is not None else None,  # 万元→元
 402:     } for r in rt_series]
 403:     # ---- 从日内价格序列补齐剩余 3 个维度，使盘后/实时左右 8 维对齐 ----
 404:     prices = [float(r.price or 0) for r in rt_series if r.price is not None]
 405:     if len(prices) >= 2:
 406:         rt_high = max(prices)
 407:         rt_low = min(prices)
 408:         rt_current = prices[-1]
 409:         # 波动健康：日内振幅（与盘后 ATR/close 口径不同但语义一致）
 410:         if rt_low > 0:
 411:             amplitude_pct = (rt_high - rt_low) / rt_low * 100
 412:             if 1.0 <= amplitude_pct <= 5.0:
 413:                 volatility_rt = 80
 414:             elif 0.5 <= amplitude_pct <= 8.0:
 415:                 volatility_rt = 60
 416:             else:
 417:                 volatility_rt = 35
 418:         else:
 419:             volatility_rt = 50
 420:         # 回撤状态：当前价相对日内高点的回撤
 421:         if rt_high > 0:
 422:             rt_dd = (rt_current - rt_high) / rt_high * 100  # 负值=回撤
 423:             drawdown_rt = _clamp(100 + rt_dd * 8, 0, 100)
 424:         else:
 425:             drawdown_rt = 100
 426:     else:
 427:         volatility_rt = 50
 428:         drawdown_rt = 100
 429:     # 量能健康：实时无逐笔成交量比，用主力净流入强度代理（与资金动能同向但口径不同）
 430:     if abs(rt_main_force) > 1e6:
 431:         vol_bonus = min(abs(rt_main_force) / 1e8, 3) * 10
 432:         volume_rt = _clamp(50 + (1 if rt_main_force > 0 else -1) * vol_bonus, 0, 100)
 433:     else:
 434:         volume_rt = 50
 435:     return {
 436:         'available': True,
 437:         'live': live,
 438:         # 三种状态，供前端诚实标注：
 439:         #   live         —— 今天盘中且处于交易时段，实时数据滚动更新
 440:         #   closed_today —— 今天有实时数据但已收盘（或尚未开盘前），定格在今天最后 1 分钟快照，
 441:         #                   即「盘后」视图，一直挂到下一个开盘才重新计算
 442:         #   previous     —— 今天尚无任何实时数据（如周末/休市/开盘前），回退到最近一个交易日
 443:         'mode': 'live' if live else ('closed_today' if today == date.today() else 'previous'),
 444:         'date': today.isoformat(),
 445:         'snapshot_time': rt_snapshot_time.strftime('%Y-%m-%dT%H:%M') if rt_snapshot_time else None,
 446:         'trend_strength': round(trend_rt, 1),
 447:         'capital_momentum': round(capital_rt, 1),
 448:         'sector_resonance': round(resonance_rt, 1),
 449:         'relative_strength': round(relative_rt, 1),
 450:         'volume_health': round(volume_rt, 1),
 451:         'volatility_health': round(volatility_rt, 1),
 452:         'drawdown_status': round(drawdown_rt, 1),
 453:         'institution_signal': round(inst_rt, 1) if inst_rt is not None else None,
 454:         'price_chg': round(rt_pct_chg, 2),
 455:         # 资金流向拆解（实时端仅主力/散户/板块有，4 档拆解实时暂无）
 456:         'main_net': round(rt_main_net),
 457:         'retail_net': round(float(rt_money.retail_net or 0)) if rt_money else None,
 458:         'sector_net': round(rt_sector_net * 10000) if rt_sector else None,  # 万元→元
 459:         'sector_rise': round(rt_sector_rise, 2) if rt_sector else None,  # 板块实时涨幅%（供前端「个股 vs 板块」对照）
 460:         # 当日分时序列（真实时间维度）
 461:         'intraday': intraday,
 462:     }
 463: # ===== 主力净流入累计（多周期） =====
 464: def _compute_cumulative(ts_code: str, sector: str, db, target_date, periods=(1, 2, 3, 5, 10, 20)) -> dict:
 465:     """按最近 N 个有数据的交易日累加主力净流入（个股用 main_net，板块用 net_flow），单位元。
 466:     说明：交易所有休市/停牌，故"近N日"=最近 N 个有数据的交易日，而非自然日。
 467:     若历史交易日不足 N 个，则该周期返回 None（前端显示为空，不做虚假补全）。
 468:     """
 469:     max_p = max(periods)
 470:     # 个股：取最近 max_p 个交易日的 main_net
 471:     stock_dates = [d[0] for d in db.query(StockMoneyFlowDetail.trade_date).filter(
 472:         StockMoneyFlowDetail.ts_code == ts_code,
 473:         StockMoneyFlowDetail.trade_date <= target_date,
 474:     ).distinct().order_by(StockMoneyFlowDetail.trade_date.desc()).limit(max_p).all()]
 475:     stock = {}
 476:     for p in periods:
 477:         if len(stock_dates) >= p:
 478:             sel = stock_dates[:p]
 479:             s = db.query(func.sum(StockMoneyFlowDetail.main_net)).filter(
 480:                 StockMoneyFlowDetail.ts_code == ts_code,
 481:                 StockMoneyFlowDetail.trade_date.in_(sel),
 482:             ).scalar() or 0
 483:             stock[p] = round(float(s))
 484:         else:
 485:             stock[p] = None
 486:     # 板块：取最近 max_p 个交易日的 net_flow
 487:     sector_cum = {}
 488:     if sector:
 489:         sec_dates = [d[0] for d in db.query(SectorFlow.trade_date).filter(
 490:             SectorFlow.sector == sector,
 491:             SectorFlow.trade_date <= target_date,
 492:         ).distinct().order_by(SectorFlow.trade_date.desc()).limit(max_p).all()]
 493:         for p in periods:
 494:             if len(sec_dates) >= p:
 495:                 sel = sec_dates[:p]
 496:                 s = db.query(func.sum(SectorFlow.net_flow)).filter(
 497:                     SectorFlow.sector == sector,
 498:                     SectorFlow.trade_date.in_(sel),
 499:                 ).scalar() or 0
 500:                 sector_cum[p] = round(float(s))
 501:             else:
 502:                 sector_cum[p] = None
 503:     else:
 504:         for p in periods:
 505:             sector_cum[p] = None
 506:     return {'periods': list(periods), 'stock': stock, 'sector': sector_cum}
 507: def _compute_sector_rotation(sector: str, db, target_date, lookback_days: int = 10) -> Optional[dict]:
 508:     """板块轮动完整版计算——基于历史 N 日数据计算轮动阶段、资金连续性、龙头持续性等信号。
 509:     返回字段：
 510:     - consecutive_inflow_days: 连续净流入天数（≥1 表示持续入场）
 511:     - consecutive_outflow_days: 连续净流出天数
 512:     - cumulative_net_flow: N 日累计净流入金额（万元）
 513:     - avg_daily_inflow: 日均净流入金额
 514:     - inflow_strength: 资金入场强度评分 0-100（综合连续性 + 累计规模）
 515:     - heat_slope_5d: 5日热度斜率（升温速率）
 516:     - heat_trend: 热度趋势 'accel_up' / 'steady_up' / 'stable' / 'cooling_down' / 'accel_down'
 517:     - leader_continuity_days: 龙头连续领涨天数
 518:     - leader_changed: 龙头是否切换（与昨日对比）
 519:     - cumulative_chg_5d: 5日累计涨幅
 520:     - cumulative_chg_10d: 10日累计涨幅
 521:     - rotation_signal: 综合轮动信号标签（犀利操作建议）
 522:     - rotation_color: 标签颜色
 523:     - rotation_icon: 标签图标
 524:     - days_to_buy: 预计还需多少天可买（基于入场强度推算，吸筹期信号）
 525:     """
 526:     if not sector:
 527:         return None
 528:     # 取最近 lookback_days 个交易日的板块数据
 529:     rows = db.query(SectorFlow).filter(
 530:         SectorFlow.sector == sector,
 531:         SectorFlow.trade_date <= target_date,
 532:     ).order_by(SectorFlow.trade_date.desc()).limit(lookback_days).all()
 533:     if not rows:
 534:         return None
 535:     # rows[0] = 今日，rows[1] = 昨日，...
 536:     today = rows[0]
 537:     net_flows = [float(r.net_flow or 0) for r in rows]  # 万元
 538:     heat_scores = [float(r.heat_score) if r.heat_score is not None else None for r in rows]
 539:     leader_stocks = [r.leader_stock for r in rows]
 540:     leader_strengths = [float(r.leader_strength) if r.leader_strength is not None else None for r in rows]
 541:     avg_chgs = [float(r.avg_chg) if r.avg_chg is not None else 0 for r in rows]
 542:     limit_up_counts = [int(r.limit_up_count or 0) for r in rows]
 543:     # 1. 资金连续性
 544:     consecutive_inflow_days = 0
 545:     for f in net_flows:
 546:         if f > 0:
 547:             consecutive_inflow_days += 1
 548:         else:
 549:             break
 550:     consecutive_outflow_days = 0
 551:     for f in net_flows:
 552:         if f < 0:
 553:             consecutive_outflow_days += 1
 554:         else:
 555:             break
 556:     # N 日累计净流入
 557:     cumulative_net_flow = round(sum(net_flows), 2)
 558:     avg_daily_inflow = round(cumulative_net_flow / len(net_flows), 2) if net_flows else 0
 559:     # 资金入场强度评分 0-100
 560:     # 算法：连续性天数权重50% + 累计规模权重50%
 561:     inflow_strength = 0
 562:     if consecutive_inflow_days > 0:
 563:         # 连续性：3天=50分，5天=70分，7天=85分，10天=100分
 564:         consec_score = min(100, consecutive_inflow_days * 15 + 10)
 565:         # 累计规模：1亿=50分，5亿=80分，10亿=100分（万元单位）
 566:         abs_cum = abs(cumulative_net_flow)
 567:         if cumulative_net_flow > 0:
 568:             scale_score = min(100, abs_cum / 100000 * 50 + 30)  # 10万=30分，10亿=100分
 569:         else:
 570:             scale_score = 0
 571:         inflow_strength = round(consec_score * 0.5 + scale_score * 0.5)
 572:     # 2. 热度趋势
 573:     heat_slope_5d = None
 574:     if len(heat_scores) >= 5 and all(h is not None for h in heat_scores[:5]):
 575:         recent_5 = heat_scores[:5]
 576:         # 线性回归斜率：(y2-y1) / (x2-x1)，简化为首尾差
 577:         heat_slope_5d = round((recent_5[0] - recent_5[-1]) / 5, 2)
 578:     heat_trend = 'stable'
 579:     if heat_slope_5d is not None:
 580:         # 加速度：近3日斜率 vs 远3日斜率
 581:         if len(heat_scores) >= 6:
 582:             recent_3 = heat_scores[:3]
 583:             far_3 = heat_scores[3:6]
 584:             recent_slope = (recent_3[0] - recent_3[-1]) / 3 if all(h is not None for h in recent_3) else 0
 585:             far_slope = (far_3[0] - far_3[-1]) / 3 if all(h is not None for h in far_3) else 0
 586:             accel = recent_slope - far_slope
 587:             if heat_slope_5d > 3 and accel > 1:
 588:                 heat_trend = 'accel_up'  # 加速升温
 589:             elif heat_slope_5d > 3:
 590:                 heat_trend = 'steady_up'  # 匀速升温
 591:             elif heat_slope_5d < -3 and accel < -1:
 592:                 heat_trend = 'accel_down'  # 加速降温
 593:             elif heat_slope_5d < -3:
 594:                 heat_trend = 'cooling_down'  # 匀速降温
 595:         else:
 596:             if heat_slope_5d > 3:
 597:                 heat_trend = 'steady_up'
 598:             elif heat_slope_5d < -3:
 599:                 heat_trend = 'cooling_down'
 600:     # 3. 龙头持续性
 601:     leader_continuity_days = 0
 602:     today_leader = leader_stocks[0] if leader_stocks else None
 603:     for ls in leader_stocks:
 604:         if ls and today_leader and ls == today_leader:
 605:             leader_continuity_days += 1
 606:         else:
 607:             break
 608:     leader_changed = (len(leader_stocks) >= 2 and
 609:                      leader_stocks[0] and leader_stocks[1] and
 610:                      leader_stocks[0] != leader_stocks[1])
 611:     # 4. 累计涨幅
 612:     cumulative_chg_5d = round(sum(avg_chgs[:5]), 2) if len(avg_chgs) >= 5 else None
 613:     cumulative_chg_10d = round(sum(avg_chgs[:10]), 2) if len(avg_chgs) >= 10 else None
 614:     # 5. 综合轮动信号（核心）
 615:     rotation_signal = None
 616:     rotation_color = '#94a3b8'
 617:     rotation_icon = '⏳'
 618:     days_to_buy = None
 619:     today_leader_strength = leader_strengths[0] if leader_strengths else None
 620:     # 金额格式化：万→亿
 621:     def _fmt_flow(wan):
 622:         abs_w = abs(wan)
 623:         if abs_w >= 10000:
 624:             return f'{wan/10000:.2f}亿'
 625:         return f'{wan:.0f}万'
 626:     cum_flow_str = _fmt_flow(cumulative_net_flow)
 627:     # 详情字符串：天数+累计金额（前端单独展示，避免信号过长换行）
 628:     flow_direction = '流入' if cumulative_net_flow >= 0 else '流出'
 629:     rotation_detail = f'{consecutive_inflow_days if cumulative_net_flow >= 0 else consecutive_outflow_days}天{flow_direction}·累计{cum_flow_str}'
 630:     if consecutive_inflow_days >= 7 and cumulative_net_flow >= 200000:
 631:         # 连续7天+流入且累计≥20亿 → 主升浪
 632:         rotation_signal = f'主升浪·持股待涨'
 633:         rotation_color = '#dc2626'
 634:         rotation_icon = '🚀'
 635:     elif consecutive_inflow_days >= 5 and cumulative_net_flow >= 100000:
 636:         # 连续5天+流入且累计≥10亿 → 主力建仓完毕
 637:         days_to_buy = max(0, 7 - consecutive_inflow_days)
 638:         rotation_signal = f'主力建仓·即将启动'
 639:         rotation_color = '#ef4444'
 640:         rotation_icon = '💰'
 641:     elif consecutive_inflow_days >= 3 and cumulative_net_flow >= 50000:
 642:         # 连续3天+流入且累计≥5亿 → 吸筹中
 643:         days_to_buy = max(1, 5 - consecutive_inflow_days)
 644:         rotation_signal = f'主力吸筹·再等{days_to_buy}天可买'
 645:         rotation_color = '#f97316'
 646:         rotation_icon = '🔍'
 647:     elif consecutive_inflow_days >= 2 and cumulative_net_flow >= 10000:
 648:         # 连续2天+流入且累计≥1亿 → 试探性建仓
 649:         days_to_buy = max(2, 5 - consecutive_inflow_days)
 650:         rotation_signal = f'主力试探·观察{days_to_buy}天确认'
 651:         rotation_color = '#eab308'
 652:         rotation_icon = '👀'
 653:     elif consecutive_inflow_days >= 1:
 654:         # 单日流入
 655:         rotation_signal = f'资金流入·观察'
 656:         rotation_color = '#3b82f6'
 657:         rotation_icon = '💧'
 658:     elif consecutive_outflow_days >= 5 and cumulative_net_flow <= -100000:
 659:         # 连续5天+流出且累计≥10亿 → 主力出货
 660:         rotation_signal = f'主力出货·坚决回避'
 661:         rotation_color = '#22c55e'
 662:         rotation_icon = '🏃'
 663:     elif consecutive_outflow_days >= 3 and cumulative_net_flow <= -50000:
 664:         # 连续3天+流出且累计≥5亿 → 资金撤退
 665:         rotation_signal = f'资金撤退·减仓'
 666:         rotation_color = '#3b82f6'
 667:         rotation_icon = '📉'
 668:     elif consecutive_outflow_days >= 1:
 669:         # 单日流出
 670:         rotation_signal = f'资金流出·谨慎'
 671:         rotation_color = '#94a3b8'
 672:         rotation_icon = '💧'
 673:     else:
 674:         rotation_signal = '资金中性·观望'
 675:         rotation_color = '#94a3b8'
 676:         rotation_icon = '⏳'
 677:         rotation_detail = ''
 678:     # 龙头信号覆写：龙头断板或切换时加注警示
 679:     if today_leader_strength is not None and today_leader_strength < 3 and consecutive_inflow_days >= 3:
 680:         rotation_signal = f'龙头断板·见顶信号 / {rotation_signal}'
 681:         rotation_color = '#dc2626'
 682:         rotation_icon = '⚠️'
 683:     elif leader_changed and consecutive_inflow_days >= 3:
 684:         rotation_signal = f'龙头切换·分歧加剧 / {rotation_signal}'
 685:         rotation_color = '#f97316'
 686:         rotation_icon = '🔀'
 687:     # 热度趋势加注
 688:     heat_trend_label = {
 689:         'accel_up': '热度加速',
 690:         'steady_up': '热度升温',
 691:         'stable': '热度稳定',
 692:         'cooling_down': '热度降温',
 693:         'accel_down': '热度急降',
 694:     }.get(heat_trend, '热度未知')
 695:     return {
 696:         'consecutive_inflow_days': consecutive_inflow_days,
 697:         'consecutive_outflow_days': consecutive_outflow_days,
 698:         'cumulative_net_flow_wan': cumulative_net_flow,  # 万元
 699:         'avg_daily_inflow_wan': avg_daily_inflow,
 700:         'inflow_strength': inflow_strength,
 701:         'heat_slope_5d': heat_slope_5d,
 702:         'heat_trend': heat_trend,
 703:         'heat_trend_label': heat_trend_label,
 704:         'leader_continuity_days': leader_continuity_days,
 705:         'leader_changed': leader_changed,
 706:         'cumulative_chg_5d': cumulative_chg_5d,
 707:         'cumulative_chg_10d': cumulative_chg_10d,
 708:         'rotation_signal': rotation_signal,
 709:         'rotation_color': rotation_color,
 710:         'rotation_icon': rotation_icon,
 711:         'rotation_detail': rotation_detail,
 712:         'days_to_buy': days_to_buy,
 713:     }
 714: # ===== 8 维盘后计算（原有） =====
 715: def _compute_dashboard(code: str, db) -> Optional[dict]:
 716:     """核心计算——单只股票的 8 维指数 + 操作建议"""
 717:     # 容错：剥掉 ts_code 后缀（.SZ/.SH/.BJ/.sh/.sz/.bj），兼容前端传入 6位或 9位
 718:     # stock_features_daily.stock_code 与 stock_flow 的 LIKE 'XXX.%' 都按 6 位存
 719:     code6 = code.split('.')[0] if code else ''
 720:     if not code6:
 721:         return None
 722:     # 优先按 StockFlow 定位最新交易日（覆盖全市场，比 features_daily 范围广得多）
 723:     # features_daily 只覆盖自选股（113 只/日），共振列表 250+ 只无法命中。
 724:     # 但 StockFlow 是全市场入库的，所以先查 StockFlow，再回退 features_daily。
 725:     latest_flow = db.query(StockFlow).filter(
