384: async def _build_rank_result(indices_list: list, cache: dict, source_label: str,
385:                               force: int = 0) -> dict:
386:     """通用排名构建：对给定指数列表按成分股聚合 stock_flow，缺数据时降级东方财富"""
387:     if not force and cache['data'] and time.time() - cache['ts'] < _RANK_CACHE_TTL:
388:         return cache['data']
389:     # 主数据源：数据库聚合
390:     db_results = []
391:     db_hit_count = 0
392:     with get_db_session() as db:
393:         for idx_def in indices_list:
394:             try:
395:                 agg = _aggregate_index_from_db(idx_def, db, latest_n_days=22)
396:                 if agg and agg.get('latest_date'):
397:                     db_results.append(agg)
398:                     db_hit_count += 1
399:                 else:
400:                     db_results.append(None)
401:             except Exception as e:
402:                 logger.warning(f'[index_flow] DB 聚合 {idx_def["ts_code"]} 失败: {e}')
403:                 db_results.append(None)
404:     # 如果数据库全部命中，直接返回
405:     if db_hit_count == len(indices_list):
406:         result_indices = []
407:         latest_date = None
408:         for agg in db_results:
409:             if agg is None:
410:                 continue
411:             if latest_date is None or agg['latest_date'] > latest_date:
412:                 latest_date = agg['latest_date']
413:             result_indices.append({
414:                 'ts_code': agg['ts_code'],
415:                 'name': agg['name'],
416:                 'close': agg.get('close'),
417:                 'pct_change': agg.get('pct_change'),
418:                 'inflow_1d': agg['inflow_1d'],
419:                 'inflow_3d': agg['inflow_3d'],
420:                 'inflow_5d': agg['inflow_5d'],
421:                 'inflow_10d': agg['inflow_10d'],
422:                 'inflow_22d': agg['inflow_22d'],
423:                 'abs_1d': abs(agg['inflow_1d']),
424:                 'member_count': agg.get('member_count', 0),
425:                 'source': 'db',
426:             })
427:         result_indices.sort(key=lambda x: x['inflow_5d'], reverse=True)
428:         result = {
429:             'date': latest_date,
430:             'indices': result_indices,
431:             'count': len(result_indices),
432:             'source': 'database',
433:             'index_type': source_label,
434:         }
435:         cache['data'] = result
436:         cache['ts'] = time.time()
437:         return result
438:     # 降级：对数据库未命中的指数调用东方财富
439:     logger.info(f'[index_flow] DB 命中 {db_hit_count}/{len(indices_list)}, 降级 EM 补充')
440:     em_indices_with_secid = [(i, idx) for i, idx in enumerate(indices_list)
441:                              if idx.get('secid') and db_results[i] is None]
442:     em_hist_results = []
443:     em_quote_results = []
444:     if em_indices_with_secid:
445:         tasks_hist = [_fetch_index_flow_history_em(idx['secid'], limit=15) for _, idx in em_indices_with_secid]
446:         tasks_quote = [_fetch_index_quote_em(idx['secid']) for _, idx in em_indices_with_secid]
447:         em_hist_results = await asyncio.gather(*tasks_hist, return_exceptions=True)
448:         em_quote_results = await asyncio.gather(*tasks_quote, return_exceptions=True)
449:     result_indices = []
450:     latest_date = None
451:     em_fail_count = 0
452:     # 处理 DB 命中的指数
453:     for agg in db_results:
454:         if agg is None:
455:             continue
456:         if latest_date is None or agg['latest_date'] > latest_date:
457:             latest_date = agg['latest_date']
458:         result_indices.append({
459:             'ts_code': agg['ts_code'],
460:             'name': agg['name'],
461:             'close': agg.get('close'),
462:             'pct_change': agg.get('pct_change'),
463:             'inflow_1d': agg['inflow_1d'],
464:             'inflow_3d': agg['inflow_3d'],
465:             'inflow_5d': agg['inflow_5d'],
466:             'inflow_10d': agg['inflow_10d'],
467:             'inflow_22d': agg['inflow_22d'],
468:             'abs_1d': abs(agg['inflow_1d']),
469:             'member_count': agg.get('member_count', 0),
470:             'source': 'db',
471:         })
472:     # 处理 EM 补充的指数
473:     for j, (orig_i, idx_def) in enumerate(em_indices_with_secid):
474:         hist = em_hist_results[j] if not isinstance(em_hist_results[j], Exception) else []
475:         quote = em_quote_results[j] if not isinstance(em_quote_results[j], Exception) else {}
476:         if not hist:
477:             em_fail_count += 1
478:             continue
479:         if latest_date is None or hist[-1]['date'] > latest_date:
480:             latest_date = hist[-1]['date']
481:         result_indices.append({
482:             'ts_code': idx_def['ts_code'],
483:             'name': idx_def['name'],
484:             'close': quote.get('close'),
485:             'pct_change': quote.get('pct_change'),
486:             'inflow_1d': _aggregate_flow_em(hist, 1),
487:             'inflow_3d': _aggregate_flow_em(hist, 3),
488:             'inflow_5d': _aggregate_flow_em(hist, 5),
489:             'inflow_10d': _aggregate_flow_em(hist, 10),
490:             'inflow_22d': _aggregate_flow_em(hist, 22),
491:             'abs_1d': abs(_aggregate_flow_em(hist, 1)),
492:             'member_count': 0,
493:             'source': 'eastmoney',
494:         })
495:     result_indices.sort(key=lambda x: x['inflow_5d'], reverse=True)
496:     result = {
497:         'date': latest_date,
498:         'indices': result_indices,
499:         'count': len(result_indices),
500:         'source': 'database+eastmoney' if em_indices_with_secid else 'database',
501:         'index_type': source_label,
502:     }
503:     # 全部失败时附加错误信息
504:     if not result_indices:
505:         result['error'] = 'data_source_unavailable'
506:         result['message'] = '数据库与东方财富数据源均不可用，请稍后重试'
507:     cache['data'] = result
508:     cache['ts'] = time.time()
509:     return result
