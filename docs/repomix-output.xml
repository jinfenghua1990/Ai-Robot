 11: def _corr(left: list[float], right: list[float]) -> float | None:
 12:     if len(left) < 3 or len(left) != len(right):
 13:         return None
 14:     lx, rx = mean(left), mean(right)
 15:     ld = sum((x - lx) ** 2 for x in left) ** 0.5
 16:     rd = sum((x - rx) ** 2 for x in right) ** 0.5
 17:     return round(sum((a - lx) * (b - rx) for a, b in zip(left, right)) / (ld * rd), 6) if ld and rd else None
 18: def _rank(values: list[float]) -> list[float]:
 19:     order = sorted(enumerate(values), key=lambda item: item[1])
 20:     result = [0.0] * len(values)
 21:     index = 0
 22:     while index < len(order):
 23:         end = index
 24:         while end + 1 < len(order) and order[end + 1][1] == order[index][1]:
 25:             end += 1
 26:         rank = (index + end + 2) / 2
 27:         for pos in range(index, end + 1):
 28:             result[order[pos][0]] = rank
 29:         index = end + 1
 30:     return result
 31: def _forward_window(bars, trade_date: date, horizon: int):
 32:     ordered = [bar for bar in bars if bar.trade_date >= trade_date]
 33:     if len(ordered) <= horizon or not ordered[0].close:
 34:         return None
 35:     entry = ordered[0].close
 36:     future = ordered[:horizon + 1]
 37:     returns = future[horizon].close / entry - 1
 38:     max_profit = max((bar.high / entry - 1 for bar in future), default=None)
 39:     max_loss = min((bar.low / entry - 1 for bar in future), default=None)
 40:     running_high = future[0].high
 41:     drawdown = 0.0
 42:     for bar in future:
 43:         running_high = max(running_high, bar.high)
 44:         drawdown = min(drawdown, bar.low / running_high - 1 if running_high else 0)
 45:     return returns, max_profit, max_loss, drawdown
