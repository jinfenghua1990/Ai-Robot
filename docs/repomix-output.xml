 98: def analyze_position(pos: dict, sector_trend: dict, config: dict, total_assets: float) -> dict:
 99:     """
100:     多维度评分系统：每个维度独立计分，最终信号由总分决定
101:     正分 = 看多因素，负分 = 看空因素
102:     12 个评分维度统一为规则表（_RULES），新增/调整只需修改规则表，无需改主逻辑。
103:     """
104:     profit_pct = pos.get("profitPct", 0)
105:     pos_pct = pos.get("posPct", 0)
106:     day_profit = pos.get("dayProfit", 0)
107:     day_profit_pct = pos.get("dayProfitPct", 0)
108:     sector_ok = sector_trend.get("available", False)
109:     sector_name = sector_trend.get("sector", "未知")
110:     # ========== 规则表：12 个评分维度（看空 7 + 看多 5）==========
111:     # 每条规则 (condition, factor_name, weight, detail_fmt)：
112:     #   - condition: 命中条件（lambda 闭包）
113:     #   - factor_name: 因素中文名
114:     #   - weight: 权重（正=看多，负=看空）
115:     #   - detail_fmt: 详情格式化函数 (接收 self 绑定的 pos/st_dict/config) -> str
116:     _RULES = [
117:         # 看空维度
118:         (lambda: profit_pct <= config["stop_loss_pct"],
119:          "止损亏损", -3,
120:          lambda: f"亏损 {profit_pct:.1f}% 超过止损线 {config['stop_loss_pct']}%"),
121:         (lambda: sector_ok and sector_trend.get("decline_days", 0) >= config["sector_decline_days"],
122:          "板块下行", -2,
123:          lambda: f"板块「{sector_name}」热度连续 {sector_trend['decline_days']} 天下滑（当前 {sector_trend['latest_heat']}）"),
124:         (lambda: sector_ok and sector_trend.get("latest_heat", 100) < config["sector_heat_threshold"],
125:          "板块低温", -1,
126:          lambda: f"板块「{sector_name}」热度 {sector_trend['latest_heat']} 低于预警线 {config['sector_heat_threshold']}"),
127:         (lambda: profit_pct >= config["take_profit_pct"],
128:          "止盈区间", -1,
129:          lambda: f"盈利 {profit_pct:.1f}% 达到止盈线 {config['take_profit_pct']}%，可减仓锁定利润"),
130:         (lambda: pos_pct > config["max_position_pct"],
131:          "仓位过重", -1,
132:          lambda: f"仓位 {pos_pct:.1f}% 超过上限 {config['max_position_pct']}%"),
133:         (lambda: sector_ok and sector_trend.get("flow_direction") == "outflow",
134:          "资金流出", -1,
135:          lambda: f"板块「{sector_name}」资金净流出 {abs(sector_trend.get('total_net_flow', 0)):.0f} 万"),
136:         (lambda: day_profit_pct <= -3,
137:          "当日大跌", -1,
138:          lambda: f"当日跌幅 {day_profit_pct:.1f}%，短期承压"),
139:         # 看多维度
140:         (lambda: sector_ok and sector_trend.get("heat_trend") == "up",
141:          "板块上升", 2,
142:          lambda: f"板块「{sector_name}」热度上升（当前 {sector_trend['latest_heat']}，均值 {sector_trend['avg_heat']}）"),
143:         (lambda: sector_ok and sector_trend.get("flow_direction") == "inflow",
144:          "资金流入", 1,
145:          lambda: f"板块「{sector_name}」资金净流入 {sector_trend.get('total_net_flow', 0):.0f} 万"),
146:         (lambda: profit_pct >= config["add_position_pct"] and profit_pct < config["take_profit_pct"],
147:          "盈利良好", 1,
148:          lambda: f"盈利 {profit_pct:.1f}%，处于健康区间"),
149:         (lambda: sector_ok and sector_trend.get("latest_avg_chg", 0) > 0,
150:          "板块涨势", 1,
151:          lambda: f"板块当日平均涨幅 +{sector_trend['latest_avg_chg']:.2f}%"),
152:         (lambda: pos_pct < config["max_position_pct"] * 0.5,
153:          "仓位较低", 1,
154:          lambda: f"仓位 {pos_pct:.1f}% 远低于上限 {config['max_position_pct']}%，有加仓空间"),
155:     ]
156:     # ========== 规则评估：单循环计算 score + 分类 factors ==========
157:     score = 0
158:     positive_factors: list = []
159:     negative_factors: list = []
160:     for cond, factor, weight, detail_fn in _RULES:
161:         if not cond():
162:             continue
163:         score += weight
164:         factor_obj = {"factor": factor, "detail": detail_fn(), "weight": weight}
165:         (negative_factors if weight < 0 else positive_factors).append(factor_obj)
166:     # ========== 信号判定 ==========
167:     if score <= SCORE_STRONG_SELL:
168:         signal = SIGNAL_STRONG_SELL
169:     elif score <= SCORE_SELL:
170:         signal = SIGNAL_SELL
171:     elif score >= SCORE_ADD:
172:         signal = SIGNAL_ADD
173:     else:
174:         signal = SIGNAL_HOLD
175:     # 风险等级
176:     if score <= SCORE_STRONG_SELL:
177:         risk_level = "high"
178:     elif score <= SCORE_SELL:
179:         risk_level = "medium"
180:     else:
181:         risk_level = "low"
182:     # ========== 生成理由 ==========
183:     reasons = []
184:     # 看空因素
185:     for f in negative_factors:
186:         reasons.append(f"[-{abs(f['weight'])}] {f['factor']}：{f['detail']}")
187:     # 看多因素
188:     for f in positive_factors:
189:         reasons.append(f"[+{f['weight']}] {f['factor']}：{f['detail']}")
190:     # 综合结论
191:     if not reasons:
192:         if profit_pct >= 0:
193:             reasons.append(f"[0] 盈利 {profit_pct:.1f}%，各维度均衡，维持持仓")
194:         else:
195:             reasons.append(f"[0] 亏损 {profit_pct:.1f}% 但未触及止损线，各维度均衡，维持持仓观察")
196:     # 当日盈亏补充
197:     if day_profit != 0 and day_profit_pct > -3:
198:         reasons.append(f"当日{'盈利' if day_profit > 0 else '亏损'} {abs(day_profit):.0f} 元 ({day_profit_pct:+.1f}%)")
199:     reasons.append(f"综合评分: {score:+d} → {SIGNAL_META[signal]['label']}")
200:     return {
201:         "secCode": pos.get("secCode"),
202:         "secName": pos.get("secName"),
