359: def _em_fetch_page(url, params, pn, max_retries=5):
360:     """获取东方财富单页数据（带重试），供并发调用。"""
361:     for attempt in range(max_retries):
362:         try:
363:             resp = requests.get(url, params=params, timeout=15,
364:                                headers={'User-Agent': 'Mozilla/5.0'})
365:             data = resp.json().get('data', {})
366:             items = data.get('diff', [])
367:             if isinstance(items, dict):
368:                 items = list(items.values())
369:             return pn, items, data.get('total', 0), None
370:         except Exception as e:
371:             if attempt < max_retries - 1:
372:                 # 并发场景下缩短退避，避免单页阻塞整体
373:                 time.sleep(0.1 * (2 ** attempt))
374:             else:
375:                 return pn, [], 0, e
376:     return pn, [], 0, None
377: def _em_fetch_all(fs, fid='f62', po='1', fields='f12,f14,f62,f3,f66,f72,f78,f84', max_workers=8):
378:     """分页获取东方财富全部数据（单页最多100条，并发请求）。
379:     优化：先串行取第1页得到 total，再用 ThreadPoolExecutor 并发拉取后续页。
380:     全市场 5000+ 只股票从串行 ~8-10s 降到 ~1.5-2.5s。
381:     """
382:     url = 'http://push2.eastmoney.com/api/qt/clist/get'
383:     base_params = {
384:         'fid': fid, 'po': po, 'pz': '100',
385:         'fs': fs, 'fields': fields,
386:     }
387:     # 先取第1页，获取 total 并作为容错基准
388:     _, first_items, total, err = _em_fetch_page(url, {**base_params, 'pn': '1'}, 1)
389:     if err:
390:         logger.error(f'[em] page 1 failed: {err}')
391:         return [], None
392:     if total is None:
393:         total = 0
394:     all_items = list(first_items)
395:     if not first_items or len(first_items) < 100:
396:         return all_items, total
397:     total_pages = (total + 99) // 100
398:     if total_pages <= 1:
399:         return all_items, total
400:     # 并发拉取第2页及以后
401:     pages_to_fetch = [(url, {**base_params, 'pn': str(pn)}, pn) for pn in range(2, total_pages + 1)]
402:     failed_pages = []
403:     with ThreadPoolExecutor(max_workers=max_workers) as executor:
404:         futures = [executor.submit(_em_fetch_page, u, p, pn) for u, p, pn in pages_to_fetch]
405:         for future in futures:
406:             try:
407:                 pn, items, _, page_err = future.result()
408:                 if page_err:
409:                     failed_pages.append(pn)
410:                     logger.warning(f'[em] page {pn} failed: {page_err}')
411:                 else:
412:                     all_items.extend(items)
413:             except Exception as e:
414:                 logger.warning(f'[em] concurrent fetch error: {e}')
415:     if failed_pages:
416:         logger.warning(f'[em] {len(failed_pages)} pages failed: {failed_pages[:10]}')
417:     return all_items, total
