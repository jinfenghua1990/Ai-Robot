276: def sync_factor_reviews(result: dict) -> int:
277:     """Apply conservative lifecycle recommendations to the registry.
278:     A short research window can move a formula between candidate and
279:     observation, but it cannot promote a factor to production. Production
280:     promotion requires at least 120 research sessions/days and the explicit
281:     production gate calculated by the validator.
282:     """
283:     rows = result.get("rows") or []
284:     if not rows:
285:         return 0
286:     review_date = result.get("trade_date")
287:     research_days = int(result.get("research_days") or 0)
288:     changed = 0
289:     with engine.begin() as conn:
290:         current_rows = conn.execute(text("SELECT factor_name, status FROM v2_factor_registry")).mappings().all()
291:         current = {row["factor_name"]: row["status"] for row in current_rows}
292:         for row in rows:
293:             name = row["factor_name"]
294:             old_status = current.get(name, "candidate")
295:             if old_status in {"retired", "suspended"}:
296:                 continue
297:             recommended = row.get("recommended_status") or "candidate"
298:             # A short window is for sample accumulation, not demotion.  Keep
299:             # an already audited observation factor in observation until a
300:             # meaningful rolling window is available.
301:             if old_status == "candidate" and research_days < 60:
302:                 recommended = "candidate"
303:             if old_status == "observation" and research_days < 60:
304:                 recommended = "observation"
305:             if recommended == "production" and research_days < 120:
306:                 recommended = "observation"
307:             if old_status == "production" and research_days < 120:
308:                 recommended = "production"
309:             enabled = recommended in {"observation", "production"}
310:             conn.execute(text("""
311:                 UPDATE v2_factor_registry
312:                    SET status=:status, enabled_in_score=:enabled_in_score,
313:                        allow_production=:allow_production,
314:                        status_reason=:status_reason, last_reviewed=:last_reviewed,
315:                        updated_at=NOW()
316:                  WHERE factor_name=:factor_name
317:             """), {
318:                 "status": recommended,
319:                 "enabled_in_score": enabled,
320:                 "allow_production": recommended == "production",
321:                 "status_reason": row.get("validation_reason") or "验证中心自动评估",
322:                 "last_reviewed": review_date,
323:                 "factor_name": name,
324:             })
325:             changed += 1
326:     return changed
