 1: """
 2: 龙头历史写入服务
 3: 职责：每日主龙选出后，写入 leader_history 表
 4: 规则：同一天同一板块只允许一条记录，存在则更新
 5: """
 6: import logging
 7: from db.models import LeaderHistory
 8: logger = logging.getLogger(__name__)
 9: def save_daily_leader(db, trade_date, sector, leader):
10:     """保存每日主龙记录（同日同板块只保留一条，存在则更新）
11:     Args:
12:         db: 数据库会话
13:         trade_date: 交易日期字符串 YYYY-MM-DD
14:         sector: 板块名称
15:         leader: 主龙数据字典，需包含 ts_code, name, score, sector_score, stage
16:     """
17:     date_str = trade_date if isinstance(trade_date, str) else trade_date.isoformat()
18:     # 查询是否已存在同日同板块的记录
19:     existing = db.query(LeaderHistory).filter(
20:         LeaderHistory.trade_date == date_str,
21:         LeaderHistory.sector == sector,
22:     ).first()
23:     if existing:
24:         # 更新已有记录
25:         existing.leader_code = leader.get('ts_code', '')
26:         existing.leader_name = leader.get('name', '')
27:         existing.leader_score = leader.get('score', 0)
28:         existing.sector_score = leader.get('sector_score', 0)
29:         existing.stage = leader.get('stage', 'unknown')
30:         logger.debug(f'更新龙头历史: {date_str} {sector} {leader.get("name")}')
31:     else:
32:         # 新增记录
33:         record = LeaderHistory(
34:             trade_date=date_str,
35:             sector=sector,
36:             leader_code=leader.get('ts_code', ''),
37:             leader_name=leader.get('name', ''),
38:             leader_score=leader.get('score', 0),
39:             sector_score=leader.get('sector_score', 0),
40:             stage=leader.get('stage', 'unknown'),
41:         )
42:         db.add(record)
43:         logger.debug(f'新增龙头历史: {date_str} {sector} {leader.get("name")}')
44:     db.commit()
