<file path="backend/api/leader_history.py">
  1: """
  2: 龙头历史统计 API
  3: GET /api/leader/history - 历史主龙记录列表
  4: GET /api/leader/stats - 统计汇总（平均寿命/切换次数/活跃板块数）
  5: """
  6: import logging
  7: from fastapi import APIRouter, Query
  8: from sqlalchemy import desc
  9: from db.connection import get_db
 10: from db.session import get_db_session
 11: from db.models import LeaderHistory
 12: router = APIRouter()
 13: logger = logging.getLogger(__name__)
 14: @router.get("/api/leader/history")
 15: def leader_history(limit: int = Query(100, description="返回条数限制")):
 16:     """历史主龙记录列表
 17:     返回按日期倒序的主龙记录
 18:     """
 19:     with get_db_session() as db:
 20:         records = db.query(LeaderHistory).order_by(
 21:             desc(LeaderHistory.trade_date), desc(LeaderHistory.leader_score)
 22:         ).limit(limit).all()
 23:         return [
 24:             {
 25:                 'date': r.trade_date,
 26:                 'sector': r.sector,
 27:                 'leader_code': r.leader_code,
 28:                 'leader_name': r.leader_name,
 29:                 'leader_score': float(r.leader_score) if r.leader_score else 0,
 30:                 'sector_score': float(r.sector_score) if r.sector_score else 0,
 31:                 'stage': r.stage,
 32:             }
 33:             for r in records
 34:         ]
 35: @router.get("/api/leader/stats")
 36: def leader_stats(days: int = Query(20, description="统计近N个交易日")):
 37:     """龙头统计汇总
 38:     返回：
 39:     - avg_life_days: 龙头平均寿命（同一板块连续担任主龙的平均天数）
 40:     - switch_count: 龙头切换次数
 41:     - active_sectors: 近N个交易日出现过主龙的板块数
 42:     - total_records: 总记录数
 43:     - date_range: 日期范围
 44:     - sector_breakdown: 各板块的龙头统计
 45:     """
 46:     with get_db_session() as db:
 47:         # 获取全部历史记录（按日期+板块排序）
 48:         all_records = db.query(LeaderHistory).order_by(
 49:             LeaderHistory.trade_date, LeaderHistory.sector
 50:         ).all()
 51:         if not all_records:
 52:             return {
 53:                 'avg_life_days': 0,
 54:                 'switch_count': 0,
 55:                 'active_sectors': 0,
 56:                 'total_records': 0,
 57:                 'date_range': None,
 58:                 'sector_breakdown': [],
 59:             }
 60:         # === 1. 计算龙头平均寿命 ===
 61:         # 按板块分组，计算每个板块内龙头连续担任天数
 62:         sector_groups = {}
 63:         for r in all_records:
 64:             if r.sector not in sector_groups:
 65:                 sector_groups[r.sector] = []
 66:             sector_groups[r.sector].append(r)
 67:         all_lifespans = []
 68:         for sector, records in sector_groups.items():
 69:             # 同一板块内，按日期排序
 70:             records.sort(key=lambda x: x.trade_date)
 71:             # 计算连续担任主龙的天数
 72:             current_leader = None
 73:             current_days = 0
 74:             for r in records:
 75:                 if r.leader_code != current_leader:
 76:                     if current_leader is not None and current_days > 0:
 77:                         all_lifespans.append(current_days)
 78:                     current_leader = r.leader_code
 79:                     current_days = 1
 80:                 else:
 81:                     current_days += 1
 82:             # 最后一段
 83:             if current_days > 0:
 84:                 all_lifespans.append(current_days)
 85:         avg_life = sum(all_lifespans) / len(all_lifespans) if all_lifespans else 0
 86:         # === 2. 龙头切换次数 ===
 87:         switch_count = 0
 88:         for sector, records in sector_groups.items():
 89:             records.sort(key=lambda x: x.trade_date)
 90:             prev_leader = None
 91:             for r in records:
 92:                 if prev_leader is not None and r.leader_code != prev_leader:
 93:                     switch_count += 1
 94:                 prev_leader = r.leader_code
 95:         # === 3. 活跃板块数（近N个交易日） ===
 96:         # 取最近N个交易日
 97:         all_dates = sorted(set(r.trade_date for r in all_records), reverse=True)
 98:         recent_dates = set(all_dates[:days])
 99:         recent_sectors = set(
100:             r.sector for r in all_records if r.trade_date in recent_dates
101:         )
102:         # === 4. 板块维度统计 ===
103:         sector_breakdown = []
104:         for sector, records in sector_groups.items():
105:             leaders = list(set(r.leader_name for r in records if r.leader_name))
106:             sector_breakdown.append({
107:                 'sector': sector,
108:                 'record_count': len(records),
109:                 'leader_count': len(leaders),
110:                 'leaders': leaders[:5],  # 前5个龙头
111:                 'avg_score': sum(float(r.leader_score or 0) for r in records) / len(records),
112:             })
113:         sector_breakdown.sort(key=lambda x: x['record_count'], reverse=True)
114:         return {
115:             'avg_life_days': round(avg_life, 1),
116:             'switch_count': switch_count,
117:             'active_sectors': len(recent_sectors),
118:             'total_records': len(all_records),
119:             'date_range': {
120:                 'start': all_dates[-1] if all_dates else None,
121:                 'end': all_dates[0] if all_dates else None,
122:             },
123:             'sector_breakdown': sector_breakdown[:10],
124:         }
</file>

