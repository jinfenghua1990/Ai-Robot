 15: from quant_vnext.production import run_production
 16: logger = logging.getLogger(__name__)
 17: def _code6(value: str) -> str:
 18:     return (value or "").split(".", 1)[0]
 19: def _date_value(value: Optional[str | date]) -> Optional[date]:
 20:     if value is None or isinstance(value, date):
 21:         return value
 22:     return datetime.strptime(value, "%Y-%m-%d").date()
 23: def _candidate_from_snapshot(item: dict, signal_date: date) -> dict:
 24:     resonance = item.get("resonance") or {}
 25:     dimensions = item.get("dimensions") or {}
 26:     return {
 27:         "ts_code": item.get("ts_code", ""),
 28:         "name": item.get("name", ""),
 29:         "sector": item.get("sector", ""),
 30:         "signal_date": signal_date.isoformat(),
 31:         "rank": item.get("rank", 0),
 32:         "factor_score": item.get("factor_score"),
 33:         "dimensions": dimensions,
 34:         "resonance_count": resonance.get("count", 0),
 35:         "resonance_dimensions": resonance.get("dimensions", []),
 36:         "failed_dimensions": resonance.get("failed_dimensions", []),
 37:         "resonance_eligible": bool(resonance.get("eligible", False)),
 38:         "resonance_reason": resonance.get("reason", ""),
 39:         "lifecycle": item.get("lifecycle", ""),
 40:         "trading_state": item.get("trading_state", "INVALID"),
 41:         "market_state": item.get("market_state", ""),
 42:         "reasons": item.get("reasons", []),
 43:         # Compatibility fields for existing cards; they are no longer used
 44:         # as the buy decision.
 45:         "vote_score": resonance.get("count", 0),
 46:         "strategies": resonance.get("dimensions", []),
 47:     }
 48: def aggregate_signals(
 49:     trade_date: Optional[str | date],
 50:     db,
 51:     limit: Optional[int] = None,
 52: ) -> List[Dict]:
 53:     """Return V2 ranked signals, never legacy strategy votes.
 54:     ``trade_date`` is resolved to the latest completed daily bar <= that date,
 55:     so an intraday call on a new calendar day cannot silently label yesterday's
 56:     signal as today's signal.
 57:     """
 58:     result = run_production(
 59:         db,
 60:         requested_date=_date_value(trade_date),
 61:         display_limit=limit,
 62:     )
 63:     signal_date = result.get("trade_date")
 64:     if not signal_date:
 65:         return []
 66:     return [
 67:         _candidate_from_snapshot(item, signal_date)
 68:         for item in result.get("signals", [])
 69:     ]
