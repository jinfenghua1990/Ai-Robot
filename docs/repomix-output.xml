<file path="frontend/src/components/charts/TrendLineChart.jsx">
  1: import { useMemo } from 'react';
  2: import ReactECharts from 'echarts-for-react/lib/core';
  3: import echarts from '../../lib/echarts';
  4: import { tooltipStyle } from '../../utils/chartConfig';
  5: import { getSectorColorHex } from '../../utils/sectorColors';
  6: export default function TrendLineChart({ data, topSectors, selectedSector, onSectorClick, height = 240 }) {
  7:   // 预构建索引 Map，避免循环内 find 的 O(n²) 查找
  8:   const series = useMemo(() => {
  9:     if (!data?.dates || !topSectors || topSectors.length === 0) return [];
 10:     // key = `${dateIdx}_${sectorIdx}` → value
 11:     const valueMap = new Map();
 12:     for (const v of data.values) {
 13:       valueMap.set(`${v[0]}_${v[1]}`, v[2]);
 14:     }
 15:     return topSectors.slice(0, 10).map((s, i) => {
 16:       const sectorIdx = data.sectors.indexOf(s.sector);
 17:       const trendData = data.dates.map((_, dateIdx) => {
 18:         const val = valueMap.get(`${dateIdx}_${sectorIdx}`);
 19:         return val != null ? parseFloat(val.toFixed(1)) : null;
 20:       });
 21:       const isSelected = selectedSector && selectedSector === s.sector;
 22:       const dimmed = selectedSector && !isSelected;
 23:       const color = getSectorColorHex(s.sector);
 24:       return {
 25:         name: s.sector,
 26:         type: 'line',
 27:         smooth: true,
 28:         symbol: 'circle',
 29:         symbolSize: isSelected ? 10 : 6,
 30:         connectNulls: true,
 31:         lineStyle: { width: isSelected ? 4 : 2.5, color, opacity: dimmed ? 0.25 : 1 },
 32:         itemStyle: { color, opacity: dimmed ? 0.25 : 1 },
 33:         data: trendData,
 34:         emphasis: {
 35:           focus: 'series',
 36:           lineStyle: { width: 4 },
 37:           symbolSize: 10,
 38:         },
 39:       };
 40:     });
 41:   }, [data, topSectors, selectedSector]);
 42:   const option = useMemo(() => {
 43:     if (!data?.dates || !topSectors || topSectors.length === 0) return null;
 44:     return {
 45:       tooltip: {
 46:         ...tooltipStyle,
 47:         trigger: 'axis',
 48:         formatter: (params) => {
 49:           let html = `<div style="font-weight:700;margin-bottom:6px">${params[0].axisValue}</div>`;
 50:           const sorted = [...params].sort((a, b) => b.value - a.value);
 51:           sorted.forEach(p => {
 52:             if (p.value == null) return;
 53:             const heat = p.value;
 54:             const color = heat > 70 ? '#ef4444' : heat > 55 ? '#f97316' : heat > 40 ? '#eab308' : '#22c55e';
 55:             html += `<div style="display:flex;align-items:center;gap:6px;margin:2px 0">`;
 56:             html += `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${p.color}"></span>`;
 57:             html += `<span style="flex:1">${p.seriesName}</span>`;
 58:             html += `<span style="font-weight:600;color:${color}">${heat.toFixed(1)}</span>`;
 59:             html += `</div>`;
 60:           });
 61:           return html;
 62:         },
 63:       },
 64:       legend: {
 65:         type: 'scroll',
 66:         top: 0,
 67:         textStyle: { color: 'var(--text-secondary)', fontSize: 11 },
 68:         pageTextStyle: { color: 'var(--text-muted)' },
 69:         pageItemSize: 12,
 70:       },
 71:       grid: {
 72:         top: 40,
 73:         left: 40,
 74:         right: 20,
 75:         bottom: 30,
 76:       },
 77:       xAxis: {
 78:         type: 'category',
 79:         data: data.dates,
 80:         boundaryGap: false,
 81:         axisLabel: {
 82:           color: 'var(--text-secondary)',
 83:           fontSize: 10,
 84:           rotate: 35,
 85:           interval: 'auto',
 86:           formatter: (val) => val.slice(5),
 87:         },
 88:         axisLine: { lineStyle: { color: 'var(--border-color)' } },
 89:         axisTick: { show: false },
 90:       },
 91:       yAxis: {
 92:         type: 'value',
 93:         min: 0,
 94:         max: 100,
 95:         axisLabel: {
 96:           color: 'var(--text-secondary)',
 97:           fontSize: 11,
 98:         },
 99:         splitLine: { lineStyle: { color: 'var(--border-color)', type: 'dashed', opacity: 0.5 } },
100:         axisLine: { show: false },
101:         axisTick: { show: false },
102:       },
103:       series,
104:     };
105:   }, [data, topSectors, series]);
106:   if (!option) return null;
107:   const onEvents = onSectorClick ? {
108:     click: (params) => {
109:       if (params.componentType === 'series') onSectorClick(params.seriesName);
110:     },
111:   } : undefined;
112:   return (
113:     <div className="h-full">
114:       <ReactECharts
115:         echarts={echarts}
116:         option={option}
117:         notMerge={true}
118:         style={{ height: typeof height === 'number' ? `${height}px` : height, width: '100%' }}
119:         opts={{ renderer: 'canvas' }}
120:         onEvents={onEvents}
121:       />
122:     </div>
123:   );
124: }
</file>

