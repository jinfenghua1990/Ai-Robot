  7: from datetime import datetime
  8: from sqlalchemy import select
  9: from utils.cache import BoundedDict
 10: logger = logging.getLogger(__name__)
 11: router = APIRouter()
 12: # 内存缓存：{ cache_key: (result, timestamp) }
 13: _cache = BoundedDict(maxsize=100)
 14: _flow_trend_cache = BoundedDict(maxsize=50)
 15: _flow_rank_cache = BoundedDict(maxsize=50)
 16: _CACHE_TTL = 300  # 5分钟
 17: def _resolve_trade_date(db, raw_date):
 18:     """若 raw_date 当天无数据，向前查找最近一个交易日。返回 (实际日期, 字符串形式)。"""
 19:     if raw_date:
 20:         try:
 21:             end_date = datetime.strptime(raw_date, '%Y-%m-%d').date()
 22:         except ValueError:
 23:             raise HTTPException(status_code=400, detail="date must be YYYY-MM-DD format")
 24:     else:
 25:         end_date = datetime.now().date()
 26:     latest = db.query(SectorFlow.trade_date).filter(
 27:         SectorFlow.trade_date <= end_date
 28:     ).order_by(SectorFlow.trade_date.desc()).first()
 29:     if not latest:
 30:         return None, None
 31:     actual = latest[0]
 32:     return actual, actual.strftime('%Y-%m-%d')
 33: @router.get("/api/heatmap")
 34: def get_heatmap(response: Response, date: str = Query(None), days: int = Query(5)):
 35:     """返回热力图数据：日期×板块的heat_score矩阵（正序：旧→新）"""
 36:     # 输入验证
 37:     if days < 1 or days > 30:
 38:         raise HTTPException(status_code=400, detail="days must be between 1 and 30")
 39:     if date:
 40:         try:
 41:             datetime.strptime(date, '%Y-%m-%d')
 42:         except ValueError:
 43:             raise HTTPException(status_code=400, detail="date must be YYYY-MM-DD format")
 44:     # 缓存检查
 45:     cache_key = f"{date}_{days}"
 46:     cached = _cache.get(cache_key)
 47:     if cached and time.time() - cached[1] < _CACHE_TTL:
 48:         response.headers["Cache-Control"] = "public, max-age=300"
 49:         response.headers["X-Cache"] = "HIT"
 50:         return cached[0]
 51:     with get_db_session() as db:
 52:         end_date = datetime.strptime(date, '%Y-%m-%d') if date else datetime.now()
 53:         # 一次查询获取所需日期范围内的所有数据，避免两次独立查询
 54:         # 先用子查询找到最近的 N 个交易日
 55:         available_dates_subq = (
 56:             select(SectorFlow.trade_date)
 57:             .filter(SectorFlow.trade_date <= end_date.date())
 58:             .distinct()
 59:             .order_by(SectorFlow.trade_date.desc())
 60:             .limit(days)
 61:             .scalar_subquery()
 62:         )
 63:         # 直接查询这些日期的所有数据
 64:         sectors = db.query(SectorFlow).filter(
 65:             SectorFlow.trade_date.in_(available_dates_subq)
 66:         ).all()
 67:         # 提取日期并排序（旧→新）
 68:         date_set = sorted(set(s.trade_date for s in sectors))
 69:         dates = [d.strftime('%Y-%m-%d') for d in date_set]
 70:         if not dates:
 71:             result = {'dates': [], 'sectors': [], 'values': [], 'actual_date': None}
 72:             _cache[cache_key] = (result, time.time())
 73:             response.headers["Cache-Control"] = "public, max-age=300"
 74:             response.headers["X-Cache"] = "MISS"
 75:             return result
 76:         # 用字典做 O(1) 查找，用 sorted 保证顺序确定
 77:         date_index = {d: i for i, d in enumerate(dates)}
 78:         sector_names = sorted(set(s.sector for s in sectors))
 79:         sector_index = {s: i for i, s in enumerate(sector_names)}
 80:         values = []
 81:         for s in sectors:
 82:             date_str = s.trade_date.strftime('%Y-%m-%d')
 83:             x = date_index.get(date_str, -1)
 84:             if x >= 0:
 85:                 y = sector_index.get(s.sector, -1)
 86:                 if y >= 0:
 87:                     values.append([x, y, float(s.heat_score or 0)])
 88:         result = {
 89:             'dates': dates,
 90:             'sectors': sector_names,
 91:             'values': values,
 92:             'actual_date': dates[-1],
 93:         }
 94:         # 写入缓存
 95:         _cache[cache_key] = (result, time.time())
 96:         response.headers["Cache-Control"] = "public, max-age=300"
 97:         response.headers["X-Cache"] = "MISS"
 98:         return result
 99: @router.get("/api/sector-flow-trend")
100: def get_sector_flow_trend(
101:     response: Response,
102:     date: str = Query(None),
103:     days: int = Query(5),
104:     sectors: str = Query(None),
105: ):
106:     """返回指定板块最近 N 个交易日的 net_flow 时间序列（旧→新）"""
107:     if days < 1 or days > 30:
108:         raise HTTPException(status_code=400, detail="days must be between 1 and 30")
109:     if date:
110:         try:
111:             datetime.strptime(date, '%Y-%m-%d')
112:         except ValueError:
113:             raise HTTPException(status_code=400, detail="date must be YYYY-MM-DD format")
114:     sector_list = [s.strip() for s in (sectors or '').split(',') if s.strip()]
115:     if not sector_list:
116:         raise HTTPException(status_code=400, detail="sectors is required")
117:     cache_key = f"{date}_{days}_{','.join(sector_list)}"
118:     cached = _flow_trend_cache.get(cache_key)
119:     if cached and time.time() - cached[1] < _CACHE_TTL:
120:         response.headers["Cache-Control"] = "public, max-age=300"
121:         response.headers["X-Cache"] = "HIT"
122:         return cached[0]
123:     with get_db_session() as db:
124:         end_date = datetime.strptime(date, '%Y-%m-%d') if date else datetime.now()
125:         available_dates_subq = (
126:             select(SectorFlow.trade_date)
127:             .filter(SectorFlow.trade_date <= end_date.date())
128:             .distinct()
129:             .order_by(SectorFlow.trade_date.desc())
130:             .limit(days)
131:             .scalar_subquery()
132:         )
133:         records = db.query(SectorFlow).filter(
134:             SectorFlow.trade_date.in_(available_dates_subq),
135:             SectorFlow.sector.in_(sector_list),
136:         ).all()
137:         date_set = sorted(set(r.trade_date for r in records))
138:         dates = [d.strftime('%Y-%m-%d') for d in date_set]
139:         if not dates:
140:             result = {'dates': [], 'series': [], 'actual_date': None}
141:             _flow_trend_cache[cache_key] = (result, time.time())
142:             response.headers["Cache-Control"] = "public, max-age=300"
143:             response.headers["X-Cache"] = "MISS"
144:             return result
145:         date_index = {d: i for i, d in enumerate(dates)}
146:         data_map = {(r.sector, date_index[r.trade_date.strftime('%Y-%m-%d')]): float(r.net_flow or 0) for r in records}
147:         series = []
148:         for name in sector_list:
149:             values = [data_map.get((name, i), 0) for i in range(len(dates))]
150:             series.append({'sector': name, 'values': values})
151:         result = {'dates': dates, 'series': series, 'actual_date': dates[-1]}
152:         _flow_trend_cache[cache_key] = (result, time.time())
153:         response.headers["Cache-Control"] = "public, max-age=300"
154:         response.headers["X-Cache"] = "MISS"
155:         return result
