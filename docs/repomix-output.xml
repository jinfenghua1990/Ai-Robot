130: def _price_field(bars: Sequence[Bar], name: str) -> float:
131:     bar = bars[-1]
132:     if name == "open":
133:         return bar.open
134:     if name == "high":
135:         return bar.high
136:     if name == "low":
137:         return bar.low
138:     return bar.amount / bar.volume if bar.volume else bar.close
139: def _window(values: Sequence[float], period: int) -> list[float] | None:
140:     return list(values[-period:]) if len(values) >= period else None
141: def _change_window(values: Sequence[float], period: int) -> list[float] | None:
142:     if len(values) < period + 1:
143:         return None
144:     return [values[index] - values[index - 1] for index in range(len(values) - period, len(values))]
145: def _alpha158_values(bars: Sequence[Bar]) -> dict[str, float | None]:
146:     if not bars:
147:         return {}
148:     latest = bars[-1]
149:     close = [bar.close for bar in bars]
150:     high = [bar.high for bar in bars]
151:     low = [bar.low for bar in bars]
152:     volume = [bar.volume for bar in bars]
153:     current_close = latest.close
154:     result: dict[str, float | None] = {}
155:     candle_range = latest.high - latest.low
156:     open_price = latest.open
157:     upper = latest.high - max(latest.open, latest.close)
158:     lower = min(latest.open, latest.close) - latest.low
159:     result.update({
160:         "qlib_alpha158_kmid": _div(latest.close - latest.open, open_price),
161:         "qlib_alpha158_klen": _div(latest.high - latest.low, open_price),
162:         "qlib_alpha158_kmid2": _div(latest.close - latest.open, candle_range),
163:         "qlib_alpha158_kup": _div(upper, open_price),
164:         "qlib_alpha158_kup2": _div(upper, candle_range),
165:         "qlib_alpha158_klow": _div(lower, open_price),
166:         "qlib_alpha158_klow2": _div(lower, candle_range),
167:         "qlib_alpha158_ksft": _div(2 * latest.close - latest.high - latest.low, open_price),
168:         "qlib_alpha158_ksft2": _div(2 * latest.close - latest.high - latest.low, candle_range),
169:     })
170:     for field in ("open", "high", "low", "vwap"):
171:         result[f"qlib_alpha158_{field}0"] = _div(_price_field(bars, field), current_close)
172:     for period in WINDOWS:
173:         closes = _window(close, period)
174:         highs = _window(high, period)
175:         lows = _window(low, period)
176:         volumes = _window(volume, period)
177:         changes = _change_window(close, period)
178:         volume_changes = _change_window(volume, period)
179:         if not closes or not highs or not lows or not volumes:
180:             for operator in ("roc", "ma", "std", "beta", "rsqr", "resi", "max", "min", "qtlu", "qtld", "rank", "rsv", "imax", "imin", "imxd", "corr", "cord", "cntp", "cntn", "cntd", "sump", "sumn", "sumd", "vma", "vstd", "wvma", "vsump", "vsumn", "vsumd"):
181:                 result[f"qlib_alpha158_{operator}{period}"] = None
182:             continue
183:         lagged_close = close[-period - 1] if len(close) >= period + 1 else None
184:         result[f"qlib_alpha158_roc{period}"] = _div(lagged_close, current_close)
185:         result[f"qlib_alpha158_ma{period}"] = _div(mean(closes), current_close)
186:         result[f"qlib_alpha158_std{period}"] = _div(pstdev(closes), current_close)
187:         slope = _slope(closes)
188:         result[f"qlib_alpha158_beta{period}"] = _div(slope, current_close)
189:         if slope is None:
190:             result[f"qlib_alpha158_rsqr{period}"] = None
191:             result[f"qlib_alpha158_resi{period}"] = None
192:         else:
193:             xbar = (period - 1) / 2
194:             ybar = mean(closes)
195:             intercept = ybar - slope * xbar
196:             fitted = [intercept + slope * index for index in range(period)]
197:             total = sum((value - ybar) ** 2 for value in closes)
198:             residual = closes[-1] - fitted[-1]
199:             result[f"qlib_alpha158_rsqr{period}"] = _safe(1 - sum((actual - predicted) ** 2 for actual, predicted in zip(closes, fitted)) / total) if total else 0.0
200:             result[f"qlib_alpha158_resi{period}"] = _div(residual, current_close)
201:         result[f"qlib_alpha158_max{period}"] = _div(max(highs), current_close)
202:         result[f"qlib_alpha158_min{period}"] = _div(min(lows), current_close)
203:         result[f"qlib_alpha158_qtlu{period}"] = _div(_quantile(closes, 0.8), current_close)
204:         result[f"qlib_alpha158_qtld{period}"] = _div(_quantile(closes, 0.2), current_close)
205:         result[f"qlib_alpha158_rank{period}"] = _safe((sum(value < current_close for value in closes) + 0.5 * sum(value == current_close for value in closes)) / period)
206:         range_value = max(highs) - min(lows)
207:         result[f"qlib_alpha158_rsv{period}"] = _div(current_close - min(lows), range_value)
208:         max_index = max(index for index, value in enumerate(highs) if value == max(highs))
209:         min_index = max(index for index, value in enumerate(lows) if value == min(lows))
210:         idx_max = (period - 1 - max_index) / period
211:         idx_min = (period - 1 - min_index) / period
212:         result[f"qlib_alpha158_imax{period}"] = _safe(idx_max)
213:         result[f"qlib_alpha158_imin{period}"] = _safe(idx_min)
214:         result[f"qlib_alpha158_imxd{period}"] = _safe(idx_max - idx_min)
215:         log_volume = [math.log(max(value, 0.0) + 1.0) for value in volumes]
216:         result[f"qlib_alpha158_corr{period}"] = _corr(closes, log_volume)
217:         if changes and volume_changes:
218:             close_ratios = [close[index] / close[index - 1] for index in range(len(close) - period, len(close)) if close[index - 1]]
219:             volume_ratios = [math.log(max(volume[index] / volume[index - 1], 0.0) + 1.0) for index in range(len(volume) - period, len(volume)) if volume[index - 1]]
220:             result[f"qlib_alpha158_cord{period}"] = _corr(close_ratios, volume_ratios) if len(close_ratios) == len(volume_ratios) else None
221:             positive_changes = [value for value in changes if value > 0]
222:             negative_changes = [-value for value in changes if value < 0]
223:             absolute_changes = sum(abs(value) for value in changes)
224:             result[f"qlib_alpha158_cntp{period}"] = sum(value > 0 for value in changes) / period
225:             result[f"qlib_alpha158_cntn{period}"] = sum(value < 0 for value in changes) / period
226:             result[f"qlib_alpha158_cntd{period}"] = result[f"qlib_alpha158_cntp{period}"] - result[f"qlib_alpha158_cntn{period}"]
227:             result[f"qlib_alpha158_sump{period}"] = _div(sum(positive_changes), absolute_changes)
228:             result[f"qlib_alpha158_sumn{period}"] = _div(sum(negative_changes), absolute_changes)
229:             result[f"qlib_alpha158_sumd{period}"] = _div(sum(positive_changes) - sum(negative_changes), absolute_changes)
230:         else:
231:             for operator in ("cord", "cntp", "cntn", "cntd", "sump", "sumn", "sumd"):
232:                 result[f"qlib_alpha158_{operator}{period}"] = None
233:         result[f"qlib_alpha158_vma{period}"] = _div(mean(volumes), latest.volume)
234:         result[f"qlib_alpha158_vstd{period}"] = _div(pstdev(volumes), latest.volume)
235:         if changes:
236:             weighted = [abs(changes[index]) * volume[len(volume) - period + index] for index in range(period)]
237:             result[f"qlib_alpha158_wvma{period}"] = _div(pstdev(weighted), mean(weighted)) if weighted else None
238:         else:
239:             result[f"qlib_alpha158_wvma{period}"] = None
240:         if volume_changes:
241:             positive_volume = [value for value in volume_changes if value > 0]
242:             negative_volume = [-value for value in volume_changes if value < 0]
243:             absolute_volume = sum(abs(value) for value in volume_changes)
244:             result[f"qlib_alpha158_vsump{period}"] = _div(sum(positive_volume), absolute_volume)
245:             result[f"qlib_alpha158_vsumn{period}"] = _div(sum(negative_volume), absolute_volume)
246:             result[f"qlib_alpha158_vsumd{period}"] = _div(sum(positive_volume) - sum(negative_volume), absolute_volume)
247:         else:
248:             result[f"qlib_alpha158_vsump{period}"] = None
249:             result[f"qlib_alpha158_vsumn{period}"] = None
250:             result[f"qlib_alpha158_vsumd{period}"] = None
251:     return result
252: calculate_alpha158 = _alpha158_values
253: ALPHA158_FACTOR_NAMES = frozenset(item.name for item in alpha158_definitions())
