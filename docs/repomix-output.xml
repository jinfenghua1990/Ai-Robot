<file path="backend/api/watchlist/groups.py">
 1: """watchlist 分组管理 API
 2: - GET    /api/watchlist/groups
 3: - POST   /api/watchlist/groups
 4: - PUT    /api/watchlist/groups/rename
 5: - DELETE /api/watchlist/groups/{name}
 6: """
 7: import logging
 8: from fastapi import APIRouter, HTTPException, Query
 9: from pydantic import BaseModel
10: from db.session import get_db_session
11: from db.models import Watchlist
12: from ._shared import reset_watchlist_cache
13: logger = logging.getLogger(__name__)
14: router = APIRouter()
15: class GroupRenameRequest(BaseModel):
16:     old_name: str
17:     new_name: str
18: @router.get("/api/watchlist/groups")
19: async def list_groups():
20:     with get_db_session() as db:
21:         rows = db.query(Watchlist.group_name, Watchlist.stock_code).all()
22:         groups = {}
23:         for g, c in rows:
24:             name = g or '默认'
25:             groups[name] = groups.get(name, 0) + 1
26:         groups.setdefault('默认', 0)
27:         result = [{'name': n, 'count': cnt} for n, cnt in sorted(groups.items(), key=lambda x: (x[0] == '默认', x[0]))]
28:         return {'groups': result, 'active': '默认'}
29: @router.post("/api/watchlist/groups")
30: async def create_group(req: dict):
31:     name = (req.get('name') or '').strip()
32:     if not name:
33:         raise HTTPException(status_code=400, detail="分组名不能为空")
34:     if len(name) > 20:
35:         raise HTTPException(status_code=400, detail="分组名过长（≤20字）")
36:     with get_db_session() as db:
37:         existing = db.query(Watchlist.group_name).filter(Watchlist.group_name == name).first()
38:         if existing:
39:             raise HTTPException(status_code=400, detail=f"分组「{name}」已存在")
40:         return {'success': True, 'name': name}
41: @router.put("/api/watchlist/groups/rename")
42: async def rename_group(req: GroupRenameRequest):
43:     old = (req.old_name or '').strip()
44:     new = (req.new_name or '').strip()
45:     if not old or not new:
46:         raise HTTPException(status_code=400, detail="分组名不能为空")
47:     if old == new:
48:         return {'success': True, 'affected': 0}
49:     with get_db_session() as db:
50:         affected = db.query(Watchlist).filter(Watchlist.group_name == old).update({'group_name': new})
51:         db.commit()
52:         reset_watchlist_cache()
53:         # 同步 JSON：更新该分组下所有股票
54:         from .watchlist_local import read_local, write_local
55:         data = read_local()
56:         for s in data["stocks"]:
57:             if s.get("group") == old:
58:                 s["group"] = new
59:         write_local(data)
60:         return {'success': True, 'affected': affected, 'new_name': new}
61: @router.delete("/api/watchlist/groups/{name}")
62: async def delete_group(name: str, force: bool = Query(False)):
63:     if name == '默认':
64:         raise HTTPException(status_code=400, detail="默认分组不可删除")
65:     with get_db_session() as db:
66:         count = db.query(Watchlist).filter(Watchlist.group_name == name).count()
67:         if count > 0 and not force:
68:             raise HTTPException(status_code=400, detail=f"分组「{name}」还有 {count} 只股票，请先移走或使用 force=true")
69:         if force and count > 0:
70:             db.query(Watchlist).filter(Watchlist.group_name == name).update({'group_name': '默认'})
71:         db.commit()
72:         reset_watchlist_cache()
73:         # 同步 JSON
74:         if force and count > 0:
75:             from .watchlist_local import read_local, write_local
76:             data = read_local()
77:             for s in data["stocks"]:
78:                 if s.get("group") == name:
79:                     s["group"] = "默认"
80:             write_local(data)
81:         return {'success': True, 'moved': count if force else 0}
