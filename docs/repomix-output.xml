  1: """美股 / 港股数据层 —— 移植自 global-stock-data（美港股全栈工具包）。
  2: 只并入「域内(东财)」的合规子集：全球指数 + 美港股行情 + 关键财务指标。
  3: 用途＝A 股「看隔夜外围脸色」+ 个股页支持美港股代码。
  4: 工程要点：
  5: - 东财调用全部复用 `astock.em_get`（直连优先、避开用户 Clash 代理挂国内站）+
  6:   `astock.eastmoney_datacenter`（datacenter 三表/指标已封装）。
  7: - push2 stock/get 直连偶发掉连 → **push2 优先、失败降级 push2delay**（延时行情，研究场景足够），
  8:   latch 到可用主机整进程复用（同成交额榜的做法）。
  9: - Yahoo / SEC 等国外源不并入（需科学上网、且非必要）。
 10: 合规：只做客观数据整理，不预置标的、不推荐、不预测。
 11: """
 12: from __future__ import annotations
 13: from services.research import astock
 14: _UA_H = {"User-Agent": astock.UA}
 15: _GS_HOSTS = ("push2.eastmoney.com", "push2delay.eastmoney.com")
 16: _gs_host = [0]  # 当前可用主机下标；首次 push2 掉连后 latch 到 push2delay
 17: # 全球指数（东财 push2 secid）—— A 股看隔夜外围脸色的核心几个，均已实测。
 18: _INDICES = (
 19:     {"key": "dji", "name": "道琼斯", "secid": "100.DJIA", "region": "美股"},
 20:     {"key": "spx", "name": "标普500", "secid": "100.SPX", "region": "美股"},
 21:     {"key": "ndx", "name": "纳斯达克", "secid": "100.NDX", "region": "美股"},
 22:     {"key": "hsi", "name": "恒生指数", "secid": "100.HSI", "region": "港股"},
 23:     {"key": "hstech", "name": "恒生科技", "secid": "124.HSTECH", "region": "港股"},
 24: )
 25: # 搜索返回的 MktNum → (secucode 后缀, 市场名)
 26: _MKT = {105: (".O", "NASDAQ"), 106: (".N", "NYSE"), 107: (".O", "US"), 116: (".HK", "HK"),
 27:         177: (".KS", "KR")}  # 177=韩股（Kospi/Kosdaq，含三星/SK海力士等半导体龙头）；东财仅行情、无 F10 财务
 28: _QUOTE_FIELDS = "f43,f44,f45,f46,f48,f57,f58,f59,f60,f116,f170"
 29: def _push2_stock_get(secid: str, fields: str) -> dict | None:
 30:     """东财 push2 stock/get：push2 优先、失败降级 push2delay；latch 可用主机。空数据返回 None。"""
 31:     params = {"secid": secid, "fields": fields}
 32:     for i in range(_gs_host[0], len(_GS_HOSTS)):
 33:         try:
 34:             r = astock.em_get(f"https://{_GS_HOSTS[i]}/api/qt/stock/get",
 35:                               params=params, headers=_UA_H, timeout=10)
 36:             d = r.json().get("data")
 37:         except Exception:
 38:             continue
 39:         if d:
 40:             _gs_host[0] = i
 41:             return d
 42:     return None
 43: def _price(d: dict, key: str):
 44:     """f43 等价格字段：除以 10^f59 还原。'-' / None → None。"""
 45:     v = d.get(key)
 46:     if not isinstance(v, (int, float)):
 47:         return None
 48:     dec = d.get("f59")
 49:     if not isinstance(dec, int):  # 注意：不能用 `or 2`——韩元等 f59=0 会被误判成 2，价格被多除 100 倍
 50:         dec = 2
 51:     return round(v / (10 ** dec), dec)
 52: def _quote_from(d: dict) -> dict:
 53:     chg = d.get("f170")
 54:     return {
 55:         "code": d.get("f57"), "name": d.get("f58"),
 56:         "price": _price(d, "f43"), "open": _price(d, "f46"),
 57:         "high": _price(d, "f44"), "low": _price(d, "f45"),
 58:         "prev_close": _price(d, "f60"),
 59:         "amount": d.get("f48") if isinstance(d.get("f48"), (int, float)) else None,
 60:         "mcap": d.get("f116") if isinstance(d.get("f116"), (int, float)) and d.get("f116") else None,
 61:         "change_pct": round(chg / 100, 2) if isinstance(chg, (int, float)) else None,
 62:     }
 63: def global_indices() -> list[dict]:
 64:     """全球指数快照（道指 / 标普500 / 纳斯达克 / 恒生 / 恒生科技）。源无的档跳过。"""
 65:     out = []
 66:     for idx in _INDICES:
 67:         d = _push2_stock_get(idx["secid"], "f43,f57,f58,f59,f60,f170")
 68:         if not d:
 69:             continue
 70:         chg = d.get("f170")
 71:         out.append({
 72:             "key": idx["key"], "name": idx["name"], "region": idx["region"],
 73:             "price": _price(d, "f43"),
 74:             "change_pct": round(chg / 100, 2) if isinstance(chg, (int, float)) else None,
 75:         })
 76:     return out
 77: def _search(q: str) -> dict | None:
 78:     """东财搜索一次：市场过滤 + **精确代码匹配优先**，退而取第一条。
 79:     只按 MktNum 过滤挑不出正股——东财搜 AAPL 会混入 AAPL22(票据)/AAPB(2倍做多ETF)，
 80:     搜 BABA 混入 05593(窝轮)，且 SecurityType 分不开(正股与 ETF 同为 Type7、正股港股与窝轮同为 Type6)。
 81:     正股的 Code 恰好等于查询词，故精确匹配 Code==q 最稳；无精确匹配(名称查询)才退回第一条。
 82:     """
 83:     url = "https://searchapi.eastmoney.com/api/suggest/get"
 84:     params = {"input": q, "type": 14,
 85:               "token": "D43BF722C8E33BDC906FB84D85E326E8", "count": 10}
 86:     try:
 87:         r = astock.em_get(url, params=params, headers=_UA_H, timeout=10)
 88:         rows = (r.json().get("QuotationCodeTable") or {}).get("Data") or []
 89:     except Exception:
 90:         return None
 91:     matches = []
 92:     for s in rows:
 93:         try:
 94:             mkt = int(s.get("MktNum"))
 95:         except (TypeError, ValueError):
 96:             continue
 97:         if mkt in _MKT:
 98:             matches.append((mkt, s))
 99:     if not matches:
100:         return None
101:     mkt, s = next(((m, x) for m, x in matches if str(x.get("Code", "")).upper() == q), matches[0])
102:     suffix, market = _MKT[mkt]
103:     code = s.get("Code", "")
104:     return {"code": code, "name": s.get("Name", ""), "secid_prefix": mkt,
105:             "secucode": f"{code}{suffix}", "market": market}
106: def resolve_symbol(query: str) -> dict | None:
107:     """代码/名称 → {code, name, secid_prefix, secucode, market}。认美股/港股/韩股。
108:     数字型港股短代码（如 `700`）补零到 5 位再试一次（东财按 `00700` 收）。
109:     韩股用国际后缀 `.KS`/`.KQ`/`.KR`（如三星 `005930.KS`）——韩股代码与 A 股同为 6 位数字，
110:     需显式后缀区分，否则前端会按 A 股处理、后端也搜不到韩股。"""
111:     q = query.strip().upper()
112:     if not q:
113:         return None
114:     for suf in (".KS", ".KQ", ".KR"):  # 剥掉韩股后缀，按裸代码搜（东财 177=韩股）
115:         if q.endswith(suf):
116:             q = q[: -len(suf)]
117:             break
118:     hit = _search(q)
119:     if hit is None and q.isdigit() and len(q) < 5:
120:         hit = _search(q.zfill(5))
121:     return hit
122: def _key_metrics(secucode: str) -> dict | None:
123:     """东财 GMAININDICATOR 最新一期关键财务指标（美股/港股中文字段）。"""
124:     market = "HK" if secucode.endswith(".HK") else "US"
125:     rows = astock.eastmoney_datacenter(
126:         f"RPT_{market}F10_FN_GMAININDICATOR",
127:         filter_str=f'(SECUCODE="{secucode}")',
128:         page_size=1, sort_columns="REPORT_DATE", sort_types="-1")
129:     if not rows:
130:         return None
131:     m = rows[0]
132:     return {
133:         "report_date": str(m.get("REPORT_DATE") or "")[:10],
134:         "revenue": m.get("OPERATE_INCOME"),
135:         "revenue_yoy": m.get("OPERATE_INCOME_YOY"),
136:         "net_profit": m.get("PARENT_HOLDER_NETPROFIT") or m.get("HOLDER_PROFIT"),
137:         "eps": m.get("BASIC_EPS"),
138:         "roe": m.get("ROE_AVG"),
139:         "gross_margin": m.get("GROSS_PROFIT_RATIO"),
140:         "net_margin": m.get("NET_PROFIT_RATIO"),
141:         "debt_ratio": m.get("DEBT_ASSET_RATIO"),
142:     }
143: def us_hk_stock(query: str) -> dict:
144:     """个股聚合（美/港）：解析代码 → 行情 + 关键财务指标。查不到返回 {}。"""
145:     info = resolve_symbol(query)
146:     if not info:
147:         return {}
148:     d = _push2_stock_get(f"{info['secid_prefix']}.{info['code']}", _QUOTE_FIELDS)
149:     quote = _quote_from(d or {})  # 行情临时取不到也返回完整 null 形状，契合 GlobalQuote 类型
150:     return {
151:         "code": info["code"],
152:         "name": info["name"] or quote.get("name") or info["code"],
153:         "market": info["market"],
154:         "quote": quote,
155:         "metrics": _key_metrics(info["secucode"]) if info["market"] != "KR" else None,  # 韩股东财无 F10 财务
156:     }
157: def get_klines(symbol: str, days: int = 252) -> list[dict] | None:
158:     """获取美股/港股历史K线（东财 push2his）
159:     Args:
160:         symbol: 股票代码（如 AAPL, 00700）
161:         days: 需要的最多天数
162:     Returns:
163:         [{date, open, high, low, close, volume}, ...] 按日期升序
164:     """
165:     info = resolve_symbol(symbol)
166:     if not info:
167:         return None
168:     secid = f"{info['secid_prefix']}.{info['code']}"
169:     url = "https://push2his.eastmoney.com/api/qt/stock/kline/get"
170:     params = {
171:         "secid": secid,
172:         "fields1": "f1,f2,f3",
173:         "fields2": "f51,f52,f53,f54,f55,f56,f57,f58,f59,f60,f61",
174:         "klt": "101",   # 日K
175:         "fqt": "1",     # 前复权
176:         "end": "20500101",
177:         "lmt": str(min(days, 1000)),   # 最多1000天
178:     }
179:     try:
180:         r = astock.em_get(url, params=params, headers=_UA_H, timeout=15)
181:         d = r.json()
182:         klines = d.get("data", {}).get("klines", [])
183:     except Exception as exc:
184:         import logging
185:         logging.getLogger(__name__).debug(f"[gstock] get_klines failed {symbol}: {exc}")
186:         return None
187:     if not klines:
188:         return None
189:     items = []
190:     for line in klines:
191:         parts = line.split(",")
192:         if len(parts) < 6:
193:             continue
194:         close = float(parts[1]) if parts[1] else None
195:         if close is None:
196:             continue
197:         items.append({
198:             "date": parts[0].strip(),
199:             "open": float(parts[2]) if parts[2] else None,
200:             "high": float(parts[3]) if parts[3] else None,
201:             "low": float(parts[4]) if parts[4] else None,
202:             "close": close,
203:             "volume": int(float(parts[5])) if parts[5] else 0,
204:         })
205:     # 东财返回降序，需要反转
206:     items.reverse()
207:     return items if items else None
