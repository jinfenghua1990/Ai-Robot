  1: """Production-facing helpers for the V2 right-side factor engine.
  2: This module is deliberately independent from the legacy strategy tables.  It
  3: owns the completed-daily-bar date, the tradable universe, bulk history loading,
  4: cross-sectional ranking, and the payload consumed by the execution layer.
  5: """
  6: from __future__ import annotations
  7: from dataclasses import asdict
  8: from datetime import date
  9: from typing import Iterable, Mapping, Optional
 10: from sqlalchemy import func
 11: from db.models import StockDailyKline, StockFlow
 12: from .contracts import DailyBar, MarketContext, SignalSnapshot
 13: from .pipeline import QuantPipeline
 14: def _clean_name(value: object) -> str:
 15:     return str(value or "").upper().replace(" ", "").replace("　", "")
 16: def is_st_name(name: object) -> bool:
 17:     """Return True for ST/*ST names after whitespace normalization."""
 18:     normalized = _clean_name(name)
 19:     return normalized.startswith("ST") or normalized.startswith("*ST")
 20: def resolve_trade_date(db, requested: Optional[date] = None) -> Optional[date]:
 21:     """Resolve a signal date to the latest completed daily-bar date.
 22:     Intraday callers commonly pass today's calendar date while the latest
 23:     completed daily bar is yesterday's date.  Falling back to a date <= the
 24:     requested date prevents the execution layer from labelling stale signals
 25:     as today's signals.
 26:     """
 27:     query = db.query(func.max(StockDailyKline.trade_date))
 28:     if requested is not None:
 29:         query = query.filter(StockDailyKline.trade_date <= requested)
 30:     return query.scalar()
 31: def _metadata_for_date(db, trade_date: date) -> dict[str, dict[str, str]]:
 32:     """Load one name/sector record per symbol for a completed trade date."""
 33:     result: dict[str, dict[str, str]] = {}
 34:     rows = db.query(
 35:         StockFlow.ts_code, StockFlow.name, StockFlow.sector
 36:     ).filter(StockFlow.trade_date == trade_date).all()
 37:     for code, name, sector in rows:
 38:         result.setdefault(code, {"name": name or "", "sector": sector or ""})
 39:     return result
 40: def latest_codes(db, trade_date: date, limit: Optional[int] = None) -> list[str]:
 41:     """Build the eligible V2 universe from all symbols with a latest bar.
 42:     ``limit`` is only a safety cap for callers that explicitly request one;
 43:     it is never used as the ranking mechanism.  The production API scores the
 44:     full eligible universe first and applies the display limit afterwards.
 45:     """
 46:     metadata = _metadata_for_date(db, trade_date)
 47:     rows = db.query(
 48:         StockDailyKline.ts_code,
 49:         StockDailyKline.close,
 50:         StockDailyKline.volume,
 51:     ).filter(
 52:         StockDailyKline.trade_date == trade_date,
 53:         StockDailyKline.close > 0,
 54:         StockDailyKline.volume > 0,
 55:     ).distinct().all()
 56:     codes = []
 57:     for code, close, volume in rows:
 58:         meta = metadata.get(code, {})
 59:         if is_st_name(meta.get("name")):
 60:             continue
 61:         codes.append(code)
 62:     codes.sort()
 63:     return codes[:limit] if limit else codes
 64: def load_history(
 65:     db,
 66:     codes: Iterable[str],
 67:     trade_date: date,
 68:     lookback: int = 120,
 69: ) -> dict[str, list[DailyBar]]:
 70:     """Bulk-load bounded history instead of issuing one query per symbol."""
 71:     code_list = list(dict.fromkeys(codes))
 72:     if not code_list:
 73:         return {}
 74:     metadata = _metadata_for_date(db, trade_date)
 75:     grouped: dict[str, list[DailyBar]] = {code: [] for code in code_list}
 76:     rows = db.query(StockDailyKline).filter(
 77:         StockDailyKline.ts_code.in_(code_list),
 78:         StockDailyKline.trade_date <= trade_date,
 79:     ).order_by(
 80:         StockDailyKline.ts_code,
 81:         StockDailyKline.trade_date.desc(),
 82:     ).all()
 83:     seen: dict[str, int] = {}
 84:     for row in rows:
 85:         count = seen.get(row.ts_code, 0)
 86:         if count >= lookback:
 87:             continue
 88:         meta = metadata.get(row.ts_code, {})
 89:         grouped[row.ts_code].append(DailyBar(
 90:             ts_code=row.ts_code,
 91:             trade_date=row.trade_date,
 92:             open=float(row.open or 0),
 93:             high=float(row.high or 0),
 94:             low=float(row.low or 0),
 95:             close=float(row.close or 0),
 96:             volume=float(row.volume or 0),
 97:             amount=float(row.amount or 0),
 98:             pct_chg=float(row.pct_chg or 0),
 99:             sector=row.sector or meta.get("sector", ""),
100:             is_st=is_st_name(meta.get("name")),
101:         ))
102:         seen[row.ts_code] = count + 1
103:     for code in grouped:
104:         grouped[code].reverse()
105:     return grouped
106: def market_context(db, trade_date: date) -> MarketContext:
107:     """Build market breadth and limit structure from the whole daily universe."""
108:     rows = db.query(
109:         StockDailyKline.ts_code,
110:         StockDailyKline.close,
111:         StockDailyKline.pct_chg,
112:     ).filter(StockDailyKline.trade_date == trade_date).all()
113:     changes = [float(row[2]) for row in rows if row[2] is not None]
114:     breadth = sum(value > 0 for value in changes) / len(changes) if changes else 0.0
115:     normalized = [value * 100 if abs(value) <= 1 else value for value in changes]
116:     limit_up = sum(value >= 9.5 for value in normalized)
117:     limit_down = sum(value <= -9.5 for value in normalized)
118:     prior_dates = [row[0] for row in db.query(
119:         StockDailyKline.trade_date
120:     ).distinct().filter(
121:         StockDailyKline.trade_date <= trade_date
122:     ).order_by(StockDailyKline.trade_date.desc()).limit(21).all()]
123:     market_return = None
124:     if len(prior_dates) >= 21:
125:         prior_date = prior_dates[-1]
126:         latest_close = {code: float(close) for code, close, _ in rows if close}
127:         prior_rows = db.query(
128:             StockDailyKline.ts_code, StockDailyKline.close
129:         ).filter(
130:             StockDailyKline.trade_date == prior_date,
131:             StockDailyKline.ts_code.in_(list(latest_close)),
132:         ).all()
133:         returns = [
134:             latest_close[code] / float(close) - 1
135:             for code, close in prior_rows
136:             if close and latest_close.get(code)
137:         ]
138:         market_return = sum(returns) / len(returns) if returns else None
139:     return MarketContext(
140:         trade_date=trade_date,
141:         breadth=breadth,
142:         limit_up_count=limit_up,
143:         limit_down_count=limit_down,
144:         market_return_20d=market_return,
145:         market_data_available=bool(rows),
146:     )
147: def run_production(
148:     db,
149:     requested_date: Optional[date] = None,
150:     display_limit: Optional[int] = 50,
151:     codes: Optional[Iterable[str]] = None,
152:     lookback: int = 120,
153: ) -> dict:
154:     """Run the V2 production engine and return ranked, explainable signals."""
155:     trade_date = resolve_trade_date(db, requested_date)
156:     if not trade_date:
157:         return {"trade_date": None, "universe_count": 0, "market": None, "signals": [], "values": []}
158:     selected = list(codes) if codes is not None else latest_codes(db, trade_date)
159:     history = load_history(db, selected, trade_date, lookback=lookback)
160:     history = {
161:         code: bars for code, bars in history.items()
162:         if bars and bars[-1].trade_date == trade_date
163:     }
164:     context = market_context(db, trade_date)
165:     pipeline = QuantPipeline()
166:     values, snapshots = pipeline.run_with_values(history, trade_date, context)
167:     metadata = _metadata_for_date(db, trade_date)
168:     ranked = []
169:     for rank, snapshot in enumerate(snapshots, start=1):
170:         item = asdict(snapshot)
171:         item.update(metadata.get(snapshot.ts_code, {}))
172:         item["rank"] = rank
173:         item["eligible"] = snapshot.resonance.eligible
174:         ranked.append(item)
175:     if display_limit is not None:
176:         ranked = ranked[:display_limit]
177:     return {
178:         "trade_date": trade_date,
179:         "universe_count": len(history),
180:         "market": context,
181:         "signals": ranked,
182:         "values": values,
183:         "snapshots": snapshots,
184:     }
</file>

