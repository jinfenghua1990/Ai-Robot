133: def eastmoney_industry_reports(keywords: list[str] | None = None, days: int = 90, max_pages: int = 3) -> list[dict]:
134:     """按行业拉研报（qType=1）——适合产业链 / 主题级检索。keywords 在标题上过滤。"""
135:     from datetime import date, timedelta
