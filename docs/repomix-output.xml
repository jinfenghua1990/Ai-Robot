 1: from datetime import date, timedelta
 2: from quant_vnext.contracts import DailyBar, DimensionScore, MarketContext
 3: from quant_vnext.market_regime import MarketRegimeEngine
 4: from quant_vnext.pipeline import QuantPipeline
 5: from quant_vnext.registry import default_registry
 6: from quant_vnext.scoring import CrossSectionScorer
 7: def _bars(code: str, growth: float, sector: str = "科技"):
 8:     result = []
 9:     for index in range(80):
10:         close = 10 * (1 + growth) ** index
11:         result.append(DailyBar(
12:             code,
13:             date(2026, 1, 1) + timedelta(days=index),
14:             close * 0.99,
15:             close * 1.01,
16:             close * 0.98,
17:             close,
18:             1000 + index * 10,
19:             100000 + index * 100,
20:             sector=sector,
21:         ))
22:     return result
23: def test_registry_contains_seven_factor_groups():
24:     categories = {item.category for item in default_registry().production()}
25:     assert categories == {"market", "sector", "momentum", "trend", "volume_price", "position", "risk"}
26:     assert len(default_registry().production()) >= 30
27: def test_market_regime_changes_weights_and_new_position_permission():
28:     engine = MarketRegimeEngine()
29:     strong = engine.assess(MarketContext(date(2026, 3, 21), 0.80, 30, 5, market_return_20d=0.08))
30:     weak = engine.assess(MarketContext(date(2026, 3, 21), 0.20, 3, 30, market_return_20d=-0.08))
31:     assert strong.state == "STRONG"
32:     assert strong.allow_new_positions is True
33:     assert strong.weights["trend"] > strong.weights["position"]
34:     assert weak.state == "WEAK"
35:     assert weak.allow_new_positions is False
36:     assert weak.weights["risk_penalty"] > strong.weights["risk_penalty"]
37: def test_pipeline_exposes_all_factor_groups_and_market_state():
38:     target = date(2026, 3, 21)
39:     result = QuantPipeline().run(
40:         {"000001.SZ": _bars("000001.SZ", 0.01)},
41:         target,
42:         MarketContext(target, 0.55),
43:     )[0]
44:     assert set(result.dimensions) == {"market", "sector", "strength", "trend", "volume_price", "position", "risk"}
45:     assert result.market_state == "RANGE"
46:     assert set(result.factor_weights) == {"market", "sector", "strength", "trend", "volume_price", "position", "risk_penalty"}
47: def test_score_formula_uses_risk_as_penalty():
48:     dimensions = {
49:         name: DimensionScore(name, 80.0, True, [])
50:         for name in ("market", "sector", "strength", "trend", "volume_price", "position", "risk")
51:     }
52:     assert CrossSectionScorer.factor_score(dimensions) == 75.0
