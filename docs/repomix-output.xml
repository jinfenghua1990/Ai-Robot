 68: def _serialize_tracker(db, t, include_daily=True, daily_limit=None):
 69:     """序列化一条 StrategyTrack，可选附带 daily 数据"""
 70:     row = {
 71:         "id": t.id,
 72:         "pool_date": _d(t.pool_date),
