368: # ============ 多因子量化选股（基于免费 F10 批量预拉数据）============
369: # 数据来源：stock_universe(名称/行业/板块) + stock_f10(财务/估值/机构) + stock_money_flow_detail(主力净流入)
370: # 因子：PE(TTM) / ROE / 毛利率 / 机构占流通比 / 主力净流入 / 行业 / 板块
371: def _latest_flow_map(db):
372:     """最新交易日的主力净流入 map: ts_code -> main_net(元)"""
373:     latest = db.execute(func.max(StockMoneyFlowDetail.trade_date)).scalar()
374:     if not latest:
375:         return {}
376:     rows = db.execute(
377:         select(StockMoneyFlowDetail.ts_code, StockMoneyFlowDetail.main_net)
378:         .where(StockMoneyFlowDetail.trade_date == latest)
379:     ).all()
380:     return {r[0]: (float(r[1]) if r[1] is not None else None) for r in rows}
381: def _mfactor_score(pe, roe, gm, inst):
382:     """综合质量-估值评分：ROE/PE（盈利收益率倒数）× 质量/筹码加成。None 稳健。"""
383:     try:
384:         pe_v = float(pe) if pe is not None else None
385:         roe_v = float(roe) if roe is not None else 0.0
386:         gm_v = float(gm) if gm is not None else 0.0
387:         inst_v = float(inst) if inst is not None else 0.0
388:         if pe_v is None or pe_v <= 0:
389:             return None
390:         return (roe_v / pe_v) * (1 + gm_v / 100.0) * (1 + inst_v / 100.0)
391:     except Exception:
392:         return None
393: @router.get("/api/screener/filter")
394: def mfactor_filter(
395:     pe_max: float = Query(None, description="PE(TTM) 上限，如 20"),
396:     roe_min: float = Query(None, description="ROE(%) 下限，如 15"),
397:     gm_min: float = Query(None, description="毛利率(%) 下限，如 30"),
398:     inst_min: float = Query(None, description="机构占流通比(%) 下限，如 3"),
399:     net_inflow_min: float = Query(None, description="主力净流入下限(元，来自盘后资金流)"),
400:     sector: str = Query(None, description="行业模糊匹配，如 白酒 / 银行 / 半导体"),
401:     market: str = Query(None, description="板块：主板 / 创业板 / 科创板 / 北交所"),
402:     sort_by: str = Query("score", description="排序字段: score/pe/roe/gross_margin/inst_hold/net_inflow"),
403:     order: str = Query("desc", description="asc / desc"),
404:     limit: int = Query(50, ge=1, le=500),
405: ):
406:     """多因子量化选股：低估值 + 高质量 + 机构持股 + 主力流入。数据来自免费 F10 预拉缓存。"""
407:     with SessionLocal() as db:
408:         uni_map = {r.ts_code: r for r in db.execute(select(StockUniverse)).scalars().all()}
409:         flow_map = _latest_flow_map(db)
410:         f10_rows = db.execute(select(StockF10)).scalars().all()
411:     candidates = []
412:     for r in f10_rows:
413:         uni = uni_map.get(r.ts_code)
414:         if not uni:
415:             continue
416:         fj = json.loads(r.financial_json or "{}")
417:         ij = json.loads(r.institution_json or "{}")
418:         pe = fj.get("pe_ttm")
419:         roe = fj.get("roe")
420:         gm = fj.get("gross_margin")
421:         rev = fj.get("revenue")
422:         ni = fj.get("net_profit")
423:         inst = ij.get("持仓占实际流通A股比例")
424:         inst_cnt = ij.get("机构数量")
425:         flow = flow_map.get(r.ts_code)
426:         # ---- 因子过滤 ----
427:         if pe_max is not None and (pe is None or float(pe) > pe_max):
428:             continue
429:         if roe_min is not None and (roe is None or float(roe) < roe_min):
430:             continue
431:         if gm_min is not None and (gm is None or float(gm) < gm_min):
432:             continue
433:         if inst_min is not None and (inst is None or float(inst) < inst_min):
434:             continue
435:         if net_inflow_min is not None and (flow is None or flow < net_inflow_min):
436:             continue
437:         if sector and sector not in (uni.industry or ""):
438:             continue
439:         if market and uni.market != market:
440:             continue
441:         score = _mfactor_score(pe, roe, gm, inst)
442:         candidates.append({
443:             "ts_code": r.ts_code,
444:             "name": uni.name,
445:             "industry": uni.industry,
446:             "market": uni.market,
447:             "pe_ttm": pe,
448:             "roe": roe,
449:             "gross_margin": gm,
450:             "revenue": rev,
451:             "net_profit": ni,
452:             "inst_hold_ratio": inst,
453:             "inst_count": inst_cnt,
454:             "main_net_inflow": flow,
455:             "score": score,
456:         })
457:     # ---- 排序 ----
458:     def _key(c):
459:         if sort_by == "pe":
460:             v = c["pe_ttm"]
461:             return v if v is not None else (float("inf") if order == "asc" else float("-inf"))
462:         if sort_by == "roe":
463:             return c["roe"] if c["roe"] is not None else 0
464:         if sort_by == "gross_margin":
465:             return c["gross_margin"] if c["gross_margin"] is not None else 0
466:         if sort_by == "inst_hold":
467:             return c["inst_hold_ratio"] if c["inst_hold_ratio"] is not None else 0
468:         if sort_by == "net_inflow":
469:             return c["main_net_inflow"] if c["main_net_inflow"] is not None else 0
470:         return c["score"] if c["score"] is not None else (float("inf") if order == "asc" else float("-inf"))
471:     reverse = (order == "desc")
472:     candidates.sort(key=_key, reverse=reverse)
473:     return {"count": len(candidates), "results": candidates[:limit]}
