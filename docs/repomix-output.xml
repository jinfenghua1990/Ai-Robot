 25:   { color: '#16a34a', label: '▼大幅降温' },
 26: ];
 27: /**
 28:  * 板块热度/变化趋势横向柱状图
 29:  * - viewMode='heat': 按热度降序的横向柱状图，柱长=热度(0-100)，颜色=热度等级
 30:  * - viewMode='change': 发散型横向柱状图，零轴居中，升温红柱向右，降温绿柱向左
 31:  * 接受 selectedSector/onSectorClick 实现左右联动高亮
 32:  */
 33: export default function BarHeatChart({ data, selectedDate, viewMode = 'heat', selectedSector, onSectorClick }) {
 34:   // 提取当日 + 前一日板块热度，用 Map 一次遍历
 35:   const { sorted, currentDate, prevDate } = useMemo(() => {
 36:     if (!data || !data.values || data.values.length === 0) {
 37:       return { sorted: [], currentDate: null, prevDate: null };
 38:     }
 39:     const dateIdx = data.dates.indexOf(selectedDate);
 40:     const effectiveDateIdx = dateIdx >= 0 ? dateIdx : data.dates.length - 1;
 41:     const curDate = data.dates[effectiveDateIdx];
 42:     const prevDt = effectiveDateIdx > 0 ? data.dates[effectiveDateIdx - 1] : null;
 43:     const curHeat = new Map();
 44:     const prevHeat = new Map();
 45:     for (const v of data.values) {
 46:       if (v[0] === effectiveDateIdx) curHeat.set(data.sectors[v[1]], v[2]);
 47:       else if (v[0] === effectiveDateIdx - 1) prevHeat.set(data.sectors[v[1]], v[2]);
 48:     }
 49:     const all = [...curHeat.entries()].map(([name, heat]) => {
 50:       const prev = prevHeat.get(name) ?? null;
 51:       return { name, heat, prev, trend: prev != null ? heat - prev : 0 };
 52:     });
 53:     const s = (viewMode === 'heat'
 54:       ? all.sort((a, b) => b.heat - a.heat)
 55:       : all.sort((a, b) => Math.abs(b.trend) - Math.abs(a.trend))
 56:     ).slice(0, 20);
 57:     return { sorted: s, currentDate: curDate, prevDate: prevDt };
 58:   }, [data, selectedDate, viewMode]);
 59:   const option = useMemo(() => {
 60:     if (sorted.length === 0) return null;
 61:     const isHeat = viewMode === 'heat';
 62:     const sectorNames = sorted.map(s => s.name);
 63:     const values = isHeat
 64:       ? sorted.map(s => Math.max(s.heat, 0.5))
 65:       : sorted.map(s => s.trend);
 66:     // 选中态：匹配项全亮+边框，其余降透明度；无选择时全亮
 67:     const dimmed = (name) => selectedSector && selectedSector !== name;
 68:     const formatter = isHeat
 69:       ? (params) => {
 70:           const d = sorted[params.dataIndex];
 71:           const trendText = d.trend > 1
 72:             ? `<span style="color:#ef4444">▲ +${d.trend.toFixed(1)}</span>`
 73:             : d.trend < -1
 74:             ? `<span style="color:#22c55e">▼ ${d.trend.toFixed(1)}</span>`
 75:             : '<span style="color:#999">● 持平</span>';
 76:           return `<div style="font-weight:700;font-size:14px;margin-bottom:4px">${d.name}</div>` +
 77:                  `<div style="font-size:12px;color:#ccc">热度：<span style="font-weight:600;color:${getHeatColor(d.heat)}">${d.heat.toFixed(1)}</span></div>` +
 78:                  `<div style="font-size:12px;color:#ccc">前一天：${d.prev != null ? d.prev.toFixed(1) : '—'}</div>` +
 79:                  `<div style="font-size:12px;color:#ccc">变化：${trendText}</div>`;
 80:         }
 81:       : (params) => {
 82:           const d = sorted[params.dataIndex];
 83:           const trendColor = d.trend > 0 ? '#ef4444' : d.trend < 0 ? '#22c55e' : '#999';
 84:           const trendIcon = d.trend > 0 ? '▲' : d.trend < 0 ? '▼' : '●';
 85:           return `<div style="font-weight:700;font-size:14px;margin-bottom:4px">${d.name}</div>` +
 86:                  `<div style="font-size:12px;color:#ccc">变化：<span style="font-weight:600;color:${trendColor}">${trendIcon} ${d.trend > 0 ? '+' : ''}${d.trend.toFixed(1)}</span></div>` +
 87:                  `<div style="font-size:12px;color:#ccc">当日热度：${d.heat.toFixed(1)}</div>` +
 88:                  `<div style="font-size:12px;color:#ccc">前一天热度：${d.prev != null ? d.prev.toFixed(1) : '—'}</div>`;
 89:         };
 90:     if (isHeat) {
 91:       // 热度值：横向柱状图，按热度降序
 92:       return {
 93:         tooltip: { ...tooltipStyle, formatter },
