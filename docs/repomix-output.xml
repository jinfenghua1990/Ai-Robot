<file path="frontend/src/context/TradingContext.jsx">
  1: import { createContext, useContext, useState, useCallback, useRef, useEffect, useMemo } from 'react';
  2: import { apiFetch } from '../utils/request';
  3: import { SLOW_POLL_INTERVAL } from '../utils/constants';
  4: const TradingContext = createContext(null);
  5: /**
  6:  * 判断是否在 A 股交易时间（9:30-11:30, 13:00-15:00）
  7:  * 纯函数，提到组件外避免每次 render 重建闭包
  8:  */
  9: function isTradingHours() {
 10:   const now = new Date();
 11:   const h = now.getHours();
 12:   const m = now.getMinutes();
 13:   const t = h * 60 + m;
 14:   const day = now.getDay();
 15:   // 周末不刷新
 16:   if (day === 0 || day === 6) return false;
 17:   // 9:30-11:30 或 13:00-15:00
 18:   return (t >= 570 && t <= 690) || (t >= 780 && t <= 900);
 19: }
 20: export function TradingProvider({ children }) {
 21:   const [balance, setBalance] = useState(null);
 22:   const [positions, setPositions] = useState(null);
 23:   const [loading, setLoading] = useState(false);
 24:   const [tradeResult, setTradeResult] = useState(null); // { success, message, orderId }
 25:   // 并发刷新 nonce：仅最新的 refreshAll 调用有权清 loading
 26:   const refreshNonceRef = useRef(0);
 27:   // 交易/撤单后 500ms 防抖刷新的 timer，卸载时清理
 28:   const refreshDebounceRef = useRef(null);
 29:   const refreshBalance = useCallback(async (force = false) => {
 30:     try {
 31:       const { ok, data } = await apiFetch(`/api/trading/balance${force ? '?force=1' : ''}`);
 32:       if (!ok) return;
 33:       setBalance(data);
 34:     } catch (e) { /* silent */ }
 35:   }, []);
 36:   const refreshPositions = useCallback(async (force = false) => {
 37:     try {
 38:       const { ok, data } = await apiFetch(`/api/trading/positions${force ? '?force=1' : ''}`);
 39:       if (!ok) return;
 40:       setPositions(data);
 41:     } catch (e) { /* silent */ }
 42:   }, []);
 43:   const refreshAll = useCallback(async (force = false) => {
 44:     // 用递增 nonce 区分并发调用：仅最后一次完成时才把 loading 置 false
 45:     const myNonce = ++refreshNonceRef.current;
 46:     setLoading(true);
 47:     try {
 48:       await Promise.all([refreshBalance(force), refreshPositions(force)]);
 49:     } finally {
 50:       if (myNonce === refreshNonceRef.current) setLoading(false);
 51:     }
 52:   }, [refreshBalance, refreshPositions]);
 53:   // 交易/撤单后防抖刷新：500ms 内多次触发只执行一次，避免请求叠加
 54:   const scheduleRefresh = useCallback(() => {
 55:     if (refreshDebounceRef.current) clearTimeout(refreshDebounceRef.current);
 56:     refreshDebounceRef.current = setTimeout(() => {
 57:       refreshDebounceRef.current = null;
 58:       refreshAll();
 59:     }, 500);
 60:   }, [refreshAll]);
 61:   const executeTrade = useCallback(async (params) => {
 62:     try {
 63:       const { ok, data, error } = await apiFetch('/api/trading/trade', {
 64:         method: 'POST',
 65:         headers: { 'Content-Type': 'application/json' },
 66:         body: JSON.stringify(params),
 67:       });
 68:       if (ok) {
 69:         setTradeResult({ success: true, message: '委托成功', data });
 70:         // 交易后防抖刷新数据
 71:         scheduleRefresh();
 72:       } else {
 73:         setTradeResult({ success: false, message: error || '委托失败' });
 74:       }
 75:       return data;
 76:     } catch (e) {
 77:       setTradeResult({ success: false, message: '网络错误' });
 78:       return null;
 79:     }
 80:   }, [scheduleRefresh]);
 81:   const cancelOrder = useCallback(async (params) => {
 82:     try {
 83:       const { ok, data } = await apiFetch('/api/trading/cancel', {
 84:         method: 'POST',
 85:         headers: { 'Content-Type': 'application/json' },
 86:         body: JSON.stringify(params),
 87:       });
 88:       if (ok) {
 89:         // 撤单后防抖刷新数据
 90:         scheduleRefresh();
 91:       }
 92:       return data;
 93:     } catch (e) {
 94:       return null;
 95:     }
 96:   }, [scheduleRefresh]);
 97:   const clearTradeResult = useCallback(() => setTradeResult(null), []);
 98:   // 初始加载一次 + 盘中5分钟自动刷新（非交易时间不调用，节省妙想API配额）
 99:   useEffect(() => {
100:     refreshAll();
101:     const timer = setInterval(() => {
102:       if (isTradingHours()) {
103:         refreshAll();
104:       }
105:     }, SLOW_POLL_INTERVAL); // 5分钟
106:     return () => {
107:       clearInterval(timer);
108:       // 清理交易/撤单防抖 timer，避免卸载后 setState
109:       if (refreshDebounceRef.current) clearTimeout(refreshDebounceRef.current);
110:     };
111:   }, [refreshAll]);
112:   // Context value 必须 useMemo：否则每次 Provider 重渲染（balance/positions 变化）都会新建对象引用，
113:   // 导致所有 useTrading() consumer 全量重渲染，即使它们只读 actions 不读 state
114:   const value = useMemo(() => ({
115:     balance, positions, loading, tradeResult,
116:     refreshAll, refreshBalance, refreshPositions,
117:     executeTrade, cancelOrder, clearTradeResult,
118:   }), [balance, positions, loading, tradeResult,
119:        refreshAll, refreshBalance, refreshPositions,
120:        executeTrade, cancelOrder, clearTradeResult]);
121:   return (
122:     <TradingContext.Provider value={value}>
123:       {children}
124:     </TradingContext.Provider>
125:   );
126: }
127: export function useTrading() {
128:   const ctx = useContext(TradingContext);
129:   if (!ctx) throw new Error('useTrading must be used within TradingProvider');
130:   return ctx;
131: }
</file>

<file path="frontend/src/hooks/useDatePicker.js">
 1: import { useState, useEffect } from 'react';
 2: import { apiFetch } from '../utils/request';
 3: const fmtDate = (n) => {
 4:   return `${n.getFullYear()}-${String(n.getMonth()+1).padStart(2,'0')}-${String(n.getDate()).padStart(2,'0')}`;
 5: };
 6: // 默认“盘后数据”= 前一个交易日：今天-1，跳过周末（周六→周五，周日→周五）
 7: const prevTradingDay = () => {
 8:   const n = new Date();
 9:   n.setDate(n.getDate() - 1);
10:   const dow = n.getDay();
11:   if (dow === 0) n.setDate(n.getDate() - 2);      // 周日 -> 上周五
12:   else if (dow === 6) n.setDate(n.getDate() - 1); // 周六 -> 周五
13:   return fmtDate(n);
14: };
15: export function useDatePicker() {
16:   // 默认“盘后”= 前一个交易日（昨天/跳过周末），打开即有盘后数据、无需手动选。
17:   // 异步拉 /api/latest-date 做校正：若最新盘后日已是今天（收盘后已生成），仍回退到前一个交易日；
18:   // 若今天尚无盘后数据（latest-date 落在更早日期），则采用该有数据的日期。
19:   const [selectedDate, setSelectedDate] = useState(prevTradingDay());
20:   const [loadingDate, setLoadingDate] = useState(true);
21:   useEffect(() => {
22:     let cancelled = false;
23:     (async () => {
24:       try {
25:         const { ok, data } = await apiFetch('/api/latest-date');
26:         if (!cancelled && ok && data && data.date) {
27:           const latest = data.date;   // YYYY-MM-DD（ISO，可直接字典序比较）
28:           const prev = prevTradingDay();
29:           // 不晚于“前一天”：latest 比前一天更晚（即今天）时用前一天，否则用 latest
30:           setSelectedDate(latest > prev ? prev : latest);
31:         }
32:       } catch {
33:         // 保留 prevTradingDay 的回退值
34:       } finally {
35:         if (!cancelled) setLoadingDate(false);
36:       }
37:     })();
38:     return () => { cancelled = true; };
39:   }, []);
40:   const changeDate = (offset) => {
41:     if (!selectedDate) return;
42:     const [y, m, d] = selectedDate.split('-').map(Number);
43:     const dt = new Date(y, m - 1, d);
44:     dt.setDate(dt.getDate() + offset);
45:     setSelectedDate(fmtDate(dt));
46:   };
47:   return { selectedDate, setSelectedDate, changeDate, loadingDate };
48: }
</file>

<file path="frontend/src/hooks/useLifecycleData.js">
  1: import { useState, useEffect, useMemo, useCallback } from 'react';
  2: import { useDatePicker } from './useDatePicker';
  3: import { STAGES, STAGE_COLORS } from '../constants/stages';
  4: import { apiFetch } from '../utils/request';
  5: const PAGE_SIZE = 20;
  6: /**
  7:  * Lifecycle 系列 Page 共享的数据获取+过滤+分页逻辑
  8:  * @param {string} apiEndpoint - 如 '/api/lifecycle', '/api/lifecycle-v2', '/api/lifecycle-v3'
  9:  * @param {object} [options] - { sortByDefault: 'strength' }
 10:  */
 11: export function useLifecycleData(apiEndpoint, options = {}) {
 12:   const { selectedDate, setSelectedDate, changeDate } = useDatePicker();
 13:   const [data, setData] = useState(null);
 14:   const [loading, setLoading] = useState(true);
 15:   const [error, setError] = useState(null);
 16:   const [stageFilter, setStageFilter] = useState('全部');
 17:   const [sectorFilter, setSectorFilter] = useState('全部');
 18:   const [searchText, setSearchText] = useState('');
 19:   const [sortBy, setSortBy] = useState(options.sortByDefault || 'strength');
 20:   const [currentPage, setCurrentPage] = useState(0);
 21:   // retryNonce：递增触发 useEffect 重发请求（setSelectedDate 相同值会被 React bail-out 忽略）
 22:   const [retryNonce, setRetryNonce] = useState(0);
 23:   // 数据加载
 24:   useEffect(() => {
 25:     if (!selectedDate) return;
 26:     setLoading(true);
 27:     setError(null);
 28:     const controller = new AbortController();
 29:     (async () => {
 30:       const { ok, data: d } = await apiFetch(
 31:         `${apiEndpoint}?date=${selectedDate}`,
 32:         { signal: controller.signal }
 33:       );
 34:       // 组件卸载 / 依赖变更：直接返回，不 setState
 35:       if (controller.signal.aborted) return;
 36:       if (!ok) {
 37:         setError('数据加载失败');
 38:         setLoading(false);
 39:         return;
 40:       }
 41:       setData(d);
 42:       setLoading(false);
 43:     })();
 44:     return () => controller.abort();
 45:   }, [selectedDate, apiEndpoint, retryNonce]);
 46:   // 筛选变化重置页码
 47:   useEffect(() => { setCurrentPage(0); }, [stageFilter, sectorFilter, searchText, sortBy]);
 48:   // 各阶段数量统计
 49:   const stageCounts = useMemo(() => {
 50:     if (!data?.leaders) return [];
 51:     return STAGES.map(s => ({
 52:       stage: s,
 53:       count: data.leaders.filter(l => l.stage === s).length,
 54:       color: STAGE_COLORS[s],
 55:     }));
 56:   }, [data]);
 57:   // 板块列表（用于筛选下拉）
 58:   const sectorList = useMemo(() => {
 59:     if (!data?.leaders) return [];
 60:     const counts = {};
 61:     data.leaders.forEach(l => { counts[l.sector] = (counts[l.sector] || 0) + 1; });
 62:     return Object.entries(counts).sort((a, b) => b[1] - a[1]);
 63:   }, [data]);
 64:   // 过滤 + 排序
 65:   const filteredLeaders = useMemo(() => {
 66:     if (!data?.leaders) return [];
 67:     let result = data.leaders;
 68:     if (stageFilter !== '全部') result = result.filter(l => l.stage === stageFilter);
 69:     if (sectorFilter !== '全部') result = result.filter(l => l.sector === sectorFilter);
 70:     if (searchText.trim()) {
 71:       const q = searchText.trim().toLowerCase();
 72:       result = result.filter(l =>
 73:         l.ts_code?.toLowerCase().includes(q) ||
 74:         l.name?.toLowerCase().includes(q) ||
 75:         l.sector?.toLowerCase().includes(q)
 76:       );
 77:     }
 78:     const sorted = [...result];
 79:     if (sortBy === 'strength') sorted.sort((a, b) => (b.strength || 0) - (a.strength || 0));
 80:     else if (sortBy === 'days') sorted.sort((a, b) => (b.consecutive_days || 0) - (a.consecutive_days || 0));
 81:     else if (sortBy === 'change') sorted.sort((a, b) => Math.abs(b.change_rate || 0) - Math.abs(a.change_rate || 0));
 82:     return sorted;
 83:   }, [data, stageFilter, sectorFilter, searchText, sortBy]);
 84:   const totalPages = Math.ceil(filteredLeaders.length / PAGE_SIZE);
 85:   // pagedLeaders 用 useMemo 缓存，避免每次 render 新建数组引用击穿 SignalCard memo
 86:   const pagedLeaders = useMemo(
 87:     () => filteredLeaders.slice(currentPage * PAGE_SIZE, (currentPage + 1) * PAGE_SIZE),
 88:     [filteredLeaders, currentPage]
 89:   );
 90:   // retry 用递增 nonce 触发 useEffect 重发请求
 91:   const retry = useCallback(() => {
 92:     setError(null);
 93:     setRetryNonce(n => n + 1);
 94:   }, []);
 95:   return {
 96:     data, loading, error, retry,
 97:     selectedDate, setSelectedDate, changeDate,
 98:     stageFilter, setStageFilter,
 99:     sectorFilter, setSectorFilter,
100:     sectorList,
