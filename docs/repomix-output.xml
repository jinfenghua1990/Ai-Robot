 406: def _batch_hit_tags(db, stock_codes: list, sectors_map: dict) -> dict:
 407:     """批量计算 7 大命中标签，返回 {ts_code: {hit_tags: [], action_hint: ''}}
 408:     7 个批量查询相互独立，并行执行（ThreadPoolExecutor）将首次耗时 6-9s 降到 1-2s。
 409:     每个线程使用独立 Session（SQLAlchemy Session 非线程安全）。
 410:     """
 411:     if not stock_codes:
 412:         return {}
 413:     valid_codes = [c for c in stock_codes if c and len(c) == 6]
 414:     ts_codes = [f"{c}.SH" if c[0] in ('6', '9') else f"{c}.SZ" for c in valid_codes]
 415:     code_to_ts = {c: (f"{c}.SH" if c[0] in ('6', '9') else f"{c}.SZ") for c in valid_codes}
 416:     from db.connection import SessionLocal
 417:     from concurrent.futures import ThreadPoolExecutor, as_completed
 418:     hit_tasks = [
 419:         ('yuzi',         _hit_yuzi,         (ts_codes,)),
 420:         ('strategy',     _hit_strategy,     (valid_codes,)),
 421:         ('trend',        _hit_trend,        (valid_codes,)),
 422:         ('capital',      _hit_capital,      (ts_codes,)),
 423:         ('popularity',   _hit_popularity,   (sectors_map,)),
 424:         ('support',      _hit_support,      (ts_codes,)),
 425:         ('accumulation', _hit_accumulation, (ts_codes,)),
 426:     ]
 427:     sets = {name: set() for name, _, _ in hit_tasks}
 428:     def _run_in_thread(name, fn, args):
 429:         # 每个线程独占一个 Session，避免 SQLAlchemy 状态污染
 430:         thread_db = SessionLocal()
 431:         try:
 432:             return name, fn(thread_db, *args)
 433:         except Exception as e:
 434:             logger.warning(f'_hit_{name} failed: {e}')
 435:             try:
 436:                 thread_db.rollback()
 437:             except Exception:
 438:                 logger.debug(f'_hit_{name} rollback failed', exc_info=True)
 439:             return name, set()
 440:         finally:
 441:             thread_db.close()
 442:     with ThreadPoolExecutor(max_workers=7) as executor:
 443:         future_to_name = {executor.submit(_run_in_thread, name, fn, args): name
 444:                           for name, fn, args in hit_tasks}
 445:         for future in as_completed(future_to_name):
 446:             try:
 447:                 name, result = future.result()
 448:                 sets[name] = result or set()
 449:             except Exception as e:
 450:                 logger.warning(f'_hit task future failed: {e}')
 451:     out = {}
 452:     # _hit_strategy 返回 dict（{code: strategy_name}），其他返回 set
 453:     strategy_map = sets.get('strategy') or {}
 454:     # strategy 命中时不加 'strategy' 通用标签（与顶部 strategyTags 重复），
 455:     # 改为加 'strategy:BS-全市场' 形式，让前端直接显示具体策略名
 456:     # _gen_action_hint 只看基础 6 个标签，不受影响
 457:     for code in valid_codes:
 458:         ts = code_to_ts[code]
 459:         tags = []
 460:         if ts in sets.get('yuzi', set()):
 461:             tags.append('yuzi')
 462:         # strategy 标签合并：跳过通用 'strategy' 标签，由 strategyTags 顶部标签承担显示
 463:         # 如需保留命中信息可加：if code in strategy_map: tags.append(f'strategy:{strategy_map[code]}')
 464:         if code in sets.get('trend', set()):
 465:             tags.append('trend')
 466:         if ts in sets.get('capital', set()):
 467:             tags.append('capital')
 468:         if code in sets.get('popularity', set()):
 469:             tags.append('popularity')
 470:         if ts in sets.get('support', set()):
 471:             tags.append('support')
 472:         if ts in sets.get('accumulation', set()):
 473:             tags.append('accumulation')
 474:         out[ts] = {
 475:             'hit_tags': tags,
 476:             'action_hint': _gen_action_hint(tags),
 477:             'strategy_name': strategy_map.get(code),  # 附加策略名，供前端选用
 478:         }
 479:     return out
