145:   const { order, colors, legacyMap, defaultStage } = config;
146:   // 兼容旧名称
147:   let mappedStage = stage ? (legacyMap[stage] || stage) : null;
148:   const finalStage = mappedStage || (variant === 'lifecycle' ? inferStage(value || 0) : defaultStage);
149:   const currentIdx = order.indexOf(finalStage);
150:   const isUnknown = currentIdx === -1;
151:   return (
152:     <div className="flex-1 flex flex-col gap-0.5 min-w-0 w-full">
153:       <div className="flex-1 flex items-center gap-1 min-w-0">
154:         <div className="flex-1 flex h-2 rounded-full overflow-hidden gap-px" style={{ background: 'var(--bg-hover)' }}>
155:           {order.map((s, i) => (
156:             <div key={s} className="flex-1 transition-all" style={{
157:               background: !isUnknown && i <= currentIdx ? colors[s] : 'transparent',
158:               opacity: !isUnknown && i === currentIdx ? 1 : !isUnknown && i < currentIdx ? 0.5 : 1,
159:             }} title={s} />
160:           ))}
161:         </div>
162:         <span
163:           className={`flex-shrink-0 text-right font-bold whitespace-nowrap ${compact ? 'text-[10px] w-7' : 'text-xs w-9'}`}
164:           style={{ color: isUnknown ? '#9CA3AF' : (colors[finalStage] || '#9CA3AF') }}
165:         >
166:           {finalStage}
167:         </span>
168:       </div>
169:       {showLabels && (
170:         <div className="flex gap-px">
171:           {order.map((s, i) => (
172:             <div key={s} className="flex-1 text-center text-[10px] leading-tight" style={{
173:               color: i === currentIdx ? colors[s] : 'var(--text-muted)',
174:               fontWeight: i === currentIdx ? 700 : 400,
175:             }}>
176:               {s}
177:             </div>
178:           ))}
179:         </div>
180:       )}
181:     </div>
182:   );
183: }
