<file path="backend/analyzers/heat_score.py">
 1: """
 2: 热度评分计算器
 3: heat_score = net_flow_normalized * 0.4 + limit_up_count_normalized * 0.3 + rise_ratio_normalized * 0.3
 4: """
 5: import sys, os
 6: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 7: import logging
 8: import numpy as np
 9: from db.session import get_db_session
10: from db.models import SectorFlow
11: logger = logging.getLogger(__name__)
12: def calculate_heat_scores(trade_date):
13:     """计算指定日期所有板块的热度评分"""
14:     try:
15:         with get_db_session() as db:
16:             sectors = db.query(SectorFlow).filter_by(trade_date=trade_date).all()
17:             if not sectors:
18:                 print(f'[heat] No sector data for {trade_date}')
19:                 return
20:             net_flows = np.array([float(s.net_flow or 0) for s in sectors])
21:             limit_ups = np.array([float(s.limit_up_count or 0) for s in sectors])
22:             rises = np.array([float(s.rise_ratio or 0) for s in sectors])
23:             def normalize(arr):
24:                 if len(arr) == 0:
25:                     return arr
26:                 if arr.max() == arr.min():
27:                     return np.ones_like(arr) * 0.5
28:                 return (arr - arr.min()) / (arr.max() - arr.min())
29:             nf_norm = normalize(net_flows)
30:             lu_norm = normalize(limit_ups)
31:             rr_norm = normalize(rises)
32:             for i, sector in enumerate(sectors):
33:                 score = nf_norm[i] * 0.4 + lu_norm[i] * 0.3 + rr_norm[i] * 0.3
34:                 sector.heat_score = round(float(score * 100), 2)  # 0-100分
35:             db.commit()
36:             print(f'[heat] Calculated heat scores for {len(sectors)} sectors')
37:     except Exception as e:
38:         pass  # with context auto-rollbacks
39:         logger.exception(f'[heat] Error')
40:         return {'error': str(e)}
41: if __name__ == '__main__':
42:     from datetime import datetime
43:     today = datetime.now().strftime('%Y-%m-%d')
44:     calculate_heat_scores(today)
