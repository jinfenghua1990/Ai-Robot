<file path="frontend/src/components/charts/SectorRealtimeTrendChart.jsx">
  1: import { useState, useEffect, useMemo, useRef } from 'react';
  2: import ReactECharts from 'echarts-for-react/lib/core';
  3: import echarts from '../../lib/echarts';
  4: import { tooltipStyle } from '../../utils/chartConfig';
  5: import { apiFetch } from '../../utils/request';
  6: import { fmtFlow } from '../../utils/format';
  7: import { getSectorColorHex } from '../../utils/sectorColors';
  8: import CategoryLineChart from './CategoryLineChart';
  9: /**
 10:  * Top 10 板块实时资金流向分钟走势图
 11:  * X 轴：交易时间；Y 轴：净流入（万元）；每条线代表一个板块。
 12:  */
 13: export default function SectorRealtimeTrendChart({
 14:   sectors, rtSectors, selectedSector, onSectorClick, height = '260px',
 15:   trendApiPath = '/api/realtime/sector-trend',
 16: }) {
 17:   const [trends, setTrends] = useState([]);
 18:   const [loading, setLoading] = useState(false);
 19:   const cacheRef = useRef(new Map());
 20:   const tradeDate = rtSectors?.trade_date;
 21:   useEffect(() => {
 22:     if (!tradeDate || !sectors?.length) {
 23:       setTrends([]);
 24:       return;
 25:     }
 26:     const controller = new AbortController();
 27:     setLoading(true);
 28:     (async () => {
 29:       const results = await Promise.all(
 30:         sectors.map(async (name) => {
 31:           const cacheKey = `${tradeDate}_${name}`;
 32:           if (cacheRef.current.has(cacheKey)) {
 33:             return cacheRef.current.get(cacheKey);
 34:           }
 35:           const { ok, data } = await apiFetch(
 36:             `${trendApiPath}?sector=${encodeURIComponent(name)}`,
 37:             { signal: controller.signal }
 38:           );
 39:           if (!ok || !data?.points) return null;
 40:           const item = { sector: name, points: data.points };
 41:           cacheRef.current.set(cacheKey, item);
 42:           return item;
 43:         })
 44:       );
 45:       if (!controller.signal.aborted) {
 46:         setTrends(results.filter(Boolean));
 47:         setLoading(false);
 48:       }
 49:     })();
 50:     return () => controller.abort();
 51:   }, [tradeDate, sectors, trendApiPath]);
 52:   const option = useMemo(() => {
 53:     if (trends.length === 0) return null;
 54:     const timesSet = new Set();
 55:     trends.forEach(t => t.points.forEach(p => timesSet.add(p.time)));
 56:     const times = [...timesSet].sort();
 57:     const series = trends.map((t) => {
 58:       const isSelected = selectedSector && selectedSector === t.sector;
 59:       const dimmed = selectedSector && !isSelected;
 60:       const color = getSectorColorHex(t.sector);
 61:       const pointMap = new Map(t.points.map(p => [p.time, p.net_flow]));
 62:       return {
 63:         name: t.sector,
 64:         type: 'line',
 65:         smooth: true,
 66:         symbol: 'circle',
 67:         symbolSize: isSelected ? 10 : 4,
 68:         connectNulls: true,
 69:         lineStyle: { width: isSelected ? 4 : 2.5, color, opacity: dimmed ? 0.25 : 1 },
 70:         itemStyle: { color, opacity: dimmed ? 0.25 : 1 },
 71:         data: times.map(time => pointMap.get(time) ?? null),
 72:         emphasis: { focus: 'series', lineStyle: { width: 4 }, symbolSize: 10 },
 73:       };
 74:     });
 75:     return {
 76:       tooltip: {
 77:         ...tooltipStyle,
 78:         trigger: 'axis',
 79:         formatter: (params) => {
 80:           let html = `<div style="font-weight:700;margin-bottom:6px">${params[0].axisValue}</div>`;
 81:           const sorted = [...params].filter(p => p.value != null).sort((a, b) => b.value - a.value);
 82:           sorted.forEach(p => {
 83:             const color = p.value > 0 ? '#ef4444' : p.value < 0 ? '#22c55e' : '#6b7280';
 84:             html += `<div style="display:flex;align-items:center;gap:6px;margin:2px 0;font-size:12px">`;
 85:             html += `<span style="display:inline-block;width:8px;height:8px;border-radius:50%;background:${p.color}"></span>`;
 86:             html += `<span style="flex:1">${p.seriesName}</span>`;
 87:             html += `<span style="font-weight:600;color:${color}">${p.value > 0 ? '+' : ''}${fmtFlow(p.value)}</span>`;
 88:             html += `</div>`;
 89:           });
 90:           return html;
 91:         },
 92:       },
 93:       legend: {
 94:         type: 'scroll',
 95:         top: 0,
 96:         textStyle: { color: 'var(--text-secondary)', fontSize: 11 },
 97:         pageTextStyle: { color: 'var(--text-muted)' },
 98:         pageItemSize: 12,
 99:       },
100:       grid: { top: 40, left: 55, right: 30, bottom: 30 },
101:       xAxis: {
102:         type: 'category',
103:         data: times,
104:         boundaryGap: false,
105:         axisLabel: { color: 'var(--text-secondary)', fontSize: 11 },
106:         axisLine: { lineStyle: { color: 'var(--border-color)' } },
107:         axisTick: { show: false },
108:       },
109:       yAxis: {
110:         type: 'value',
111:         name: '净流入（万元）',
112:         nameTextStyle: { color: 'var(--text-muted)', fontSize: 10 },
113:         axisLabel: {
114:           color: 'var(--text-secondary)',
115:           fontSize: 11,
116:           formatter: (v) => Math.abs(v) >= 10000 ? `${(v / 10000).toFixed(0)}亿` : `${(v / 1000).toFixed(0)}k`,
117:         },
118:         splitLine: { lineStyle: { color: 'var(--border-color)', type: 'dashed', opacity: 0.5 } },
119:         axisLine: { show: false },
120:         axisTick: { show: false },
121:       },
122:       series,
123:     };
124:   }, [trends, selectedSector]);
125:   const onEvents = useMemo(() => onSectorClick ? {
126:     click: (params) => {
127:       if (params.componentType === 'series') onSectorClick(params.seriesName);
128:     },
129:   } : undefined, [onSectorClick]);
130:   if (loading) {
131:     return <div className="h-64 rounded-xl animate-pulse" style={{ background: 'var(--bg-hover)' }} />;
132:   }
133:   if (!tradeDate) {
134:     return (
135:       <div className="flex items-center justify-center h-64 text-sm" style={{ color: 'var(--text-muted)' }}>
136:         暂无实时快照
137:       </div>
138:     );
139:   }
140:   if (!option) {
141:     // 非盘中时无分钟数据， fallback 用快照中的净流入展示 Top10 板块资金流向
142:     const snapshot = rtSectors?.sectors || [];
143:     const fallback = sectors
144:       .map(name => snapshot.find(s => s.sector === name))
145:       .filter(Boolean)
146:       .sort((a, b) => b.net_flow - a.net_flow);
147:     if (fallback.length === 0) {
148:       return (
149:         <div className="flex items-center justify-center h-64 text-sm" style={{ color: 'var(--text-muted)' }}>
150:           暂无资金流向数据
151:         </div>
152:       );
153:     }
154:     return (
155:       <CategoryLineChart
156:         categories={fallback.map(s => s.sector)}
157:         values={fallback.map(s => s.net_flow)}
158:         selectedItem={selectedSector}
159:         onItemClick={onSectorClick}
160:         color="#6366f1"
161:         valueFormatter={(v) => Math.abs(v) >= 10000 ? `${(v / 10000).toFixed(0)}亿` : `${v.toFixed(0)}万`}
162:         height={height}
163:       />
164:     );
165:   }
166:   const chartHeight = typeof height === 'number' ? `${height}px` : height;
167:   return (
168:     <div className="h-full">
169:       <ReactECharts
170:         echarts={echarts}
171:         option={option}
172:         notMerge={true}
173:         style={{ height: chartHeight, width: '100%' }}
174:         opts={{ renderer: 'canvas' }}
175:         onEvents={onEvents}
176:       />
177:     </div>
178:   );
179: }
</file>

