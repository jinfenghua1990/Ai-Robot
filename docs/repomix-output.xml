<file path="backend/api/proxy.py">
 1: """反向代理：将子系统 API 统一收敛到 AIROBOT 端口 9000。
 2: Hermes 子系统已并入本进程（见 backend/main.py 中 hermes_backend 路由并入），
 3: 不再经此代理转发到 8788。此处仅保留仍独立运行的 DSA 子系统：
 4: - /api/v1/*          -> DSA   localhost:8000
 5: """
 6: import logging
 7: from typing import Optional
 8: from fastapi import APIRouter, Request
 9: from fastapi.responses import Response
10: logger = logging.getLogger("airobot.proxy")
11: router = APIRouter()
12: # 子系统代理目标（内部端口）
13: _DSA_BASE = "http://127.0.0.1:8000"
14: _HOP_BY_HOP_HEADERS = {
15:     "connection",
16:     "keep-alive",
17:     "proxy-authenticate",
18:     "proxy-authorization",
19:     "te",
20:     "trailers",
21:     "transfer-encoding",
22:     "upgrade",
23:     "content-encoding",
24: }
25: def _error_response(status_code: int, service: str, detail: str, hint: str) -> Response:
26:     import json
27:     return Response(
28:         content=json.dumps({"error": f"{service} unavailable", "detail": detail, "hint": hint},
29:                            ensure_ascii=False).encode(),
30:         status_code=status_code,
31:         media_type="application/json",
32:     )
33: async def _proxy_request(
34:     request: Request,
35:     target_base: str,
36:     path: str,
37:     *,
38:     strip_prefix: Optional[str] = None,
39:     timeout: float = 30.0,
40: ) -> Response:
41:     """将请求转发到目标子系统后端。
42:     :param strip_prefix: 若提供，从请求路径中去掉此前缀后再转发。
43:                          例如 `/api/v1/` -> 转发到目标根路径。
44:     """
45:     client = request.app.state.http_client
46:     original_path = request.url.path
47:     if strip_prefix and original_path.startswith(strip_prefix):
48:         target_path = original_path[len(strip_prefix):]
49:     else:
50:         target_path = original_path
51:     # 保证根路径至少留一个 /
52:     target_url = f"{target_base}/{target_path.lstrip('/')}"
53:     if request.url.query:
54:         target_url = f"{target_url}?{request.url.query}"
55:     # 转发 headers，去掉 hop-by-hop 和 host
56:     headers = {
57:         k: v
58:         for k, v in request.headers.items()
59:         if k.lower() not in _HOP_BY_HOP_HEADERS and k.lower() != "host"
60:     }
61:     try:
62:         body = await request.body()
63:         resp = await client.request(
64:             method=request.method,
65:             url=target_url,
66:             headers=headers,
67:             content=body or None,
68:             timeout=timeout,
69:             follow_redirects=False,
70:         )
71:     except Exception as e:
72:         logger.warning("Proxy error %s -> %s: %s", request.url.path, target_url, e)
73:         return _error_response(
74:             503,
75:             "Upstream",
76:             str(e),
77:             "目标子系统未启动或不可达",
78:         )
79:     # 过滤响应头中的 hop-by-hop 字段
80:     response_headers = {
81:         k: v
82:         for k, v in resp.headers.items()
83:         if k.lower() not in _HOP_BY_HOP_HEADERS
84:     }
85:     return Response(
86:         content=resp.content,
87:         status_code=resp.status_code,
88:         headers=response_headers,
89:     )
90: # ---------------------------------------------------------------------------
91: # DSA API 代理：/api/v1/* 收敛到后端 8000
92: # ---------------------------------------------------------------------------
93: @router.api_route(
94:     "/api/v1/{path:path}",
95:     methods=["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS", "HEAD"],
96:     include_in_schema=False,
97: )
98: async def proxy_dsa(request: Request, path: str) -> Response:
99:     return await _proxy_request(request, _DSA_BASE, path)
