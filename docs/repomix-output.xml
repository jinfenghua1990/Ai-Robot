  1: /**
  2:  * 格式化金额：保留2位小数，null返回'--'
  3:  * @param {number} val - 金额
  4:  * @returns {string} 格式化后的字符串
  5:  */
  6: export const formatMoney = (val) => {
  7:   if (val == null) return '--';
  8:   return val.toLocaleString('zh-CN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  9: };
 10: /**
 11:  * 安全保留2位小数（null/NaN→'0.00'）
 12:  */
 13: export const f2 = (v) => {
 14:   const n = Number(v);
 15:   return isNaN(n) ? '0.00' : n.toFixed(2);
 16: };
 17: /**
 18:  * 涨跌色：正→红 #ef4444，负→绿 #22c55e，零/NaN→灰 #888
 19:  */
 20: export const colorForPct = (v) => {
 21:   const n = Number(v);
 22:   if (isNaN(n) || n === 0) return '#888';
 23:   return n > 0 ? '#ef4444' : '#22c55e';
 24: };
 25: /**
 26:  * 去掉股票代码的 .SH/.SZ/.BJ 后缀
 27:  */
 28: export const stripCode = (code) => String(code || '').split('.')[0];
 29: /**
 30:  * 格式化盈亏：带正负号 + 2位小数
 31:  * @param {number} val - 盈亏金额
