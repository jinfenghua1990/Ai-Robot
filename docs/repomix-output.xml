643:             <div style={{
644:               background: C.card, border: `1px solid ${C.border}`,
645:               borderRadius: 12, padding: 24, marginBottom: 24
646:             }}>
647:               <h2 style={{
648:                 fontSize: 18, color: C.heading, marginBottom: 16,
649:                 paddingBottom: 10, borderBottom: `1px solid ${C.border}`,
650:                 display: 'flex', alignItems: 'center', gap: 8
651:               }}>
652:                 <span style={{ fontSize: 20 }}>⏱️</span> 时间窗口共振
653:               </h2>
654:               <SummaryBox>
655:                 {data.time_confluence.map((item, i) => {
656:                   const isConfluence = item.includes('多指数共振');
657:                   return (
658:                     <li key={i} style={{
659:                       padding: '6px 0', fontSize: 13,
660:                       borderBottom: `1px solid ${C.border}`,
661:                       listStyle: 'none',
662:                       color: isConfluence ? C.orange : 'inherit',
663:                       fontWeight: isConfluence ? 600 : 400
664:                     }}>
665:                       {isConfluence && <span style={{ marginRight: 4 }}>⚡</span>}
666:                       {item}
