  1: import ReactECharts from 'echarts-for-react/lib/core';
  2: import echarts from '../../lib/echarts';
  3: import { tooltipStyle } from '../../utils/chartConfig';
  4: import { getSectorColorHex } from '../../utils/sectorColors';
  5: // A股颜色习惯：红色=流入/上涨，绿色=流出/下跌
  6: const COLOR_INFLOW = '#ef4444';   // 红色 - 流入
  7: const COLOR_OUTFLOW = '#22c55e';  // 绿色 - 流出
  8: export default function SankeyChart({ data, onNodeClick, selectedSector, height = '500px' }) {
  9:   if (!data || !data.nodes || data.nodes.length === 0) {
 10:     return (
 11:       <div className="flex items-center justify-center h-96 text-sm" style={{ color: 'var(--text-muted)' }}>
 12:         暂无轮动数据
 13:       </div>
 14:     );
 15:   }
 16:   // 计算各节点总流入/流出
 17:   const inTotals = {};
 18:   const outTotals = {};
 19:   const nodeCategory = {}; // name → category 映射
 20:   data.nodes.forEach(n => {
 21:     nodeCategory[n.name] = n.category;
 22:   });
 23:   data.links.forEach(l => {
 24:     outTotals[l.source] = (outTotals[l.source] || 0) + l.value;
 25:     inTotals[l.target] = (inTotals[l.target] || 0) + l.value;
 26:   });
 27:   // 节点颜色：同一板块固定色相，流入/流出用同一色相的明暗区分
 28:   const getNodeColor = (name) => {
 29:     const category = nodeCategory[name];
 30:     return getSectorColorHex(name, category === 'outflow' ? 'outflow' : 'inflow');
 31:   };
 32:   // 获取节点总额
 33:   const getNodeTotal = (name) => {
 34:     const category = nodeCategory[name];
 35:     return category === 'outflow' ? (outTotals[name] || 0) : (inTotals[name] || 0);
 36:   };
 37:   const option = {
 38:     tooltip: {
 39:       ...tooltipStyle,
 40:       trigger: 'item',
 41:       formatter: (params) => {
 42:         if (params.dataType === 'edge') {
 43:           const pct = ((params.data.value / (outTotals[params.data.source] || 1)) * 100).toFixed(1);
 44:           return `<div style="font-weight:600;font-size:13px">${params.data.source} → ${params.data.target}</div>` +
 45:                  `<div style="font-size:12px;color:#ccc">资金量：<span style="font-weight:600;color:#fff">${params.data.value.toFixed(1)}万</span></div>` +
 46:                  `<div style="font-size:12px;color:#ccc">占流出比：${pct}%</div>`;
 47:         }
 48:         const nodeName = params.data.name;
 49:         const category = nodeCategory[nodeName];
 50:         const total = getNodeTotal(nodeName);
 51:         const type = category === 'outflow' ? '流出' : '流入';
 52:         const color = getSectorColorHex(nodeName, category === 'outflow' ? 'outflow' : 'inflow');
 53:         return `<div style="font-weight:700;font-size:14px;margin-bottom:4px">${nodeName}</div>` +
 54:                `<div style="font-size:12px;color:#ccc">类型：<span style="color:${color}">${type}</span></div>` +
 55:                `<div style="font-size:12px;color:#ccc">总${type}：<span style="font-weight:600;color:#fff">${total.toFixed(1)}万</span></div>`;
 56:       },
 57:     },
 58:     series: [{
 59:       type: 'sankey',
 60:       data: data.nodes.map(n => {
 61:         const isSelected = selectedSector && n.name === selectedSector;
 62:         const dimmed = selectedSector && !isSelected;
 63:         return {
 64:           name: n.name,
 65:           itemStyle: {
 66:             color: getNodeColor(n.name),
 67:             borderColor: isSelected ? '#fff' : 'rgba(0,0,0,0.2)',
 68:             borderWidth: isSelected ? 2 : 0,
 69:             opacity: dimmed ? 0.25 : 1,
 70:           },
 71:           value: getNodeTotal(n.name),
 72:         };
 73:       }),
 74:       links: data.links.map(l => {
 75:         const involved = selectedSector && (l.source === selectedSector || l.target === selectedSector);
 76:         const dimmed = selectedSector && !involved;
 77:         return {
 78:           source: l.source,
 79:           target: l.target,
 80:           value: l.value,
 81:           lineStyle: {
 82:             color: 'gradient',
 83:             curveness: 0.5,
 84:             opacity: dimmed ? 0.05 : (involved ? 0.5 : 0.25),
 85:           },
 86:         };
 87:       }),
 88:       orient: 'horizontal',
 89:       label: {
 90:         color: 'var(--text-primary)',
 91:         fontSize: 11,
 92:         fontWeight: 500,
 93:         formatter: (params) => {
 94:           const name = params.data.name;
 95:           const total = getNodeTotal(name);
 96:           return `${name}\n${total.toFixed(0)}万`;
 97:         },
 98:       },
 99:       lineStyle: { color: 'gradient', curveness: 0.5, opacity: 0.25 },
100:       emphasis: { focus: 'adjacency', lineStyle: { opacity: 0.7 } },
101:       nodeGap: 16,
102:       nodeWidth: 10,
103:       layoutIterations: 32,
104:     }],
105:   };
106:   const onChartClick = (params) => {
107:     if (params.dataType === 'node' && onNodeClick) {
108:       onNodeClick(params.data.name);
109:     }
110:   };
111:   const onEvents = { click: onChartClick };
112:   return (
113:     <div className="h-full flex flex-col">
114:       <div className="flex items-center justify-between mb-1 px-1">
115:         <div className="flex items-center gap-2 text-[10px]" style={{ color: 'var(--text-muted)' }}>
116:           <span className="flex items-center gap-1"><span className="inline-block w-2 h-2 rounded" style={{background: COLOR_OUTFLOW}}></span>流出</span>
117:           <span className="flex items-center gap-1"><span className="inline-block w-2 h-2 rounded" style={{background: COLOR_INFLOW}}></span>流入</span>
118:         </div>
119:         <div className="text-[10px]" style={{ color: 'var(--text-muted)' }}>
120:           悬停详情{onNodeClick ? ' · 点击钻取' : ''}
121:         </div>
122:       </div>
123:       <div className="flex-1 min-h-0">
124:         <ReactECharts echarts={echarts} option={option} style={{ height: '100%', width: '100%' }} opts={{ renderer: 'canvas' }} onEvents={onEvents} />
125:       </div>
126:     </div>
127:   );
128: }
</file>

