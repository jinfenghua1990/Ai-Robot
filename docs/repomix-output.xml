 12: export default function MoneyFlowBoard({ moneyFlow, sectorTrend, sector, dash }) {
 13:   const useDash = !!dash && dash.institution_flow != null;
 14:   const inst = dash?.institution_flow || {};
 15:   const sf = dash?.sector_flow || {};
 16:   const mf = moneyFlow;
 17:   const hasMf = mf?.available;
 18:   if (!useDash && !hasMf) {
 19:     return (
 20:       <div className="rounded-md px-2 py-3 text-center text-[10px]" style={{ background: 'var(--bg-card)', color: 'var(--text-muted)' }}>
 21:         暂无盘后资金流向数据
 22:       </div>
 23:     );
 24:   }
 25:   // 饼图：优先用 dash 5 档净流入绝对值分布；fallback 用旧 moneyFlow 买入/卖出
 26:   let pieData = [];
 27:   if (useDash) {
 28:     const abs = (v) => Math.abs(v || 0);
 29:     pieData = [
 30:       { value: abs(inst.super_large_net), name: '特大', itemStyle: { color: '#ef4444' } },
 31:       { value: abs(inst.large_net), name: '大单', itemStyle: { color: '#f97316' } },
 32:       { value: abs(inst.medium_net), name: '中单', itemStyle: { color: '#eab308' } },
 33:       { value: abs(inst.small_net), name: '小单', itemStyle: { color: '#3b82f6' } },
 34:       { value: abs(inst.tiny_net), name: '散单', itemStyle: { color: '#94a3b8' } },
 35:     ].filter(d => d.value > 0);
 36:   } else {
 37:     const mainBuy = mf.main_buy || 0;
 38:     const mainSell = mf.main_sell || 0;
 39:     const retailBuy = mf.retail_buy;
 40:     const retailSell = mf.retail_sell;
 41:     const hasRetail = retailBuy != null && retailSell != null;
 42:     pieData = [
 43:       { value: Math.max(mainBuy, 0), name: '主力买入', itemStyle: { color: '#d32f2f' } },
 44:       { value: Math.max(mainSell, 0), name: '主力卖出', itemStyle: { color: '#388e3c' } },
 45:       ...(hasRetail ? [
 46:         { value: Math.max(retailBuy, 0), name: '散户买入', itemStyle: { color: '#ff7043' } },
 47:         { value: Math.max(retailSell, 0), name: '散户卖出', itemStyle: { color: '#8bc34a' } },
 48:       ] : []),
 49:     ].filter(d => d.value > 0);
 50:   }
 51:   const pieOption = {
 52:     tooltip: { trigger: 'item', formatter: '{b}: {c}' + (useDash ? '万' : '万') + ' ({d}%)' },
 53:     legend: { show: false },
 54:     series: [{
 55:       type: 'pie',
 56:       radius: ['35%', '62%'],
 57:       center: ['50%', '52%'],
 58:       label: { show: true, fontSize: 10, formatter: '{b}\n{d}%' },
 59:       labelLine: { length: 6, length2: 5 },
 60:       data: pieData,
 61:     }],
 62:   };
 63:   const flowRows = useDash ? [
 64:     { name: '特大单', val: inst.super_large_net || 0 },
 65:     { name: '大单', val: inst.large_net || 0 },
 66:     { name: '中单', val: inst.medium_net || 0 },
 67:     { name: '小单', val: inst.small_net || 0 },
 68:     { name: '散单', val: inst.tiny_net || 0 },
 69:   ] : [
 70:     { name: '特大单', val: mf.super_large || 0 },
 71:     { name: '大单', val: mf.large || 0 },
 72:     { name: '小单', val: mf.small || 0 },
 73:     { name: '散单', val: mf.tiny || 0 },
 74:   ];
 75:   const maxAbs = Math.max(...flowRows.map(d => Math.abs(d.val)), 1);
 76:   const fmt = useDash ? fmtYuan : fmtWan;
 77:   const mainNet = useDash ? inst.main_net : mf.main_net;
 78:   const retailNet = useDash ? (inst.retail_net != null ? inst.retail_net : -(inst.main_net || 0)) : mf.retail_net;
 79:   const sectorNet = useDash ? sf.net_flow : sectorTrend?.total_net_flow;
 80:   const sectorName = useDash ? (sf.sector || sector) : sector;
 81:   return (
 82:     <div className="rounded-md px-2 py-1.5 flex flex-col gap-1.5" style={{ background: 'transparent', border: '1px solid rgba(107,114,128,0.2)' }}>
 83:       {/* 标题 */}
 84:       <div className="flex items-center justify-between">
 85:         <div className="flex items-center gap-1.5">
 86:           <span className="text-[11px] font-bold" style={{ color: 'var(--flow-up)' }}>资金流向</span>
 87:           {hasMf && !useDash && mf.trade_date && (
 88:             <span className="text-[10px] px-1 rounded" style={{ background: 'rgba(59,130,246,0.1)', color: 'var(--color-blue)' }}>
 89:               📊 盘后 {String(mf.trade_date).slice(0,4)}/{String(mf.trade_date).slice(4,6)}/{String(mf.trade_date).slice(6,8)}
 90:             </span>
 91:           )}
 92:           {useDash && dash.date && (
 93:             <span className="text-[10px] px-1 rounded" style={{ background: 'rgba(59,130,246,0.1)', color: 'var(--color-blue)' }}>
 94:               📊 盘后 {dash.date}
 95:             </span>
 96:           )}
 97:         </div>
 98:       </div>
 99:       {/* 板块净流入 */}
100:       {sectorNet != null && (
101:         <div className="flex items-center justify-between text-[10px] px-1.5 py-0.5 rounded" style={{ background: 'rgba(168,85,247,0.08)', border: '1px solid rgba(168,85,247,0.2)' }}>
102:           <span style={{ color: 'var(--text-muted)' }}>🏭 {sectorName || '板块'}资金净流入</span>
103:           <span className="font-bold" style={{ color: (sectorNet || 0) >= 0 ? 'var(--flow-up)' : 'var(--flow-down)' }}>
104:             {(sectorNet || 0) >= 0 ? '+' : ''}{fmtYuan(sectorNet)}
105:           </span>
106:         </div>
107:       )}
108:       {/* 上排：饼图 + 净额摘要 */}
109:       <div className="grid grid-cols-5 gap-2">
110:         <div className="col-span-2">
111:           {pieData.length > 0 ? (
112:             <ReactECharts option={pieOption} style={{ height: 108 }} opts={{ renderer: 'svg' }} />
113:           ) : (
114:             <div className="h-[108px] flex items-center justify-center text-[10px]" style={{ color: 'var(--text-muted)' }}>暂无分布数据</div>
115:           )}
116:         </div>
117:         <div className="col-span-3 flex flex-col justify-center gap-1">
118:           <div className="flex items-center justify-between text-[10px] px-2 py-1 rounded" style={{ background: (mainNet || 0) >= 0 ? 'rgba(239,68,68,0.08)' : 'rgba(34,197,94,0.08)' }}>
119:             <span className="font-medium" style={{ color: 'var(--text-secondary)' }}>主力</span>
120:             <span className="font-bold" style={{ color: (mainNet || 0) >= 0 ? '#d32f2f' : '#388e3c' }}>
121:               {(mainNet || 0) >= 0 ? '+' : ''}{fmt(mainNet || 0)}
122:             </span>
123:           </div>
124:           <div className="flex items-center justify-between text-[10px] px-2 py-1 rounded" style={{ background: (retailNet || 0) >= 0 ? 'rgba(239,68,68,0.08)' : 'rgba(34,197,94,0.08)' }}>
125:             <span className="font-medium" style={{ color: 'var(--text-secondary)' }}>散户</span>
126:             <span className="font-bold" style={{ color: (retailNet || 0) >= 0 ? '#d32f2f' : '#388e3c' }}>
127:               {(retailNet || 0) >= 0 ? '+' : ''}{fmt(retailNet || 0)}
128:             </span>
129:           </div>
130:         </div>
131:       </div>
132:       {/* 5 档横条 */}
133:       <div className="flex flex-col gap-1">
134:         {flowRows.map((d, i) => {
135:           const isPos = d.val >= 0;
136:           const pct = Math.min(100, Math.abs(d.val) / maxAbs * 100);
137:           return (
138:             <div key={i} className="flex items-center gap-1.5 text-[10px]">
139:               <span className="w-6 flex-shrink-0 text-right font-medium" style={{ color: 'var(--text-secondary)' }}>{d.name}</span>
140:               <div className="flex-1 h-2 rounded-full" style={{ background: 'rgba(107,114,128,0.08)' }}>
141:                 <div className="h-full rounded-full" style={{ width: `${pct}%`, background: isPos ? '#d32f2f' : '#388e3c', opacity: 0.8 }} />
142:               </div>
143:               <span className="w-14 text-right font-bold tabular-nums" style={{ color: isPos ? '#d32f2f' : '#388e3c' }}>
144:                 {isPos ? '+' : ''}{fmt(d.val)}
145:               </span>
146:             </div>
147:           );
148:         })}
149:       </div>
150:     </div>
151:   );
152: }
