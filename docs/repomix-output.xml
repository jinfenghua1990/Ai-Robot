 77: def _mean(values: Sequence[float]) -> float | None:
 78:     return mean(values) if values else None
 79: def _ret(closes: Sequence[float], period: int) -> float | None:
 80:     if len(closes) <= period or not closes[-period - 1]:
 81:         return None
 82:     return closes[-1] / closes[-period - 1] - 1
 83: def _corr(left: Sequence[float], right: Sequence[float]) -> float | None:
 84:     if len(left) != len(right) or len(left) < 3:
 85:         return None
 86:     lx, rx = mean(left), mean(right)
 87:     ld = sum((x - lx) ** 2 for x in left) ** 0.5
 88:     rd = sum((x - rx) ** 2 for x in right) ** 0.5
 89:     return sum((a - lx) * (b - rx) for a, b in zip(left, right)) / (ld * rd) if ld and rd else None
 90: def _slope(values: Sequence[float]) -> float | None:
 91:     if len(values) < 2:
 92:         return None
 93:     xbar = (len(values) - 1) / 2
 94:     ybar = mean(values)
 95:     den = sum((i - xbar) ** 2 for i in range(len(values)))
 96:     return sum((i - xbar) * (v - ybar) for i, v in enumerate(values)) / den if den else None
 97: def _atr(bars: Sequence[Bar], period: int = 14) -> float | None:
 98:     if len(bars) < period + 1 or not bars[-1].close:
 99:         return None
100:     tr = []
101:     for prev, cur in zip(bars[-period - 1:-1], bars[-period:]):
102:         tr.append(max(cur.high - cur.low, abs(cur.high - prev.close), abs(cur.low - prev.close)))
103:     return mean(tr) / bars[-1].close if tr else None
104: def _percentile(values: Sequence[float], value: float) -> float:
105:     if len(values) < 2:
106:         return 50.0
107:     below = sum(item < value for item in values)
108:     equal = sum(item == value for item in values)
109:     return 100.0 * (below + equal / 2) / len(values)
