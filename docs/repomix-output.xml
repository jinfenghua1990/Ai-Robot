  8: import ChartLabelLayer from './ChartLabelLayer';
  9: /**
 10:  * 概念板块实时资金流向累计走势图（仿行情终端风格）
 11:  * - 所有折线从 09:30 的 0 轴出发
 12:  * - 净流入区域红色系，净流出区域绿色系
 13:  * - 右侧板块名称+数值用外部 HTML 标签层渲染，强制最小间距，永不重叠
 14:  * - 按最终值排序：净流入在上，净流出在下
 15:  */
 16: export default function ConceptRealtimeTrendChart({
 17:   sectors, rtSectors, selectedSector, onSectorClick, height = '260px', maxLines = 30,
 18:   trendApiPath = '/api/realtime/concept-sector-trend',
 19:   bulkTrendApiPath,
 20: }) {
 21:   const [trends, setTrends] = useState([]);
 22:   const [loading, setLoading] = useState(false);
 23:   const cacheRef = useRef(new Map());
 24:   const chartRef = useRef(null);
 25:   const tradeDate = rtSectors?.trade_date;
 26:   // 生成固定交易时间轴（09:30-11:30, 13:00-15:00）
 27:   const timeAxis = useMemo(() => {
 28:     const times = [];
 29:     for (let h = 9; h <= 11; h++) {
 30:       for (let m = 30; m < 60; m += 5) times.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
 31:     }
 32:     times.push('12:00'); // dummy noon separator
 33:     for (let h = 13; h < 15; h++) {
 34:       for (let m = 0; m < 60; m += 5) times.push(`${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}`);
 35:     }
 36:     times.push('15:00');
 37:     return times;
 38:   }, []);
 39:   useEffect(() => {
 40:     if (!tradeDate || !sectors?.length) {
 41:       setTrends([]);
 42:       return;
 43:     }
 44:     const controller = new AbortController();
 45:     setLoading(true);
