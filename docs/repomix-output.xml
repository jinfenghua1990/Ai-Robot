  52: // 14 日 RSI
  53: function calcRSI(closes, period = 14) {
  54:   if (!closes || closes.length < period + 1) return null;
  55:   let gains = 0, losses = 0;
  56:   for (let i = closes.length - period; i < closes.length; i++) {
  57:     const d = closes[i] - closes[i - 1];
  58:     if (d >= 0) gains += d; else losses -= d;
  59:   }
  60:   const rs = gains / (losses || 1e-9);
  61:   return 100 - 100 / (1 + rs);
  62: }
