<file path="backend/api/rate_limit.py">
  1: import logging
  2: from fastapi import Request, status
  3: from fastapi.responses import JSONResponse
  4: from starlette.middleware.base import BaseHTTPMiddleware
  5: from config import (
  6:     RATE_LIMIT_MAX_REQUESTS,
  7:     RATE_LIMIT_WINDOW_SECONDS,
  8:     RATE_LIMIT_MAX_CONNECTIONS_PER_IP,
  9: )
 10: from datetime import datetime, timedelta
 11: from collections import defaultdict
 12: logger = logging.getLogger("rate_limit")
 13: # V2 总览是本地数据库只读接口。首屏会并行请求 dashboard/candidates，
 14: # 还会被用户频繁切换页面重新读取；把它们计入全局外部接口频率桶，
 15: # 会导致正常的页面导航被错误地返回 429。并发限制仍然保留，避免请求堆积。
 16: V2_READ_ONLY_PREFIXES = (
 17:     "/api/v2/dashboard",
 18:     "/api/v2/candidates",
 19:     "/api/v2/health",
 20:     "/api/v2/registry",
 21:     "/api/v2/factor-lifecycle",
 22:     "/api/v2/system/quality",
 23:     "/api/v2/system/quality-dashboard",
 24:     "/api/v2/collection/status",
 25: )
 26: class RateLimitMiddleware(BaseHTTPMiddleware):
 27:     """单 worker 语义的限流中间件。
 28:     注意：
 29:     - 多 worker 部署（uvicorn --workers N）时，每个 worker 持有独立计数器，
 30:       全局阈值实际为 max_requests * N。需要跨 worker 一致限流请改用 Redis。
 31:     - 中间件内不要 raise HTTPException：会被外层 ServerErrorMiddleware +
 32:       全局 Exception handler 吞成 500。统一返回 JSONResponse。
 33:     """
 34:     def __init__(self, app, max_requests: int = None, window_seconds: int = None):
 35:         super().__init__(app)
 36:         self.max_requests = max_requests or RATE_LIMIT_MAX_REQUESTS
 37:         self.window_seconds = window_seconds or RATE_LIMIT_WINDOW_SECONDS
 38:         self.request_timestamps = defaultdict(list)
 39:         # 每 IP 活跃连接计数
 40:         self.active_connections = defaultdict(int)
 41:         self.max_connections_per_ip = RATE_LIMIT_MAX_CONNECTIONS_PER_IP
 42:     async def dispatch(self, request: Request, call_next):
 43:         # request.client 在 ASGI 内部调用 / Unix socket 部署时可能为 None
 44:         client_ip = request.client.host if request.client else "unknown"
 45:         path = request.url.path
 46:         # 只对 GET/HEAD 生效；POST 的快照保存、系统检查和交易接口仍受限。
 47:         skip_frequency_limit = (
 48:             request.method in {"GET", "HEAD"}
 49:             and path.startswith(V2_READ_ONLY_PREFIXES)
 50:         )
 51:         # 跳过：SSE 长连接 / 静态资源 / 健康检查 / 文档
 52:         skip_connection_limit = (
 53:             path == '/api/watchlist/realtime/stream' or
 54:             path.startswith('/assets/') or
 55:             path.startswith('/_dsa/') or
 56:             path == '/api/health' or
 57:             path == '/api/health/detailed' or
 58:             path == '/openapi.json' or
 59:             path.startswith('/docs') or
 60:             path == '/redoc'
 61:         )
 62:         # 1. 并发连接数限制（防止连接积压）
 63:         if not skip_connection_limit and self.active_connections[client_ip] >= self.max_connections_per_ip:
 64:             logger.warning(
 65:                 "[rate_limit] 429 TOO_MANY_CONNECTIONS ip=%s path=%s active=%d/%d",
 66:                 client_ip, path, self.active_connections[client_ip], self.max_connections_per_ip
 67:             )
 68:             return JSONResponse(
 69:                 status_code=status.HTTP_429_TOO_MANY_REQUESTS,
 70:                 content={
 71:                     "code": "TOO_MANY_CONNECTIONS",
 72:                     "message": "并发连接过多，请关闭多余标签页后重试",
 73:                     "retry_after": 5,
 74:                 },
 75:             )
 76:         # 2. 请求频率限制
 77:         now = datetime.now()
 78:         window_start = now - timedelta(seconds=self.window_seconds)
 79:         # 过滤过期时间戳，列表为空时删除 IP key，避免长期内存泄漏
 80:         recent = [ts for ts in self.request_timestamps[client_ip] if ts > window_start]
 81:         if recent:
 82:             self.request_timestamps[client_ip] = recent
 83:         elif client_ip in self.request_timestamps:
 84:             del self.request_timestamps[client_ip]
 85:         if not skip_frequency_limit and len(recent) >= self.max_requests:
 86:             logger.warning(
 87:                 "[rate_limit] 429 RATE_LIMITED ip=%s path=%s requests=%d/%d in %ds",
 88:                 client_ip, path, len(recent), self.max_requests, self.window_seconds
 89:             )
 90:             return JSONResponse(
 91:                 status_code=status.HTTP_429_TOO_MANY_REQUESTS,
 92:                 content={
 93:                     "code": "RATE_LIMITED",
 94:                     "message": "请求过于频繁，请稍后再试",
 95:                     "retry_after": self.window_seconds,
 96:                 },
 97:                 headers={"Retry-After": str(self.window_seconds)},
 98:             )
 99:         if not skip_frequency_limit:
100:             self.request_timestamps[client_ip].append(now)
101:         if not skip_connection_limit:
102:             self.active_connections[client_ip] += 1
103:         try:
104:             response = await call_next(request)
105:             return response
106:         finally:
107:             if not skip_connection_limit:
108:                 # pop 避免 KeyError；defaultdict 会按需重建
109:                 self.active_connections[client_ip] -= 1
110:                 if self.active_connections[client_ip] <= 0:
111:                     self.active_connections.pop(client_ip, None)
