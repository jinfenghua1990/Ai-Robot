<file path="frontend/src/components/IpoTracker.jsx">
  1: import { useState, useEffect, useMemo } from 'react';
  2: import { parseStageDate } from '../data/ipoProjects';
  3: // ─────────────────────────────────────────────────────────────────────────
  4: // IPO 跟踪共享组件
  5: //   IpoTimeline    —— 前跟踪：横向步进器 + 实时倒计时（按当前时间自动推进）
  6: //   IpoListingCard —— 后跟踪：上市后拉取公司自身实时行情卡
  7: // ─────────────────────────────────────────────────────────────────────────
  8: // 计算当前所处阶段
  9: export function computeIpoProgress(project, now) {
 10:   const enriched = project.stages.map((s) => ({ ...s, ms: parseStageDate(s.date) }));
 11:   let currentIdx = -1;
 12:   enriched.forEach((s, i) => {
 13:     if (s.ms != null && s.ms <= now) currentIdx = i;
 14:   });
 15:   const nextIdx = enriched.findIndex((s) => s.ms != null && s.ms > now);
 16:   return enriched.map((s, i) => {
 17:     let status;
 18:     if (s.ms == null) status = 'unknown';
 19:     else if (i < currentIdx) status = 'done';
 20:     else if (i === currentIdx) status = 'done';
 21:     else if (i === nextIdx) status = 'active';
 22:     else status = 'upcoming';
 23:     return { ...s, status };
 24:   }).reduce((acc, s, i) => {
 25:     acc.stages.push(s);
 26:     if (s.status === 'active') acc.nextIdx = i;
 27:     return acc;
 28:   }, { stages: [], nextIdx: -1, currentIdx });
 29: }
 30: const STATUS_STYLE = {
 31:   done: { color: '#22c55e', bg: 'rgba(34,197,94,0.12)', border: 'rgba(34,197,94,0.4)', icon: '✓' },
 32:   active: { color: '#3b82f6', bg: 'rgba(59,130,246,0.14)', border: 'rgba(59,130,246,0.5)', icon: '●' },
 33:   upcoming: { color: 'var(--text-muted)', bg: 'var(--bg-surface)', border: 'var(--border-color)', icon: '○' },
 34:   unknown: { color: 'var(--text-muted)', bg: 'var(--bg-surface)', border: 'var(--border-color)', icon: '?' },
 35: };
 36: function fmtCountdown(ms) {
 37:   if (ms < 0) ms = 0;
 38:   const dd = Math.floor(ms / 86400000);
 39:   const hh = Math.floor((ms % 86400000) / 3600000);
 40:   const mm = Math.floor((ms % 3600000) / 60000);
 41:   if (dd > 0) return `${dd}天${hh}小时`;
 42:   if (hh > 0) return `${hh}小时${mm}分`;
 43:   return `${mm}分`;
 44: }
 45: function fmtDate(d) {
 46:   if (!d) return '待披露';
 47:   return d.replace(/-/g, '/');
 48: }
 49: // ===== 前跟踪：进程时间线 + 实时倒计时 =====
 50: export function IpoTimeline({ project }) {
 51:   const [now, setNow] = useState(Date.now());
 52:   useEffect(() => {
 53:     const t = setInterval(() => setNow(Date.now()), 30000); // 每 30s 刷新倒计时
 54:     return () => clearInterval(t);
 55:   }, []);
 56:   const { stages, nextIdx } = useMemo(() => computeIpoProgress(project, now), [project, now]);
 57:   const nextStage = nextIdx >= 0 ? stages[nextIdx] : null;
 58:   const allDone = stages.every((s) => s.status === 'done');
 59:   let statusLine;
 60:   if (project.listed && allDone) {
 61:     statusLine = { text: '已上市 · 后跟踪进行中', color: '#22c55e', icon: '🚀' };
 62:   } else if (nextStage) {
 63:     const diff = nextStage.ms - now;
 64:     statusLine = {
 65:       text: `距「${nextStage.label}」还有 ${fmtCountdown(diff)}`,
 66:       color: STATUS_STYLE.active.color,
 67:       icon: '⏳',
 68:     };
 69:   } else {
 70:     statusLine = { text: '进程进行中 · 后续节点待披露', color: 'var(--text-muted)', icon: '📝' };
 71:   }
 72:   return (
 73:     <div className="rounded-xl border p-3 space-y-2.5" style={{
 74:       borderColor: 'rgba(59,130,246,0.3)',
 75:       background: 'linear-gradient(135deg, rgba(59,130,246,0.05) 0%, rgba(168,85,247,0.04) 100%)',
 76:     }}>
 77:       {/* 顶部状态行 */}
 78:       <div className="flex items-center gap-2 flex-wrap">
 79:         <span className="text-sm font-bold" style={{ color: 'var(--text-primary)' }}>{project.name}</span>
 80:         <span className="text-xs px-2 py-0.5 rounded-full flex items-center gap-1"
 81:           style={{ background: `${statusLine.color}14`, color: statusLine.color, border: `1px solid ${statusLine.color}40` }}>
 82:           {statusLine.icon} {statusLine.text}
 83:         </span>
 84:         <span className="text-xs px-1.5 py-0.5 rounded" style={{ background: 'rgba(168,85,247,0.1)', color: '#a855f7' }}>
 85:           {project.board}{project.code ? ` · ${project.code}` : ' · 代码待定'}
 86:         </span>
 87:       </div>
 88:       {/* 步进器 */}
 89:       <div className="flex items-center gap-1 flex-wrap">
 90:         {stages.map((s, i) => {
 91:           const st = STATUS_STYLE[s.status];
 92:           return (
 93:             <div key={s.key} className="flex items-center gap-1">
 94:               <div className="flex flex-col items-center" title={s.label}>
 95:                 <div className="w-5 h-5 rounded-full flex items-center justify-center text-[10px] font-bold"
 96:                   style={{ background: st.bg, color: st.color, border: `1px solid ${st.border}` }}>
 97:                   {st.icon}
 98:                 </div>
 99:                 <div className="text-[9px] mt-0.5 whitespace-nowrap" style={{ color: s.status === 'upcoming' || s.status === 'unknown' ? 'var(--text-muted)' : st.color }}>
100:                   {s.label}
101:                 </div>
102:                 <div className="text-[8px] whitespace-nowrap" style={{ color: 'var(--text-muted)' }}>{fmtDate(s.date)}</div>
103:               </div>
104:               {i < stages.length - 1 && (
105:                 <div className="w-4 h-px mb-4" style={{
106:                   background: s.status === 'done' ? 'rgba(34,197,94,0.5)' : 'var(--border-color)',
107:                 }} />
108:               )}
109:             </div>
110:           );
111:         })}
112:       </div>
113:     </div>
114:   );
115: }
116: // ===== 后跟踪：上市后公司自身实时行情卡 =====
117: export function IpoListingCard({ project, quote, loading }) {
118:   if (!project.listed || !project.code) {
119:     return (
120:       <div className="rounded-xl border p-3" style={{ borderColor: 'rgba(148,163,184,0.3)', background: 'var(--bg-card)' }}>
121:         <div className="flex items-center gap-2 mb-1.5">
122:           <span className="text-sm">📈</span>
123:           <span className="text-xs font-bold" style={{ color: 'var(--text-primary)' }}>上市后跟踪（后跟踪）</span>
124:           <span className="text-[10px]" style={{ color: 'var(--text-muted)' }}>· 上市后自动激活</span>
125:         </div>
126:         <div className="text-[11px]" style={{ color: 'var(--text-muted)' }}>
127:           {project.name} 尚未上市（代码待定）。上市后本模块将自动拉取该公司自身实时行情：
128:           现价、涨跌、较发行价涨跌幅、市值估算，无需手动配置。
129:         </div>
130:       </div>
131:     );
132:   }
133:   const price = quote?.price;
134:   const chg = quote?.changePct;
135:   const isUp = chg != null && chg >= 0;
136:   const vsIssue = project.issuePrice && price != null
137:     ? (price / project.issuePrice - 1) * 100
138:     : null;
139:   const marketCap = project.totalShares && price != null
140:     ? price * project.totalShares
141:     : null;
142:   const fmtCap = (v) => {
143:     if (v == null) return '待补充';
144:     if (v >= 1e12) return (v / 1e12).toFixed(2) + '万亿';
145:     return (v / 1e8).toFixed(0) + '亿';
146:   };
147:   const fmtChgPct = (v) => {
148:     if (v == null) return '—';
149:     return `${v >= 0 ? '+' : ''}${v.toFixed(2)}%`;
150:   };
151:   const cards = [
152:     {
153:       label: '现价', value: price != null ? price.toFixed(2) : '—',
154:       color: 'var(--text-primary)', sub: project.code,
155:     },
156:     {
157:       label: '涨跌幅', value: fmtChgPct(chg),
158:       color: isUp ? '#ef4444' : '#22c55e', sub: isUp ? '▲' : '▼',
159:     },
160:     {
161:       label: '较发行价', value: vsIssue != null ? fmtChgPct(vsIssue) : (project.issuePrice ? '—' : '待补充'),
162:       color: vsIssue == null ? 'var(--text-muted)' : (vsIssue >= 0 ? '#ef4444' : '#22c55e'),
163:       sub: project.issuePrice ? `发行价 ${project.issuePrice}` : '发行价待补充',
164:     },
165:     {
166:       label: '估算市值', value: fmtCap(marketCap),
167:       color: 'var(--text-primary)', sub: project.totalShares ? '基于总股本' : '总股本待补充',
168:     },
169:   ];
170:   return (
171:     <div className="rounded-xl border p-3" style={{ borderColor: 'rgba(34,197,94,0.3)', background: 'var(--bg-card)' }}>
172:       <div className="flex items-center gap-2 mb-2">
173:         <span className="text-sm">📈</span>
174:         <span className="text-xs font-bold" style={{ color: 'var(--text-primary)' }}>上市后跟踪（后跟踪）</span>
175:         <span className="text-[10px]" style={{ color: 'var(--text-muted)' }}>· 实时行情 {project.code}</span>
176:         {loading && !quote && <span className="text-[10px]" style={{ color: '#f59e0b' }}>加载中…</span>}
177:       </div>
