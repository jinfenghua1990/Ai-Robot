 76: │   ├── api/               # 33 个 endpoint
 77: │   ├── services/          # 业务服务
 78: │   ├── analyzers/         # 纯分析
 79: │   ├── collectors/        # 数据采集
 80: │   ├── strategies/        # 策略代码
 81: │   └── db/                # 模型
 82: ├── frontend/              # 前端
 83: │   ├── src/pages/         # 14 个页面
 84: │   ├── src/components/    # 通用组件
 85: │   └── src/lib/           # 工具
 86: ├── docs/                  # 文档
 87: │   ├── ARCHITECTURE.md
 88: │   ├── API.md
 89: │   ├── ER_DIAGRAM.md
 90: │   └── audit/SUMMARY.md
 91: ├── start.sh               # 启动脚本
 92: └── stop.sh                # 停止脚本
