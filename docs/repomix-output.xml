 76: def _yahoo_fetch(symbol: str, range_str: str = "5d") -> list[dict] | None:
 77:     """通过 Yahoo Finance API 获取 K 线；港股失败时回退新浪。
 78:     每次请求独立 Session（避免多线程共享会话死锁）；不做 crumb 刷新
 79:     （实测 Yahoo 对本机 IP  blanket 429，crumb 无效且 fc.yahoo.com 易挂起拖慢页面）。
 80:     Yahoo 不可用时快速失败（429/异常/空结果）→ 港股回退新浪，其余返回 None。
 81:     """
 82:     url = f"https://query1.finance.yahoo.com/v8/finance/chart/{symbol}"
 83:     params = {"range": range_str, "interval": "1d"}
 84:     s = requests.Session()
 85:     s.headers.update(_YAHOO_HEADERS)
 86:     try:
 87:         try:
 88:             resp = s.get(url, params=params, timeout=10)
 89:             if resp.status_code == 429:
 90:                 logger.warning(f"Yahoo 429 for {symbol}")
 91:             else:
 92:                 resp.raise_for_status()
 93:                 data = resp.json()
 94:                 result = data["chart"]["result"][0]
 95:                 ts_list = result.get("timestamp", [])
 96:                 quote = result.get("indicators", {}).get("quote", [{}])[0]
 97:                 opens = quote.get("open", [])
 98:                 highs = quote.get("high", [])
 99:                 lows = quote.get("low", [])
100:                 closes = quote.get("close", [])
101:                 volumes = quote.get("volume", [])
102:                 items = []
103:                 prev_close = None
104:                 for i in range(len(ts_list)):
105:                     close = closes[i] if i < len(closes) else None
106:                     if close is None:
107:                         continue
108:                     import datetime as _dt
109:                     dt = _dt.datetime.fromtimestamp(ts_list[i])
110:                     open_price = opens[i] if i < len(opens) else None
111:                     high = highs[i] if i < len(highs) else None
112:                     low = lows[i] if i < len(lows) else None
113:                     volume = volumes[i] if i < len(volumes) else None
114:                     change_amount = round(close - prev_close, 4) if prev_close and prev_close > 0 else None
115:                     change_pct = round((close - prev_close) / prev_close * 100, 4) if prev_close and prev_close > 0 else None
116:                     items.append({
117:                         "date": dt.strftime("%Y-%m-%d"),
118:                         "open": round(open_price, 4) if open_price else None,
119:                         "high": round(high, 4) if high else None,
120:                         "low": round(low, 4) if low else None,
121:                         "close": round(close, 4),
122:                         "volume": int(volume) if volume else 0,
123:                         "change_pct": change_pct,
124:                         "change_amount": change_amount,
125:                         "prev_close": round(prev_close, 4) if prev_close else None,
126:                     })
127:                     prev_close = close
128:                 if items:
129:                     return items
130:         except Exception as exc:
131:             logger.warning(f"Yahoo Finance fetch failed for {symbol}: {exc}")
132:         # Yahoo 不可用（429/异常/空结果）→ 港股回退新浪，其余快速返回 None
133:         if symbol.endswith(".HK"):
134:             return _sina_hk_kline(symbol, range_str)
135:         return None
136:     finally:
137:         s.close()
138: def _yfinance_fetch(symbol: str, range_str: str = "5d") -> list[dict] | None:
139:     """使用本地 yfinance 包作为 Yahoo chart API 的备用实现。"""
140:     try:
141:         import yfinance as yf
142:         frame = yf.download(
143:             symbol,
144:             period=range_str,
145:             interval="1d",
146:             auto_adjust=False,
147:             progress=False,
148:             threads=False,
149:         )
150:         if frame is None or frame.empty:
151:             return None
152:         if hasattr(frame.columns, "levels"):
153:             frame.columns = frame.columns.get_level_values(0)
154:         required = {"Open", "High", "Low", "Close", "Volume"}
155:         if not required.issubset(set(frame.columns)):
156:             return None
157:         items = []
158:         previous = None
159:         for index, row in frame.iterrows():
160:             close = _safe_float(row.get("Close"))
161:             if close is None:
162:                 continue
163:             change_amount = round(close - previous, 4) if previous else None
164:             change_pct = round((close - previous) / previous * 100, 4) if previous else None
165:             items.append({
166:                 "date": index.strftime("%Y-%m-%d"),
167:                 "open": _safe_float(row.get("Open")),
168:                 "high": _safe_float(row.get("High")),
169:                 "low": _safe_float(row.get("Low")),
170:                 "close": round(close, 4),
171:                 "volume": int(_safe_float(row.get("Volume")) or 0),
172:                 "change_pct": change_pct,
173:                 "change_amount": change_amount,
174:                 "prev_close": round(previous, 4) if previous else None,
175:             })
176:             previous = close
177:         return items or None
178:     except Exception as exc:
179:         logger.warning("local yfinance fallback failed for %s: %s", symbol, exc)
180:         return None
181: def _sina_hk_kline(yahoo_symbol: str, range_str: str = "5d") -> list[dict] | None:
182:     """新浪港股日K兜底（Yahoo 不可用时）。yahoo_symbol 形如 0700.HK / 700.HK → 新浪 hk00700"""
183:     code = yahoo_symbol.replace(".HK", "")
184:     sina_symbol = f"hk{code.zfill(5)}"
185:     _datalen_map = {"5d": 8, "1mo": 30, "3mo": 90, "6mo": 120, "1y": 250, "2y": 500, "5y": 1200, "ytd": 250, "max": 1200}
186:     datalen = _datalen_map.get(range_str, 30)
187:     url = "https://money.finance.sina.com.cn/quotes_service/api/json_v2.php/CN_MarketData.getKLineData"
188:     params = {"symbol": sina_symbol, "scale": "240", "ma": "no", "datalen": str(datalen)}
189:     try:
190:         resp = requests.get(
191:             url, params=params,
192:             headers={"User-Agent": _YAHOO_HEADERS["User-Agent"], "Referer": "https://finance.sina.com.cn"},
193:             timeout=8,
194:         )
195:         resp.encoding = "gbk"
196:         arr = resp.json()
197:         if not isinstance(arr, list) or not arr:
198:             return None
199:         items = []
200:         prev_close = None
201:         for row in arr:
202:             d = (row.get("day") or "")[:10]
203:             try:
204:                 c = float(row.get("close"))
205:             except (TypeError, ValueError):
206:                 continue
207:             o = _safe_float(row.get("open"))
208:             h = _safe_float(row.get("high"))
209:             l = _safe_float(row.get("low"))
210:             v = _safe_float(row.get("volume"))
211:             change_pct = None
212:             change_amount = None
213:             if prev_close and prev_close > 0:
214:                 change_amount = round(c - prev_close, 4)
215:                 change_pct = round((c - prev_close) / prev_close * 100, 4)
216:             items.append({
217:                 "date": d,
218:                 "open": round(o, 4) if o else None,
219:                 "high": round(h, 4) if h else None,
220:                 "low": round(l, 4) if l else None,
221:                 "close": round(c, 4),
222:                 "volume": int(v) if v else 0,
223:                 "change_pct": change_pct,
224:                 "change_amount": change_amount,
225:                 "prev_close": round(prev_close, 4) if prev_close else None,
226:             })
227:             prev_close = c
228:         return items if items else None
229:     except Exception as e:
230:         logger.warning(f"Sina HK kline failed for {yahoo_symbol}: {e}")
231:         return None
232: def _yahoo_fetch_cached(symbol: str, range_str: str = "5d") -> list[dict] | None:
233:     """带缓存的 _yahoo_fetch，5 分钟 TTL 避免重复慢速调用"""
234:     cache_key = f"{symbol}:{range_str}"
235:     now = time.time()
236:     if cache_key in _cache:
237:         ts, data = _cache[cache_key]
238:         if now - ts < _CACHE_TTL:
239:             return data
240:     data = _yahoo_fetch(symbol, range_str)
241:     _cache[cache_key] = (now, data)
242:     return data
243: def _to_yahoo_symbol(market: str, code: str) -> str:
244:     """把业务代码转成 Yahoo 代码
245:     HK: 00700 → 0700.HK (去前导0, 加 .HK)
246:     US: AAPL → AAPL (不变)
247:     """
248:     if market == "HK":
249:         stripped = code.upper().replace(".HK", "").strip()
250:         try:
251:             return f"{int(stripped):04d}.HK"
252:         except ValueError:
253:             return f"{stripped.zfill(4)}.HK"
