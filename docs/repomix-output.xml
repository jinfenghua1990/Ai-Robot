74:         db.commit()
75:         reset_watchlist_cache()
76:         return {
77:             'success': True,
78:             'synced': len(synced),
79:             'skipped': len(skipped),
80:             'synced_list': synced,
81:             'skipped_list': skipped[:10],
82:             'message': f'同步完成：新增 {len(synced)} 只，跳过 {len(skipped)} 只已存在',
