  1: """
  2: 盘中实时聚合器（DB-first 中转层 - 实时轨）
  3: 数据流（每 5 秒轮询,零外部调用）:
  4:     realtime_stock_flow 表（由 scheduled_realtime_snapshot 每分钟写入,唯一外部采集入口）
  5:         → 本模块读最新一批快照 → 内存聚合大单/主动率/承接指标
  6:         → 写入 REALTIME_STATE dict → FastAPI /api/v1/stock/super_panel 直接读
  7:         → 同时落库 stock_realtime_tick（供 V 字反转回溯,保持兼容）
  8: 设计原则（DB-first）:
  9: - 采集与运算彻底分离:外部行情只由 realtime_collector 采集一次进 realtime_stock_flow
 10: - 本模块不做任何外部 HTTP 请求（不拉东财/腾讯/新浪）,仅读本地库 + 本地运算
 11: - 带宽竞争消除:东财请求量降到每分钟 1 次（snapshot 单路）
 12: """
 13: import logging
 14: from collections import deque
 15: from dataclasses import dataclass, field
 16: from datetime import datetime, timedelta
 17: from typing import Dict, Optional
 18: logger = logging.getLogger(__name__)
 19: # ============================================================
 20: # 内存中转：单只股票的实时态
 21: # ============================================================
 22: @dataclass
 23: class RealtimeState:
 24:     """单只股票的盘中实时态（数据来自 realtime_stock_flow,无盘口）"""
 25:     ts_code: str
 26:     # 最近一次快照
 27:     last_price: float = 0.0
 28:     last_volume: int = 0                                # 累计成交量(手)
 29:     last_amount: float = 0.0                            # 累计成交额(元)
 30:     last_bid_price_1: float = 0.0
 31:     last_bid_vol_1: int = 0
 32:     last_ask_price_1: float = 0.0
 33:     last_ask_vol_1: int = 0
 34:     last_turnover_rate: float = 0.0
 35:     last_main_force_inflow: float = 0.0                 # 主力净流入(元)
 36:     last_snapshot_time: Optional[datetime] = None
 37:     last_source: str = ''
 38:     last_close: float = 0.0                             # 昨收价(realtime_stock_flow 不含,置0)
 39:     last_pct_chg: float = 0.0                           # 涨跌幅 %(源端已算)
 40:     # 大单检测（分钟级代理,基于主力净流入）
 41:     large_buy_count_3s: int = 0
 42:     large_sell_count_3s: int = 0
 43:     large_order_active_ratio: float = 0.0               # 主动买入比 %
 44:     # 千单频次（分钟级代理）
 45:     thousand_count_1m: int = 0
 46:     # 滑窗:保留接口,分钟级下仅记录批次（不再做秒级滑窗）
 47:     _thousand_log: deque = field(default_factory=deque)
 48:     _active_log: deque = field(default_factory=deque)
 49:     # 累计当日大单笔数
 50:     total_large_buy_today: int = 0
 51:     total_large_sell_today: int = 0
 52:     total_thousand_today: int = 0
 53:     def update_from_flow(self, flow):
 54:         """从 realtime_stock_flow 行更新实时态（DB-first,无外部调用）
 55:         flow: db.models.RealtimeStockFlow 实例
 56:         """
 57:         self.last_price = float(flow.price or 0)
 58:         self.last_pct_chg = float(flow.price_chg or 0)
 59:         # main_force_inflow 库里单位是万元,统一转元保持与下游一致
 60:         mfi = float(flow.main_force_inflow or 0) * 10000
 61:         self.last_main_force_inflow = mfi
 62:         self.last_snapshot_time = flow.snapshot_time
 63:         self.last_source = flow.source or 'db'
 64:         self.last_close = 0.0
 65:         # 基于主力净流入更新大单/主动率（无盘口降级）
 66:         self.record_flow_inflow(mfi)
 67:     def record_flow_inflow(self, main_force_inflow_yuan: float):
 68:         """无盘口环境下,用主力净流入(元)代理大单主动率与方向计数
 69:         - 主动率:主力净流入为正→主动买,负→主动卖,1000万为强信号阈值
 70:         - 方向计数:分钟级,每只每分钟一次
 71:         """
 72:         scale = 10_000_000.0  # 1000万
 73:         ratio = 50.0 + (main_force_inflow_yuan / scale) * 50.0
 74:         self.large_order_active_ratio = round(max(0.0, min(100.0, ratio)), 1)
 75:         if main_force_inflow_yuan > 0:
 76:             self.large_buy_count_3s = 1
 77:             self.large_sell_count_3s = 0
 78:             self.total_large_buy_today += 1
 79:         elif main_force_inflow_yuan < 0:
 80:             self.large_buy_count_3s = 0
 81:             self.large_sell_count_3s = 1
 82:             self.total_large_sell_today += 1
 83:         else:
 84:             self.large_buy_count_3s = 0
 85:             self.large_sell_count_3s = 0
 86:         # 千单频次代理:|主力净流入| >= 1000万 视为有大单活跃
 87:         if abs(main_force_inflow_yuan) >= scale:
 88:             self.thousand_count_1m = 1
 89:             self.total_thousand_today += 1
 90:         else:
 91:             self.thousand_count_1m = 0
 92: # 全局字典（进程级）
 93: REALTIME_STATE: Dict[str, RealtimeState] = {}
 94: # 最近已处理的快照批次时间（去重:避免重复批次重复写库）
 95: _last_processed_snapshot_time = None
 96: def get_or_create_state(ts_code: str) -> RealtimeState:
 97:     if ts_code not in REALTIME_STATE:
 98:         REALTIME_STATE[ts_code] = RealtimeState(ts_code=ts_code)
 99:     return REALTIME_STATE[ts_code]
100: def serialize_state(ts_code: str) -> Optional[dict]:
101:     """序列化单只股票的实时态供 API 返回"""
102:     s = REALTIME_STATE.get(ts_code)
103:     if not s:
104:         return None
105:     pct = s.last_pct_chg
106:     if not pct and s.last_close and s.last_price:
107:         pct = round((s.last_price - s.last_close) / s.last_close * 100, 2)
108:     return {
109:         'current_price': s.last_price,
110:         'pct_chg': pct,
111:         'last_close': s.last_close,
112:         'volume': s.last_volume,
113:         'amount': s.last_amount,
114:         'bid_price_1': s.last_bid_price_1,
115:         'bid_vol_1': s.last_bid_vol_1,
116:         'ask_price_1': s.last_ask_price_1,
117:         'ask_vol_1': s.last_ask_vol_1,
118:         'turnover_rate': s.last_turnover_rate,
119:         'main_force_inflow': s.last_main_force_inflow,
120:         'large_order_active_ratio': s.large_order_active_ratio,
121:         'large_buy_count_3s': s.large_buy_count_3s,
122:         'large_sell_count_3s': s.large_sell_count_3s,
123:         'thousand_order_count_per_min': s.thousand_count_1m,
124:         'total_large_buy_today': s.total_large_buy_today,
125:         'total_large_sell_today': s.total_large_sell_today,
126:         'total_thousand_today': s.total_thousand_today,
127:         'support_level_eval': _evaluate_support(s),
128:         'snapshot_time': s.last_snapshot_time.isoformat() if s.last_snapshot_time else None,
129:         'source': s.last_source,
130:     }
131: def _evaluate_support(s: RealtimeState) -> str:
132:     """基于主力净流入 + 涨跌幅 评价承接力度（无盘口降级）"""
133:     mfi = s.last_main_force_inflow or 0
134:     pct = s.last_pct_chg or 0
135:     if mfi > 0 and pct > 0:
136:         return '🟢 主力净流入 + 上涨，主动买入承接强'
137:     if mfi > 0 and pct <= 0:
138:         return '🟡 主力净流入但价未涨，承接偏强'
139:     if mfi < 0 and pct < 0:
140:         return '🔴 主力净流出 + 下跌，承接弱'
141:     if mfi < 0 and pct >= 0:
142:         return '🟡 主力净流出但价抗跌，承接偏弱'
143:     return '⚪ 中性'
144: # ============================================================
145: # 调度入口：每 5 秒轮询（DB-first,零外部调用）
146: # ============================================================
147: def collect_realtime_snapshot():
148:     """
149:     DB-first 盘中聚合（每 5 秒轮询,scheduled 仅在交易时段触发）:
150:     1. 读 realtime_stock_flow 最新一批快照（由 collect_realtime_stock_flow 每分钟写入）
151:     2. 更新 REALTIME_STATE 内存 dict（供 super_panel 读）
152:     3. 仅当有新快照批次时,落库 stock_realtime_tick（供 V 字反转回溯,保持兼容）
153:     本函数不做任何外部 HTTP 请求。
154:     """
155:     global _last_processed_snapshot_time
156:     from db.session import get_db_session
157:     from db.models import RealtimeStockFlow
158:     from sqlalchemy import func
159:     today = datetime.now().date()
160:     try:
161:         with get_db_session() as db:
162:             latest = db.query(func.max(RealtimeStockFlow.snapshot_time)).filter(
163:                 RealtimeStockFlow.trade_date == today
164:             ).scalar()
165:             if not latest:
166:                 logger.debug('[realtime_aggregator] 暂无实时快照数据（可能非交易时段）')
167:                 return
168:             if _last_processed_snapshot_time and latest <= _last_processed_snapshot_time:
169:                 # 无新批次,跳过（REALTIME_STATE 已是最新）
170:                 return
171:             rows = db.query(RealtimeStockFlow).filter(
172:                 RealtimeStockFlow.trade_date == today,
173:                 RealtimeStockFlow.snapshot_time == latest,
174:             ).all()
175:     except Exception as e:
176:         logger.warning(f'[realtime_aggregator] 读取 realtime_stock_flow 失败: {e}')
177:         return
178:     if not rows:
179:         return
180:     logger.info(f'[realtime_aggregator] 处理 {len(rows)} 只股票 (snapshot={latest})')
181:     # 1) 更新内存态（本地运算,无网络）
182:     for flow in rows:
183:         state = get_or_create_state(flow.ts_code)
184:         state.update_from_flow(flow)
185:     # 2) 新批次:落库 stock_realtime_tick（保持 core.py V 字反转检测兼容）
186:     tick_rows = []
187:     for flow in rows:
188:         mfi = float(flow.main_force_inflow or 0) * 10000
189:         tick_rows.append({
190:             'snapshot_time': flow.snapshot_time,
191:             'trade_date': today,
192:             'ts_code': flow.ts_code,
193:             'price': float(flow.price or 0),
194:             'volume': 0,
195:             'amount': 0,
196:             'bid_price_1': 0,
197:             'bid_vol_1': 0,
198:             'ask_price_1': 0,
199:             'ask_vol_1': 0,
200:             'turnover_rate': 0,
201:             'main_force_inflow': mfi,
202:             'source': 'realtime_stock_flow',
203:         })
204:     if tick_rows:
205:         try:
206:             from db.connection import engine
207:             from sqlalchemy import text
208:             with engine.connect() as conn:
209:                 conn.execute(
210:                     text("""
211:                         INSERT INTO stock_realtime_tick
212:                         (snapshot_time, trade_date, ts_code, price, volume, amount,
213:                          bid_price_1, bid_vol_1, ask_price_1, ask_vol_1,
214:                          turnover_rate, main_force_inflow, source)
215:                         VALUES (:snapshot_time, :trade_date, :ts_code, :price, :volume, :amount,
216:                                 :bid_price_1, :bid_vol_1, :ask_price_1, :ask_vol_1,
217:                                 :turnover_rate, :main_force_inflow, :source)
218:                     """),
219:                     tick_rows
220:                 )
221:                 conn.commit()
222:         except Exception as e:
223:             logger.warning(f'[realtime_aggregator] tick 落库失败: {e}')
224:     _last_processed_snapshot_time = latest
225: # ============================================================
226: # 收盘清理
227: # ============================================================
228: def cleanup_realtime_after_close(retention_days: int = 60):
229:     """收盘后清理实时明细，默认保留 60 个自然日。
230:     这里只处理三个明确的实时明细表，不触碰日线、资金汇总、策略结果
231:     或分析报告；60 天也比原注释中的 30 天更保守，避免误删近期复盘数据。
232:     """
233:     from db.connection import engine
234:     from sqlalchemy import text
235:     cutoff = datetime.now().date() - timedelta(days=retention_days)
236:     with engine.connect() as conn:
237:         counts = {}
238:         for table in ('stock_realtime_orderbook', 'stock_realtime_tick', 'realtime_stock_flow'):
239:             result = conn.execute(text(f"DELETE FROM {table} WHERE trade_date < :cutoff"), {"cutoff": cutoff})
240:             counts[table] = result.rowcount
241:         conn.commit()
242:     logger.info('[realtime_aggregator] cleanup done (cutoff=%s, deleted=%s)', cutoff, counts)
