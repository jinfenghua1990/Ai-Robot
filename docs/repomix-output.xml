  1: /**
  2:  * 策略共振股 20 天跟踪
  3:  *
  4:  * 多策略共振选股入池后，跟踪 20 天。出现 BS S 信号则撤离到历史。
  5:  *
  6:  * 布局：
  7:  * ┌──────────────────────────────────────────────────────────────────┐
  8:  * │ 🎯 策略共振股 20 天跟踪  [入池(今日)][入池(指定日期)][每日更新][刷新]   │
  9:  * │ 跟踪中 N | 已撤离 N | 平均收益 +X% | 胜率 X% | 最大 +X% | 最小 -X%  │
 10:  * ├──────────────────────────────────────────────────────────────────┤
 11:  * │ [跟踪中] [历史]                                                    │
 12:  * ├──────────────────────────────────────────────────────────────────┤
 13:  * │ ┌──────────┐ ┌──────────┐ ┌──────────┐                           │
 14:  * │ │ 股票卡片  │ │ 股票卡片  │ │ 股票卡片  │                           │
 15:  * │ └──────────┘ └──────────┘ └──────────┘                           │
 16:  * └──────────────────────────────────────────────────────────────────┘
 17:  *
 18:  * API:
 19:  *   GET  /api/strategy-track/list?status=active
 20:  *   GET  /api/strategy-track/history?limit=100&offset=0
 21:  *   POST /api/strategy-track/pool?date=YYYY-MM-DD&min_count=2
 22:  *   POST /api/strategy-track/daily-update
 23:  *   POST /api/strategy-track/manual-exit  body: { tracker_id, reason }
 24:  */
 25: import { useState, useEffect, useCallback } from 'react';
 26: import { apiFetch } from '../utils/request';
 27: import { UP_COLOR, DOWN_COLOR, UP_DARK, DOWN_DARK } from '../utils/colors';
 28: import SinaLink from '../components/SinaLink';
 29: import { stripCode } from '../utils/format';
 30: const fmtPct = (v) => {
 31:   if (v == null) return '-';
 32:   const n = Number(v);
 33:   if (n === 0) return '0%';
 34:   if (n > 0) return `+${n.toFixed(2)}%`;
 35:   return `${n.toFixed(2)}%`;
 36: };
 37: const pctColor = (v) => {
 38:   if (v == null) return '#6b7280';
 39:   const n = Number(v);
 40:   if (n >= 5) return UP_DARK;
 41:   if (n >= 0.5) return UP_COLOR;
 42:   if (n <= -5) return DOWN_DARK;
 43:   if (n <= -0.5) return DOWN_COLOR;
 44:   return '#6b7280';
 45: };
 46: // Mini sparkline: 60x20 SVG 折线图 (取最后 20 个 cum_pct 点)
 47: const Sparkline = ({ points }) => {
 48:   if (!points || points.length === 0) return null;
 49:   const pts = points.slice(-20);
 50:   const vals = pts.map((p) => Number(p.cum_pct ?? 0));
 51:   const min = Math.min(...vals, 0);
 52:   const max = Math.max(...vals, 0);
 53:   const range = max - min || 1;
 54:   const W = 60, H = 20, pad = 2;
 55:   const xStep = pts.length > 1 ? (W - pad * 2) / (pts.length - 1) : 0;
 56:   const y = (v) => H - pad - ((v - min) / range) * (H - pad * 2);
 57:   const path = pts
 58:     .map((p, i) => `${i === 0 ? 'M' : 'L'} ${(pad + i * xStep).toFixed(2)} ${y(Number(p.cum_pct ?? 0)).toFixed(2)}`)
 59:     .join(' ');
 60:   const zeroY = y(0);
 61:   const lastVal = vals[vals.length - 1];
 62:   const lineColor = lastVal >= 0 ? UP_COLOR : DOWN_COLOR;
 63:   const lastX = pts.length > 1 ? pad + (pts.length - 1) * xStep : pad;
 64:   return (
 65:     <svg width={W} height={H} style={{ display: 'block' }}>
 66:       <line x1={pad} y1={zeroY} x2={W - pad} y2={zeroY} stroke="#9ca3af" strokeWidth="0.5" strokeDasharray="2 2" />
 67:       <path d={path} fill="none" stroke={lineColor} strokeWidth="1.2" />
 68:       <circle cx={lastX.toFixed(2)} cy={y(lastVal).toFixed(2)} r="1.5" fill={lineColor} />
 69:     </svg>
 70:   );
 71: };
 72: // 撤离原因样式
 73: const exitReasonStyle = (reason) => {
 74:   if (reason === 'BS_S_SIGNAL') return { label: 'BS卖出信号', color: DOWN_COLOR, bg: 'rgba(34,197,94,0.12)', border: 'rgba(34,197,94,0.4)' };
 75:   if (reason === 'MAX_DAYS_REACHED') return { label: '满20天到期', color: '#6b7280', bg: 'rgba(107,114,128,0.12)', border: 'rgba(107,114,128,0.4)' };
 76:   if (reason === 'MANUAL') return { label: '手动撤离', color: '#3b82f6', bg: 'rgba(59,130,246,0.12)', border: 'rgba(59,130,246,0.4)' };
 77:   return { label: reason || '未知', color: '#6b7280', bg: 'rgba(107,114,128,0.12)', border: 'rgba(107,114,128,0.4)' };
 78: };
 79: // BS 信号 badge: B → 持仓中(green), S → 已平仓(red), null → 无信号(gray)
 80: const bsBadgeStyle = (signal) => {
 81:   if (signal === 'B') return { label: 'B 持仓中', color: DOWN_COLOR, bg: 'rgba(34,197,94,0.12)', border: 'rgba(34,197,94,0.4)' };
 82:   if (signal === 'S') return { label: 'S 已平仓', color: UP_COLOR, bg: 'rgba(239,68,68,0.12)', border: 'rgba(239,68,68,0.4)' };
 83:   return { label: '无信号', color: '#6b7280', bg: 'rgba(107,114,128,0.12)', border: 'rgba(107,114,128,0.4)' };
 84: };
