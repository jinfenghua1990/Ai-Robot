 25: // 迷你走势图
 26: function Sparkline({ points, color }) {
 27:   if (!points || points.length < 2) return <span style={{ color: 'var(--text-muted)' }}>—</span>;
 28:   const vals = points.map(p => (typeof p === 'object' ? p.c : p)).filter(v => v != null).map(Number);
 29:   if (vals.length < 2) return <span style={{ color: 'var(--text-muted)' }}>—</span>;
 30:   const min = Math.min(...vals), max = Math.max(...vals);
 31:   const span = max - min || 1;
 32:   const w = 64, h = 20, pad = 2;
 33:   const step = (w - pad * 2) / (vals.length - 1);
 34:   const coords = vals.map((v, i) => {
 35:     const x = pad + i * step;
 36:     const y = pad + (h - pad * 2) * (1 - (v - min) / span);
 37:     return `${x.toFixed(1)},${y.toFixed(1)}`;
 38:   }).join(' ');
 39:   return (
 40:     <svg width={w} height={h} style={{ display: 'block' }}>
 41:       <polyline points={coords} fill="none" stroke={color} strokeWidth="1.2" />
 42:     </svg>
 43:   );
 44: }
