 23: router = APIRouter()
 24: # ============================================================
 25: # 序列化辅助
 26: # ============================================================
 27: def _f(v):
 28:     """Decimal/None → float/None"""
 29:     if v is None:
 30:         return None
 31:     if isinstance(v, Decimal):
 32:         return float(v)
 33:     return v
