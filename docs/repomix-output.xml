 1: from __future__ import annotations
 2: from typing import Mapping
 3: from .contracts import DimensionScore
 4: LIFECYCLE = ("跟随", "关注", "吸筹", "启动", "发酵", "主升", "退潮")
 5: TRADING = ("WATCH", "READY", "TRIGGERED", "HOLD", "NO_CHASE", "INVALID")
 6: def lifecycle_state(dimensions: Mapping[str, DimensionScore]) -> str:
 7:     trend = dimensions.get("trend")
 8:     strength = dimensions.get("strength")
 9:     position = dimensions.get("position")
10:     if not trend or not trend.valid:
11:         return "关注"
12:     if strength and strength.valid and strength.score is not None and strength.score < 35:
13:         return "退潮"
14:     if trend.score is not None and trend.score >= 80 and strength and strength.score is not None and strength.score >= 70:
15:         return "主升"
16:     if trend.score is not None and trend.score >= 65:
17:         return "启动" if not position or position.score is None or position.score >= 45 else "发酵"
18:     return "吸筹"
19: def trading_state(
20:     dimensions: Mapping[str, DimensionScore],
21:     resonance_eligible: bool,
22:     market_state: str = "",
23:     allow_new_positions: bool = True,
24: ) -> str:
25:     risk = dimensions.get("risk")
26:     position = dimensions.get("position")
27:     trend = dimensions.get("trend")
28:     if not all(d and d.valid for d in (risk, position, trend)):
29:         return "INVALID"
30:     if risk.score is not None and risk.score < 40:
31:         return "INVALID"
32:     if not allow_new_positions or market_state == "WEAK":
33:         return "NO_CHASE"
34:     if position.score is not None and position.score >= 85:
35:         return "NO_CHASE"
36:     if resonance_eligible and trend.score is not None and trend.score >= 70:
37:         return "TRIGGERED"
38:     if trend.score is not None and trend.score >= 60:
39:         return "READY"
40:     return "WATCH"
