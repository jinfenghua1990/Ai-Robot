<file path="frontend/src/components/watchlist/GroupBar.jsx">
  1: import { useState, useRef, useEffect } from 'react';
  2: import { apiFetch } from '../../utils/request';
  3: /**
  4:  * 分组管理下拉
  5:  *  - 列出所有分组（带股票数）+ 切换当前激活分组
  6:  *  - 新建 / 重命名 / 删除 / 强制清空
  7:  */
  8: export default function GroupBar({ groups, active, onChange, onRefresh, addLog }) {
  9:   const [open, setOpen] = useState(false);
 10:   const [editing, setEditing] = useState(null); // {oldName, newName}
 11:   const [confirming, setConfirming] = useState(null); // 待删除的分组名
 12:   const ref = useRef(null);
 13:   useEffect(() => {
 14:     const h = (e) => { if (ref.current && !ref.current.contains(e.target)) setOpen(false); };
 15:     document.addEventListener('mousedown', h);
 16:     return () => document.removeEventListener('mousedown', h);
 17:   }, []);
 18:   const create = async (name) => {
 19:     if (!name) return;
 20:     const { ok, error } = await apiFetch('/api/watchlist/groups', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name }) });
 21:     if (ok) { addLog?.('success', `分组「${name}」已创建`); onRefresh(); }
 22:     else { addLog?.('error', error || '创建失败'); }
 23:   };
 24:   const rename = async (oldName, newName) => {
 25:     if (!newName || oldName === newName) return;
 26:     const { ok, error } = await apiFetch('/api/watchlist/groups/rename', { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ old_name: oldName, new_name: newName }) });
 27:     if (ok) { addLog?.('success', `已重命名为「${newName}」`); onChange(newName); onRefresh(); }
 28:     else { addLog?.('error', error || '重命名失败'); }
 29:   };
 30:   const remove = async (name, force = false) => {
 31:     const { ok, error } = await apiFetch(`/api/watchlist/groups/${encodeURIComponent(name)}${force ? '?force=true' : ''}`, { method: 'DELETE' });
 32:     if (ok) { addLog?.('success', `已删除分组「${name}」`); if (active === name) onChange('全部'); onRefresh(); }
 33:     else { addLog?.('error', error || '删除失败'); }
 34:   };
 35:   const activeGroup = groups.find(g => g.name === active);
 36:   const totalCount = groups.reduce((s, g) => s + g.count, 0);
 37:   // "全部"模式时 count 显示总股数；否则显示当前分组股数
 38:   const displayCount = active === '全部' ? totalCount : (activeGroup?.count || 0);
 39:   return (
 40:     <div ref={ref} className="relative">
 41:       <button
 42:         onClick={() => setOpen(!open)}
 43:         className="px-2 py-1 rounded text-[11px] flex items-center gap-1.5 hover:opacity-80"
 44:         style={{ background: 'var(--bg-hover)', border: '1px solid var(--border-color)', color: 'var(--text-primary)' }}
 45:       >
 46:         📂 <span className="font-bold">{active || '全部'}</span>
 47:         <span style={{ color: 'var(--text-muted)' }}>({displayCount})</span>
 48:         <span style={{ color: 'var(--text-muted)' }}>{open ? '▲' : '▼'}</span>
 49:       </button>
 50:       {open && (
 51:         <div className="absolute right-0 top-full mt-1 z-30 rounded-lg shadow-2xl min-w-[260px] p-2"
 52:           style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)' }}>
 53:           {/* 分组列表 */}
 54:           <div className="text-[10px] mb-1 px-1" style={{ color: 'var(--text-muted)' }}>
 55:             共 {groups.length} 个分组 / {totalCount} 只股
 56:           </div>
 57:           <div className="max-h-[200px] overflow-y-auto">
 58:             {/* "全部"虚拟项 — 默认显示所有股票，不按分组过滤 */}
 59:             <div className="flex items-center gap-1 px-1 py-1 rounded hover:bg-white/5">
 60:               <button
 61:                 onClick={() => { onChange('全部'); setOpen(false); }}
 62:                 className="flex-1 text-left text-[11px] px-1"
 63:                 style={{ color: '全部' === active ? '#60a5fa' : 'var(--text-primary)', fontWeight: '全部' === active ? 700 : 400 }}
 64:               >
 65:                 {'全部' === active && '● '}全部 <span style={{ color: 'var(--text-muted)' }}>({totalCount})</span>
 66:               </button>
 67:             </div>
 68:             {groups.map(g => (
 69:               <div key={g.name} className="flex items-center gap-1 px-1 py-1 rounded hover:bg-white/5 group">
 70:                 {editing?.oldName === g.name ? (
 71:                   <input
 72:                     autoFocus
 73:                     defaultValue={g.name}
 74:                     onBlur={(e) => { rename(g.name, e.target.value.trim()); setEditing(null); }}
 75:                     onKeyDown={(e) => { if (e.key === 'Enter') { rename(g.name, e.target.value.trim()); setEditing(null); } if (e.key === 'Escape') setEditing(null); }}
 76:                     className="flex-1 px-1 text-[11px] rounded"
 77:                     style={{ background: 'var(--bg-input)', border: '1px solid var(--border-color)', color: 'var(--text-primary)' }}
 78:                   />
 79:                 ) : (
 80:                   <button
 81:                     onClick={() => { onChange(g.name); setOpen(false); }}
 82:                     className="flex-1 text-left text-[11px] px-1"
 83:                     style={{ color: g.name === active ? '#60a5fa' : 'var(--text-primary)', fontWeight: g.name === active ? 700 : 400 }}
 84:                   >
 85:                     {g.name === active && '● '}{g.name} <span style={{ color: 'var(--text-muted)' }}>({g.count})</span>
 86:                   </button>
 87:                 )}
 88:                 {g.name !== '默认' && editing?.oldName !== g.name && (
 89:                   <div className="hidden group-hover:flex items-center gap-0.5">
 90:                     <button onClick={() => setEditing({ oldName: g.name, newName: g.name })} title="重命名" className="px-1 text-[10px] hover:opacity-70" style={{ color: 'var(--text-muted)' }}>✎</button>
 91:                     <button onClick={() => setConfirming(g.name)} title="删除" className="px-1 text-[10px] hover:opacity-70" style={{ color: '#ef4444' }}>🗑</button>
 92:                   </div>
 93:                 )}
 94:               </div>
 95:             ))}
 96:           </div>
 97:           {/* 新建分组 */}
 98:           <NewGroupInput onCreate={(n) => { create(n); }} />
 99:           {/* 删除确认 */}
100:           {confirming && (
101:             <div className="mt-2 p-2 rounded text-[11px]" style={{ background: 'rgba(239,68,68,0.1)', border: '1px solid #ef4444' }}>
102:               <div style={{ color: '#ef4444' }}>删除分组「{confirming}」？</div>
103:               <div className="flex gap-1 mt-1">
104:                 <button onClick={() => { remove(confirming, true); setConfirming(null); }} className="px-2 py-0.5 rounded text-[10px]" style={{ background: '#ef4444', color: '#fff' }}>移到默认组</button>
105:                 <button onClick={() => setConfirming(null)} className="px-2 py-0.5 rounded text-[10px]" style={{ background: 'var(--bg-hover)', color: 'var(--text-primary)' }}>取消</button>
106:               </div>
107:             </div>
108:           )}
109:         </div>
110:       )}
111:     </div>
112:   );
113: }
114: function NewGroupInput({ onCreate }) {
115:   const [show, setShow] = useState(false);
