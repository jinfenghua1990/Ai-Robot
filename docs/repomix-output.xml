  1: """
  2: 调度器状态 API（只读，便于确认"每日网上数据入库"定时器是否在工作）
  3: - GET /api/scheduler/jobs           列出所有定时任务 + 下次运行时间 + 进程存活
  4: - GET /api/scheduler/research-status  今日研究采集落库条数（证明 19:30 定时器已执行）
  5: """
  6: import time
  7: import logging
  8: from datetime import datetime, date
  9: from fastapi import APIRouter
 10: from sqlalchemy import text
 11: from collectors.scheduler import scheduler
 12: from db.session import get_db_session
 13: from db.models import StockNewsSearch, StockDataQuery, AIAnalysisCache
 14: logger = logging.getLogger(__name__)
 15: router = APIRouter(prefix="/api/scheduler", tags=["scheduler"])
 16: # 进程启动时刻（用于 uptime 展示）
 17: START_TIME = time.time()
 18: # 与"每日网上数据 → 本地库"最相关的定时任务（其余是实时/盘中任务，列表里折叠展示）
 19: _DAILY_ETL_FOCUS = {
 20:     "research_collection",   # 19:30 妙想资讯+数据+AI基线 → stock_news_search/stock_data_query/ai_analysis_cache
 21:     "daily_report",          # 20:00 综合日报 HTML 生成
 22:     "archive",               # 15:05 收盘归档 → sector_flow/stock_flow
 23:     "analyze",               # 15:30 盘后分析
 24:     "dragon_tiger_evening",  # 18:05 龙虎榜（Tushare 18:00 发布数据，18:05 首次采，18:30 兜底）
 25:     "moneyflow_detail",      # 17:30 四档资金流
 26: }
 27: @router.get("/jobs")
 28: def list_jobs():
 29:     """列出所有已注册的定时任务及下次触发时间"""
 30:     jobs = []
 31:     for j in scheduler.get_jobs():
 32:         jobs.append({
 33:             "id": j.id,
 34:             "trigger": str(j.trigger),
 35:             "next_run": j.next_run_time.isoformat() if j.next_run_time else None,
 36:         })
 37:     daily = [j for j in jobs if j["id"] in _DAILY_ETL_FOCUS]
 38:     return {
 39:         "scheduler_running": scheduler.running,
 40:         "uptime_seconds": int(time.time() - START_TIME),
 41:         "job_count": len(jobs),
 42:         "daily_etl_jobs": daily,
 43:         "all_jobs": jobs,
 44:     }
 45: @router.get("/research-status")
 46: def research_status():
 47:     """今日研究采集落库情况——三项均 >0 即表示当日 19:30 定时器已成功执行"""
 48:     today = date.today()
 49:     today_start = datetime(today.year, today.month, today.day)
 50:     with get_db_session() as db:
 51:         news = db.query(StockNewsSearch).filter(
 52:             StockNewsSearch.created_at >= today_start).count()
 53:         data = db.query(StockDataQuery).filter(
 54:             StockDataQuery.query_time >= today_start).count()
 55:         ai = db.query(AIAnalysisCache).filter(
 56:             AIAnalysisCache.created_at >= today_start).count()
 57:     return {
 58:         "date": today.isoformat(),
 59:         "stock_news_search_today": news,
 60:         "stock_data_query_today": data,
 61:         "ai_analysis_cache_today": ai,
 62:         "note": "三项均 >0 表示当日 19:30 研究采集定时器已成功执行并落库",
 63:     }
 64: @router.get("/freshness")
 65: def data_freshness():
 66:     """全表数据新鲜度看板：每张关键表的最新数据日期 + 是否落后于最新交易日。
 67:     返回 reference_market_day（以 stock_flow 最大交易日为基准）与每个表的
 68:     latest / gap_days / fresh。gap_days>0 即表示数据滞后，可一眼看出哪里卡住
 69:     （例如此前 concept_sector_flow 卡在 07-06 即会被暴露）。
 70:     """
 71:     # (表名, 日期列) —— 均为硬编码常量，非用户输入，可安全拼接到 SQL
 72:     targets = [
 73:         ("sector_flow", "trade_date"),
 74:         ("stock_flow", "trade_date"),
 75:         ("concept_sector_flow", "trade_date"),
 76:         ("leader_lifecycle", "trade_date"),
 77:         ("watchlist_signal_daily", "trade_date"),
 78:         ("trading_signal_daily", "trade_date"),
 79:         ("stock_daily_kline", "trade_date"),
 80:         ("stock_news_search", "created_at"),
 81:         ("stock_data_query", "query_time"),
 82:         ("ai_analysis_cache", "created_at"),
 83:         ("realtime_concept_sector_flow", "snapshot_time"),
 84:     ]
 85:     # 白名单校验，防止未来配置被篡改时 SQL 注入
 86:     _ALLOWED_TABLES = {t for t, _ in targets}
 87:     _ALLOWED_COLS = {c for _, c in targets}
 88:     with get_db_session() as db:
 89:         ref = db.execute(text("SELECT max(trade_date) FROM stock_flow")).scalar()
 90:         rows = []
 91:         for tbl, col in targets:
 92:             try:
 93:                 if tbl not in _ALLOWED_TABLES or col not in _ALLOWED_COLS:
 94:                     raise ValueError(f"table/column not in whitelist: {tbl}.{col}")
 95:                 d = db.execute(text(f"SELECT max({col})::date FROM {tbl}")).scalar()
 96:             except Exception as e:
 97:                 rows.append({"table": tbl, "latest": None, "gap_days": None,
 98:                              "fresh": False, "error": str(e)[:120]})
 99:                 continue
100:             gap = (ref - d).days if (ref and d) else None
101:             rows.append({
102:                 "table": tbl,
103:                 "latest": d.isoformat() if d else None,
104:                 "gap_days": gap,
105:                 "fresh": bool(gap is not None and gap <= 0),
106:             })
107:     return {
108:         "reference_market_day": ref.isoformat() if ref else None,
109:         "tables": rows,
110:         "stale_count": sum(1 for r in rows if r.get("gap_days") and r["gap_days"] > 0),
111:     }
