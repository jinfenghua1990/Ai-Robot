<file path="backend/collectors/lifecycle_tracker.py">
  1: """
  2: 游资 7 天生命周期跟踪中转调度器 (main_tracker.py)
  3: 数据流：
  4: 1) trigger_d1() - 找出 yuzi_quant_signals 当日共振数≥2 且 净买>0 的信号,
  5:                    INSERT 到 yuzi_lifecycle_tracker (D1 触发记录)
  6: 2) update_lifecycle(target_date) - 对所有 trigger_date >= today-30 的股票,
  7:                     拉 Tushare daily 算 day_diff (1-20),
  8:                     组装 7 维度状态 → UPDATE lifecycle_data JSONB
  9: 3) finalize_outcome() - 对已填到 Day 20+ 的,计算 final_outcome + net_return_20d
 10: CLI:
 11:     python lifecycle_tracker.py d1 --date 20260703   # 手动补 D1
 12:     python lifecycle_tracker.py update --date 20260704  # 补某日 D2-D20
 13:     python lifecycle_tracker.py run --date 20260704     # d1 + update 一条龙
 14: """
 15: import json
 16: import logging
 17: import time
 18: import argparse
 19: from datetime import datetime, timedelta
 20: from typing import Optional, Dict, List
 21: from sqlalchemy import desc
 22: from db.connection import engine
 23: from db.session import get_db_session
 24: from db.models import (
 25:     YuziQuantSignal, YuziLifecycleTracker, YuziSeatDaily,
 26:     StockDailyKline, StockFlow,
 27: )
 28: logger = logging.getLogger(__name__)
 29: # ============================================================
 30: # D1 触发器
 31: # ============================================================
 32: def trigger_d1(trade_date: str) -> int:
 33:     """
 34:     把 trade_date 当日触发 D1 条件的共振股写入 tracker 表
 35:     D1 触发条件（与 yuzi_quant_signals 一致）：
 36:         - resonance_count >= 1   (放宽:至少1位游资共振)
 37:         - total_net_buy > 0
 38:         - quant_score >= 60      (放宽:中等置信度起步)
 39:     Returns: 新增行数
 40:     """
 41:     inserted = 0
 42:     with get_db_session() as db:
 43:         # 1) 找当日触发股 (排除 ST/*ST 股票)
 44:         rows = db.query(YuziQuantSignal).filter(
 45:             YuziQuantSignal.trade_date == trade_date,
 46:             YuziQuantSignal.resonance_count >= 1,
 47:             YuziQuantSignal.total_net_buy > 0,
 48:             YuziQuantSignal.quant_score >= 60,
 49:             ~YuziQuantSignal.stock_name.like('%ST%'),
 50:         ).all()
 51:         for r in rows:
 52:             # 2) 跳过已存在
 53:             exists = db.query(YuziLifecycleTracker).filter(
 54:                 YuziLifecycleTracker.trigger_date == trade_date,
 55:                 YuziLifecycleTracker.ts_code == r.ts_code,
 56:             ).first()
 57:             if exists:
 58:                 continue
 59:             # 3) INSERT
 60:             db.add(YuziLifecycleTracker(
 61:                 trigger_date=trade_date,
 62:                 ts_code=r.ts_code,
 63:                 stock_name=r.stock_name or '',
 64:                 quant_score_d1=r.quant_score,
 65:                 boss_list_d1=r.boss_list or '',
 66:                 resonance_count_d1=r.resonance_count,
 67:                 lifecycle_data=json.dumps({}, ensure_ascii=False),
 68:                 day_filled=1,
 69:                 final_outcome='未结束',
 70:             ))
 71:             inserted += 1
 72:         db.commit()
 73:     logger.info(f'[trigger_d1] {trade_date} inserted={inserted}')
 74:     return inserted
 75: # ============================================================
 76: # D2-D7 增量更新
 77: # ============================================================
 78: def _tushare_daily(ts_code: str, trade_date: str) -> Optional[dict]:
 79:     """调 Tushare 拉日线"""
 80:     from collectors.tdx_collector import call_tushare_mcp
 81:     rows = call_tushare_mcp(
 82:         api_name='daily',
 83:         params={'ts_code': ts_code, 'trade_date': trade_date},
 84:         fields=['ts_code', 'trade_date', 'open', 'high', 'low', 'close',
 85:                 'pre_close', 'change', 'pct_chg', 'vol', 'amount', 'turnover_rate'],
 86:     )
 87:     if rows:
 88:         return rows[0]
 89:     return None
 90: def _tushare_top_list_for_stock(ts_code: str, trade_date: str) -> Optional[dict]:
 91:     """看某股某日是否上龙虎榜(用于 capital_retention 判断)"""
 92:     from collectors.tdx_collector import call_tushare_mcp
 93:     rows = call_tushare_mcp(
 94:         api_name='top_list',
 95:         params={'ts_code': ts_code, 'trade_date': trade_date},
 96:         fields=['ts_code', 'net_amount', 'net_rate', 'reason'],
 97:     )
 98:     if rows:
 99:         return rows[0]
100:     return None
101: def _read_daily_kline(ts_code: str, trade_date: str) -> Optional[dict]:
102:     """从中转层 stock_daily_kline 读日线数据（不再实时调 Tushare）"""
103:     with get_db_session() as db:
104:         d_str = f'{trade_date[:4]}-{trade_date[4:6]}-{trade_date[6:8]}'
105:         row = db.query(StockDailyKline).filter(
106:             StockDailyKline.ts_code == ts_code,
107:             StockDailyKline.trade_date == d_str,
108:         ).first()
109:         if not row:
110:             return None
111:         close = float(row.close or 0)
112:         pct_chg = float(row.pct_chg or 0)
113:         # pre_close 反推: close = pre_close * (1 + pct_chg/100)
114:         pre_close = close / (1 + pct_chg / 100) if pct_chg != 0 else close
115:         return {
116:             'open': float(row.open or 0),
117:             'high': float(row.high or 0),
118:             'low': float(row.low or 0),
119:             'close': close,
120:             'pre_close': pre_close,
121:             'pct_chg': pct_chg,
122:         }
123: def _read_top_list(ts_code: str, trade_date: str) -> Optional[dict]:
124:     """从中转层 yuzi_seat_daily 读当日席位净额(替代 Tushare top_list)"""
125:     with get_db_session() as db:
126:         rows = db.query(YuziSeatDaily).filter(
127:             YuziSeatDaily.ts_code == ts_code,
128:             YuziSeatDaily.trade_date == trade_date,
129:         ).all()
130:         if not rows:
131:             return None
132:         return {
133:             'net_amount': sum(float(r.net_amount or 0) for r in rows) * 10000.0,  # 万→元
134:         }
135: def _trading_day_diff(trigger_dt: datetime, target_dt: datetime) -> int:
136:     """
137:     算两个日期之间的"交易日序号"差(跳过周末)
138:     - d1 = trigger_dt 本身
139:     - 例: 6-25(四)→6-29(一) = 3 个交易日 (跳过 6-27/28 周末)
140:     """
141:     if target_dt < trigger_dt:
142:         return 0
143:     cur = trigger_dt
144:     count = 0
145:     while cur <= target_dt:
146:         if cur.weekday() < 5:  # 周一到周五
147:             count += 1
148:         cur += timedelta(days=1)
149:     return count
150: def _classify_price_stage(pct_chg: float, open_premium: float) -> str:
151:     """价格状态分类"""
152:     if pct_chg >= 9.8:
153:         return '连板'
154:     if pct_chg <= -9.8:
155:         return '跌停A杀'
156:     if open_premium >= 3.0 and pct_chg >= 5.0:
157:         return '晋级'   # 竞价强 + 大涨
158:     if open_premium <= -3.0 and pct_chg <= -3.0:
159:         return '分歧'   # 竞价弱 + 收跌
160:     if abs(pct_chg) < 1.5:
161:         return '震荡'
162:     if pct_chg > 0:
163:         return '偏多'
164:     return '偏空'
165: def _classify_capital_retention(yesterday_seat_net: float, today_seat_net: float) -> str:
166:     """资金留存判断(简化版,基于龙虎榜席位净买变化)"""
167:     if yesterday_seat_net is None or today_seat_net is None:
168:         return '无数据'
169:     if today_seat_net > 0 and today_seat_net >= yesterday_seat_net * 0.7:
170:         return '锁仓'
171:     if today_seat_net > 0 and today_seat_net < yesterday_seat_net * 0.7:
172:         return '减仓'
173:     if today_seat_net < 0:
174:         return '出货'
175:     return '无数据'
176: def _classify_support(open_premium: float, intra_amp: float, pct_chg: float) -> str:
177:     """承接力度(竞价+振幅+收涨)"""
178:     if open_premium >= 2.0 and pct_chg > 0:
179:         return '强'
180:     if open_premium <= -2.0 and pct_chg < 0:
181:         return '弱'
182:     if intra_amp > 12:
183:         return '弱'  # 振幅大+没方向 = 承接混乱
184:     return '中'
185: def _compute_day_metrics(ts_code: str, trade_date: str, yesterday_seat_net: Optional[float]) -> Optional[dict]:
186:     """组装 7 维度:全部从 DB 中转层读"""
187:     daily = _read_daily_kline(ts_code, trade_date)
188:     if not daily:
189:         return None
190:     open_p = daily['open']
191:     high_p = daily['high']
192:     low_p = daily['low']
193:     pre_close = daily['pre_close']
194:     pct_chg = daily['pct_chg']
195:     # 从 stock_flow 读资金数据
196:     with get_db_session() as db:
197:         sf = db.query(StockFlow).filter(
198:             StockFlow.ts_code == ts_code,
199:             StockFlow.trade_date == trade_date,
200:         ).first()
201:         main_force = float(sf.main_force_inflow or 0) if sf else 0  # 主力净流入(万)
202:         net_inflow = float(sf.net_inflow or 0) if sf else 0  # 总净流入(万)
203:         retail_flow = float(sf.retail_flow or 0) if sf else 0  # 散户净流入(万)
204:     open_premium = (open_p / pre_close - 1) * 100 if pre_close > 0 else 0
205:     intra_amp = (high_p - low_p) / pre_close * 100 if pre_close > 0 else 0
206:     price_stage = _classify_price_stage(pct_chg, open_premium)
207:     # 资金留存:从 yuzi_seat_daily 读当日席位净额
208:     top = _read_top_list(ts_code, trade_date)
209:     today_seat_net = top['net_amount'] / 10000.0 if top else None  # 元→万
210:     capital_retention = _classify_capital_retention(yesterday_seat_net, today_seat_net or 0)
211:     support = _classify_support(open_premium, intra_amp, pct_chg)
212:     # 主力主导度 = |主力| / (|主力| + |散户|), 0-100 之间
213:     total_abs = abs(main_force) + abs(retail_flow)
214:     main_force_ratio = round(abs(main_force) / total_abs * 100, 0) if total_abs > 0 else 0
215:     return {
216:         'price_stage': price_stage,
217:         'open_premium': round(open_premium, 2),
218:         'intra_amplitude': round(intra_amp, 2),
219:         'pct_chg': round(pct_chg, 2),
220:         'main_force_inflow': round(main_force, 0),
221:         'net_inflow': round(net_inflow, 0),
222:         'retail_flow': round(retail_flow, 0),
223:         'main_force_ratio': main_force_ratio,
224:         'capital_retention': capital_retention,
225:         'support_level': support,
226:         'win_rate_impact': round(pct_chg, 2),
227:     }
228: def update_lifecycle(target_date: str) -> Dict:
229:     """
230:     增量更新 target_date 当天所有 tracker 记录的 Day X
231:     Returns: {date, updated, skipped, finalized}
232:     """
233:     target_dt = datetime.strptime(target_date, '%Y%m%d')
234:     # 拉 30 天内的 active tracker, 覆盖 20 个交易日
235:     cutoff = (target_dt - timedelta(days=30)).strftime('%Y%m%d')
236:     updated, skipped, finalized = 0, 0, 0
237:     with get_db_session() as db:
238:         active = db.query(YuziLifecycleTracker).filter(
239:             YuziLifecycleTracker.trigger_date >= cutoff,
240:             YuziLifecycleTracker.trigger_date <= target_date,
241:         ).all()
242:         for tracker in active:
243:             trigger_dt = datetime.strptime(tracker.trigger_date, '%Y%m%d')
244:             # 按交易日算 day_diff: 跳过 trigger_dt..target_dt 之间的周末
245:             # 例: 6-25(周四)→6-29(周一), 日历差=5, 交易日差=3 (d3)
246:             day_diff = _trading_day_diff(trigger_dt, target_dt)
247:             if day_diff < 1 or day_diff > 20:
248:                 skipped += 1
249:                 continue
250:             day_key = f'd{day_diff}'
251:             # 解析已有 lifecycle_data
252:             try:
253:                 lifecycle = json.loads(tracker.lifecycle_data or '{}')
254:             except (ValueError, TypeError):
255:                 lifecycle = {}
256:             # 以实际数据是否存在为准，防御 day_filled 与实际数据不一致（如 trigger_d1 时 day_filled=1 但 lifecycle_data 为空）
257:             if day_key in lifecycle:
258:                 skipped += 1
259:                 continue
260:             # 算 D-1 的大佬净买(用于 capital_retention)
261:             d_prev = f'd{day_diff - 1}'
262:             yesterday_seat_net = None
263:             if d_prev in lifecycle and 'capital_retention' in lifecycle[d_prev]:
264:                 # 上一日的席位净买我们没存,简化:从 yuzi_seat_daily 取
265:                 prev_date = (target_dt - timedelta(days=1)).strftime('%Y%m%d')
266:                 prev_seat = db.query(YuziSeatDaily).filter(
267:                     YuziSeatDaily.ts_code == tracker.ts_code,
268:                     YuziSeatDaily.trade_date == prev_date,
269:                 ).all()
270:                 if prev_seat:
271:                     yesterday_seat_net = sum(float(s.net_amount or 0) for s in prev_seat)
272:             metrics = _compute_day_metrics(tracker.ts_code, target_date, yesterday_seat_net)
273:             if not metrics:
274:                 skipped += 1
275:                 continue
276:             metrics['date'] = target_date  # YYYYMMDD, 前端表头展示用
277:             lifecycle[day_key] = metrics
278:             tracker.lifecycle_data = json.dumps(lifecycle, ensure_ascii=False)
279:             tracker.day_filled = max(tracker.day_filled or 1, day_diff)
280:             # Day 20 当天:算 final_outcome
281:             if day_diff >= 20:
282:                 # 算 20d 最大可实现收益
283:                 # = (Day 1 开盘 → Day 20 最高价) / Day 1 开盘
284:                 # 取 20 天内的累计 pct_chg + 单日最大涨幅
285:                 total_pct = 0.0
286:                 for k in [f'd{i}' for i in range(1, 21)]:
287:                     if k in lifecycle:
288:                         total_pct += float(lifecycle[k].get('win_rate_impact', 0) or 0)
289:                 # 取 20 天内的单日最大涨幅 + 累计(更接近实际可实现)
290:                 max_single = max((float(lifecycle[k].get('win_rate_impact', 0) or 0) for k in lifecycle), default=0)
291:                 net_return = round(max(max_single, total_pct), 2)
292:                 # 结局分类(20d 阈值与 7d 不同:大妖/A 杀门槛放宽)
293:                 if net_return >= 30:
294:                     outcome = '大妖股'
295:                 elif net_return <= -20:
296:                     outcome = 'A杀退潮'
297:                 elif 8 <= net_return < 30:
298:                     outcome = '高位震荡'
299:                 elif -8 <= net_return < 8:
300:                     outcome = '横盘'
301:                 else:  # -20 ~ -8
302:                     outcome = '弱势回调'
303:                 tracker.final_outcome = outcome
304:                 tracker.net_return_20d = net_return
305:                 finalized += 1
306:             updated += 1
307:             time.sleep(0.15)  # Tushare 限流
308:         db.commit()
309:     logger.info(f'[update_lifecycle] {target_date} updated={updated} skipped={skipped} finalized={finalized}')
310:     return {'date': target_date, 'updated': updated, 'skipped': skipped, 'finalized': finalized}
311: def run_all(target_date: str) -> Dict:
312:     """一站式: D1 触发 + D2-D7 更新"""
313:     d1_n = trigger_d1(target_date)
314:     upd = update_lifecycle(target_date)
315:     return {'date': target_date, 'd1_inserted': d1_n, **upd}
316: def list_active_tasks(days_back: int = 30) -> List[dict]:
317:     """列出所有正在跟踪周期的任务(30 天窗口, 覆盖 20 个交易日)"""
318:     with get_db_session() as db:
319:         cutoff = (datetime.now() - timedelta(days=days_back)).strftime('%Y%m%d')
320:         rows = db.query(YuziLifecycleTracker).filter(
321:             YuziLifecycleTracker.trigger_date >= cutoff,
322:         ).order_by(desc(YuziLifecycleTracker.trigger_date)).all()
323:         return [{
324:             'id': r.id,
325:             'trigger_date': r.trigger_date,
326:             'ts_code': r.ts_code,
327:             'stock_name': r.stock_name,
328:             'quant_score_d1': float(r.quant_score_d1 or 0),
329:             'day_filled': r.day_filled,
330:             'final_outcome': r.final_outcome,
331:             'net_return_20d': float(r.net_return_20d or 0),
332:         } for r in rows]
333: def backfill_history(start_date: str, end_date: str) -> List[dict]:
334:     """
335:     历史回填 D1（用于冷启动）：
336:     对区间内每一天,跑 trigger_d1 + update_lifecycle
337:     关键:每个 trigger_date 需要 20 个交易日的 update_lifecycle 跟进,
338:     才能把 D1-D20 全部填满.因此实际跑的范围需要扩展到 end_date + 25.
339:     """
340:     sd = datetime.strptime(start_date, '%Y%m%d')
341:     ed = datetime.strptime(end_date, '%Y%m%d')
342:     if sd > ed:
343:         sd, ed = ed, sd
344:     # 扩展到 end + 25 天,确保 end_date 当天触发的股也能填到 D20
345:     end_extended = ed + timedelta(days=25)
346:     # 先清空旧数据,避免重复
347:     with get_db_session() as db:
348:         deleted = db.query(YuziLifecycleTracker).filter(
349:             YuziLifecycleTracker.trigger_date >= start_date,
350:             YuziLifecycleTracker.trigger_date <= end_date,
351:         ).delete(synchronize_session=False)
352:         db.commit()
353:         logger.info(f'[backfill] 清空旧数据 {deleted} 条')
354:     results = []
355:     cur = sd
356:     while cur <= end_extended:
357:         d = cur.strftime('%Y%m%d')
358:         try:
359:             r = run_all(d)
360:             results.append(r)
361:         except Exception as e:
362:             logger.error(f'[{d}] backfill error: {e}', exc_info=True)
363:             results.append({'date': d, 'error': str(e)})
364:         cur += timedelta(days=1)
365:     return results
366: # ============================================================
367: # CLI
368: # ============================================================
369: if __name__ == '__main__':
370:     parser = argparse.ArgumentParser(description='游资 7 天生命周期跟踪调度器')
371:     sub = parser.add_subparsers(dest='cmd')
372:     p1 = sub.add_parser('d1', help='触发 D1 记录')
373:     p1.add_argument('--date', required=True)
374:     p2 = sub.add_parser('update', help='更新 D2-D7 状态')
375:     p2.add_argument('--date', required=True)
376:     p3 = sub.add_parser('run', help='D1+Update 一条龙')
377:     p3.add_argument('--date', required=True)
378:     p4 = sub.add_parser('backfill', help='历史回填')
379:     p4.add_argument('--start', required=True)
380:     p4.add_argument('--end', required=True)
381:     p5 = sub.add_parser('list', help='列出活跃任务')
382:     p5.add_argument('--days', type=int, default=10)
383:     args = parser.parse_args()
384:     logging.basicConfig(level=logging.INFO, format='%(asctime)s [%(levelname)s] %(message)s')
385:     if args.cmd == 'd1':
386:         n = trigger_d1(args.date)
387:         print(f'插入 D1 触发: {n} 条')
388:     elif args.cmd == 'update':
389:         r = update_lifecycle(args.date)
390:         print(r)
391:     elif args.cmd == 'run':
392:         r = run_all(args.date)
393:         print(r)
394:     elif args.cmd == 'backfill':
395:         rs = backfill_history(args.start, args.end)
396:         for r in rs:
397:             print(r)
398:     elif args.cmd == 'list':
399:         tasks = list_active_tasks(args.days)
400:         for t in tasks:
401:             print(t)
402:     else:
403:         parser.print_help()
</file>

<file path="backend/collectors/realtime_stock_collector.py">
  1: """
  2: 实时个股资金流向采集器（多源+交叉验证）
  3: 额度优化策略：
  4: - 东方财富datacenter：全市场批量（1次API，有额度限制但批量高效）
  5: - 东财push2 + 新浪财经：Top20资金流向验证（无额度限制）
  6: - 国信证券：Top10资金流向验证（有额度限制，减少使用）
  7: - 腾讯财经：Top50价格验证（无额度限制）
