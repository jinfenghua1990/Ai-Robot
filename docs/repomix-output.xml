442:     """从 AkShare 拉取东方财富概念板块及成分股"""
443:     try:
444:         import akshare as ak
445:     except ImportError:
446:         logger.warning('[sync_concept_sectors] akshare not installed')
447:         return {}
448:     concepts = {}
449:     try:
