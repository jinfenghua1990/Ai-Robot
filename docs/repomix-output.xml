366:                     <td className="px-1.5 py-1.5 text-right font-medium" style={{ color: it.rsi >= 70 ? DOWN_DARK : it.rsi <= 30 ? UP_DARK : 'var(--text-secondary)' }}>{fmtNum(it.rsi, 0)}</td>
