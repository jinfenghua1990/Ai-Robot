214: 
215: 在 `_hit_support` 函数之后、`_gen_action_hint` 之前插入：
216: 
217: ```python
218: def _hit_accumulation(db, ts_codes: list) -> set:
219:     """🧲 吸筹命中：最近两期股东户数连续减少 + 户均持股增加"""
220:     from db.models import StockHolderNumber
221:     if not ts_codes:
222:         return set()
223:     # 取每只股最近两期（按公告日期倒序）
224:     from sqlalchemy import Row, func
225:     sub = db.query(
226:         StockHolderNumber.ts_code,
227:         func.max(StockHolderNumber.ann_date).label('latest_date')
228:     ).filter(StockHolderNumber.ts_code.in_(ts_codes)).group_by(StockHolderNumber.ts_code).subquery()
229:     latest_rows = db.query(StockHolderNumber).join(
230:         sub,
231:         (StockHolderNumber.ts_code == sub.c.ts_code) &
232:         (StockHolderNumber.ann_date == sub.c.latest_date)
233:     ).all()
234:     if not latest_rows:
235:         return set()
236:     prev_dates = db.query(
237:         StockHolderNumber.ts_code,
238:         func.max(StockHolderNumber.ann_date).label('prev_date')
239:     ).filter(
240:         StockHolderNumber.ts_code.in_(ts_codes),
241:         StockHolderNumber.ann_date < sub.c.latest_date
242:     ).group_by(StockHolderNumber.ts_code).subquery()
243:     prev_rows = db.query(StockHolderNumber).join(
244:         prev_dates,
245:         (StockHolderNumber.ts_code == prev_dates.c.ts_code) &
246:         (StockHolderNumber.ann_date == prev_dates.c.prev_date)
247:     ).all()
248:     prev_map = {r.ts_code: r for r in prev_rows}
249:     hit = set()
250:     for cur in latest_rows:
251:         prev = prev_map.get(cur.ts_code)
252:         if not prev:
253:             continue
254:         if (cur.holder_num or 0) > 0 and (prev.holder_num or 0) > 0 \
255:                 and cur.holder_num < prev.holder_num \
256:                 and (cur.avg_shares or 0) > (prev.avg_shares or 0):
257:             hit.add(cur.ts_code)
258:     return hit
259: ```
