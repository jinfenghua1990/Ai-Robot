318:         <div className="rounded-xl border overflow-hidden" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)' }}>
319:           <div className="overflow-x-auto no-scrollbar">
320:             <table className="w-full text-[11px]" style={{ borderCollapse: 'collapse', minWidth: 1080 }}>
321:               <thead>
322:                 <tr style={{ background: 'var(--bg-secondary)' }}>
