178: def _passes_research_filters(item: dict) -> bool:
179:     """判断是否通过研究池硬门槛"""
180:     price = _numf(item.get("price"))
181:     mcap = _numf(item.get("market_cap"))
182:     turnover = _numf(item.get("turnover"))
183:     symbol = str(item.get("symbol", ""))
184:     # 排除明显非普通股
185:     if len(symbol) > 5 and not symbol.replace(".", "").isalpha():
186:         return False
187:     # 排除 ETF 关键词（简单过滤）
188:     name = str(item.get("name", "")).upper()
189:     etf_keywords = ["ETF", "TRUST", "FUND", "NOTE", "BEAR", "BULL"]
190:     if any(kw in name for kw in etf_keywords):
191:         return False
192:     if price is not None and price < RESEARCH_CONFIG["min_price"]:
193:         return False
194:     if mcap is not None and mcap < RESEARCH_CONFIG["min_market_cap"]:
195:         return False
196:     if turnover is not None and turnover < RESEARCH_CONFIG["min_avg_dollar_volume"]:
197:         return False
198:     return True
199: def _score_core_a(item: dict) -> float:
200:     """Core A 排名评分（总分 100）"""
201:     score = 0.0
202:     turnover = _numf(item.get("turnover")) or 0
203:     mcap = _numf(item.get("market_cap")) or 0
204:     price = _numf(item.get("price")) or 0
205:     # 20日平均成交额排名（25分）
206:     if turnover > 0:
207:         score += 25 * min(turnover / 1_000_000_000, 1.0)  # 10亿成交额得满分
208:     # 市值及机构参与度（10分）
209:     if mcap > 0:
210:         score += 10 * min(mcap / 500_000_000_000, 1.0)  # 5000亿市值得满分
211:     # 价格适合度（10分）
212:     if 20 <= price <= 500:
213:         score += 10
214:     elif price >= 10:
215:         score += 6
216:     elif price >= 5:
217:         score += 3
218:     # 波动率适合度（10分）- 默认给中等分
219:     score += 6
220:     return score
221: def _score_core_b(item: dict) -> float:
222:     """Core B 排名评分（总分 100）"""
223:     score = 0.0
224:     turnover = _numf(item.get("turnover")) or 0
225:     mcap = _numf(item.get("market_cap")) or 0
226:     price = _numf(item.get("price")) or 0
227:     # 20日平均成交额（20分）
228:     if turnover > 0:
229:         score += 20 * min(turnover / 500_000_000, 1.0)
230:     # 市值（10分）
231:     if mcap > 0:
232:         score += 10 * min(mcap / 100_000_000_000, 1.0)
233:     # 价格适合度（10分）
234:     if 15 <= price <= 300:
235:         score += 10
236:     elif price >= 7:
237:         score += 5
238:     # 趋势质量（10分）
239:     score += 5
240:     return score
