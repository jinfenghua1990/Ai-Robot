266: def _calculate_quality_score(sources_count, outliers_count, cv, confidence):
267:     """计算质量评分（0-100）"""
268:     # 完整性（30分）：数据源数量
269:     completeness = min(30, sources_count * 7.5)
270:     # 一致性（40分）：变异系数越小越好
271:     consistency = max(0, 40 - cv * 2)
272:     # 可靠性（30分）：异常源越少越好
273:     if sources_count > 0:
274:         reliability = 30 * (1 - outliers_count / sources_count)
275:     else:
276:         reliability = 0
277:     score = completeness + consistency + reliability
278:     # 置信度加成
279:     if confidence == 'high':
280:         score = min(100, score + 5)
281:     elif confidence == 'disputed':
282:         score = max(0, score - 15)
283:     return score
