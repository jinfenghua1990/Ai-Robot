14: export default function SystemCheckBanner() {
15:   const [issues, setIssues] = useState([]);
16:   const [dismissed, setDismissed] = useState(false);
17:   const [checked, setChecked] = useState(false);
18:   const navigate = useNavigate();
19:   const hadIssues = useRef(false);
20:   useEffect(() => {
21:     let alive = true;
22:     const load = async () => {
23:       const { ok, data } = await apiFetch('/api/services/status');
24:       if (!alive || !ok || !data || !Array.isArray(data.services)) return;
25:       const next = computeIssues(data.services);
26:       // 问题清空时重置「已忽略」状态，便于下次再出现时重新提示
27:       if (next.length === 0 && hadIssues.current) setDismissed(false);
28:       hadIssues.current = next.length > 0;
29:       setIssues(next);
30:       setChecked(true);
31:     };
32:     load();
33:     const t = setInterval(load, 60000);
34:     return () => { alive = false; clearInterval(t); };
35:     // eslint-disable-next-line react-hooks/exhaustive-deps
36:   }, []);
37:   if (!checked || dismissed || issues.length === 0) return null;
38:   const hasError = issues.some((i) => i.level === 'error');
39:   const accent = hasError ? 'var(--accent-red)' : 'var(--accent-amber)';
40:   const icon = hasError ? '⚠️' : '🔔';
41:   return (
42:     <div
43:       className="fade-in flex items-center gap-2.5 px-3 py-2 mx-3 md:mx-4 mt-3 rounded-xl border premium-card"
44:       style={{
45:         borderColor: accent,
46:         background: hasError
47:           ? 'color-mix(in srgb, var(--accent-red) 7%, var(--bg-card))'
48:           : 'color-mix(in srgb, var(--accent-amber) 9%, var(--bg-card))',
49:       }}
50:     >
51:       <span className="text-base shrink-0">{icon}</span>
52:       <div className="flex-1 min-w-0 text-xs" style={{ color: 'var(--text-primary)' }}>
53:         <span className="font-semibold">系统自检：</span>
54:         {issues.map((i, idx) => (
55:           <span key={i.key}>
56:             {idx > 0 && <span style={{ color: 'var(--text-muted)' }}> · </span>}
57:             {i.path ? (
58:               <a
59:                 onClick={(e) => { e.preventDefault(); navigate(i.path); }}
60:                 href={i.path}
61:                 className="cursor-pointer hover:underline"
62:                 style={{ color: accent }}
63:               >
64:                 {i.label} {i.msg}
65:               </a>
66:             ) : (
67:               <span style={{ color: accent }}>{i.label} {i.msg}</span>
68:             )}
69:           </span>
70:         ))}
71:       </div>
72:       <button
73:         onClick={() => setDismissed(true)}
74:         className="shrink-0 px-1.5 py-0.5 rounded text-xs transition-colors"
75:         style={{ color: 'var(--text-muted)' }}
76:         title="忽略本次提示"
77:       >
78:         ✕
79:       </button>
80:     </div>
81:   );
82: }
