 54:       if (prev.has(key)) return prev;
 55:       const next = new Set(prev);
 56:       next.add(key);
 57:       return next;
 58:     });
 59:   }, []);
 60:   const handleRefresh = useCallback(() => {
 61:     setRefreshTicks(prev => ({ ...prev, [activeKey]: (prev[activeKey] || 0) + 1 }));
 62:   }, [activeKey]);
 63:   return (
 64:     <div className="space-y-2">
 65:       {/* 二级Tab栏已上移到外层，这里仅保留刷新按钮（极简） */}
 66:       <div className="flex justify-end">
 67:         <button
 68:           onClick={handleRefresh}
 69:           className="px-2 py-1 rounded-md border text-xs flex items-center gap-1 transition-colors hover:opacity-80"
 70:           style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)' }}
 71:           title="刷新当前子模块数据"
 72:         >
 73:           🔄 刷新子模块
 74:         </button>
 75:       </div>
 76:       {/* 内容区：已加载的tab保持挂载以保留状态，用display隐藏 */}
 77:       <div className="tab-content">
 78:         {TABS.map(tab => {
 79:           if (!loadedKeys.has(tab.key)) return null;
 80:           const isActive = tab.key === activeKey;
 81:           const { Component } = tab;
 82:           return (
 83:             <div
 84:               key={tab.key}
 85:               className="transition-opacity duration-200"
 86:               style={{
 87:                 display: isActive ? 'block' : 'none',
 88:                 opacity: isActive ? 1 : 0,
 89:               }}
 90:             >
 91:               <Suspense fallback={<TabLoader />}>
 92:                 <Component key={`${tab.key}-${refreshTicks[tab.key] || 0}`} />
 93:               </Suspense>
 94:             </div>
 95:           );
 96:         })}
 97:         {!loadedKeys.has(activeKey) && <TabLoader />}
 98:       </div>
 99:     </div>
100:   );
101: }
</file>

