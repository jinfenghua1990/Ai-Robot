 23: def _create_ssl_context():
 24:     """创建SSL上下文，允许不安全的 renegotiation 以兼容旧服务器"""
 25:     try:
 26:         ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
 27:         ctx.check_hostname = False
 28:         ctx.verify_mode = ssl.CERT_NONE
 29:         try:
 30:             ctx.set_ciphers('ALL:@SECLEVEL=0')
 31:             ctx.options |= ssl.OP_LEGACY_SERVER_CONNECT
 32:         except Exception:
 33:             pass
 34:         return ctx
 35:     except Exception as e:
 36:         pass
 37:     try:
 38:         ctx = ssl._create_unverified_context()
 39:         try:
 40:             ctx.options |= ssl.OP_LEGACY_SERVER_CONNECT
 41:             ctx.set_ciphers('ALL:@SECLEVEL=0')
 42:         except Exception:
 43:             pass
 44:         return ctx
 45:     except Exception:
 46:         pass
 47:     return None
 48: def _curl_request(url: str) -> Dict[str, Any]:
 49:     """使用curl发送请求，当requests/urllib失败时的备用方案"""
 50:     params["skillName"] = SKILL_NAME
 51:     try:
 52:         result = subprocess.run(
 53:             ["curl", "-s", "-k", url],
 54:             capture_output=True,
 55:             text=True,
 56:             timeout=30,
 57:             encoding='utf-8',
 58:             errors='ignore'
 59:         )
 60:         if result.returncode == 0 and result.stdout:
 61:             try:
 62:                 return json.loads(result.stdout)
 63:             except json.JSONDecodeError:
 64:                 return {"error": "Invalid JSON response", "raw": result.stdout[:500]}
 65:         else:
 66:             return {"error": f"curl failed: {result.stderr}"}
 67:     except Exception as e:
