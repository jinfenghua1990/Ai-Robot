  1: from __future__ import annotations
  2: from math import isnan
  3: from statistics import mean
  4: from typing import Iterable, Sequence
  5: from .contracts import MarketContext
  6: def _rank(values: Sequence[float]) -> list[float]:
  7:     ordered = sorted(enumerate(values), key=lambda item: item[1])
  8:     result = [0.0] * len(values)
  9:     i = 0
 10:     while i < len(ordered):
 11:         j = i
 12:         while j + 1 < len(ordered) and ordered[j + 1][1] == ordered[i][1]:
 13:             j += 1
 14:         rank = (i + j + 2) / 2
 15:         for k in range(i, j + 1):
 16:             result[ordered[k][0]] = rank
 17:         i = j + 1
 18:     return result
 19: def correlation(left: Sequence[float], right: Sequence[float]) -> float | None:
 20:     pairs = [(float(a), float(b)) for a, b in zip(left, right) if not isnan(float(a)) and not isnan(float(b))]
 21:     if len(pairs) < 3:
 22:         return None
 23:     ax, bx = mean(a for a, _ in pairs), mean(b for _, b in pairs)
 24:     numerator = sum((a - ax) * (b - bx) for a, b in pairs)
 25:     den_a = sum((a - ax) ** 2 for a, _ in pairs) ** .5
 26:     den_b = sum((b - bx) ** 2 for _, b in pairs) ** .5
 27:     return numerator / (den_a * den_b) if den_a and den_b else None
 28: def factor_ic(factor_values: Sequence[float], forward_returns: Sequence[float]) -> float | None:
 29:     return correlation(factor_values, forward_returns)
 30: def rank_ic(factor_values: Sequence[float], forward_returns: Sequence[float]) -> float | None:
 31:     return correlation(_rank(factor_values), _rank(forward_returns))
 32: def factor_correlation_matrix(columns: dict[str, Sequence[float]]) -> dict[str, dict[str, float | None]]:
 33:     names = list(columns)
 34:     return {a: {b: correlation(columns[a], columns[b]) for b in names} for a in names}
 35: def rolling_factor_validation(engine, history, dates, horizon: int = 5) -> list[dict]:
 36:     """按交易日滚动计算横截面 IC / Rank IC，因子只使用当日以前数据。"""
 37:     observations: dict[str, list[tuple[float, float]]] = {}
 38:     for trade_date in sorted(set(dates)):
 39:         visible = {
 40:             code: [bar for bar in bars if bar.trade_date <= trade_date]
 41:             for code, bars in history.items()
 42:         }
 43:         visible = {code: bars for code, bars in visible.items() if bars and bars[-1].trade_date == trade_date}
 44:         if not visible:
 45:             continue
 46:         values = engine.calculate(visible, trade_date, _derived_market_context(visible, trade_date))
 47:         future = {}
 48:         for code, bars in history.items():
 49:             ordered = sorted(bars, key=lambda item: item.trade_date)
 50:             indexes = {bar.trade_date: index for index, bar in enumerate(ordered)}
 51:             index = indexes.get(trade_date)
 52:             if index is not None and index + horizon < len(ordered) and ordered[index].close:
 53:                 future[code] = ordered[index + horizon].close / ordered[index].close - 1
 54:         for value in values:
 55:             if value.valid and value.raw_value is not None and value.ts_code in future:
 56:                 observations.setdefault(value.name, []).append((value.raw_value, future[value.ts_code]))
 57:     result = []
 58:     for name, pairs in observations.items():
 59:         factors = [pair[0] for pair in pairs]
 60:         returns = [pair[1] for pair in pairs]
 61:         result.append({
 62:             "factor_name": name,
 63:             "period_days": horizon,
 64:             "sample_count": len(pairs),
 65:             "ic": factor_ic(factors, returns),
 66:             "rank_ic": rank_ic(factors, returns),
 67:             "mean_forward_return": mean(returns) if returns else None,
 68:         })
 69:     return result
 70: def factor_correlation_from_history(engine, history, dates) -> dict[str, dict[str, float | None]]:
 71:     """Compute factor correlations on aligned stock/date observations.
 72:     Correlations must compare the same stock on the same signal date.  A
 73:     simple zip of independently filtered factor lists can silently compare
 74:     different securities when one factor has missing history, so this helper
 75:     aligns observations by ``(trade_date, ts_code)`` first.
 76:     """
 77:     observations: dict[tuple[object, str], dict[str, float]] = {}
 78:     for trade_date in sorted(set(dates)):
 79:         visible = {
 80:             code: [bar for bar in bars if bar.trade_date <= trade_date]
 81:             for code, bars in history.items()
 82:         }
 83:         visible = {
 84:             code: bars for code, bars in visible.items()
 85:             if bars and bars[-1].trade_date == trade_date
 86:         }
 87:         if not visible:
 88:             continue
 89:         values = engine.calculate(visible, trade_date, _derived_market_context(visible, trade_date))
 90:         for value in values:
 91:             if value.valid and value.raw_value is not None:
 92:                 observations.setdefault((trade_date, value.ts_code), {})[value.name] = float(value.raw_value)
 93:     names = sorted({name for row in observations.values() for name in row})
 94:     result: dict[str, dict[str, float | None]] = {name: {} for name in names}
 95:     for left in names:
 96:         for right in names:
 97:             pairs = [
 98:                 (row[left], row[right])
 99:                 for row in observations.values()
100:                 if left in row and right in row
101:             ]
102:             result[left][right] = correlation(
103:                 [pair[0] for pair in pairs],
104:                 [pair[1] for pair in pairs],
105:             )
106:     return result
107: def _derived_market_context(visible, trade_date) -> MarketContext:
108:     """Build only from bars visible on the validation date."""
109:     latest = [bars[-1] for bars in visible.values() if bars]
110:     breadth = sum(
111:         1 for bars in visible.values()
112:         if len(bars) >= 2 and bars[-1].close > bars[-2].close
113:     ) / len(latest) if latest else 0.0
114:     returns = []
115:     for bars in visible.values():
116:         if len(bars) >= 21 and bars[-21].close:
117:             returns.append(bars[-1].close / bars[-21].close - 1)
118:     return MarketContext(
119:         trade_date=trade_date,
120:         breadth=breadth,
121:         limit_up_count=sum(1 for bars in visible.values() if bars and abs(float(bars[-1].pct_chg or 0)) >= 9.5 and float(bars[-1].pct_chg or 0) > 0),
122:         limit_down_count=sum(1 for bars in visible.values() if bars and abs(float(bars[-1].pct_chg or 0)) >= 9.5 and float(bars[-1].pct_chg or 0) < 0),
123:         market_return_20d=mean(returns) if returns else None,
124:         market_data_available=True,
125:     )
