 221: # ===== 工具 =====
 222: def _clamp(v, lo=0, hi=100):
 223:     return max(lo, min(hi, v))
 224: def _features_to_dict(f) -> dict:
 225:     return {
 226:         'rsi_14': f.rsi_14,
 227:         'volume_ratio': f.volume_ratio,
 228:         'close_vs_ma20': f.close_vs_ma20,
