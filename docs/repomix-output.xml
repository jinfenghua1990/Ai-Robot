  1: /**
  2:  * 7 维度信号命中评分（20天跟踪页 + 自选页统一标签体系）
  3:  *
  4:  * 7 个维度：涨跌幅 / 价格阶段 / 竞价溢价 / 振幅 / 主力净流入 / 散户净流入 / 承接力度
  5:  * 每个维度判定为 看多(+1) / 看空(-1) / 中性(0)
  6:  * 命中数 = 看多维度数 - 看空维度数，范围 -7 ~ +7
  7:  *
  8:  * 标签映射：
  9:  *   6-7  → 强多（主升浪）
 10:  *   3-5  → 偏多
 11:  *   -2~2 → 中性
 12:  *   -5~-3→ 偏空
 13:  *   -7~-6→ 强空（退潮）
 14:  */
 15: // 单维度判定: 返回 1(看多) / -1(看空) / 0(中性)
 16: const _scoreDimension = (dim, value, ctx = {}) => {
 17:   switch (dim) {
 18:     case 'pct_chg': {
 19:       if (value == null) return 0;
 20:       if (value > 0) return 1;
 21:       if (value < 0) return -1;
 22:       return 0;
 23:     }
 24:     case 'price_stage': {
 25:       if (['连板', '晋级', '偏多'].includes(value)) return 1;
 26:       if (['跌停A杀', '偏空', '砸盘'].includes(value)) return -1;
 27:       return 0; // 震荡/分歧
 28:     }
 29:     case 'open_premium': {
 30:       if (value == null) return 0;
 31:       if (value >= 1) return 1;
 32:       if (value <= -1) return -1;
 33:       return 0;
 34:     }
 35:     case 'intra_amplitude': {
 36:       // 振幅需要配合涨跌方向: 放量上涨=看多, 放量下跌=看空
 37:       const pct = ctx.pct_chg || 0;
 38:       if (value == null || value < 8) return 0; // 振幅<8% 不算信号
 39:       if (pct > 0) return 1;
 40:       if (pct < 0) return -1;
 41:       return 0;
 42:     }
 43:     case 'main_force_inflow': {
 44:       if (value == null || value === 0) return 0;
 45:       return value > 0 ? 1 : -1;
 46:     }
 47:     case 'retail_flow': {
 48:       // 散户净流入是反向信号: 散户大量流入=主力出货=看空; 散户流出=主力接盘=看多
 49:       if (value == null || value === 0) return 0;
 50:       return value > 0 ? -1 : 1;
 51:     }
 52:     case 'support_level': {
 53:       if (value === '强') return 1;
 54:       if (value === '弱') return -1;
 55:       return 0;
 56:     }
 57:     default:
 58:       return 0;
 59:   }
 60: };
 61: /**
 62:  * 计算 7 维度信号命中数
 63:  * @param {Object} day - DayCell 数据（含 pct_chg/price_stage/open_premium/intra_amplitude/main_force_inflow/retail_flow/support_level）
 64:  * @returns {Object} { score, bullCount, bearCount, neutralCount, label, color, details }
 65:  */
 66: export const computeSignalScore = (day) => {
 67:   if (!day) return null;
 68:   const pctChg = Number(day.pct_chg ?? day.win_rate_impact ?? 0);
 69:   const ctx = { pct_chg: pctChg };
 70:   const dims = [
 71:     { key: 'pct_chg', label: '涨跌', value: pctChg },
 72:     { key: 'price_stage', label: '阶段', value: day.price_stage || '震荡' },
 73:     { key: 'open_premium', label: '竞价', value: Number(day.open_premium || 0) },
 74:     { key: 'intra_amplitude', label: '振幅', value: Number(day.intra_amplitude || 0), ctx },
 75:     { key: 'main_force_inflow', label: '主力', value: Number(day.main_force_inflow || 0) },
 76:     { key: 'retail_flow', label: '散户', value: Number(day.retail_flow || 0) },
 77:     { key: 'support_level', label: '承接', value: day.support_level || '中' },
 78:   ];
 79:   let bullCount = 0;
 80:   let bearCount = 0;
 81:   let neutralCount = 0;
 82:   const details = [];
 83:   dims.forEach(d => {
 84:     const v = d.key === 'intra_amplitude'
 85:       ? _scoreDimension(d.key, d.value, ctx)
 86:       : _scoreDimension(d.key, d.value);
 87:     if (v === 1) bullCount++;
 88:     else if (v === -1) bearCount++;
 89:     else neutralCount++;
 90:     details.push({ label: d.label, value: v });
 91:   });
 92:   const score = bullCount - bearCount; // -7 ~ +7
 93:   // 标签映射
 94:   let label, color, bg;
 95:   if (score >= 6) {
 96:     label = '强多'; color = '#dc2626'; bg = 'rgba(220,38,38,0.2)';
 97:   } else if (score >= 3) {
 98:     label = '偏多'; color = '#ef4444'; bg = 'rgba(239,68,68,0.12)';
 99:   } else if (score >= -2) {
100:     label = '中性'; color = '#6b7280'; bg = 'rgba(156,163,175,0.12)';
101:   } else if (score >= -5) {
102:     label = '偏空'; color = '#16a34a'; bg = 'rgba(22,163,74,0.12)';
103:   } else {
104:     label = '强空'; color = '#15803d'; bg = 'rgba(21,128,61,0.2)';
105:   }
106:   return {
107:     score,
108:     bullCount,
109:     bearCount,
110:     neutralCount,
111:     label,
112:     color,
113:     bg,
114:     details,
115:   };
116: };
117: /**
118:  * 命中数文字（用于 tooltip / 详情）
119:  * 例: "5/7看多" / "3/7看空" / "4多2空1中"
120:  */
121: export const fmtHitCount = (score) => {
122:   if (!score) return '—';
123:   return `${score.bullCount}多${score.bearCount}空${score.neutralCount}中`;
124: };
125: /**
126:  * 3 天趋势评分 — 基于最近 3 天 7 维得分的「平均强度 + 走势方向」
127:  *
128:  * 解决痛点: 单看最新一天会被"高位滞涨"骗(最新一天偏多但近3天持续走弱)
129:  *
130:  * 算法:
131:  *   avgScore   = 最近 3 天 7 维得分的平均 (-7~+7)
132:  *   trajectory = 最新一天 - 3 天前 (正=转强 / 负=转弱)
133:  *
134:  * 综合 12 种场景标签（强度 × 方向）:
135:  *   强势上行  - 平均强多 + 转强 (主升浪加速)
136:  *   高位滞涨  - 平均强多 + 转弱 (头部预警⚠)
137:  *   持续走强  - 平均偏多 + 转强 (启动)
138:  *   上涨乏力  - 平均偏多 + 转弱 (动力衰减)
139:  *   底部修复  - 平均震荡 + 转强 (有承接)
140:  *   横盘整理  - 平均震荡 + 平稳
141:  *   转弱信号  - 平均震荡 + 转弱 (预警)
142:  *   超跌反弹  - 平均偏弱 + 转强 (可能有买点)
143:  *   止跌迹象  - 平均弱势 + 转强
144:  *   持续走弱  - 平均偏弱 + 转弱 (退潮)
145:  *   继续杀跌  - 平均弱势 + 转弱 (主跌浪)
146:  *
147:  * @param {Object} lc - lifecycle_data (含 d1/d2/.../d20)
148:  * @returns {Object} { avgScore, trajectory, label, color, bg, dailyScores, lastScore, days }
149:  */
150: export const computeTrendSignalScore = (lc) => {
151:   if (!lc || typeof lc !== 'object') return null;
152:   const keys = Object.keys(lc)
153:     .filter(k => k.startsWith('d'))
154:     .map(k => parseInt(k.slice(1), 10))
155:     .filter(n => !isNaN(n));
156:   if (!keys.length) return null;
157:   const maxN = Math.max(...keys);
158:   // 取最近 3 天(允许缺失,过滤掉)
159:   const recentDays = [];
160:   for (let i = 0; i < 3; i++) {
161:     const d = lc[`d${maxN - i}`];
162:     if (d) recentDays.push(d);
163:   }
164:   if (!recentDays.length) return null;
165:   const dailyScores = recentDays.map(d => computeSignalScore(d)).filter(Boolean);
166:   if (!dailyScores.length) return null;
167:   const scores = dailyScores.map(s => s.score);
168:   const avgScore = scores.reduce((a, b) => a + b, 0) / scores.length;
169:   const trajectory = scores.length >= 2 ? (scores[0] - scores[scores.length - 1]) : 0;
170:   const strong = avgScore >= 4;      // 强多区
171:   const bull = avgScore >= 1.5;       // 偏多区
172:   const bear = avgScore <= -1.5;      // 偏空区
173:   const weak = avgScore <= -4;        // 强空区
174:   const rising = trajectory >= 2;     // 显著转强
175:   const falling = trajectory <= -2;   // 显著转弱
176:   let label, color, bg;
177:   if (strong && rising) {
178:     label = '强势上行'; color = '#dc2626'; bg = 'rgba(220,38,38,0.25)';
179:   } else if (strong && falling) {
180:     label = '高位滞涨'; color = '#f97316'; bg = 'rgba(249,115,22,0.18)';  // ⚠橙色预警
181:   } else if (strong) {
182:     label = '强势'; color = '#dc2626'; bg = 'rgba(220,38,38,0.2)';
183:   } else if (bull && rising) {
