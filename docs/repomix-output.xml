169: @router.get("/scanner")
170: async def get_scanner(
171:     symbols: str = Query("", description="逗号分隔的股票代码（与 universe 互斥；留空则从池取）"),
172:     universe: str = Query("", description="股票池：CORE_A / CORE_B / ALL / RESEARCH_DYNAMIC"),
173:     market_mult: float = 1.0,
174:     sector_mult: float = 1.0,
175:     refresh: bool = Query(False, description="强制刷新缓存"),
176: ):
177:     """扫描并评分股票。V2.2: 缓存 2 分钟，refresh=true 强制刷新。"""
178:     # 防御：/overview 等内部直接函数调用时，FastAPI 不会解析 Query 默认值
179:     def _to_float(v: object, default: float = 1.0) -> float:
180:         if isinstance(v, (int, float)):
181:             return float(v)
182:         inner = getattr(v, "default", None)
183:         if isinstance(inner, (int, float)):
184:             return float(inner)
185:         return default
186:     market_mult = _to_float(market_mult)
187:     sector_mult = _to_float(sector_mult)
188:     # ── 缓存检查 ──
189:     cache_key = make_cache_key(scanner=True, symbols=symbols, universe=universe)
190:     if not refresh:
191:         cached = scanner_cache.get(cache_key)
192:         if cached is not None:
193:             return jsonable_encoder(cached)
194:     # ── 解析候选 ──
195:     if symbols.strip():
196:         code_list = [s.strip().upper() for s in symbols.split(",") if s.strip()]
197:         pool_source = None
198:     elif universe.strip():
199:         uni = universe.strip().upper()
200:         if uni == "ALL":
201:             code_list = uniques_for_scanner(["CORE_A", "CORE_B"])
202:         else:
203:             code_list = get_universe_members(uni)
204:         limit = get_scanner_limit(uni) if uni != "ALL" else 120
205:         code_list = code_list[:limit]
206:         pool_source = uni
207:     else:
208:         return jsonable_encoder({"candidates": [], "count": 0, "message": "请提供股票代码或选择股票池", "pool": None})
209:     if not code_list:
210:         return jsonable_encoder({"candidates": [], "count": 0, "message": "股票池候选为空", "pool": pool_source})
211:     # 并行批量拉取 K 线（单次最多 30 只，避免 Nasdaq 限流）
212:     from us_quant.data_provider import get_klines_batch
213:     max_scan = min(len(code_list), 30)
214:     _klines_map = get_klines_batch(code_list[:max_scan], "3mo")
215:     candidates = []
216:     for symbol in code_list[:max_scan]:
217:         try:
218:             klines = _klines_map.get(symbol)
219:             if not klines:
220:                 continue
221:             closes = [k["close"] for k in klines if k.get("close")]
222:             highs = [k["high"] for k in klines if k.get("high")]
223:             lows = [k["low"] for k in klines if k.get("low")]
224:             volumes = [k["volume"] for k in klines if k.get("volume")]
225:             price = closes[-1] if closes else None
226:             if not price:
227:                 continue
228:             # 技术指标
229:             ema10_vals = ema(closes, 10)
230:             ema20_vals = ema(closes, 20)
231:             ma50_vals = sma(closes, 50)
232:             rsi_val = calc_rsi(closes, 14)
233:             macd_val = calc_macd(closes)
234:             kdj_val = calc_kdj(closes)
235:             ema10 = ema10_vals[-1] if ema10_vals else None
236:             ema20 = ema20_vals[-1] if ema20_vals else None
237:             ma50 = ma50_vals[-1] if ma50_vals else None
238:             # 硬过滤
239:             hf = check_hard_filters(price=price)
240:             # 平台突破评分
241:             high_52w = max(closes[-252:]) if len(closes) >= 252 else max(closes)
242:             base_high = max(closes[-20:]) if len(closes) >= 20 else max(closes)
243:             base_low = min(closes[-20:]) if len(closes) >= 20 else min(closes)
244:             base_days = 20
245:             rel_vol = (volumes[-1] / (sum(volumes[-5:]) / 5)) if len(volumes) >= 5 else 1.0
246:             change_today = (closes[-1] - closes[-2]) / closes[-2] * 100 if len(closes) >= 2 else 0
247:             bs = score_breakout(
248:                 price=price, ema10=ema10, ema20=ema20, ma50=ma50,
249:                 high_52w=high_52w, base_high=base_high, base_low=base_low,
250:                 base_days=base_days, rel_volume=rel_vol,
251:                 change_pct_today=change_today,
252:                 market_mult=market_mult,
253:             )
254:             # 趋势回踩评分
255:             prior_uptrend = bool(ema10 and ema20 and ma50 and ema10 > ema20 > ma50)
256:             pullback_pct = None
257:             if len(closes) >= 10:
258:                 peak = max(closes[-10:])
259:                 pullback_pct = (peak - price) / peak * 100
260:             ps = score_pullback(
261:                 price=price, ema10=ema10, ema20=ema20, ma50=ma50,
262:                 prior_uptrend=prior_uptrend, first_pullback=True,
263:                 pullback_pct=pullback_pct, volume_contracted=True,
264:                 no_consecutive_bearish=True,
265:                 market_mult=market_mult,
266:             )
267:             # 7状态
268:             state = determine_stock_state(
269:                 price=price, ma20=ema20, ma50=ma50,
270:                 rsi=rsi_val,
271:             )
272:             # 计算关键位
273:             stop_loss = None
274:             if ma50 and price:
275:                 stop_loss = round(ma50 * 0.97, 2)
276:             elif price:
277:                 stop_loss = round(price * 0.95, 2)
278:             candidates.append({
279:                 "symbol": symbol,
280:                 "price": round(price, 2),
281:                 "change_pct": round(change_today, 2),
282:                 "rsi": round(rsi_val, 1) if rsi_val else None,
283:                 "macd": macd_val,
284:                 "kdj": kdj_val,
285:                 "ema10": round(ema10, 2) if ema10 else None,
286:                 "ema20": round(ema20, 2) if ema20 else None,
287:                 "ma50": round(ma50, 2) if ma50 else None,
288:                 "hard_filter_pass": hf.passed,
289:                 "hard_filter_reasons": hf.reasons,
290:                 "breakout_score": bs.total if bs.hard_pass else None,
291:                 "breakout_details": bs.details,
292:                 "pullback_score": ps.total if ps.hard_pass else None,
293:                 "pullback_details": ps.details,
294:                 "state": state.state,
295:                 "state_label": state.label,
296:                 "state_signal": state.signal,
297:                 "stop_loss": stop_loss,
298:                 "ma_bias": round(ma_bias(price, ma50), 2) if ma50 else None,
299:             })
300:         except Exception as exc:
301:             logger.warning(f"Scanner error for {symbol}: {exc}")
302:             continue
303:     candidates.sort(key=lambda x: max(
304:         x.get("breakout_score") or 0,
305:         x.get("pullback_score") or 0,
306:     ), reverse=True)
307:     # 计算排名
308:     for i, c in enumerate(candidates):
309:         c["rank"] = i + 1
310:     result = {
311:         "candidates": candidates,
312:         "count": len(candidates),
313:         "pool": pool_source,
314:         "pool_total": len(code_list),
315:         "scanned": max_scan,
316:         "updated_at": datetime.utcnow().isoformat(),
317:     }
318:     # 缓存结果（2 分钟）
319:     scanner_cache.set(cache_key, result, ttl=120)
320:     return jsonable_encoder(result)
