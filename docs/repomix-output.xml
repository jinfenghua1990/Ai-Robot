244: async def _get_quote(code: str):
245:     """获取新浪实时行情（缓存30秒，与 watchlist._get_quote 口径一致）"""
246:     cached = _quote_cache.get(code)
247:     if cached and time.time() - cached[1] < _QUOTE_CACHE_TTL:
248:         return cached[0]
