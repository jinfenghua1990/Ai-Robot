  1: """市场总览数据层 —— 市场情绪 + 板块资金流（板块/大盘级公开数据，不涉个股推荐）。
  2: 省流量：全站共享一份缓存（TTL 默认 5 分钟），多个用户/多次打开只抓一次；
  3: 盘中 5 分钟刷新足够，非交易时段数据本就不变。数据源全免费、无 key。
  4: """
  5: from __future__ import annotations
  6: import time
  7: from collections import Counter
  8: from datetime import datetime, timezone, timedelta
  9: from services.research import astock
 10: from services.research import gstock
 11: BEIJING = timezone(timedelta(hours=8))
 12: _CACHE: dict = {}
 13: _TTL = 300  # 5 分钟；全站共享，省数据源压力
 14: def _cached(key: str, fn, valid=bool):
 15:     """TTL 缓存。数据源故障的空结果不缓存（valid 判否），下次请求直接重试。"""
 16:     now = time.time()
 17:     hit = _CACHE.get(key)
 18:     if hit and now - hit[0] < _TTL:
 19:         return hit[1]
 20:     val = fn()
 21:     if valid(val):
 22:         _CACHE[key] = (now, val)
 23:     return val
 24: def _num(v) -> int:
 25:     try:
 26:         return int(float(v))
 27:     except (ValueError, TypeError):
 28:         return 0
 29: def _sentiment() -> dict:
 30:     """市场情绪：涨跌家数/涨停跌停/活跃度 + 大盘宽度、题材投机（客观数据机械分档）。"""
 31:     try:
 32:         # akshare 惰性导入（同 astock 模式）：未装时降级返回空，不挡整个服务启动
 33:         df = astock._akshare().stock_market_activity_legu()
 34:         d = {row["item"]: row["value"] for _, row in df.iterrows()}
 35:     except Exception:
 36:         return {}
 37:     up, down, flat = _num(d.get("上涨")), _num(d.get("下跌")), _num(d.get("平盘"))
 38:     zt, zt_real = _num(d.get("涨停")), _num(d.get("真实涨停"))
 39:     dt, dt_real = _num(d.get("跌停")), _num(d.get("真实跌停"))
 40:     r = up / max(down, 1)
 41:     if up < 600:
 42:         breadth = "冰点"
 43:     elif r < 0.7:
 44:         breadth = "偏弱"
 45:     elif r < 1.2:
 46:         breadth = "中性"
 47:     elif r < 2.5:
 48:         breadth = "偏强"
 49:     else:
 50:         breadth = "普涨"
 51:     speculation = "亢奋" if zt_real >= 100 else "活跃" if zt_real >= 60 else "普通" if zt_real >= 30 else "冰点"
 52:     return {
 53:         "up": up, "down": down, "flat": flat,
 54:         "zt": zt, "zt_real": zt_real, "dt": dt, "dt_real": dt_real,
 55:         "active": str(d.get("活跃度", "")),
 56:         "breadth": breadth, "speculation": speculation,
 57:         "date": str(d.get("统计日期", "")),
 58:     }
 59: def _sectors() -> list[dict]:
 60:     """行业资金流（按净额降序）。不含领涨股等个股字段。"""
 61:     try:
 62:         f = astock._akshare().stock_fund_flow_industry(symbol="即时")
 63:         f = f.sort_values("净额", ascending=False)
 64:     except Exception:
 65:         return []
 66:     out = []
 67:     for _, row in f.iterrows():
 68:         out.append({
 69:             "name": str(row["行业"]),
 70:             "pct": round(float(row.get("行业-涨跌幅", 0) or 0), 2),
 71:             "net": round(float(row.get("净额", 0) or 0), 2),
 72:             "inflow": round(float(row.get("流入资金", 0) or 0), 2),
 73:             "outflow": round(float(row.get("流出资金", 0) or 0), 2),
 74:             "firms": _num(row.get("公司家数")),
 75:         })
 76:     return out
 77: def get_overview() -> dict:
 78:     """市场情绪 + 板块资金（含缓存）。资金轮动由前端从 sectors 头尾取。"""
 79:     def build():
 80:         return {
 81:             "sentiment": _sentiment(),
 82:             "sectors": _sectors(),
 83:             "updated": datetime.now(BEIJING).strftime("%Y-%m-%d %H:%M"),
 84:         }
 85:     return _cached("overview", build, valid=lambda v: bool(v.get("sentiment") or v.get("sectors")))
 86: def _emotion() -> dict:
 87:     """短线情绪（聚合口径，**零个股名**）：连板梯队 / 最高连板 / 炸板率 / 封板率 / 晋级率 / 涨跌停家数。
 88:     数据源＝东财涨停板四池（push2ex）。只把池子聚合成计数与比率，
 89:     **不输出任何个股 code/name**——守产品「零标的」红线（个股清单是甩名单，不做）。
 90:     """
 91:     # 定位最近交易日：从今天往前回溯，第一日有涨停池即取（非交易日/盘前返空则继续回溯）。
 92:     today = datetime.now(BEIJING).date()
 93:     resolved, zt = "", []
 94:     for back in range(8):
 95:         d = (today - timedelta(days=back)).strftime("%Y%m%d")
 96:         zt = astock.em_zt_topic_pool("getTopicZTPool", d, "fbt:asc")
 97:         if zt:
 98:             resolved = d
 99:             break
100:     if not resolved:
101:         return {}
102:     zb = astock.em_zt_topic_pool("getTopicZBPool", resolved, "fbt:asc")    # 炸板池
103:     dt = astock.em_zt_topic_pool("getTopicDTPool", resolved, "fund:asc")   # 跌停池
104:     yzt = astock.em_zt_topic_pool("getYesterdayZTPool", resolved, "zs:desc")  # 昨涨停池
105:     boards = [_num(p.get("lbc")) or 1 for p in zt]      # 每只连板数（缺省按 1 板）
106:     lianban = [b for b in boards if b >= 2]             # 2 板及以上（连板）
107:     # 连板梯队：2/3/4/5+ 各多少家（5 代表 5 板及以上），只保留有家数的档
108:     tiers = Counter(min(b, 5) for b in lianban)
109:     ladder = [{"boards": b, "count": tiers[b], "plus": b >= 5} for b in sorted(tiers)]
110:     # 连板股清单（2 板+，客观公开榜单数据；按连板数、成交额降序）。
111:     # 产品定位调整（2026-07-05）：从「零标的」→「展示客观榜单但不推荐/不预测/不评分」。
112:     lianban_stocks = sorted(
113:         ({
114:             "code": str(p.get("c", "")), "name": p.get("n", ""),
115:             "boards": _num(p.get("lbc")) or 1,
116:             "price": round((astock._numf(p.get("p")) or 0) / 1000, 2),
117:             "pct": round(astock._numf(p.get("zdp")) or 0, 2),
118:             "amount": astock._numf(p.get("amount")),      # 成交额,元（'-' 占位归一为 None，防排序对 str 取负崩溃）
119:             "float_cap": astock._numf(p.get("ltsz")),     # 流通市值,元
120:             "industry": p.get("hybk", ""),  # 概念/行业
121:         } for p in zt if (_num(p.get("lbc")) or 1) >= 2),
122:         key=lambda x: (-x["boards"], -(x["amount"] or 0)),
123:     )
124:     zt_count, zb_count, yzt_count = len(zt), len(zb), len(yzt)
125:     attempts = zt_count + zb_count                       # 尝试涨停 = 封住 + 炸板
126:     seal_rate = round(zt_count / attempts, 3) if attempts else None      # 封板率
127:     break_rate = round(zb_count / attempts, 3) if attempts else None     # 炸板率
128:     # 晋级率＝今日 2 板+（＝昨涨停今又停）÷ 昨日涨停家数
129:     promotion_rate = round(len(lianban) / yzt_count, 3) if yzt_count else None
130:     return {
131:         "date": f"{resolved[:4]}-{resolved[4:6]}-{resolved[6:]}",
132:         "zt_count": zt_count,
133:         "dt_count": len(dt),
134:         "zb_count": zb_count,
135:         "max_boards": max(boards) if boards else 0,
136:         "lianban_count": len(lianban),
137:         "ladder": ladder,
138:         "lianban_stocks": lianban_stocks,
139:         "seal_rate": seal_rate,
140:         "break_rate": break_rate,
141:         "promotion_rate": promotion_rate,
142:         "yzt_count": yzt_count,
143:     }
144: def get_short_term_emotion() -> dict:
145:     """短线情绪（含缓存，5 分钟）。"""
146:     return _cached("emotion", _emotion)
147: def get_turnover_top() -> dict:
148:     """全市场成交额榜 Top20（客观公开榜单，含缓存 5 分钟）。"""
149:     def build():
150:         return {
151:             "stocks": astock.market_turnover_rank(20),
152:             "updated": datetime.now(BEIJING).strftime("%Y-%m-%d %H:%M"),
153:         }
154:     return _cached("turnover_top", build, valid=lambda v: bool(v.get("stocks")))
155: def get_global_indices() -> list[dict]:
156:     """全球指数快照（美股 / 港股，含缓存 5 分钟）。空结果不缓存。"""
157:     return _cached("global_indices", gstock.global_indices, valid=bool)
