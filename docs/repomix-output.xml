  1: """抗跌深V反转策略 v2
  2: 核心逻辑:
  3:   1. 区间抗跌: 从基准日(默认 7月1日)至今, 跌幅不超过阈值(默认 20%)
  4:   2. 真V形态: 今日盘中曾跌破 -min_intraday_drop%(默认 5%), 收盘却收红 ≥ min_close_up%
  5:      分板阈值: 主板(60/00)收盘涨≥5%, 创业板(300)/科创板(688)收盘涨≥10%
  6:   3. 板块共振: 同板块命中 ≥ N 只 (过滤孤狼行情)
  7:   4. 板块强度约束(可选): 板块命中数 ≤ max_sector_hit(默认 8)
  8:      避免整个板块被动跟涨稀释信号
  9: 两个视图:
 10:   - view=all       全部命中(只看个股条件)
 11:   - view=sector    板块共振(个股条件 + 同板块≥N只)
 12: 历史回测接口:
 13:   - GET /api/strategy-vreversal/backtest  跑过去 N 天策略命中率 + T+1/T+3/T+5 收益率
 14: """
 15: import logging
 16: from datetime import date, timedelta
 17: from fastapi import APIRouter, Query
 18: from sqlalchemy import text
 19: from db.session import get_db_session
 20: logger = logging.getLogger(__name__)
 21: router = APIRouter()
 22: def _classify_board(ts_code: str) -> str:
 23:     """分板: main=主板, chinext=创业板, star=科创板"""
 24:     code = ts_code[:3] if ts_code else ''
 25:     if code.startswith('688') or code.startswith('689'):
 26:         return 'star'
 27:     if code.startswith('300') or code.startswith('301'):
 28:         return 'chinext'
 29:     return 'main'
 30: def _board_threshold_pct(board: str, base_pct: float) -> float:
 31:     """分板阈值: 主板用 base_pct, 双创板翻倍(因为±20%涨跌停)"""
 32:     if board in ('chinext', 'star'):
 33:         return base_pct * 1.5  # 双创板阈值放宽 1.5 倍(不是 2 倍, 避免阈值过高)
 34:     return base_pct
 35: @router.get("/api/strategy-vreversal")
 36: def get_vreversal(
 37:     date: str = Query(None, description="交易日 YYYY-MM-DD, 默认最新交易日"),
 38:     base_date: str = Query("2026-07-01", description="基准日 YYYY-MM-DD"),
 39:     max_drawdown: float = Query(20.0, description="区间跌幅上限(%)"),
 40:     min_close_up: float = Query(5.0, description="今日收盘涨幅下限(主板, %)"),
 41:     min_intraday_drop: float = Query(5.0, description="今日盘中最低跌幅下限(%) (V形态约束)"),
 42:     require_v_shape: bool = Query(True, description="是否启用 V 形态约束"),
 43:     min_sector_hit: int = Query(2, description="板块共振最小只数"),
 44:     max_sector_hit: int = Query(8, description="板块命中数上限(避免被动跟涨稀释)"),
 45:     view: str = Query("sector", description="视图: all=全部命中 / sector=板块共振"),
 46: ):
 47:     """抗跌深V反转策略筛选 v2
 48:     返回:
 49:       - stocks: 命中股票列表(含板块命中数 + V形态指标)
 50:       - sectors: 板块分布统计
 51:       - summary: 命中数 + 板块数
 52:     """
 53:     with get_db_session() as db:
 54:         # 未指定日期 → 取最新交易日
 55:         if not date:
 56:             row = db.execute(text(
 57:                 "SELECT MAX(trade_date) FROM stock_daily_kline"
 58:             )).scalar()
 59:             if not row:
 60:                 return {"stocks": [], "sectors": [], "summary": {}}
 61:             date = row.isoformat() if hasattr(row, 'isoformat') else str(row)
 62:         # 主查询: V 形态 + 板块命中数
 63:         # 关键改进: 用 CASE WHEN 按板块分阈值
 64:         sql = text("""
 65:         WITH base AS (
 66:             -- 基准日收盘价
 67:             SELECT ts_code, close AS base_close
 68:             FROM stock_daily_kline
 69:             WHERE trade_date = :base_date
 70:         ),
 71:         today AS (
 72:             -- 今日行情 (用 pct_chg + close 反推 pre_close)
 73:             SELECT ts_code, open, high, low, close, pct_chg,
 74:                    -- pre_close = close / (1 + pct_chg/100)
 75:                    close / NULLIF((1 + pct_chg / 100.0), 0) AS pre_close
 76:             FROM stock_daily_kline
 77:             WHERE trade_date = :trade_date
 78:         ),
 79:         filtered AS (
 80:             -- 第一步: 个股条件过滤
 81:             -- 1) 区间抗跌: 基准日 → 今日收盘 跌幅 ≤ 阈值
 82:             -- 2) 今日收盘涨幅 ≥ 分板阈值 (基础约束, 不受V形态影响)
 83:             -- 3) V 形态(可选): 盘中最低跌幅 ≤ -min_intraday_drop% (曾跌破过)
 84:             SELECT t.ts_code, t.open, t.high, t.low, t.close,
 85:                    t.pct_chg AS today_pct,
 86:                    t.pre_close,
 87:                    b.base_close,
 88:                    ROUND(((t.close - b.base_close) / b.base_close * 100)::numeric, 2) AS period_pct,
 89:                    ROUND(((t.high - t.low) / NULLIF(t.pre_close, 0) * 100)::numeric, 2) AS intraday_range_pct,
 90:                    ROUND(((t.high - NULLIF(t.pre_close, 0)) / NULLIF(t.pre_close, 0) * 100)::numeric, 2) AS max_up_pct,
 91:                    ROUND(((t.low  - NULLIF(t.pre_close, 0)) / NULLIF(t.pre_close, 0) * 100)::numeric, 2) AS min_intraday_pct,
 92:                    -- V 形态强度: 收盘价相对盘中最低的回升幅度
 93:                    ROUND(((t.close - t.low) / NULLIF(t.pre_close, 0) * 100)::numeric, 2) AS v_rebound_pct,
 94:                    -- 分板阈值
 95:                    CASE
 96:                        WHEN t.ts_code LIKE '688%' OR t.ts_code LIKE '689%'
 97:                             OR t.ts_code LIKE '300%' OR t.ts_code LIKE '301%'
 98:                        THEN :min_close_up_chinext
 99:                        ELSE :min_close_up_main
100:                    END AS required_close_up
101:             FROM today t
102:             JOIN base b ON b.ts_code = t.ts_code
103:             WHERE (t.close - b.base_close) / b.base_close >= -:max_drawdown_ratio
104:               -- 抗跌含义: 区间跌幅在 -max_drawdown% ~ 0% 之间 (真正跌过的, 但没崩盘)
105:               AND (t.close - b.base_close) / b.base_close <= 0
106:               -- 今日收盘涨幅 (基础约束, 不受V形态影响)
107:               AND t.pct_chg >= CASE
108:                   WHEN t.ts_code LIKE '688%' OR t.ts_code LIKE '689%'
109:                        OR t.ts_code LIKE '300%' OR t.ts_code LIKE '301%'
110:                   THEN :min_close_up_chinext
111:                   ELSE :min_close_up_main
112:               END
113:               -- V 形态约束(可选): 盘中曾跌破 -min_intraday_drop%
114:               AND (
115:                   NOT :require_v_shape
116:                   OR (t.low - NULLIF(t.pre_close, 0)) / NULLIF(t.pre_close, 0) <= -:min_intraday_drop_ratio
117:               )
118:         ),
119:         stock_sector AS (
120:             -- 每只股票最新的概念板块 + 股票名称(只扫基准日之后, 减少扫描量)
121:             SELECT DISTINCT ON (ts_code) ts_code, sector, name
122:             FROM stock_flow
123:             WHERE sector IS NOT NULL AND sector != ''
124:               AND trade_date >= :base_date
125:             ORDER BY ts_code, trade_date DESC
126:         ),
127:         stock_name AS (
128:             -- 股票名称兜底: 即使没有板块也要拿名称(从最近的 stock_flow 记录)
129:             SELECT DISTINCT ON (ts_code) ts_code, name
130:             FROM stock_flow
131:             WHERE name IS NOT NULL AND name != ''
132:             ORDER BY ts_code, trade_date DESC
133:         ),
134:         enriched AS (
135:             -- 加上板块 + 板块命中数(窗口函数, 一次算出) + 股票名称
136:             SELECT f.*,
137:                    s.sector,
138:                    s.name AS sector_name,
139:                    sn.name AS stock_name,
140:                    COUNT(*) OVER (PARTITION BY s.sector) AS sector_hit_count
141:             FROM filtered f
142:             LEFT JOIN stock_sector s ON s.ts_code = f.ts_code
143:             LEFT JOIN stock_name sn ON sn.ts_code = f.ts_code
144:         )
145:         SELECT ts_code, sector, sector_name, stock_name,
146:                today_pct, period_pct, intraday_range_pct,
147:                max_up_pct, min_intraday_pct, v_rebound_pct, required_close_up,
148:                close AS today_close, base_close, pre_close,
149:                sector_hit_count
150:         FROM enriched
151:         ORDER BY
152:             CASE WHEN sector IS NULL THEN 1 ELSE 0 END,
153:             sector_hit_count DESC,
154:             v_rebound_pct DESC NULLS LAST,
155:             today_pct DESC;
156:         """)
157:         # 计算分板阈值
158:         min_close_up_main = min_close_up
159:         min_close_up_chinext = min_close_up * 1.5  # 双创板放宽 1.5 倍
160:         rows = db.execute(sql, {
161:             "base_date": base_date,
162:             "trade_date": date,
163:             "max_drawdown_ratio": max_drawdown / 100.0,
164:             "require_v_shape": require_v_shape,
165:             "min_intraday_drop": min_intraday_drop,
166:             "min_intraday_drop_ratio": min_intraday_drop / 100.0,
167:             "min_close_up_main": min_close_up_main,
168:             "min_close_up_chinext": min_close_up_chinext,
169:         }).fetchall()
170:         # 转为 dict 列表
171:         all_stocks = []
172:         for r in rows:
173:             # 优先用 stock_name(全量兜底), 没有就用 sector_name(有板块的股票)
174:             stock_name = r.stock_name or r.sector_name or ''
175:             all_stocks.append({
176:                 "ts_code": r.ts_code,
177:                 "name": stock_name,
178:                 "board": _classify_board(r.ts_code),
179:                 "sector": r.sector,
180:                 "today_pct": float(r.today_pct) if r.today_pct is not None else None,
181:                 "period_pct": float(r.period_pct) if r.period_pct is not None else None,
182:                 "intraday_range_pct": float(r.intraday_range_pct) if r.intraday_range_pct is not None else None,
183:                 "max_up_pct": float(r.max_up_pct) if r.max_up_pct is not None else None,
184:                 "min_intraday_pct": float(r.min_intraday_pct) if r.min_intraday_pct is not None else None,
185:                 "v_rebound_pct": float(r.v_rebound_pct) if r.v_rebound_pct is not None else None,
186:                 "required_close_up": float(r.required_close_up) if r.required_close_up is not None else None,
187:                 "today_close": float(r.today_close),
188:                 "base_close": float(r.base_close),
189:                 "pre_close": float(r.pre_close) if r.pre_close else None,
190:                 "sector_hit_count": int(r.sector_hit_count) if r.sector else 0,
191:             })
192:         # 按视图过滤 + 板块强度约束
193:         if view == "sector":
194:             stocks = [s for s in all_stocks
195:                      if s["sector"]
196:                      and s["sector_hit_count"] >= min_sector_hit
197:                      and s["sector_hit_count"] <= max_sector_hit]
198:         else:
199:             stocks = [s for s in all_stocks
200:                      if not s["sector"] or s["sector_hit_count"] <= max_sector_hit]
201:         # 板块分布统计(基于全部候选, 不受 max_sector_hit 影响)
202:         sector_map = {}
203:         for s in all_stocks:
204:             sec = s["sector"]
205:             if not sec:
206:                 continue
207:             sector_map.setdefault(sec, {
208:                 "sector": sec,
209:                 "count": 0,
210:                 "today_pct_avg": 0.0,
211:                 "period_pct_avg": 0.0,
212:                 "v_rebound_avg": 0.0,
213:             })
214:             m = sector_map[sec]
215:             m["count"] += 1
216:             m["today_pct_avg"] += s["today_pct"] or 0
217:             m["period_pct_avg"] += s["period_pct"] or 0
218:             m["v_rebound_avg"] += s["v_rebound_pct"] or 0
219:         sectors = []
220:         for sec, m in sector_map.items():
221:             if m["count"] > 0:
222:                 m["today_pct_avg"] = round(m["today_pct_avg"] / m["count"], 2)
223:                 m["period_pct_avg"] = round(m["period_pct_avg"] / m["count"], 2)
224:                 m["v_rebound_avg"] = round(m["v_rebound_avg"] / m["count"], 2)
225:             m["is_resonance"] = m["count"] >= min_sector_hit
226:             m["is_too_crowded"] = m["count"] > max_sector_hit
227:             sectors.append(m)
228:         sectors.sort(key=lambda x: -x["count"])
229:         return {
230:             "date": date,
231:             "base_date": base_date,
232:             "view": view,
233:             "params": {
234:                 "max_drawdown": max_drawdown,
235:                 "min_close_up_main": min_close_up_main,
236:                 "min_close_up_chinext": min_close_up_chinext,
237:                 "min_intraday_drop": min_intraday_drop,
238:                 "require_v_shape": require_v_shape,
239:                 "min_sector_hit": min_sector_hit,
240:                 "max_sector_hit": max_sector_hit,
241:             },
242:             "stocks": stocks,
243:             "sectors": sectors,
244:             "summary": {
245:                 "total": len(stocks),
246:                 "total_all": len(all_stocks),
247:                 "sector_count": len(sectors),
248:                 "sector_resonance_count": sum(1 for s in sectors if s["count"] >= min_sector_hit),
249:                 "sector_crowded_count": sum(1 for s in sectors if s["count"] > max_sector_hit),
250:             },
251:         }
252: # ========================= 历史回测 =========================
253: @router.get("/api/strategy-vreversal/backtest")
254: def backtest_vreversal(
255:     days: int = Query(20, description="回测最近 N 个交易日"),
256:     base_date: str = Query("2026-07-01", description="基准日"),
257:     max_drawdown: float = Query(20.0),
258:     min_close_up: float = Query(5.0),
259:     min_intraday_drop: float = Query(5.0),
260:     require_v_shape: bool = Query(True),
261:     min_sector_hit: int = Query(2),
262:     max_sector_hit: int = Query(8),
263:     view: str = Query("sector"),
264: ):
265:     """历史回测: 跑过去 N 天的命中率 + T+1/T+3/T+5 收益率
266:     每个交易日:
267:       1. 用当日条件筛选命中股票
268:       2. 算命中股票在 T+1/T+3/T+5 的平均/中位数收益率
269:       3. 跟大盘指数(上证)同窗口对比
270:     Returns:
271:       - daily_stats: [{date, hit_count, avg_t1, avg_t3, avg_t5, market_t1, market_t3, market_t5}]
272:       - summary: {win_rate_t1, win_rate_t3, win_rate_t5, avg_return_t1/3/5, market_avg}
273:     """
274:     with get_db_session() as db:
275:         # 取最近 N 个交易日
276:         trade_dates = [r[0] for r in db.execute(text(
277:             "SELECT DISTINCT trade_date FROM stock_daily_kline "
278:             "WHERE trade_date >= :base_date "
279:             "ORDER BY trade_date DESC LIMIT :limit"
280:         ), {"base_date": base_date, "limit": days}).fetchall()]
281:         if not trade_dates:
282:             return {"daily_stats": [], "summary": {}}
283:         # 反向排序(按时间正序)便于阅读
284:         trade_dates_sorted = sorted(trade_dates, reverse=False)
285:         daily_stats = []
286:         all_returns_t1 = []
287:         all_returns_t3 = []
288:         all_returns_t5 = []
289:         for trade_date in trade_dates_sorted:
290:             date_str = trade_date.isoformat() if hasattr(trade_date, 'isoformat') else str(trade_date)
291:             # 复用筛选逻辑(内部调用 get_vreversal, 避免代码重复)
292:             # 但因 get_vreversal 是 FastAPI endpoint, 这里直接执行 SQL
293:             hit_stocks = _query_vreversal(
294:                 db, date_str, base_date, max_drawdown, min_close_up,
295:                 min_intraday_drop, require_v_shape, min_sector_hit, max_sector_hit, view
296:             )
297:             if not hit_stocks:
298:                 daily_stats.append({
299:                     "date": date_str,
300:                     "hit_count": 0,
301:                     "avg_t1": None, "avg_t3": None, "avg_t5": None,
302:                     "market_t1": None, "market_t3": None, "market_t5": None,
303:                 })
304:                 continue
305:             # 取命中股票的 ts_code 列表
306:             hit_codes = [s["ts_code"] for s in hit_stocks]
307:             # 算 T+1/T+3/T+5 的收益率
308:             future_returns = _compute_future_returns(
309:                 db, hit_codes, trade_date, [1, 3, 5]
310:             )
311:             # 算大盘基准: 用全市场平均日涨跌幅累计 (不依赖指数表)
312:             market_returns = _compute_market_returns(
313:                 db, trade_date, [1, 3, 5]
314:             )
315:             # _compute_future_returns 返回 {p: [(ts_code, ret), ...]}
316:             # 所以二元组取索引 1 (ret 值), 不是 p
317:             t1_list = [v[1] for v in future_returns.get(1, []) if v[1] is not None]
318:             t3_list = [v[1] for v in future_returns.get(3, []) if v[1] is not None]
319:             t5_list = [v[1] for v in future_returns.get(5, []) if v[1] is not None]
320:             avg_t1 = round(sum(t1_list) / len(t1_list), 2) if t1_list else None
321:             avg_t3 = round(sum(t3_list) / len(t3_list), 2) if t3_list else None
322:             avg_t5 = round(sum(t5_list) / len(t5_list), 2) if t5_list else None
323:             if avg_t1 is not None: all_returns_t1.extend(t1_list)
324:             if avg_t3 is not None: all_returns_t3.extend(t3_list)
325:             if avg_t5 is not None: all_returns_t5.extend(t5_list)
326:             daily_stats.append({
327:                 "date": date_str,
328:                 "hit_count": len(hit_stocks),
329:                 "avg_t1": avg_t1, "avg_t3": avg_t3, "avg_t5": avg_t5,
330:                 "market_t1": market_returns.get(1),
331:                 "market_t3": market_returns.get(3),
332:                 "market_t5": market_returns.get(5),
333:             })
334:         # 汇总
335:         win_rate_t1 = round(sum(1 for r in all_returns_t1 if r > 0) / len(all_returns_t1) * 100, 2) if all_returns_t1 else 0
336:         win_rate_t3 = round(sum(1 for r in all_returns_t3 if r > 0) / len(all_returns_t3) * 100, 2) if all_returns_t3 else 0
337:         win_rate_t5 = round(sum(1 for r in all_returns_t5 if r > 0) / len(all_returns_t5) * 100, 2) if all_returns_t5 else 0
338:         summary = {
339:             "total_days": len(trade_dates_sorted),
340:             "total_hits": sum(d["hit_count"] for d in daily_stats),
341:             "avg_hit_per_day": round(sum(d["hit_count"] for d in daily_stats) / len(trade_dates_sorted), 1),
342:             "win_rate_t1": win_rate_t1,
343:             "win_rate_t3": win_rate_t3,
344:             "win_rate_t5": win_rate_t5,
345:             "avg_return_t1": round(sum(all_returns_t1) / len(all_returns_t1), 2) if all_returns_t1 else 0,
346:             "avg_return_t3": round(sum(all_returns_t3) / len(all_returns_t3), 2) if all_returns_t3 else 0,
347:             "avg_return_t5": round(sum(all_returns_t5) / len(all_returns_t5), 2) if all_returns_t5 else 0,
348:             "market_avg_t1": round(sum(d["market_t1"] for d in daily_stats if d["market_t1"] is not None) / max(1, sum(1 for d in daily_stats if d["market_t1"] is not None)), 2),
349:             "market_avg_t3": round(sum(d["market_t3"] for d in daily_stats if d["market_t3"] is not None) / max(1, sum(1 for d in daily_stats if d["market_t3"] is not None)), 2),
350:             "market_avg_t5": round(sum(d["market_t5"] for d in daily_stats if d["market_t5"] is not None) / max(1, sum(1 for d in daily_stats if d["market_t5"] is not None)), 2),
351:         }
352:         # 超额收益 = 策略 - 市场
353:         summary["excess_t1"] = round(summary["avg_return_t1"] - summary["market_avg_t1"], 2)
354:         summary["excess_t3"] = round(summary["avg_return_t3"] - summary["market_avg_t3"], 2)
355:         summary["excess_t5"] = round(summary["avg_return_t5"] - summary["market_avg_t5"], 2)
356:         return {"daily_stats": daily_stats, "summary": summary}
357: def _query_vreversal(db, date_str, base_date, max_drawdown, min_close_up,
358:                      min_intraday_drop, require_v_shape, min_sector_hit,
359:                      max_sector_hit, view):
360:     """复用筛选 SQL, 返回命中股票列表"""
361:     sql = text("""
362:     WITH base AS (
363:         SELECT ts_code, close AS base_close
364:         FROM stock_daily_kline
365:         WHERE trade_date = :base_date
366:     ),
367:     today AS (
368:         SELECT ts_code, open, high, low, close, pct_chg,
369:                close / NULLIF((1 + pct_chg / 100.0), 0) AS pre_close
370:         FROM stock_daily_kline
371:         WHERE trade_date = :trade_date
372:     ),
373:     filtered AS (
374:         SELECT t.ts_code, t.pct_chg AS today_pct,
375:                b.base_close,
376:                ROUND(((t.close - b.base_close) / b.base_close * 100)::numeric, 2) AS period_pct
377:         FROM today t
378:         JOIN base b ON b.ts_code = t.ts_code
379:         WHERE (t.close - b.base_close) / b.base_close >= -:max_drawdown_ratio
380:           -- 抗跌含义: 区间跌幅在 -max_drawdown% ~ 0% 之间
381:           AND (t.close - b.base_close) / b.base_close <= 0
382:           -- 今日收盘涨幅 (基础约束, 不受V形态影响)
383:           AND t.pct_chg >= CASE
384:               WHEN t.ts_code LIKE '688%' OR t.ts_code LIKE '689%'
385:                    OR t.ts_code LIKE '300%' OR t.ts_code LIKE '301%'
386:               THEN :min_close_up_chinext
387:               ELSE :min_close_up_main
388:           END
389:           -- V 形态约束(可选): 盘中曾跌破 -min_intraday_drop%
390:           AND (
391:               NOT :require_v_shape
392:               OR (t.low - NULLIF(t.pre_close, 0)) / NULLIF(t.pre_close, 0) <= -:min_intraday_drop_ratio
393:           )
394:     ),
395:     stock_sector AS (
396:         SELECT DISTINCT ON (ts_code) ts_code, sector
397:         FROM stock_flow
398:         WHERE sector IS NOT NULL AND sector != ''
399:           AND trade_date >= :base_date
400:         ORDER BY ts_code, trade_date DESC
401:     ),
402:     enriched AS (
403:         SELECT f.*, s.sector,
404:                COUNT(*) OVER (PARTITION BY s.sector) AS sector_hit_count
405:         FROM filtered f
406:         LEFT JOIN stock_sector s ON s.ts_code = f.ts_code
407:     )
408:     SELECT ts_code, sector, today_pct, period_pct, sector_hit_count
409:     FROM enriched
410:     """)
411:     rows = db.execute(sql, {
412:         "base_date": base_date,
413:         "trade_date": date_str,
414:         "max_drawdown_ratio": max_drawdown / 100.0,
415:         "require_v_shape": require_v_shape,
416:         "min_intraday_drop": min_intraday_drop,
417:         "min_intraday_drop_ratio": min_intraday_drop / 100.0,
418:         "min_close_up_main": min_close_up,
419:         "min_close_up_chinext": min_close_up * 1.5,
420:     }).fetchall()
421:     all_stocks = [{
422:         "ts_code": r.ts_code,
423:         "sector": r.sector,
424:         "sector_hit_count": int(r.sector_hit_count) if r.sector else 0,
425:     } for r in rows]
426:     if view == "sector":
427:         return [s for s in all_stocks
428:                 if s["sector"]
429:                 and s["sector_hit_count"] >= min_sector_hit
430:                 and s["sector_hit_count"] <= max_sector_hit]
431:     else:
432:         return [s for s in all_stocks
433:                 if not s["sector"] or s["sector_hit_count"] <= max_sector_hit]
434: def _compute_future_returns(db, ts_codes: list, base_date, periods: list) -> dict:
435:     """算命中股票在 T+N 的收益率(基于收盘价)
436:     Args:
437:         db: DB session
438:         ts_codes: 命中股票代码列表
439:         base_date: 基准日 (命中日, 即 T 日)
440:         periods: [1, 3, 5]
441:     Returns: {1: [(ts_code, t1_return), ...], 3: ..., 5: ...}
442:     """
443:     if not ts_codes:
444:         return {p: [] for p in periods}
445:     # 取 base_date 后 periods_max 个交易日的收盘价
446:     max_p = max(periods)
447:     placeholders = ','.join([f":c{i}" for i in range(len(ts_codes))])
448:     params = {f"c{i}": c for i, c in enumerate(ts_codes)}
449:     params["base_date"] = base_date
450:     params["limit"] = max_p + 1
451:     sql = text(f"""
452:     WITH future_dates AS (
453:         SELECT trade_date,
454:                ROW_NUMBER() OVER (ORDER BY trade_date) AS rn
455:         FROM (
456:             SELECT DISTINCT trade_date
457:             FROM stock_daily_kline
458:             WHERE trade_date > :base_date
459:             ORDER BY trade_date
460:             LIMIT :limit
461:         ) sub
462:     )
463:     SELECT k.ts_code, k.trade_date, k.close,
464:            fd.rn
465:     FROM stock_daily_kline k
466:     JOIN future_dates fd ON fd.trade_date = k.trade_date
467:     WHERE k.ts_code IN ({placeholders})
468:       AND k.trade_date > :base_date
469:     """)
470:     rows = db.execute(sql, params).fetchall()
471:     # 组织为 {ts_code: {rn: close}}
472:     by_code = {}
473:     # 注意: SQLAlchemy Row 对象不能直接 dict() 转 {col: val},
474:     # 必须用 r[0]: r[1] 显式取列
475:     base_closes = {
476:         r[0]: float(r[1]) for r in db.execute(text(
477:             "SELECT ts_code, close FROM stock_daily_kline "
478:             "WHERE trade_date = :d AND ts_code IN " + f"({placeholders})"
479:         ), {**params, "d": base_date}).fetchall()
480:         if r[1] is not None
481:     }
482:     for r in rows:
483:         by_code.setdefault(r.ts_code, {})[r.rn] = float(r.close) if r.close is not None else None
484:     result = {p: [] for p in periods}
485:     for code in ts_codes:
486:         base = base_closes.get(code)
487:         if not base:
488:             continue
489:         for p in periods:
490:             future_close = by_code.get(code, {}).get(p)
491:             if future_close:
492:                 ret = round((future_close - base) / base * 100, 2)
493:                 result[p].append((code, ret))
494:     return result
495: def _compute_market_returns(db, base_date, periods: list) -> dict:
496:     """算大盘基准: 用全市场平均日涨跌幅累计
497:     每日市场收益率 = AVG(pct_chg) FROM stock_daily_kline WHERE trade_date = X
498:     T+N 累计 = ((1+r1)*(1+r2)*...*(1+rN) - 1) * 100
499:     Args:
500:         db: DB session
501:         base_date: 命中日 (T 日)
502:         periods: [1, 3, 5]
503:     Returns: {1: t1_return, 3: t3_return, 5: t5_return}
504:     """
505:     max_p = max(periods)
506:     sql = text("""
507:     WITH future_dates AS (
508:         SELECT trade_date,
509:                ROW_NUMBER() OVER (ORDER BY trade_date) AS rn
510:         FROM (
511:             SELECT DISTINCT trade_date
512:             FROM stock_daily_kline
513:             WHERE trade_date > :base_date
514:             ORDER BY trade_date
515:             LIMIT :limit
516:         ) sub
517:     )
518:     SELECT fd.rn, AVG(k.pct_chg) AS avg_pct
519:     FROM stock_daily_kline k
520:     JOIN future_dates fd ON fd.trade_date = k.trade_date
521:     WHERE k.pct_chg IS NOT NULL
522:     GROUP BY fd.rn
523:     """)
524:     rows = db.execute(sql, {"base_date": base_date, "limit": max_p}).fetchall()
525:     daily_avg = {
526:         r.rn: float(r.avg_pct) if r.avg_pct is not None else None
527:         for r in rows
528:     }
529:     result = {}
530:     for p in periods:
531:         if not daily_avg:
532:             result[p] = None
533:             continue
534:         # 检查 1~p 的数据是否齐全
535:         if any(daily_avg.get(i) is None for i in range(1, p + 1)):
536:             result[p] = None
537:             continue
538:         cum = 1.0
539:         for i in range(1, p + 1):
540:             cum *= (1 + daily_avg[i] / 100.0)
541:         result[p] = round((cum - 1) * 100, 2)
542:     return result
</file>

