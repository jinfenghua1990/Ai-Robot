 98:         <div className="flex-1 grid gap-1.5 overflow-hidden p-1.5" style={{ gridTemplateColumns: '1fr 1fr', minHeight: 0 }}>
 99:           {/* 左列：K线主图 / 成交量 / MACD+KDJ */}
100:           <div className="overflow-hidden" style={{ minWidth: 0 }}>
