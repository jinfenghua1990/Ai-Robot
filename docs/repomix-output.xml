156:             final_value = median
157:             r.status = 'approved'
158:             r.final_value = final_value
159:             r.reviewed_by = 'auto_reverify'
160:             r.reviewed_at = datetime.now()
161:             r.reason = f'[盘后复验·低置信度] CV={cv:.1f}%>15%，盘后仍分歧，取中位数。建议次日关注'
162:             r.sources_data = json.dumps(new_sources, ensure_ascii=False, default=str)
163:             forced_pass += 1
164:             print(f'  {r.ts_code} {r.indicator}: ⚠️ 盘后仍分歧 CV={cv:.1f}%，取中位数={final_value:.2f}')
165:         # 同步更新历史表的权威值
166:         hist = db.query(StockFlow).filter_by(
167:             trade_date=trade_date, ts_code=r.ts_code
168:         ).first()
169:         if hist and r.final_value is not None:
