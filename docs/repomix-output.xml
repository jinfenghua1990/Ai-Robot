 76:         "strategies": _parse_strategies(t.strategies_json),
 77:         "strategy_count": t.strategy_count,
 78:         "pool_score": _f(t.pool_score),
 79:         "pool_close": _f(t.pool_close),
 80:         "track_days": t.track_days,
 81:         "status": t.status,
 82:         "exit_date": _d(t.exit_date),
 83:         "exit_reason": t.exit_reason,
 84:         "exit_price": _f(t.exit_price),
 85:         "exit_return_pct": _f(t.exit_return_pct),
 86:         "latest_day": t.latest_day,
 87:         "latest_trade_date": _d(t.latest_trade_date),
 88:         "latest_close": _f(t.latest_close),
 89:         "latest_pct": _f(t.latest_pct),
 90:         "latest_daily_chg": _f(t.latest_daily_chg),
 91:         "latest_bs_signal": t.latest_bs_signal,
 92:         "latest_bs_reason": t.latest_bs_reason,
 93:         "max_return_pct": _f(t.max_return_pct),
 94:         "min_return_pct": _f(t.min_return_pct),
 95:         "created_at": _d(t.created_at),
 96:         "updated_at": _d(t.updated_at),
 97:     }
 98:     if include_daily:
 99:         q = (
100:             db.query(StrategyTrackDaily)
101:             .filter(StrategyTrackDaily.tracker_id == t.id)
102:             .order_by(StrategyTrackDaily.day_n.asc())
103:         )
104:         if daily_limit is not None:
105:             q = q.limit(daily_limit)
106:         row["daily"] = [_serialize_daily(d) for d in q.all()]
