  1: """
  2: 个股全聚合单页面接口（双轨制中转层 - 聚合轨）
  3: - GET /api/v1/stock/super_panel?code=600xxx  →  静态 + 实时 一次返回
  4: - GET /api/v1/stock/super_panel?code=600xxx&section=realtime  →  仅返回实时（3 秒轮询用）
  5: 为什么单点聚合而不是让前端拼装:
  6: - 盘后静态 7 个表, 1 次 JOIN 完成 vs 前端 N 次请求
  7: - 盘中实时走内存 dict, 0 DB
  8: - 前端只读不拼, 失败降级统一在服务端处理
  9: """
 10: import logging
 11: from datetime import datetime, timedelta, time as dtime
 12: from fastapi import APIRouter, Query
 13: from db.session import get_db_session
 14: from db.models import (
 15:     YuziQuantSignal, YuziSeatDaily, YuziDict, YuziLifecycleTracker,
 16:     ConceptSector, ConceptSectorFlow, Watchlist,
 17: )
 18: from collectors.realtime_aggregator import serialize_state, REALTIME_STATE
 19: logger = logging.getLogger(__name__)
 20: router = APIRouter()
 21: def _normalize_ts_code(code: str) -> str:
 22:     """6 位代码 → ts_code 格式"""
 23:     if not code:
 24:         return ''
 25:     code = str(code).strip()
 26:     if '.' in code:
 27:         return code.upper()
 28:     if code.startswith('6') or code.startswith('9'):
 29:         return f'{code}.SH'
 30:     if code.startswith('8') or code.startswith('4'):
 31:         return f'{code}.BJ'
 32:     return f'{code}.SZ'
 33: def _is_trading_hours() -> bool:
 34:     """是否在盘中交易时段(9:30-11:30 / 13:00-15:00)"""
 35:     now = datetime.now()
 36:     if now.weekday() >= 5:
 37:         return False
 38:     t = now.time()
 39:     return (dtime(9, 30) <= t <= dtime(11, 30)) or (dtime(13, 0) <= t <= dtime(15, 0))
 40: def _load_post_market_base(ts_code: str) -> dict:
 41:     """盘后静态数据(7 个表 → 1 次聚合, 全部 DB 读)"""
 42:     stock_code = ts_code.split('.')[0]
 43:     out = {
 44:         'quant_score': None,
 45:         'quant_rank': None,
 46:         'total_net_buy_wan': 0,
 47:         'resonance_count': 0,
 48:         'concept_sector': '',
 49:         'sector_hot_money_count': 0,
 50:         'sector_heat_score': None,
 51:         'lifecycle_7d': [],
 52:         'lifecycle_20d': [],
 53:         'yesterday_bosses': [],
 54:         'in_watchlist': False,
 55:         'note': '',
 56:     }
 57:     try:
 58:         with get_db_session() as db:
 59:             # 1) 量化共振分(游资维度)
 60:             sig = db.query(YuziQuantSignal).filter(
 61:                 YuziQuantSignal.ts_code == ts_code
 62:             ).order_by(YuziQuantSignal.trade_date.desc()).first()
 63:             if sig:
 64:                 out['quant_score'] = float(sig.quant_score or 0) if sig.quant_score else None
 65:                 out['total_net_buy_wan'] = float(sig.total_net_buy or 0) if sig.total_net_buy else 0
 66:                 out['resonance_count'] = int(sig.resonance_count or 0) if sig.resonance_count else 0
 67:                 out['concept_sector'] = sig.sector or ''
 68:                 out['stock_name'] = sig.stock_name or ''
 69:                 out['change_pct'] = float(sig.change_pct or 0) if sig.change_pct else None
 70:                 out['list_reason'] = sig.list_reason or ''
 71:             # 2) 昨日 / 近期游资席位(从席位明细倒推)
 72:             seat_rows = db.query(YuziSeatDaily).filter(
 73:                 YuziSeatDaily.ts_code == ts_code
 74:             ).order_by(YuziSeatDaily.trade_date.desc()).limit(20).all()
 75:             # 按 (seat_name, trade_date) 聚合 → 找"最近 1 个交易日"
 76:             seen_dates = sorted({r.trade_date for r in seat_rows}, reverse=True)
 77:             latest_date = seen_dates[0] if seen_dates else None
 78:             if latest_date:
 79:                 latest_seats = [r for r in seat_rows if r.trade_date == latest_date]
 80:                 # 关联 yuzi_dict 拿别名
 81:                 seat_names = list({r.seat_name for r in latest_seats})
 82:                 alias_map = {}
 83:                 if seat_names:
 84:                     for d in db.query(YuziDict).filter(YuziDict.seat_name.in_(seat_names)).all():
 85:                         alias_map[d.seat_name] = d.yuzi_alias
 86:                 bosses = []
 87:                 for r in latest_seats:
 88:                     alias = alias_map.get(r.seat_name) or r.yuzi_alias or r.seat_name
 89:                     net = float(r.net_amount or 0) if r.net_amount else 0
 90:                     # 推断 action: net > 0 新进, =0 锁仓, <0 砸盘
 91:                     if net > 100:
 92:                         action = '新进'
 93:                     elif net < -100:
 94:                         action = '砸盘'
 95:                     else:
 96:                         action = '锁仓'
 97:                     bosses.append({
 98:                         'name': alias,
 99:                         'seat': r.seat_name,
100:                         'action': action,
101:                         'net_buy_wan': round(net, 2),
102:                     })
103:                 # 净买入降序
104:                 bosses.sort(key=lambda x: x['net_buy_wan'], reverse=True)
105:                 out['yesterday_bosses'] = bosses[:8]
106:                 out['yesterday_trade_date'] = latest_date
107:             # 3) 板块热度(从 concept_sector_flow 找最近 1 日)
108:             if out['concept_sector']:
109:                 cs = db.query(ConceptSector).filter(
110:                     ConceptSector.name == out['concept_sector']
111:                 ).first()
112:                 if cs:
113:                     from db.models import ConceptSectorFlow
114:                     latest_sector_flow = db.query(ConceptSectorFlow).filter(
115:                         ConceptSectorFlow.concept_sector_id == cs.id
116:                     ).order_by(ConceptSectorFlow.trade_date.desc()).first()
117:                     if latest_sector_flow:
118:                         out['sector_heat_score'] = float(latest_sector_flow.heat_score or 0) if latest_sector_flow.heat_score else None
119:                         # 同板块共振股数(quant_score >= 70 视为游资共振)
120:                         out['sector_hot_money_count'] = db.query(YuziQuantSignal).filter(
121:                             YuziQuantSignal.sector == out['concept_sector'],
122:                             YuziQuantSignal.quant_score >= 70,
123:                         ).count()
124:             # 4) 20 个交易日生命周期(YuziLifecycleTracker)
125:             # 覆盖一个完整中期波段(建仓→主升→派发),与机构月度复盘周期对齐
126:             tracker = db.query(YuziLifecycleTracker).filter(
127:                 YuziLifecycleTracker.ts_code == ts_code
128:             ).order_by(YuziLifecycleTracker.trigger_date.desc()).first()
129:             if tracker and tracker.lifecycle_data:
130:                 # lifecycle_data 是 JSONB dict, 形如 {d1:..., d2:..., d3:...}
131:                 lc = tracker.lifecycle_data if isinstance(tracker.lifecycle_data, dict) else {}
132:                 trigger = tracker.trigger_date
133:                 # 后续 d2-d20 算实际日期
134:                 try:
135:                     base = datetime.strptime(trigger, '%Y%m%d').date()
136:                 except Exception:
137:                     base = datetime.now().date()
138:                 for d in range(1, 21):
139:                     day = base + timedelta(days=d - 1)
140:                     key = f'd{d}'
141:                     info = lc.get(key) or {}
142:                     stage = info.get('price_stage') or info.get('stage') or '—'
143:                     score = info.get('quant_score') or info.get('score')
144:                     day_data = {
145:                         'date': day.strftime('%Y%m%d'),
146:                         'stage': stage,
147:                         'score': float(score) if score else None,
148:                     }
149:                     out['lifecycle_7d'].append(day_data)
150:                     out['lifecycle_20d'].append(day_data)
151:             # 5) 自选状态
152:             wl = db.query(Watchlist).filter_by(stock_code=stock_code).first()
153:             if wl:
154:                 out['in_watchlist'] = True
155:                 out['note'] = wl.note or ''
156:                 out['watchlist_group'] = wl.group_name or '默认'
157:     except Exception as e:
158:         logger.error(f'[super_panel] load post_market_base failed for {ts_code}: {e}', exc_info=True)
159:         out['error'] = str(e)
160:     return out
161: def _realtime_section(ts_code: str) -> dict:
162:     """盘中实时(从内存 REALTIME_STATE dict 读, 0 DB)"""
163:     state = REALTIME_STATE.get(ts_code)
164:     if not state:
165:         # 占位: 收盘或未采集
166:         if _is_trading_hours():
167:             return {
168:                 'available': False,
169:                 'status': 'pending',
170:                 'message': '盘中实时数据采集中, 请稍候 3 秒',
171:             }
172:         return {
173:             'available': False,
174:             'status': 'closed',
175:             'message': '非交易时段, 实时数据未采集',
176:         }
177:     s = serialize_state(ts_code)
178:     s['available'] = True
179:     s['status'] = 'live'
180:     # 计算 pct_chg 需要昨收价, 取自 state.last_close 字段
181:     last_close = getattr(state, 'last_close', 0) or 0
182:     if last_close and s.get('current_price'):
183:         s['pct_chg'] = round((s['current_price'] - last_close) / last_close * 100, 2)
184:     return s
185: @router.get('/api/v1/stock/super_panel')
186: def super_panel(code: str = Query(..., description='股票代码, 6位 或 ts_code 格式'),
187:                 section: str = Query('all', description='all / realtime / static')):
188:     """
189:     个股全聚合单页面接口
190:     - section=all: 静态+实时全部返回
191:     - section=static: 只返回盘后静态
192:     - section=realtime: 只返回盘中实时(前端 3 秒轮询用)
193:     """
194:     ts_code = _normalize_ts_code(code)
195:     if not ts_code:
196:         return {'error': 'invalid code'}
197:     update_time = datetime.now().isoformat(timespec='seconds')
198:     state = REALTIME_STATE.get(ts_code)
199:     realtime_health = 'live' if state else ('closed' if not _is_trading_hours() else 'stale')
200:     if section == 'realtime':
201:         return {
202:             'ts_code': ts_code,
203:             'update_time': update_time,
204:             'realtime_intraday': _realtime_section(ts_code),
205:             'source_health': {'static': 'ok', 'realtime': realtime_health},
206:         }
207:     if section == 'static':
208:         return {
209:             'ts_code': ts_code,
210:             'update_time': update_time,
211:             'post_market_base': _load_post_market_base(ts_code),
212:             'source_health': {'static': 'ok', 'realtime': realtime_health},
213:         }
214:     # section=all
215:     return {
216:         'ts_code': ts_code,
217:         'update_time': update_time,
218:         'source_health': {
219:             'static': 'ok',
220:             'realtime': realtime_health,
221:         },
222:         'post_market_base': _load_post_market_base(ts_code),
223:         'realtime_intraday': _realtime_section(ts_code),
224:     }
225: @router.get('/api/v1/stock/super_panel/health')
226: def super_panel_health():
227:     """健康检查: 返回当前 REALTIME_STATE 中股票数 + 调度状态"""
228:     from collectors.scheduler import _is_intraday_trading_hours
229:     return {
230:         'realtime_state_count': len(REALTIME_STATE),
231:         'trading_hours': _is_intraday_trading_hours(),
232:         'ts_codes_sample': list(REALTIME_STATE.keys())[:20],
233:         'check_time': datetime.now().isoformat(timespec='seconds'),
234:     }
