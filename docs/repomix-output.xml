<file path="backend/quant_vnext/alpha158_engine.py">
 1: """Small, dependency-free evaluator for the local Alpha158 research subset."""
 2: from __future__ import annotations
 3: import math
 4: from datetime import date
 5: from statistics import mean, pstdev
 6: from typing import Mapping, Sequence
 7: from .alpha158_catalog import ALPHA158_RESEARCH_FACTORS
 8: from .contracts import DailyBar, FactorValue
 9: def _corr(left: Sequence[float], right: Sequence[float]) -> float | None:
10:     if len(left) != len(right) or len(left) < 3:
11:         return None
12:     left_mean, right_mean = mean(left), mean(right)
13:     left_dev = sum((value - left_mean) ** 2 for value in left) ** 0.5
14:     right_dev = sum((value - right_mean) ** 2 for value in right) ** 0.5
15:     if not left_dev or not right_dev:
16:         return None
17:     return sum((a - left_mean) * (b - right_mean) for a, b in zip(left, right)) / (left_dev * right_dev)
18: def _slope(values: Sequence[float]) -> float:
19:     x_mean = (len(values) - 1) / 2
20:     y_mean = mean(values)
21:     denominator = sum((index - x_mean) ** 2 for index in range(len(values)))
22:     return sum((index - x_mean) * (value - y_mean) for index, value in enumerate(values)) / denominator if denominator else 0.0
23: def _rsquare(values: Sequence[float]) -> float:
24:     correlation = _corr(list(range(len(values))), values)
25:     return correlation * correlation if correlation is not None else 0.0
26: def _value(name: str, category: str, ts_code: str, trade_date: date, raw: float | None, reason: str = "") -> FactorValue:
27:     valid = raw is not None and math.isfinite(float(raw))
28:     return FactorValue(ts_code, trade_date, name, category, float(raw) if valid else None, None, valid, reason if not valid else "")
29: class Alpha158ResearchEngine:
30:     """Evaluate only the explicitly approved research subset, never production factors."""
31:     def calculate(self, history: Mapping[str, Sequence[DailyBar]], trade_date: date, market=None) -> list[FactorValue]:
32:         definitions = {item.name: item for item in ALPHA158_RESEARCH_FACTORS}
33:         result: list[FactorValue] = []
34:         for ts_code, source_bars in history.items():
35:             bars = sorted((bar for bar in source_bars if bar.trade_date <= trade_date), key=lambda bar: bar.trade_date)
36:             if not bars or bars[-1].trade_date != trade_date:
37:                 continue
38:             closes = [bar.close for bar in bars]
39:             highs = [bar.high for bar in bars]
40:             lows = [bar.low for bar in bars]
41:             volumes = [bar.volume for bar in bars]
42:             window = 20
43:             recent_close = closes[-window:]
44:             recent_high = highs[-window:]
45:             recent_low = lows[-window:]
46:             recent_volume = volumes[-window:]
47:             changes = [closes[index] / closes[index - 1] - 1 for index in range(1, len(closes)) if closes[index - 1]]
48:             recent_changes = changes[-window:]
49:             values = {
50:                 "qlib_roc_5d": closes[-6] / closes[-1] if len(closes) >= 6 and closes[-1] else None,
51:                 "qlib_roc_20d": closes[-21] / closes[-1] if len(closes) >= 21 and closes[-1] else None,
52:                 "qlib_ma_gap_20d": mean(recent_close) / closes[-1] if len(recent_close) == window and closes[-1] else None,
53:                 "qlib_beta_20d": _slope(recent_close) / closes[-1] if len(recent_close) == window and closes[-1] else None,
54:                 "qlib_rsqr_20d": _rsquare(recent_close) if len(recent_close) == window else None,
55:                 "qlib_rsv_20d": (closes[-1] - min(recent_low)) / (max(recent_high) - min(recent_low) + 1e-12) if len(recent_close) == window else None,
56:                 "qlib_std_20d": pstdev(recent_close) / closes[-1] if len(recent_close) == window and closes[-1] else None,
57:                 "qlib_corr_price_volume_20d": _corr(recent_close, [math.log(volume + 1) for volume in recent_volume]) if len(recent_close) == window else None,
58:                 "qlib_cntd_20d": (sum(change > 0 for change in recent_changes) - sum(change < 0 for change in recent_changes)) / window if len(recent_changes) == window else None,
59:                 "qlib_sump_20d": sum(max(change, 0) for change in recent_changes) / (sum(abs(change) for change in recent_changes) + 1e-12) if len(recent_changes) == window else None,
60:                 "qlib_vma_20d": mean(recent_volume) / (volumes[-1] + 1e-12) if len(recent_volume) == window else None,
61:                 "qlib_vstd_20d": pstdev(recent_volume) / (volumes[-1] + 1e-12) if len(recent_volume) == window else None,
62:                 "qlib_wvma_20d": (
63:                     pstdev([abs(change) * volume for change, volume in zip(recent_changes, volumes[-window:])])
64:                     / (mean([abs(change) * volume for change, volume in zip(recent_changes, volumes[-window:])]) + 1e-12)
65:                     if len(recent_changes) == window else None
66:                 ),
67:             }
68:             for name, definition in definitions.items():
69:                 result.append(_value(name, definition.category, ts_code, trade_date, values[name], "insufficient_history"))
70:         return result
