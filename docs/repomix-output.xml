 26: def _is_trading_day(date_str):
 27:     return jobs._is_trading_day(date_str)
 28: def _is_intraday_trading_hours():
 29:     """判断当前是否在盘中交易时段（9:25-11:30, 13:00-15:00）"""
 30:     now = datetime.now()
 31:     if now.weekday() >= 5:
 32:         return False
 33:     t = now.hour * 100 + now.minute
 34:     return (925 <= t <= 1130) or (1300 <= t <= 1500)
 35: def _has_today_data():
 36:     return jobs._has_today_data()
