475:             ema20 = ema20_vals[-1] if ema20_vals else None
476:             ma50 = ma50_vals[-1] if ma50_vals else None
477:             # 突破评分
478:             high_52w = max(closes[-252:]) if len(closes) >= 252 else max(closes)
479:             base_high = max(closes[-20:]) if len(closes) >= 20 else max(closes)
480:             base_low = min(closes[-20:]) if len(closes) >= 20 else min(closes)
481:             rel_vol = (volumes[-1] / (sum(volumes[-5:]) / 5)) if len(volumes) >= 5 else 1.0
482:             change_today = (closes[-1] - closes[-2]) / closes[-2] * 100 if len(closes) >= 2 else 0
483:             bs = score_breakout(
