 79:     # 后台写入 stock_daily_kline 表缓存（不阻塞返回）
 80:     _cache_kline_to_db(ts_code, ts_data)
 81:     # === 复权处理：用 adj_factor 修正价格，使 MA/ATR 不受除权除息影响 ===
 82:     try:
