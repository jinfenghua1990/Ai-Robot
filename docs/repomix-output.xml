 64: def _reverify_pending_reviews(trade_date, db):
 65:     """
 66:     盘后复验pending审核记录：
 67:     1. 重新采集多源数据验证
 68:     2. CV≤15% → 自动通过
 69:     3. CV>15% → 取中位数作为最终值（低置信度），标注"盘后复验仍分歧"
 70:     4. 确保所有pending记录都有最终值，不再遗留
 71:     """
 72:     pending = db.query(ManualReviewQueue).filter_by(status='pending').all()
 73:     if not pending:
 74:         print('[reverify] 无pending审核记录')
 75:         return
 76:     print(f'[reverify] 复验 {len(pending)} 条pending记录')
 77:     # 批量获取腾讯财经价格（用于价格指标复验）
 78:     ts_codes = list({r.ts_code for r in pending})
 79:     tencent_data = batch_realtime_quotes(ts_codes) if ts_codes else {}
 80:     # 批量获取国信证券数据（用于资金流向复验）
 81:     guosen_data = {}
 82:     try:
 83:         from collectors.guosen_collector import guosen_single_fund_flow
 84:         for code in ts_codes[:20]:  # 限制20只避免额度问题
 85:             data = guosen_single_fund_flow(code)
 86:             if data:
 87:                 guosen_data[code] = data
 88:     except Exception as e:
 89:         print(f'[reverify] 国信证券采集失败: {e}')
 90:     auto_passed = 0
 91:     forced_pass = 0
 92:     for r in pending:
 93:         # 重新采集多源数据
 94:         new_sources = {}
 95:         # 东方财富：从最新快照获取
 96:         latest_rt = db.query(RealtimeStockFlow).filter_by(
 97:             trade_date=trade_date, ts_code=r.ts_code
 98:         ).order_by(RealtimeStockFlow.snapshot_time.desc()).first()
 99:         if latest_rt:
100:             if r.indicator == 'main_force_inflow':
101:                 new_sources['eastmoney'] = float(latest_rt.main_force_inflow or 0)
102:             elif r.indicator == 'price':
103:                 new_sources['eastmoney'] = float(latest_rt.price or 0)
104:             elif r.indicator == 'price_chg':
105:                 new_sources['eastmoney'] = float(latest_rt.price_chg or 0)
106:         # 腾讯财经：价格
107:         if r.ts_code in tencent_data and r.indicator == 'price':
108:             new_sources['tencent'] = float(tencent_data[r.ts_code].get('price', 0) or 0)
109:         # 国信证券：资金流向+价格
110:         if r.ts_code in guosen_data:
111:             gd = guosen_data[r.ts_code]
112:             if r.indicator == 'main_force_inflow' and gd.get('main_force_inflow') is not None:
113:                 new_sources['guosen'] = float(gd['main_force_inflow'])
114:         # 合并原始数据
115:         try:
116:             old_raw = json.loads(r.sources_data) if r.sources_data else {}
117:             for k, v in old_raw.items():
118:                 val = v.get('value') if isinstance(v, dict) else v
119:                 if val is not None and k not in new_sources:
120:                     new_sources[k] = float(val)
121:         except Exception:
122:             logger.debug('handled exception', exc_info=True)
123:         vals = list(new_sources.values())
124:         if not vals:
125:             # 无数据，强制拒绝
126:             r.status = 'rejected'
127:             r.reviewed_by = 'auto_reverify'
128:             r.reviewed_at = datetime.now()
129:             r.reason = f'[盘后复验] 无有效数据，拒绝'
130:             forced_pass += 1
131:             continue
132:         median = statistics.median(vals)
133:         mean = statistics.mean(vals)
134:         std = statistics.stdev(vals) if len(vals) > 1 else 0
135:         cv = (std / abs(mean) * 100) if mean else 0
136:         if cv <= 15.0:
137:             # CV≤15%：自动通过
138:             if cv <= 5.0:
139:                 final_value = statistics.mean(vals)
140:                 confidence = '高'
141:                 reason = f'盘后复验CV={cv:.1f}%≤5%，取平均值'
142:             else:
143:                 final_value = median
144:                 confidence = '中'
145:                 reason = f'盘后复验CV={cv:.1f}%≤15%，取中位数'
146:             r.status = 'approved'
147:             r.final_value = final_value
148:             r.reviewed_by = 'auto_reverify'
149:             r.reviewed_at = datetime.now()
150:             r.reason = f'[盘后复验·{confidence}置信度] {reason}'
151:             r.sources_data = json.dumps(new_sources, ensure_ascii=False, default=str)
152:             auto_passed += 1
153:             print(f'  {r.ts_code} {r.indicator}: ✅ 复验通过({confidence}) CV={cv:.1f}% 值={final_value:.2f}')
154:         else:
