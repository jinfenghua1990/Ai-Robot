 34: # ---------------------------------------------------------------------------
 35: def _fetch_gtimg(prefixed_codes: list[str]) -> str:
 36:     url = "https://qt.gtimg.cn/q=" + ",".join(prefixed_codes)
 37:     last_exc = None
 38:     for attempt in range(3):           # 腾讯行情偶发连接重置，加重试兜底
 39:         try:
 40:             req = urllib.request.Request(url, headers={"User-Agent": UA})
 41:             with urllib.request.urlopen(req, timeout=10) as resp:
 42:                 return resp.read().decode("gbk")
 43:         except Exception as e:
 44:             last_exc = e
 45:             if attempt < 2:
 46:                 time.sleep(0.4 * (attempt + 1) + random.uniform(0, 0.3))
 47:     raise last_exc or RuntimeError("_fetch_gtimg failed")
 48: def _parse_gtimg(data: str) -> dict[str, dict]:
 49:     result: dict[str, dict] = {}
 50:     for line in data.strip().split(";"):
 51:         if not line.strip() or "=" not in line or '"' not in line:
 52:             continue
 53:         key = line.split("=")[0].split("_")[-1]
 54:         vals = line.split('"')[1].split("~")
 55:         if len(vals) < 53:
 56:             continue
 57:         code = key[2:]
 58:         def num(i: int) -> float:
 59:             try:
 60:                 return float(vals[i]) if vals[i] else 0.0
 61:             except (ValueError, IndexError):
 62:                 return 0.0
 63:         result[code] = {
 64:             "name": vals[1],
 65:             "price": num(3),
 66:             "last_close": num(4),
 67:             "open": num(5),
 68:             "change_amt": num(31),
 69:             "change_pct": num(32),
 70:             "high": num(33),
 71:             "low": num(34),
 72:             "amount_wan": num(37),
 73:             "turnover_pct": num(38),
 74:             "pe_ttm": num(39),
 75:             "amplitude_pct": num(43),
 76:             "mcap_yi": num(44),
 77:             "float_mcap_yi": num(45),
 78:             "pb": num(46),
 79:             "limit_up": num(47),
 80:             "limit_down": num(48),
 81:             "vol_ratio": num(49),
 82:             "pe_static": num(52),
 83:         }
 84:     return result
 85: def tencent_quote(codes: list[str]) -> dict[str, dict]:
 86:     """批量个股实时行情：现价 / 涨跌 / PE / PB / 市值 / 换手 / 涨跌停。"""
 87:     prefixed = [f"{get_prefix(c)}{c}" for c in codes]
 88:     return _parse_gtimg(_fetch_gtimg(prefixed))
 89: # A股大盘指数（前缀规则与个股不同，固定带前缀代码）
 90: A_INDICES = ["sh000001", "sz399001", "sz399006", "sh000300"]
 91: def index_quote() -> list[dict]:
 92:     """A股大盘指数实时行情（上证/深证成指/创业板指/沪深300）。"""
 93:     parsed = _parse_gtimg(_fetch_gtimg(A_INDICES))
 94:     out = []
 95:     for full in A_INDICES:
