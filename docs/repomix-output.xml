  5: /**
  6:  * BS策略轻量Tab组件
  7:  * 接受一个回测策略参数，自动扫描并展示结果
  8:  * 用于策略中心扁平化Tab
  9:  */
 10: export default function BSStrategyTab({ strategy }) {
 11:   const [result, setResult] = useState(null);
 12:   const [scanning, setScanning] = useState(false);
 13:   const [error, setError] = useState(null);
 14:   const runScan = useCallback(async () => {
 15:     if (!strategy) return;
 16:     setScanning(true);
 17:     setError(null);
 18:     try {
 19:       // 优先读预计算结果（盘后定时任务已落库），无则 fallback 现场扫描
 20:       if (strategy.id) {
 21:         const todayRes = await apiFetch(`/api/bs-screener/today?backtest_id=${strategy.id}`);
 22:         if (todayRes.ok) {
 23:           setResult(todayRes.data);
 24:           return;
 25:         }
 26:       }
 27:       // fallback：现场扫描
 28:       const qs = new URLSearchParams({
 29:         atr_period: String(strategy.atr_period),
 30:         atr_multiplier: String(strategy.atr_multiplier),
 31:         scan_limit: '9999',
 32:         sector: '',
 33:         signal_type: 'B',
 34:         volume_filter: String(strategy.volume_filter || false),
 35:         ma20_filter: String(strategy.ma20_filter || false),
 36:         ma60_trend: String(strategy.ma60_trend || false),
 37:         rsi_filter: String(strategy.rsi_filter || false),
 38:         strong_volume: String(strategy.strong_volume || false),
 39:         macd_filter: String(strategy.macd_filter || false),
 40:         kdj_filter: String(strategy.kdj_filter || false),
 41:         rsi_lower: String(strategy.rsi_lower || 30),
 42:         rsi_upper: String(strategy.rsi_upper || 70),
 43:         dimension: String(strategy.dimension || ''),
 44:       }).toString();
 45:       const { ok, data, status } = await apiFetch(`/api/bs-screener/run?${qs}`);
 46:       if (!ok) throw new Error(`扫描失败: ${status}`);
 47:       setResult(data);
 48:     } catch (e) {
 49:       setError(e.message);
 50:     } finally {
 51:       setScanning(false);
 52:     }
 53:   }, [strategy]);
 54:   // 首次挂载自动扫描
 55:   useEffect(() => {
 56:     runScan();
 57:   }, [runScan]);
 58:   const handleExportCSV = () => {
 59:     if (!result?.signals?.length) return;
 60:     const header = '代码,名称,板块,信号,价格,ATR上轨,涨幅%\n';
 61:     const rows = result.signals.map(s =>
 62:       `${s.ts_code},${s.name || ''},${s.sector || ''},${s.signal_type || 'B'},${s.price || ''},${s.atr_upper || ''},${s.change_pct || ''}`
 63:     ).join('\n');
 64:     const blob = new Blob([header + rows], { type: 'text/csv;charset=utf-8' });
 65:     const url = URL.createObjectURL(blob);
 66:     const a = document.createElement('a');
 67:     a.href = url;
 68:     a.download = `BS_${strategy.name}_${new Date().toISOString().slice(0, 10)}.csv`;
 69:     a.click();
 70:     URL.revokeObjectURL(url);
 71:   };
 72:   const pf = strategy.profit_factor >= 999 ? 999 : strategy.profit_factor;
 73:   const tabColor = pf >= 2.0 && strategy.win_rate >= 45 ? '#ef4444' : pf >= 1.5 ? '#eab308' : '#6b7280';
 74:   const dimensionLabel = strategy.dimension === 'star' ? '科创板' : strategy.dimension === 'chinext' ? '创业板' : strategy.dimension === 'all' ? '全A股' : strategy.dimension;
 75:   return (
 76:     <div className="space-y-2">
 77:       {/* 策略信息栏 */}
 78:       <div className="flex items-center justify-between px-3 py-2 rounded-lg border" style={{ borderColor: 'var(--border-color)', background: 'var(--bg-card)' }}>
 79:         <div className="flex items-center gap-3 text-xs">
 80:           <span style={{ color: 'var(--text-primary)' }}>
 81:             <strong>{strategy.name}</strong>
 82:             <span className="ml-1.5 px-1.5 py-0.5 rounded" style={{ background: 'var(--bg-hover)', color: 'var(--text-muted)' }}>{dimensionLabel}</span>
 83:           </span>
 84:           <span style={{ color: 'var(--text-muted)' }}>
 85:             ATR({strategy.atr_period},{strategy.atr_multiplier})
 86:             {[strategy.ma60_trend && 'MA60', strategy.rsi_filter && `RSI(${strategy.rsi_lower}-${strategy.rsi_upper})`, strategy.macd_filter && 'MACD', strategy.strong_volume && '强量'].filter(Boolean).join('+') && ` +${[strategy.ma60_trend && 'MA60', strategy.rsi_filter && `RSI(${strategy.rsi_lower}-${strategy.rsi_upper})`, strategy.macd_filter && 'MACD', strategy.strong_volume && '强量'].filter(Boolean).join('+')}`}
 87:           </span>
 88:         </div>
 89:         <div className="flex items-center gap-2 text-xs">
 90:           <span style={{ color: 'var(--text-muted)' }}>回测胜率 <strong style={{ color: strategy.win_rate >= 50 ? '#ef4444' : 'var(--text-secondary)' }}>{strategy.win_rate}%</strong></span>
 91:           <span style={{ color: 'var(--text-muted)' }}>盈亏比 <strong style={{ color: '#eab308' }}>{pf >= 999 ? '∞' : pf}</strong></span>
 92:           <span style={{ color: tabColor }}>{pf >= 2.0 && strategy.win_rate >= 45 ? '★★★' : pf >= 1.5 ? '★★' : '★'}</span>
 93:         </div>
 94:       </div>
 95:       {/* 操作按钮 */}
 96:       <div className="flex items-center justify-end gap-2">
 97:         <button
 98:           onClick={runScan}
 99:           disabled={scanning}
100:           className="px-2 py-1 rounded-md text-xs border flex items-center gap-1 transition-colors"
101:           style={{
102:             borderColor: scanning ? 'var(--border-color)' : 'rgba(34,197,94,0.3)',
103:             color: scanning ? 'var(--text-muted)' : '#22c55e',
104:             background: scanning ? 'transparent' : 'rgba(34,197,94,0.05)',
105:           }}
106:         >
107:           {scanning ? '⏳ 扫描中...' : '🔍 开始扫描'}
108:         </button>
109:         <button
110:           onClick={handleExportCSV}
111:           disabled={!result?.signals?.length}
112:           className="px-2 py-1 rounded-md text-xs border flex items-center gap-1 transition-colors"
113:           style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)', opacity: !result?.signals?.length ? 0.5 : 1 }}
114:         >
115:           📥 导出CSV
116:         </button>
117:       </div>
118:       {/* 扫描结果 */}
119:       {scanning ? (
120:         <div className="text-center py-12">
121:           <div className="inline-block w-6 h-6 border-2 rounded-full animate-spin" style={{ borderColor: 'var(--accent-blue)', borderTopColor: 'transparent' }} />
122:           <div className="mt-2 text-xs" style={{ color: 'var(--text-muted)' }}>
123:             正在用 {strategy.name} 策略扫描全市场...
124:           </div>
125:         </div>
126:       ) : error ? (
127:         <div className="text-center py-8 text-sm" style={{ color: '#ef4444' }}>扫描失败: {error}</div>
128:       ) : result ? (
129:         <>
130:           <div className="text-xs px-1" style={{ color: 'var(--text-muted)' }}>
131:             扫描 {result.scanned} · 命中 <strong style={{ color: '#ef4444' }}>{result.summary?.total || 0}</strong>
132:           </div>
133:           {result.signals?.length > 0 ? (
134:             <StrategyResultsTable
135:               rows={result.signals}
136:               getRowKey={(row, i) => row.ts_code || i}
137:               columns={[
138:                 { key: 'code', label: '代码', render: r => r.ts_code, width: '75px' },
139:                 { key: 'name', label: '名称', render: r => r.name, width: '80px' },
140:                 { key: 'signal', label: '信号', render: r => r.signal_type || 'B', width: '50px' },
141:                 { key: 'price', label: '触发价', render: r => r.price, type: 'number', align: 'right', width: '65px' },
142:                 { key: 'changePct', label: '涨跌幅', render: r => r.change_pct, type: 'percent', align: 'right', width: '70px' },
143:                 { key: 'atrUpper', label: 'ATR上轨', render: r => r.atr_upper, type: 'number', align: 'right', width: '75px' },
144:                 { key: 'sector', label: '板块', render: r => r.sector, width: '80px' },
145:               ]}
146:               cardComponent={StrategySignalCard}
147:               cardProps={{ mode: 'watchlist', showWatchBtn: true, showAnalysisButton: true }}
148:             />
149:           ) : (
150:             <div className="text-center py-8 text-sm" style={{ color: 'var(--text-muted)' }}>
151:               今日无符合条件的B点信号
152:             </div>
153:           )}
154:         </>
155:       ) : (
156:         <div className="text-center py-8 text-sm" style={{ color: 'var(--text-muted)' }}>
157:           点击"开始扫描"运行策略
158:         </div>
159:       )}
160:     </div>
161:   );
162: }
