<file path="backend/analyzers/buy_power.py">
  1: """
  2: 股价购买力评分（100分制）
  3: 5维度加权: 流动性 + 价格位置 + 资金流入 + 板块热度 + 技术形态
  4: 高分 = 强购买力（可放心买的大资金标的）
  5: 低分 = 杂毛（小市值/低流动性/冷门板块/技术破位）
  6: """
  7: from typing import Optional
  8: def _clamp(v, lo=0, hi=100):
  9:     return max(lo, min(hi, v))
 10: def _score_volume(volume_ratio: float) -> float:
 11:     """
 12:     流动性分（30%权重）
 13:     volume_ratio = 当前成交量 / 5日均量
 14:     1.0 = 平均；1.5 = 放量；0.5 = 缩量
 15:     """
 16:     if volume_ratio is None:
 17:         return 50  # 无数据给中性分
 18:     # 0.3倍→0分，1.0倍→50分，1.5倍→75分，2.5倍→100分
 19:     if volume_ratio < 0.3:
 20:         return 0
 21:     if volume_ratio < 1.0:
 22:         return _clamp(50 * (volume_ratio - 0.3) / 0.7)
 23:     if volume_ratio < 2.5:
 24:         return _clamp(50 + 50 * (volume_ratio - 1.0) / 1.5)
 25:     return 100
 26: def _score_price_position(price_pos_pct: float) -> float:
 27:     """
 28:     价格位置分（25%权重）
 29:     price_pos_pct = (现价 - 20日最低) / (20日最高 - 20日最低) * 100
 30:     0 = 20日最低（潜在底部）；50 = 中位；100 = 20日最高（追高风险）
 31:     理想买点：30-70 分（突破中位但未到顶）
 32:     """
 33:     if price_pos_pct is None:
 34:         return 50
 35:     # 30-70 区间给高分，两端给低分
 36:     if price_pos_pct < 10:
 37:         return _clamp(price_pos_pct * 2)  # 0-10 → 0-20
 38:     if price_pos_pct < 30:
 39:         return _clamp(20 + (price_pos_pct - 10) * 2)  # 10-30 → 20-60
 40:     if price_pos_pct < 70:
 41:         return _clamp(60 + (price_pos_pct - 30) * 1.0)  # 30-70 → 60-100
 42:     if price_pos_pct < 90:
 43:         return _clamp(100 - (price_pos_pct - 70) * 2.5)  # 70-90 → 100-50
 44:     return _clamp(50 - (price_pos_pct - 90) * 5)  # 90-100 → 50-0
 45: def _score_money_flow(net_flow_pct: float) -> float:
 46:     """
 47:     资金流入分（20%权重）
 48:     net_flow_pct = 主力净流入 / 流通市值 * 100（百分比）
 49:     >0 流入；<0 流出
 50:     """
 51:     if net_flow_pct is None:
 52:         return 50
 53:     # -2% → 0分，0% → 50分，+2% → 100分
 54:     return _clamp(50 + net_flow_pct * 25)
 55: def _score_sector_heat(heat: float) -> float:
 56:     """
 57:     板块热度分（15%权重）
 58:     heat = 板块最新热度（0-100）
 59:     """
 60:     if heat is None or heat <= 0:
 61:         return 30
 62:     return _clamp(heat)
 63: def _score_tech(ma_bull: bool, macd_golden: bool, kdj_zone: str) -> float:
 64:     """
 65:     技术形态分（10%权重）
 66:     ma_bull: MA5 > MA20 (多头排列)
 67:     macd_golden: MACD 金叉
 68:     kdj_zone: 'overbought' | 'oversold' | 'middle'（超买/超卖/中位）
 69:     """
 70:     score = 50
 71:     if ma_bull:
 72:         score += 20
 73:     if macd_golden:
 74:         score += 15
 75:     if kdj_zone == 'middle':
 76:         score += 15
 77:     elif kdj_zone == 'oversold':
 78:         score += 5
 79:     # 超买不加分
 80:     return _clamp(score)
 81: def calculate_buy_power(
 82:     volume_ratio: Optional[float] = None,
 83:     price_pos_pct: Optional[float] = None,
 84:     net_flow_pct: Optional[float] = None,
 85:     sector_heat: Optional[float] = None,
 86:     ma_bull: bool = False,
 87:     macd_golden: bool = False,
 88:     kdj_zone: str = 'middle',
 89: ) -> dict:
 90:     """
 91:     计算股价购买力评分（100分制）
 92:     返回 dict: { score, level, dimensions: {...} }
 93:     """
 94:     vol = _score_volume(volume_ratio)
 95:     pos = _score_price_position(price_pos_pct)
 96:     flow = _score_money_flow(net_flow_pct)
 97:     heat = _score_sector_heat(sector_heat)
 98:     tech = _score_tech(ma_bull, macd_golden, kdj_zone)
 99:     score = vol * 0.30 + pos * 0.25 + flow * 0.20 + heat * 0.15 + tech * 0.10
100:     score = round(score, 1)
101:     if score >= 80:
102:         level = '极强'
103:         color = '#ef4444'
104:     elif score >= 65:
105:         level = '强'
106:         color = '#f97316'
107:     elif score >= 50:
108:         level = '中'
109:         color = '#eab308'
110:     elif score >= 35:
111:         level = '弱'
112:         color = '#3b82f6'
113:     else:
114:         level = '极弱'
115:         color = '#6b7280'
116:     return {
117:         'score': score,
118:         'level': level,
119:         'color': color,
120:         'dimensions': {
121:             'volume': round(vol, 1),
122:             'position': round(pos, 1),
123:             'flow': round(flow, 1),
124:             'heat': round(heat, 1),
125:             'tech': round(tech, 1),
126:         },
127:     }
128: def is_junk_stock(
129:     stock_name: str = '',
130:     list_days: Optional[int] = None,
131:     market_cap: Optional[float] = None,
132:     avg_turnover: Optional[float] = None,
133:     sector_heat: Optional[float] = None,
134:     consecutive_decline_days: int = 0,
135: ) -> dict:
136:     """
137:     检测是否为"杂毛"（不可重仓的标的）
138:     满足任一即标记:
139:     1. ST 类（股票名含「ST」）
140:     2. 次新股（上市<60天）
141:     3. 小市值（<50亿）
142:     4. 低流动性（日均成交<1亿）
143:     5. 冷门板块（热度<30）
144:     6. 连续阴跌（≥3天连续下跌）
145:     返回: { is_junk: bool, reasons: [str], junk_score: 0-100 (越高越杂毛) }
146:     """
147:     reasons = []
148:     score = 0  # 杂毛分（越高越差）
149:     # 1. ST
150:     if 'ST' in (stock_name or '').upper():
151:         reasons.append('ST')
152:         score += 30
153:     # 2. 次新股
154:     if list_days is not None and list_days < 60:
155:         reasons.append(f'次新({list_days}天)')
156:         score += 15
157:     # 3. 小市值
158:     if market_cap is not None and market_cap < 50:
159:         reasons.append(f'小市值({market_cap:.0f}亿)')
160:         score += 20
161:     # 4. 低流动性（成交额=0 视为数据缺失，跳过判定）
162:     if avg_turnover is not None and avg_turnover > 0 and avg_turnover < 1:
163:         reasons.append(f'低成交({avg_turnover:.2f}亿)')
164:         score += 25
165:     # 5. 冷门板块（热度=0 视为数据缺失，跳过判定）
166:     if sector_heat is not None and sector_heat > 0 and sector_heat < 30:
167:         reasons.append(f'冷板块(热度{sector_heat:.0f})')
168:         score += 10
169:     # 6. 连续阴跌
170:     if consecutive_decline_days >= 3:
171:         reasons.append(f'连跌{consecutive_decline_days}天')
172:         score += 15
173:     return {
174:         'is_junk': len(reasons) > 0,
175:         'reasons': reasons,
176:         'junk_score': min(score, 100),
177:     }
178: def calc_buy_power_for_signal(quote: dict, sector_trend: dict, bs_signal: str = None) -> dict:
179:     """根据 quote + sector_trend + bs_signal 计算购买力评分（100分制）
180:     与自选股/模拟盘共用的统一入口，确保两端数据维度一致。
181:     - quote: 新浪实时行情 dict（可为 None，退化为中性分）
182:     - sector_trend: 板块趋势 dict（含 latest_heat, available）
183:     - bs_signal: 'B' | 'S' | None（SuperTrend 信号，None 时 ma_bull/macd_golden 为 False）
184:     """
185:     if not quote:
186:         return calculate_buy_power()
187:     change_pct = quote.get('changePct', 0) or 0
188:     price_pos_pct = max(0, min(100, 50 + change_pct * 5))  # ±10%→0-100
189:     sector_heat = sector_trend.get('latest_heat', 0) if sector_trend.get('available') else 0
190:     ma_bull = bs_signal == 'B'
191:     macd_golden = bs_signal == 'B'
192:     kdj_zone = 'middle' if 20 < sector_heat < 80 else 'overbought' if sector_heat >= 80 else 'oversold'
193:     return calculate_buy_power(
194:         volume_ratio=1.0,            # 新浪行情无 volume_ratio，与自选股口径一致
195:         price_pos_pct=price_pos_pct,
196:         net_flow_pct=0,              # 新浪行情无 main_net_inflow_pct，与自选股口径一致
197:         sector_heat=sector_heat,
198:         ma_bull=ma_bull,
199:         macd_golden=macd_golden,
200:         kdj_zone=kdj_zone,
201:     )
</file>

<file path="backend/analyzers/holding_state.py">
  1: """持仓状态引擎。
  2: watchlist 的职责是管理已有持仓和候选观察标的，不是把一个技术信号直接翻译成买入。
  3: 本模块只做纯规则计算，输入已经准备好的持仓、技术、资金和板块因子，便于单元测试和后续回测。
  4: """
  5: from __future__ import annotations
  6: from typing import Any, Dict
  7: HOLDING_STATUS = {
  8:     "WATCH": {"label": "观察", "color": "#64748b"},
  9:     "READY": {"label": "等待确认", "color": "#eab308"},
 10:     "TRIGGERED": {"label": "持仓强化", "color": "#22c55e"},
 11:     "HOLD": {"label": "继续持有", "color": "#16a34a"},
 12:     "NO_CHASE": {"label": "持有但不追高", "color": "#f97316"},
 13:     "INVALID": {"label": "无效/退出", "color": "#dc2626"},
 14: }
 15: def _num(value: Any, default: float = 0.0) -> float:
 16:     try:
 17:         return float(value) if value is not None else default
 18:     except (TypeError, ValueError):
 19:         return default
 20: def _clamp(value: float, lo: float = 0.0, hi: float = 100.0) -> float:
 21:     return max(lo, min(hi, value))
 22: def _is_forbidden(name: str, code: str = "") -> bool:
 23:     normalized = (name or "").strip().upper().replace(" ", "")
 24:     code_normalized = (code or "").strip().upper()
 25:     return (
 26:         normalized.startswith(("ST", "*ST", "S*ST", "退"))
 27:         or "退市" in normalized
 28:         or code_normalized.startswith(("退",))
 29:     )
 30: def evaluate_holding_state(
 31:     *,
 32:     code: str,
 33:     name: str,
 34:     position: Dict[str, Any] | None,
 35:     quote: Dict[str, Any] | None,
 36:     market_state: Dict[str, Any] | None,
 37:     score_dimensions: Dict[str, Any] | None,
 38:     overall_score: Any,
 39:     technical: Dict[str, Any] | None,
 40:     bs_signal: str | None,
 41: ) -> Dict[str, Any]:
 42:     """根据持仓环境输出状态、动作和可解释因子。
 43:     设计原则：
 44:     - 未持仓只允许输出 WATCH/INVALID，不伪装成买入建议。
 45:     - 持仓判断优先看趋势破坏、回撤、风险和资金环境。
 46:     - B/S 只是证据，不能单独决定状态。
 47:     """
 48:     pos = position or {}
 49:     dims = score_dimensions or {}
 50:     features = (market_state or {}).get("features") or {}
 51:     tech = technical or {}
 52:     held_count = _num(pos.get("count"))
 53:     held = held_count > 0
 54:     pnl_pct = _num(pos.get("profitPct"), 0.0)
 55:     day_pct = _num(pos.get("dayProfitPct"), 0.0)
 56:     trend = _num(dims.get("trend_strength"), _num(tech.get("score"), 50.0))
 57:     strength = _num(dims.get("relative_strength"), 50.0)
 58:     capital = _num(dims.get("capital_momentum"), 50.0)
 59:     sector = _num(dims.get("sector_resonance"), 50.0)
 60:     volume = _num(dims.get("volume_health"), 50.0)
 61:     volatility = _num(dims.get("volatility_health"), 50.0)
 62:     drawdown = _num(dims.get("drawdown_status"), 50.0)
 63:     overall = _num(overall_score, 50.0)
 64:     close_vs_ma20 = _num(features.get("close_vs_ma20"), 0.0)
 65:     noise = _num(features.get("noise_ratio"), 0.0)
 66:     stage = str(tech.get("stage") or "")
 67:     forbidden = _is_forbidden(name, code)
 68:     has_trend_data = dims.get("trend_strength") is not None or tech.get("score") is not None
 69:     has_price_data = bool(quote and _num(quote.get("price")) > 0)
 70:     factors = [
 71:         {"key": "持仓", "label": "持仓中" if held else "未持仓", "score": 100 if held else 0,
 72:          "detail": f"数量 {int(held_count)} 股" if held else "当前没有实际持仓"},
 73:         {"key": "趋势", "label": "趋势健康" if trend >= 60 else "趋势转弱" if trend < 40 else "趋势中性",
 74:          "score": round(trend, 1), "detail": f"趋势强度 {trend:.1f}"},
 75:         {"key": "强度", "label": "相对强" if strength >= 60 else "相对弱" if strength < 40 else "相对中性",
 76:          "score": round(strength, 1), "detail": f"相对强度 {strength:.1f}"},
 77:         {"key": "板块", "label": "板块支持" if sector >= 60 else "板块偏弱" if sector < 40 else "板块中性",
 78:          "score": round(sector, 1), "detail": f"板块共振 {sector:.1f}"},
 79:         {"key": "量价资金", "label": "量价健康" if min(capital, volume) >= 60 else "量价偏弱" if max(capital, volume) < 40 else "量价中性",
 80:          "score": round((capital + volume) / 2, 1), "detail": f"资金 {capital:.1f} / 量能 {volume:.1f}"},
 81:         {"key": "风险", "label": "风险可控" if min(volatility, drawdown) >= 60 else "风险升高" if max(volatility, drawdown) < 40 else "风险中性",
 82:          "score": round((volatility + drawdown) / 2, 1), "detail": f"波动健康 {volatility:.1f} / 回撤健康 {drawdown:.1f}"},
 83:     ]
 84:     reasons = []
 85:     warnings = []
 86:     if forbidden:
 87:         reasons.append("ST/退市类标的禁止持仓策略继续管理")
 88:     if not held:
 89:         reasons.append("未持仓，不生成加仓或卖出结论")
 90:     if bs_signal == "S":
 91:         warnings.append("BS卖出信号，仅作为减仓风险证据")
 92:     if stage in {"破位", "弱势"} or trend < 40 or close_vs_ma20 < -0.08:
 93:         warnings.append("趋势结构已转弱")
 94:     if pnl_pct <= -15:
 95:         warnings.append(f"浮亏已达 {pnl_pct:.1f}%")
 96:     if noise >= 2.0:
 97:         warnings.append(f"价格噪声偏高({noise:.2f})")
 98:     if sector < 40:
 99:         warnings.append("板块环境偏弱")
100:     if held and not has_trend_data:
101:         warnings.append("缺少关键趋势数据，不能继续持仓决策")
102:     # 交易状态：未持仓不进入持有态；禁入标的永远无效。
103:     if forbidden:
104:         status = "INVALID"
105:         action = "退出/禁止持有"
106:     elif not held:
107:         status = "WATCH"
108:         action = "仅观察，不买入"
109:     elif held and not has_price_data and not has_trend_data:
110:         status = "INVALID"
111:         action = "数据不足，暂停持仓决策"
112:     elif not has_trend_data:
113:         status = "INVALID"
114:         action = "数据不足，暂停持仓决策"
115:     elif (stage in {"破位", "弱势"} and trend < 45) or (pnl_pct <= -20 and trend < 55) or (pnl_pct <= -12 and trend < 45) or (bs_signal == "S" and trend < 35):
116:         status = "INVALID"
117:         action = "退出或大幅减仓"
118:     elif (stage in {"顶部", "突破"} and pnl_pct >= 15) or (pnl_pct >= 25 and close_vs_ma20 >= 0.08):
119:         status = "NO_CHASE"
120:         action = "继续持有，不追高加仓"
121:     elif trend >= 65 and strength >= 60 and sector >= 50 and capital >= 55 and drawdown >= 55:
122:         status = "TRIGGERED"
123:         action = "趋势确认，可小幅强化"
124:     elif trend >= 50 and overall >= 50 and drawdown >= 45:
125:         status = "HOLD"
126:         action = "继续持有，跟踪保护位"
127:     else:
128:         status = "READY"
129:         action = "等待修复确认，不加仓"
130:     # 给前端一个稳定的状态摘要，避免把 score 当作最终交易决定。
131:     state_meta = HOLDING_STATUS[status]
132:     return {
133:         "status": status,
134:         "statusLabel": state_meta["label"],
135:         "statusColor": state_meta["color"],
136:         "action": action,
137:         "isHeld": held,
138:         "holdingCount": int(held_count),
139:         "profitPct": round(pnl_pct, 2),
140:         "factorScore": round(_clamp((trend * 0.30 + strength * 0.15 + sector * 0.15 + capital * 0.15 + volume * 0.10 + drawdown * 0.15)), 1),
141:         "factors": factors,
142:         "reasons": reasons,
143:         "warnings": warnings,
144:         "decisionRule": "持仓优先：先判断趋势破坏与风险，再判断是否强化；BS信号不单独决定买卖。",
145:     }
</file>

