  1: """US Quant System — 技术指标计算
  2: 基于日线/分钟线计算常用技术指标。
  3: yfinance 返回的 OHLC 数据格式: {symbol: [{Date, Open, High, Low, Close, Volume}, ...]}
  4: """
  5: from __future__ import annotations
  6: from typing import Optional
  7: def ema(values: list[float], period: int) -> list[float]:
  8:     """指数移动平均"""
  9:     if len(values) < period:
 10:         return []
 11:     multiplier = 2.0 / (period + 1)
 12:     result = [sum(values[:period]) / period]
 13:     for v in values[period:]:
 14:         result.append((v - result[-1]) * multiplier + result[-1])
 15:     return result
 16: def sma(values: list[float], period: int) -> list[float]:
 17:     """简单移动平均"""
 18:     if len(values) < period:
 19:         return []
 20:     result = []
 21:     for i in range(len(values) - period + 1):
 22:         result.append(sum(values[i:i + period]) / period)
 23:     return result
 24: def rsi(values: list[float], period: int = 14) -> Optional[float]:
 25:     """相对强弱指标 — 返回最新值"""
 26:     if len(values) < period + 1:
 27:         return None
 28:     gains, losses = 0.0, 0.0
 29:     for i in range(-period, 0):
 30:         diff = values[i] - values[i - 1]
 31:         if diff > 0:
 32:             gains += diff
 33:         else:
 34:             losses -= diff
 35:     avg_gain = gains / period
 36:     avg_loss = losses / period
 37:     if avg_loss == 0:
 38:         return 100.0
 39:     rs = avg_gain / avg_loss
 40:     return 100.0 - (100.0 / (1.0 + rs))
 41: def macd(values: list[float], fast: int = 12, slow: int = 26, signal: int = 9) -> dict:
 42:     """MACD 指标 — 返回最新值"""
 43:     ema_fast = ema(values, fast)
 44:     ema_slow = ema(values, slow)
 45:     if not ema_fast or not ema_slow:
 46:         return {"dif": None, "dea": None, "hist": None, "status": "N/A"}
 47:     dif = ema_fast[-1] - ema_slow[-1]
 48:     # 计算 DEA (signal line)
 49:     dif_line = [ema_fast[i] - ema_slow[i] for i in range(min(len(ema_fast), len(ema_slow)))]
 50:     if len(dif_line) < signal:
 51:         return {"dif": dif, "dea": None, "hist": None, "status": "N/A"}
 52:     dea_vals = ema(dif_line, signal)
 53:     if not dea_vals:
 54:         return {"dif": dif, "dea": None, "hist": None, "status": "N/A"}
 55:     dea = dea_vals[-1]
 56:     hist = dif - dea
 57:     status = "多头" if dif > dea and hist > 0 else "空头" if dif < dea and hist < 0 else "中性"
 58:     return {"dif": round(dif, 4), "dea": round(dea, 4), "hist": round(hist, 4), "status": status}
 59: def kdj(values: list[float], period: int = 9, k_smooth: int = 3, d_smooth: int = 3) -> dict:
 60:     """KDJ 指标 — 返回最新值"""
 61:     if len(values) < period:
 62:         return {"k": None, "d": None, "j": None, "status": "N/A"}
 63:     recent = values[-period:]
 64:     hh = max(recent)
 65:     ll = min(recent)
 66:     if hh == ll:
 67:         return {"k": 50.0, "d": 50.0, "j": 50.0, "status": "中性"}
 68:     rsv = (recent[-1] - ll) / (hh - ll) * 100
 69:     k_values = [rsv]
 70:     for _ in range(1, k_smooth):
 71:         k_values.append((2 / 3) * k_values[-1] + (1 / 3) * rsv)
 72:     k = k_values[-1]
 73:     d = (2 / 3) * (k if len(k_values) == 1 else k) + (1 / 3) * k
 74:     j = 3 * k - 2 * d
 75:     if k > 80 and d > 80:
 76:         status = "超买"
 77:     elif k < 20 and d < 20:
 78:         status = "超卖"
 79:     elif k > d:
 80:         status = "多头"
 81:     elif k < d:
 82:         status = "空头"
 83:     else:
 84:         status = "中性"
 85:     return {"k": round(k, 2), "d": round(d, 2), "j": round(j, 2), "status": status}
 86: def atr(highs: list[float], lows: list[float], closes: list[float], period: int = 14) -> Optional[float]:
 87:     """平均真实波幅 — 返回最新值"""
 88:     if len(closes) < period + 1:
 89:         return None
 90:     trs = []
 91:     for i in range(1, len(closes)):
 92:         hl = highs[i] - lows[i]
 93:         hc = abs(highs[i] - closes[i - 1])
 94:         lc = abs(lows[i] - closes[i - 1])
 95:         trs.append(max(hl, hc, lc))
 96:     if len(trs) < period:
 97:         return None
 98:     return sum(trs[-period:]) / period
 99: def ma_bias(price: float, ma_value: float) -> float:
100:     """乖离率"""
101:     if ma_value == 0:
102:         return 0.0
103:     return (price - ma_value) / ma_value * 100
104: def vwap(highs: list[float], lows: list[float], closes: list[float], volumes: list[float]) -> Optional[float]:
105:     """成交量加权平均价格"""
106:     if not volumes:
107:         return None
108:     tp_sum = sum((h + l + c) / 3 * v for h, l, c, v in zip(highs, lows, closes, volumes))
109:     vol_sum = sum(volumes)
110:     if vol_sum == 0:
111:         return None
112:     return tp_sum / vol_sum
</file>

<file path="backend/us_quant/market_regime.py">
  1: """US Quant System — 市场环境引擎
  2: 5种市场状态：
  3:   STRONG_BREADTH       — 强势普涨
  4:   LEADER_CONCENTRATION  — 龙头集中
  5:   HIGH_LEVEL_RANGE      — 高位震荡
  6:   WEAK_REBOUND          — 弱势反弹
  7:   RISK_OFF              — 风险回避
  8: 从 SPY/QQQ/IWM/RSP/VIX 等 ETF 判断。
  9: """
 10: from __future__ import annotations
 11: from typing import Optional
 12: from .contracts import IndexQuote, MarketRegime
 13: def assess_market_regime(
 14:     spy: Optional[IndexQuote] = None,
 15:     qqq: Optional[IndexQuote] = None,
 16:     iwm: Optional[IndexQuote] = None,
 17:     rsp: Optional[IndexQuote] = None,
 18:     vix: Optional[float] = None,
 19:     advancers_pct: Optional[float] = None,  # 上涨股票占比 0-100
 20:     new_high_pct: Optional[float] = None,   # 新高股票占比 0-100
 21: ) -> MarketRegime:
 22:     """
 23:     评估市场环境状态。
 24:     各参数可空，缺失时使用默认值（保守估计）。
 25:     """
 26:     # 默认值（保守）
 27:     spy = spy or IndexQuote(symbol="SPY", name="SPY", price=0, change_pct=0)
 28:     qqq = qqq or IndexQuote(symbol="QQQ", name="QQQ", price=0, change_pct=0)
 29:     iwm = iwm or IndexQuote(symbol="IWM", name="IWM", price=0, change_pct=0)
 30:     rsp = rsp or IndexQuote(symbol="RSP", name="RSP", price=0, change_pct=0)
 31:     vix = vix or 20.0
 32:     advancers_pct = advancers_pct if advancers_pct is not None else 50.0
 33:     new_high_pct = new_high_pct if new_high_pct is not None else 50.0
 34:     # 计算各维度
 35:     spy_above_ma20 = spy.ma20 is not None and spy.price > spy.ma20
 36:     qqq_above_ma20 = qqq.ma20 is not None and qqq.price > qqq.ma20
 37:     rsp_above_ma20 = rsp.ma20 is not None and rsp.price > rsp.ma20
 38:     spy_ma20_up = spy.ma20 is not None and spy.ma50 is not None and spy.ma20 > spy.ma50
 39:     # 市场宽度
 40:     breadth_ok = advancers_pct > 50.0
 41:     new_high_ok = new_high_pct > 10.0
 42:     # VIX 风险
 43:     vix_low = vix < 20.0
 44:     vix_medium = 20.0 <= vix < 30.0
 45:     vix_high = vix >= 30.0
 46:     # 强弱对比
 47:     rsp_weak = rsp.ma20 is not None and (rsp.price <= rsp.ma20 * 0.98)
 48:     iwm_weak = iwm.ma20 is not None and (iwm.price <= iwm.ma20 * 0.98)
 49:     # ─── 判断市场状态 ─────────────────────────────────────────────────────────
 50:     # RISK_OFF: 破位 + 宽度恶化 + 高VIX
 51:     if (not spy_above_ma20 or not qqq_above_ma20) and (vix_high or not breadth_ok):
 52:         return MarketRegime(
 53:             regime="RISK_OFF",
 54:             score=max(0, min(30, _calc_score(0, 0, 0, vix))),
 55:             label="风险回避",
 56:             allow_new_positions=False,
 57:             reason="指数破位 + 市场宽度恶化 + 高VIX，仅允许减仓和平仓",
 58:             breakout_mult=0.0,
 59:             pullback_mult=0.0,
 60:             earnings_gap_mult=0.0,
 61:         )
 62:     # WEAK_REBOUND: 短线反弹但中期弱
 63:     if (spy_above_ma20 or qqq_above_ma20) and (not rsp_above_ma20 or iwm_weak) and (vix_medium or not breadth_ok):
 64:         return MarketRegime(
 65:             regime="WEAK_REBOUND",
 66:             score=31.50,
 67:             label="弱势反弹",
 68:             allow_new_positions=True,
 69:             reason="短线反弹但中期趋势未修复，宽度未确认",
 70:             breakout_mult=0.0,
 71:             pullback_mult=0.30,
 72:             earnings_gap_mult=0.30,
 73:         )
 74:     # HIGH_LEVEL_RANGE: 指数高位 + 波动扩大
 75:     if spy_above_ma20 and qqq_above_ma20 and (not breadth_ok or not new_high_ok) and (vix_medium or iwm_weak):
 76:         return MarketRegime(
 77:             regime="HIGH_LEVEL_RANGE",
 78:             score=51.65,
 79:             label="高位震荡",
 80:             allow_new_positions=True,
 81:             reason="指数高位，波动扩大，市场宽度下降",
 82:             breakout_mult=0.40,
 83:             pullback_mult=0.70,
 84:             earnings_gap_mult=0.40,
 85:         )
 86:     # LEADER_CONCENTRATION: 指数涨但宽度弱
 87:     if (spy_above_ma20 or qqq_above_ma20) and (rsp_weak or iwm_weak) and (not breadth_ok or not new_high_ok):
 88:         return MarketRegime(
 89:             regime="LEADER_CONCENTRATION",
 90:             score=52.75,
 91:             label="龙头集中",
 92:             allow_new_positions=True,
 93:             reason="指数上涨但宽度不足，上涨集中于少数大盘龙头",
 94:             breakout_mult=0.70,
 95:             pullback_mult=0.80,
 96:             earnings_gap_mult=0.60,
 97:         )
 98:     # STRONG_BREADTH: 强势普涨
 99:     if spy_above_ma20 and qqq_above_ma20 and rsp_above_ma20 and spy_ma20_up and breadth_ok and new_high_ok and vix_low:
100:         return MarketRegime(
101:             regime="STRONG_BREADTH",
102:             score=85.90,
103:             label="强势普涨",
104:             allow_new_positions=True,
105:             reason="指数趋势向上，市场宽度改善，多数行业上涨",
106:             breakout_mult=1.0,
107:             pullback_mult=1.0,
108:             earnings_gap_mult=1.0,
109:         )
110:     # 默认：中性震荡
111:     return MarketRegime(
112:         regime="HIGH_LEVEL_RANGE",
113:         score=50.50,
114:         label="中性震荡",
115:         allow_new_positions=True,
116:         reason="市场中性震荡，各维度信号不明确",
117:         breakout_mult=0.50,
118:         pullback_mult=0.60,
119:         earnings_gap_mult=0.50,
120:     )
121: def _calc_score(trend: float, breadth: float, vix_score: float, vix: float) -> float:
122:     """计算综合评分"""
123:     vix_part = max(0, 100 - vix * 3)  # VIX 越低分越高
124:     return round((trend * 0.4 + breadth * 0.3 + vix_part * 0.3), 1)
125: def get_regime_multipliers(regime: str) -> dict[str, float]:
126:     """获取各策略在当前市场状态下的乘数"""
127:     mults = {
128:         "STRONG_BREADTH": {"breakout": 1.0, "pullback": 1.0, "earnings_gap": 1.0},
129:         "LEADER_CONCENTRATION": {"breakout": 0.70, "pullback": 0.80, "earnings_gap": 0.60},
130:         "HIGH_LEVEL_RANGE": {"breakout": 0.40, "pullback": 0.70, "earnings_gap": 0.40},
131:         "WEAK_REBOUND": {"breakout": 0.0, "pullback": 0.30, "earnings_gap": 0.30},
132:         "RISK_OFF": {"breakout": 0.0, "pullback": 0.0, "earnings_gap": 0.0},
133:     }
134:     return mults.get(regime, {"breakout": 0.5, "pullback": 0.5, "earnings_gap": 0.5})
</file>

<file path="backend/us_quant/rebalance.py">
  1: """
  2: US Quant System — 股票池自动再平衡引擎
  3: V2.2 架构冻结: 按配置驱动，自动填充池到目标数量。
  4: 策略:
  5: - US_CORE_A: 按市值排名的 Top 300
  6: - US_CORE_B: 按市值排名的 301-800
  7: - US_RESEARCH: 剩余活跃美股（去重后）
  8: - 支持 dry-run 模式预览变更
  9: """
 10: from __future__ import annotations
 11: import logging
 12: from datetime import date, datetime
 13: from typing import Optional
 14: from sqlalchemy import text
 15: logger = logging.getLogger(__name__)
 16: def _db_conn():
 17:     try:
 18:         from db.session import SessionLocal
 19:         s = SessionLocal()
 20:         return s, s.close
 21:     except Exception:
 22:         return None, None
 23: def get_universe_definitions() -> list[dict]:
 24:     """从数据库读取所有池定义"""
 25:     s, close = _db_conn()
 26:     if not s:
 27:         logger.warning("[rebalance] 无法连接数据库")
 28:         return []
 29:     try:
 30:         rows = s.execute(text("""
 31:             SELECT universe_code, name, target_count, rebalance_frequency, rules
 32:             FROM universe_definitions WHERE is_active ORDER BY universe_code
 33:         """)).fetchall()
 34:         result = []
 35:         for r in rows:
 36:             cnt = s.execute(
 37:                 text("SELECT COUNT(*) FROM universe_memberships WHERE universe_code=:c AND effective_to IS NULL"),
 38:                 {"c": r[0]}
 39:             ).scalar()
 40:             tier = "core" if "CORE" in (r[0] or "") else "research" if "RESEARCH" in (r[0] or "") else "other"
 41:             result.append({
 42:                 "code": r[0], "name": r[1], "target_count": r[2],
 43:                 "rebalance_frequency": r[3], "tier": tier, "rules": r[4] or {},
 44:                 "current_count": cnt or 0,
 45:             })
 46:         return result
 47:     except Exception as e:
 48:         logger.error(f"[rebalance] 读取定义失败: {e}")
 49:         return []
 50:     finally:
 51:         close()
 52: def get_all_us_instruments() -> list[dict]:
 53:     """获取所有活跃美股"""
 54:     s, close = _db_conn()
 55:     if not s:
 56:         return []
 57:     try:
 58:         rows = s.execute(text("""
 59:             SELECT id, symbol, name, sector, industry
 60:             FROM instruments
 61:             WHERE market = 'US' AND is_active = true
 62:             ORDER BY symbol
 63:         """)).fetchall()
 64:         return [
 65:             {"id": r[0], "symbol": r[1], "name": r[2],
 66:              "sector": r[3], "industry": r[4]}
 67:             for r in rows
 68:         ]
 69:     except Exception as e:
 70:         logger.error(f"[rebalance] 读取美股列表失败: {e}")
 71:         return []
 72:     finally:
 73:         close()
 74: def get_current_members(code: str) -> set[str]:
 75:     """获取池当前成员（instrument_id 的 UUID 字符串集合）"""
 76:     s, close = _db_conn()
 77:     if not s:
 78:         return set()
 79:     try:
 80:         rows = s.execute(
 81:             text("SELECT instrument_id::text FROM universe_memberships WHERE universe_code=:c AND effective_to IS NULL"),
 82:             {"c": code}
 83:         ).fetchall()
 84:         return {r[0] for r in rows}
 85:     except Exception as e:
 86:         logger.error(f"[rebalance] 读取 {code} 成员失败: {e}")
 87:         return set()
 88:     finally:
 89:         close()
 90: def assign_pools(
 91:     instruments: list[dict],
 92:     existing: dict[str, set[str]],
 93:     definitions: list[dict],
 94: ) -> dict[str, list[str]]:
 95:     """按配置分配股票到各池
 96:     Args:
 97:         instruments: 所有美股
 98:         existing: 各池现有成员 {pool_code: set(instrument_id_text)}
 99:         definitions: 池定义列表
100:     Returns:
101:         {pool_code: [instrument_id_text to add]}
102:     """
103:     # 构建池层级
104:     tiers = {"core_a": [], "core_b": [], "research": [], "other": []}
105:     for d in definitions:
106:         if d["code"] == "US_CORE_A":
107:             tiers["core_a"].append(d)
108:         elif d["code"] == "US_CORE_B":
109:             tiers["core_b"].append(d)
110:         elif d["code"] == "US_RESEARCH":
111:             tiers["research"].append(d)
112:         else:
113:             tiers["other"].append(d)
114:     # 简单分配：按字母序分配到各池
115:     used_ids: set[str] = set()
116:     result: dict[str, list[str]] = {}
117:     for pool_list in [tiers["core_a"], tiers["core_b"], tiers["research"], tiers["other"]]:
118:         for d in pool_list:
119:             target = d["target_count"]
120:             if target is None:
121:                 continue
122:             target = int(target)
123:             existing_ids = existing.get(d["code"], set())
124:             current = len(existing_ids)
125:             need = max(0, target - current)
126:             # 从未分配且未使用的股票中选取
127:             available = [inst for inst in instruments if str(inst["id"]) not in used_ids]
128:             to_add = [str(inst["id"]) for inst in available[:need]]
129:             result[d["code"]] = to_add
130:             used_ids.update(to_add)
131:     return result
132: def apply_rebalance(
133:     assignments: dict[str, list[str]],
134:     definitions: list[dict],
135:     dry_run: bool = True,
136: ) -> dict:
137:     """执行再平衡
138:     Args:
139:         assignments: {pool_code: [instrument_id_text to add]}
140:         definitions: 池定义列表
141:         dry_run: True = 只预览，False = 写入数据库
142:     Returns:
143:         rebalance 报告
144:     """
145:     s, close = _db_conn()
146:     if not s:
147:         return {"status": "error", "message": "无法连接数据库"}
148:     report = {
149:         "status": "dry_run" if dry_run else "applied",
150:         "timestamp": datetime.now().isoformat(),
151:         "pools": [],
152:         "total_added": 0,
153:     }
154:     try:
155:         for d in definitions:
156:             code = d["code"]
157:             to_add = assignments.get(code, [])
158:             if not to_add:
159:                 report["pools"].append({
160:                     "code": code, "name": d["name"],
161:                     "target": d["target_count"],
162:                     "current": d["current_count"],
163:                     "added": 0, "message": "已达标",
164:                 })
165:                 continue
166:             if not dry_run:
167:                 rank_start = d["current_count"] + 1
168:                 for i, inst_id_text in enumerate(to_add):
169:                     s.execute(
170:                         text("""
171:                             INSERT INTO universe_memberships (universe_code, instrument_id, rank, effective_from, created_at)
172:                             VALUES (:code, :inst_id::uuid, :rank, :eff_date, NOW())
173:                             ON CONFLICT (universe_code, instrument_id, effective_to) DO NOTHING
174:                         """),
175:                         {
176:                             "code": code, "inst_id": inst_id_text,
177:                             "rank": rank_start + i,
178:                             "eff_date": date.today(),
179:                         }
180:                     )
181:                 s.commit()
182:                 logger.info(f"[rebalance] {code}: 添加 {len(to_add)} 只")
183:             report["pools"].append({
184:                 "code": code, "name": d["name"],
185:                 "target": d["target_count"],
186:                 "current": d["current_count"],
187:                 "added": len(to_add),
188:                 "new_total": d["current_count"] + len(to_add),
189:                 "message": f"需添加 {len(to_add)} 只" if len(to_add) > 0 else "已达标",
190:             })
191:             report["total_added"] += len(to_add)
192:         if not dry_run:
193:             s.commit()
194:     except Exception as e:
195:         s.rollback()
196:         logger.error(f"[rebalance] 执行失败: {e}")
197:         report["status"] = "error"
198:         report["message"] = str(e)
199:     finally:
200:         close()
201:     return report
202: def run_rebalance(dry_run: bool = True) -> dict:
203:     """运行完整再平衡流程
204:     Args:
205:         dry_run: True = 预览，False = 执行
206:     Returns:
207:         再平衡报告
208:     """
209:     # 1. 读取定义
210:     definitions = get_universe_definitions()
211:     if not definitions:
212:         return {"status": "error", "message": "无池定义"}
213:     # 2. 读取所有美股
214:     instruments = get_all_us_instruments()
215:     logger.info(f"[rebalance] 共 {len(instruments)} 只美股")
216:     # 3. 读取现有成员
217:     existing = {}
218:     for d in definitions:
219:         existing[d["code"]] = get_current_members(d["code"])
220:     # 4. 分配
221:     assignments = assign_pools(instruments, existing, definitions)
222:     # 5. 应用
223:     report = apply_rebalance(assignments, definitions, dry_run=dry_run)
224:     # 6. 统计
225:     new_instruments = get_all_us_instruments()
226:     report["total_instruments"] = len(new_instruments)
227:     return report
</file>

