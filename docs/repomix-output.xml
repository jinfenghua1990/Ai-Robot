 1: from __future__ import annotations
 2: from statistics import mean
 3: from typing import Iterable, Sequence
 4: def forward_return(closes: Sequence[float], horizon: int) -> float | None:
 5:     if len(closes) <= horizon or not closes[0]:
 6:         return None
 7:     return closes[horizon] / closes[0] - 1
 8: def evaluate_forward_returns(samples: Iterable[Sequence[float]], horizons=(1, 3, 5, 10, 20)) -> dict:
 9:     result = {}
10:     for horizon in horizons:
11:         values = [value for sample in samples if (value := forward_return(sample, horizon)) is not None]
12:         result[str(horizon)] = {
13:             "count": len(values),
14:             "mean": round(mean(values), 6) if values else None,
15:             "win_rate": round(sum(v > 0 for v in values) / len(values), 6) if values else None,
16:             "max_profit": max(values) if values else None,
17:             "max_loss": min(values) if values else None,
18:         }
19:     return result
