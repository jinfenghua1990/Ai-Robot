12:   if (n >= 3) return // 防止极端情况下死循环
13:   try { sessionStorage.setItem('airobot_recover', String(n + 1)) } catch (e) {}
14:   window.location.replace(window.location.href)
15: }
16: window.addEventListener('unhandledrejection', (event) => {
17:   const reason = event.reason
18:   const msg = (reason && reason.message) ? reason.message : String(reason)
19:   if (/Failed to fetch dynamically imported module|Importing a module script failed|ChunkLoadError|Loading chunk|Failed to load|404/i.test(msg)) {
20:     trySelfRecover()
21:   }
22: })
