445: /* ================= 右侧抽屉 ================= */
446: function Drawer({ code, mode, wlSignal, cfg, global, notes, auditItems, onClose, onOpenConfig, onOpenDetail, onSave, onEnable, onDisable, onPause, onResume, onRefreshAudit, navigate }) {
447:   // Esc 关闭抽屉
448:   useEffect(() => {
449:     const onKey = (e) => { if (e.key === 'Escape') onClose(); };
450:     window.addEventListener('keydown', onKey);
451:     return () => window.removeEventListener('keydown', onKey);
452:   }, [onClose]);
453:   const sig = wlSignal || {};
454:   const q = sig.quote || {};
455:   const ind = sig.indicators || {};
456:   const pos = sig.position || {};
457:   const mf = sig.moneyFlow || {};
458:   return (
459:     <div className="fixed inset-0 z-50 flex items-center justify-center" style={{ background: 'rgba(0,0,0,0.4)' }} onClick={onClose}>
460:       <div className="w-[600px] max-w-[94vw] h-[86vh] flex flex-col rounded-xl overflow-hidden"
461:         style={{ background: 'var(--bg-primary)', border: '1px solid var(--border-color)', boxShadow: '0 12px 48px rgba(0,0,0,0.25)' }}
462:         onClick={(e) => e.stopPropagation()}>
463:         {mode === 'audit' ? (
464:           <AuditPanel items={auditItems} code={code} onClose={onClose} onRefresh={() => onRefreshAudit(code)} />
465:         ) : mode === 'config' ? (
466:           <ConfigPanel code={code} cfg={cfg} global={global}
467:             onClose={onClose}
468:             onSave={onSave} onEnable={onEnable} onDisable={onDisable}
469:             onPause={onPause} onResume={onResume} />
470:         ) : (
471:           <DetailPanel code={code} sig={sig} q={q} ind={ind} pos={pos} mf={mf}
472:             cfg={cfg} global={global} notes={notes}
473:             onClose={onClose} onOpenConfig={() => onOpenConfig(code)} onOpenDetail={onOpenDetail} navigate={navigate} />
474:         )}
475:       </div>
476:     </div>
477:   );
478: }
479: /* ===== 详情面板 ===== */
480: function DetailPanel({ code, sig, q, ind, pos, mf, cfg, global, notes, onClose, onOpenConfig, navigate }) {
481:   const [audit, setAudit] = useState([]);
482:   useEffect(() => {
483:     apiFetch(`/api/auto-trade/audit?code=${code}`).then(({ ok, data }) => { if (ok) setAudit(data.items || []); });
484:   }, [code]);
485:   const price = q.price ?? pos.price ?? 0;
486:   const cost = pos.costPrice ?? 0;
487:   const profitPct = pos.profitPct ?? (cost > 0 ? ((price - cost) / cost) * 100 : 0);
488:   const reasons = (sig.reasons || []).slice(0, 3);
489:   const mode = cfg?.mode || 'off';
490:   const p = cfg?.prices || {};
491:   const rk = cfg?.risk || {};
492:   const header = (
493:     <div className="flex items-center justify-between px-4 py-2.5 border-b shrink-0" style={{ borderColor: 'var(--border-color)' }}>
494:       <div>
495:         <span className="text-sm font-bold" style={{ color: 'var(--text-primary)' }}>{q.name || code}</span>
496:         <span className="ml-1.5 text-[10px]" style={{ color: 'var(--text-muted)' }}>{code}</span>
497:       </div>
498:       <button onClick={onClose} className="px-2 py-0.5 rounded border text-[11px]" style={{ borderColor: 'var(--border-color)', color: 'var(--text-secondary)' }}>✕ 关闭</button>
499:     </div>
500:   );
501:   const Section = ({ title, children }) => (
502:     <div className="px-4 py-2.5 border-b" style={{ borderColor: 'var(--border-color)' }}>
503:       <div className="text-[11px] font-bold mb-1.5" style={{ color: 'var(--accent-blue)' }}>{title}</div>
504:       {children}
505:     </div>
506:   );
507:   const Row = ({ k, v, c }) => (
