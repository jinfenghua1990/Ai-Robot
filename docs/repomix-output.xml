  1: import { useState, useEffect, useMemo } from 'react';
  2: import { apiFetch } from '../../utils/request';
  3: import { stripCode } from '../../utils/format';
  4: const fmtFlow = (v) => {
  5:   if (v == null || isNaN(v)) return '—';
  6:   const abs = Math.abs(v);
  7:   if (abs >= 10000) return `${(v / 10000).toFixed(2)}亿`;
  8:   return `${v.toFixed(0)}万`;
  9: };
 10: /**
 11:  * 资金对比（盘后 vs 实时）· 折线 + Δ 徽章
 12:  * 每只股票一张卡：上方红色盘后主力净流入线、下方蓝色实时主力净流入线（共享尺度），
 13:  * Δ 徽章一眼显示实时相对盘后的加码/撤离。实时新增个股单独标注。
 14:  * - postStockTop：来自 /api/money-flow 的盘后 sector→stock 链路 Top10
 15:  * - rtStocks：PanoramaPage 单一轮询注入
 16:  */
 17: export default function StockCompareSection({ selectedDate, rtStocks, selectedStock, onSelectStock }) {
 18:   const [moneyFlowData, setMoneyFlowData] = useState(null);
 19:   const [loading, setLoading] = useState(true);
 20:   useEffect(() => {
 21:     if (!selectedDate) return;
 22:     const controller = new AbortController();
 23:     (async () => {
 24:       const { ok, data } = await apiFetch(`/api/money-flow?date=${selectedDate}`, { signal: controller.signal });
 25:       if (!ok) { setLoading(false); return; }
 26:       setMoneyFlowData(data);
 27:       setLoading(false);
 28:     })();
 29:     return () => controller.abort();
 30:   }, [selectedDate]);
 31:   // 实时个股 Map（按 ts_code 索引）
 32:   const realtimeMap = useMemo(() => {
 33:     const m = new Map();
 34:     (rtStocks?.stocks || []).forEach(s => m.set(s.ts_code, s));
 35:     return m;
 36:   }, [rtStocks]);
 37:   // 盘后个股 Top10（仅 sector→stock 链路）
 38:   const postStockTop = useMemo(() => {
 39:     if (!moneyFlowData?.nodes || !moneyFlowData?.links) return [];
 40:     const leaders = moneyFlowData.nodes.filter(n => n.category === 'leader');
 41:     const leaderNames = new Set(leaders.map(n => n.name));
 42:     const stockMap = new Map();
 43:     moneyFlowData.links.forEach(l => {
 44:       if (!leaderNames.has(l.target)) return;
 45:       const ld = leaders.find(n => n.name === l.target);
 46:       const prev = stockMap.get(l.target);
 47:       if (prev) prev.value += l.value;
 48:       else stockMap.set(l.target, {
 49:         ts_code: l.target, name: ld?.label || l.target, value: l.value,
 50:         price: ld?.price || 0, price_chg: ld?.price_chg || 0,
 51:       });
 52:     });
 53:     return [...stockMap.values()].sort((a, b) => b.value - a.value).slice(0, 10);
 54:   }, [moneyFlowData]);
 55:   // 合并盘后 + 实时资金
 56:   const compareList = useMemo(() => {
 57:     return postStockTop.map(s => {
 58:       const rt = realtimeMap.get(s.ts_code);
 59:       return {
 60:         ts_code: s.ts_code,
 61:         name: s.name,
 62:         sector: rt?.sector || '',
 63:         postFlow: s.value,
 64:         rtFlow: rt?.main_force_inflow ?? null,
 65:         rtSources: rt?.sources_count ?? 0,
 66:         price_chg: rt?.price_chg ?? s.price_chg ?? 0,
 67:       };
 68:     });
 69:   }, [postStockTop, realtimeMap]);
 70:   // 实时新增榜：实时 Top 中盘后未上榜
 71:   const newcomers = useMemo(() => {
 72:     const postCodes = new Set(postStockTop.map(s => s.ts_code));
 73:     return (rtStocks?.stocks || [])
 74:       .filter(s => !postCodes.has(s.ts_code))
 75:       .sort((a, b) => (b.main_force_inflow || 0) - (a.main_force_inflow || 0))
 76:       .slice(0, 5)
 77:       .map(s => ({
 78:         ts_code: s.ts_code,
 79:         name: s.name,
 80:         sector: s.sector || '',
 81:         postFlow: null,
 82:         rtFlow: s.main_force_inflow ?? 0,
 83:         rtSources: s.sources_count ?? 0,
 84:         price_chg: s.price_chg ?? 0,
 85:       }));
 86:   }, [rtStocks, postStockTop]);
 87:   const dateLabel = selectedDate ? selectedDate.slice(5) : '';
 88:   const allCards = [...compareList, ...newcomers];
 89:   const renderCard = (item, idx, isNewcomer) => {
 90:     const post = item.postFlow;
 91:     const rt = item.rtFlow;
 92:     const hasRt = rt != null;
 93:     // Δ = 实时 − 盘后（仅两者都有时）
 94:     const delta = hasRt && post != null ? rt - post : null;
 95:     const deltaUp = delta != null && delta > 0;
 96:     const deltaDown = delta != null && delta < 0;
 97:     // 状态药丸
 98:     let status = { text: '盘后上榜', color: '#a5b4fc', bg: 'rgba(99,102,241,0.15)' };
 99:     if (isNewcomer) status = { text: '实时新增', color: '#f59e0b', bg: 'rgba(245,158,11,0.15)' };
100:     else if (deltaUp) status = { text: '实时加码', color: '#ef4444', bg: 'rgba(239,68,68,0.15)' };
101:     else if (deltaDown) status = { text: '实时撤离', color: '#22c55e', bg: 'rgba(34,197,94,0.15)' };
102:     // 共享尺度（取两者绝对值最大）
103:     const maxAbs = Math.max(Math.abs(post || 0), Math.abs(rt || 0), 1);
104:     const postPct = post != null ? (Math.abs(post) / maxAbs) * 100 : 0;
105:     const rtPct = hasRt ? (Math.abs(rt) / maxAbs) * 100 : 0;
106:     const postPositive = (post || 0) >= 0;
107:     const rtPositive = (rt || 0) >= 0;
108:     const isSelected = selectedStock === item.ts_code;
109:     return (
110:       <div key={item.ts_code || idx}
111:         className="rounded-xl border p-2.5 cursor-pointer transition-all"
112:         style={{
113:           borderColor: isSelected ? 'rgba(56,189,248,0.6)' : 'var(--border-color)',
114:           background: 'var(--bg-card)',
115:           boxShadow: isSelected ? '0 0 0 1px rgba(56,189,248,0.4)' : 'none',
116:         }}
117:         onClick={() => onSelectStock?.(item.ts_code)}>
118:         {/* 头部 */}
119:         <div className="flex items-center justify-between gap-2 mb-2">
120:           <div className="flex items-center gap-1.5 min-w-0">
121:             <span className="text-xs font-bold flex-shrink-0" style={{ color: idx < 3 && !isNewcomer ? '#ef4444' : 'var(--text-muted)' }}>{idx + 1}</span>
122:             <span className="text-sm font-bold truncate" style={{ color: 'var(--text-primary)' }}>{item.name}</span>
123:             <span className="text-[10px]" style={{ color: 'var(--text-muted)' }}>{stripCode(item.ts_code)}</span>
124:           </div>
125:           <span className="px-1.5 py-0.5 rounded text-[10px] font-semibold flex-shrink-0"
126:             style={{ background: status.bg, color: status.color }}>{status.text}</span>
127:         </div>
128:         {item.sector && (
129:           <div className="text-[10px] mb-2 truncate" style={{ color: 'var(--text-muted)' }}>📁 {item.sector}</div>
130:         )}
131:         {/* 盘后折线 */}
132:         <div className="flex items-center gap-2 mb-1">
133:           <span className="text-[10px] w-8 flex-shrink-0" style={{ color: 'var(--text-muted)' }}>📊盘后</span>
134:           <div className="flex-1 h-4 relative flex items-center" style={{ background: 'var(--bg-surface)', borderRadius: '4px' }}>
135:             {post != null ? (
136:               <>
137:                 <div className="absolute left-0 top-1/2 -translate-y-1/2 h-0.5 rounded-full transition-all"
