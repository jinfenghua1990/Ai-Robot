  8: from .factors import _ret
  9: def _number(value, default: float = 0.0) -> float:
 10:     if value is None:
 11:         return default
 12:     if isinstance(value, Decimal):
 13:         return float(value)
 14:     try:
 15:         return float(value)
 16:     except (TypeError, ValueError):
 17:         return default
 18: def _clean_name(value: object) -> str:
 19:     return str(value or "").upper().replace(" ", "").replace("　", "")
 20: def is_st(name: object) -> bool:
 21:     value = _clean_name(name)
 22:     return value.startswith("ST") or value.startswith("*ST")
 23: class MarketData:
 24:     """Read-only adapter over the existing Ai-Robot database.
 25:     No legacy ORM model or strategy service is imported here.  The new app
 26:     consumes only raw daily bars, stock metadata and sector flow data.
 27:     """
 28:     def resolve_date(self, requested: date | None = None) -> date | None:
 29:         sql = "SELECT MAX(trade_date) AS trade_date FROM stock_daily_kline"
 30:         params = {}
 31:         if requested:
 32:             sql += " WHERE trade_date <= :requested"
 33:             params["requested"] = requested
 34:         with engine.connect() as conn:
 35:             row = conn.execute(text(sql), params).mappings().first()
 36:         return row["trade_date"] if row and row["trade_date"] else None
 37:     def load_universe(self, trade_date: date) -> list[dict]:
 38:         sql = text("""
 39:             SELECT k.ts_code, k.close, k.volume,
 40:                    COALESCE(s.name, '') AS name,
 41:                    COALESCE(s.sector, k.sector, '') AS sector
 42:             FROM stock_daily_kline k
 43:             LEFT JOIN (
 44:               SELECT DISTINCT ON (ts_code) ts_code, name, sector
 45:               FROM stock_flow
 46:               WHERE trade_date = :trade_date
 47:               ORDER BY ts_code, id DESC
 48:             ) s ON s.ts_code = k.ts_code
 49:             WHERE k.trade_date = :trade_date
 50:               AND COALESCE(k.close, 0) > 0
 51:               AND COALESCE(k.volume, 0) > 0
 52:             ORDER BY k.ts_code
 53:         """)
 54:         with engine.connect() as conn:
 55:             rows = [dict(row._mapping) for row in conn.execute(sql, {"trade_date": trade_date})]
 56:         result = []
 57:         filtered_st = 0
 58:         for row in rows:
 59:             if is_st(row.get("name")):
 60:                 filtered_st += 1
 61:                 continue
 62:             row["close"] = _number(row.get("close"))
 63:             row["volume"] = _number(row.get("volume"))
 64:             row["name"] = row.get("name") or row["ts_code"]
 65:             row["sector"] = row.get("sector") or "未分类"
 66:             result.append(row)
 67:         self.last_filtered_st_count = filtered_st
 68:         return result
 69:     def load_history(self, codes: Iterable[str], trade_date: date, lookback_days: int = 240) -> dict[str, list[Bar]]:
 70:         code_list = list(dict.fromkeys(codes))
 71:         if not code_list:
 72:             return {}
 73:         start = trade_date - timedelta(days=lookback_days)
 74:         stmt = text("""
 75:             SELECT ts_code, trade_date, open, high, low, close, volume, amount, pct_chg, sector
 76:             FROM stock_daily_kline
 77:             WHERE ts_code IN :codes
 78:               AND trade_date BETWEEN :start_date AND :trade_date
 79:             ORDER BY ts_code, trade_date
 80:         """).bindparams(bindparam("codes", expanding=True))
 81:         with engine.connect() as conn:
 82:             rows = conn.execute(stmt, {
 83:                 "codes": code_list, "start_date": start, "trade_date": trade_date,
 84:             }).mappings().all()
 85:         metadata = {item["ts_code"]: item for item in self.load_universe(trade_date)}
 86:         result = {code: [] for code in code_list}
 87:         for row in rows:
 88:             meta = metadata.get(row["ts_code"], {})
 89:             result.setdefault(row["ts_code"], []).append(Bar(
 90:                 code=row["ts_code"],
 91:                 trade_date=row["trade_date"],
 92:                 open=_number(row.get("open")), high=_number(row.get("high")),
 93:                 low=_number(row.get("low")), close=_number(row.get("close")),
 94:                 volume=_number(row.get("volume")), amount=_number(row.get("amount")),
 95:                 pct_chg=_number(row.get("pct_chg")),
 96:                 name=meta.get("name", ""), sector=row.get("sector") or meta.get("sector", "未分类"),
 97:             ))
 98:         return {
 99:             code: bars[-120:]
100:             for code, bars in result.items()
101:             if bars and bars[-1].trade_date == trade_date
102:         }
103:     def load_sector_flow(self, trade_date: date) -> dict[str, dict[str, float | None]]:
104:         latest = None
105:         with engine.connect() as conn:
106:             latest = conn.execute(text(
107:                 "SELECT MAX(trade_date) FROM sector_flow WHERE trade_date <= :trade_date"
108:             ), {"trade_date": trade_date}).scalar()
109:             if not latest:
110:                 return {}
111:             rows = [dict(row._mapping) for row in conn.execute(text("""
112:                 SELECT sector, net_flow, heat_score, rise_ratio, avg_chg
113:                 FROM sector_flow WHERE trade_date = :trade_date
114:             """), {"trade_date": latest})]
115:         raw_flow = [_number(row.get("net_flow"), 0.0) for row in rows]
116:         ordered = sorted(raw_flow)
117:         result = {}
118:         for row in rows:
119:             flow = _number(row.get("net_flow"), 0.0)
120:             below = sum(value < flow for value in ordered)
121:             equal = sum(value == flow for value in ordered)
122:             percentile = 100 * (below + equal / 2) / len(ordered) if len(ordered) > 1 else 50.0
123:             rise = _number(row.get("rise_ratio"), 0.0)
124:             heat = _number(row.get("heat_score"), 0.0)
125:             avg_chg = _number(row.get("avg_chg"), 0.0)
126:             result[row["sector"]] = {
127:                 "net_flow": flow,
128:                 "net_flow_percentile": percentile,
129:                 "strength": max(0.0, min(100.0, rise * 0.55 + max(0.0, min(100.0, heat)) * 0.25 + max(0.0, min(100.0, 50 + avg_chg * 10)) * 0.20)),
130:                 "data_date": latest,
131:             }
132:         return result
133:     def market_context(self, trade_date: date, universe: list[dict], history: dict[str, list[Bar]]) -> MarketContext:
134:         changes = []
135:         limit_up = 0
136:         limit_down = 0
137:         returns = []
138:         for item in universe:
139:             bars = history.get(item["ts_code"], [])
140:             if not bars:
141:                 continue
142:             bar = bars[-1]
143:             change = bar.pct_chg * 100 if abs(bar.pct_chg) <= 1 else bar.pct_chg
144:             changes.append(change)
145:             limit_up += change >= 9.5
146:             limit_down += change <= -9.5
147:             r20 = _ret([value.close for value in bars], 20)
148:             if r20 is not None:
149:                 returns.append(r20)
150:         breadth = sum(value > 0 for value in changes) / len(changes) if changes else 0.0
151:         market_return = sum(returns) / len(returns) if returns else None
152:         balance = (limit_up - limit_down) / (limit_up + limit_down + 10)
153:         if breadth >= 0.68 and (market_return is None or market_return >= 0):
154:             state, sentiment = "STRONG", "偏强"
155:         elif breadth < 0.32 or balance <= -0.35 or (market_return is not None and market_return <= -0.08):
156:             state, sentiment = "WEAK", "偏弱"
157:         else:
158:             state, sentiment = "RANGE", "震荡"
159:         return MarketContext(
160:             trade_date, breadth, int(limit_up), int(limit_down), market_return,
161:             sentiment, state, "stock_daily_kline全市场截面代理",
162:         )
