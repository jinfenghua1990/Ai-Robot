 1: from __future__ import annotations
 2: from dataclasses import dataclass
 3: from datetime import date
 4: from typing import Iterable, Mapping, Sequence
 5: from .contracts import DailyBar, MarketContext
 6: @dataclass(frozen=True)
 7: class DataQuality:
 8:     valid: bool
 9:     reasons: tuple[str, ...] = ()
10: def quality_gate(bars: Sequence[DailyBar], trade_date: date, max_staleness_days: int = 0) -> DataQuality:
11:     reasons = []
12:     if not bars:
13:         reasons.append("no_bars")
14:     else:
15:         latest = max(item.trade_date for item in bars)
16:         if latest != trade_date:
17:             reasons.append("stale_or_missing_latest_bar")
18:         if any(item.is_suspended for item in bars if item.trade_date == trade_date):
19:             reasons.append("suspended")
20:         if any(item.is_st for item in bars if item.trade_date == trade_date):
21:             reasons.append("st_stock")
22:     return DataQuality(not reasons, tuple(reasons))
23: def build_universe(history: Mapping[str, Sequence[DailyBar]], trade_date: date, market: MarketContext) -> dict[str, Sequence[DailyBar]]:
24:     """基础股票池门禁；不以单日资金流作为唯一入池条件。"""
25:     if market.trade_date != trade_date:
26:         raise ValueError("market context date mismatch")
27:     return {
28:         code: bars
29:         for code, bars in history.items()
30:         if quality_gate(bars, trade_date).valid
31:         and bars[-1].close > 0
32:         and bars[-1].volume > 0
33:     }
