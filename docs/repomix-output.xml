142:             'message': f'[{trade_date}] 最新快照 {latest_time} 仅覆盖 {latest_snapshot_count} 只股票，低于预期 {min_expected_stocks}',
143:             'details': {
144:                 'latest_time': latest_time.isoformat(),
145:                 'latest_snapshot_count': latest_snapshot_count,
146:                 'min_expected_stocks': min_expected_stocks,
147:             },
148:         })
149:     for a in alerts:
150:         record_alert(**a, trade_date=trade_date)
151:     return alerts[0] if alerts else None
