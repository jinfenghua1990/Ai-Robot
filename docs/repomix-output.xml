112: def _cache_kline_to_db(ts_code: str, ts_data: list):
113:     """将 Tushare daily 数据写入 stock_daily_kline 表缓存"""
114:     if not ts_data:
115:         return
116:     try:
117:         from datetime import datetime as dt
118:         with get_db_session() as db:
119:             existing_dates = {str(r.trade_date) for r in db.query(StockDailyKline).filter(
120:                 StockDailyKline.ts_code == ts_code
121:             ).all()}
122:             new_rows = []
123:             for item in ts_data:
124:                 td = item.get('trade_date', '')
125:                 if not td or td in existing_dates:
126:                     continue
127:                 try:
128:                     new_rows.append(StockDailyKline(
129:                         ts_code=ts_code,
130:                         trade_date=dt.strptime(td, '%Y%m%d').date(),
131:                         open=float(item['open']), high=float(item['high']),
132:                         low=float(item['low']), close=float(item['close']),
133:                         volume=int(float(item.get('vol', 0) or 0)),
134:                         amount=float(item.get('amount', 0) or 0),
135:                         pct_chg=float(item.get('pct_chg', 0) or 0),
136:                     ))
137:                 except (KeyError, ValueError):
138:                     continue
139:             if new_rows:
140:                 db.bulk_save_objects(new_rows)
141:                 db.commit()
142:                 logger.info(f'[market_state] 缓存 {len(new_rows)} 条 K线到 stock_daily_kline ({ts_code})')
143:     except Exception:
144:         logger.debug(f'_cache_kline_to_db failed for {ts_code}', exc_info=True)
145: def _stock_code_to_tushare(stock_code: str) -> str:
146:     """A股代码转tushare格式（StockFlow表用）：6/9开头→.SH，0/3开头→.SZ，4/8开头→.BJ"""
147:     code = (stock_code or '').strip().split('.')[0]
148:     if code.startswith(('6', '9')):
149:         return f'{code}.SH'
150:     if code.startswith(('4', '8')):
151:         return f'{code}.BJ'
152:     return f'{code}.SZ'
153: def _fetch_money_flow(stock_code: str, days: int = 5) -> dict:
154:     """从 StockFlow 表读取主力资金流数据
155:     返回 {main_net_inflow_1d, main_net_inflow_3d, main_net_inflow_5d, flow_continuity, flow_strength}
156:     """
157:     from db.models import StockFlow
158:     ts_code = _stock_code_to_tushare(stock_code)
159:     with get_db_session() as db:
160:         rows = db.query(StockFlow).filter(
161:             StockFlow.ts_code == ts_code
162:         ).order_by(StockFlow.trade_date.desc()).limit(days).all()
163:         if not rows:
164:             return {'main_net_inflow_1d': 0, 'main_net_inflow_3d': 0, 'main_net_inflow_5d': 0,
165:                     'flow_continuity': 0, 'flow_strength': 0}
166:         inflows = [float(r.main_force_inflow or 0) for r in rows]
167:         inflow_1d = inflows[0]
168:         inflow_3d = sum(inflows[:3]) if len(inflows) >= 3 else sum(inflows)
169:         inflow_5d = sum(inflows[:5]) if len(inflows) >= 5 else sum(inflows)
170:         # 连续为正天数
171:         continuity = 0
172:         for v in inflows:
173:             if v > 0:
174:                 continuity += 1
175:             else:
176:                 break
177:         return {
178:             'main_net_inflow_1d': round(inflow_1d, 0),
179:             'main_net_inflow_3d': round(inflow_3d, 0),
180:             'main_net_inflow_5d': round(inflow_5d, 0),
181:             'flow_continuity': continuity,
182:             'flow_strength': round(inflow_5d, 0),
183:         }
184: # ===================== 指标计算 =====================
185: def _calc_ma(values: list, period: int) -> list:
186:     """简单移动平均"""
187:     ma = []
188:     for i in range(len(values)):
189:         if i < period - 1:
190:             ma.append(None)
191:         else:
192:             ma.append(sum(values[i - period + 1: i + 1]) / period)
193:     return ma
194: def _calc_atr(klines: list, period: int = 14) -> float:
195:     """ATR(14) - 平均真实波幅"""
196:     if len(klines) < period + 1:
197:         return 0
198:     trs = []
199:     for i in range(1, len(klines)):
200:         high = klines[i]['high']
201:         low = klines[i]['low']
202:         prev_close = klines[i - 1]['close']
203:         tr = max(
204:             high - low,
205:             abs(high - prev_close),
206:             abs(low - prev_close),
207:         )
208:         trs.append(tr)
209:     return sum(trs[-period:]) / period if len(trs) >= period else 0
210: def _calc_noise_ratio(klines: list, period: int = 5) -> float:
211:     """噪音比 = (上影线 + 下影线) / 实体，取近5日均值"""
212:     recent = klines[-period:] if len(klines) >= period else klines
213:     ratios = []
214:     for k in recent:
215:         body = abs(k['close'] - k['open'])
216:         if body < 0.001:
217:             ratios.append(2.0)  # 十字星，噪音极高
218:             continue
219:         upper_shadow = k['high'] - max(k['close'], k['open'])
220:         lower_shadow = min(k['close'], k['open']) - k['low']
221:         ratios.append((upper_shadow + lower_shadow) / body)
222:     return sum(ratios) / len(ratios) if ratios else 0
223: def compute_features(klines: list, sector_strength: float = 0, money_flow: dict = None) -> dict:
224:     """从K线列表计算6类特征数据，返回字典"""
225:     if len(klines) < 60:
226:         return None
227:     closes = [k['close'] for k in klines]
228:     volumes = [k['volume'] for k in klines]
229:     highs = [k['high'] for k in klines]
230:     lows = [k['low'] for k in klines]
231:     # ① 价格结构
232:     ma5_list = _calc_ma(closes, 5)
233:     ma20_list = _calc_ma(closes, 20)
234:     ma60_list = _calc_ma(closes, 60)
235:     close = closes[-1]
236:     ma5 = ma5_list[-1]
237:     ma20 = ma20_list[-1]
238:     ma60 = ma60_list[-1]
239:     # MA20斜率（5日前vs现在，归一化）
240:     ma20_5d_ago = ma20_list[-6] if len(ma20_list) >= 6 and ma20_list[-6] else ma20
241:     ma20_slope = (ma20 - ma20_5d_ago) / ma20_5d_ago if ma20_5d_ago > 0 else 0
242:     close_vs_ma20 = (close - ma20) / ma20 if ma20 > 0 else 0
243:     # 近20日新高突破次数（当日high突破前20日最高价）
244:     high_break_20d = 0
245:     if len(highs) >= 25:
246:         for i in range(20, len(highs)):
247:             prev_20d_high = max(highs[i - 20: i])
248:             if highs[i] > prev_20d_high:
249:                 high_break_20d += 1
250:     # ② 成交量
251:     volume = volumes[-1]
252:     volume_ma20 = sum(volumes[-20:]) / 20 if len(volumes) >= 20 else (sum(volumes) / len(volumes) if volumes else 1)
253:     volume_ratio = volume / volume_ma20 if volume_ma20 > 0 else 1.0
254:     # ③ 资金流（从 StockFlow 表读取主力净流入）
255:     mf = money_flow or {}
256:     main_net_inflow_1d = mf.get('main_net_inflow_1d', 0)
257:     main_net_inflow_3d = mf.get('main_net_inflow_3d', 0)
258:     main_net_inflow_5d = mf.get('main_net_inflow_5d', 0)
259:     flow_continuity = mf.get('flow_continuity', 0)  # 连续净流入天数
260:     flow_strength = mf.get('flow_strength', 0)       # 5日累计净流入
261:     # ④ 波动结构
262:     atr_14 = _calc_atr(klines, 14)
263:     noise_ratio = _calc_noise_ratio(klines, 5)
264:     # RSI(14) - 用于技术形态 7 段判定（顶部判断）
265:     rsi_list = calc_rsi(closes, 14)
266:     rsi_14 = rsi_list[-1] if rsi_list and rsi_list[-1] is not None else None
267:     # ⑤ 趋势一致性
268:     if len(highs) >= 10:
269:         recent_5_high = max(highs[-5:])
270:         prev_5_high = max(highs[-10:-5])
271:         higher_high_flag = 1 if recent_5_high > prev_5_high else 0
272:         recent_5_low = min(lows[-5:])
273:         prev_5_low = min(lows[-10:-5])
274:         higher_low_flag = 1 if recent_5_low > prev_5_low else 0
275:     else:
276:         higher_high_flag = 0
277:         higher_low_flag = 0
278:     # 趋势一致性评分：近10日上涨日占比
279:     up_count = sum(1 for i in range(-10, 0) if closes[i] > closes[i - 1]) if len(closes) >= 11 else 0
280:     trend_consistency_score = up_count / 10
281:     return {
282:         'close': round(close, 3),
283:         'ma5': round(ma5, 3) if ma5 else None,
284:         'ma20': round(ma20, 3) if ma20 else None,
285:         'ma60': round(ma60, 3) if ma60 else None,
286:         'ma20_slope': round(ma20_slope, 4),
287:         'close_vs_ma20': round(close_vs_ma20, 4),
288:         'high_break_20d': high_break_20d,
289:         'volume': volume,
290:         'volume_ma20': int(volume_ma20),
291:         'volume_ratio': round(volume_ratio, 2),
292:         'main_net_inflow_1d': main_net_inflow_1d,
293:         'main_net_inflow_3d': main_net_inflow_3d,
294:         'main_net_inflow_5d': main_net_inflow_5d,
295:         'flow_continuity': flow_continuity,
296:         'atr_14': round(atr_14, 3),
297:         'noise_ratio': round(noise_ratio, 2),
298:         'higher_high_flag': higher_high_flag,
299:         'higher_low_flag': higher_low_flag,
300:         'trend_consistency_score': round(trend_consistency_score, 2),
301:         'sector_strength': round(sector_strength, 2),
302:         'rsi_14': round(rsi_14, 2) if rsi_14 else None,
303:     }
304: # ===================== 3态判定 =====================
305: def classify_market_state(f: dict) -> tuple:
306:     """
307:     判定市场状态：CHOPPY / TREND / IMPULSE
308:     返回 (state, reasons_list)
309:     """
310:     if not f:
311:         return ('UNKNOWN', ['数据不足'])
312:     reasons = []
313:     # ---- IMPULSE（主升）：趋势 + 加速 + 资金连续 + 板块共振 ----
314:     impulse_score = 0
315:     if f['close_vs_ma20'] > 0.03:
316:         impulse_score += 1; reasons.append('close高于MA20 3%+')
317:     if f['ma20_slope'] > 0.01:
318:         impulse_score += 1; reasons.append('MA20快速上行')
319:     if f['volume_ratio'] > 1.5:
320:         impulse_score += 1; reasons.append(f"放量({f['volume_ratio']}倍)")
321:     if f['flow_continuity'] >= 3:
322:         impulse_score += 1; reasons.append(f"连续{f['flow_continuity']}日主力净流入")
323:     if f['higher_high_flag'] and f['higher_low_flag']:
324:         impulse_score += 1; reasons.append('高低点同步抬高')
325:     if f['noise_ratio'] < 1.0:
326:         impulse_score += 1; reasons.append(f"走势干净(noise={f['noise_ratio']})")
327:     if f['sector_strength'] > 2:
328:         impulse_score += 1; reasons.append(f"板块强势({f['sector_strength']}%)")
329:     if impulse_score >= 5:
330:         return ('IMPULSE', reasons[:4])
331:     # ---- TREND（趋势）：有方向 + 有延续资金 ----
332:     trend_score = 0
333:     trend_reasons = []
334:     if f['close_vs_ma20'] > 0:
335:         trend_score += 1; trend_reasons.append('close>MA20')
336:     if f['ma20'] and f['ma60'] and f['ma20'] > f['ma60']:
337:         trend_score += 1; trend_reasons.append('MA20>MA60')
338:     if f['ma20_slope'] > 0:
339:         trend_score += 1; trend_reasons.append('MA20正斜率')
340:     if f['volume_ratio'] > 1.2:
341:         trend_score += 1; trend_reasons.append(f"温和放量({f['volume_ratio']}倍)")
342:     if f['main_net_inflow_3d'] > 0:
343:         trend_score += 1; trend_reasons.append('3日主力净流入为正')
344:     if f['higher_high_flag']:
345:         trend_score += 1; trend_reasons.append('创新高')
346:     if trend_score >= 4:
347:         return ('TREND', trend_reasons[:4])
348:     # ---- CHOPPY（杂毛）：没方向 + 资金断 + 走势乱 ----
349:     choppy_reasons = []
350:     if abs(f['close_vs_ma20']) < 0.02:
351:         choppy_reasons.append('close在MA20附近横盘')
352:     if abs(f['ma20_slope']) < 0.005:
353:         choppy_reasons.append('MA20斜率≈0')
354:     if not f['higher_high_flag']:
355:         choppy_reasons.append('无higher high')
356:     if f['noise_ratio'] > 1.5:
357:         choppy_reasons.append(f"噪音高(noise={f['noise_ratio']})")
358:     if f['main_net_inflow_3d'] <= 0:
359:         choppy_reasons.append('3日主力资金不连续')
360:     if f['volume_ratio'] < 0.8:
361:         choppy_reasons.append(f"缩量({f['volume_ratio']}倍)")
362:     # 默认就是 CHOPPY（不满足 TREND/IMPULSE 的都是杂毛）
363:     if not choppy_reasons:
364:         choppy_reasons.append('未达趋势标准')
365:     return ('CHOPPY', choppy_reasons[:4])
