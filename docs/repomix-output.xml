 => remove(report.id)} className="rounded border px-2 py-1 text-[10px]" style={{ borderColor: '#ef444466', color: '#b91c1c' }}>删除</button></div></div>)}{!reports.length && <div className="p-8 text-center text-xs" style={{ color: 'var(--text-muted)' }}>暂无本地研报，点击右上角上传</div>}</div>}</div>;
