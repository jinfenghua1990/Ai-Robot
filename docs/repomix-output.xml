441: def _parse_date_yyyymmdd(s: str):
442:     """YYYYMMDD 字符串转 date 对象"""
443:     try:
444:         return datetime.strptime(s, '%Y%m%d').date()
445:     except (ValueError, TypeError):
446:         return None
447: def _days_between(d1: str, d2: str) -> Optional[int]:
448:     """两个 YYYYMMDD 字符串之间相隔天数 (calendar days)"""
449:     dt1 = _parse_date_yyyymmdd(d1)
450:     dt2 = _parse_date_yyyymmdd(d2)
451:     if not dt1 or not dt2:
452:         return None
453:     return (dt2 - dt1).days
454: @router.get("/api/yuzi/holdings")
455: def holdings(
456:     days: int = Query(30, description="回溯最近 N 天的席位记录"),
457:     alias: Optional[str] = Query(None, description="按大佬别名过滤"),
458:     ts_code: Optional[str] = Query(None, description="按股票代码过滤"),
459:     status: Optional[str] = Query(None, description="'open'=未平仓 / 'closed'=已平仓 / None=全部"),
460:     min_hold_days: int = Query(0, description="最小持有天数过滤(已平仓)"),
461:     limit: int = Query(300, description="最多返回条数"),
462: ):
463:     """
464:     大佬持仓跟踪: 把同一 (alias, ts_code) 的 BUY 和后续 SELL 配对,算持有天数和收益率
465:     算法(简化 FIFO):
466:       - 按 (alias, ts_code) 分组,组内按 trade_date ASC 排序
467:       - open_date = 首次 BUY 记录日期
468:       - close_date = 首次 SELL 记录(open_date 之后)日期
469:       - 持有天数 = close_date - open_date (calendar days)
470:       - 收益率 = (close日 close价 - open日 close价) / open日 close价 × 100
471:       - 若无 close_date → status='open' (未平仓)
472:     注: 龙虎榜数据是席位日聚合(非订单级),所以 BUY/SELL 配对是近似(FIFO),
473:         够回答"大佬买入后第几天跑了"这个核心问题。
474:     """
475:     with get_db_session() as db:
476:         cutoff = (datetime.now() - timedelta(days=days + 15)).strftime('%Y%m%d')
477:         q = db.query(YuziSeatDaily).filter(YuziSeatDaily.trade_date >= cutoff)
478:         if alias:
479:             q = q.filter(YuziSeatDaily.yuzi_alias == alias)
480:         if ts_code:
481:             q = q.filter(YuziSeatDaily.ts_code == ts_code)
482:         rows = q.order_by(
483:             YuziSeatDaily.yuzi_alias,
484:             YuziSeatDaily.ts_code,
485:             YuziSeatDaily.trade_date,
486:         ).all()
487:         # 按 (alias, ts_code) 分组
488:         groups: dict = defaultdict(list)
489:         for r in rows:
490:             groups[(r.yuzi_alias, r.ts_code)].append(r)
491:         results = []
492:         for (alias_name, code), recs in groups.items():
493:             if not recs or not alias_name:
494:                 continue
495:             stock_name = recs[0].stock_name or ''
496:             # 过滤 ST
497:             if 'ST' in stock_name or 'ST' in code:
498:                 continue
499:             buy_recs = [r for r in recs if r.side == 'BUY']
500:             sell_recs = [r for r in recs if r.side == 'SELL']
501:             if not buy_recs:
502:                 continue  # 只有卖出没有买入,无法配对
503:             open_rec = buy_recs[0]
504:             open_date = open_rec.trade_date
505:             open_amount = float(open_rec.net_amount or 0)
506:             # 找首次 SELL after open_date
507:             close_rec = next((s for s in sell_recs if s.trade_date > open_date), None)
508:             if close_rec:
509:                 close_date = close_rec.trade_date
510:                 close_amount = float(close_rec.net_amount or 0)
511:                 hold_days = _days_between(open_date, close_date)
512:                 status_val = 'closed'
513:             else:
514:                 close_date = None
515:                 close_amount = None
516:                 hold_days = None
517:                 status_val = 'open'
518:             # 过滤: 最小持有天数
519:             if min_hold_days and (hold_days is None or hold_days < min_hold_days):
520:                 continue
521:             # 过滤: 状态
522:             if status and status_val != status:
523:                 continue
524:             # 算收益率 (用 StockDailyKline)
525:             return_pct = None
526:             if close_date:
527:                 open_dt = _parse_date_yyyymmdd(open_date)
528:                 close_dt = _parse_date_yyyymmdd(close_date)
529:                 if open_dt and close_dt:
530:                     k_open = db.query(StockDailyKline).filter(
531:                         StockDailyKline.ts_code == code,
532:                         StockDailyKline.trade_date == open_dt,
533:                     ).first()
534:                     k_close = db.query(StockDailyKline).filter(
535:                         StockDailyKline.ts_code == code,
536:                         StockDailyKline.trade_date == close_dt,
537:                     ).first()
538:                     if k_open and k_close:
539:                         o = float(k_open.close or 0)
540:                         c = float(k_close.close or 0)
541:                         if o > 0:
542:                             return_pct = round((c - o) / o * 100, 2)
543:             results.append({
544:                 'alias': alias_name,
545:                 'ts_code': code,
546:                 'stock_name': stock_name,
547:                 'open_date': open_date,
548:                 'open_amount': round(open_amount, 2),
549:                 'close_date': close_date,
550:                 'close_amount': round(close_amount, 2) if close_amount is not None else None,
551:                 'hold_days': hold_days,
552:                 'return_pct': return_pct,
553:                 'status': status_val,
554:             })
555:         # 排序: 未平仓优先,然后按 open_date desc
556:         results.sort(
557:             key=lambda x: (x['status'] != 'open', -(int(x['open_date']) if x['open_date'] else 0))
558:         )
559:         total_before_limit = len(results)
560:         results = results[:limit]
561:         # 汇总
562:         open_count = sum(1 for r in results if r['status'] == 'open')
563:         closed_count = sum(1 for r in results if r['status'] == 'closed')
564:         closed_with_hold = [r for r in results if r['hold_days'] is not None]
565:         avg_hold = (
566:             sum(r['hold_days'] for r in closed_with_hold) / len(closed_with_hold)
567:             if closed_with_hold else 0
568:         )
569:         win_count = sum(1 for r in results if r['return_pct'] and r['return_pct'] > 0)
570:         win_rate = round(win_count / max(closed_count, 1) * 100, 1) if closed_count else 0
571:         return {
572:             'total': total_before_limit,
573:             'returned': len(results),
574:             'open_count': open_count,
575:             'closed_count': closed_count,
576:             'avg_hold_days': round(avg_hold, 1) if closed_with_hold else 0,
577:             'win_rate': win_rate,
578:             'holdings': results,
579:         }
