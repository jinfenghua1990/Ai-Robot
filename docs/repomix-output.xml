<file path="backend/api/bs_backtest/engine.py">
  1: """BS 回测核心引擎：单股回测 + 统计指标 + 交易费"""
  2: import math
  3: import logging
  4: from datetime import datetime
  5: from api.bs_signals import _generate_bs_signals
  6: logger = logging.getLogger(__name__)
  7: COMMISSION_RATE = 0.0005
  8: STAMP_TAX_RATE = 0.001
  9: MIN_TRADE_FEE = 5.0
 10: def _calc_trade_fee(amount: float, is_buy: bool) -> float:
 11:     commission = max(amount * COMMISSION_RATE, MIN_TRADE_FEE)
 12:     if is_buy:
 13:         return commission
 14:     return commission + amount * STAMP_TAX_RATE
 15: def _calc_hold_days(entry_date: str, exit_date: str) -> int:
 16:     """计算持仓天数（自然日）"""
 17:     try:
 18:         d1 = datetime.strptime(entry_date[:10], '%Y-%m-%d')
 19:         d2 = datetime.strptime(exit_date[:10], '%Y-%m-%d')
 20:         return (d2 - d1).days
 21:     except Exception:
 22:         logger.debug(f"_calc_hold_days failed", exc_info=True)
 23:         return 0
 24: def _calc_stats(trades: list, equity_curve: list, initial_capital: float) -> dict:
 25:     """计算回测统计指标"""
 26:     def _safe(v, default=0):
 27:         if v is None:
 28:             return default
 29:         try:
 30:             f = float(v)
 31:             if math.isnan(f) or math.isinf(f):
 32:                 return default
 33:             return f
 34:         except Exception:
 35:             logger.debug(f"_safe failed", exc_info=True)
 36:             return default
 37:     for t in trades:
 38:         t['profit'] = _safe(t.get('profit', 0))
 39:         t['profit_pct'] = _safe(t.get('profit_pct', 0))
 40:         t['hold_days'] = max(0, _safe(t.get('hold_days', 0), 0))
 41:     for p in equity_curve:
 42:         p['equity'] = _safe(p.get('equity', 0), 0)
 43:     if not trades:
 44:         return {
 45:             'total_trades': 0,
 46:             'win_trades': 0,
 47:             'loss_trades': 0,
 48:             'win_rate': 0,
 49:             'total_profit': 0,
 50:             'total_profit_pct': 0,
 51:             'avg_profit_pct': 0,
 52:             'max_profit_pct': 0,
 53:             'max_loss_pct': 0,
 54:             'avg_hold_days': 0,
 55:             'profit_factor': 0,
 56:             'max_drawdown': 0,
 57:             'max_drawdown_pct': 0,
 58:             'annual_return': 0,
 59:         }
 60:     win_trades = [t for t in trades if t['profit'] > 0]
 61:     loss_trades = [t for t in trades if t['profit'] <= 0]
 62:     total_profit = sum(t['profit'] for t in trades)
 63:     gross_profit = sum(t['profit'] for t in win_trades) if win_trades else 0
 64:     gross_loss = abs(sum(t['profit'] for t in loss_trades)) if loss_trades else 0
 65:     max_equity = 0
 66:     max_drawdown = 0
 67:     max_drawdown_pct = 0
 68:     for point in equity_curve:
 69:         eq = point['equity']
 70:         if eq > max_equity:
 71:             max_equity = eq
 72:         dd = max_equity - eq
 73:         if dd > max_drawdown:
 74:             max_drawdown = dd
 75:             max_drawdown_pct = (dd / max_equity * 100) if max_equity else 0
 76:     total_days = _calc_hold_days(equity_curve[0]['date'], equity_curve[-1]['date']) if equity_curve else 1
 77:     total_days = max(total_days, 1)
 78:     total_return_pct = (total_profit / initial_capital * 100) if initial_capital else 0
 79:     annual_return = ((1 + total_return_pct / 100) ** (365 / total_days) - 1) * 100 if total_days > 0 else 0
 80:     result = {
 81:         'total_trades': len(trades),
 82:         'win_trades': len(win_trades),
 83:         'loss_trades': len(loss_trades),
 84:         'win_rate': round(len(win_trades) / len(trades) * 100, 1),
 85:         'total_profit': round(total_profit, 2),
 86:         'gross_profit': round(gross_profit, 2),
 87:         'gross_loss': round(gross_loss, 2),
 88:         'total_profit_pct': round(total_return_pct, 2),
 89:         'avg_profit_pct': round(sum(t['profit_pct'] for t in trades) / len(trades), 2),
 90:         'max_profit_pct': round(max(t['profit_pct'] for t in trades), 2),
 91:         'max_loss_pct': round(min(t['profit_pct'] for t in trades), 2),
 92:         'avg_hold_days': round(sum(t['hold_days'] for t in trades) / len(trades), 1),
 93:         'profit_factor': round(gross_profit / gross_loss, 2) if gross_loss > 0 else 99.99,
 94:         'max_drawdown': round(max_drawdown, 2),
 95:         'max_drawdown_pct': round(max_drawdown_pct, 2),
 96:         'annual_return': round(annual_return, 2),
 97:     }
 98:     for k, v in result.items():
 99:         if isinstance(v, float) and (math.isnan(v) or math.isinf(v)):
100:             if k == 'profit_factor':
101:                 result[k] = 99.99
102:             else:
103:                 result[k] = 0
104:     return result
105: def _backtest_single(
106:     klines: list,
107:     atr_period: int,
108:     atr_multiplier: float,
109:     initial_capital: float,
110:     start_date: str,
111:     end_date: str,
112:     volume_filter: bool = False,
113:     ma20_filter: bool = False,
114:     ma60_trend: bool = False,
115:     rsi_filter: bool = False,
116:     strong_volume: bool = False,
117:     macd_filter: bool = False,
118:     kdj_filter: bool = False,
119:     stop_loss_pct: float = 0.0,
120:     rsi_lower: int = 30,
121:     rsi_upper: int = 70,
122:     main_force_filter: bool = False,
123:     main_force_db=None,
124:     main_force_lookback: int = 3,
125:     main_force_min_total: float = 0.0,
126:     ma60_rising: bool = False,
127:     code: str = '',
128:     sector_uptrend_filter: bool = False,
129:     sector_top10_map: dict = None,
130:     stock_sector_map: dict = None,
131:     sector_no_data_action: str = 'pass',
132: ) -> dict:
133:     """单股回测
134:     B 点次日开盘买入，S 点次日开盘卖出，全仓操作
135:     """
136:     if len(klines) < 30:
137:         return {'trades': [], 'stats': {}, 'equity_curve': [], 'error': 'K线数据不足'}
138:     bs_signals, dif, dea, macd, ma5, ma20, k_vals, d_vals, j_vals, support, resistance, trend = \
139:         _generate_bs_signals(klines, atr_period, atr_multiplier)
140:     if not bs_signals:
141:         return {'trades': [], 'stats': {}, 'equity_curve': [], 'error': '无信号'}
142:     ma60 = None
143:     rsi_vals = None
144:     if ma60_trend or ma60_rising or rsi_filter:
145:         from api.bs_signals import _calc_ma, _calc_rsi
146:         if ma60_trend or ma60_rising:
147:             ma60 = _calc_ma(klines, 60)
148:         if rsi_filter:
149:             rsi_vals = _calc_rsi(klines, 14)
150:     date_idx = {k['date']: i for i, k in enumerate(klines)}
151:     in_range_signals = [s for s in bs_signals if start_date <= s['date'] <= end_date]
152:     if volume_filter or ma20_filter or ma60_trend or ma60_rising or rsi_filter or strong_volume or macd_filter or kdj_filter or sector_uptrend_filter:
153:         filtered = []
154:         for sig in in_range_signals:
155:             if sig['type'] == 'S':
156:                 filtered.append(sig)
157:                 continue
158:             sig_idx = date_idx.get(sig['date'])
159:             if sig_idx is None or sig_idx == 0:
160:                 filtered.append(sig)
161:                 continue
162:             if volume_filter and sig_idx >= 5:
163:                 vol_today = klines[sig_idx]['volume']
164:                 vol_avg5 = sum(klines[sig_idx - 5 + j]['volume'] for j in range(5)) / 5
165:                 if vol_today < vol_avg5:
166:                     continue
167:             if strong_volume and sig_idx >= 5:
168:                 vol_today = klines[sig_idx]['volume']
169:                 vol_avg5 = sum(klines[sig_idx - 5 + j]['volume'] for j in range(5)) / 5
170:                 if vol_today < vol_avg5 * 2:
171:                     continue
172:             if ma20_filter and ma20 and sig_idx > 0:
173:                 if ma20[sig_idx] is None or ma20[sig_idx - 1] is None:
174:                     continue
175:                 if ma20[sig_idx] <= ma20[sig_idx - 1]:
176:                     continue
177:             if ma60_trend and ma60 and sig_idx > 0:
178:                 if ma60[sig_idx] is None:
179:                     continue
180:                 if klines[sig_idx]['close'] < ma60[sig_idx]:
181:                     continue
182:             if rsi_filter and rsi_vals and sig_idx > 0:
183:                 rsi = rsi_vals[sig_idx]
184:                 if rsi is None or rsi < rsi_lower or rsi > rsi_upper:
185:                     continue
186:             if ma60_rising and ma60 and sig_idx > 1:
187:                 if ma60[sig_idx] is None or ma60[sig_idx - 1] is None:
188:                     continue
189:                 if ma60[sig_idx] <= ma60[sig_idx - 1]:
190:                     continue
191:             if macd_filter and sig_idx > 0:
192:                 if macd[sig_idx] is None or macd[sig_idx] <= 0:
193:                     continue
194:             if kdj_filter and sig_idx > 0:
195:                 if k_vals[sig_idx] is None or k_vals[sig_idx] >= 80:
196:                     continue
197:             if sector_uptrend_filter:
198:                 sig_date = sig['date']
199:                 top10 = sector_top10_map.get(sig_date) if sector_top10_map else None
200:                 if top10 is None:
201:                     if sector_no_data_action == 'block':
202:                         continue
203:                 else:
204:                     sector = stock_sector_map.get(code) if stock_sector_map else None
205:                     if not sector or sector not in top10:
206:                         continue
207:             if main_force_filter and main_force_db is not None:
208:                 try:
209:                     from datetime import datetime as _dt, timedelta as _td
210:                     from db.models import StockFlow
211:                     sig_dt = _dt.strptime(sig['date'], '%Y-%m-%d').date()
212:                     start_dt = sig_dt - _td(days=main_force_lookback + 3)
213:                     rows = main_force_db.query(StockFlow).filter(
214:                         StockFlow.ts_code == (code if code.endswith('.SH') or code.endswith('.SZ') else f"{code}.{'SH' if code.startswith('6') else 'SZ'}"),
215:                         StockFlow.trade_date > start_dt,
216:                         StockFlow.trade_date <= sig_dt,
217:                     ).order_by(StockFlow.trade_date.desc()).limit(main_force_lookback).all()
218:                     if not rows:
219:                         pass
220:                     else:
221:                         total_wan = sum(float(r.main_force_inflow or 0) for r in rows) / 10000.0
222:                         if total_wan < main_force_min_total:
223:                             continue
224:                 except Exception as e:
225:                     logger.debug(f'[bs_backtest] 主力净流入查询失败: {e}')
226:             filtered.append(sig)
227:         in_range_signals = filtered
228:     trades = []
229:     position = 0
230:     entry_price = 0.0
231:     entry_date = ''
232:     capital = initial_capital
233:     equity_curve = []
234:     signal_map = {s['date']: s for s in in_range_signals}
235:     for i, k in enumerate(klines):
236:         cur_date = k['date']
237:         if cur_date < start_date:
238:             continue
239:         if cur_date > end_date:
240:             break
241:         if position > 0 and stop_loss_pct > 0 and i + 1 < len(klines):
242:             stop_price = entry_price * (1 - stop_loss_pct / 100)
243:             if k['low'] <= stop_price:
244:                 next_k = klines[i + 1]
245:                 trade_price = next_k['open']
246:                 sell_amount = position * trade_price
247:                 fee = _calc_trade_fee(sell_amount, False)
248:                 capital += (sell_amount - fee)
249:                 profit = (trade_price - entry_price) * position - _calc_trade_fee(entry_price * position, True) - fee
250:                 profit_pct = (trade_price - entry_price) / entry_price * 100
251:                 trades.append({
252:                     'code': code, 'entry_date': entry_date,
253:                     'entry_price': round(entry_price, 2), 'exit_date': next_k['date'],
254:                     'exit_price': round(trade_price, 2), 'shares': position,
255:                     'profit': round(profit, 2), 'profit_pct': round(profit_pct, 2),
256:                     'hold_days': _calc_hold_days(entry_date, next_k['date']),
257:                     'signal_reason': f'止损({stop_loss_pct}%)',
258:                 })
259:                 position = 0
260:                 entry_price = 0.0
261:                 continue
262:         sig = signal_map.get(cur_date)
263:         if sig and i + 1 < len(klines):
264:             next_k = klines[i + 1]
265:             trade_price = next_k['open']
266:             if sig['type'] == 'B' and position == 0:
267:                 buy_amount = capital
268:                 shares = int(buy_amount / trade_price / 100) * 100
269:                 if shares <= 0:
270:                     continue
271:                 cost = shares * trade_price
272:                 fee = _calc_trade_fee(cost, True)
273:                 capital -= (cost + fee)
274:                 position = shares
275:                 entry_price = trade_price
276:                 entry_date = next_k['date']
277:             elif sig['type'] == 'S' and position > 0:
278:                 sell_amount = position * trade_price
279:                 fee = _calc_trade_fee(sell_amount, False)
280:                 capital += (sell_amount - fee)
281:                 profit = (trade_price - entry_price) * position - _calc_trade_fee(entry_price * position, True) - fee
282:                 profit_pct = (trade_price - entry_price) / entry_price * 100
283:                 trades.append({
284:                     'code': code, 'entry_date': entry_date,
285:                     'entry_price': round(entry_price, 2), 'exit_date': next_k['date'],
286:                     'exit_price': round(trade_price, 2), 'shares': position,
287:                     'profit': round(profit, 2), 'profit_pct': round(profit_pct, 2),
288:                     'hold_days': _calc_hold_days(entry_date, next_k['date']),
289:                     'signal_reason': sig.get('reasons', [''])[0] if sig.get('reasons') else '',
290:                 })
291:                 position = 0
292:                 entry_price = 0.0
293:         equity = capital + position * k['close']
294:         equity_curve.append({'date': cur_date, 'equity': round(equity, 2)})
295:     if position > 0 and equity_curve:
296:         last_k = klines[-1]
297:         profit = (last_k['close'] - entry_price) * position
298:         profit_pct = (last_k['close'] - entry_price) / entry_price * 100
299:         trades.append({
300:             'code': code, 'entry_date': entry_date,
301:             'entry_price': round(entry_price, 2),
302:             'exit_date': equity_curve[-1]['date'] + '(未平仓)',
303:             'exit_price': round(last_k['close'], 2), 'shares': position,
304:             'profit': round(profit, 2), 'profit_pct': round(profit_pct, 2),
305:             'hold_days': _calc_hold_days(entry_date, equity_curve[-1]['date']),
306:             'signal_reason': '回测结束时未平仓',
307:         })
308:     stats = _calc_stats(trades, equity_curve, initial_capital)
309:     return {'trades': trades, 'stats': stats, 'equity_curve': equity_curve}
