108: def _calc_bs_signals_for_klines(db, ts_code, end_date):
109:     """取最近 150 条 K 线（截止 end_date），调用 _generate_bs_signals，
110:     返回 {date_str: signal_dict} 字典。失败返回 {}。"""
111:     try:
112:         all_klines = (
113:             db.query(StockDailyKline)
114:             .filter(StockDailyKline.ts_code == ts_code)
115:             .filter(StockDailyKline.trade_date <= end_date)
116:             .order_by(StockDailyKline.trade_date.asc())
117:             .all()
118:         )
119:         if len(all_klines) < 20:
120:             return {}
121:         recent = all_klines[-150:] if len(all_klines) > 150 else all_klines
122:         klines = [
123:             {
124:                 "date": k.trade_date.isoformat() if k.trade_date else None,
125:                 "open": float(k.open) if k.open is not None else 0.0,
126:                 "high": float(k.high) if k.high is not None else 0.0,
127:                 "low": float(k.low) if k.low is not None else 0.0,
128:                 "close": float(k.close) if k.close is not None else 0.0,
129:                 "volume": int(k.volume) if k.volume is not None else 0,
130:             }
131:             for k in recent
132:         ]
133:         result = _generate_bs_signals(klines, period=10, multiplier=1.0)
134:         # _generate_bs_signals 实际返回元组 (signals, dif, dea, macd, ...)
135:         if isinstance(result, tuple) and len(result) > 0:
136:             signals = result[0]
137:         elif isinstance(result, list):
138:             signals = result
139:         else:
140:             signals = []
141:         bs_by_date = {}
142:         for sig in signals:
143:             if isinstance(sig, dict) and sig.get("date"):
144:                 bs_by_date[sig["date"]] = sig
145:         return bs_by_date
146:     except Exception as e:
147:         logger.warning(f"[strategy_track] BS signal calc failed for {ts_code}: {e}")
148:         return {}
149: # ============================================================
150: # GET /api/strategy-track/list
151: # ============================================================
152: @router.get("/api/strategy-track/list")
153: def list_trackers(
154:     status: str = Query("active", description="状态过滤: active / exited / expired / all"),
155:     pool_date: str = Query(None, description="入池日期 YYYY-MM-DD"),
156: ):
157:     """获取跟踪列表（默认 active），含每日明细和统计摘要"""
158:     with get_db_session() as db:
159:         q = db.query(StrategyTrack)
