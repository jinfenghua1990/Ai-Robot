<file path="backend/collectors/research_collector.py">
  1: """
  2: 盘后研究采集（填补本地"定性/新闻/因果"层空白）
  3: - 目标池 = 自选股 ∪ 当日强势股(涨幅>=阈值) ∪ 龙头生命周期活跃股
  4: - 对每只目标股调用妙想资讯搜索 + 金融数据查询（自动落库 stock_news_search / stock_data_query）
  5: - 生成 AI 综合分析并落库 ai_analysis_cache：
  6:     优先走配置的 LLM（AI_LLM_API_KEY），未配置则用妙想结构化内容作基线（model='mx-search-baseline'）
  7: 设计原则：完全复用现有 api.mx_skills 的存库逻辑，不重复造轮子；懒加载避免循环依赖。
  8: """
  9: import logging
 10: import json
 11: import asyncio
 12: from datetime import datetime
 13: from config import (
 14:     AI_LLM_API_KEY, AI_LLM_BASE_URL, AI_LLM_MODEL,
 15:     RESEARCH_LIMIT_UP_PCT, RESEARCH_ACTIVE_STAGES, RESEARCH_THROTTLE,
 16: )
 17: logger = logging.getLogger(__name__)
 18: def _to_6digit(ts_code: str) -> str:
 19:     """300017.SZ -> 300017 ; 300017 -> 300017"""
 20:     if not ts_code:
 21:         return ts_code
 22:     return ts_code.split('.')[0]
 23: def get_research_targets(today: str = None) -> list:
 24:     """返回去重后的目标池 [(code6, name, source_csv), ...]"""
 25:     from db.session import get_db_session
 26:     from db.models import Watchlist, StockFlow, LeaderLifecycle
 27:     today = today or datetime.now().strftime('%Y-%m-%d')
 28:     targets: dict = {}  # code6 -> {'name': str, 'sources': set}
 29:     with get_db_session() as db:
 30:         # 1) 自选股
 31:         for w in db.query(Watchlist).all():
 32:             code = _to_6digit(w.stock_code)
 33:             if not code:
 34:                 continue
 35:             t = targets.setdefault(code, {'name': w.stock_name or '', 'sources': set()})
 36:             t['sources'].add('watchlist')
 37:             if not t['name'] and w.stock_name:
 38:                 t['name'] = w.stock_name
 39:         # 2) 当日强势股（涨幅 >= 阈值，默认 9%）
 40:         for r in db.query(StockFlow).filter(
 41:             StockFlow.trade_date == today,
 42:             StockFlow.price_chg >= RESEARCH_LIMIT_UP_PCT,
 43:         ).all():
 44:             code = _to_6digit(r.ts_code)
 45:             if not code:
 46:                 continue
 47:             t = targets.setdefault(code, {'name': r.name or '', 'sources': set()})
 48:             t['sources'].add('strong_move')
 49:             if not t['name'] and r.name:
 50:                 t['name'] = r.name
 51:         # 3) 龙头生命周期活跃阶段
 52:         for r in db.query(LeaderLifecycle).filter(
 53:             LeaderLifecycle.trade_date == today,
 54:             LeaderLifecycle.stage.in_(RESEARCH_ACTIVE_STAGES),
 55:         ).all():
 56:             code = _to_6digit(r.ts_code)
 57:             if not code:
 58:                 continue
 59:             t = targets.setdefault(code, {'name': r.name or '', 'sources': set()})
 60:             t['sources'].add('leader_active')
 61:             if not t['name'] and r.name:
 62:                 t['name'] = r.name
 63:     return [(c, v['name'], ','.join(sorted(v['sources']))) for c, v in targets.items()]
 64: def _lookup_name(code6: str) -> str:
 65:     from db.session import get_db_session
 66:     from db.models import Watchlist, StockFlow, LeaderLifecycle
 67:     with get_db_session() as db:
 68:         w = db.query(Watchlist).filter(Watchlist.stock_code == code6).first()
 69:         if w and w.stock_name:
 70:             return w.stock_name
 71:         r = db.query(StockFlow).filter(
 72:             StockFlow.ts_code.like(code6 + '.%')).order_by(StockFlow.trade_date.desc()).first()
 73:         if r and r.name:
 74:             return r.name
 75:         l = db.query(LeaderLifecycle).filter(
 76:             LeaderLifecycle.ts_code.like(code6 + '.%')).order_by(LeaderLifecycle.trade_date.desc()).first()
 77:         if l and l.name:
 78:             return l.name
 79:     return ''
 80: # ==================== C6: 可插拔"网上数据源"注册表 ====================
 81: # 每个 source 是 async 函数 (code6, name) -> dict，返回 {"news": 文本, "data": 表或None, "tag": 来源标识}
 82: # 现有源均基于妙想；未来新增东财研报/雪球热度/交易所公告等，只需实现一个函数并追加到 RESEARCH_SOURCES。
 83: # 落库复用 api.mx_skills 的 save 逻辑（每次 mx 查询带 stock_code 即自动写入 stock_news_search / stock_data_query）。
 84: async def _src_mx_news_data(code6, name):
 85:     """妙想主源：资讯搜索 + 金融数据查询（原逻辑）"""
 86:     from api.mx_skills import mx_search_query, mx_data_query, NLQuery
 87:     news_content, data_tables = '', None
 88:     try:
 89:         news_resp = await mx_search_query(NLQuery(
 90:             query=f"{name} 最新公告 利好 利空 近期催化因素",
 91:             stock_code=code6, stock_name=name))
 92:         news_content = (news_resp or {}).get('content', '') or ''
 93:     except Exception as e:
 94:         logger.warning(f'[research] {code6} 资讯搜索失败: {e}')
 95:     try:
 96:         data_resp = await mx_data_query(NLQuery(
 97:             query=f"{name} 近一年营收 净利润 毛利率 主力资金流向",
 98:             stock_code=code6, stock_name=name))
 99:         data_tables = (data_resp or {}).get('tables')
100:     except Exception as e:
101:         logger.warning(f'[research] {code6} 数据查询失败: {e}')
102:     return {"news": news_content, "data": data_tables, "tag": "mx-main"}
103: async def _src_mx_research_report(code6, name):
104:     """妙想扩展源：机构研报 / 评级 / 目标价 / 盈利预测（演示新源接入，丰富研究层）"""
105:     from api.mx_skills import mx_search_query, NLQuery
106:     content = ''
107:     try:
108:         resp = await mx_search_query(NLQuery(
109:             query=f"{name} 最新研报 机构评级 目标价 盈利预测",
110:             stock_code=code6, stock_name=name))
111:         content = (resp or {}).get('content', '') or ''
112:     except Exception as e:
113:         logger.warning(f'[research] {code6} 研报搜索失败: {e}')
114:     return {"news": content, "data": None, "tag": "mx-report"}
115: # 数据源注册表（顺序执行；新增源只需实现函数并追加到此）
116: RESEARCH_SOURCES = [_src_mx_news_data, _src_mx_research_report]
117: async def collect_research_for_stock(code6: str, name: str):
118:     """对单只股票跑全部已注册网上数据源，聚合并自动落库；返回 (news_content, data_tables)"""
119:     news_parts = []
120:     data_tables = None
121:     for src in RESEARCH_SOURCES:
122:         try:
123:             res = await src(code6, name)
124:         except Exception as e:
125:             logger.warning(f'[research] {code6} 数据源 {getattr(src, "__name__", src)} 失败: {e}')
126:             continue
127:         if res.get("news"):
128:             news_parts.append(res["news"])
129:         if res.get("data") and data_tables is None:
130:             data_tables = res["data"]
131:         # 源间轻微节流，避免对妙想猛打
132:         if RESEARCH_THROTTLE > 0:
133:             await asyncio.sleep(min(RESEARCH_THROTTLE, 0.5))
134:     news_content = "\n\n".join(p for p in news_parts if p)
135:     return news_content, data_tables
136: def _build_baseline(code6, name, news_content, data_tables) -> dict:
137:     """无 LLM 时，用妙想结构化内容构造基线分析（仍填补 ai_analysis_cache 空白）"""
138:     sections = []
139:     if news_content:
140:         sections.append({"title": "资讯/事件", "content": news_content})
141:     if data_tables:
142:         try:
143:             tables = data_tables if isinstance(data_tables, list) else json.loads(data_tables)
144:             rows = []
145:             for tb in (tables or [])[:3]:
146:                 rows.append(str(tb)[:1000])
147:             if rows:
148:                 sections.append({"title": "关键财务/数据", "content": "\n".join(rows)})
149:         except Exception:
150:             logger.debug("research: financial data section skip", exc_info=False)
151:     if not sections:
152:         return None
153:     return {
154:         "summary": f"{name}({code6}) 盘后研究基线：基于妙想资讯+数据，未做 LLM 综合。",
155:         "sections": sections,
156:         "generated_by": "mx-search-baseline",
157:     }
158: def _extract_json(text):
159:     """从模型返回中稳健提取 JSON：兼容裸 JSON、```json 围栏、前后多余文本。"""
160:     if not isinstance(text, str):
161:         text = str(text)
162:     text = text.strip()
163:     if text.startswith("```"):
164:         lines = text.splitlines()
165:         if lines and lines[0].startswith("```"):
166:             lines = lines[1:]
167:         if lines and lines[-1].strip().startswith("```"):
168:             lines = lines[:-1]
169:         text = "\n".join(lines).strip()
170:     try:
171:         return json.loads(text)
