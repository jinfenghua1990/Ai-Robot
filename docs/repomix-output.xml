  1: """4.0 组合回测引擎
  2: 按 signal_4 分级分配资金：STRONG_BUY 60% / WATCH_BUY 30% / FORBID 跳过
  3: 复用 bs_backtest.engine._backtest_single 做单股回测
  4: """
  5: import asyncio
  6: import logging
  7: from datetime import datetime, date, timedelta
  8: from typing import List, Dict, Optional
  9: from api.bs_signals import _fetch_kline
 10: from api.bs_backtest.engine import _backtest_single, _calc_stats
 11: logger = logging.getLogger(__name__)
 12: # signal_4 → 资金权重（占比初始资金的百分比）
 13: SIGNAL_CAPITAL_WEIGHT = {
 14:     'STRONG_BUY': 0.60,   # 强买：分配 60% 初始资金
 15:     'WATCH_BUY': 0.30,    # 观察买：分配 30%
 16:     'FORBID': 0.0,        # 禁止：不回测
 17: }
 18: async def _backtest_one(code: str, capital: float, start_date: str, end_date: str,
 19:                        semaphore: asyncio.Semaphore) -> dict:
 20:     """单股回测（带并发控制）"""
 21:     if capital <= 0:
 22:         return {'code': code, 'trades': [], 'stats': {}, 'equity_curve': [], 'error': 'capital=0'}
 23:     async with semaphore:
 24:         try:
 25:             klines = await _fetch_kline(code, 300)
 26:             if not klines or len(klines) < 100:
 27:                 return {'code': code, 'trades': [], 'stats': {}, 'equity_curve': [],
 28:                         'error': f'kline too short: {len(klines) if klines else 0}'}
 29:             result = _backtest_single(
 30:                 klines,
 31:                 atr_period=10,
 32:                 atr_multiplier=1.0,
 33:                 initial_capital=capital,
 34:                 start_date=start_date,
 35:                 end_date=end_date,
 36:             )
 37:             result['code'] = code
 38:             result['allocated_capital'] = capital
 39:             return result
 40:         except Exception as e:
 41:             logger.error(f'[backtest_engine] {code} error: {e}')
 42:             return {'code': code, 'trades': [], 'stats': {}, 'equity_curve': [], 'error': str(e)}
 43: async def run_portfolio_backtest(
 44:     stock_signals: List[Dict],
 45:     initial_capital: float,
 46:     start_date: str,
 47:     end_date: str,
 48:     max_concurrency: int = 5,
 49: ) -> Dict:
 50:     """组合回测：按 signal_4 分配资金后并发回测
 51:     Args:
 52:         stock_signals: [{'ts_code': '600000.SH', 'signal_4': 'STRONG_BUY', 'name': '...'}, ...]
 53:         initial_capital: 总初始资金
 54:         start_date/end_date: 回测区间
 55:         max_concurrency: 最大并发数
 56:     Returns:
 57:         {
 58:             'summary': {...},          # 组合级统计
 59:             'per_stock': [{...}, ...],  # 每只股票统计
 60:             'trades': [...],            # 全部交易记录
 61:             'equity_curve': [...],      # 组合权益曲线
 62:             'allocation': [...],        # 资金分配明细
 63:         }
 64:     """
 65:     # 1. 按 signal_4 分配资金
 66:     allocation = []
 67:     total_weight = 0.0
 68:     for s in stock_signals:
 69:         sig = s.get('signal_4', 'FORBID')
 70:         weight = SIGNAL_CAPITAL_WEIGHT.get(sig, 0.0)
 71:         if weight > 0:
 72:             allocation.append({
 73:                 'ts_code': s['ts_code'],
 74:                 'name': s.get('name', ''),
 75:                 'signal_4': sig,
 76:                 'weight': weight,
 77:                 'capital': round(initial_capital * weight, 2),
 78:             })
 79:             total_weight += weight
 80:     # 归一化（总权重可能 > 1.0，按比例缩放）
 81:     if total_weight > 1.0:
 82:         for a in allocation:
 83:             a['capital'] = round(a['capital'] / total_weight, 2)
 84:             a['weight'] = round(a['weight'] / total_weight, 4)
 85:     if not allocation:
 86:         return {
 87:             'summary': _empty_summary(),
 88:             'per_stock': [],
 89:             'trades': [],
 90:             'equity_curve': [],
 91:             'allocation': [],
 92:             'message': '无 STRONG_BUY/WATCH_BUY 信号可回测',
 93:         }
 94:     # 2. 并发回测
 95:     semaphore = asyncio.Semaphore(max_concurrency)
 96:     tasks = [_backtest_one(a['ts_code'].split('.')[0], a['capital'], start_date, end_date, semaphore)
 97:              for a in allocation]
 98:     results = await asyncio.gather(*tasks, return_exceptions=True)
 99:     final_results = []
100:     for r in results:
101:         if isinstance(r, Exception):
102:             final_results.append({'code': 'unknown', 'trades': [], 'stats': {}, 'equity_curve': [],
103:                                   'error': f'{type(r).__name__}: {str(r)[:200]}'})
104:         else:
105:             final_results.append(r)
106:     # 3. 合并交易 + 权益曲线
107:     all_trades = []
108:     all_equity = {}
109:     valid_results = [r for r in final_results if not r.get('error')]
110:     for r in valid_results:
111:         all_trades.extend(r['trades'])
112:         for point in r['equity_curve']:
113:             d = point['date']
114:             all_equity[d] = all_equity.get(d, 0) + point['equity']
115:     merged_curve = [{'date': d, 'equity': round(v, 2)} for d, v in sorted(all_equity.items())]
116:     summary = _calc_stats(all_trades, merged_curve, initial_capital)
117:     # 4. 个股级统计
118:     per_stock = []
119:     for r, a in zip(final_results, allocation):
120:         ts = r.get('trades', [])
121:         net_profit = sum(t.get('profit', 0) for t in ts) if ts else 0
122:         per_stock.append({
123:             'code': a['ts_code'],
124:             'name': a['name'],
125:             'signal_4': a['signal_4'],
126:             'allocated_capital': a['capital'],
127:             'trades': len(ts),
128:             'net_profit': round(net_profit, 2),
129:             'profitable': net_profit > 0,
130:             'stats': r.get('stats', {}),
131:             'error': r.get('error'),
132:         })
133:     # 5. 个股胜率
134:     stock_with_trades = [s for s in per_stock if s['trades'] > 0]
135:     stock_profitable = [s for s in stock_with_trades if s['net_profit'] > 0]
136:     summary['stock_win_rate'] = round(
137:         len(stock_profitable) / len(stock_with_trades) * 100, 1
138:     ) if stock_with_trades else 0
139:     summary['stock_profitable_count'] = len(stock_profitable)
140:     summary['stock_with_trades_count'] = len(stock_with_trades)
141:     return {
142:         'summary': summary,
143:         'per_stock': per_stock,
144:         'trades': all_trades,
145:         'equity_curve': merged_curve,
146:         'allocation': allocation,
147:     }
148: def _empty_summary() -> dict:
149:     return {
150:         'total_trades': 0, 'win_trades': 0, 'loss_trades': 0,
151:         'win_rate': 0, 'total_profit': 0, 'total_profit_pct': 0,
152:         'avg_profit_pct': 0, 'max_profit_pct': 0, 'max_loss_pct': 0,
153:         'avg_hold_days': 0, 'profit_factor': 0,
154:         'max_drawdown': 0, 'max_drawdown_pct': 0, 'annual_return': 0,
155:         'stock_win_rate': 0, 'stock_profitable_count': 0, 'stock_with_trades_count': 0,
156:     }
157: def run_backtest_from_signals(target_date: Optional[date] = None,
158:                               initial_capital: float = 100000.0,
159:                               days: int = 30) -> Dict:
160:     """从 TradingSignalDaily 取信号跑组合回测（同步入口）
161:     Args:
162:         target_date: 信号日期，默认今天
163:         initial_capital: 初始资金
164:         days: 回测区间天数
165:     Returns:
166:         组合回测结果
167:     """
168:     from db.session import get_db_session
169:     from db.models import TradingSignalDaily
170:     if target_date is None:
171:         target_date = date.today()
172:     elif isinstance(target_date, str):
173:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
174:     end_date = target_date.strftime('%Y-%m-%d')
175:     start_date = (target_date - timedelta(days=days)).strftime('%Y-%m-%d')
176:     with get_db_session() as db:
177:         rows = db.query(TradingSignalDaily).filter(
178:             TradingSignalDaily.trade_date == target_date,
179:             TradingSignalDaily.signal_4.in_(['STRONG_BUY', 'WATCH_BUY']),
180:         ).all()
181:         stock_signals = [{'ts_code': r.ts_code, 'name': r.name, 'signal_4': r.signal_4} for r in rows]
182:     if not stock_signals:
183:         return {
184:             'summary': _empty_summary(),
185:             'per_stock': [],
186:             'trades': [],
187:             'equity_curve': [],
188:             'allocation': [],
189:             'message': f'{end_date} 无 STRONG_BUY/WATCH_BUY 信号',
190:         }
191:     return asyncio.run(run_portfolio_backtest(
192:         stock_signals, initial_capital, start_date, end_date,
193:     ))
</file>

<file path="backend/services/trading_system/position_engine.py">
 1: """动态仓位引擎
 2: 公式：仓位 = ATR仓位 × 信号强度系数 × 情绪系数 × 板块热度系数
 3: ATR 风险预算法：单股风险 ≤ 总资金 × 2%（2% 法则）
 4: """
 5: import logging
 6: from typing import Dict
 7: logger = logging.getLogger(__name__)
 8: DEFAULT_TOTAL_CAPITAL = 1_000_000
 9: SINGLE_RISK_PCT = 2.0
10: MAX_TOTAL_POSITION_PCT = 50.0
11: MIN_POSITION_PCT = 1.0
12: MAX_POSITION_PCT = 10.0
13: SENTIMENT_COEF = {
14:     '恐慌': 0.3, '谨慎': 0.5, '中性': 0.7, '乐观': 0.9, '狂热': 0.6,
15: }
16: def calc_dynamic_position(
17:     signal: dict,
18:     signal_4: str,
19:     final_score: float,
20:     total_capital: float = DEFAULT_TOTAL_CAPITAL,
21:     single_risk_pct: float = SINGLE_RISK_PCT,
22: ) -> Dict:
23:     """动态仓位计算
24:     1. 信号强度系数：强买 1.0 / 观察买 0.6 / 禁止 0
25:     2. 情绪系数：恐慌0.3/谨慎0.5/中性0.7/乐观0.9/狂热0.6（退潮降仓）
26:     3. 板块热度系数：latest_heat / 100，钳制 [0.3, 1.0]
27:     4. ATR 风险预算法：仓位金额 = (总资金 × 2%) / (ATR% × 1.5乘数)
28:     5. 最终仓位 = ATR仓位 × 三系数，受单票上下限约束
29:     6. 止损 = ATR × 1.5 / 价格，钳制 [3%, 10%]
30:     7. 止盈 = 2 × 止损（1:2 盈亏比）
31:     """
32:     if signal_4 == 'FORBID':
33:         return {
34:             'position_pct': 0, 'position_amount': 0,
35:             'stop_loss_pct': 0, 'take_profit_pct': 0,
36:             'atr_14': 0, 'risk_per_share': 0,
37:             'coefficients': {}, 'reason': '禁止参与，0仓位',
38:         }
39:     price = (signal.get('quote') or {}).get('price', 0)
40:     if price <= 0:
41:         return {
42:             'position_pct': 0, 'position_amount': 0,
43:             'stop_loss_pct': 0, 'take_profit_pct': 0,
44:             'atr_14': 0, 'risk_per_share': 0,
45:             'coefficients': {}, 'reason': '无实时价格',
46:         }
47:     # 1. 信号强度系数
48:     strength_coef = 1.0 if signal_4 == 'STRONG_BUY' else 0.6
49:     # 2. 情绪系数
50:     sentiment_stage = (signal.get('sentiment') or {}).get('stage', '中性')
51:     sentiment_coef = SENTIMENT_COEF.get(sentiment_stage, 0.7)
52:     # 3. 板块热度系数
53:     sector_trend = signal.get('sectorTrend') or {}
54:     heat = sector_trend.get('latest_heat', 50) if sector_trend.get('available') else 50
55:     sector_coef = max(0.3, min(1.0, heat / 100))
56:     # 4. ATR 风险预算法
57:     features = (signal.get('marketState') or {}).get('features') or {}
58:     atr_14 = features.get('atr_14', 0) or 0
59:     atr_pct = (atr_14 / price) if price > 0 else 0.03
60:     atr_multiplier = 1.5
61:     risk_amount = total_capital * single_risk_pct / 100
62:     stop_loss_ratio = atr_pct * atr_multiplier
63:     stop_loss_ratio = max(0.03, min(0.10, stop_loss_ratio))
64:     atr_position_amount = risk_amount / stop_loss_ratio if stop_loss_ratio > 0 else 0
65:     # 5. 最终仓位 = ATR仓位 × 三系数
66:     position_amount = atr_position_amount * strength_coef * sentiment_coef * sector_coef
67:     position_pct = (position_amount / total_capital * 100) if total_capital > 0 else 0
68:     # 钳制到上下限
69:     min_pct = MIN_POSITION_PCT if signal_4 == 'STRONG_BUY' else 0
70:     position_pct = max(min_pct, min(MAX_POSITION_PCT, position_pct))
71:     position_amount = total_capital * position_pct / 100
72:     # 6. 止损止盈
73:     stop_loss_pct = -stop_loss_ratio * 100
74:     take_profit_pct = stop_loss_ratio * 2 * 100
75:     return {
76:         'position_pct': round(position_pct, 2),
77:         'position_amount': round(position_amount, 2),
78:         'stop_loss_pct': round(stop_loss_pct, 2),
79:         'take_profit_pct': round(take_profit_pct, 2),
80:         'atr_14': round(atr_14, 3),
81:         'risk_per_share': round(risk_amount, 2),
82:         'coefficients': {
83:             'strength': strength_coef,
84:             'sentiment': sentiment_coef,
85:             'sector': round(sector_coef, 2),
86:         },
87:     }
</file>

<file path="backend/services/trading_system/risk_engine.py">
 1: """组合风控引擎
 2: - 单票风险 ≤ 2%（position_engine 已保证）
 3: - 总仓位 ≤ 30-50%（情绪退潮降仓）
 4: - 高位股禁止重仓：连板≥4 或 偏离MA20>15% → 仓位上限 3%
 5: """
 6: import logging
 7: from typing import Dict, List, Tuple
 8: logger = logging.getLogger(__name__)
 9: # 情绪 → 总仓位上限映射
10: SENTIMENT_TOTAL_CAP = {
11:     '恐慌': 30.0, '谨慎': 30.0,
12:     '中性': 40.0,
13:     '乐观': 50.0,
14:     '狂热': 30.0,
15: }
16: HIGH_POSITION_MAX_PCT = 3.0
17: def is_high_position_stock(signal: dict) -> Tuple[bool, str]:
18:     """判断是否高位股
19:     - 连板 ≥ 4（lifecycle stage == '主升' 且 consecutive_days ≥ 4）
20:     - 偏离 MA20 > 15%（close_vs_ma20 > 0.15）
21:     """
22:     lifecycle = signal.get('lifecycleStage', '')
23:     consecutive = (signal.get('position') or {}).get('count', 0) or 0
24:     features = (signal.get('marketState') or {}).get('features') or {}
25:     close_vs_ma20 = features.get('close_vs_ma20', 0) or 0
26:     if lifecycle == '主升' and consecutive >= 4:
27:         return True, f'{consecutive}连板高位'
28:     if close_vs_ma20 > 0.15:
29:         return True, f'偏离MA20 {close_vs_ma20*100:.1f}%高位'
30:     return False, ''
31: def assess_portfolio_risk(
32:     signals_4: List[dict],
33:     market_sentiment: str = '中性',
34: ) -> Dict:
35:     """组合风控评估
36:     输入：当日所有候选股票的 4.0 信号列表（每项含 signal_raw, signal_4, final_score, position_pct）
37:     输出：风控状态 + 总仓位建议 + 各股风控调整
38:     """
39:     total_cap = SENTIMENT_TOTAL_CAP.get(market_sentiment, 40.0)
40:     buyable = [s for s in signals_4 if s.get('signal_4') in ('STRONG_BUY', 'WATCH_BUY')]
41:     buyable.sort(key=lambda x: (
42:         -1 if x['signal_4'] == 'STRONG_BUY' else 0,
43:         -x.get('final_score', 0),
44:     ))
45:     total_position_pct = 0.0
46:     adjusted = []
47:     warnings = []
48:     for sig in buyable:
49:         original_pct = sig.get('position_pct', 0)
50:         raw = sig.get('signal_raw') or {}
51:         is_high, reason = is_high_position_stock(raw)
52:         if is_high:
53:             original_pct = min(original_pct, HIGH_POSITION_MAX_PCT)
54:             warnings.append(f'{sig.get("name", sig.get("ts_code", ""))} 高位股({reason})，仓位降至{original_pct}%')
55:             sig['risk_status'] = 'warn'
56:             sig['risk_reasons'] = [reason]
57:         else:
58:             sig['risk_status'] = 'ok'
59:             sig['risk_reasons'] = []
60:         remaining = total_cap - total_position_pct
61:         if remaining <= 0:
62:             warnings.append(f'总仓位已达{total_cap}%上限，{sig.get("name", sig.get("ts_code", ""))}不再分配')
63:             sig['position_pct'] = 0
64:             sig['position_amount'] = 0
65:             sig['risk_status'] = 'forbid'
66:             sig['risk_reasons'] = ['总仓位已满']
67:             adjusted.append(sig)
68:             continue
69:         final_pct = min(original_pct, remaining)
70:         total_position_pct += final_pct
71:         sig['position_pct'] = round(final_pct, 2)
72:         sig['position_amount'] = round(final_pct * 10000, 2)
73:         adjusted.append(sig)
74:     return {
75:         'total_position_pct': round(total_position_pct, 2),
76:         'total_cap_pct': total_cap,
77:         'sentiment': market_sentiment,
78:         'buyable_count': len(buyable),
79:         'warnings': warnings,
80:         'adjusted_signals': adjusted,
81:     }
</file>

<file path="backend/services/trading_system/signal_engine.py">
 1: """4.0 信号分级引擎
 2: 基于 6 维评分（sentiment/momentum/mainForce/technical/sectorResonance/risk）
 3: + BS 信号 + 市场状态 + 生命周期 → 强买/观察买/禁止参与
 4: """
 5: import logging
 6: from typing import Tuple, Dict
 7: logger = logging.getLogger(__name__)
 8: # 信号分级阈值
 9: STRONG_BUY_THRESHOLD = 70
10: WATCH_BUY_THRESHOLD = 50
11: # 6 维权重（sum=1.0）
12: WEIGHTS = {
13:     'sentiment': 0.20,
14:     'momentum': 0.20,
15:     'mainForce': 0.25,
16:     'technical': 0.15,
17:     'sector': 0.10,
18:     'risk': 0.10,  # 反向指标
19: }
20: def calc_final_score(signal: dict) -> Tuple[float, Dict[str, float]]:
21:     """6 维加权计算 final_score（0-100）
22:     复用 signal 中已计算的 sentiment/momentum/mainForce/technical/sectorResonance/risk
23:     risk 是反向指标（高分=危险），转换为正向：100 - risk.score
24:     返回 (final_score, score_detail)
25:     """
26:     s = (signal.get('sentiment') or {}).get('score', 50)
27:     m = (signal.get('momentum') or {}).get('score', 50)
28:     mf = (signal.get('mainForce') or {}).get('score', 50)
29:     t = (signal.get('technical') or {}).get('score', 50)
30:     sr = (signal.get('sectorResonance') or {}).get('score', 50)
31:     r = (signal.get('risk') or {}).get('score', 50)
32:     risk_positive = 100 - r
33:     final = (
34:         s * WEIGHTS['sentiment'] +
35:         m * WEIGHTS['momentum'] +
36:         mf * WEIGHTS['mainForce'] +
37:         t * WEIGHTS['technical'] +
38:         sr * WEIGHTS['sector'] +
39:         risk_positive * WEIGHTS['risk']
40:     )
41:     detail = {
42:         'sentiment': round(s, 1),
43:         'momentum': round(m, 1),
44:         'mainForce': round(mf, 1),
45:         'technical': round(t, 1),
46:         'sector': round(sr, 1),
47:         'risk': round(r, 1),
48:     }
49:     return round(final, 2), detail
50: def classify_signal_4(signal: dict, final_score: float) -> dict:
51:     """4.0 信号分级：强买 / 观察买 / 禁止参与
52:     一票否决条件（即使 final_score 高也降级为禁止参与）：
53:     - bs_signal == 'S' → 禁止参与
54:     - market_state == 'CHOPPY' 且 quality_status in ['劣质','中性'] → 禁止参与
55:     - 生命周期 stage in ['分歧','衰退','退潮'] → 禁止参与
56:     高危降级：
57:     - risk.stage in ['高危','极危'] → 降级为观察买
58:     """
59:     bs_signal = signal.get('bsSignal')
60:     market_state = (signal.get('marketState') or {}).get('market_state', '')
61:     quality = signal.get('qualityStatus', '')
62:     risk_stage = (signal.get('risk') or {}).get('stage', '')
63:     lifecycle = signal.get('lifecycleStage', '')
64:     forbid_reasons = []
65:     if bs_signal == 'S':
66:         forbid_reasons.append('BS卖出信号')
67:     if market_state == 'CHOPPY' and quality in ('劣质', '中性'):
68:         forbid_reasons.append(f'{market_state}+{quality}杂毛不参与')
69:     if lifecycle in ('分歧', '衰退', '退潮'):
70:         forbid_reasons.append(f'生命周期{lifecycle}谨慎参与')
71:     if forbid_reasons:
72:         return {
73:             'signal_4': 'FORBID', 'label': '禁止参与', 'color': '#6b7280',
74:             'reasons': forbid_reasons,
75:         }
76:     if risk_stage in ('高危', '极危'):
77:         return {
78:             'signal_4': 'WATCH_BUY', 'label': '观察买', 'color': '#eab308',
79:             'reasons': [f'风险等级{risk_stage}降级观察'],
80:         }
81:     if final_score >= STRONG_BUY_THRESHOLD:
82:         return {
83:             'signal_4': 'STRONG_BUY', 'label': '强买', 'color': '#ef4444',
84:             'reasons': [f'综合评分{final_score:.0f}≥{STRONG_BUY_THRESHOLD}'],
85:         }
86:     elif final_score >= WATCH_BUY_THRESHOLD:
87:         return {
88:             'signal_4': 'WATCH_BUY', 'label': '观察买', 'color': '#eab308',
89:             'reasons': [f'综合评分{final_score:.0f}∈[{WATCH_BUY_THRESHOLD},{STRONG_BUY_THRESHOLD})'],
90:         }
91:     else:
92:         return {
93:             'signal_4': 'FORBID', 'label': '禁止参与', 'color': '#6b7280',
94:             'reasons': [f'综合评分{final_score:.0f}<{WATCH_BUY_THRESHOLD}'],
95:         }
