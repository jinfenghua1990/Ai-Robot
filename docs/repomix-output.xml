288:     DATA_SOURCES[name] = config
289:     logger.info(f'[registry] Registered data source: {name} ({config.get("display_name", "")})')
290: def get_source_info():
291:     """获取数据源统计信息（供前端展示）"""
292:     all_sources = list(DATA_SOURCES.values())
293:     available = [s for s in all_sources if s['available']]
294:     unlimited = [s for s in available if not s['rate_limited']]
295:     rate_limited = [s for s in available if s['rate_limited']]
296:     pending = [s for s in all_sources if not s['available']]
297:     # 按指标统计
298:     indicator_coverage = {}
299:     for s in available:
300:         for ind in s['indicators']:
301:             if ind not in indicator_coverage:
302:                 indicator_coverage[ind] = []
303:             indicator_coverage[ind].append(s['display_name'])
304:     return {
305:         'total': len(all_sources),
306:         'available_count': len(available),
307:         'unlimited_count': len(unlimited),
308:         'rate_limited_count': len(rate_limited),
309:         'pending_count': len(pending),
310:         'indicator_coverage': indicator_coverage,
311:         'sources': DATA_SOURCES,
312:     }
313: if __name__ == '__main__':
314:     info = get_source_info()
315:     print(f"数据源总数: {info['total']}")
316:     print(f"已启用: {info['available_count']} (无限制: {info['unlimited_count']}, 有额度: {info['rate_limited_count']})")
317:     print(f"待集成: {info['pending_count']}")
318:     print("\n=== 按指标覆盖 ===")
319:     for ind, sources in info['indicator_coverage'].items():
320:         print(f"  {ind}: {', '.join(sources)}")
321:     print("\n=== 支持主力净流入的无限制数据源 ===")
