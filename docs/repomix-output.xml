451:         logger.info('[sync_concept_sectors] fetched %d concept boards from akshare', len(df_list))
452:     except Exception as e:
453:         logger.warning(f'[sync_concept_sectors] akshare stock_board_concept_name_em error: {e}', exc_info=True)
454:         return {}
455:     names = []
456:     for _, row in df_list.iterrows():
457:         name = row.get('板块名称', '').strip()
458:         if name:
459:             names.append(name)
460:     def _fetch_one(name):
461:         try:
462:             df_cons = ak.stock_board_concept_cons_em(symbol=name)
463:             codes = []
464:             for _, r in df_cons.iterrows():
465:                 code = r.get('代码') or r.get('股票代码')
466:                 if code:
467:                     codes.append(_normalize_ts_code(code))
468:             return name, codes
469:         except Exception as e:
470:             logger.debug('[sync_concept_sectors] akshare cons fetch failed for %s: %s', name, e)
471:             return name, []
472:     for name, codes in _run_threaded(_fetch_one, names, max_workers=4, ordered=True):
473:         if codes:
474:             concepts[name] = codes
475:     logger.info('[sync_concept_sectors] akshare concepts with constituents: %d', len(concepts))
476:     return concepts
