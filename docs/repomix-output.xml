 1: /**
 2:  * 统一 API 请求封装
 3:  *
 4:  * 替换散落在各 Page 的 fetch(...).then(r=>r.json()).catch(()=>null) 模板。
 5:  * 返回 { ok, data, error, status } 结构，调用方按 ok 分支处理即可。
 6:  *
 7:  * 用法：
 8:  *   const { ok, data, error } = await apiFetch('/api/watchlist');
 9:  *   if (!ok) { 处理错误; return; }
10:  *   使用 data;
11:  *
12:  *   // POST 请求
13:  *   const { ok } = await apiFetch('/api/watchlist/add', {
14:  *     method: 'POST',
15:  *     headers: { 'Content-Type': 'application/json' },
16:  *     body: JSON.stringify({ stockCode: '000001' }),
17:  *   });
18:  *
19:  *   // 外部传入 AbortSignal 取消请求
20:  *   const ctrl = new AbortController();
21:  *   apiFetch('/api/foo', { signal: ctrl.signal });
22:  *   ctrl.abort();  // 立即取消，不会等重试 backoff
23:  */
24: export async function apiFetch(url, options = {}, timeout = 8000, retries = 2) {
25:   // 仅对 GET（幂等读）做重试，避免 POST/PUT/DELETE 等写操作因重试导致重复提交
26:   const method = (options.method || 'GET').toUpperCase();
27:   const maxAttempts = method === 'GET' ? retries + 1 : 1;
28:   // 外部 signal（可选）：来自调用方 AbortController，用于取消请求
29:   const externalSignal = options.signal;
30:   let lastError = null;
31:   for (let attempt = 0; attempt < maxAttempts; attempt++) {
32:     // 外部已取消则立刻退出，不等 backoff
33:     if (externalSignal?.aborted) {
34:       return { ok: false, data: null, error: '请求已取消', status: 0 };
35:     }
36:     const ctrl = new AbortController();
37:     const timer = setTimeout(() => ctrl.abort(), timeout);
38:     // 联动外部 signal：外部 abort 时立即 abort 内部 ctrl（无需等 timeout）
39:     const onExternalAbort = () => ctrl.abort();
40:     if (externalSignal) externalSignal.addEventListener('abort', onExternalAbort, { once: true });
41:     try {
42:       // 注意：fetch 的 signal 用内部 ctrl.signal，而非外部 signal
43:       // （外部 signal 通过上面的 listener 联动到 ctrl，避免重试时复用已 aborted 的 signal）
44:       const resp = await fetch(url, { ...options, signal: ctrl.signal });
45:       if (resp.ok) {
46:         const data = await resp.json();
47:         return { ok: true, data, error: null, status: resp.status };
48:       }
49:       // 429 限流：按 Retry-After 等待后重试（仅 GET）
50:       if (resp.status === 429 && attempt < maxAttempts - 1) {
51:         const retryAfter = Number(resp.headers.get('Retry-After')) || 2;
52:         lastError = 'HTTP 429 限流';
53:         await new Promise((r) => {
54:           const t = setTimeout(r, Math.min(retryAfter, 5) * 1000);
55:           if (externalSignal) {
56:             externalSignal.addEventListener('abort', () => { clearTimeout(t); r(); }, { once: true });
57:           }
58:         });
59:         continue;
60:       }
61:       // 4xx（非 429）：客户端错误，不重试；解析响应体提取服务端错误信息
62:       if (resp.status < 500) {
63:         let body = null;
64:         try { body = await resp.json(); } catch { /* 非 JSON 响应体 */ }
65:         const errMsg = body?.error || body?.message || `HTTP ${resp.status}`;
66:         return { ok: false, data: null, error: errMsg, status: resp.status };
67:       }
68:       // 5xx：服务端错误，走重试
69:       lastError = `HTTP ${resp.status}`;
70:     } catch (err) {
71:       // 外部取消：立即返回，不重试
72:       if (externalSignal?.aborted) {
73:         return { ok: false, data: null, error: '请求已取消', status: 0 };
74:       }
75:       // 网络错误 / 超时（AbortError）：瞬态故障，走重试
76:       lastError = err.name === 'AbortError' ? '请求超时' : err.message;
77:     } finally {
78:       clearTimeout(timer);
79:       if (externalSignal) externalSignal.removeEventListener('abort', onExternalAbort);
80:     }
81:     // 指数退避 + 抖动；最后一次失败前不等待
82:     if (attempt < maxAttempts - 1) {
83:       const backoff = Math.min(1000 * 2 ** attempt, 4000) + Math.random() * 300;
84:       await new Promise((r) => {
85:         const t = setTimeout(r, backoff);
86:         if (externalSignal) {
87:           externalSignal.addEventListener('abort', () => { clearTimeout(t); r(); }, { once: true });
88:         }
89:       });
90:       if (externalSignal?.aborted) {
91:         return { ok: false, data: null, error: '请求已取消', status: 0 };
92:       }
93:     }
94:   }
95:   return { ok: false, data: null, error: lastError || '请求失败', status: 0 };
96: }
