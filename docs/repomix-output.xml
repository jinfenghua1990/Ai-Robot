187:             .filter(StrategyTrack.status == "expired")
188:             .scalar()
189:             or 0
190:         )
191:         # avg/win/max/min 基于 active（当前 rows 中 status==active 的）
192:         active_pcts = [
193:             r["latest_pct"]
194:             for r in rows
195:             if r["status"] == "active" and r["latest_pct"] is not None
196:         ]
197:         if active_pcts:
198:             avg_return = round(sum(active_pcts) / len(active_pcts), 2)
199:             win_rate = round(sum(1 for p in active_pcts if p > 0) / len(active_pcts), 4)
200:             max_return = round(max(active_pcts), 2)
201:             min_return = round(min(active_pcts), 2)
202:         else:
203:             avg_return = 0.0
204:             win_rate = 0.0
205:             max_return = 0.0
206:             min_return = 0.0
