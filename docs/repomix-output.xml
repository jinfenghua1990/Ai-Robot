172:             elif r.indicator == 'price':
173:                 hist.price = r.final_value
174:             elif r.indicator == 'price_chg':
175:                 hist.price_chg = r.final_value
176:     print(f'[reverify] 完成: 自动通过{auto_passed}条，强制取中位数{forced_pass}条')
177: def archive_today_snapshot_to_history(trade_date):
