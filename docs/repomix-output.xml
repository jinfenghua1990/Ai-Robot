  1: """
  2: 投资组合风格分析器
  3: 综合资金流向、板块轮动、龙头生命周期数据，生成投资风格转换建议
  4: """
  5: import sys, os
  6: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
  7: import logging
  8: from datetime import datetime
  9: from db.session import get_db_session
 10: from db.models import StockFlow, SectorFlow, LeaderLifecycle
 11: from analyzers.rotation import calculate_rotation
 12: from analyzers.money_flow import calculate_money_flow_path
 13: logger = logging.getLogger(__name__)
 14: def analyze_portfolio_style(trade_date, lookback_days=5):
 15:     """
 16:     分析当前市场风格并生成投资组合转换建议
 17:     返回: {
 18:         market_style: 当前市场风格特征,
 19:         inflow_sectors: 资金流入板块,
 20:         outflow_sectors: 资金流出板块,
 21:         top_stocks: 主力净流入个股,
 22:         leaders: 龙头股分布,
 23:         recommendations: 风格转换建议,
 24:         allocation: 推荐配置比例,
 25:         risk_control: 风控建议,
 26:     }
 27:     """
 28:     try:
 29:         with get_db_session() as db:
 30:             # 1. 获取板块轮动数据
 31:             rotation = calculate_rotation(trade_date, lookback_days)
 32:             in_totals, out_totals = {}, {}
 33:             for l in rotation.get('links', []):
 34:                 out_totals[l['source']] = out_totals.get(l['source'], 0) + l['value']
 35:                 in_totals[l['target']] = in_totals.get(l['target'], 0) + l['value']
 36:             inflow_sorted = sorted(in_totals.items(), key=lambda x: -x[1])[:5]
 37:             outflow_sorted = sorted(out_totals.items(), key=lambda x: -x[1])[:10]
 38:             total_inflow = sum(in_totals.values())
 39:             total_outflow = sum(out_totals.values())
 40:             # 2. 获取个股资金流数据
 41:             money_flow = calculate_money_flow_path(trade_date)
 42:             top10 = money_flow.get('top10', [])
 43:             # 个股板块分布
 44:             stock_sectors = {}
 45:             for s in top10:
 46:                 sec = s.get('sector', '未知')
 47:                 if sec not in stock_sectors:
 48:                     stock_sectors[sec] = {'count': 0, 'total': 0.0, 'avg_chg': [], 'stocks': []}
 49:                 stock_sectors[sec]['count'] += 1
 50:                 stock_sectors[sec]['total'] += s['main_force_inflow']
 51:                 stock_sectors[sec]['avg_chg'].append(s['price_chg'])
 52:                 stock_sectors[sec]['stocks'].append({
 53:                     'name': s['name'],
 54:                     'ts_code': s['ts_code'],
 55:                     'main_force_inflow': round(s['main_force_inflow'], 1),
 56:                     'price_chg': round(s['price_chg'], 2),
 57:                 })
 58:             for sec in stock_sectors:
 59:                 chgs = stock_sectors[sec]['avg_chg']
 60:                 stock_sectors[sec]['avg_chg'] = round(sum(chgs) / len(chgs), 2) if chgs else 0
 61:             # 3. 获取龙头股分布
 62:             leaders = db.query(LeaderLifecycle).filter_by(trade_date=trade_date).all()
 63:             leader_by_sector = {}
 64:             stage_counts = {}
 65:             for l in leaders:
 66:                 sec = l.sector or '未知'
 67:                 if sec not in leader_by_sector:
 68:                     leader_by_sector[sec] = []
 69:                 leader_by_sector[sec].append({
 70:                     'name': l.name or l.ts_code,
 71:                     'ts_code': l.ts_code,
 72:                     'stage': l.stage,
 73:                     'consecutive_days': l.consecutive_days or 1,
 74:                 })
 75:                 stage = l.stage or '未知'
 76:                 stage_counts[stage] = stage_counts.get(stage, 0) + 1
 77:             # 龙头股最多的板块 Top10
 78:             leader_top_sectors = sorted(leader_by_sector.items(), key=lambda x: -len(x[1]))[:10]
 79:             # 4. 判断市场风格
 80:             inflow_names = [s[0] for s in inflow_sorted]
 81:             outflow_names = [s[0] for s in outflow_sorted]
 82:             # 风格分类
 83:             tech_sectors = {'半导体', '通信设备', '元器件', '计算机', '软件', '电子'}
 84:             finance_sectors = {'银行', '证券', '保险', '多元金融'}
 85:             energy_sectors = {'火力发电', '水力发电', '石油', '煤炭', '电力'}
 86:             manufacturing_sectors = {'机械基件', '专用机械', '工程机械', '汽车配件', '运输设备'}
 87:             cyclical_sectors = {'化工原料', '小金属', '铝', '铜', '钢铁', '建筑工程', '电气设备'}
 88:             defensive_sectors = {'医药', '中成药', '医疗保健', '食品饮料', '旅游服务', '环境保护'}
 89:             inflow_tech = sum(v for s, v in inflow_sorted if s in tech_sectors)
 90:             inflow_finance = sum(v for s, v in inflow_sorted if s in finance_sectors)
 91:             inflow_manufacturing = sum(v for s, v in inflow_sorted if s in manufacturing_sectors)
 92:             inflow_cyclical = sum(v for s, v in inflow_sorted if s in cyclical_sectors)
 93:             inflow_defensive = sum(v for s, v in inflow_sorted if s in defensive_sectors)
 94:             outflow_finance = sum(v for s, v in outflow_sorted if s in finance_sectors)
 95:             outflow_energy = sum(v for s, v in outflow_sorted if s in energy_sectors)
 96:             # 风格判断
 97:             style_scores = {
 98:                 '成长': inflow_tech,
