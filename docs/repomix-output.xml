326: async def _fetch_sector_today_intraday(sector: str):
327:     """
328:     合成板块当天实时热度折线：
329:     1. 从 stock_flow 取该板块最近交易日的成分股
330:     2. 用 hq.sinajs.cn 批量拉取实时行情
331:     3. 计算成分股相对昨日收盘的平均涨跌幅
332:     4. 每30秒采样一个点，保留当天数据形成折线
333:     """
334:     if not sector:
335:         return []
336:     # 查找板块成分股（最近交易日）
337:     try:
338:         with get_db_session() as db:
339:             latest_date = db.query(StockFlow.trade_date).filter(
340:                 StockFlow.sector == sector
341:             ).order_by(StockFlow.trade_date.desc()).first()
342:             if not latest_date:
343:                 return []
344:             rows = db.query(StockFlow.ts_code).filter(
345:                 StockFlow.sector == sector,
346:                 StockFlow.trade_date == latest_date[0]
347:             ).distinct().limit(50).all()
348:             codes = [_ts_code_to_6digit(r[0]) for r in rows if r[0]]
349:     except Exception as e:
350:         logger.debug(f'[bs_signals] 板块成分股查询失败 {sector}: {e}')
351:         return []
352:     sina_codes = [c for c in (stock_code_to_sina(c) for c in codes) if c]
353:     if not sina_codes:
354:         return []
355:     # 批量拉取行情（hq.sinajs.cn 支持多个 code，用逗号分隔）
356:     avg_chg = None
357:     try:
358:         quotes_url = f"https://hq.sinajs.cn/list={','.join(sina_codes)}"
359:         client = _get_http_client()
360:         resp = await client.get(quotes_url, headers=SINA_HEADERS_SHORT)
361:         resp.encoding = 'gbk'
362:         text = resp.text
363:         chgs = []
364:         for line in text.split(';'):
365:             if '"' not in line:
366:                 continue
367:             parts = line.split('"')
368:             if len(parts) < 2:
369:                 continue
370:             vals = parts[1].split(',')
371:             if len(vals) < 5:
372:                 continue
373:             try:
374:                 price = float(vals[3])
375:                 yclose = float(vals[2])
376:                 if yclose:
377:                     chgs.append((price - yclose) / yclose * 100)
378:             except Exception:
379:                 logger.debug(f"function item failed", exc_info=True)
380:                 continue
381:             avg_chg = round(sum(chgs) / len(chgs), 3)
382:     except Exception:
383:         logger.warning(f"function failed", exc_info=True)
384:     if avg_chg is None:
385:         return []
386:     now_ts = int(datetime.now().timestamp())
387:     # 初始化或清理跨天数据
388:     cache = _sector_today_cache.get(sector, [])
389:     today_start = int(datetime.now().replace(hour=0, minute=0, second=0, microsecond=0).timestamp())
390:     cache = [(t, v) for t, v in cache if t >= today_start]
391:     # 去重：同一分钟内只保留最新
392:     last_min = cache[-1][0] // 60 if cache else None
393:     if last_min != now_ts // 60:
394:         cache.append((now_ts, avg_chg))
395:     else:
396:         cache[-1] = (now_ts, avg_chg)
397:     _sector_today_cache[sector] = cache
398:     return [{"time": datetime.fromtimestamp(t).strftime('%H:%M'), "value": v, "ts": t} for t, v in cache]
