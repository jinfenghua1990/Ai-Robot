<file path="backend/api/yuzi_tracker/tracker_router.py">
  1: """
  2: 游资 20 天生命周期跟踪 API 路由
  3: - GET  /api/yuzi/tracker             矩阵数据(心电图用)
  4: - GET  /api/yuzi/tracker/cluster     大妖股/A杀退潮画像(为 AI 聚类)
  5: - POST /api/yuzi/tracker/run         手动触发一次完整 run(d1+update)
  6: - POST /api/yuzi/tracker/d1          手动触发 D1
  7: - POST /api/yuzi/tracker/update      手动触发 update
  8: - POST /api/yuzi/tracker/backfill    历史回填
  9: - GET  /api/yuzi/tracker/stock       某只股票的完整 20 天轨迹
 10: """
 11: import json
 12: import logging
 13: from typing import Optional
 14: from collections import defaultdict
 15: from datetime import datetime, timedelta
 16: from fastapi import APIRouter, HTTPException, Query, Body
 17: from sqlalchemy import desc, func
 18: from db.session import get_db_session
 19: from db.models import YuziLifecycleTracker, YuziSeatDaily
 20: logger = logging.getLogger(__name__)
 21: router = APIRouter()
 22: def _row_to_dict(r: YuziLifecycleTracker) -> dict:
 23:     try:
 24:         lifecycle = json.loads(r.lifecycle_data or '{}')
 25:     except (ValueError, TypeError):
 26:         lifecycle = {}
 27:     return {
 28:         'id': r.id,
 29:         'trigger_date': r.trigger_date,
 30:         'ts_code': r.ts_code,
 31:         'stock_name': r.stock_name or '',
 32:         'quant_score_d1': float(r.quant_score_d1 or 0),
 33:         'boss_list_d1': (r.boss_list_d1 or '').split(',') if r.boss_list_d1 else [],
 34:         'resonance_count_d1': r.resonance_count_d1 or 0,
 35:         'lifecycle_data': lifecycle,
 36:         'final_outcome': r.final_outcome or '未结束',
 37:         'net_return_20d': float(r.net_return_20d or 0),
 38:         'day_filled': r.day_filled or 1,
 39:     }
 40: def _attach_boss_exits(db, rows: list) -> None:
 41:     """给每个 tracker row 附上 boss_exits + 离场/归档判定
 42:     boss_exits: {YYYYMMDD: [{alias, net}]}  D1 大佬在后续哪天卖了
 43:     all_bosses_exited: bool                 D1 大佬是否全部已离场
 44:     last_exit_date: str | None              最后一个大佬离场日期
 45:     new_entries_after_exit: list            离场后新游资买入记录
 46:     archived: bool                          全部离场 + 无新入场 + 距离≥3天 → 归档
 47:     """
 48:     if not rows:
 49:         return
 50:     ts_codes = list({r['ts_code'] for r in rows})
 51:     earliest = min(r['trigger_date'] for r in rows)
 52:     # 一次拉所有相关 SELL + BUY 记录
 53:     seats = db.query(YuziSeatDaily).filter(
 54:         YuziSeatDaily.ts_code.in_(ts_codes),
 55:         YuziSeatDaily.trade_date >= earliest,
 56:     ).all()
 57:     # 按 ts_code + side 分组
 58:     sell_by_code = defaultdict(list)
 59:     buy_by_code = defaultdict(list)
 60:     for s in seats:
 61:         if s.side == 'SELL':
 62:             sell_by_code[s.ts_code].append(s)
 63:         elif s.side == 'BUY':
 64:             buy_by_code[s.ts_code].append(s)
 65:     for r in rows:
 66:         bosses = set(r['boss_list_d1'] or [])
 67:         code_sells = sell_by_code.get(r['ts_code'], [])
 68:         exits = defaultdict(list)
 69:         for s in code_sells:
 70:             if s.yuzi_alias in bosses and s.trade_date >= r['trigger_date']:
 71:                 exits[s.trade_date].append({
 72:                     'alias': s.yuzi_alias,
 73:                     'net': round(float(s.net_amount or 0), 2),
 74:                 })
 75:         r['boss_exits'] = dict(exits)
 76:         # 离场判定: D1 大佬全部出现在 boss_exits 中
 77:         exited_aliases = set()
 78:         for _date, sells in exits.items():
 79:             for sl in sells:
 80:                 exited_aliases.add(sl['alias'])
 81:         all_bosses_exited = bool(bosses) and bosses.issubset(exited_aliases)
 82:         r['all_bosses_exited'] = all_bosses_exited
 83:         # 最后离场日期
 84:         last_exit_date = max(exits.keys()) if exits else None
 85:         r['last_exit_date'] = last_exit_date
 86:         # 离场后新游资入场检测
 87:         new_entries = []
 88:         if all_bosses_exited and last_exit_date:
 89:             code_buys = buy_by_code.get(r['ts_code'], [])
 90:             for b in code_buys:
 91:                 if b.trade_date > last_exit_date and b.yuzi_alias:
 92:                     new_entries.append({
 93:                         'alias': b.yuzi_alias,
 94:                         'date': b.trade_date,
 95:                         'net': round(float(b.net_amount or 0), 2),
 96:                     })
 97:             new_entries.sort(key=lambda x: x['date'], reverse=True)
 98:         r['new_entries_after_exit'] = new_entries
 99:         # 归档判定: 全部离场 + 无新入场 + 距最后离场日≥3天
100:         if all_bosses_exited and last_exit_date and not new_entries:
101:             try:
102:                 last_dt = datetime.strptime(last_exit_date, '%Y%m%d')
103:                 days_since = (datetime.now() - last_dt).days
104:                 r['archived'] = days_since >= 3
105:             except ValueError:
106:                 r['archived'] = False
107:         else:
108:             r['archived'] = False
109: @router.get("/api/yuzi/tracker")
110: def get_tracker(
111:     min_score: float = 0.0,
112:     outcome: Optional[str] = None,
113:     days_back: int = 30,
114:     limit: int = 200,
115:     include_archived: bool = False,
116: ):
117:     """
118:     20 天跟踪矩阵数据(供心电图前端)
119:     默认拉最近 30 天的所有 tracker, 覆盖 20 个交易日
120:     每行包含 boss_exits / all_bosses_exited / archived 等离场判定字段
121:     排序: 活跃(D1大佬未全离场) → 离场(全部离场但未归档) → 归档(离场3天无新入场)
122:     include_archived=False 时归档股票从 rows 中排除, 单独放 archived_rows
123:     """
124:     with get_db_session() as db:
125:         cutoff = (datetime.now() - timedelta(days=days_back)).strftime('%Y%m%d')
126:         q = db.query(YuziLifecycleTracker).filter(
127:             YuziLifecycleTracker.trigger_date >= cutoff,
128:         )
129:         if min_score:
130:             q = q.filter(YuziLifecycleTracker.quant_score_d1 >= min_score)
131:         if outcome:
132:             q = q.filter(YuziLifecycleTracker.final_outcome == outcome)
133:         rows = q.order_by(desc(YuziLifecycleTracker.quant_score_d1)).limit(limit or 200).all()
134:         data = [_row_to_dict(r) for r in rows]
135:         # 附上大佬卖出记录 + 离场/归档判定
136:         _attach_boss_exits(db, data)
137:         # 三组分区排序: 活跃 → 离场 → 归档
138:         active = [d for d in data if not d.get('all_bosses_exited')]
139:         exited = [d for d in data if d.get('all_bosses_exited') and not d.get('archived')]
140:         archived = [d for d in data if d.get('archived')]
141:         # 活跃组: 按 quant_score_d1 desc (已是 DB 排序, 保持)
142:         # 离场组: 按 last_exit_date desc
143:         exited.sort(key=lambda x: x.get('last_exit_date') or '', reverse=True)
144:         # 归档组: 按 last_exit_date desc
145:         archived.sort(key=lambda x: x.get('last_exit_date') or '', reverse=True)
146:         active_rows = active + exited
147:         if include_archived:
148:             active_rows = active + exited + archived
149:         # 汇总统计(仅活跃+离场, 不含归档)
150:         total = len(active_rows)
151:         by_outcome = {}
152:         for d in active_rows:
153:             o = d['final_outcome']
154:             by_outcome[o] = by_outcome.get(o, 0) + 1
155:         avg_20d = round(sum(d['net_return_20d'] for d in active_rows) / total, 2) if total else 0
156:         high_score_count = sum(1 for d in active_rows if d['quant_score_d1'] >= 85)
157:         return {
158:             'count': total,
159:             'archived_count': len(archived),
160:             'avg_20d_return': avg_20d,
161:             'high_score_count': high_score_count,
162:             'by_outcome': by_outcome,
163:             'rows': active_rows,
164:             'archived_rows': archived if not include_archived else [],
165:         }
166: @router.get("/api/yuzi/tracker/cluster")
167: def cluster_profile(
