<file path="backend/collectors/dragon_tiger_collector.py">
  1: """
  2: 游资龙虎榜采集器（Tushare top_list / top_inst）
  3: 核心流程（Day 1 盘后清洗 → Day 2 观察池）:
  4: 1) top_list(trade_date)        当日龙虎榜上榜股（含 reason / net_amount / turnover_rate）
  5: 2) top_inst(trade_date)        上榜股的营业部明细（含 ex_name / side / buy / sell）
  6: 3) 用 yuzi_dict 做 ex_name → yuzi_alias 匹配
  7: 4) 按 ts_code 聚合：总净买 / 共振大佬数 / boss_list / seat_detail
  8: 5) 量化评分（基础 60 + 共振加成 + 资金规模加成 + 涨停/换手修正）
  9: 6) 写 yuzi_seat_daily（明细）+ yuzi_quant_signals（汇总）
 10: 7) 前端 /yuzi-billboard 直接读
 11: 历史回填：backfill_yuzi(start_date, end_date) 逐日跑
 12: 盘后调度：run_today() 跑最新一日（无新数据则跳过）
 13: """
 14: import json
 15: import logging
 16: import time
 17: from datetime import datetime, timedelta
 18: from typing import Optional, List, Dict, Tuple
 19: from sqlalchemy import func
 20: from db.connection import engine
 21: from db.session import get_db_session
 22: from db.models import YuziDict, YuziQuantSignal, YuziSeatDaily
 23: logger = logging.getLogger(__name__)
 24: # === 评分参数（保持与 quant_engine.py 风格一致，可后续调）===
 25: SCORE_BASE = 60.0
 26: SCORE_PER_RESONANCE = 8.0          # 每多 1 家大佬共振 +8 分
 27: SCORE_PER_1000W_NETBUY = 1.5       # 每 1000 万净买入 +1.5 分
 28: SCORE_NETBUY_CAP = 25.0            # 资金规模加成上限 25 分
 29: SCORE_LIMIT_UP_BONUS = 5.0         # 涨停额外 +5 分
 30: SCORE_HIGH_TURN_PENALTY = -3.0     # 换手 > 30% 减 3 分（防短线出货）
 31: SCORE_TURNOVER_THRESHOLD = 30.0
 32: def _tushare_top_list(trade_date: str) -> List[dict]:
 33:     """调 Tushare HTTP API 拉 top_list"""
 34:     from collectors.tdx_collector import call_tushare_mcp
 35:     rows = call_tushare_mcp(
 36:         api_name='top_list',
 37:         params={'trade_date': trade_date},
 38:         fields=['ts_code', 'name', 'trade_date', 'close', 'pct_change',
 39:                 'turnover_rate', 'amount', 'l_sell', 'l_buy', 'l_amount',
 40:                 'net_amount', 'net_rate', 'amount_rate', 'float_values',
 41:                 'reason', 'reason_type'],
 42:     )
 43:     if not rows:
 44:         return []
 45:     # 字段名兼容
 46:     for r in rows:
 47:         r['pct_change'] = r.get('pct_change') or r.get('pct_chg') or 0
 48:         r['turnover_rate'] = r.get('turnover_rate') or 0
 49:         r['amount'] = r.get('amount') or 0
 50:         r['net_amount'] = r.get('net_amount') or 0
 51:         r['l_buy'] = r.get('l_buy') or 0
 52:         r['l_sell'] = r.get('l_sell') or 0
 53:     return rows
 54: def _tushare_top_inst(trade_date: str) -> List[dict]:
 55:     """调 Tushare HTTP API 拉 top_inst（营业部明细）"""
 56:     from collectors.tdx_collector import call_tushare_mcp
 57:     rows = call_tushare_mcp(
 58:         api_name='top_inst',
 59:         params={'trade_date': trade_date},
 60:         fields=['ts_code', 'exalter', 'side', 'buy', 'sell', 'net_buy',
 61:                 'reason', 'net_rate', 'amount', 'branch', 'net_amount'],
 62:     )
 63:     if not rows:
 64:         return []
 65:     # 字段名兼容
 66:     for r in rows:
 67:         r['buy'] = r.get('buy') or 0
 68:         r['sell'] = r.get('sell') or 0
 69:         r['net_buy'] = r.get('net_buy') or 0
 70:         r['ex_name'] = r.get('exalter') or r.get('branch') or ''
 71:     return rows
 72: def _get_yuzi_mapping(db) -> Dict[str, YuziDict]:
 73:     """从 yuzi_dict 读 seat_name → YuziDict 字典"""
 74:     rows = db.query(YuziDict).filter(YuziDict.is_active == True).all()  # noqa
 75:     return {r.seat_name: r for r in rows}
 76: def _score_signal(resonance_count: int, total_net_buy: float,
 77:                   limit_up: bool, turnover_rate: float) -> Tuple[float, dict]:
 78:     """量化评分（0-100）"""
 79:     score = SCORE_BASE
 80:     factors = {'base': SCORE_BASE}
 81:     # 共振加成
 82:     if resonance_count > 1:
 83:         s = (resonance_count - 1) * SCORE_PER_RESONANCE
 84:         score += s
 85:         factors['resonance'] = s
 86:     # 资金规模加成（每 1000 万 +1.5，封顶 25）
 87:     if total_net_buy > 0:
 88:         s = min(int(total_net_buy / 1000) * SCORE_PER_1000W_NETBUY, SCORE_NETBUY_CAP)
 89:         score += s
 90:         factors['capital'] = round(s, 2)
 91:     # 涨停加成
 92:     if limit_up:
 93:         score += SCORE_LIMIT_UP_BONUS
 94:         factors['limit_up'] = SCORE_LIMIT_UP_BONUS
 95:     # 高换手惩罚
 96:     if turnover_rate and turnover_rate > SCORE_TURNOVER_THRESHOLD:
 97:         score += SCORE_HIGH_TURN_PENALTY
 98:         factors['turnover_penalty'] = SCORE_HIGH_TURN_PENALTY
 99:     score = max(0, min(100, score))
100:     return round(score, 2), factors
101: def _process_one_day(trade_date: str) -> Dict:
102:     """
103:     处理单日：拉 Tushare → 匹配 → 评分 → 写库
104:     返回 {'date','top_list_count','top_inst_count','seat_matched','signals_written'}
105:     """
106:     logger.info(f'[{trade_date}] start processing yuzi dragon-tiger...')
107:     # 1) 拉原始数据
108:     top_list = _tushare_top_list(trade_date)
109:     if not top_list:
110:         logger.info(f'[{trade_date}] no top_list, skip')
111:         return {'date': trade_date, 'top_list': 0, 'top_inst': 0,
112:                 'matched': 0, 'signals': 0, 'seats': 0}
113:     top_inst = _tushare_top_inst(trade_date)
114:     if not top_inst:
115:         logger.info(f'[{trade_date}] no top_inst, skip')
116:         return {'date': trade_date, 'top_list': len(top_list), 'top_inst': 0,
117:                 'matched': 0, 'signals': 0, 'seats': 0}
118:     # 2) 整理 top_list 上下文 (过滤 ST/*ST 股票,不入库)
119:     tl_map = {r['ts_code']: r for r in top_list if r.get('ts_code')}
120:     st_codes = [c for c, r in tl_map.items() if 'ST' in (r.get('name') or '')]
121:     if st_codes:
122:         logger.info(f'[{trade_date}] 过滤 ST 股票 {len(st_codes)} 只: {st_codes[:10]}')
123:         tl_map = {c: r for c, r in tl_map.items() if c not in st_codes}
124:     with get_db_session() as db:
125:         yuzi_map = _get_yuzi_mapping(db)
126:         if not yuzi_map:
127:             logger.warning(f'[{trade_date}] yuzi_dict empty, run seed first')
128:             return {'date': trade_date, 'top_list': len(top_list), 'top_inst': len(top_inst),
129:                     'matched': 0, 'signals': 0, 'seats': 0}
130:         # 3) 匹配游资席位 → 按 ts_code 聚合 (跳过 ST 股票)
131:         matched_rows: List[dict] = []
132:         unmatched_seats = set()
133:         for inst in top_inst:
134:             # ST 股票整体跳过(不入 seat_daily / signal)
135:             if inst.get('ts_code') not in tl_map:
136:                 continue
137:             ex_name = inst.get('ex_name', '') or ''
138:             yd = yuzi_map.get(ex_name)
139:             if not yd:
140:                 unmatched_seats.add(ex_name)
141:                 continue
142:             inst['yuzi_alias'] = yd.yuzi_alias
143:             inst['yuzi_group'] = yd.yuzi_group
144:             inst['yuzi_hot_score'] = yd.hot_score
145:             matched_rows.append(inst)
146:         logger.info(f'[{trade_date}] matched {len(matched_rows)}/{len(top_inst)} seats, '
147:                     f'{len(unmatched_seats)} unmatched')
148:         if not matched_rows:
149:             return {'date': trade_date, 'top_list': len(top_list), 'top_inst': len(top_inst),
150:                     'matched': 0, 'signals': 0, 'seats': 0}
151:         # 4) 写 yuzi_seat_daily（先清后写，幂等）
152:         db.query(YuziSeatDaily).filter(YuziSeatDaily.trade_date == trade_date).delete()
153:         # 同 (date, seat, code) 可能有多笔成交（买入+卖出/分多次），合并成一条
154:         seat_merge = {}
155:         for inst in matched_rows:
156:             key = (inst.get('ex_name', ''), inst.get('ts_code', ''))
157:             if key not in seat_merge:
158:                 seat_merge[key] = {
159:                     'seat_name': inst.get('ex_name', ''),
160:                     'yuzi_alias': inst.get('yuzi_alias', ''),
161:                     'ts_code': inst.get('ts_code', ''),
162:                     'stock_name': (tl_map.get(inst.get('ts_code', ''), {}) or {}).get('name', ''),
163:                     'buy': 0.0, 'sell': 0.0, 'net': 0.0,
164:                     'net_ratio': float(inst.get('net_rate', 0)) or 0,
165:                     'turnover_rate': float((tl_map.get(inst.get('ts_code', ''), {}) or {}).get('turnover_rate', 0)) or 0,
166:                     'amount': float((tl_map.get(inst.get('ts_code', ''), {}) or {}).get('amount', 0)) or 0,
167:                     'reason': (tl_map.get(inst.get('ts_code', ''), {}) or {}).get('reason', ''),
168:                 }
169:             m = seat_merge[key]
170:             m['buy'] += float(inst.get('buy', 0)) / 10000.0
171:             m['sell'] += float(inst.get('sell', 0)) / 10000.0
172:             m['net'] += float(inst.get('net_buy', 0)) / 10000.0
173:         for m in seat_merge.values():
174:             db.add(YuziSeatDaily(
175:                 trade_date=trade_date,
176:                 seat_name=m['seat_name'],
177:                 yuzi_alias=m['yuzi_alias'],
178:                 ts_code=m['ts_code'],
179:                 stock_name=m['stock_name'],
180:                 side='BUY' if m['net'] > 0 else ('SELL' if m['net'] < 0 else 'FLAT'),
181:                 buy_amount=round(m['buy'], 2),
182:                 sell_amount=round(m['sell'], 2),
183:                 net_amount=round(m['net'], 2),
184:                 net_ratio=m['net_ratio'],
185:                 turnover_rate=m['turnover_rate'],
186:                 amount=m['amount'],
187:                 list_reason=m['reason'],
188:             ))
189:         # 5) 按 ts_code 聚合 → 写 yuzi_quant_signals
190:         from collections import defaultdict
191:         agg: Dict[str, dict] = defaultdict(lambda: {
192:             'total_buy': 0.0, 'total_sell': 0.0, 'total_net': 0.0,
193:             'bosses': [], 'seat_detail': [],
194:         })
195:         for inst in matched_rows:
196:             code = inst.get('ts_code', '')
197:             if not code:
198:                 continue
199:             alias = inst.get('yuzi_alias', '')
200:             if alias not in agg[code]['bosses']:
201:                 agg[code]['bosses'].append(alias)
202:             agg[code]['total_buy'] += float(inst.get('buy', 0)) / 10000.0
203:             agg[code]['total_sell'] += float(inst.get('sell', 0)) / 10000.0
204:             agg[code]['total_net'] += float(inst.get('net_buy', 0)) / 10000.0
205:             agg[code]['seat_detail'].append({
206:                 'alias': alias,
207:                 'side': 'BUY' if inst.get('net_buy', 0) > 0 else 'SELL',
208:                 'net_buy': round(float(inst.get('net_buy', 0)) / 10000.0, 2),
209:                 'buy': round(float(inst.get('buy', 0)) / 10000.0, 2),
210:                 'sell': round(float(inst.get('sell', 0)) / 10000.0, 2),
211:             })
212:         # 清空当天旧信号
213:         db.query(YuziQuantSignal).filter(YuziQuantSignal.trade_date == trade_date).delete()
214:         signals_written = 0
215:         for ts_code, item in agg.items():
216:             tl = tl_map.get(ts_code, {}) or {}
217:             net_buy = item['total_net']
218:             # 只写净买入的（净卖出跳过，量化池只关注"买"）
219:             if net_buy <= 0:
220:                 continue
221:             resonance = len(item['bosses'])
222:             limit_up = (float(tl.get('pct_change', 0) or 0) >= 9.5)
223:             turnover = float(tl.get('turnover_rate', 0) or 0)
224:             score, factors = _score_signal(resonance, net_buy, limit_up, turnover)
225:             sig = YuziQuantSignal(
226:                 trade_date=trade_date,
227:                 ts_code=ts_code,
228:                 stock_name=tl.get('name', ''),
229:                 sector=tl.get('industry', ''),  # top_list 没 industry，运行时留空
230:                 total_net_buy=round(net_buy, 2),
231:                 total_buy=round(item['total_buy'], 2),
232:                 total_sell=round(item['total_sell'], 2),
233:                 resonance_count=resonance,
234:                 boss_list=','.join(item['bosses']),
235:                 seat_detail=json.dumps(item['seat_detail'], ensure_ascii=False),
236:                 quant_score=score,
237:                 score_factors=json.dumps(factors, ensure_ascii=False),
238:                 change_pct=float(tl.get('pct_change', 0) or 0),
239:                 close_price=float(tl.get('close', 0) or 0),
240:                 turnover_rate=turnover,
241:                 limit_up_flag=limit_up,
242:                 amount=float(tl.get('amount', 0) or 0),
243:                 list_reason=tl.get('reason', ''),
244:                 list_tag=tl.get('reason_type', ''),
245:             )
246:             db.add(sig)
247:             signals_written += 1
248:         db.commit()
249:         logger.info(f'[{trade_date}] done. {signals_written} signals, '
250:                     f'{len(matched_rows)} seat rows, {len(unmatched_seats)} unmatched seats')
251:     return {
252:         'date': trade_date,
253:         'top_list': len(top_list),
254:         'top_inst': len(top_inst),
255:         'matched': len(matched_rows),
256:         'signals': signals_written,
257:         'seats': len(matched_rows),
258:         'unmatched_count': len(unmatched_seats),
259:         'unmatched_sample': list(unmatched_seats)[:30],
260:     }
261: def run_today(force_date: Optional[str] = None) -> Dict:
262:     """
263:     跑最新一日的龙虎榜清洗
264:     force_date: 强制跑指定日期（YYYYMMDD）
265:     """
266:     target = force_date
267:     if not target:
268:         # 优先尝试今天（Tushare 18:00 后出当日数据）
269:         from collectors.tdx_collector import call_tushare_mcp
270:         today_str = datetime.now().strftime('%Y%m%d')
271:         rows = call_tushare_mcp(
272:             api_name='top_list',
273:             params={'trade_date': today_str},
274:             fields=['ts_code', 'trade_date'],
275:         )
276:         if rows:
277:             target = today_str
278:         else:
279:             # 今天无数据，退到昨天
280:             target = (datetime.now() - timedelta(days=1)).strftime('%Y%m%d')
281:     return _process_one_day(target)
282: def backfill_yuzi(start_date: str, end_date: str) -> List[Dict]:
283:     """
284:     历史回填：start_date/end_date 均为 YYYYMMDD 字符串
285:     逐日跑，跳过已成功的日期
286:     """
287:     from datetime import datetime as _dt
288:     sd = _dt.strptime(start_date, '%Y%m%d')
289:     ed = _dt.strptime(end_date, '%Y%m%d')
290:     if sd > ed:
291:         sd, ed = ed, sd
292:     results = []
293:     cur = sd
294:     while cur <= ed:
295:         d = cur.strftime('%Y%m%d')
296:         try:
297:             r = _process_one_day(d)
298:             results.append(r)
299:             time.sleep(0.6)  # 避免 Tushare 限流
300:         except Exception as e:
301:             logger.error(f'[{d}] backfill error: {e}', exc_info=True)
302:             results.append({'date': d, 'error': str(e)})
303:         cur += timedelta(days=1)
304:     return results
305: def latest_yuzi_date() -> Optional[str]:
306:     """返回 DB 里最新的 yuzi_quant_signals.trade_date"""
307:     with get_db_session() as db:
308:         row = db.query(YuziQuantSignal.trade_date, func.max(YuziQuantSignal.trade_date)).first()
309:         if row and row[0]:
310:             return row[0]
311:         return None
