<file path="backend/collectors/moneyflow_detail.py">
  1: """
  2: 个股 4 档资金流(特/大/小/散单)采集器
  3: - 数据源:Tushare moneyflow 接口(主力=特大+大,散户=小+散)
  4: - Tushare moneyflow 字段:
  5:   - buy_elg_amount: 特大单买入
  6:   - sell_elg_amount: 特大单卖出
  7:   - buy_lg_amount: 大单买入
  8:   - sell_lg_amount: 大单卖出
  9:   - buy_md_amount: 中单买入
 10:   - sell_md_amount: 中单卖出
 11:   - buy_sm_amount: 小单买入
 12:   - sell_sm_amount: 小单卖出
 13: - 散单(tiny) = 净流入 - 特大单 - 大单 - 中单 - 小单
 14: - 表:stock_money_flow_detail
 15: """
 16: import logging
 17: from datetime import datetime
 18: from typing import Optional
 19: from db.session import get_db_session
 20: from db.models import StockMoneyFlowDetail
 21: logger = logging.getLogger(__name__)
 22: def _to_yuan(val) -> float:
 23:     """Tushare moneyflow 单位是万元,转元"""
 24:     try:
 25:         return float(val or 0) * 10000
 26:     except (TypeError, ValueError):
 27:         return 0.0
 28: def _net(buy, sell) -> float:
 29:     """净流入 = 买入 - 卖出"""
 30:     return _to_yuan(buy) - _to_yuan(sell)
 31: def _safe_pct(part, total) -> float:
 32:     if not total:
 33:         return 0.0
 34:     try:
 35:         return round(float(part) / float(total) * 100, 3)
 36:     except (TypeError, ValueError, ZeroDivisionError):
 37:         return 0.0
 38: def fetch_moneyflow_for_date(trade_date: str) -> dict:
 39:     """拉 Tushare 某日的全市场 moneyflow 流水,标准化后写库
 40:     trade_date: YYYYMMDD 字符串
 41:     返回:{'fetched': 整数, 'written': 整数, 'skipped': 整数}
 42:     """
 43:     from collectors.tdx_collector import call_tushare_mcp
 44:     # 拉全市场 moneyflow 流水
 45:     rows = call_tushare_mcp(
 46:         'moneyflow',
 47:         params={'trade_date': trade_date},
 48:         fields=[
 49:             'ts_code', 'trade_date',
 50:             'buy_elg_amount', 'sell_elg_amount',
 51:             'buy_lg_amount', 'sell_lg_amount',
 52:             'buy_md_amount', 'sell_md_amount',
 53:             'buy_sm_amount', 'sell_sm_amount',
 54:             'net_mf_amount',  # 主力净流入
 55:         ],
 56:     )
 57:     if not rows:
 58:         logger.info(f'[moneyflow_detail] tushare returned empty for {trade_date}')
 59:         return {'fetched': 0, 'written': 0, 'skipped': 0}
 60:     # 拉流通市值(万元) + 换手率(算占流通市值比例)
 61:     daily_rows = call_tushare_mcp(
 62:         'daily_basic',
 63:         params={'trade_date': trade_date},
 64:         fields=['ts_code', 'turnover_rate', 'circ_mv'],  # circ_mv: 流通市值(万元)
 65:     )
 66:     turnover_map = {r['ts_code']: r.get('turnover_rate') for r in (daily_rows or [])}
 67:     circ_mv_map = {r['ts_code']: r.get('circ_mv') for r in (daily_rows or [])}  # 万元
 68:     written = 0
 69:     skipped = 0
 70:     trade_date_obj = datetime.strptime(trade_date, '%Y%m%d').date()
 71:     with get_db_session() as db:
 72:         for r in rows:
 73:             ts_code = r.get('ts_code')
 74:             if not ts_code:
 75:                 skipped += 1
 76:                 continue
 77:             # 4 档净流入(元)
 78:             super_large_net = _net(r.get('buy_elg_amount'), r.get('sell_elg_amount'))
 79:             large_net = _net(r.get('buy_lg_amount'), r.get('sell_lg_amount'))
 80:             medium_net = _net(r.get('buy_md_amount'), r.get('sell_md_amount'))
 81:             small_net = _net(r.get('buy_sm_amount'), r.get('sell_sm_amount'))
 82:             # 主力=特大+大
 83:             main_net = super_large_net + large_net
 84:             main_buy = _to_yuan(r.get('buy_elg_amount')) + _to_yuan(r.get('buy_lg_amount'))
 85:             main_sell = _to_yuan(r.get('sell_elg_amount')) + _to_yuan(r.get('sell_lg_amount'))
 86:             # 散户=中单+小单+散单(tiny)
 87:             retail_buy = _to_yuan(r.get('buy_sm_amount')) + _to_yuan(r.get('buy_md_amount'))
 88:             retail_sell = _to_yuan(r.get('sell_sm_amount')) + _to_yuan(r.get('sell_md_amount'))
 89:             # 散单=主力+中单+小单 之和的负值(总净流入=0)
 90:             # 总净流入 = 主力 + 中单 + 小单 + 散单 = 0
 91:             # 所以 散单 = -(主力 + 中单 + 小单)
 92:             tiny_net = -(main_net + medium_net + small_net)
 93:             retail_net = medium_net + small_net + tiny_net  # 散户=中单+小单+散单
 94:             # 占流通市值比例(%) = 净流入(元) / 流通市值(元) * 100
 95:             # 净流入(元)/10000 = 净流入(万元)
 96:             # 流通市值(万元)
 97:             # 占比% = 净流入(万元) / 流通市值(万元) * 100
 98:             circ_mv = circ_mv_map.get(ts_code)  # 万元
 99:             super_large_pct = round(super_large_net / 10000 / circ_mv * 100, 3) if circ_mv and circ_mv > 0 else 0
100:             large_pct = round(large_net / 10000 / circ_mv * 100, 3) if circ_mv and circ_mv > 0 else 0
101:             small_pct = round(small_net / 10000 / circ_mv * 100, 3) if circ_mv and circ_mv > 0 else 0
102:             tiny_pct = round(tiny_net / 10000 / circ_mv * 100, 3) if circ_mv and circ_mv > 0 else 0
103:             turnover = float(turnover_map.get(ts_code) or 0)
104:             # upsert
105:             existing = db.query(StockMoneyFlowDetail).filter(
106:                 StockMoneyFlowDetail.trade_date == trade_date_obj,
107:                 StockMoneyFlowDetail.ts_code == ts_code,
108:             ).first()
109:             if existing:
110:                 existing.super_large_net = super_large_net
111:                 existing.large_net = large_net
112:                 existing.medium_net = medium_net
113:                 existing.small_net = small_net
114:                 existing.tiny_net = tiny_net
115:                 existing.main_net = main_net
116:                 existing.main_buy = main_buy
117:                 existing.main_sell = main_sell
118:                 existing.retail_net = retail_net
119:                 existing.retail_buy = retail_buy
120:                 existing.retail_sell = retail_sell
121:                 existing.super_large_pct = super_large_pct
122:                 existing.large_pct = large_pct
123:                 existing.small_pct = small_pct
124:                 existing.tiny_pct = tiny_pct
125:                 existing.turnover_rate = turnover
126:                 existing.source = 'tushare'
127:             else:
128:                 db.add(StockMoneyFlowDetail(
129:                     trade_date=trade_date_obj,
130:                     ts_code=ts_code,
131:                     super_large_net=super_large_net,
132:                     large_net=large_net,
133:                     medium_net=medium_net,
134:                     small_net=small_net,
135:                     tiny_net=tiny_net,
136:                     main_net=main_net,
137:                     main_buy=main_buy,
138:                     main_sell=main_sell,
139:                     retail_net=retail_net,
140:                     retail_buy=retail_buy,
141:                     retail_sell=retail_sell,
142:                     super_large_pct=super_large_pct,
143:                     large_pct=large_pct,
144:                     small_pct=small_pct,
145:                     tiny_pct=tiny_pct,
146:                     turnover_rate=turnover,
147:                     source='tushare',
148:                 ))
149:             written += 1
150:         db.commit()
151:     return {'fetched': len(rows), 'written': written, 'skipped': skipped}
152: def backfill_moneyflow_detail(start_date: str, end_date: str) -> list:
153:     """批量回填区间内的所有交易日"""
154:     from datetime import timedelta
155:     from sqlalchemy import func as sqlfunc
156:     from db.models import StockMoneyFlowDetail
157:     start = datetime.strptime(start_date, '%Y%m%d').date()
158:     end = datetime.strptime(end_date, '%Y%m%d').date()
159:     results = []
160:     cur = start
161:     while cur <= end:
162:         # 跳过周末
163:         if cur.weekday() < 5:
164:             trade_date_str = cur.strftime('%Y%m%d')
165:             try:
166:                 r = fetch_moneyflow_for_date(trade_date_str)
167:                 results.append({'date': trade_date_str, **r})
168:             except Exception as e:
169:                 logger.error(f'[moneyflow_detail] backfill {trade_date_str} error: {e}')
170:                 results.append({'date': trade_date_str, 'error': str(e)})
171:         cur += timedelta(days=1)
172:     return results
173: def get_stock_moneyflow_detail(ts_code: str, trade_date: Optional[str] = None) -> Optional[dict]:
174:     """查询某只股票某日的 4 档资金流(无 trade_date 时取最新一日)
175:     返回 dict 含:
176:       - super_large/large/small/tiny: 4 档净流入(元)
177:       - main_net/main_buy/main_sell: 主力净流入/买入/卖出
178:       - retail_net/retail_buy/retail_sell: 散户
179:       - super_large_pct/large_pct/small_pct/tiny_pct: 占流通盘比例
180:       - turnover_rate: 换手率
181:       - 同步返回近 5 日数据
182:     """
183:     from db.models import StockMoneyFlowDetail
184:     from sqlalchemy import func as sqlfunc
185:     with get_db_session() as db:
186:         if trade_date:
187:             td = datetime.strptime(trade_date, '%Y%m%d').date()
188:             row = db.query(StockMoneyFlowDetail).filter(
189:                 StockMoneyFlowDetail.trade_date == td,
190:                 StockMoneyFlowDetail.ts_code == ts_code,
191:             ).first()
192:         else:
193:             row = db.query(StockMoneyFlowDetail).filter(
194:                 StockMoneyFlowDetail.ts_code == ts_code
195:             ).order_by(StockMoneyFlowDetail.trade_date.desc()).first()
196:         if not row:
197:             return None
198:         # 当前数据
199:         current = _row_to_dict(row)
200:         # 近 5 日同档
201:         recent = db.query(StockMoneyFlowDetail).filter(
202:             StockMoneyFlowDetail.ts_code == ts_code,
203:             StockMoneyFlowDetail.trade_date <= row.trade_date,
204:         ).order_by(StockMoneyFlowDetail.trade_date.desc()).limit(5).all()
205:         recent_list = [_row_to_dict(r) for r in recent]
206:         return {
207:             'current': current,
208:             'recent_5d': recent_list,
209:         }
210: def _row_to_dict(row) -> dict:
211:     """DB Row → dict(单位:万元,保留 2 位小数)"""
212:     def y2w(v) -> float:
213:         """元 → 万元"""
214:         try:
215:             return round(float(v or 0) / 10000, 2)
216:         except (TypeError, ValueError):
217:             return 0.0
218:     return {
219:         'trade_date': row.trade_date.strftime('%Y%m%d') if row.trade_date else None,
220:         'ts_code': row.ts_code,
221:         # 4 档净流入(万元)
222:         'super_large': y2w(row.super_large_net),
223:         'large': y2w(row.large_net),
224:         'medium': y2w(row.medium_net),
225:         'small': y2w(row.small_net),
226:         'tiny': y2w(row.tiny_net),
227:         # 主力/散户(万元)
228:         'main_net': y2w(row.main_net),
229:         'main_buy': y2w(row.main_buy),
230:         'main_sell': y2w(row.main_sell),
231:         'retail_net': y2w(row.retail_net),
232:         'retail_buy': y2w(row.retail_buy),
233:         'retail_sell': y2w(row.retail_sell),
234:         # 占比(% 占流通盘)
235:         'super_large_pct': float(row.super_large_pct or 0),
236:         'large_pct': float(row.large_pct or 0),
237:         'small_pct': float(row.small_pct or 0),
238:         'tiny_pct': float(row.tiny_pct or 0),
239:         'turnover_rate': float(row.turnover_rate or 0),
240:         'source': row.source,
241:     }
