435: def compute_quality_from_features(market_state: str, features: dict, is_junk: bool = False) -> str:
436:     """根据 market_state + 特征数据细化映射到 quality_status（7段，新命名）
437:     - CHOPPY: noise_ratio>1.5 → 劣质，否则 中性
438:     - TREND:  弱趋势→偏强，中趋势→强势，强趋势+放量→极强
439:     - IMPULSE: 弱主升→强势，强主升+资金连续→核心
440:     - PENDING/无数据: 中性
441:     手动标记"淘汰"由调用方在外部保留（不进入本函数）。
442:     """
443:     if market_state == 'CHOPPY':
444:         if is_junk or (features.get('noise_ratio') or 0) > 1.5:
445:             return '劣质'
446:         return '中性'
447:     if market_state == 'TREND':
448:         close_vs_ma20 = features.get('close_vs_ma20') or 0
449:         volume_ratio = features.get('volume_ratio') or 0
450:         if close_vs_ma20 >= 0.05 and volume_ratio >= 1.5:
451:             return '极强'
452:         if close_vs_ma20 >= 0.03:
453:             return '强势'
454:         return '偏强'
455:     if market_state == 'IMPULSE':
456:         volume_ratio = features.get('volume_ratio') or 0
457:         flow_continuity = features.get('flow_continuity') or 0
458:         if volume_ratio >= 2.0 and flow_continuity >= 3:
459:             return '核心'
460:         return '极强'
461:     # PENDING / UNKNOWN / None
462:     return '中性'
