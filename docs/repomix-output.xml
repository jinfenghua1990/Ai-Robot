<file path="backend/api/watchlist/realtime_stream.py">
  1: """Watchlist 实时数据 SSE 推送
  2: - 复用 REALTIME_STATE 内存态（scheduler 每 5 秒更新）
  3: - 订阅：客户端 GET 时传 watchlist ts_code 列表，服务端每 5 秒推送一次
  4: - 格式：SSE data 字段为 JSON {ts_code: {current_price, pct_chg, ...}}
  5: - 自动清理：客户端断开后停止推送
  6: 设计权衡：
  7: - 用 SSE 而非 WebSocket：浏览器原生 EventSource，自动重连，单向推送够用
  8: - 5 秒推送周期匹配 scheduler 采集频率，避免重复刷新
  9: - 单连接支持任意数量的 watchlist 股票
 10: """
 11: import asyncio
 12: import json
 13: import logging
 14: from datetime import datetime
 15: from typing import List
 16: from fastapi import APIRouter
 17: from fastapi.responses import StreamingResponse
 18: from db.session import get_db_session
 19: from db.models import Watchlist
 20: from collectors.realtime_aggregator import REALTIME_STATE, serialize_state
 21: logger = logging.getLogger(__name__)
 22: router = APIRouter()
 23: def _resolve_watchlist_ts_codes() -> List[str]:
 24:     """从 DB 读取自选股 ts_code 列表"""
 25:     with get_db_session() as db:
 26:         rows = db.query(Watchlist.stock_code).all()
 27:         result = []
 28:         for r in rows:
 29:             code = r[0]
 30:             if code.startswith(('6', '9')):
 31:                 result.append(f'{code}.SH')
 32:             elif code.startswith(('8', '4')):
 33:                 result.append(f'{code}.BJ')
 34:             else:
 35:                 result.append(f'{code}.SZ')
 36:         return result
 37: def _build_snapshot(ts_codes: List[str]) -> dict:
 38:     """构建单帧推送数据：{ts_code: {price, pct_chg, ...}, server_time, count}"""
 39:     from datetime import date
 40:     from sqlalchemy import text
 41:     snap = {
 42:         'server_time': datetime.now().isoformat(timespec='seconds'),
 43:         'data': {},
 44:     }
 45:     # 1. 从 REALTIME_STATE 取基础行情
 46:     for ts_code in ts_codes:
 47:         st = REALTIME_STATE.get(ts_code)
 48:         if not st:
 49:             continue
 50:         snap['data'][ts_code] = serialize_state(ts_code)
 51:     # 2. 从 realtime_stock_flow 补充实时资金流（多源交叉验证，统一数据源）
 52:     if snap['data']:
 53:         try:
 54:             with get_db_session() as db:
 55:                 codes = [c for c in ts_codes if c in snap['data']]
 56:                 if codes:
 57:                     rows = db.execute(text("""
 58:                         SELECT DISTINCT ON (ts_code) ts_code,
 59:                             snapshot_time,
 60:                             main_force_inflow, retail_flow,
 61:                             price, price_chg
 62:                         FROM realtime_stock_flow
 63:                         WHERE ts_code = ANY(:codes) AND trade_date = :td
 64:                         ORDER BY ts_code, snapshot_time DESC
 65:                     """), {"codes": codes, "td": date.today()}).fetchall()
 66:                     for r in rows:
 67:                         ts = r.ts_code
 68:                         if ts in snap['data']:
 69:                             main_net = float(r.main_force_inflow or 0) * 10000  # 万元→元
 70:                             retail_net = float(r.retail_flow or 0) * 10000
 71:                             snap['data'][ts].update({
 72:                                 "main_buy": 0,
 73:                                 "main_sell": 0,
 74:                                 "main_net": main_net,
 75:                                 "retail_buy": 0,
 76:                                 "retail_sell": 0,
 77:                                 "retail_net": retail_net,
 78:                                 "turnover": 0,
 79:                                 "snapshot_time": r.snapshot_time.isoformat() if r.snapshot_time else None,
 80:                                 "money_flow_source": "realtime_crossvalidated",
 81:                             })
 82:         except Exception as e:
 83:             logger.warning(f"[realtime_stream] money flow query failed: {e}")
 84:     snap['count'] = len(snap['data'])
 85:     return snap
 86: async def _event_stream(ts_codes: List[str]):
 87:     """SSE 事件流：每 5 秒推送一次，15 秒心跳"""
 88:     interval = 5.0
 89:     heartbeat_interval = 15.0  # 每 3 帧发一次心跳
 90:     frame_count = 0
 91:     try:
 92:         # 首次立即推送一帧
 93:         yield f"data: {json.dumps(_build_snapshot(ts_codes), ensure_ascii=False)}\n\n"
 94:         while True:
 95:             await asyncio.sleep(interval)
 96:             frame_count += 1
 97:             # 每 3 帧插入一次心跳注释，保持连接活跃
 98:             if frame_count % 3 == 0:
 99:                 yield f": heartbeat\n\n"
100:             yield f"data: {json.dumps(_build_snapshot(ts_codes), ensure_ascii=False)}\n\n"
101:     except asyncio.CancelledError:
102:         logger.debug(f'[watchlist-sse] client disconnected, ts_codes={len(ts_codes)}')
103:         raise
104: @router.get('/api/watchlist/realtime/stream')
105: async def stream_realtime():
106:     """SSE 端点：服务端推送 watchlist 全量实时态（每 5 秒）
107:     客户端:
108:       const es = new EventSource('/api/watchlist/realtime/stream');
109:       es.onmessage = (e) => { const payload = JSON.parse(e.data); ... };
110:     """
111:     ts_codes = _resolve_watchlist_ts_codes()
112:     if not ts_codes:
113:         # 空自选股时也保持连接，定期返回空帧供客户端确认存活
114:         async def empty_stream():
115:             yield f"data: {json.dumps({'server_time': datetime.now().isoformat(timespec='seconds'), 'data': {}, 'count': 0}, ensure_ascii=False)}\n\n"
116:             frame_count = 0
117:             while True:
118:                 await asyncio.sleep(5.0)
119:                 frame_count += 1
120:                 if frame_count % 3 == 0:
121:                     yield f": heartbeat\n\n"
122:                 yield f"data: {json.dumps({'server_time': datetime.now().isoformat(timespec='seconds'), 'data': {}, 'count': 0}, ensure_ascii=False)}\n\n"
123:         return StreamingResponse(empty_stream(), media_type='text/event-stream',
124:                                  headers={'Cache-Control': 'no-cache', 'X-Accel-Buffering': 'no'})
125:     return StreamingResponse(_event_stream(ts_codes), media_type='text/event-stream',
126:                              headers={'Cache-Control': 'no-cache', 'X-Accel-Buffering': 'no'})
127: @router.get('/api/watchlist/realtime/snapshot')
128: async def snapshot_realtime():
129:     """REST 端点：一次性返回 watchlist 当前实时态（用于非 SSE 客户端或回退）
130:     适合场景：手机端不支持 SSE、首次加载补全、调试
131:     """
132:     ts_codes = _resolve_watchlist_ts_codes()
