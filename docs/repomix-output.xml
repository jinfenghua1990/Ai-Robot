332: # SINA_HEADERS imported from utils.http_constants
333: def _normalize_ts_code(code):
334:     """统一成分股代码为 ts_code 格式"""
335:     code = str(code).strip()
336:     if '.' in code:
337:         return code.upper()
338:     if code.startswith('6') or code.startswith('9'):
339:         return f'{code}.SH'
340:     elif code.startswith('8') or code.startswith('4') or code.startswith('92'):
341:         return f'{code}.BJ'
342:     else:
343:         return f'{code}.SZ'
344: def _run_threaded(worker, items, max_workers=4, ordered=False):
345:     """线程池执行 worker(items[i]) → list of results。
346:     Args:
347:         worker: 单元素处理函数，签名 (item) -> result
348:         items: 待处理列表
349:         max_workers: 并发线程数
350:         ordered: True=按输入顺序收集；False=按完成顺序收集
351:     Returns:
352:         list of worker 返回值；worker 异常会被记录并跳过该元素（不中断整体）。
353:     """
354:     if not items:
355:         return []
356:     results = []
357:     with ThreadPoolExecutor(max_workers=max_workers) as executor:
358:         if ordered:
359:             for r in executor.map(worker, items):
360:                 if r is not None:
361:                     results.append(r)
362:         else:
363:             futures = {executor.submit(worker, item): item for item in items}
364:             for future in as_completed(futures):
365:                 try:
366:                     r = future.result()
367:                     if r is not None:
368:                         results.append(r)
369:                 except Exception as e:
370:                     logger.warning('[sync_concept_sectors] worker exception: %s', e, exc_info=True)
371:     return results
372: def _sina_fetch_concept_list():
373:     """从新浪财经获取概念板块列表，返回 [(name, node, netamount), ...]"""
374:     url = 'http://vip.stock.finance.sina.com.cn/quotes_service/api/json_v2.php/MoneyFlow.ssl_bkzj_bk'
375:     items = []
376:     for page in range(1, 20):
377:         try:
378:             resp = requests.get(url, params={
379:                 'page': page, 'num': 100, 'sort': 'netamount', 'asc': 0, 'fenlei': 1
380:             }, timeout=10, headers=SINA_HEADERS)
381:             data = resp.json()
382:             if not data:
383:                 break
384:             for item in data:
385:                 name = item.get('name', '').strip()
386:                 node = item.get('category', '').strip()
387:                 if name and node:
388:                     items.append({
389:                         'name': name,
390:                         'node': node,
391:                         'netamount': float(item.get('netamount', 0) or 0),
392:                     })
393:             if len(data) < 100:
394:                 break
395:         except Exception as e:
396:             logger.warning(f'[sync_concept_sectors] sina list page {page} error: {e}', exc_info=True)
397:             break
398:     # 按净流入排序，取前 200（避免成分股请求过多）
399:     items.sort(key=lambda x: x['netamount'], reverse=True)
400:     print(f'[sync_concept_sectors] fetched {len(items)} concept boards from sina')
401:     return items[:200]
402: def _sina_fetch_concept_cons(node, max_pages=10):
403:     """获取单个新浪概念板块的成分股 code 列表"""
404:     url = 'http://vip.stock.finance.sina.com.cn/quotes_service/api/json_v2.php/Market_Center.getHQNodeData'
405:     codes = []
406:     for page in range(1, max_pages + 1):
407:         try:
408:             resp = requests.get(url, params={
409:                 'page': page, 'num': 80, 'sort': 'symbol', 'asc': 1, 'node': node
410:             }, timeout=10, headers=SINA_HEADERS)
411:             data = resp.json()
412:             if not data:
413:                 break
414:             for item in data:
415:                 code = str(item.get('code', '')).strip()
416:                 if code and len(code) == 6 and code.isdigit():
417:                     codes.append(_normalize_ts_code(code))
418:             if len(data) < 80:
419:                 break
420:         except Exception as e:
421:             logger.warning(f'[sync_concept_sectors] sina cons {node} page {page} error: {e}', exc_info=True)
422:             break
423:     return codes
424: def fetch_from_sina():
425:     """从新浪财经拉取概念板块列表 + 成分股"""
426:     concepts = {}
427:     items = _sina_fetch_concept_list()
428:     if not items:
429:         return concepts
430:     def _fetch_one(item):
431:         codes = _sina_fetch_concept_cons(item['node'])
432:         return item['name'], codes, len(codes)
433:     results = _run_threaded(_fetch_one, items, max_workers=8)
434:     for name, codes, count in results:
435:         if codes:
436:             concepts[name] = codes
437:             if count > 0 and count % 100 == 0:
438:                 logger.info('[sync_concept_sectors] sina %s: %d stocks (may have more)', name, count)
439:     logger.info('[sync_concept_sectors] sina concepts with constituents: %d', len(concepts))
440:     return concepts
