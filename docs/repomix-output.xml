139:     const prev2 = lc[`d${n - 2}`];
140:     const prevWeakened = [prev1, prev2].some(p => p && ['跌停A杀', '分歧', '砸盘', '弱势回调'].includes(p.price_stage));
141:     if (prevWeakened && (stage === '震荡' || stage === '偏多' || stage === '晋级')) {
