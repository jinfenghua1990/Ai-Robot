  1: """4.0 信号盘后预计算
  2: WatchlistSignalDaily → 4.0 引擎（signal/position/risk）→ TradingSignalDaily
  3: 依赖：watchlist_signal_runner 先跑完（数据源）
  4: """
  5: import sys
  6: import os
  7: import json
  8: import asyncio
  9: import logging
 10: from datetime import datetime
 11: from typing import List, Dict
 12: sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
 13: from db.session import get_db_session
 14: from db.models import WatchlistSignalDaily, TradingSignalDaily
 15: from analyzers.stock_scores import (
 16:     calc_sentiment, calc_risk, calc_momentum, calc_main_force,
 17:     calc_technical, calc_sector_resonance,
 18: )
 19: from services.signal_builder import build_signal_from_precomputed
 20: from .signal_engine import calc_final_score, classify_signal_4
 21: from .position_engine import calc_dynamic_position
 22: from .risk_engine import assess_portfolio_risk, is_high_position_stock
 23: logger = logging.getLogger(__name__)
 24: def has_run_today(target_date=None) -> bool:
 25:     """检查当日 4.0 信号是否已预计算"""
 26:     if target_date is None:
 27:         target_date = datetime.now().date()
 28:     elif isinstance(target_date, str):
 29:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
 30:     with get_db_session() as db:
 31:         count = db.query(TradingSignalDaily).filter(
 32:             TradingSignalDaily.trade_date == target_date
 33:         ).count()
 34:         return count > 0
 35: async def _process_one(row, db) -> dict:
 36:     """处理单只股票：预计算行 → 4.0 信号"""
 37:     code = row.ts_code.split('.')[0] if '.' in row.ts_code else row.ts_code
 38:     name = row.name or ''
 39:     # 1. 构建 base signal（含 quote/sectorTrend/marketState/bsSignal/qualityStatus/lifecycleStage）
 40:     signal = await build_signal_from_precomputed(code, name, row, db=db)
 41:     # 2. 补充 6 维评分（build_signal_from_precomputed 不含这些）
 42:     quote = signal.get('quote')
 43:     sector_trend = signal.get('sectorTrend') or {}
 44:     ms_data = signal.get('marketState') or {}
 45:     features = ms_data.get('features') or {}
 46:     bp_data = signal.get('buyPower') or {}
 47:     signal['sentiment'] = calc_sentiment(quote, sector_trend, features)
 48:     signal['risk'] = calc_risk(features, bp_data, None)
 49:     signal['momentum'] = calc_momentum(sector_trend, features)
 50:     signal['mainForce'] = calc_main_force(quote, features, sector_trend)
 51:     signal['technical'] = calc_technical(features)
 52:     signal['sectorResonance'] = calc_sector_resonance(sector_trend, features)
 53:     # 3. 4.0 信号分级
 54:     final_score, score_detail = calc_final_score(signal)
 55:     classification = classify_signal_4(signal, final_score)
 56:     # 4. 动态仓位
 57:     position = calc_dynamic_position(signal, classification['signal_4'], final_score)
 58:     # 5. 高位股检测
 59:     is_high, high_reason = is_high_position_stock(signal)
 60:     return {
 61:         'ts_code': row.ts_code,
 62:         'name': name,
 63:         'sector': row.sector or '',
 64:         'signal_raw': signal,
 65:         'signal_4': classification['signal_4'],
 66:         'signal_label': classification['label'],
 67:         'signal_color': classification['color'],
 68:         'final_score': final_score,
 69:         'score_detail': score_detail,
 70:         'reasons': classification['reasons'],
 71:         'position_pct': position['position_pct'],
 72:         'position_amount': position['position_amount'],
 73:         'stop_loss_pct': position['stop_loss_pct'],
 74:         'take_profit_pct': position['take_profit_pct'],
 75:         'atr_14': position['atr_14'],
 76:         'risk_per_share': position['risk_per_share'],
 77:         'market_state': ms_data.get('market_state', ''),
 78:         'sentiment_stage': (signal.get('sentiment') or {}).get('stage', '中性'),
 79:         'is_high_position': is_high,
 80:         'high_reason': high_reason,
 81:         'watchlist_signal_id': row.id,
 82:     }
 83: async def _compute_async(target_date_str: str) -> List[dict]:
 84:     """异步计算当日所有候选股票的 4.0 信号"""
 85:     with get_db_session() as db:
 86:         rows = db.query(WatchlistSignalDaily).filter(
 87:             WatchlistSignalDaily.trade_date == target_date_str
 88:         ).all()
 89:         if not rows:
 90:             logger.info(f'[trading_system] 无 {target_date_str} 的 WatchlistSignalDaily 数据')
 91:             return []
 92:         logger.info(f'[trading_system] 处理 {len(rows)} 只股票')
 93:         # 分批并发（每批 20 只，避免新浪限流）
 94:         all_results = []
 95:         batch_size = 20
 96:         for i in range(0, len(rows), batch_size):
 97:             batch = rows[i:i + batch_size]
 98:             tasks = [_process_one(row, db) for row in batch]
 99:             # 注意: 各 task 内部需自行管理 session，不可共用外层 db
100:             results = await asyncio.gather(*tasks, return_exceptions=True)
101:             for r in results:
102:                 if not isinstance(r, Exception) and r is not None:
103:                     all_results.append(r)
104:                 elif isinstance(r, Exception):
105:                     logger.error(f'[trading_system] 处理失败: {r}')
106:         # 6. 组合风控
107:         market_sentiment = '中性'
108:         if all_results:
109:             # 取多数情绪
110:             sentiments = [r['sentiment_stage'] for r in all_results]
111:             market_sentiment = max(set(sentiments), key=sentiments.count) if sentiments else '中性'
112:         risk_result = assess_portfolio_risk(all_results, market_sentiment)
113:         # 7. 合并风控调整到结果
114:         adjusted_map = {s['ts_code']: s for s in risk_result['adjusted_signals']}
115:         for r in all_results:
116:             adj = adjusted_map.get(r['ts_code'])
117:             if adj:
118:                 r['position_pct'] = adj.get('position_pct', r['position_pct'])
119:                 r['position_amount'] = adj.get('position_amount', r['position_amount'])
120:                 r['risk_status'] = adj.get('risk_status', 'ok')
121:                 r['risk_reasons'] = adj.get('risk_reasons', [])
122:             else:
123:                 r['risk_status'] = 'ok'
124:                 r['risk_reasons'] = []
125:         # 存入 risk_summary 供日志
126:         logger.info(f'[trading_system] 总仓位 {risk_result["total_position_pct"]}% / '
127:                      f'上限 {risk_result["total_cap_pct"]}% / '
128:                      f'可买 {risk_result["buyable_count"]} 只 / '
129:                      f'警告 {len(risk_result["warnings"])} 条')
130:         return all_results
131: def compute_for_date(target_date=None) -> Dict:
132:     """盘后预计算入口（同步，供 scheduler 调用）
133:     返回: {'date': str, 'count': int, 'signals': list}
134:     """
135:     if target_date is None:
136:         target_date = datetime.now().date()
137:     elif isinstance(target_date, str):
138:         target_date = datetime.strptime(target_date, '%Y-%m-%d').date()
139:     target_date_str = target_date.strftime('%Y-%m-%d')
140:     # 检查依赖
141:     from services.watchlist_signal_runner import has_run_today as wl_done
142:     if not wl_done(target_date):
143:         logger.warning(f'[trading_system] WatchlistSignalDaily 未跑完，跳过 4.0 计算')
144:         return {'date': target_date_str, 'count': 0, 'error': 'watchlist_signal not ready'}
145:     # 检查是否已跑
146:     if has_run_today(target_date):
147:         logger.info(f'[trading_system] {target_date_str} 已预计算，跳过')
148:         return {'date': target_date_str, 'count': 0, 'error': 'already computed'}
149:     # 计算
150:     results = asyncio.run(_compute_async(target_date_str))
151:     # 落库
152:     with get_db_session() as db:
153:         for r in results:
154:             row = TradingSignalDaily(
155:                 trade_date=target_date,
156:                 ts_code=r['ts_code'],
157:                 name=r['name'],
158:                 sector=r['sector'],
159:                 signal_4=r['signal_4'],
160:                 signal_label=r['signal_label'],
161:                 signal_color=r['signal_color'],
162:                 final_score=r['final_score'],
163:                 score_detail_json=json.dumps(r['score_detail'], ensure_ascii=False),
164:                 position_pct=r['position_pct'],
165:                 position_amount=r['position_amount'],
166:                 stop_loss_pct=r['stop_loss_pct'],
167:                 take_profit_pct=r['take_profit_pct'],
168:                 atr_14=r['atr_14'],
169:                 risk_per_share=r['risk_per_share'],
170:                 risk_status=r['risk_status'],
171:                 risk_reasons_json=json.dumps(r.get('risk_reasons', []), ensure_ascii=False),
172:                 market_state=r['market_state'],
173:                 sentiment_stage=r['sentiment_stage'],
174:                 is_high_position=r['is_high_position'],
175:                 watchlist_signal_id=r.get('watchlist_signal_id'),
176:                 reasons_json=json.dumps(r['reasons'], ensure_ascii=False),
177:             )
178:             db.merge(row)
179:         db.commit()
180:     # 统计
181:     summary = {
182:         'strong_buy': sum(1 for r in results if r['signal_4'] == 'STRONG_BUY'),
183:         'watch_buy': sum(1 for r in results if r['signal_4'] == 'WATCH_BUY'),
184:         'forbid': sum(1 for r in results if r['signal_4'] == 'FORBID'),
185:     }
186:     logger.info(f'[trading_system] {target_date_str} 完成: '
187:                 f'强买{summary["strong_buy"]} 观察买{summary["watch_buy"]} 禁止{summary["forbid"]}')
188:     return {'date': target_date_str, 'count': len(results), 'summary': summary, 'signals': results}
