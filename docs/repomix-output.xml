  1: /**
  2:  * 指数资金流向 — 策略决策版
  3:  *
  4:  * 设计思路：
  5:  * - 去散点图（占空间但对策略帮助小）
  6:  * - 全宽单表：所有指数按净流入排序，红绿区分方向
  7:  * - 1/3/5/10/22日维度全展示，一眼看清短期→中期趋势
  8:  * - 趋势标签：根据多维度数据自动判定"持续流入/短期流入/持续流出/短期流出"
  9:  * - 关键行高亮：连续流入/大额流入加背景色
 10:  * - 模块标题：左色块 + 右结论标签
 11:  * - 紧凑布局：减少 padding、边框、间距
 12:  */
 13: import { useState, useEffect, useMemo, useCallback } from 'react';
 14: import { apiFetch } from '../utils/request';
 15: export default function IndexFlowPage() {
 16:   const [data, setData] = useState(null);
 17:   const [loading, setLoading] = useState(true);
 18:   const [error, setError] = useState(null);
 19:   const [sortBy, setSortBy] = useState('inflow_1d');
 20:   const [sortDir, setSortDir] = useState('desc');
 21:   const [filterDir, setFilterDir] = useState('all'); // all | inflow | outflow
 22:   // 加载数据
 23:   const loadRank = useCallback(async (force = false) => {
 24:     setLoading(true);
 25:     setError(null);
 26:     const { ok, data: d, error: err } = await apiFetch(`/api/index-flow/rank${force ? '?force=1' : ''}`);
 27:     if (ok) {
 28:       setData(d);
 29:       if (d?.error === 'data_source_unavailable') {
 30:         setError(d.message || '数据源暂时不可用');
 31:       }
 32:     } else {
 33:       setError(err || '加载失败');
 34:     }
 35:     setLoading(false);
 36:   }, []);
 37:   useEffect(() => { loadRank(); }, [loadRank]);
 38:   // 亿元格式化
 39:   const fmtYi = (v) => {
 40:     if (v == null || isNaN(v)) return '—';
 41:     return `${(v / 1e8).toFixed(1)}`;
 42:   };
 43:   const fmtDateCN = (iso) => {
 44:     if (!iso || !/^\d{4}-\d{2}-\d{2}$/.test(iso)) return iso || '--';
 45:     const [y, m, d] = iso.split('-').map(Number);
 46:     return `${y}年${m}月${d}日`;
 47:   };
 48:   // 颜色
 49:   const red = (v) => v >= 0 ? '#ef4444' : '#22c55e';
 50:   const redBg = (v) => v >= 0 ? 'rgba(239,68,68,0.06)' : 'rgba(34,197,94,0.06)';
 51:   // 趋势判定
 52:   const getTrend = (item) => {
 53:     const d1 = item.inflow_1d ?? 0;
 54:     const d3 = item.inflow_3d ?? 0;
 55:     const d5 = item.inflow_5d ?? 0;
 56:     const d10 = item.inflow_10d ?? 0;
 57:     if (d1 > 0 && d3 > 0 && d5 > 0 && d10 > 0) {
 58:       return { label: '持续流入', color: '#ef4444', level: 3 };
 59:     }
 60:     if (d1 > 0 && d3 > 0 && d5 > 0) {
 61:       return { label: '中期流入', color: '#ef4444', level: 2 };
 62:     }
 63:     if (d1 > 0 && d3 > 0) {
 64:       return { label: '短期流入', color: '#f97316', level: 1 };
 65:     }
 66:     if (d1 > 0) {
 67:       return { label: '今日流入', color: '#f59e0b', level: 0 };
 68:     }
 69:     if (d1 < 0 && d3 < 0 && d5 < 0 && d10 < 0) {
 70:       return { label: '持续流出', color: '#22c55e', level: -3 };
 71:     }
 72:     if (d1 < 0 && d3 < 0 && d5 < 0) {
 73:       return { label: '中期流出', color: '#22c55e', level: -2 };
 74:     }
 75:     if (d1 < 0 && d3 < 0) {
 76:       return { label: '短期流出', color: '#3b82f6', level: -1 };
 77:     }
 78:     if (d1 < 0) {
 79:       return { label: '今日流出', color: '#64748b', level: 0 };
 80:     }
 81:     return { label: '观望', color: '#94a3b8', level: 0 };
 82:   };
 83:   // 排序 + 过滤
 84:   const sortedAll = useMemo(() => {
 85:     if (!data?.indices) return [];
 86:     const list = data.indices.map(item => ({ ...item, trend: getTrend(item) }));
 87:     const dir = sortDir === 'desc' ? -1 : 1;
 88:     list.sort((a, b) => {
 89:       const va = a[sortBy] ?? 0;
 90:       const vb = b[sortBy] ?? 0;
 91:       return (va < vb ? -1 : va > vb ? 1 : 0) * dir;
 92:     });
 93:     if (filterDir === 'inflow') return list.filter(x => (x.inflow_1d ?? 0) >= 0);
 94:     if (filterDir === 'outflow') return list.filter(x => (x.inflow_1d ?? 0) < 0);
 95:     return list;
 96:   }, [data, sortBy, sortDir, filterDir]);
 97:   const handleSort = (key) => {
 98:     if (sortBy === key) {
 99:       setSortDir(d => d === 'desc' ? 'asc' : 'desc');
100:     } else {
101:       setSortBy(key);
102:       setSortDir('desc');
103:     }
104:   };
105:   const sortIcon = (key) => {
106:     if (sortBy !== key) return '⇅';
107:     return sortDir === 'desc' ? '↓' : '↑';
108:   };
109:   // 顶部结论
110:   const topStats = useMemo(() => {
111:     if (!data?.indices) return null;
112:     const indices = data.indices;
113:     const inflowCount = indices.filter(x => (x.inflow_1d ?? 0) >= 0).length;
114:     const outflowCount = indices.filter(x => (x.inflow_1d ?? 0) < 0).length;
115:     const topInflow = indices.reduce((best, cur) => {
116:       const c = cur.inflow_1d ?? 0;
117:       const b = best.inflow_1d ?? 0;
118:       return c > b ? cur : best;
119:     }, indices[0]);
120:     const topOutflow = indices.reduce((best, cur) => {
121:       const c = cur.inflow_1d ?? 0;
122:       const b = best.inflow_1d ?? 0;
123:       return c < b ? cur : best;
124:     }, indices[0]);
125:     return { inflowCount, outflowCount, topInflow, topOutflow };
126:   }, [data]);
127:   // 表格列定义
128:   const cols = [
129:     { key: 'name', name: '指数名称', align: 'left', w: '120px' },
130:     { key: 'pct_change', name: '涨跌', align: 'right', w: '55px' },
131:     { key: 'inflow_1d', name: '1日净流入', align: 'right', w: '70px' },
132:     { key: 'inflow_3d', name: '3日净流入', align: 'right', w: '70px' },
133:     { key: 'inflow_5d', name: '5日净流入', align: 'right', w: '70px' },
134:     { key: 'inflow_10d', name: '10日净流入', align: 'right', w: '75px' },
135:     { key: 'inflow_22d', name: '22日净流入', align: 'right', w: '75px' },
136:     { key: 'trend', name: '趋势', align: 'center', w: '65px', noSort: true },
137:   ];
138:   if (loading) {
139:     return (
140:       <div className="flex items-center justify-center h-64">
141:         <div className="w-5 h-5 border-2 rounded-full animate-spin" style={{ borderColor: '#3b82f6', borderTopColor: 'transparent' }} />
142:         <span className="ml-2 text-xs" style={{ color: 'var(--text-muted)' }}>加载指数资金流向数据...</span>
143:       </div>
144:     );
145:   }
146:   if (error) {
147:     return (
148:       <div className="rounded-lg p-3 text-xs" style={{ background: 'rgba(239,68,68,0.08)', color: '#ef4444', border: '1px solid rgba(239,68,68,0.2)' }}>
149:         加载失败: {error}
150:         <button onClick={() => loadRank(true)} className="ml-2 px-2 py-0.5 rounded border text-[10px]" style={{ borderColor: '#ef4444', color: '#ef4444' }}>重试</button>
151:       </div>
152:     );
153:   }
154:   if (!data) return null;
155:   return (
156:     <div className="space-y-2">
157:       {/* ===== 标题栏：左色块 + 右结论 ===== */}
158:       <div className="flex items-center justify-between px-2.5 py-2 rounded-lg" style={{ background: 'var(--bg-card)', border: '1px solid var(--border-color)' }}>
159:         <div className="flex items-center gap-2">
160:           <span className="text-xs font-bold px-1.5 py-0 rounded" style={{ background: 'rgba(59,130,246,0.1)', color: '#3b82f6', borderLeft: '2px solid #3b82f6' }}>
161:             指数资金流向
162:           </span>
163:           <span className="text-[10px]" style={{ color: 'var(--text-muted)' }}>
164:             {fmtDateCN(data.date)}
165:           </span>
166:         </div>
167:         {topStats && (
168:           <div className="flex items-center gap-2 text-[10px]">
169:             <span className="px-1.5 py-0.5 rounded font-bold" style={{ background: 'rgba(239,68,68,0.1)', color: '#ef4444', border: '1px solid rgba(239,68,68,0.2)' }}>
170:               流入 {topStats.inflowCount}
171:             </span>
172:             <span className="px-1.5 py-0.5 rounded font-bold" style={{ background: 'rgba(34,197,94,0.1)', color: '#22c55e', border: '1px solid rgba(34,197,94,0.2)' }}>
173:               流出 {topStats.outflowCount}
174:             </span>
175:             <span className="px-1.5 py-0.5 rounded font-bold truncate max-w-[140px]" style={{ background: 'rgba(239,68,68,0.08)', color: '#ef4444' }} title={`${topStats.topInflow?.name} +${fmtYi(topStats.topInflow?.inflow_1d)}亿`}>
176:               最强: {topStats.topInflow?.name} +{fmtYi(topStats.topInflow?.inflow_1d)}亿
177:             </span>
178:           </div>
